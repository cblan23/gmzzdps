                    monster.last_hp_update_100ns = 0
                    monster.last_hp_drop_100ns = 0
                    monster.death_confirmed = False
                    monster.death_time_100ns = 0
                else:
                    monster.observed_damage_taken = 0.0
                if monster.healing_target or int(
