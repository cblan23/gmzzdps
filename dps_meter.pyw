            self._sync_unlock_hotkey_controls()
            return False
        self.lock_toggle_hotkey_enabled = bool(enabled)
        self.unlock_hotkey_registered = bool(
            enabled or getattr(self, "unlock_hotkey_enabled", False)
        )
        self.unlock_hotkey_error = ""
        self.config[LOCK_TOGGLE_HOTKEY_ENABLED_CONFIG_KEY] = bool(enabled)
        save_config(self.config)
        self._sync_unlock_hotkey_controls()
