    def _render_titlebar_icon_button(self, button: tk.Label) -> None:
        hovered = bool(getattr(button, "_hovered", False))
        color = button._hover_fg if hovered else button._normal_fg
        background = button._hover_bg if hovered else button._normal_bg
        image = self.icons.toolbar(button._icon_name, 16, color)
        button.configure(image=image, bg=background)
        button.image = image

    def _set_titlebar_icon_hover(
        self, button: tk.Label, hovered: bool
    ) -> None:
        button._hovered = bool(hovered)
        self._render_titlebar_icon_button(button)

    def _set_titlebar_icon(self, button: tk.Label, icon_name: str) -> None:
        button._icon_name = str(icon_name)
        self._render_titlebar_icon_button(button)

