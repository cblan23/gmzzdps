                )
                canvas.create_text(
                    columns["character_name"],
                    middle,
                    text=self._fit_ui_text(
                        character_name, character_available, "table"
                    ),
                    fill=TEXT if raw_character_name else MUTED,
                    anchor="w",
                    font=self._ui_font("table"),
                    tags=(tag,),
                )
            if self._history_field_visible("extraordinary_rating"):
                rating_text = self._history_optional_number(
                    summary.get("extraordinary_rating")
                )
                canvas.create_text(
                    columns["extraordinary_rating"],
                    middle,
                    text=rating_text,
                    fill=TEXT if rating_text != "--" else MUTED,
                    anchor="w",
                    font=self._ui_font("number_strong"),
                    tags=(tag,),
                )
            if self._history_field_visible("performance"):
                performance_x = columns["performance"]
                performance_text, detail_text = self._history_list_performance(
                    summary
                )
                canvas.create_text(
                    performance_x,
                    primary_y,
                    text=performance_text,
                    fill=ACCENT,
                    anchor="w",
                    font=self._ui_font("number_strong"),
                    tags=(tag,),
                )
                detail_available = max(
                    36,
                    columns["performance_right"] - performance_x - 4,
                )
                canvas.create_text(
                    performance_x,
                    secondary_y,
                    text=self._fit_ui_text(
                        detail_text, detail_available, "micro"
                    ),
                    fill=MUTED,
                    anchor="w",
                    font=self._ui_font("micro"),
                    tags=(tag,),
                )
            if self._history_field_visible("result"):
                self._draw_history_result_badge(
                    canvas,
                    columns["result"],
                    middle,
                    summary.get("result"),
                    base,
                    (tag,),
                )
            action_tags = self._draw_history_inline_actions(
                canvas,
                columns["operation_left"] + 5,
                middle,
                index,
                bool(summary.get("favorite", False)),
            )
            canvas.create_line(0, bottom - 1, width, bottom - 1, fill=BORDER)
            canvas.tag_bind(
                tag,
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._select_history(
                    selected_id
                ),
            )
            canvas.tag_bind(
                tag,
                "<Double-Button-1>",
                lambda _event, selected_id=battle_id: (
                    self._select_history(selected_id),
                    self._open_selected_history_detail(),
                ),
            )
            canvas.tag_bind(
                check_tag,
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._toggle_history_row_selection(
                    selected_id
                ),
            )
            favorite = bool(summary.get("favorite", False))
            canvas.tag_bind(
                action_tags["report"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._capture_history_team_report_by_id(
                    selected_id
                ),
            )
            canvas.tag_bind(
                action_tags["favorite"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._toggle_history_favorite_by_id(
                    selected_id
                ),
            )
            canvas.tag_bind(
                action_tags["delete"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._delete_history_by_id(
                    selected_id
