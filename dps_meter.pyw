            for kind, active in (
                ("report", False),
                ("favorite", favorite),
                ("delete", False),
            ):
                canvas.tag_bind(
                    action_tags[kind],
                    "<Enter>",
                    lambda _event, selected_index=index, selected_kind=kind, selected_active=active: self._set_history_inline_action_hover(
