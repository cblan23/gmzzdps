def load_map_display_catalog() -> dict[str, dict[int, str]]:
    """Load compact scene/dungeon labels for targetless team combat."""

    by_scene: dict[int, str] = {}
    by_dungeon: dict[int, str] = {}
    try:
        with MAP_CATALOG_CSV_PATH.open(
            "r", encoding="utf-8-sig", newline=""
        ) as handle:
            rows = csv.DictReader(handle)
            for row in rows:
                try:
                    scene_id = int(row.get("map_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    scene_id = 0
                label = str(
                    row.get("mode_name")
                    or row.get("map_name")
                    or ""
                ).strip()[:64]
                if not label:
                    continue
                if scene_id:
                    by_scene.setdefault(scene_id, label)
                for raw_dungeon_id in re.findall(
                    r"\d+", str(row.get("dungeon_ids") or "")
                ):
                    try:
                        dungeon_id = int(raw_dungeon_id)
                    except (TypeError, ValueError, OverflowError):
                        continue
                    if dungeon_id:
                        by_dungeon.setdefault(dungeon_id, label)
    except (OSError, csv.Error, TypeError, ValueError):
        pass
    return {"scene": by_scene, "dungeon": by_dungeon}


