    def main_profession(
        self, class_id: int | None, size: int = 34
    ) -> ImageTk.PhotoImage:
        """Render the extracted game crest on its established profession color."""

        class_id = int(class_id or 0)
        color = PROFESSION_COLORS.get(class_id, SUBTLE)
        physical_size = self._physical_size(size)
        key = ("main-profession", class_id, physical_size, color)
        if key in self.cache:
            return self.cache[key]

        render_size = max(4, physical_size * 4)
        rgb = tuple(int(color[index : index + 2], 16) for index in (1, 3, 5))
        bright = tuple(round(channel + (255 - channel) * 0.42) for channel in rgb)
        dark = tuple(max(4, round(channel * 0.26)) for channel in rgb)
        middle = tuple(max(8, round(channel * 0.72)) for channel in rgb)
        image = Image.new("RGBA", (render_size, render_size), (0, 0, 0, 0))

        glow = Image.new("RGBA", image.size, (0, 0, 0, 0))
        glow_draw = ImageDraw.Draw(glow, "RGBA")
        glow_margin = round(render_size * 0.14)
        glow_draw.ellipse(
            (
                glow_margin,
                glow_margin,
                render_size - glow_margin - 1,
                render_size - glow_margin - 1,
            ),
            fill=rgb + (150,),
        )
        glow = glow.filter(
            ImageFilter.GaussianBlur(max(1.0, render_size * 0.095))
        )
        image.alpha_composite(glow)

        draw = ImageDraw.Draw(image, "RGBA")
        outer = round(render_size * 0.09)
        inner = round(render_size * 0.14)
        highlight_width = max(1, round(render_size * 0.012))
        draw.ellipse(
            (outer, outer, render_size - outer - 1, render_size - outer - 1),
            fill=middle + (232,),
        )
        draw.ellipse(
            (inner, inner, render_size - inner - 1, render_size - inner - 1),
            fill=dark + (226,),
        )
        draw.arc(
            (outer, outer, render_size - outer - 1, render_size - outer - 1),
            start=202,
            end=340,
            fill=bright + (165,),
            width=highlight_width,
        )

        path = ASSET_DIR / "professions" / f"{class_id}.png"
        if not path.is_file():
            path = ASSET_DIR / f"{class_id}.png"
        source: Image.Image | None = None
        if path.is_file():
            try:
                source = Image.open(path).convert("RGBA")
            except (OSError, ValueError):
                source = None
        if source is not None and source.getchannel("A").getbbox() is not None:
            source = source.crop(source.getchannel("A").getbbox())
            glyph_extent = max(1, round(render_size * 0.64))
            source.thumbnail((glyph_extent, glyph_extent), Image.Resampling.LANCZOS)
            alpha = source.getchannel("A")
            glyph = Image.new("RGBA", source.size, (248, 252, 255, 0))
            glyph.putalpha(alpha)
            glyph_glow = Image.new("RGBA", image.size, (0, 0, 0, 0))
            glyph_x = (render_size - source.width) // 2
            glyph_y = (render_size - source.height) // 2
            glow_mask = Image.new("L", image.size, 0)
            glow_mask.paste(alpha, (glyph_x, glyph_y))
            glow_mask = glow_mask.filter(
                ImageFilter.GaussianBlur(max(1.0, render_size * 0.025))
            )
            glyph_glow.paste(rgb + (0,), (0, 0, render_size, render_size))
            glyph_glow.putalpha(glow_mask)
            image.alpha_composite(glyph_glow)
            image.alpha_composite(glyph, (glyph_x, glyph_y))

            white_core = Image.new("RGBA", source.size, (255, 255, 255, 0))
            white_core.putalpha(alpha.point(lambda value: round(value * 0.30)))
            image.alpha_composite(white_core, (glyph_x, glyph_y))
        else:
            fallback = (self.PROFESSION_GLYPHS.get(class_id, "?") or "?")[:1]
            font = self._font(max(12, round(render_size * 0.42)), bold=True)
            box = draw.textbbox((0, 0), fallback, font=font)
            text_x = (render_size - (box[2] - box[0])) / 2 - box[0]
            text_y = (render_size - (box[3] - box[1])) / 2 - box[1]
            draw.text((text_x, text_y), fallback, font=font, fill=bright + (255,))

        image = image.resize(
            (physical_size, physical_size), Image.Resampling.LANCZOS
        )
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def boss(
        self,
        icon_name: object,
        name: object,
        size: int = 48,
    ) -> ImageTk.PhotoImage:
        """Load a catalogued Boss portrait, with a stable local fallback."""

        physical_size = self._physical_size(size)
        safe_icon = Path(str(icon_name or "")).name
        display_name = str(name or "").strip() or "Boss"
        key = ("boss", safe_icon, display_name, physical_size)
        if key not in self.cache:
            path = ASSET_DIR / "bosses" / safe_icon if safe_icon else Path()
            image = self._from_file(path, physical_size) if safe_icon else None
            if image is None:
                seed = int.from_bytes(
                    hashlib.sha1(display_name.encode("utf-8")).digest()[:4],
                    "big",
                )
                image = self._draw_badge(
                    display_name[:1], WARN, physical_size, seed
                )
            self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]













def render_switch_control_image(
    background: str,
    track: str,
    thumb: str,
    checked: bool,
) -> Image.Image:
    """Render a small switch at high resolution for smooth rounded edges."""

    width, height, scale = 44, 26, 4
    image = Image.new("RGB", (width * scale, height * scale), background)
    draw = ImageDraw.Draw(image)
    draw.rounded_rectangle(
        (3 * scale, 3 * scale, 41 * scale - 1, 23 * scale - 1),
        radius=10 * scale,
        fill=track,
    )
    thumb_x = 31 if checked else 13
    draw.ellipse(
        (
            (thumb_x - 8) * scale,
            5 * scale,
            (thumb_x + 8) * scale - 1,
            21 * scale - 1,
        ),
        fill=thumb,
    )
    return image.resize((width, height), Image.Resampling.LANCZOS)







class LicenseHeartbeatWorker(threading.Thread):
    def __init__(
        self,
        licensing: LicensingService,
        messages: queue.Queue,
        stop_event: threading.Event,
    ):
        super().__init__(name="DpsLicenseHeartbeat", daemon=True)
        self.recovery = LicenseRecovery(LICENSE_HEARTBEAT_FAILURE_GRACE_SECONDS)
        self.licensing = licensing
        self.messages = messages
        self.stop_event = stop_event
        self.state_lock = threading.Lock()
        self.using = False
        self.character_name = ""
        self.game_pid = 0

    def update_state(
        self, *, using: bool, character_name: str = "", game_pid: int = 0
    ) -> None:
        with self.state_lock:
            self.using = bool(using)
            self.character_name = str(character_name).strip()[:48]
            self.game_pid = max(0, int(game_pid or 0))

    def _state(self) -> tuple[bool, str, int]:
        with self.state_lock:
            return self.using, self.character_name, self.game_pid

    def run(self) -> None:
        interval = 30
        try:
            while not self.stop_event.is_set():
                using, character_name, game_pid = self._state()
                try:
                    request_started_at = time.time()
                    result = self.licensing.heartbeat(
                        using=using,
                        character_name=character_name,
                        game_pid=game_pid,
                    )
                    request_finished_at = time.time()
                except LicensingConnectionError as error:
                    delay = self.recovery.failed()
                    write_capture_lifecycle_event(
                        "license_heartbeat_failed",
                        component="license_heartbeat",
                        error_type=type(error).__name__,
                        details=str(error)[:500],
                        failures=int(self.recovery.failures),
                        retry_delay_seconds=float(delay),
                    )
                    self.messages.put(("license_reconnecting", None))
                    self.stop_event.wait(delay)
                    continue
                if not result.authorized:
                    self.messages.put(
                        (
                            "license_required",
                            result.message or "登录状态已失效，请重新登录。",
                        )
                    )
                    return
                self.recovery.succeeded()
                capability = result.runtime_capability
                write_capture_lifecycle_event(
                    "license_heartbeat_succeeded",
                    component="license_heartbeat",
                    heartbeat_interval=int(result.heartbeat_interval),
                    lease_sequence=int(
                        getattr(capability, "lease_sequence", 0) or 0
                    ),
                    capability_expires_at=float(
                        getattr(capability, "expires_at", 0.0) or 0.0
                    ),
                    successful_renewals=int(
                        self.recovery.successful_renewals
                    ),
                )
                if result.server_time > 0:
                    self.messages.put(
                        (
                            "server_clock",
                            {
                                "server_time": result.server_time,
                                "received_at": (
                                    request_started_at + request_finished_at
                                )
                                / 2.0,
                            },
                        )
                    )
                if result.runtime_capability is not None:
                    self.messages.put(
                        (
                            "runtime_capability",
                            result.runtime_capability,
                        )
                    )
                self.messages.put(("license_reconnected", None))
                interval = result.heartbeat_interval
                self.stop_event.wait(interval)
        finally:
            write_capture_lifecycle_event(
                "license_heartbeat_stopped",
                component="license_heartbeat",
                stop_requested=bool(self.stop_event.is_set()),
            )
            self.licensing.sign_out()


class CombatClockWorker(threading.Thread):
    def __init__(
        self,
        licensing: LicensingService,
        messages: queue.Queue,
        stop_event: threading.Event,
    ):
        super().__init__(name="DpsSharedCombatClock", daemon=True)
        self.licensing = licensing
        self.messages = messages
        self.stop_event = stop_event
        self.state_lock = threading.Lock()
        self.pending: dict[str, dict[str, object]] = {}
        self.confirmed_final_revision: dict[str, int] = {}
        self.last_sent: dict[str, float] = {}
        self.wake_event = threading.Event()

    def submit(self, snapshot: dict[str, object] | None) -> None:
        if not isinstance(snapshot, dict):
            return
        encounter_id = str(snapshot.get("encounter_id", "")).strip()
        if not encounter_id:
            return
        try:
            revision = max(0, int(snapshot.get("client_revision", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            return
        if revision <= 0:
            return
        with self.state_lock:
            confirmed_revision = self.confirmed_final_revision.get(
                encounter_id, 0
            )
            if revision <= confirmed_revision:
                return
            previous = self.pending.get(encounter_id)
            previous_state = (
                str(previous.get("state", ""))
                if isinstance(previous, dict)
                else ""
            )
            next_state = str(snapshot.get("state", ""))
            try:
                previous_revision = max(
                    0, int(previous.get("client_revision", 0) or 0)
                ) if isinstance(previous, dict) else 0
            except (TypeError, ValueError, OverflowError):
                previous_revision = 0
            if revision < previous_revision:
                return
            self.pending[encounter_id] = dict(snapshot)
            if revision > previous_revision and next_state != previous_state:
                # State transitions (especially final -> active recovery) go
                # out immediately. Ordinary active elapsed-time revisions keep
                # the one-second network cadence.
                self.last_sent.pop(encounter_id, None)
            if revision > confirmed_revision:
                self.confirmed_final_revision.pop(encounter_id, None)
        self.wake_event.set()

    def cancel(self, encounter_id: object) -> None:
        key = str(encounter_id or "").strip()
        if not key:
            return
        with self.state_lock:
            self.pending.pop(key, None)
            self.last_sent.pop(key, None)

    def _due_snapshot(self) -> tuple[str, dict[str, object]] | None:
        now = time.monotonic()
        with self.state_lock:
            candidates = sorted(
                self.pending.items(),
                key=lambda item: {
                    "final": 0,
                    "settling": 1,
                    "active": 2,
                }.get(str(item[1].get("state", "active")), 3),
            )
            for encounter_id, snapshot in candidates:
                interval = combat_clock_sync_interval(snapshot)
                if now - self.last_sent.get(encounter_id, 0.0) < interval:
                    continue
                self.last_sent[encounter_id] = now
                return encounter_id, dict(snapshot)
        return None

    def run(self) -> None:
        while not self.stop_event.is_set():
            due = self._due_snapshot()
            if due is None:
                self.wake_event.wait(0.15)
                self.wake_event.clear()
                continue
            encounter_id, snapshot = due
            try:
                result = self.licensing.sync_combat_clock(snapshot)
            except LicensingConnectionError:
                self.stop_event.wait(COMBAT_CLOCK_RETRY_INTERVAL_SECONDS)
                continue
            except Exception:
                self.stop_event.wait(COMBAT_CLOCK_RETRY_INTERVAL_SECONDS)
                continue
            if not result.synchronized:
                self.stop_event.wait(COMBAT_CLOCK_RETRY_INTERVAL_SECONDS)
                continue
            self.messages.put(("combat_clock_result", result))
            if result.final:
                with self.state_lock:
                    accepted_revision = max(
                        0, int(result.client_revision or 0)
                    )
                    self.confirmed_final_revision[encounter_id] = max(
                        self.confirmed_final_revision.get(encounter_id, 0),
                        accepted_revision,
                    )
                    pending = self.pending.get(encounter_id)
                    try:
                        pending_revision = max(
                            0,
                            int(
                                pending.get("client_revision", 0) or 0
                            ),
                        ) if isinstance(pending, dict) else 0
                    except (TypeError, ValueError, OverflowError):
                        pending_revision = 0
                    if (
                        pending_revision <= accepted_revision
                        and isinstance(pending, dict)
                        and str(pending.get("state", "")) == "final"
                    ):
                        self.pending.pop(encounter_id, None)
                        self.last_sent.pop(encounter_id, None)


class BossNameResolver(threading.Thread):
    def __init__(
        self,
        messages: queue.Queue,
        stop_event: threading.Event,
        monster_catalog: dict[str, dict],
    ):
        super().__init__(name="C7BossNames", daemon=True)
        self.messages = messages
        self.stop_event = stop_event
        self.monster_catalog = monster_catalog
        self.requests: queue.Queue = queue.Queue()
        self.requested: set[tuple[int, int, int]] = set()
        self.cached_names = load_json_object(MONSTER_NAME_CACHE_PATH)

    def request(
        self,
        pid: int,
        entity_id: int,
        template_id: int,
        localization_id: int,
        filetime_100ns: int,
    ) -> None:
        if not pid or not entity_id or not template_id or not localization_id:
            return
        key = (pid, entity_id, template_id)
        if key in self.requested:
            return
        self.requested.add(key)
        self.requests.put(
            (pid, entity_id, template_id, localization_id, filetime_100ns)
        )

    def run(self) -> None:
        while not self.stop_event.is_set():
            try:
                first = self.requests.get(timeout=0.2)
            except queue.Empty:
                continue
            batch = [first]
            deadline = time.monotonic() + 0.25
            while time.monotonic() < deadline:
                try:
                    candidate = self.requests.get_nowait()
                except queue.Empty:
                    self.stop_event.wait(0.02)
                    continue
                if candidate[0] == first[0]:
                    batch.append(candidate)
                else:
                    self.requests.put(candidate)
                    break
            localization_ids = {item[3] for item in batch}
            try:
                # v0.3.0 names are offline catalog data, never a runtime
                # localization heap scan. Missing catalog entries stay unknown.
                names = {
                    int(row.get('localization_id', 0) or 0): str(row['name'])
                    for row in self.monster_catalog.values()
                    if isinstance(row, dict) and row.get('name')
                    and int(row.get('localization_id', 0) or 0) in localization_ids
                }
            except Exception as exc:
                self.messages.put(("diagnostic", f"Boss 名称后台解析失败：{exc}"))
                continue
            cache_changed = False
            for _pid, entity_id, template_id, localization_id, timestamp in batch:
                name = str(names.get(localization_id, "")).strip()
                if not name:
                    continue
                self.monster_catalog.setdefault(str(template_id), {})["name"] = name
                if self.cached_names.get(str(template_id)) != name:
                    self.cached_names[str(template_id)] = name
                    cache_changed = True
                self.messages.put(
                    (
                        "profile",
                        {
                            "filetime_100ns": timestamp,
                            "entity_id": entity_id,
                            "template_id": template_id,
                            "name": name,
                            "entity_type": "Boss",
                            "boss_type": 3,
                            "boss_rank": 3,
                        },
                    )
                )
            if cache_changed:
                write_json_object(MONSTER_NAME_CACHE_PATH, self.cached_names)


TEAM_CAPTURE_EVIDENCE_METHODS = frozenset(
    {
        "OnMsgDungeonReadinessCheck",
        "OnMsgDungeonStageSettlement",
        STAGE_COMBAT_STATISTICS_METHOD,
        SETTLEMENT_COMBAT_STATISTICS_METHOD,
        "OnMsgUpdateDungeonBattleStatistics",
        "OnMsgUpdateDungeonTeamPlayerBattleStatistics",
        *TEAM_STATISTICS_METHODS,
        "OnMsgDungeonBotDisplay",
    }
)
SCENE_CAPTURE_RESET_METHODS = SCENE_TRANSITION_METHODS


def settlement_capture_gap_reason(payload: object) -> str | None:
    """Return only a proven lossy-capture reason that blocks settlement."""

    value = payload if isinstance(payload, dict) else {}
    reason = str(value.get("reason") or "network_sequence_gap")
    if reason == "network_sequence_gap":
        return reason
    if reason == "capture_source_changed" and value.get("data_incomplete") is True:
        return "network_sequence_gap"
    return None


def classify_team_stats_mode(
    parser: object,
    batch: dict | None,
    current_mode: object = TEAM_STATS_MODE_UNKNOWN,
) -> tuple[str, str]:
    """Classify only from explicit target/protocol evidence.

    The classifier is deliberately conservative.  A name or a single damage
    amount cannot turn on the active team-RPC hook; exact dummy templates,
    parser-confirmed active Boss state, an explicit multi-player roster, or
    explicit dungeon protocol messages are required.  The returned reason is
    diagnostic-only.
    """
    current_code = normalize_team_stats_mode(
        current_mode, default=TEAM_STATS_MODE_UNKNOWN
    )
    current_name = TEAM_STATS_MODE_NAMES.get(
        current_code, TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_UNKNOWN]
    )
    payload = batch if isinstance(batch, dict) else {}
    records = [
        item
        for item in (payload.get("records", []) or [])
        if isinstance(item, dict)
    ]
    native_boss_records = [
        item
        for item in (payload.get("native_boss_records", []) or [])
        if isinstance(item, dict)
    ]
    methods = {str(item.get("method", "")) for item in records}
    scene_reset = bool(methods & SCENE_CAPTURE_RESET_METHODS)
    explicit_team_protocol = bool(methods & TEAM_CAPTURE_EVIDENCE_METHODS)

    native_dummy = False
    for record in native_boss_records:
        try:
            template_id = int(record.get("template_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            template_id = 0
        if is_training_dummy_template_id(template_id):
            native_dummy = True
            break
        # A localized name is only a secondary fallback when the native record
        # explicitly describes a training target; name alone never promotes a
        # normal entity to dummy mode.
        entity_type = str(record.get("entity_type", "")).casefold()
        if (
            "training" in entity_type
            and is_training_dummy_name(record.get("name", ""))
        ):
            native_dummy = True
            break

    context: dict[str, object] = {}
    getter = getattr(parser, "current_capture_context", None)
    if callable(getter):
        try:
            candidate = getter()
            if isinstance(candidate, dict):
                context = candidate
        except Exception:
            context = {}
    active_target_id = int(context.get("active_target_id", 0) or 0)
    active_target_dummy = bool(
        context.get("active_target_is_training_dummy", False)
    )
    target_dummy = bool(context.get("target_is_training_dummy", False))
    parser_dummy = bool(active_target_dummy or target_dummy)
    parser_non_dummy_boss = bool(context.get("has_non_dummy_boss", False))
    try:
        party_member_count = int(context.get("party_member_count", 0) or 0)
    except (TypeError, ValueError, OverflowError):
        party_member_count = 0
    try:
        party_actor_count = int(context.get("party_actor_count", 0) or 0)
    except (TypeError, ValueError, OverflowError):
        party_actor_count = 0
    try:
        authoritative_token_count = int(
            context.get("authoritative_party_token_count", 0) or 0
        )
    except (TypeError, ValueError, OverflowError):
        authoritative_token_count = 0
    try:
        dungeon_bot_roster_count = int(
            context.get("dungeon_bot_roster_count", 0) or 0
        )
    except (TypeError, ValueError, OverflowError):
        dungeon_bot_roster_count = 0
    roster_team_evidence = bool(
        party_member_count > 1
        or party_actor_count > 1
        or authoritative_token_count > 1
        or dungeon_bot_roster_count > 1
        or (
            bool(context.get("team_group_active"))
            and bool(context.get("explicit_party_roster_seen"))
        )
    )
    # The native ring can deliver a retired dummy object in the same poll as a
    # newly active Boss.  Once the parser has an active non-dummy target, that
    # stronger current-target evidence must win over the stale observation.
    if active_target_id and parser_non_dummy_boss and not active_target_dummy:
        native_dummy = False

    # A full scene transition invalidates all prior target observations.  The
    # native metadata ring is polled before network records, so a dummy object
    # in this same batch may be stale from the previous space; wait for the
    # first post-transition batch before enabling either mode.
    if scene_reset:
        return (
            TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_UNKNOWN],
            "scene_transition",
        )

    # Exact dummy evidence wins over ordinary party/roster hints.  Explicit
    # dungeon protocol is the one exception: it proves the scene is a team
    # encounter even if a stale dummy object is present in the same poll.
    if (native_dummy or parser_dummy) and not explicit_team_protocol:
        return TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_DUMMY], "exact_dummy_template"
    if explicit_team_protocol:
        return TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_TEAM], "dungeon_protocol"
    if roster_team_evidence:
        return TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_TEAM], "multiplayer_party"
    if parser_non_dummy_boss and (active_target_id or context.get("party_seen")):
        return TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_TEAM], "confirmed_boss"
    if current_name == TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_DUMMY] and parser_dummy:
        return current_name, "dummy_state_held"
    if current_name == TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_TEAM]:
        return current_name, "team_state_held"
    return TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_UNKNOWN], "awaiting_scene_evidence"


class LiveHudBossTracker:
    """Project packet-confirmed Boss state into the live HUD only."""

    def __init__(self) -> None:
        self.entities: dict[int, dict[str, object]] = {}
        self.active_entity_id = 0

    @staticmethod
    def _event_epoch(record: dict) -> float:
        try:
            capture_timestamp_ns = int(
                record.get("capture_timestamp_ns", 0) or 0
            )
        except (TypeError, ValueError, OverflowError):
            capture_timestamp_ns = 0
        if capture_timestamp_ns > 0:
            return capture_timestamp_ns / 1_000_000_000
        try:
            filetime = int(record.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            filetime = 0
        if filetime > 116_444_736_000_000_000:
            return (
                filetime - 116_444_736_000_000_000
            ) / 10_000_000
        return time.time()

    @staticmethod
    def _entity_id(record: dict) -> int:
        try:
            entity_id = int(record.get("network_entity_id", 0) or 0)
            script_entity = int(record.get("script_entity", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return 0
        if not entity_id or (script_entity and script_entity != entity_id):
            return 0
        return entity_id

    @staticmethod
    def _snapshot(state: dict[str, object]) -> dict[str, object]:
        return {
            "active": True,
            "entity_id": int(state["entity_id"]),
            "template_id": int(state["template_id"]),
            "boss_type": int(state.get("boss_type", 0) or 0),
            "name": str(state["name"]),
            "icon": str(state["icon"]),
            "level": int(state.get("level", 0) or 0),
            "current_hp": float(state.get("current_hp", 0.0) or 0.0),
            "max_hp": float(state.get("max_hp", 0.0) or 0.0),
            "current_hp_known": bool(state.get("current_hp_known", False)),
            "max_hp_known": bool(state.get("max_hp_known", False)),
            "observed_damage_taken": float(
                state.get("observed_damage_taken", 0.0) or 0.0
            ),
            "started_at_epoch": float(
                state.get("started_at_epoch", 0.0) or 0.0
            ),
            "updated_at_epoch": float(
                state.get("updated_at_epoch", 0.0) or 0.0
            ),
            "source": "npcap_live_hud",
        }

    def clear(self) -> dict[str, object] | None:
        had_active = bool(self.active_entity_id)
        self.entities.clear()
        self.active_entity_id = 0
        if had_active:
            return {"active": False, "source": "npcap_live_hud"}
        return None

    def ingest(self, record: object) -> dict[str, object] | None:
        if not isinstance(record, dict):
            return None
        method = str(record.get("method", "") or "")
        if method in SCENE_TRANSITION_METHODS:
            return self.clear()
        if str(record.get("capture_source", "") or "").casefold() != "npcap":
            return None

        args = record.get("decoded_arguments")
        if method == "NpcapEntityCreated":
            if not isinstance(args, list) or len(args) != 1:
                return None
            entity = args[0]
            if not isinstance(entity, dict) or entity.get("entity_class") != "NpcActor":
                return None
            properties = entity.get("properties")
            if not isinstance(properties, dict):
                return None
            try:
                entity_id = int(entity.get("entity_id", 0) or 0)
                template_id = int(properties.get("TemplateID", 0) or 0)
                boss_type = int(properties.get("BossType", -1))
                level = int(properties.get("Level", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                return None
            if not entity_id or template_id <= 0 or boss_type != 3:
                return None
            alias = LIVE_HUD_BOSS_ALIASES.get(
                template_id, LIVE_HUD_UNKNOWN_BOSS_ALIAS
            )
            self.entities[entity_id] = {
                "entity_id": entity_id,
                "template_id": template_id,
                "boss_type": boss_type,
                "name": alias["name"],
                "icon": alias["icon"],
                "level": level if 1 <= level <= 999 else 0,
                "current_hp": 0.0,
                "max_hp": 0.0,
                "current_hp_known": False,
                "max_hp_known": False,
                "observed_damage_taken": 0.0,
                "active": False,
                "started_at_epoch": 0.0,
                "updated_at_epoch": self._event_epoch(record),
            }
            return None

        entity_id = self._entity_id(record)
        state = self.entities.get(entity_id)
        if state is None or not isinstance(args, list):
            return None
        event_epoch = self._event_epoch(record)

        if method == "OnMsgSyncFightMode" and len(args) == 1:
            try:
                fight_mode = int(args[0])
            except (TypeError, ValueError, OverflowError):
                return None
            if fight_mode == 2:
                if not state.get("active"):
                    state["started_at_epoch"] = event_epoch
                    state["observed_damage_taken"] = 0.0
                state["ended_at_epoch"] = 0.0
                state["active"] = True
                state["updated_at_epoch"] = event_epoch
                self.active_entity_id = entity_id
                return self._snapshot(state)
            if fight_mode == 0 and state.get("active"):
                state["active"] = False
                state["updated_at_epoch"] = event_epoch
                state["ended_at_epoch"] = event_epoch
                if self.active_entity_id == entity_id:
                    self.active_entity_id = 0
                    return {
                        "active": False,
                        "entity_id": entity_id,
                        "ended_at_epoch": event_epoch,
                        "source": "npcap_live_hud",
                    }
            return None

        if method == "OnMsgSyncDirtyFightAttributes" and args:
            attributes = direct_numeric_map(args[0])
            try:
                max_hp = float(attributes[21])
            except (KeyError, TypeError, ValueError, OverflowError):
                return None
            if not math.isfinite(max_hp) or max_hp <= 0:
                return None
            state["max_hp"] = max_hp
            state["max_hp_known"] = True
        elif method == "OnMsgSyncCurrentHp" and len(args) == 1:
            try:
                current_hp = float(args[0])
            except (TypeError, ValueError, OverflowError):
                return None
            if not math.isfinite(current_hp) or current_hp < 0:
                return None
            previous_hp = (
                float(state.get("current_hp", 0.0) or 0.0)
                if state.get("current_hp_known")
                else None
            )
            if (
                state.get("active")
                and previous_hp is not None
                and current_hp < previous_hp
            ):
                state["observed_damage_taken"] = (
                    float(state.get("observed_damage_taken", 0.0) or 0.0)
                    + previous_hp - current_hp
                )
            state["current_hp"] = current_hp
            state["current_hp_known"] = True
        else:
            return None

        state["updated_at_epoch"] = event_epoch
        if state.get("active"):
            return self._snapshot(state)
        try:
            ended_at = float(state.get("ended_at_epoch", 0.0) or 0.0)
        except (TypeError, ValueError, OverflowError):
            ended_at = 0.0
        if (
            method == "OnMsgSyncCurrentHp"
            and current_hp == 0
            and ended_at > 0
            and 0 <= event_epoch - ended_at <= 5.0
        ):
            # Keep parser settlement safety unchanged, but publish the exact
            # post-fight zero to the HUD immediately.  A later repull replaces
            # this presentation state on its next FightMode=2 edge.
            terminal = self._snapshot(state)
            terminal.update(
                active=False,
                terminal_zero=True,
                ended_at_epoch=ended_at,
            )
            return terminal
        return None


class LiveHudCombatTracker:
    """Track packet-confirmed NPC combat for the live HUD clock only."""

    def __init__(self) -> None:
        self.npc_entity_ids: set[int] = set()
        self.active_npc_ids: set[int] = set()
        self.segment_id = 0
        self.started_at_epoch = 0.0
        self.active_started_at_epoch = 0.0
        self.elapsed_seconds = 0.0

    def clear(self, ended_at_epoch: float = 0.0) -> dict[str, object] | None:
        had_active = bool(self.active_npc_ids)
        segment_id = self.segment_id
        started_at_epoch = self.started_at_epoch
        self.npc_entity_ids.clear()
        self.active_npc_ids.clear()
        self.started_at_epoch = 0.0
        self.active_started_at_epoch = 0.0
        self.elapsed_seconds = 0.0
        if not had_active:
            return None
        return {
            "active": False,
            "segment_id": segment_id,
            "started_at_epoch": started_at_epoch,
            "ended_at_epoch": float(ended_at_epoch or time.time()),
            "source": "npcap_live_hud",
        }

    def ingest(self, record: object) -> dict[str, object] | None:
        if not isinstance(record, dict):
            return None
        method = str(record.get("method", "") or "")
        if method in SCENE_TRANSITION_METHODS:
            return self.clear(LiveHudBossTracker._event_epoch(record))
        if str(record.get("capture_source", "") or "").casefold() != "npcap":
            return None

        args = record.get("decoded_arguments")
        if method == "NpcapEntityCreated":
            if not isinstance(args, list) or len(args) != 1:
                return None
            entity = args[0]
            if not isinstance(entity, dict) or entity.get("entity_class") != "NpcActor":
                return None
            try:
                entity_id = int(entity.get("entity_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                return None
            if entity_id:
                self.npc_entity_ids.add(entity_id)
            return None

        if method != "OnMsgSyncFightMode" or not isinstance(args, list) or len(args) != 1:
            return None
        entity_id = LiveHudBossTracker._entity_id(record)
        if entity_id not in self.npc_entity_ids:
            return None
        try:
            fight_mode = int(args[0])
        except (TypeError, ValueError, OverflowError):
            return None
        event_epoch = LiveHudBossTracker._event_epoch(record)
        if fight_mode == 2:
            if entity_id in self.active_npc_ids:
                return None
            was_active = bool(self.active_npc_ids)
            self.active_npc_ids.add(entity_id)
            if was_active:
                return None
            resumed = self.started_at_epoch > 0
            if not resumed:
                self.segment_id += 1
                self.started_at_epoch = event_epoch
                self.elapsed_seconds = 0.0
            self.active_started_at_epoch = event_epoch
            return {
                "active": True,
                "segment_id": self.segment_id,
                "started_at_epoch": self.started_at_epoch,
                "resumed_at_epoch": event_epoch,
                "elapsed_seconds": self.elapsed_seconds,
                "resumed": resumed,
                "source": "npcap_live_hud",
            }
        if fight_mode != 0 or entity_id not in self.active_npc_ids:
            return None
        self.active_npc_ids.discard(entity_id)
        if self.active_npc_ids:
            return None
        self.elapsed_seconds += max(
            0.0, event_epoch - self.active_started_at_epoch
        )
        self.active_started_at_epoch = 0.0
        ended = {
            "active": False,
            "segment_id": self.segment_id,
            "started_at_epoch": self.started_at_epoch,
            "ended_at_epoch": event_epoch,
            "elapsed_seconds": self.elapsed_seconds,
            "paused": True,
            "source": "npcap_live_hud",
        }
        return ended


