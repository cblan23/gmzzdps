        "live_exact_callbacks_unverified": "实时逐包，等待结算校验",
    }.get(str(value or ""), "覆盖状态未知")


def dps_duration_seconds(seconds: object) -> float:
    """Use the same whole-second clock shown in the UI as the DPS divisor."""
    try:
        value = float(seconds)
    except (TypeError, ValueError, OverflowError):
        return 0.0
    if not math.isfinite(value) or value <= 0:
        return 0.0
    return float(max(1, int(value)))


def combat_clock_covers_local_span(
    shared_duration: object, observed_damage_span: object
) -> bool:
    """Reject a shared interval only when it truncates observed damage.

    Clients can discover the pull several seconds apart, so a longer shared
    interval is expected and is precisely what synchronizes a healer with the
    earliest observer.  A shorter interval is impossible for the same fight
    and indicates a stale or prematurely finalized clock.
    """
    try:
        shared_value = float(shared_duration)
        observed_value = float(observed_damage_span)
    except (TypeError, ValueError, OverflowError):
        return False
    if (
        not math.isfinite(shared_value)
        or not math.isfinite(observed_value)
        or shared_value <= 0
        or observed_value < 0
    ):
        return False
    return bool(
        shared_value + COMBAT_CLOCK_SPAN_EPSILON_SECONDS >= observed_value
    )


def combat_clock_sync_interval(snapshot: object) -> float:
    """Keep pull alignment responsive without polling once per second forever."""

    if not isinstance(snapshot, dict):
        return COMBAT_CLOCK_STEADY_INTERVAL_SECONDS
    state = str(snapshot.get("state", "active") or "active").casefold()
    if state in {"settling", "final"}:
        return COMBAT_CLOCK_TRANSITION_INTERVAL_SECONDS
    try:
        elapsed = float(snapshot.get("elapsed_seconds", 0.0) or 0.0)
    except (TypeError, ValueError, OverflowError):
        elapsed = COMBAT_CLOCK_OPENING_WINDOW_SECONDS + 1.0
    if math.isfinite(elapsed) and elapsed <= COMBAT_CLOCK_OPENING_WINDOW_SECONDS:
        return COMBAT_CLOCK_ACTIVE_INTERVAL_SECONDS
    return COMBAT_CLOCK_STEADY_INTERVAL_SECONDS


def combat_clock_interval_covers_local_edges(
    shared_started_at: object,
    shared_ended_at: object,
    local_started_at: object,
    local_ended_at: object,
) -> bool:
    """Confirm that canonical endpoints contain every observed local edge."""

    try:
        shared_start = float(shared_started_at)
        shared_end = float(shared_ended_at)
        local_start = float(local_started_at)
        local_end = float(local_ended_at)
    except (TypeError, ValueError, OverflowError):
        return False
    if not all(
        math.isfinite(value)
        for value in (shared_start, shared_end, local_start, local_end)
    ):
        return False
    if local_start <= 0.0 or local_end < local_start:
        return True
    return bool(
        shared_start <= local_start + COMBAT_CLOCK_ENDPOINT_EPSILON_SECONDS
        and shared_end + COMBAT_CLOCK_ENDPOINT_EPSILON_SECONDS >= local_end
    )


def record_observed_damage_span(record: dict) -> float:
    """Return the longest immutable local damage span carried by a record."""

    spans: list[float] = []
    has_explicit_local_interval = False
    local_interval = record.get("local_event_interval")
    if isinstance(local_interval, dict):
        try:
            local_start = float(
                local_interval.get("started_at_epoch", 0.0) or 0.0
            )
            local_end = float(
                local_interval.get("ended_at_epoch", 0.0) or 0.0
            )
        except (TypeError, ValueError, OverflowError):
            local_start = local_end = 0.0
        if local_start > 0.0 and local_end >= local_start:
            spans.append(local_end - local_start)
            has_explicit_local_interval = True

    event_log = record.get("event_log")
    rows = event_log.get("rows") if isinstance(event_log, dict) else None
    if isinstance(rows, list):
        event_times: list[int] = []
        for row in rows:
            if not isinstance(row, (list, tuple)) or not row:
                continue
            try:
                event_times.append(max(0, int(row[0])))
            except (TypeError, ValueError, OverflowError):
                continue
        if event_times:
            spans.append((max(event_times) - min(event_times)) / 1000.0)

    if not has_explicit_local_interval:
        try:
            started_at = float(record.get("started_at_epoch", 0.0) or 0.0)
            ended_at = float(record.get("ended_at_epoch", 0.0) or 0.0)
        except (TypeError, ValueError, OverflowError):
            started_at = ended_at = 0.0
        if started_at > 0 and ended_at >= started_at:
            spans.append(ended_at - started_at)
    return max((span for span in spans if math.isfinite(span)), default=0.0)


def combat_clock_digest(scope: str, values: object) -> str:
    material = "|".join(str(value) for value in values)
    payload = f"daodao-dps-clock-v1|{scope}|{material}".encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def apply_combat_clock_to_record(
    record: dict, result: CombatClockResult
) -> dict:
    updated = dict(record)
    clock_request = updated.get("_shared_clock_request")
    if str(updated.get("duration_source", "")) == "game_server_team_clock":
        return updated
    if (
        not result.synchronized
        or not result.final
        or str(result.state or "final").casefold() != "final"
        or str(result.encounter_id) != str(updated.get("encounter_id", ""))
        or not result.clock_id
    ):
        return updated

    request = clock_request if isinstance(clock_request, dict) else {}
    expected_party_key = str(
        request.get("party_key", updated.get("combat_clock_party_key", ""))
        or ""
    )
    expected_target_key = str(
        request.get("target_key", updated.get("combat_clock_target_key", ""))
        or ""
    )
    if (
        (expected_party_key and result.party_key != expected_party_key)
        or (expected_target_key and result.target_key != expected_target_key)
    ):
        updated["shared_clock_rejected"] = {
            "clock_id": result.clock_id,
            "reason": "scope_mismatch",
            "party_key_matches": result.party_key == expected_party_key,
            "target_key_matches": result.target_key == expected_target_key,
        }
        return updated
    try:
        requested_revision = max(
            0, int(request.get("client_revision", 0) or 0)
        )
    except (TypeError, ValueError, OverflowError):
        requested_revision = 0
    if requested_revision and result.client_revision < requested_revision:
        updated["shared_clock_rejected"] = {
            "clock_id": result.clock_id,
            "reason": "stale_client_revision",
            "requested_client_revision": requested_revision,
            "accepted_client_revision": result.client_revision,
        }
        return updated
    existing_clock = updated.get("shared_clock")
    try:
        existing_server_revision = max(
            0,
            int(
                existing_clock.get("revision", 0) or 0
                if isinstance(existing_clock, dict)
                else 0
            ),
        )
    except (TypeError, ValueError, OverflowError):
        existing_server_revision = 0
    if (
        existing_server_revision
        and result.revision < existing_server_revision
    ):
        updated["shared_clock_rejected"] = {
            "clock_id": result.clock_id,
            "reason": "stale_server_revision",
            "record_revision": existing_server_revision,
            "server_revision": result.revision,
        }
        return updated

    interval = ResolvedCombatInterval.from_endpoints(
        result.started_at,
        result.ended_at,
        source="server_shared_clock",
        final=True,
    )
    if not interval.valid:
        interval = ResolvedCombatInterval.from_duration(
            result.duration_seconds,
            ended_at_epoch=updated.get("ended_at_epoch", 0.0),
            source="server_shared_clock",
            final=True,
        )
    duration = interval.duration_seconds
    if not interval.valid or duration > COMBAT_CLOCK_MAX_SECONDS:
        return updated
    try:
        reported_duration = float(result.duration_seconds)
    except (TypeError, ValueError, OverflowError):
        return updated
    if (
        not math.isfinite(reported_duration)
        or abs(duration - reported_duration)
        > COMBAT_CLOCK_DURATION_EPSILON_SECONDS
    ):
        updated["shared_clock_rejected"] = {
            "clock_id": result.clock_id,
            "reason": "inconsistent_server_interval",
            "endpoint_duration_seconds": duration,
            "reported_duration_seconds": reported_duration,
        }
        return updated

    try:
        total_damage = max(0, int(updated.get("total_damage", 0) or 0))
    except (TypeError, ValueError, OverflowError):
        total_damage = 0
    if result.total_damage and result.total_damage != total_damage:
        updated["shared_clock_rejected"] = {
            "clock_id": result.clock_id,
            "reason": "total_damage_mismatch",
            "server_total_damage": result.total_damage,
            "local_total_damage": total_damage,
        }
        return updated

    observed_span = record_observed_damage_span(updated)
    if not combat_clock_covers_local_span(duration, observed_span):
        updated["shared_clock_rejected"] = {
            "clock_id": result.clock_id,
            "server_duration_seconds": duration,
            "local_observed_damage_span_seconds": observed_span,
            "shortfall_seconds": max(0.0, observed_span - duration),
            "reason": "shorter_than_local_observed_damage_span",
        }
        return updated
    divisor = interval.divisor_seconds
    if not divisor:
        return updated
    if (
        int(updated.get("total_damage", 0) or 0) <= 0
        and str(updated.get("target_filter", "")) == "healing_dummy"
    ):
        # The shared combat-clock endpoint is a DPS contract.  A pure
        # treatment-dummy record never submits one, and must keep its local
        # healing interval if an old/stale request is encountered.
        return updated
    updated = rebase_relative_combat_logs(
        updated,
        started_at_epoch=interval.started_at_epoch,
        duration_seconds=duration,
    )
    updated.pop("_shared_clock_request", None)
    participants: list[dict] = []
    for raw_participant in updated.get("participants", []):
        if not isinstance(raw_participant, dict):
            continue
        participant = dict(raw_participant)
        try:
            damage = max(0, int(participant.get("damage", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            damage = 0
        participant["dps"] = damage / divisor
        participants.append(participant)
    updated["participants"] = participants
    healers: list[dict] = []
    for raw_healer in updated.get("healers", []):
        if not isinstance(raw_healer, dict):
            continue
        healer = dict(raw_healer)
        try:
            effective_healing = max(
                0, int(healer.get("effective_healing", 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            effective_healing = 0
        healer["hps"] = effective_healing / divisor
        healers.append(healer)
    updated["started_at_epoch"] = interval.started_at_epoch
    updated["ended_at_epoch"] = interval.ended_at_epoch
    updated["started_at"] = interval_iso_timestamp(interval.started_at_epoch)
    updated["ended_at"] = interval_iso_timestamp(interval.ended_at_epoch)
    updated["duration_seconds"] = (
        updated["ended_at_epoch"] - updated["started_at_epoch"]
    )
    updated["dps_duration_seconds"] = divisor
    updated["hps_duration_seconds"] = divisor
    updated["healing_started_at_epoch"] = interval.started_at_epoch
    updated["healing_ended_at_epoch"] = interval.ended_at_epoch
    updated["team_dps"] = total_damage / divisor
    updated["healers"] = healers
    updated["team_hps"] = sum(
        int(healer.get("effective_healing", 0) or 0) for healer in healers
    ) / divisor
    updated["duration_source"] = "server_shared_clock"
    updated["shared_clock"] = {
        "clock_id": result.clock_id,
        "started_at_epoch": result.started_at,
        "ended_at_epoch": result.ended_at,
        "server_time": result.server_time,
        "state": "final",
        "final": True,
        "revision": result.revision,
        "client_revision": result.client_revision,
        "party_key": result.party_key,
        "target_key": result.target_key,
        "total_damage": result.total_damage,
        "accepted": True,
        "local_observed_damage_span_seconds": observed_span,
    }
    event_log = updated.get("event_log")
    if isinstance(event_log, dict):
        timeline = rebuild_dps_timeline(updated)
        if timeline:
            updated["dps_timeline"] = timeline
    team_timeline = rebuild_team_dps_timeline(updated)
    if team_timeline:
        updated["team_dps_timeline"] = team_timeline
    return updated


def relative_damage_bar_ratio(damage: object, highest_damage: object) -> float:
    try:
        value = max(0.0, float(damage))
        maximum = float(highest_damage)
    except (TypeError, ValueError, OverflowError):
        return 0.0
    if not math.isfinite(value) or not math.isfinite(maximum) or maximum <= 0:
        return 0.0
    return max(0.0, min(1.0, value / maximum))


def compact_width_for_visible_metrics(count: object) -> int:
    try:
        index = int(count)
    except (TypeError, ValueError, OverflowError):
        index = 0
    index = min(len(MINI_WIDTH_BY_VISIBLE_METRICS) - 1, max(0, index))
    return MINI_WIDTH_BY_VISIBLE_METRICS[index]


def format_absolute_tk_position(x: object, y: object) -> str:
    """Format absolute Tk coordinates, including positions left/above zero.

    Tk interprets ``-90+100`` as an offset from the right edge. Prefixing each
    numeric coordinate with ``+`` produces ``+-90+100``, which means the true
    desktop coordinate ``(-90, 100)``.
    """
    return f"+{int(x)}+{int(y)}"


def format_absolute_tk_geometry(
    width: object, height: object, x: object, y: object
) -> str:
    return (
        f"{max(1, int(width))}x{max(1, int(height))}"
        f"{format_absolute_tk_position(x, y)}"
    )


def monitor_work_area_for_widget(widget: tk.Misc) -> tuple[int, int, int, int]:
    """Return the work area of the monitor containing the widget's center."""

    try:
        center_x = int(widget.winfo_rootx()) + max(1, int(widget.winfo_width())) // 2
        center_y = int(widget.winfo_rooty()) + max(1, int(widget.winfo_height())) // 2
    except (AttributeError, tk.TclError, TypeError, ValueError, OverflowError):
        center_x = center_y = 0

    if sys.platform == "win32":
        try:
            import ctypes
            from ctypes import wintypes

            class MonitorInfo(ctypes.Structure):
                _fields_ = [
                    ("cbSize", wintypes.DWORD),
                    ("rcMonitor", wintypes.RECT),
                    ("rcWork", wintypes.RECT),
                    ("dwFlags", wintypes.DWORD),
                ]

            user32 = ctypes.windll.user32
            monitor_from_point = user32.MonitorFromPoint
            monitor_from_point.argtypes = (wintypes.POINT, wintypes.DWORD)
            monitor_from_point.restype = wintypes.HANDLE
            get_monitor_info = user32.GetMonitorInfoW
            get_monitor_info.argtypes = (
                wintypes.HANDLE,
                ctypes.POINTER(MonitorInfo),
            )
            get_monitor_info.restype = wintypes.BOOL
            monitor = monitor_from_point(
                wintypes.POINT(center_x, center_y), 2
            )
            info = MonitorInfo()
            info.cbSize = ctypes.sizeof(info)
            if monitor and get_monitor_info(monitor, ctypes.byref(info)):
                work = info.rcWork
                if work.right > work.left and work.bottom > work.top:
                    return work.left, work.top, work.right, work.bottom
        except (AttributeError, OSError, TypeError, ValueError):
            pass

    try:
        left = int(widget.winfo_vrootx())
        top = int(widget.winfo_vrooty())
        width = max(1, int(widget.winfo_vrootwidth()))
        height = max(1, int(widget.winfo_vrootheight()))
    except (AttributeError, tk.TclError, TypeError, ValueError, OverflowError):
        try:
            left = top = 0
            width = max(1, int(widget.winfo_screenwidth()))
            height = max(1, int(widget.winfo_screenheight()))
        except (AttributeError, tk.TclError, TypeError, ValueError, OverflowError):
            return 0, 0, 1, 1
    return left, top, left + width, top + height


def clamp_popup_position(
    x: object,
    y: object,
    width: object,
    height: object,
    work_area: tuple[int, int, int, int],
    *,
    margin: int = 4,
) -> tuple[int, int]:
    """Keep a popup wholly inside one monitor whenever it fits there."""

    left, top, right, bottom = (int(value) for value in work_area)
    popup_width = max(1, int(width))
    popup_height = max(1, int(height))
    inset = max(0, int(margin))
    minimum_x = left + inset
    minimum_y = top + inset
    maximum_x = max(minimum_x, right - inset - popup_width)
    maximum_y = max(minimum_y, bottom - inset - popup_height)
    return (
        max(minimum_x, min(int(x), maximum_x)),
        max(minimum_y, min(int(y), maximum_y)),
    )


def help_popup_position(
    anchor_x: object,
    anchor_y: object,
    anchor_width: object,
    anchor_height: object,
    popup_width: object,
    popup_height: object,
    work_area: tuple[int, int, int, int],
) -> tuple[int, int]:
    """Place help beside its badge without crossing the badge's monitor."""

    anchor_left = int(anchor_x)
    anchor_top = int(anchor_y)
    anchor_right = anchor_left + max(1, int(anchor_width))
    anchor_bottom = anchor_top + max(1, int(anchor_height))
    width = max(1, int(popup_width))
    height = max(1, int(popup_height))
    _left, _top, right, bottom = work_area
    x = anchor_right + 8
    y = anchor_bottom + 5
    if x + width > int(right) - 4:
        x = anchor_left - width - 8
    if y + height > int(bottom) - 4:
        y = anchor_top - height - 5
    return clamp_popup_position(x, y, width, height, work_area)


def dropdown_popup_bounds(
    anchor_x: object,
    anchor_y: object,
    anchor_width: object,
    anchor_height: object,
    popup_width: object,
    desired_height: object,
    work_area: tuple[int, int, int, int],
) -> tuple[int, int, int, int]:
    """Fit a dropdown below or above its control on the same monitor."""

    left, top, right, bottom = (int(value) for value in work_area)
    margin = 4
    gap = 2
    usable_width = max(1, right - left - margin * 2)
    usable_height = max(1, bottom - top - margin * 2)
    width = min(max(1, int(popup_width)), usable_width)
    height = min(max(1, int(desired_height)), usable_height)
    anchor_left = int(anchor_x)
    anchor_top = int(anchor_y)
    anchor_bottom = anchor_top + max(1, int(anchor_height))
    below_y = anchor_bottom + gap
    above_bottom = anchor_top - gap
    below_space = max(0, bottom - margin - below_y)
    above_space = max(0, above_bottom - (top + margin))

    if height <= below_space:
        y = below_y
    elif height <= above_space:
        y = above_bottom - height
    elif below_space >= above_space and below_space > 0:
        height = min(height, below_space)
        y = below_y
    elif above_space > 0:
        height = min(height, above_space)
        y = above_bottom - height
    else:
        y = top + margin

    x, y = clamp_popup_position(
        anchor_left, y, width, height, work_area, margin=margin
    )
    return x, y, width, height


def clipped_overlay_bounds(
    owner_x: object,
    owner_y: object,
    owner_width: object,
    owner_height: object,
    content_x: object,
    content_y: object,
    content_width: object,
    content_height: object,
) -> tuple[int, int, int, int] | None:
    """Clip an auxiliary screen-space window to its visible owner content."""

    try:
        owner_left = int(owner_x)
        owner_top = int(owner_y)
        owner_right = owner_left + max(0, int(owner_width))
        owner_bottom = owner_top + max(0, int(owner_height))
        content_left = int(content_x)
        content_top = int(content_y)
        content_right = content_left + max(0, int(content_width))
        content_bottom = content_top + max(0, int(content_height))
    except (TypeError, ValueError, OverflowError):
        return None

    left = max(owner_left, content_left)
    top = max(owner_top, content_top)
    right = min(owner_right, content_right)
    bottom = min(owner_bottom, content_bottom)
    if right <= left or bottom <= top:
        return None
    return left, top, right - left, bottom - top


def parse_absolute_tk_geometry(value: object) -> tuple[int, int, int, int] | None:
    text = str(value or "").strip()
    absolute = re.fullmatch(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", text)
    if absolute:
        return tuple(int(part) for part in absolute.groups())
    # Accept saved geometry from older builds, where a signed suffix was
    # intended as an absolute desktop coordinate even though Tk interpreted a
    # negative value as a right/bottom-relative offset.
    legacy = re.fullmatch(r"(\d+)x(\d+)([+-]\d+)([+-]\d+)", text)
    if legacy:
        return tuple(int(part) for part in legacy.groups())
    return None


def clamp_geometry_to_work_areas(
    width: int,
    height: int,
    x: int,
    y: int,
    work_areas: list[tuple[int, int, int, int]],
) -> tuple[int, int, int, int]:
    """Recover fully off-screen windows without constraining normal movement.

    A window that intersects any active monitor is already reachable. Keep
    its geometry untouched so it can sit on a secondary monitor or straddle
    two displays. Only a window with no visible intersection is moved to the
    nearest work area (for example after a previously-used monitor is
    disconnected).
    """
    areas = [
        area
        for area in work_areas
        if len(area) == 4 and area[2] > area[0] and area[3] > area[1]
    ]
    if not areas:
        areas = [(0, 0, max(1, width), max(1, height))]
    width = max(1, int(width))
    height = max(1, int(height))
    x = int(x)
    y = int(y)
    window_right = x + width
    window_bottom = y + height

    def intersection_area(area: tuple[int, int, int, int]) -> int:
        left, top, right, bottom = area
        return max(0, min(window_right, right) - max(x, left)) * max(
            0, min(window_bottom, bottom) - max(y, top)
        )

    if any(intersection_area(area) > 0 for area in areas):
        return width, height, x, y

    def area_score(area: tuple[int, int, int, int]) -> tuple[int, int]:
        left, top, right, bottom = area
        center_x = x + width // 2
        center_y = y + height // 2
        nearest_x = min(max(center_x, left), right)
        nearest_y = min(max(center_y, top), bottom)
        distance = (center_x - nearest_x) ** 2 + (center_y - nearest_y) ** 2
        return -distance, -(right - left) * (bottom - top)

    left, top, right, bottom = max(areas, key=area_score)
    width = min(width, right - left)
    height = min(height, bottom - top)
    x = min(max(x, left), right - width)
    y = min(max(y, top), bottom - height)
    return width, height, x, y


def chinese_number(index: int) -> str:
    if 1 <= index <= len(CHINESE_NUMBERS):
        return CHINESE_NUMBERS[index - 1]
    return str(index)


def chinese_error_message(value) -> str:
    text = str(value).strip()
    lower = text.casefold()
    if "process not found" in lower:
        return "游戏未运行"
    if "version/signature mismatch" in lower or "target rva is outside" in lower:
        return "游戏连接正在重新尝试。"
    if "openprocess" in lower:
        return "无法连接游戏进程，请确认游戏已启动。"
    if "ring buffer" in lower:
        return "战斗数据缓冲区异常，正在尝试重新连接。"
    first_line = text.splitlines()[0] if text else "未知错误"
    return f"连接异常：{first_line}"


