[Unit]
Description=Daodao authenticated QQ maintenance (loopback only)
After=network-online.target docker.service

[Service]
User=root
WorkingDirectory=/opt/daodao-card-bot
EnvironmentFile=/etc/gmzz-dps-monitor.env
EnvironmentFile=/opt/daodao-card-bot/.env
ExecStart=/opt/daodao-card-bot/.venv/bin/python -m app.maintenance
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/daodao-card-bot/logs /opt/daodao-card-bot/data
MemoryMax=192M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
