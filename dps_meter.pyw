    def _feedback_selected_histories(self) -> None:
        selected_ids = tuple(sorted(self.history_selected_ids))
        if not selected_ids:
            self._show_notice(
                "反馈选中战斗",
                "请先在战斗列表中勾选至少一场记录。",
                parent=self.history_window,
            )
            return
        self.show_feedback(selected_record_ids=selected_ids)

    def _feedback_selected_history(self) -> None:
        record = self._selected_history_record()
        if record is None:
            return
        self._feedback_history_record(str(record.get("encounter_id", "")))

