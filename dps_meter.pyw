        self.root.withdraw()
        self.root.configure(bg=BG)
        self.root.geometry(self._initial_geometry())
        self.root.minsize(
            self._main_minimum_width(),
            MINI_MIN_HEIGHT if self.compact_mode else MAIN_MIN_HEIGHT,
