    def _settings_check_row(
        self,
        parent: tk.Misc,
        caption: str,
        variable: tk.BooleanVar,
        *,
        disabled: bool,
        row: int,
        column: int,
        help_text: str = "",
    ) -> None:
        cell = tk.Frame(parent, bg=PANEL, height=54)
        cell.grid(
            row=row,
            column=column,
            sticky="ew",
            padx=(8, 14) if column == 0 else (14, 8),
        )
        cell.grid_propagate(False)
        tk.Frame(cell, bg=BORDER, height=1).pack(side="bottom", fill="x")
        control = ModernCheckControl(
            cell,
            caption,
            variable,
            font=self._ui_font("settings"),
            background=PANEL,
            foreground=TEXT,
            disabled=disabled,
            help_text=help_text,
            help_font=self._ui_font("small"),
        )
        control.pack(fill="both", expand=True, padx=4, pady=(8, 7))

    def _set_native_toggle_hotkey(self, hotkey: str) -> bool:
        tray_icon = getattr(self, "tray_icon", None)
        if not hotkey:
            if tray_icon is None:
                return True
            try:
                return bool(tray_icon.set_hotkey(0, 0))
            except (AttributeError, OSError, RuntimeError):
                return False
        parameters = toggle_hotkey_windows_parameters(hotkey)
        if tray_icon is None or parameters is None:
            return False
        try:
            return bool(tray_icon.set_hotkey(*parameters))
        except (AttributeError, OSError, RuntimeError):
            return False

    def _set_toggle_visibility_hotkey_enabled(
        self,
        enabled: bool,
        *,
        persist: bool = True,
    ) -> bool:
        desired = bool(enabled)
        previous_enabled = bool(
            getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        if desired:
            hotkey = self.toggle_visibility_hotkey or DEFAULT_TOGGLE_VISIBILITY_HOTKEY
            self.toggle_visibility_hotkey = hotkey
            if not self._set_native_toggle_hotkey(hotkey):
                self.toggle_visibility_hotkey_enabled = False
                self.toggle_hotkey_registered = False
                self.toggle_hotkey_error = (
                    f"{hotkey} 已被其他程序占用"
                    if getattr(self, "tray_icon", None) is not None
                    else "全局快捷键服务不可用"
                )
                self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = hotkey
                self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = False
                if persist:
                    save_config(self.config)
                self._sync_toggle_hotkey_controls()
                return False
            self.toggle_visibility_hotkey_enabled = True
            self.toggle_hotkey_registered = True
            self.toggle_hotkey_error = ""
        else:
            if not self._set_native_toggle_hotkey(""):
                self.toggle_visibility_hotkey_enabled = previous_enabled
                self.toggle_hotkey_error = "无法停用当前快捷键，请重试"
                self._sync_toggle_hotkey_controls()
                return False
            self.toggle_visibility_hotkey_enabled = False
            self.toggle_hotkey_registered = False
            self.toggle_hotkey_error = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = (
            self.toggle_visibility_hotkey
        )
        self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = (
            self.toggle_visibility_hotkey_enabled
        )
        if persist:
            save_config(self.config)
        self._sync_toggle_hotkey_controls()
        return True

    def _apply_toggle_hotkey_enabled_setting(self, *_args) -> None:
        variable = getattr(self, "settings_hotkey_enabled_var", None)
        if variable is None or getattr(
            self, "toggle_hotkey_enabled_syncing", False
        ):
            return
        try:
            enabled = bool(variable.get())
        except tk.TclError:
            return
        self._set_toggle_visibility_hotkey_enabled(enabled)

    def _register_configured_toggle_hotkey(self) -> bool:
        hotkey = getattr(self, "toggle_visibility_hotkey", "")
        enabled = bool(
            hotkey
            and getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        if not enabled:
            if not hotkey:
                self.toggle_visibility_hotkey_enabled = False
            unregistered = self._set_native_toggle_hotkey("")
            self.toggle_hotkey_registered = False
            self.toggle_hotkey_error = (
                "" if unregistered else "无法停用当前快捷键，请重试"
            )
            self._sync_toggle_hotkey_controls()
            return unregistered
        tray_available = getattr(self, "tray_icon", None) is not None
        registered = self._set_native_toggle_hotkey(hotkey)
        self.toggle_hotkey_registered = registered
        self.toggle_hotkey_error = (
            ""
            if registered
            else (
                f"{hotkey} 已被其他程序占用"
                if tray_available
                else "全局快捷键服务不可用"
            )
        )
        self._sync_toggle_hotkey_controls()
        return registered

    def _sync_toggle_hotkey_controls(
        self,
        status: str | None = None,
        *,
        error: bool = False,
    ) -> None:
        value_label = getattr(self, "settings_hotkey_value_label", None)
        status_label = getattr(self, "settings_hotkey_status_label", None)
        enabled_variable = getattr(self, "settings_hotkey_enabled_var", None)
        capturing = bool(getattr(self, "toggle_hotkey_capture_active", False))
        enabled = bool(
            getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        if enabled_variable is not None:
            try:
                if bool(enabled_variable.get()) != enabled:
                    self.toggle_hotkey_enabled_syncing = True
                    enabled_variable.set(enabled)
            except tk.TclError:
                pass
            finally:
                self.toggle_hotkey_enabled_syncing = False
        if status is None:
            status = getattr(self, "toggle_hotkey_error", "")
            error = bool(status)
        shown_status = str(status or "") if error else ""
        if value_label is not None and value_label.winfo_exists():
            value_label.configure(
                text=(
                    "录入中…"
                    if capturing
                    else (self.toggle_visibility_hotkey or "未设置")
                ),
                fg=(
                    WARN
                    if capturing
                    else (ACCENT if enabled else MUTED)
                ),
                highlightbackground=(
                    ERROR if shown_status else (ACCENT if capturing else BORDER)
                ),
            )
        if status_label is None or not status_label.winfo_exists():
            return
        status_label.configure(text=shown_status, fg=ERROR)

    def _begin_toggle_hotkey_capture(self, _event=None) -> str:
        if self.closing:
            return "break"
        if getattr(self, "toggle_hotkey_registered", False) and not (
            self._set_native_toggle_hotkey("")
        ):
            self._sync_toggle_hotkey_controls(
                "无法暂停当前快捷键，请重试", error=True
            )
            return "break"
        self.toggle_hotkey_registered = False
        self.toggle_hotkey_capture_active = True
        self.toggle_hotkey_capture_modifiers = set()
        self._sync_toggle_hotkey_controls()
        value_label = self.settings_hotkey_value_label
        if value_label is not None and value_label.winfo_exists():
            value_label.focus_set()
        return "break"

    def _capture_toggle_hotkey_key(self, event) -> str | None:
        if not getattr(self, "toggle_hotkey_capture_active", False):
            return None
        keysym = str(getattr(event, "keysym", "") or "")
        folded = keysym.casefold()
        if folded == "escape":
            self._cancel_toggle_hotkey_capture()
            return "break"
        modifier = ""
        if folded in {"control_l", "control_r"}:
            modifier = "Ctrl"
        elif folded in {"alt_l", "alt_r", "iso_level3_shift"}:
            modifier = "Alt"
        elif folded in {"shift_l", "shift_r"}:
            modifier = "Shift"
        if modifier:
            self.toggle_hotkey_capture_modifiers.add(modifier)
            return "break"

        try:
            state = int(getattr(event, "state", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            state = 0
        for held_modifier in self.toggle_hotkey_capture_modifiers:
            state |= {
                "Ctrl": 0x0004,
                "Alt": 0x0008,
                "Shift": 0x0001,
            }[held_modifier]
        candidate = toggle_hotkey_from_tk_event(keysym, state)
        if not candidate:
            self._sync_toggle_hotkey_controls(
                "单键请使用 Home、F1-F12 等功能键", error=True
            )
            return "break"

        previous_hotkey = self.toggle_visibility_hotkey
        enabled = bool(
            getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        if enabled and not self._set_native_toggle_hotkey(candidate):
            restored = self._set_native_toggle_hotkey(previous_hotkey)
            self.toggle_hotkey_registered = bool(previous_hotkey and restored)
            self.toggle_visibility_hotkey_enabled = bool(
                self.toggle_hotkey_registered
            )
            self.toggle_hotkey_error = (
                f"{candidate} 已被其他程序占用"
                if restored
                else f"{previous_hotkey} 暂时无法恢复"
            )
            self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = (
                self.toggle_visibility_hotkey_enabled
            )
            save_config(self.config)
            self._sync_toggle_hotkey_controls()
            return "break"

        self.toggle_visibility_hotkey = candidate
        self.toggle_hotkey_registered = enabled
        self.toggle_hotkey_error = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = candidate
        self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = enabled
        save_config(self.config)
        self._sync_toggle_hotkey_controls()
        return "break"

    def _release_toggle_hotkey_modifier(self, event) -> str | None:
        if not getattr(self, "toggle_hotkey_capture_active", False):
            return None
        folded = str(getattr(event, "keysym", "") or "").casefold()
        modifier = ""
        if folded in {"control_l", "control_r"}:
            modifier = "Ctrl"
        elif folded in {"alt_l", "alt_r", "iso_level3_shift"}:
            modifier = "Alt"
        elif folded in {"shift_l", "shift_r"}:
            modifier = "Shift"
        if modifier:
            self.toggle_hotkey_capture_modifiers.discard(modifier)
            return "break"
        return None

    def _cancel_toggle_hotkey_capture(self, _event=None) -> None:
        if not getattr(self, "toggle_hotkey_capture_active", False):
            return
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        self._register_configured_toggle_hotkey()

    def _clear_toggle_visibility_hotkey(self) -> None:
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        if not self._set_native_toggle_hotkey(""):
            self._sync_toggle_hotkey_controls(
                "无法关闭当前快捷键，请重试", error=True
            )
            return
        self.toggle_visibility_hotkey = ""
        self.toggle_visibility_hotkey_enabled = False
        self.toggle_hotkey_registered = False
        self.toggle_hotkey_error = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = False
        save_config(self.config)
        self._sync_toggle_hotkey_controls()

    def _select_settings_section(self, section: str) -> None:
        if section not in self.backend_settings_frames:
            section = "general"
        for key, frame in self.backend_settings_frames.items():
            if key == section:
                frame.grid(row=0, column=0, sticky="nsew")
            else:
                frame.grid_remove()
        for key, button in self.backend_settings_buttons.items():
            selected = key == section
            button.configure(
                bg=PANEL_2 if selected else BG,
                fg=ACCENT if selected else TEXT,
            )

    def _remember_backend_sidebar_width(self) -> None:
        sidebar = self.backend_sidebar
        if sidebar is None or not sidebar.winfo_exists():
            return
        width = min(420, max(270, int(sidebar.winfo_width())))
        try:
            previous = int(self.config.get("backend_sidebar_width", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            previous = 0
        if previous == width:
            return
        self.config["backend_sidebar_width"] = width
        save_config(self.config)

    def _preview_font_size(self, value: object) -> None:
        if self.settings_font_value_label is None:
            return
        try:
            size = int(round(float(value)))
        except (TypeError, ValueError, OverflowError):
            return
        self.settings_font_value_label.configure(text=f"{size}px")
        self._apply_live_ui_settings()

    def _preview_window_alpha(self, value: object) -> None:
        # Opacity has its own slider callback. Apply the value directly so it
        # cannot be dropped by the guard used while the rest of Settings is
        # still being constructed.
        self._set_window_alpha(value)

    def _apply_live_ui_settings(self, *_args) -> None:
        if (
            not getattr(self, "settings_live_apply_ready", False)
            or getattr(self, "settings_live_apply_running", False)
        ):
            return
        self.settings_live_apply_running = True
        try:
            self._save_ui_settings()
        finally:
            self.settings_live_apply_running = False

    def _save_ui_settings(self) -> None:
        previous_font_size = self.ui_font_size
        if self.settings_font_size_var is not None:
            self.ui_font_size = min(18, max(12, self.settings_font_size_var.get()))
        if self.settings_opacity_var is not None:
            self._set_window_alpha(self.settings_opacity_var.get(), persist=False)
        if self.settings_target_boss_lookup_var is not None:
            self.target_boss_lookup_enabled = bool(
                self.settings_target_boss_lookup_var.get()
            )
            self.worker.set_target_boss_lookup_enabled(
                self.target_boss_lookup_enabled
            )
        if self.settings_show_names_var is not None:
            self.hide_names = not bool(self.settings_show_names_var.get())
        if self.settings_show_damage_var is not None:
            self.show_total_damage = bool(self.settings_show_damage_var.get())
        if self.settings_show_dps_var is not None:
            self.show_dps = bool(self.settings_show_dps_var.get())
        if self.settings_show_share_var is not None:
            self.show_damage_share = bool(self.settings_show_share_var.get())
        if self.settings_show_critical_var is not None:
            self.show_critical_rate = bool(self.settings_show_critical_var.get())
        if self.settings_show_penetration_var is not None:
            self.show_penetration_rate = bool(
                self.settings_show_penetration_var.get()
            )
        if self.settings_keep_dps_bars_opaque_var is not None:
            self.keep_dps_bars_opaque = bool(
                self.settings_keep_dps_bars_opaque_var.get()
            )
            if not self.keep_dps_bars_opaque:
                self._hide_main_content_overlay()
        if self.settings_show_extraordinary_rating_var is not None:
            self.show_extraordinary_rating = bool(
                self.settings_show_extraordinary_rating_var.get()
            )
        if self.settings_team_rating_preview_var is not None:
            self.team_rating_preview_enabled = bool(
                TEAM_RATING_PREVIEW_AVAILABLE
                and self.settings_team_rating_preview_var.get()
            )
            if self._team_rating_preview_active():
                self._hide_main_content_overlay()
        if self.settings_boss_enrage_prediction_var is not None:
            prediction_enabled = bool(
                self.settings_boss_enrage_prediction_var.get()
            )
            if prediction_enabled != self.boss_enrage_prediction_enabled:
                self.boss_enrage_prediction_enabled = prediction_enabled
                self.enrage_predictor.reset()
                self.enrage_prediction = None
                self._set_enrage_prediction_visible(False)
        if self.settings_show_deaths_var is not None:
            self.show_deaths = bool(self.settings_show_deaths_var.get())
        if self.settings_show_revives_var is not None:
            self.show_revives = bool(self.settings_show_revives_var.get())
        if self.settings_show_death_duration_var is not None:
            self.show_death_duration = bool(
                self.settings_show_death_duration_var.get()
            )
        if self.settings_show_taken_var is not None:
            self.show_taken = bool(self.settings_show_taken_var.get())
        if self.settings_show_taken_share_var is not None:
            self.show_taken_share = bool(
                self.settings_show_taken_share_var.get()
            )
        if self.settings_show_boss_damage_var is not None:
            self.show_boss_damage = bool(
                self.settings_show_boss_damage_var.get()
            )
        if self.settings_show_boss_share_var is not None:
            self.show_boss_share = bool(
                self.settings_show_boss_share_var.get()
            )
        if self.settings_show_boss_hits_var is not None:
            self.show_boss_hits = bool(
                self.settings_show_boss_hits_var.get()
            )
        if self.settings_show_boss_max_hit_var is not None:
            self.show_boss_max_hit = bool(
                self.settings_show_boss_max_hit_var.get()
            )
        if self.settings_show_effective_healing_var is not None:
            self.show_effective_healing = bool(
                self.settings_show_effective_healing_var.get()
            )
        if self.settings_show_hps_var is not None:
            self.show_hps = bool(self.settings_show_hps_var.get())
        if self.settings_show_overheal_rate_var is not None:
            self.show_overheal_rate = bool(
                self.settings_show_overheal_rate_var.get()
            )
        self._sync_team_rating_preview_layout(
            self._team_rating_preview_active()
        )
        self._sync_compact_geometry_width()
        self.root.minsize(
            self._main_minimum_width(),
            MINI_MIN_HEIGHT if self.compact_mode else MAIN_MIN_HEIGHT,
        )
        if self.ui_font_size != previous_font_size:
            self._configure_ui_fonts()
        self._sync_action_buttons()
        self._draw_main_header()
        self._draw_main_rows()
        self._schedule_main_content_overlay_sync()
        self._draw_history_participant_header()
        self._render_history_selection()
        self._save_preferences()

    def _sync_history_detail_toolbar_visibility(self, visible: bool) -> None:
        toolbar = getattr(self, "history_detail_sticky_toolbar", None)
        if toolbar is None:
            return
        try:
            if visible:
                toolbar.place(x=0, y=0, relwidth=1.0, height=44)
                toolbar.lift()
            else:
                toolbar.place_forget()
        except (AttributeError, tk.TclError):
            return

    def _show_history_browser(self) -> None:
        browser = getattr(self, "history_browser_frame", None)
        detail = getattr(self, "history_battle_detail_frame", None)
        self._sync_history_detail_toolbar_visibility(False)
        if detail is not None and detail.winfo_manager():
            detail.pack_forget()
        if browser is not None and not browser.winfo_manager():
            browser.pack(fill="both", expand=True)
        self.history_page_mode = "browser"
        self._refresh_history_page_extent()
        self._reset_history_page_scroll()
        self._render_history_snapshot()

    def _open_selected_history_detail(self) -> None:
        if not self.history_selected_id:
            return
        record = self._selected_history_record()
        if record is None:
            self._show_notice(
                "战斗详情",
                "这场战斗的本地文件已不存在，请刷新战斗记录。",
                parent=self.history_window,
            )
            return
        browser = getattr(self, "history_browser_frame", None)
        detail = getattr(self, "history_battle_detail_frame", None)
        if browser is not None and browser.winfo_manager():
            browser.pack_forget()
        if detail is not None and not detail.winfo_manager():
            detail.pack(fill="both", expand=True)
        self.history_page_mode = "detail"
        self._sync_history_detail_toolbar_visibility(True)
        self._refresh_history_page_extent()
        self._reset_history_page_scroll()
        self._render_history_selection()
        self._draw_history_detail_result()
        self._draw_history_detail_hero()

    def _set_history_time_filter(self, value: str) -> None:
        if self.history_filter_time_var is None:
            return
        self.history_filter_time_var.set(str(value))
        self._sync_history_time_buttons()
        self._history_filter_changed()

    def _sync_history_time_buttons(self) -> None:
        selected = (
            self.history_filter_time_var.get()
            if self.history_filter_time_var is not None
            else "近30天"
        )
        for value, button in getattr(self, "history_time_buttons", {}).items():
            active = value == selected
            button.configure(
                bg="#17342c" if active else SURFACE,
                fg=ACCENT if active else MUTED,
            )

    def _history_filter_payload(self) -> dict[str, object]:
        filters: dict[str, object] = {"boss_only": True}
        time_value = (
            self.history_filter_time_var.get()
            if self.history_filter_time_var is not None
            else "近30天"
        )
        now = dt.datetime.now().astimezone()
        today = now.replace(hour=0, minute=0, second=0, microsecond=0)
        if time_value == "今天":
            filters["start_epoch"] = today.timestamp()
        elif time_value == "近3天":
            filters["start_epoch"] = (today - dt.timedelta(days=2)).timestamp()
        elif time_value == "近7天":
            filters["start_epoch"] = (today - dt.timedelta(days=6)).timestamp()
        elif time_value == "近30天":
            filters["start_epoch"] = (today - dt.timedelta(days=29)).timestamp()
        elif time_value == "近90天":
            filters["start_epoch"] = (today - dt.timedelta(days=89)).timestamp()
        filters["query"] = self._history_filter_value("query")

        if self.history_filter_dungeon_var is not None:
            selected_dungeon = self.history_filter_dungeon_var.get()
            if selected_dungeon != "全部":
                dungeon = selected_dungeon
                filters["dungeon"] = dungeon
                filters["dungeon_aliases"] = list(
                    HISTORY_DUNGEON_ALIASES.get(dungeon, (dungeon,))
                )
                filters["dungeon_bosses"] = list(
                    HISTORY_DUNGEON_BOSSES.get(dungeon, ())
                )
                if dungeon == "木桩":
                    filters["boss_only"] = False
        if self.history_filter_boss_var is not None:
            selected_boss = self.history_filter_boss_var.get()
            if selected_boss != "全部":
                boss = selected_boss
                filters["boss"] = boss
                filters["boss_aliases"] = list(
                    HISTORY_BOSS_ALIASES.get(boss, (boss,))
                )
        result_map = {
            "胜利": (RESULT_DEFEATED,),
            "失败": "failed",
            "中断": (RESULT_INTERRUPTED, RESULT_UNDETERMINED),
        }
        if self.history_filter_result_var is not None:
            result = result_map.get(self.history_filter_result_var.get())
            if result:
                if isinstance(result, tuple):
                    filters["results"] = list(result)
                else:
                    filters["result"] = result
        return filters

    def _history_sort_key(self) -> str:
        value = self.history_sort_var.get() if self.history_sort_var else "时间最新"
        sort_key = {
            "时间最新": "time_desc",
            "时间最早": "time_asc",
            "DPS最高": "dps_desc",
            "DPS最低": "dps_asc",
            "伤害最高": "damage_desc",
            "伤害最低": "damage_asc",
            "时长最长": "duration_desc",
            "时长最短": "duration_asc",
        }.get(value, "time_desc")
        if (
            getattr(self, "history_meter_mode", "dps") == "boss_damage"
            and sort_key in {"damage_desc", "damage_asc"}
        ):
            return f"boss_{sort_key}"
        return sort_key

    def _history_filter_changed(self) -> None:
        if self.history_window is None or not self.history_window.winfo_exists():
            return
        self._sync_history_time_buttons()
        self.history_page_number = 1
        previous = self.history_filter_after_id
        if previous is not None:
            try:
                self.history_window.after_cancel(previous)
            except tk.TclError:
                pass
        self.history_filter_after_id = self.history_window.after(
            300, self._query_history_records
        )

    def _history_dungeon_filter_changed(self) -> None:
        self._sync_history_boss_filter_options()
        self._history_filter_changed()

    def _history_page_size_changed(self) -> None:
        if self.history_page_size_var is None:
            return
        match = re.search(r"(10|20|50|100)", self.history_page_size_var.get())
        if match is None:
            return
        self.history_page_size = int(match.group(1))
        self.config["history_page_size"] = self.history_page_size
        self._save_preferences()
        self.history_page_number = 1
        self._query_history_records()

    def _clear_history_filters(self) -> None:
        if self.history_filter_time_var is not None:
            self.history_filter_time_var.set("近30天")
        if self.history_filter_dungeon_var is not None:
            self.history_filter_dungeon_var.set("全部")
        if self.history_filter_boss_var is not None:
            self.history_filter_boss_var.set("全部")
        if self.history_filter_result_var is not None:
            self.history_filter_result_var.set("战斗结果  全部")
        if self.history_sort_var is not None:
            self.history_sort_var.set("时间最新")
        for entry in self.history_filter_entries.values():
            entry.reset()
        self._sync_history_time_buttons()
        self.history_page_number = 1
        self._query_history_records()

    def _update_history_filter_options(self) -> None:
        self._sync_history_boss_filter_options()

    def _sync_history_boss_filter_options(self) -> None:
        selected_dungeon = (
            self.history_filter_dungeon_var.get()
            if self.history_filter_dungeon_var is not None
            else "全部"
        )
        if selected_dungeon == "全部":
            names = tuple(
                boss
                for bosses in HISTORY_DUNGEON_BOSSES.values()
                for boss in bosses
            )
        else:
            names = HISTORY_DUNGEON_BOSSES.get(selected_dungeon, ())
        boss_choices = ["全部", *names]
        boss_dropdown = self.history_filter_dropdowns.get("boss")
        if boss_dropdown is not None:
            boss_dropdown.choices = tuple(boss_choices)
        if (
            self.history_filter_boss_var is not None
            and self.history_filter_boss_var.get() not in boss_choices
        ):
            self.history_filter_boss_var.set("全部")

    def _query_history_records(self) -> None:
        self.history_filter_after_id = None
        try:
            filters = self._history_filter_payload()
            result = self.history_store.query_summaries(
                filters,
                page=self.history_page_number,
                page_size=self.history_page_size,
                sort=self._history_sort_key(),
            )
            total = int(result.get("total", 0) or 0)
            balanced_page_size = self._balanced_history_page_size(
                total, self.history_page_size
            )
            if balanced_page_size != self.history_page_size:
                result = self.history_store.query_summaries(
                    filters,
                    page=int(result.get("page", self.history_page_number) or 1),
                    page_size=balanced_page_size,
                    sort=self._history_sort_key(),
                )
            overview = self.history_store.history_overview(filters)
        except (OSError, TypeError, ValueError):
            result = {
                "records": [],
                "total": 0,
                "page": 1,
                "page_count": 1,
            }
            overview = {}
        self.history_effective_page_size = int(
            result.get("page_size", self.history_page_size)
            or self.history_page_size
        )
        previous_id = self.history_selected_id
        self.history_records = list(result.get("records", []))
        self.history_total_records = int(result.get("total", 0) or 0)
        self.history_page_number = int(result.get("page", 1) or 1)
        self.history_page_count = int(result.get("page_count", 1) or 1)
        current_page_ids = {
            str(row.get("battle_id", row.get("encounter_id", "")))
            for row in self.history_records
        }
        if previous_id not in current_page_ids:
            self.history_selected_id = (
                str(
                    self.history_records[0].get(
                        "battle_id", self.history_records[0].get("encounter_id", "")
                    )
                )
                if self.history_records
                else ""
            )
            self.history_selected_actor = 0
            self.history_loaded_record = None
        self.history_overview_data = overview
        if self.history_count_label is not None:
            selected = len(self.history_selected_ids)
            suffix = f" · 已选 {selected}" if selected else ""
            self.history_count_label.configure(
                text=f"共 {self.history_total_records} 场{suffix}"
            )
        self._update_history_overview()
        self._draw_history_list()
        if self.history_window is not None and self.history_window.winfo_exists():
            self.history_window.after_idle(self._update_history_overview)
            self.history_window.after_idle(self._draw_history_list)
        self._draw_history_pagination()
        self._render_history_snapshot()
        self._sync_history_selection_controls()
        if self.history_page_mode == "detail":
            self._render_history_selection()

