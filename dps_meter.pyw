        canvas.itemconfigure(
            f"{tag}:icon",
            image=self.icons.toolbar(icon_name, 13, foreground),
        )
        canvas.configure(cursor="hand2" if hovered else "")

    def _hide_pvp_history_roster_tooltip(self, _event=None) -> None:
        popup = getattr(self, "history_pvp_roster_tooltip", None)
        self.history_pvp_roster_tooltip = None
        if popup is not None:
            try:
                if popup.winfo_exists():
                    popup.destroy()
            except tk.TclError:
                pass

    def _show_pvp_history_roster_tooltip(self, event, description: str) -> None:
        self._hide_pvp_history_roster_tooltip()
        description = str(description or "").strip()
        if not description or getattr(self, "closing", False):
            return
        try:
            popup = tk.Toplevel(self.root)
            self.history_pvp_roster_tooltip = popup
            popup.withdraw()
            popup.overrideredirect(True)
            popup.configure(bg="#28465d")
            popup.transient(self.root)
            tk.Label(
                popup,
                text=description,
                bg="#101923",
                fg=TEXT,
                padx=9,
                pady=5,
                bd=0,
                justify="left",
                font=self._ui_font("micro"),
            ).pack(fill="both", expand=True, padx=1, pady=1)
            popup.update_idletasks()
            x = min(
                int(event.x_root) + 12,
                max(0, popup.winfo_screenwidth() - popup.winfo_reqwidth() - 8),
            )
            y = min(
                int(event.y_root) + 12,
                max(0, popup.winfo_screenheight() - popup.winfo_reqheight() - 8),
            )
            popup.geometry(
                format_absolute_tk_geometry(
                    popup.winfo_reqwidth(), popup.winfo_reqheight(), x, y
                )
            )
            popup.deiconify()
            self._set_window_topmost_noactivate(
                popup,
                self._preferred_main_topmost()
                or bool(getattr(self, "window_locked", False)),
            )
        except (AttributeError, tk.TclError):
            self._hide_pvp_history_roster_tooltip()

    def _draw_pvp_history_roster_preview(
        self,
        canvas: tk.Canvas,
        allies: list[dict],
        enemies: list[dict],
        team_size: int,
        left: int,
        right: int,
        top: int,
        row_index: int,
        row_tag: str,
        hide_names: bool,
        *,
        hunter_city: bool = False,
    ) -> dict[str, object]:
        if hunter_city:
            width = max(1, right - left)
            canvas.create_text(
                (left + right) / 2, top + 16,
                text=f"我方 · {len(allies)} 人",
                fill=ACCENT, font=self._ui_font("micro"), tags=(row_tag,),
            )
            visible = allies[:4]
            if not visible:
                canvas.create_text(
                    (left + right) / 2, top + 56, text="名单未获取",
                    fill=MUTED, font=self._ui_font("micro"), tags=(row_tag,),
                )
                return {"allies": {"rows": [], "omitted": 0}}
            gap = max(30, min(40, (width - 16) // len(visible)))
            start = (left + right) / 2 - gap * (len(visible) - 1) / 2
            for index, actor in enumerate(visible):
                x = start + index * gap
                item_tag = f"hunter-roster:{row_index}:{index}"
                icon = self._history_profession_icon(
                    int(actor.get("profession_id", 0) or 0), 21
                )
                canvas.create_image(
                    x, top + 51, image=icon, tags=(row_tag, item_tag)
                )
                name = self._history_actor_name(actor, index, hide_names)
                rating = actor.get("extraordinary_rating")
                canvas.create_text(
                    x, top + 84,
                    text=("本人" if actor.get("is_self") and hide_names else name),
                    fill=TEXT, font=self._ui_font("micro"),
                    tags=(row_tag, item_tag),
                )
                canvas.tag_bind(
                    item_tag, "<Enter>",
                    lambda event, text=(
                        f"{name}\n非凡评分 "
                        + (f"{rating:,}" if rating is not None else "未获取")
                    ): self._show_pvp_history_roster_tooltip(event, text),
                )
                canvas.tag_bind(
                    item_tag, "<Leave>", self._hide_pvp_history_roster_tooltip
                )
            if len(allies) > len(visible):
                canvas.create_text(
                    right - 8, top + 84,
                    text=f"+{len(allies) - len(visible)}",
                    fill=SUBTLE, anchor="e", font=self._ui_font("micro"),
                    tags=(row_tag,),
                )
            return {"allies": {"rows": visible, "omitted": max(0, len(allies) - len(visible))}}
        preview = self._pvp_roster_preview(allies, enemies, team_size)
        width = max(1, right - left)
        center = (left + right) / 2
        versus_gap = 26 if width >= 180 else 18
        group_gap = 5 if width >= 210 else 3 if width >= 140 else 1
        group_width = max(1, (width - versus_gap - 12) / 2)
        group_centers = (
            left + 4 + group_width / 2,
            right - 4 - group_width / 2,
        )
        icon_y = top + 53
        canvas.create_text(
            center,
            icon_y,
            text="VS",
            fill=ERROR,
            font=self._ui_font("micro"),
            tags=(row_tag,),
        )

        for side_index, (caption, payload, color) in enumerate(
            (
                ("我方", preview["allies"], ACCENT),
                ("敌方", preview["enemies"], ERROR),
            )
        ):
            rows = payload["rows"]
            count = max(1, len(rows))
            icon_size = max(
                9,
                min(
                    24 if width >= 220 else 19 if width >= 150 else 13,
                    int((group_width - group_gap * (count - 1)) / count),
                ),
            )
            total_width = count * icon_size + max(0, count - 1) * group_gap
            start_x = group_centers[side_index] - total_width / 2 + icon_size / 2
            canvas.create_text(
                group_centers[side_index],
                top + 17,
                text=caption,
                fill=color,
                font=self._ui_font("micro"),
                tags=(row_tag,),
            )
            for actor_index, actor in enumerate(rows):
                x = start_x + actor_index * (icon_size + group_gap)
                item_tag = f"pvp-roster:{row_index}:{side_index}:{actor_index}"
                is_self = bool(actor.get("is_self"))
                is_lowest = bool(actor.get("preview_lowest")) and team_size > 1
                canvas.create_oval(
                    x - icon_size / 2 - 2,
                    icon_y - icon_size / 2 - 2,
                    x + icon_size / 2 + 2,
                    icon_y + icon_size / 2 + 2,
                    fill="#0b1117",
                    outline="#53616d",
                    width=1,
                    tags=(row_tag, item_tag),
                )
                icon = self._history_profession_icon(
                    int(actor.get("profession_id", 0) or 0), icon_size
                )
                canvas.create_image(
                    x,
                    icon_y,
                    image=icon,
                    anchor="center",
                    tags=(row_tag, item_tag),
                )
                if is_lowest:
                    canvas.create_text(
                        x + icon_size / 2 + 2,
                        icon_y + icon_size / 2 + 4,
                        text="低",
                        fill="#ef9b5b",
                        anchor="ne",
                        font=self._ui_font("micro"),
                        tags=(row_tag, item_tag),
                    )
                shown_name = (
                    "本人"
                    if hide_names and is_self
                    else self._history_actor_name(actor, actor_index, hide_names)
                )
                tooltip_lines = [shown_name]
                if team_size != 3:
                    rating = actor.get("extraordinary_rating")
                    tooltip_lines.append(
                        "非凡评分  --" if rating is None else f"非凡评分  {int(rating):,}"
                    )
                if actor.get("is_ai"):
                    tooltip_lines.append("竞技人机")
                description = "\n".join(tooltip_lines)
                canvas.tag_bind(
                    item_tag,
                    "<Enter>",
                    lambda event, text=description: self._show_pvp_history_roster_tooltip(
                        event, text
                    ),
                )
                canvas.tag_bind(
                    item_tag,
                    "<Leave>",
                    self._hide_pvp_history_roster_tooltip,
                )
                if team_size == 1 and width >= 150:
                    canvas.create_text(
                        x,
                        top + 83,
                        text=self._fit_ui_text(
                            shown_name, max(30, int(group_width - 4)), "micro"
                        ),
                        fill=TEXT,
                        anchor="center",
                        font=self._ui_font("micro"),
                        tags=(row_tag, item_tag),
                    )
            omitted = int(payload["omitted"] or 0)
            if omitted:
                canvas.create_text(
                    group_centers[side_index],
                    top + 88,
                    text=f"+{omitted}",
                    fill=SUBTLE,
                    anchor="center",
                    font=self._ui_font("micro"),
                    tags=(row_tag,),
                )
        return preview

    def _draw_pvp_history_list(self) -> None:
        """Render mode, match, performance, matchup and result at a glance."""

        canvas = getattr(self, "history_list_canvas", None)
        if canvas is None:
            return
        self._hide_pvp_history_roster_tooltip()
        canvas.delete("all")
        viewport_width = max(1, int(canvas.winfo_width() or 1))
        columns = self._pvp_history_list_columns(viewport_width)
        width = columns["width"]
        height = max(1, int(canvas.winfo_height() or 1))
        records = [
            row for row in getattr(self, "history_records", ())
            if isinstance(row, dict)
        ]
        if not records:
            canvas.create_text(
                viewport_width // 2,
                height // 2 - 16,
                text="暂无竞技战绩",
                fill=TEXT,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                viewport_width // 2,
                height // 2 + 8,
                text="完成一场 PvP 对决后，记录会自动出现在这里",
                fill=MUTED,
                font=self._ui_font("micro"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        row_height = 112
        action_left = columns["action_left"]
        result_left = columns["result_left"]
        matchup_left = columns["matchup_left"]
        performance_left = columns["performance_left"]
        preview_left = columns["preview_left"]
        info_left = columns["info_left"]
        info_meta_left = columns["info_meta_left"]
        hide_names = self._history_names_hidden()
        for index, summary in enumerate(records):
            top = index * row_height
            bottom = top + row_height
            middle = top + row_height // 2
            battle_id = str(
                summary.get("battle_id", summary.get("encounter_id", ""))
            )
            selected = battle_id == getattr(self, "history_selected_id", "")
            base = PANEL_2 if selected else (PANEL if index % 2 == 0 else SURFACE)
            accent = ACCENT if selected else blend_color(BORDER, ACCENT, 0.28)
            tag = f"history:{index}"
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline="", tags=(tag,)
            )
            canvas.create_rectangle(
                0, top, 3, bottom - 1, fill=accent, outline="", tags=(tag,)
            )
            mode_name = str(summary.get("stage_name") or "PvP").strip()
            map_name = str(summary.get("dungeon_name") or "未知地图").strip()
            team_size = int(summary.get("team_size", 0) or 0)
            mode_badge = f"{team_size}V{team_size}" if team_size in {1, 3, 6, 12} else "PvP"
            mode_color = {
                1: "#e6bd62",
                3: "#55c7a8",
                6: "#6f9cff",
                12: "#b58ae8",
            }.get(team_size, PVP_MODE_FOREGROUND)
            icon = self.icons.pvp_mode(
                mode_name,
                map_name,
                team_size,
                size=44,
            )
            # PhotoImage uses the physical DPI-scaled size while the previous
            # north-west placement assumed a fixed 50 px icon.  At 125%/150%
            # scaling its visual center therefore drifted right of the text.
            # Anchor both elements to the same mode-column center instead.
            mode_center_x = max(28, columns["info_left"] // 2)
            badge_font = self._ui_font("micro")
            try:
                icon_height = max(1, int(icon.height()))
            except (AttributeError, TypeError, ValueError, tk.TclError):
                icon_height = 44
            try:
                badge_height = max(1, int(badge_font.metrics("linespace")))
            except (AttributeError, TypeError, ValueError, tk.TclError):
                badge_height = 12
            mode_gap = 5
            mode_group_top = middle - (
                icon_height + mode_gap + badge_height
            ) / 2
            mode_icon_y = mode_group_top + icon_height / 2
            mode_badge_y = (
                mode_group_top + icon_height + mode_gap + badge_height / 2
            )
            canvas.create_image(
                mode_center_x,
                mode_icon_y,
                image=icon,
                anchor="center",
                tags=(tag,),
            )
            canvas.create_text(
                mode_center_x,
                mode_badge_y,
                text=mode_badge,
                fill=mode_color,
                anchor="center",
                font=badge_font,
                tags=(tag,),
            )

            info_width = max(24, info_meta_left - info_left - 8)
            meta_width = max(
                24, columns["info_right"] - info_meta_left - 6
            )
            canvas.create_text(
                info_left,
                top + 39,
                text=self._fit_ui_text(mode_name, info_width, "strong"),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
                tags=(tag,),
            )
            canvas.create_text(
                info_left,
                top + 75,
                text=self._fit_ui_text(map_name, info_width, "micro"),
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            try:
                occurred_text = dt.datetime.fromtimestamp(
                    float(summary.get("started_at_epoch", 0.0) or 0.0)
                ).strftime("%m/%d")
            except (OSError, OverflowError, TypeError, ValueError):
                occurred_text = "时间未知"
            canvas.create_text(
                info_meta_left,
                top + 39,
                text=self._fit_ui_text(occurred_text, meta_width, "micro"),
                fill=SUBTLE,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            canvas.create_text(
                info_meta_left,
                top + 75,
                text=self._fit_ui_text(
                    self._history_optional_duration(summary.get("duration_seconds")),
                    meta_width,
                    "micro",
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )

            canvas.create_line(
                preview_left - 6,
                top + 12,
                preview_left - 6,
                bottom - 12,
                fill=BORDER,
            )
            allies, enemies, _ = self._pvp_snapshot_rosters(summary)
            self._draw_pvp_history_roster_preview(
                canvas,
                allies,
                enemies,
                team_size,
                preview_left,
                performance_left - 10,
                top,
                index,
                tag,
                hide_names,
                hunter_city=int(summary.get("map_id", 0) or 0) in HUNTER_CITY_MAPS,
            )

            canvas.create_line(
                performance_left - 6,
                top + 12,
                performance_left - 6,
                bottom - 12,
                fill=BORDER,
            )
            canvas.create_text(
                performance_left + 4,
                top + 18,
                text="我的表现",
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            kills = self._history_optional_number(summary.get("kills"))
            assists = self._history_optional_number(summary.get("assists"))
            deaths = self._history_optional_number(summary.get("deaths"))
            if team_size == 1:
                performance_lines = (f"击败  {kills}", f"阵亡  {deaths}")
            else:
                performance_lines = (
                    f"击杀 {kills}  助攻 {assists}",
                    f"阵亡 {deaths}",
                )
            for line_index, line in enumerate(performance_lines):
                canvas.create_text(
                    performance_left + 4,
                    top + 43 + line_index * 21,
                    text=line,
                    fill=TEXT if line_index == 0 else ERROR,
                    anchor="w",
                    font=self._ui_font("micro"),
                    tags=(tag,),
                )
            canvas.create_text(
                performance_left + 4,
                top + 91,
                text=f"伤害  {self._history_optional_number(summary.get('my_damage'))}",
                fill=ACCENT if selected else TEXT,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )

            canvas.create_line(
                matchup_left - 6,
                top + 12,
                matchup_left - 6,
                bottom - 12,
                fill=BORDER,
            )
            hunter_city = int(summary.get("map_id", 0) or 0) in HUNTER_CITY_MAPS
            matchup = (
                {
                    "title": "我方平均评分",
                    "rows": (("当前名单", self._history_optional_number(
                        self._pvp_roster_rating_stats(allies).get("average")
                    )),),
                    "footer": "",
                    "ratings_visible": True,
                }
                if hunter_city else self._pvp_history_matchup_summary(
                    allies, enemies, team_size
                )
            )
            canvas.create_text(
                matchup_left + 4,
                top + 18,
                text=matchup["title"],
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            for row_index, ((caption, shown), color) in enumerate(
                zip(matchup["rows"], (ACCENT, ERROR))
            ):
                canvas.create_text(
                    matchup_left + 4,
                    top + 43 + row_index * 24,
                    text=f"{caption}  {shown}",
                    fill=(
                        color
                        if not matchup["ratings_visible"] or shown != "--"
                        else MUTED
                    ),
                    anchor="w",
                    font=self._ui_font("micro"),
                    tags=(tag,),
                )
            if matchup["footer"]:
                canvas.create_text(
                    matchup_left + 4,
                    top + 94,
                    text=matchup["footer"],
                    fill=SUBTLE,
                    anchor="w",
                    font=self._ui_font("micro"),
                    tags=(tag,),
                )

            self._draw_history_result_badge(
                canvas,
                action_left - 4,
                middle,
                summary.get("result"),
                base,
                (tag,),
            )
            action_tags = self._draw_pvp_history_inline_actions(
                canvas,
                action_left + 4,
                top + 24,
                index,
                bool(summary.get("favorite", False)),
            )
            canvas.create_line(0, bottom - 1, width, bottom - 1, fill=BORDER)

            canvas.tag_bind(
                tag,
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._select_history(selected_id),
            )
            canvas.tag_bind(
                tag,
                "<Double-Button-1>",
                lambda _event, selected_id=battle_id: (
                    self._select_history(selected_id),
                    self._open_selected_history_detail(),
                ),
            )
            canvas.tag_bind(
                action_tags["view"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: (
                    self._select_history(selected_id),
                    self._open_selected_history_detail(),
                ),
            )
            canvas.tag_bind(
                action_tags["share"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: (
                    self._select_history(selected_id),
                    self._share_history(),
                ),
            )
            canvas.tag_bind(
                action_tags["favorite"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._toggle_history_favorite_by_id(
                    selected_id
                ),
            )
            for kind in ("view", "share", "favorite"):
                action_tag = action_tags.get(kind)
                if not action_tag:
                    continue
                canvas.tag_bind(
                    action_tag,
                    "<Enter>",
                    lambda _event, selected_index=index, selected_kind=kind, selected_favorite=bool(summary.get("favorite", False)): self._set_pvp_history_action_hover(
                        canvas,
                        selected_index,
                        selected_kind,
                        True,
                        favorite=selected_favorite,
                    ),
                )
                canvas.tag_bind(
                    action_tag,
                    "<Leave>",
                    lambda _event, selected_index=index, selected_kind=kind, selected_favorite=bool(summary.get("favorite", False)): self._set_pvp_history_action_hover(
                        canvas,
                        selected_index,
                        selected_kind,
                        False,
                        favorite=selected_favorite,
                    ),
                )
            canvas.tag_bind(
                tag,
                "<Enter>",
                lambda _event: canvas.configure(cursor="hand2"),
            )
            canvas.tag_bind(
                tag,
                "<Leave>",
                lambda _event: canvas.configure(cursor=""),
            )
        canvas.configure(
            scrollregion=(0, 0, width, max(height, len(records) * row_height))
        )

    def _draw_indexed_history_list(self) -> None:
        canvas = self.history_list_canvas
        if canvas is None:
            return
        if getattr(self, "backend_current_page", "history") == "kings":
            self._draw_pvp_history_list()
            return
        canvas.delete("all")
        viewport_width = max(1, canvas.winfo_width())
        width = self._history_list_content_width(viewport_width)
        height = max(1, canvas.winfo_height())
        if not self.history_records:
            filtered = bool(
                self._history_filter_value("query")
                or (
                    self.history_filter_time_var is not None
                    and self.history_filter_time_var.get() != "全部"
                )
                or (
                    self.history_filter_result_var is not None
                    and self.history_filter_result_var.get() != "战斗结果  全部"
                )
            )
            canvas.create_text(
                viewport_width // 2,
                height // 2 - 18,
                text=(
                    "没有找到符合条件的战斗记录"
                    if filtered
                    else "暂无竞技战斗记录"
                    if getattr(self, "backend_current_page", "history") == "kings"
                    else "暂无 Boss 战斗记录"
                ),
                fill=TEXT,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                viewport_width // 2,
                height // 2 + 5,
                text=(
                    "清除筛选条件"
                    if filtered
                    else "完成一次有效 Boss 战斗后，记录会自动出现在这里"
                ),
                fill=ACCENT if filtered else MUTED,
                font=self._ui_font("micro"),
                tags=("history-clear-filters",) if filtered else (),
            )
            if filtered:
                canvas.tag_bind(
                    "history-clear-filters",
                    "<Button-1>",
                    lambda _event: self._clear_history_filters(),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        base_row_height = 68
        content_height = len(self.history_records) * base_row_height
        if self.history_page_count > 1:
            content_height = max(content_height, height)
        canvas.configure(yscrollincrement=base_row_height)
        columns = self._history_list_columns(width)
        right = columns["right"]
        for index, summary in enumerate(self.history_records):
            top = round(index * content_height / len(self.history_records))
            bottom = round(
                (index + 1) * content_height / len(self.history_records)
            )
            row_height = bottom - top
            middle = top + row_height // 2
            primary_y = middle - 14
            secondary_y = middle + 11
            battle_id = str(
                summary.get("battle_id", summary.get("encounter_id", ""))
            )
            selected = battle_id == self.history_selected_id
            checked = battle_id in self.history_selected_ids
            base = PANEL_2 if selected else (PANEL if index % 2 == 0 else SURFACE)
            tag = f"history:{index}"
            check_tag = f"history-check:{index}"
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline="", tags=(tag,)
            )
            canvas.create_rectangle(
                0,
                top,
                3,
                bottom - 1,
                fill=ACCENT if selected else base,
                outline="",
                tags=(tag,),
            )
            self._draw_history_checkbox(
                canvas,
                columns["check"],
                middle,
                "checked" if checked else "empty",
                (check_tag,),
            )
            duration_text = self._history_optional_duration(
                summary.get("duration_seconds")
            )
            try:
                timestamp = dt.datetime.fromtimestamp(
                    float(
                        summary.get(
                            "started_at_epoch", summary.get("ended_at_epoch", 0.0)
                        )
                        or 0.0
                    )
                )
                occurred_text = timestamp.strftime("%m-%d · %H:%M")
            except (OSError, TypeError, ValueError, OverflowError):
                occurred_text = "发生时间未知"
            canvas.create_text(
                columns["time"],
                primary_y,
                text=duration_text,
                fill=TEXT,
                anchor="w",
                font=self._ui_font("number_strong"),
                tags=(tag,),
            )
            canvas.create_text(
                columns["time"],
                secondary_y,
                text=occurred_text,
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            dungeon_name = str(summary.get("dungeon_name", "")).strip() or "未知区域"
            encounter_title = self._history_encounter_title(summary)
            boss_name = str(summary.get("boss_name", "")).strip() or encounter_title
            if getattr(self, "backend_current_page", "history") == "kings":
                boss_icon = self.icons.pvp_mode(
                    summary.get("stage_name", "PvP"),
                    summary.get("dungeon_name", ""),
                    summary.get("team_size", 0),
                    size=50,
                )
            else:
                boss_icon = self.icons.boss(
                    summary.get("boss_icon", ""), boss_name, size=50
                )
            canvas.create_image(
                columns["icon"],
                middle,
                image=boss_icon,
                anchor="w",
                tags=(tag,),
            )
            content_x = columns["content"]
            available = max(36, columns["content_right"] - content_x)
            canvas.create_text(
                content_x,
                primary_y,
                text=self._fit_ui_text(
                    encounter_title,
                    available,
                    "strong",
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
                tags=(tag,),
            )
            canvas.create_text(
                content_x,
                secondary_y,
                text=self._fit_ui_text(
                    (
                        (
                            f"地图 · {dungeon_name}"
                            if getattr(self, "backend_current_page", "history") == "kings"
                            else f"副本 · {dungeon_name}"
                        )
                        if dungeon_name != encounter_title
                        else ""
                    ),
                    available,
                    "micro",
                ),
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            if self._history_field_visible("character"):
                class_id = _parsed_profession_id(
                    summary.get("profession_id", 0)
                )
                profession_icon = self._history_profession_icon(class_id, 22)
                canvas.create_image(
                    columns["character_icon"],
                    middle,
                    image=profession_icon,
                    anchor="w",
                    tags=(tag,),
                )
                raw_character_name = str(summary.get("my_name", "")).strip()
                character_name = (
                    "玩家1"
                    if self._history_names_hidden() and raw_character_name
                    else raw_character_name or "--"
                )
                character_available = max(
                    36,
                    columns["character_right"]
                    - columns["character_name"]
                    - 4,
                )
                canvas.create_text(
                    columns["character_name"],
                    middle,
                    text=self._fit_ui_text(
                        character_name, character_available, "table"
                    ),
                    fill=TEXT if raw_character_name else MUTED,
                    anchor="w",
                    font=self._ui_font("table"),
                    tags=(tag,),
                )
            if self._history_field_visible("extraordinary_rating"):
                rating_text = self._history_optional_number(
                    summary.get("extraordinary_rating")
                )
                canvas.create_text(
                    columns["extraordinary_rating"],
                    middle,
                    text=rating_text,
                    fill=TEXT if rating_text != "--" else MUTED,
                    anchor="w",
                    font=self._ui_font("number_strong"),
                    tags=(tag,),
                )
            if self._history_field_visible("performance"):
                performance_x = columns["performance"]
                performance_text, detail_text = self._history_list_performance(
                    summary
                )
                interrupted = self._history_result_presentation(
                    summary.get("result")
                )[0] == "中断"
                if interrupted:
                    detail_text = "数据不全"
                canvas.create_text(
                    performance_x,
                    primary_y,
                    text=performance_text,
                    fill=ACCENT,
                    anchor="w",
                    font=self._ui_font("number_strong"),
                    tags=(tag,),
                )
                detail_available = max(
                    36,
                    columns["performance_right"] - performance_x - 4,
                )
                canvas.create_text(
                    performance_x,
                    secondary_y,
                    text=self._fit_ui_text(
                        detail_text, detail_available, "micro"
                    ),
                    fill=WARN if interrupted else MUTED,
                    anchor="w",
                    font=self._ui_font("micro"),
                    tags=(tag,),
                )
            if self._history_field_visible("result"):
                self._draw_history_result_badge(
                    canvas,
                    columns["result"],
                    middle,
                    summary.get("result"),
                    base,
                    (tag,),
                )
            action_tags = self._draw_history_inline_actions(
                canvas,
                columns["operation_left"] + 5,
                middle,
                index,
                bool(summary.get("favorite", False)),
                battle_id,
                summary,
            )
            canvas.create_line(0, bottom - 1, width, bottom - 1, fill=BORDER)
            canvas.tag_bind(
                tag,
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._select_history(
                    selected_id
                ),
            )
            canvas.tag_bind(
                tag,
                "<Double-Button-1>",
                lambda _event, selected_id=battle_id: (
                    self._select_history(selected_id),
                    self._open_selected_history_detail(),
                ),
            )
            canvas.tag_bind(
                check_tag,
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._toggle_history_row_selection(
                    selected_id
                ),
            )
            favorite = bool(summary.get("favorite", False))
            canvas.tag_bind(
                action_tags["report"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._capture_history_team_report_by_id(
                    selected_id
                ),
            )
            upload_state = str(
                self._history_upload_state(battle_id).get("state", "pending")
                or "pending"
            ).casefold()
            upload_tag = action_tags.get("upload")
            if upload_tag and history_upload_action_clickable(upload_state):
                canvas.tag_bind(
                    upload_tag,
                    "<Button-1>",
                    lambda _event, selected_id=battle_id: self._show_history_upload_confirmation(
                        selected_id
                    ),
                )
            canvas.tag_bind(
                action_tags["favorite"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._toggle_history_favorite_by_id(
                    selected_id
                ),
            )
            canvas.tag_bind(
                action_tags["delete"],
                "<Button-1>",
                lambda _event, selected_id=battle_id: self._delete_history_by_id(
                    selected_id
                ),
            )
            for kind, active in (
                ("report", False),
                ("upload", upload_state != "pending"),
                ("favorite", favorite),
                ("delete", False),
            ):
                if kind not in action_tags:
                    continue
                canvas.tag_bind(
                    action_tags[kind],
                    "<Enter>",
                    lambda _event, selected_index=index, selected_kind=kind, selected_active=active, selected_upload_state=upload_state: self._set_history_inline_action_hover(
                        canvas,
                        selected_index,
                        selected_kind,
                        True,
                        active=selected_active,
                        upload_state=selected_upload_state,
                    ),
                )
                canvas.tag_bind(
                    action_tags[kind],
                    "<Leave>",
                    lambda _event, selected_index=index, selected_kind=kind, selected_active=active, selected_upload_state=upload_state: self._set_history_inline_action_hover(
                        canvas,
                        selected_index,
                        selected_kind,
                        False,
                        active=selected_active,
                        upload_state=selected_upload_state,
                    ),
                )
            for interactive_tag in (tag, check_tag):
                canvas.tag_bind(
                    interactive_tag,
                    "<Enter>",
                    lambda _event: canvas.configure(cursor="hand2"),
                )
                canvas.tag_bind(
                    interactive_tag,
                    "<Leave>",
                    lambda _event: canvas.configure(cursor=""),
                )
        canvas.configure(
            scrollregion=(0, 0, width, max(height, content_height))
        )

    def _select_history(self, encounter_id: str) -> None:
        next_id = str(encounter_id)
        if next_id != self.history_selected_id:
            self.history_loaded_record = None
            self.history_trend_hover_time = None
            self.history_trend_selected_time = None
            self.history_detail_trend_hover_time = None
            self.history_detail_trend_selected_time = None
            self.history_detail_trend_plot_bounds = None
            self.history_trend_plot_bounds = None
            self.history_trend_record_id = ""
            self.history_trend_points = []
            self.history_trend_source = "settlement_average"
            self.history_skill_timeline_selected_hit = None
            self.history_skill_timeline_hover_hit = None
            self.history_skill_timeline_focus_time = None
