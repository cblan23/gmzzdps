    def _selected_history_damage_participant(self) -> tuple[dict | None, dict | None]:
        record = self._selected_history_record()
        if not isinstance(record, dict):
            return None, None
        participants = record.get("participants")
        if not isinstance(participants, list):
            return record, None
        participant = next(
            (
                row for row in participants
                if isinstance(row, dict)
                and int(row.get("actor_id", 0) or 0)
                == int(self.history_selected_actor or 0)
            ),
            None,
        )
        return record, participant

    def _selected_history_equipment_participant(
        self, record: dict | None = None
    ) -> dict | None:
        record = record if isinstance(record, dict) else self._selected_history_record()
        if not isinstance(record, dict):
            return None
        try:
            selected_actor = int(self.history_selected_actor or 0)
        except (TypeError, ValueError, OverflowError):
            return None
        if not selected_actor:
            return None
        matches = []
        for collection_name in ("participants", "healers", "damage_taken"):
            collection = record.get(collection_name)
            if not isinstance(collection, list):
                continue
            for row in collection:
                if not isinstance(row, dict):
                    continue
                try:
                    actor_id = int(row.get("actor_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    continue
                if actor_id == selected_actor:
                    matches.append(row)
        return next(
            (
                row
                for row in matches
                if isinstance(row.get("equipment_snapshot"), dict)
            ),
            matches[0] if matches else None,
        )

    def _history_selected_actor_is_self(self) -> bool:
        record = self._selected_history_record()
        if not isinstance(record, dict):
            return False
        pvp_record = str(record.get("combat_mode", "")).casefold() == "pvp"
        try:
            selected_actor = int(self.history_selected_actor or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if not selected_actor:
            return False
        for collection_name in ("participants", "healers", "damage_taken"):
            collection = record.get(collection_name, [])
            if not isinstance(collection, list):
                continue
            for row in collection:
                if not isinstance(row, dict):
                    continue
                try:
                    actor_id = int(row.get("actor_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    continue
                if actor_id != selected_actor:
                    continue
                if pvp_record or row.get("is_self") is True:
                    return row.get("local_detail_available", True) is not False
        return False

    def _sync_history_local_detail_modules(self) -> bool:
        visible = self._history_selected_actor_is_self()
        changed = visible != bool(
            getattr(self, "history_local_detail_modules_visible", True)
        )
        panel_specs = (
            (
                getattr(self, "history_skill_quality_panel", None),
                {"fill": "x", "padx": 18, "pady": (8, 0)},
            ),
            (
                getattr(self, "history_critical_luck_panel", None),
                {"fill": "x", "padx": 18, "pady": (8, 0)},
            ),
            (
                getattr(self, "history_opener_panel", None),
                {"fill": "x", "padx": 18, "pady": (8, 0)},
            ),
            (
                getattr(self, "history_skill_timeline_panel", None),
                {"fill": "x", "padx": 18, "pady": (8, 14)},
            ),
        )
        for panel, pack_options in panel_specs:
            if panel is None:
                continue
            try:
                managed = bool(panel.winfo_manager())
                if visible and not managed:
                    panel.pack(**pack_options)
                elif not visible and managed:
                    panel.pack_forget()
            except (AttributeError, tk.TclError):
                continue
        self.history_local_detail_modules_visible = visible
        if changed and getattr(self, "history_page_mode", "browser") == "detail":
            self._refresh_history_page_extent()
        return visible

    def _sync_history_equipment_panel(self, record: object) -> bool:
        panel = getattr(self, "history_equipment_panel", None)
        visible = (
            isinstance(record, dict)
            and str(record.get("combat_mode", "")).casefold() == "pvp"
            and getattr(self, "history_page_mode", "browser") == "detail"
        )
        if panel is None:
            self.history_equipment_visible = False
            return False
        try:
            managed = bool(panel.winfo_manager())
            if visible and not managed:
                before = getattr(self, "history_skill_share_panel", None)
                options = {"fill": "x", "padx": 18, "pady": (8, 0)}
                if before is not None and before.winfo_manager():
                    options["before"] = before
                panel.pack(**options)
            elif not visible and managed:
                panel.pack_forget()
        except (AttributeError, tk.TclError):
            visible = False
        changed = visible != bool(
            getattr(self, "history_equipment_visible", False)
        )
        self.history_equipment_visible = visible
        if changed and getattr(self, "history_page_mode", "browser") == "detail":
            self._refresh_history_page_extent()
        if visible:
            self._draw_history_equipment_snapshot()
        return visible

    @staticmethod
    def _history_equipment_timestamp(snapshot: dict) -> str:
        try:
            stamp = int(snapshot.get("captured_at_ns", 0) or 0)
            if stamp > 0:
                return dt.datetime.fromtimestamp(stamp / 1e9).strftime(
                    "%Y-%m-%d %H:%M:%S"
                )
        except (OSError, TypeError, ValueError, OverflowError):
            pass
        captured = snapshot.get("captured_at")
        if captured:
            try:
                parsed = dt.datetime.fromisoformat(str(captured).replace("Z", "+00:00"))
                if parsed.tzinfo is not None:
                    parsed = parsed.astimezone()
                return parsed.strftime("%Y-%m-%d %H:%M:%S")
            except (TypeError, ValueError, OverflowError):
                pass
        return "--"

    def _draw_history_equipment_snapshot(self) -> None:
        canvas = getattr(self, "history_equipment_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record, participant = self._selected_history_damage_participant()
        if (
            not isinstance(record, dict)
            or str(record.get("combat_mode", "")).casefold() != "pvp"
            or not isinstance(participant, dict)
        ):
            canvas.create_text(
                width // 2,
                height // 2,
                text="请选择一名玩家查看本场装备快照",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        snapshot = participant.get("equipment_snapshot")
        if not isinstance(snapshot, dict):
            canvas.create_text(
                width // 2,
                height // 2 - 8,
                text="本场未返回该玩家的装备快照",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 18,
                text="不会使用当前装备补写历史，也不会推测缺失词条",
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        equipment = snapshot.get("equipment")
        equipment = [
            row for row in equipment if isinstance(row, dict)
        ] if isinstance(equipment, list) else []
        rating = normalize_extraordinary_rating(
            participant.get("extraordinary_rating")
            or snapshot.get("extraordinary_rating")
        )
        try:
            pvp_count = max(0, int(snapshot.get("pvp_equipment_count", 0) or 0))
            active_words = max(0, int(snapshot.get("active_word_count", 0) or 0))
            total_words = max(0, int(snapshot.get("total_word_count", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            pvp_count = active_words = total_words = 0
        summary_height = 70
        canvas.create_rectangle(0, 0, width, summary_height, fill="#101419", outline="")
        summary = (
            ("玩家", str(participant.get("name") or "未知玩家"), TEXT),
            (
                "非凡评分",
                "--" if rating is None else format_number(rating),
                WARN if rating is not None else MUTED,
