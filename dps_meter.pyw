                bg=SURFACE,
                width=width,
                highlightthickness=1,
                highlightbackground=BORDER,
            )
            cell.grid(row=0, column=len(player_stat_pairs), sticky="nsew")
            cell.pack_propagate(False)
            caption_label = tk.Label(
                cell,
                text=caption,
                bg=SURFACE,
                fg=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
            )
            caption_label.pack(fill="x", padx=11, pady=(21, 0))
            value_label = tk.Label(
                cell,
                text="--",
                bg=SURFACE,
                fg=TEXT,
                anchor="w",
                font=self._ui_font("number_strong"),
            )
            value_label.pack(fill="x", padx=11, pady=(4, 0))
            player_stat_pairs.append((cell, caption_label, value_label))
            return caption_label, value_label

