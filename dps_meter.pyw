            notice_consent,
            text="《用户须知》",
            bg=BG,
            fg=ACCENT,
            activebackground=BG,
            activeforeground="#86edca",
            cursor="hand2",
            font=self._ui_font("body"),
        )
        notice_link.pack(side="left")
        # Opening a grabbed Toplevel from ButtonPress transfers Tk's input
        # grab while the physical mouse button is still down.  On Windows this
        # can leave the login UI stuck waiting for a release owned by the new
        # window.  Wait for the real release before changing the grab owner.
        notice_link.bind(
            "<ButtonRelease-1>",
            lambda _event: self._show_user_notice() or "break",
        )
        notice_link.bind("<Enter>", lambda _event: notice_link.configure(fg="#86edca"))
        notice_link.bind("<Leave>", lambda _event: notice_link.configure(fg=ACCENT))
