    def _capture_toggle_hotkey_key(self, event) -> str | None:
        if not getattr(self, "toggle_hotkey_capture_active", False):
            return None
        keysym = str(getattr(event, "keysym", "") or "")
        folded = keysym.casefold()
        if folded == "escape":
            self._cancel_toggle_hotkey_capture()
            return "break"
        modifier = ""
        if folded in {"control_l", "control_r"}:
            modifier = "Ctrl"
        elif folded in {"alt_l", "alt_r", "iso_level3_shift"}:
            modifier = "Alt"
        elif folded in {"shift_l", "shift_r"}:
            modifier = "Shift"
        if modifier:
            self.toggle_hotkey_capture_modifiers.add(modifier)
            return "break"

        try:
            state = int(getattr(event, "state", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            state = 0
        for held_modifier in self.toggle_hotkey_capture_modifiers:
            state |= {
                "Ctrl": 0x0004,
                "Alt": 0x0008,
                "Shift": 0x0001,
            }[held_modifier]
        candidate = toggle_hotkey_from_tk_event(keysym, state)
        if not candidate:
            self._sync_toggle_hotkey_controls(
                "单键请使用 Home、F1-F12 等功能键", error=True
            )
            return "break"

        previous_hotkey = self.toggle_visibility_hotkey
        enabled = bool(
            getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        if enabled and not self._set_native_toggle_hotkey(candidate):
            restored = self._set_native_toggle_hotkey(previous_hotkey)
            self.toggle_hotkey_registered = bool(previous_hotkey and restored)
            self.toggle_visibility_hotkey_enabled = bool(
                self.toggle_hotkey_registered
            )
            self.toggle_hotkey_error = (
                f"{candidate} 已被其他程序占用"
                if restored
                else f"{previous_hotkey} 暂时无法恢复"
            )
            self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = (
                self.toggle_visibility_hotkey_enabled
            )
            save_config(self.config)
            self._sync_toggle_hotkey_controls()
            return "break"

        self.toggle_visibility_hotkey = candidate
        self.toggle_hotkey_registered = enabled
        self.toggle_hotkey_error = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = candidate
        self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = enabled
        save_config(self.config)
        self._sync_toggle_hotkey_controls()
        return "break"

    def _release_toggle_hotkey_modifier(self, event) -> str | None:
        if not getattr(self, "toggle_hotkey_capture_active", False):
            return None
        folded = str(getattr(event, "keysym", "") or "").casefold()
        modifier = ""
        if folded in {"control_l", "control_r"}:
            modifier = "Ctrl"
        elif folded in {"alt_l", "alt_r", "iso_level3_shift"}:
            modifier = "Alt"
        elif folded in {"shift_l", "shift_r"}:
            modifier = "Shift"
        if modifier:
            self.toggle_hotkey_capture_modifiers.discard(modifier)
            return "break"
        return None

