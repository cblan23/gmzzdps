    def _sync_history_detail_metrics_layout(self, width: int | None = None) -> None:
        frame = getattr(self, "history_detail_metrics_frame", None)
        cards = getattr(self, "history_detail_metric_cards", ())
        if frame is None or len(cards) != 5:
            return
        try:
            if not frame.winfo_exists():
                return
        except tk.TclError:
            return
        width = max(1, int(width if width is not None else frame.winfo_width()))
        micro = self._ui_font("micro")
        number = self._ui_font("number_large")
        full_captions = (
            "战斗时长", "团队总伤害", "团队 DPS", "队伍平均非凡评分", "战斗结果"
        )
        minimum_card = max(
            max(
                micro.measure(caption) + 28,
                number.measure("59,392,271") + 32,
            )
            for caption in full_captions
        )
        compact = width < max(760, minimum_card * 5)
        row_height = max(
            76,
            micro.metrics("linespace")
            + self._ui_font("number_large").metrics("linespace") + 20,
        )
        state = (compact, row_height)
        if state == getattr(self, "history_detail_metrics_layout_state", None):
            return
        self.history_detail_metrics_layout_state = state
        self.history_my_value._caption_label.configure(
            text="平均评分" if compact else "队伍平均非凡评分"
        )
        for column in range(5):
            frame.grid_columnconfigure(
                column, weight=1 if column < (3 if compact else 5) else 0,
                uniform="history_detail_metrics" if column < (3 if compact else 5) else "",
            )
        frame.grid_rowconfigure(1, weight=1 if compact else 0)
        for index, card in enumerate(cards):
            card.grid_configure(
                row=index // 3 if compact else 0,
                column=index % 3 if compact else index,
                columnspan=2 if compact and index == 4 else 1,
            )
        frame.configure(height=row_height * (2 if compact else 1))

    def _sync_history_detail_tabs_layout(self, width: int | None = None) -> None:
        bar = getattr(self, "history_detail_tabs_bar", None)
        if bar is None:
            return
        try:
            if not bar.winfo_exists():
                return
        except tk.TclError:
            return
        width = max(1, int(width if width is not None else bar.winfo_width()))
        compact = width < 1050
        if compact == getattr(self, "history_detail_tabs_compact", None):
            return
        self.history_detail_tabs_compact = compact
        title = self.history_detail_tabs_title
        divider = self.history_detail_tabs_divider
        hint = self.history_detail_tabs_hint
        if compact:
            title.pack_forget()
            divider.pack_forget()
            hint.pack_forget()
        else:
            first_tab = next(iter(self.history_meter_buttons.values()))
            title.pack(side="left", fill="y", before=first_tab)
            divider.pack(side="left", fill="y", before=first_tab)
            hint.pack(side="right", fill="y", padx=13)
        for tab in self.history_meter_buttons.values():
            tab.configure(padx=9 if compact else 22)

    def _sync_history_team_heading_layout(self, width: int | None = None) -> None:
        heading = getattr(self, "history_team_heading", None)
