    def _select_history(self, encounter_id: str) -> None:
        next_id = str(encounter_id)
        if next_id != self.history_selected_id:
            self.history_loaded_record = None
            self.history_trend_hover_time = None
            self.history_trend_selected_time = None
            self.history_detail_trend_hover_time = None
            self.history_detail_trend_selected_time = None
            self.history_detail_trend_plot_bounds = None
            self.history_trend_plot_bounds = None
            self.history_trend_record_id = ""
            self.history_trend_points = []
            self.history_trend_source = "settlement_average"
            self.history_skill_timeline_selected_hit = None
            self.history_skill_timeline_hover_hit = None
            self.history_skill_timeline_focus_time = None
        self.history_selected_id = next_id
        self.history_selected_actor = 0
        if getattr(self, "history_layout_version", 1) >= 2:
            self._draw_history_list()
            self._render_history_snapshot()
            if self.history_page_mode == "detail":
                self._render_history_selection()
        else:
            self._render_history_selection()

    def _feedback_history_record(self, encounter_id: str) -> None:
        self._select_history(encounter_id)
        self.show_feedback(encounter_id)

    @staticmethod
    def _history_rate_text(value: object) -> str:
        try:
            rate = float(value) if value is not None else None
        except (TypeError, ValueError, OverflowError):
            return "--"
        if rate is None or not math.isfinite(rate):
            return "--"
        return f"{rate * 100:.1f}%"

    @staticmethod
    def _history_boss_damage(record: object) -> dict[str, object]:
        if not isinstance(record, dict):
            return {}
        value = record.get("boss_damage")
        return value if isinstance(value, dict) else {}

    @staticmethod
    def _history_boss_sources(record: object) -> list[dict]:
        value = DpsWindow._history_boss_damage(record).get("sources", [])
        if not isinstance(value, list):
            return []
        return [row for row in value if isinstance(row, dict)]

    @staticmethod
    def _history_boss_death_events(record: object) -> list[dict[str, object]]:
        boss_damage = DpsWindow._history_boss_damage(record)
        event_log = boss_damage.get("death_event_log")
        if not isinstance(event_log, dict):
            return []
        raw_rows = event_log.get("rows")
        if not isinstance(raw_rows, list):
            return []
        columns = event_log.get("columns", [])
        indexes = (
            {str(name): index for index, name in enumerate(columns)}
            if isinstance(columns, list)
            else {}
        )
        events: list[dict[str, object]] = []
        for raw_row in raw_rows:
            try:
                if isinstance(raw_row, dict):
                    time_ms = int(raw_row.get("time_ms", 0) or 0)
                    actor_id = int(raw_row.get("actor_id", 0) or 0)
                    name = str(raw_row.get("name", "") or "")
                elif isinstance(raw_row, (list, tuple)):
                    time_index = indexes.get("time_ms", 0)
                    actor_index = indexes.get("actor_id", 1)
                    name_index = indexes.get("name", 2)
                    time_ms = int(raw_row[time_index] or 0)
                    actor_id = int(raw_row[actor_index] or 0)
                    name = (
                        str(raw_row[name_index] or "")
                        if name_index < len(raw_row)
                        else ""
                    )
                else:
                    continue
            except (IndexError, TypeError, ValueError, OverflowError):
                continue
            events.append(
                {
                    "time_seconds": max(0.0, time_ms / 1000.0),
                    "actor_id": actor_id,
                    "name": name.strip() or "队伍成员",
                }
            )
        return sorted(events, key=lambda row: float(row["time_seconds"]))

    @staticmethod
    def _history_boss_coverage_text(boss_damage: object) -> tuple[str, str]:
        value = boss_damage if isinstance(boss_damage, dict) else {}
        if value.get("unavailable_reason") == "training_dummy":
            return "训练目标不会主动造成伤害", MUTED
        return {
            "complete": ("数据完整", ACCENT),
            "observed_partial": ("已观测部分", WARN),
            "conflict": ("数据冲突", ERROR),
        }.get(str(value.get("coverage", "")), ("该场未记录首领伤害", MUTED))

    def _history_boss_icon_name(self, source: object) -> str:
        if not isinstance(source, dict):
            return ""
        try:
            return self.history_store._index().catalog.boss_icon(
                source.get("template_id", 0), name=source.get("name", "")
            )
        except (AttributeError, OSError, TypeError, ValueError):
            return ""

    def _render_history_boss_source_summary(
        self,
        record: dict | None,
        sources: list[dict],
        source: dict | None,
    ) -> None:
        name_label = getattr(self, "history_player_name_label", None)
        rank_label = getattr(self, "history_player_rank_label", None)
        rating_label = getattr(self, "history_player_rating_label", None)
        icon_label = getattr(self, "history_player_icon_label", None)
        primary_label = getattr(self, "history_player_primary_label", None)
        primary_caption = getattr(self, "history_player_primary_caption", None)
        stat_labels = getattr(self, "history_player_stat_labels", {})
        boss_damage = self._history_boss_damage(record)
        coverage_text, coverage_color = self._history_boss_coverage_text(
            boss_damage
        )
        if not isinstance(source, dict):
            if name_label is not None:
                name_label.configure(text=coverage_text, fg=coverage_color)
            if rank_label is not None:
                rank_label.configure(text="--", fg=SUBTLE)
            if rating_label is not None:
                rating_label.configure(text="首领伤害", fg=SUBTLE, bg=SURFACE)
            if icon_label is not None:
                icon_label.configure(image="", text="♜")
                icon_label.image = None
            if primary_label is not None:
                primary_label.configure(text="--", fg=MUTED)
            if primary_caption is not None:
                primary_caption.configure(text="来源伤害")
            for _key, (caption, value) in stat_labels.items():
                caption.configure(text="数据范围")
                value.configure(text="--", fg=MUTED)
            if self.history_detail_label is not None:
                self.history_detail_label.configure(text=coverage_text)
            self._draw_history_player_share()
            return

        try:
            index = sources.index(source)
        except ValueError:
            index = 0
        name = str(source.get("name", "")).strip() or "首领"
        kind = str(source.get("kind", "boss")).casefold()
        damage = max(0, int(source.get("damage", 0) or 0))
        share = max(0.0, min(1.0, float(source.get("share", 0.0) or 0.0)))
        hits = max(0, int(source.get("hits", 0) or 0))
        max_hit = max(0, int(source.get("max_hit", 0) or 0))
        if name_label is not None:
            name_label.configure(text=name, fg=TEXT)
        if rank_label is not None:
            rank_label.configure(text=f"#{index + 1:02d}", fg="#e67d72")
        if rating_label is not None:
            rating_label.configure(
                text="机制来源" if kind == "mechanism" else "首领来源",
                fg=WARN if kind == "mechanism" else ACCENT,
                bg=SURFACE,
            )
        if icon_label is not None:
            portrait = self.icons.boss(
                self._history_boss_icon_name(source), name, size=36
            )
            icon_label.configure(image=portrait, text="")
            icon_label.image = portrait
        if primary_label is not None:
            primary_label.configure(text=format_number(damage), fg="#e67d72")
        if primary_caption is not None:
            primary_caption.configure(text="来源伤害")
        captions = {
            "amount": "已归类伤害",
            "share": "来源占比",
            "rates": "命中 / 最高",
        }
        values = {
            "amount": format_number(damage),
            "share": f"{share * 100:.1f}%",
            "rates": f"{hits} / {format_number(max_hit)}",
        }
        for key, (caption_label, value_label) in stat_labels.items():
            caption_label.configure(text=captions.get(key, key))
            value_label.configure(
                text=values.get(key, "--"),
                fg="#e67d72" if key == "share" else TEXT,
            )
        if self.history_detail_label is not None:
            self.history_detail_label.configure(
                text=f"{coverage_text} · 命中次数 {hits} · 最高一击 {format_number(max_hit)}"
            )
        self._draw_history_player_share()

    def _render_history_player_summary(
        self,
        record: dict | None,
        participants: list[dict],
        participant: dict | None,
        *,
        healing_mode: bool,
        taken_mode: bool,
    ) -> None:
        name_label = getattr(self, "history_player_name_label", None)
        rank_label = getattr(self, "history_player_rank_label", None)
        rating_label = getattr(self, "history_player_rating_label", None)
        icon_label = getattr(self, "history_player_icon_label", None)
        primary_label = getattr(self, "history_player_primary_label", None)
        primary_caption = getattr(self, "history_player_primary_caption", None)
        stat_labels = getattr(self, "history_player_stat_labels", {})
        if not any(
            (
                name_label,
                rank_label,
                rating_label,
                icon_label,
                primary_label,
                primary_caption,
                stat_labels,
                getattr(self, "history_player_share_canvas", None),
            )
        ):
            return
        if not isinstance(participant, dict):
            if name_label is not None:
                name_label.configure(text="请选择队员", fg=MUTED)
            if rank_label is not None:
                rank_label.configure(text="--", fg=SUBTLE)
            if rating_label is not None:
                rating_label.configure(
                    text="非凡评分 --", fg=SUBTLE, bg=SURFACE
                )
            if icon_label is not None:
                icon_label.configure(image="", text="?")
                icon_label.image = None
            if primary_label is not None:
                primary_label.configure(text="--", fg=MUTED)
            if primary_caption is not None:
                primary_caption.configure(text="个人数据")
            for _key, (_caption, value) in stat_labels.items():
                value.configure(text="--", fg=MUTED)
            self._draw_history_player_share()
            return

        try:
            index = next(
                row_index
                for row_index, row in enumerate(participants)
                if isinstance(row, dict)
                and int(row.get("actor_id", 0) or 0)
                == int(participant.get("actor_id", 0) or 0)
            )
        except StopIteration:
            index = 0
        class_id = int(participant.get("profession_id", 0) or 0)
        _profession, profession_color = self._profession_info(class_id)
        if name_label is not None:
            name_label.configure(
                text=self._history_actor_name(
                    participant, index, self._history_names_hidden()
                ),
                fg=TEXT,
            )
        if rank_label is not None:
            rank_label.configure(text=f"#{index + 1:02d}", fg=profession_color)
        if rating_label is not None:
            is_ai = history_participant_is_ai(participant)
            rating = (
                None
                if is_ai
                else normalize_extraordinary_rating(
                    participant.get("extraordinary_rating")
                )
            )
            if is_ai:
                rating_text = "非凡评分 人机"
            elif rating is not None:
                rating_text = f"非凡评分 {format_number(rating)}"
            else:
                rating_text = "非凡评分 --"
            rating_label.configure(
                text=rating_text,
                fg="#8bc7d4" if is_ai else ACCENT if rating is not None else SUBTLE,
                bg=(
                    blend_color(SURFACE, "#67aebe" if is_ai else ACCENT, 0.10)
                    if is_ai or rating is not None
                    else SURFACE
                ),
            )
        if icon_label is not None:
            profession_icon = self.icons.profession(class_id, 36)
            icon_label.configure(image=profession_icon, text="")
            icon_label.image = profession_icon

        duration = self._history_display_duration(
            record or {}, healing_mode
        )
        duration = dps_duration_seconds(duration)
        if healing_mode:
            primary_value = participant.get("hps")
            if primary_value is None and duration:
                primary_value = (
                    float(participant.get("effective_healing", 0.0) or 0.0)
                    / duration
                )
            primary_text = self._history_optional_number(primary_value)
            primary_caption_text = "个人 HPS"
            total = max(
                0.0,
                float((record or {}).get("team_effective_healing", 0.0) or 0.0),
            )
            effective = max(
                0.0,
                float(participant.get("effective_healing", 0.0) or 0.0),
            )
            share = effective / total if total else 0.0
            response = participant.get("response", {})
            response = response if isinstance(response, dict) else {}
            response_text = (
                f"{format_response_time(response.get('fastest_ms'))} / "
                f"{format_response_time(response.get('slowest_ms'))}"
            )
            captions = {
                "amount": "有效治疗",
                "share": "治疗占比",
                "rates": "过量率",
            }
            values = {
                "amount": format_number(effective),
                "share": f"{share * 100:.1f}%",
                "rates": format_overheal_rate(
                    participant.get("overheal_rate"),
                    partial=bool(participant.get("overheal_rate_partial")),
                ),
            }
            detail_text = "有效治疗构成 · 明细范围以游戏结算为准"
        elif taken_mode:
            taken = max(0.0, float(participant.get("taken", 0.0) or 0.0))
            team_taken = max(
                0.0, float((record or {}).get("team_taken", 0.0) or 0.0)
            )
            try:
                share = max(
                    0.0,
                    min(1.0, float(participant.get("share", 0.0) or 0.0)),
                )
            except (TypeError, ValueError, OverflowError):
                share = taken / team_taken if team_taken else 0.0
            primary_text = format_number(taken)
            primary_caption_text = "个人承伤"
            captions = {
                "amount": "个人承伤",
                "share": "承伤占比",
                "rates": "数据范围",
            }
            values = {
                "amount": format_number(taken),
                "share": f"{share * 100:.1f}%",
                "rates": "结算汇总",
            }
            detail_text = "当前仅提供玩家承伤汇总，暂无可靠的技能归属"
        else:
            damage = max(0.0, float(participant.get("damage", 0.0) or 0.0))
            raw_dps = participant.get("dps")
            try:
                dps = (
                    max(0.0, float(raw_dps))
                    if raw_dps is not None
                    else damage / duration if duration else 0.0
                )
            except (TypeError, ValueError, OverflowError):
                dps = damage / duration if duration else 0.0
            try:
                share = max(
                    0.0,
                    min(1.0, float(participant.get("share", 0.0) or 0.0)),
                )
            except (TypeError, ValueError, OverflowError):
                share = 0.0
            deaths = max(0, int(participant.get("deaths", 0) or 0))
            revives = max(0, int(participant.get("revives", 0) or 0))
            primary_text = format_number(dps)
            primary_caption_text = "个人 DPS"
            captions = {
                "amount": "总伤害",
                "share": "伤害占比",
                "rates": "暴击 / 穿刺",
            }
            values = {
                "amount": format_number(damage),
                "share": f"{share * 100:.1f}%",
                "rates": (
                    f"{self._history_rate_text(participant.get('critical_rate'))} / "
                    f"{self._history_rate_text(participant.get('penetration_rate'))}"
                ),
            }
            detail_status = str(participant.get("skill_detail_status", ""))
            try:
                difference = max(
                    0, int(participant.get("server_damage_difference", 0) or 0)
                )
            except (TypeError, ValueError, OverflowError):
                difference = 0
            detail_text = (
                TEAMMATE_SKILL_DETAIL_MISSING_MESSAGE
                if detail_status == "pending_server_detail"
                else f"结算中有 {format_number(difference)} 伤害未归类"
                if difference
                else "技能明细已同步 · 点击下方技能查看构成"
            )

        if primary_label is not None:
            primary_label.configure(text=primary_text, fg=profession_color)
        if primary_caption is not None:
            primary_caption.configure(text=primary_caption_text)
        if self.history_detail_label is not None:
            self.history_detail_label.configure(text=detail_text)
        for key, (caption_label, value_label) in stat_labels.items():
            caption_label.configure(text=captions.get(key, key))
            value_label.configure(
                text=values.get(key, "--"),
                fg=profession_color if key == "share" else TEXT,
            )
        self._draw_history_player_share()
        self._draw_history_skill_share()
        if getattr(self, "history_local_detail_modules_visible", True):
            self._draw_history_skill_quality()
            self._draw_history_critical_luck()
            self._draw_history_opener_sequence()
            self._draw_history_skill_timeline()

    def _render_history_selection(self) -> None:
        record = self._selected_history_record()
        participants: list[dict] = []
        selected_participant: dict | None = None
        healing_mode = self.history_meter_mode == "hps"
        taken_mode = self.history_meter_mode == "dt"
        boss_mode = self.history_meter_mode == "boss_damage"
        modern_history = getattr(self, "history_layout_version", 1) >= 2
        if record is None:
            self.history_selected_actor = 0
            if self.history_target_label is not None:
                self.history_target_label.configure(text="暂无战斗记录", fg=MUTED)
                self.history_time_label.configure(text="--")
            detail_dungeon_label = getattr(
                self, "history_detail_dungeon_label", None
            )
            if detail_dungeon_label is not None:
                detail_dungeon_label.configure(
                    text="完成一场 Boss 战斗后会自动保存", fg=MUTED
                )
            detail_icon_label = getattr(self, "history_detail_icon_label", None)
            if detail_icon_label is not None:
                detail_icon_label.configure(image="", text="♜")
                detail_icon_label.image = None
            detail_status_label = getattr(
                self, "history_detail_status_label", None
            )
            if detail_status_label is not None:
                detail_status_label.configure(
                    text="等待数据", fg=MUTED
                )
            detail_accent = getattr(self, "history_detail_accent_frame", None)
            if detail_accent is not None:
                detail_accent.configure(bg=ACCENT)
            if self.history_total_value is not None:
                self.history_total_value.configure(
                    text="--" if modern_history else "0"
                )
                self.history_total_value._caption_label.configure(
                    text=(
                        "总有效治疗"
                        if healing_mode
                        else "已归类首领伤害"
                        if boss_mode
                        else "团队总承伤" if taken_mode else "总伤害"
                    )
                )
            if self.history_dps_value is not None:
                self.history_dps_value.configure(
                    text="--" if modern_history else "0"
                )
                self.history_dps_value._caption_label.configure(
                    text=(
                        "团队 HPS"
                        if healing_mode
                        else "归类比例"
                        if boss_mode
                        else "最高承伤占比" if taken_mode else "总 DPS"
                    )
                )
            if self.history_team_value is not None:
                self.history_team_value.configure(
                    text="--" if modern_history else "0 人"
                )
            if modern_history and getattr(self, "history_my_value", None) is not None:
                self.history_my_value.configure(text="--")
                self.history_my_value._caption_label.configure(
                    text="队伍平均非凡评分"
                )
            if modern_history and getattr(self, "history_duration_value", None) is not None:
                self.history_duration_value.configure(text="--")
            if self.history_favorite_button is not None:
                self.history_favorite_button.configure(text="☆ 收藏", fg=MUTED)
            if self.history_detail_label is not None:
                self.history_detail_label.configure(
                    text=(
                        "暂无治疗详情"
                        if healing_mode
                        else "该场未记录首领伤害"
                        if boss_mode
                        else "承伤当前仅提供玩家汇总"
                        if taken_mode
                        else "暴击率 --  ·  穿刺率 --  ·  死亡 0  ·  复活 0  ·  死亡时间 00:00"
                    )
                )
        else:
            boss_damage = self._history_boss_damage(record)
            boss_data_available = str(
                boss_damage.get("coverage", "")
            ) in {"complete", "observed_partial", "conflict"}
            participants = (
                self._history_boss_sources(record)
                if boss_mode
                else record.get(
                    (
                        "healers"
                        if healing_mode
                        else "damage_taken" if taken_mode else "participants"
                    ),
                    [],
                )
            )
            participants = participants if isinstance(participants, list) else []
            try:
                team_size = max(
                    len(participants),
                    int(record.get("team_size", len(participants))),
                )
            except (TypeError, ValueError, OverflowError):
                team_size = len(participants)
            actor_ids = [
                int(item.get("entity_id" if boss_mode else "actor_id", 0) or 0)
                for item in participants
            ]
            if self.history_selected_actor not in actor_ids:
                preferred_actor = 0 if boss_mode else next(
                    (
                        int(item.get("actor_id", 0) or 0)
                        for item in participants
                        if item.get("is_self") is True
                    ),
                    0,
                )
                if not preferred_actor and modern_history and not boss_mode:
                    preferred_actor = next(
                        (
                            int(item.get("actor_id", 0) or 0)
                            for item in record.get("participants", [])
                            if isinstance(item, dict) and item.get("is_self") is True
                        ),
                        0,
                    )
                    if preferred_actor not in actor_ids:
                        preferred_actor = 0
                self.history_selected_actor = preferred_actor or (
                    actor_ids[0] if actor_ids else 0
                )
            monster = record.get("monster")
            monster = monster if isinstance(monster, dict) else {}
            target_name = str(monster.get("name", "")).strip() or (
                "Boss战斗" if self._history_is_boss(record) else "怪物战斗"
            )
            level = int(monster.get("level", 0) or 0)
            if level:
                target_name += f"  Lv.{level}"
            summary = self._selected_history_summary() if modern_history else None
            if summary is not None:
                target_name = self._history_encounter_title(summary)
            self.history_target_label.configure(text=target_name, fg=TEXT)
            dungeon_name = (
                str(summary.get("dungeon_name", "")).strip()
                if isinstance(summary, dict)
                else ""
            )
            detail_dungeon_label = getattr(
                self, "history_detail_dungeon_label", None
            )
            if detail_dungeon_label is not None:
                difficulty = (
                    str(summary.get("difficulty", "")).strip()
                    if isinstance(summary, dict)
                    else ""
                )
                dungeon_text = dungeon_name or "未知副本"
                if difficulty:
                    dungeon_text = f"{dungeon_text}  ·  {difficulty}"
                detail_dungeon_label.configure(
                    text=dungeon_text, fg=WARN
                )
            self.history_time_label.configure(
                text=(
                    f"发生于 {self._history_timestamp(record)}   ·   "
                    f"战斗用时 {format_duration(self._history_display_duration(record, healing_mode))}"
                )
            )
            detail_icon_label = getattr(self, "history_detail_icon_label", None)
            if detail_icon_label is not None:
                boss_name = (
                    str(summary.get("boss_name", "")).strip()
                    if isinstance(summary, dict)
                    else str(monster.get("name", "")).strip()
                ) or target_name
                portrait = self.icons.boss(
                    summary.get("boss_icon", "") if isinstance(summary, dict) else "",
                    boss_name,
                    size=90,
                )
                detail_icon_label.configure(image=portrait, text="")
                detail_icon_label.image = portrait
            _result_text, result_color = self._history_result_presentation(
                summary.get("result") if isinstance(summary, dict) else ""
            )
            completeness = (
                str(summary.get("completeness", ""))
                if isinstance(summary, dict)
                else ""
            )
            if boss_mode:
                completeness_text, boss_coverage_color = (
                    self._history_boss_coverage_text(boss_damage)
                )
            else:
                completeness_text = {
                    COMPLETENESS_COMPLETE: "数据完整",
                    COMPLETENESS_LIMITED: "基础数据",
                }.get(completeness, "部分数据")
                boss_coverage_color = WARN
            detail_status_label = getattr(
                self, "history_detail_status_label", None
            )
            if detail_status_label is not None:
                detail_status_label.configure(
                    text=completeness_text,
                    fg=(
                        boss_coverage_color
                        if boss_mode
                        else ACCENT
                        if completeness == COMPLETENESS_COMPLETE
                        else WARN
                    ),
                )
            detail_accent = getattr(self, "history_detail_accent_frame", None)
            if detail_accent is not None:
                detail_accent.configure(bg=result_color)
            if self.history_total_value is not None:
                self.history_total_value.configure(
                    text=(
                        format_number(record.get("team_effective_healing", 0))
                        if healing_mode
                        else format_number(
                            boss_damage.get("observed_damage", 0) or 0
                        )
                        if boss_mode and boss_data_available
                        else "--"
                        if boss_mode
                        else format_number(record.get("team_taken", 0) or 0)
                        if taken_mode
                        else format_number(record.get("total_damage", 0))
                    )
                )
                self.history_total_value._caption_label.configure(
                    text=(
                        "总有效治疗"
                        if healing_mode
                        else "已归类首领伤害"
                        if boss_mode
                        else "团队总承伤" if taken_mode else "总伤害"
                    )
                )
            if self.history_dps_value is not None:
                if boss_mode:
                    ratio = boss_damage.get("classification_ratio")
                    self.history_dps_value.configure(
                        text=(
                            self._history_rate_text(ratio)
                            if boss_data_available
                            else "--"
                        )
                    )
                elif taken_mode:
                    max_taken_share = max(
                        (
                            max(
                                0.0,
                                min(1.0, float(item.get("share", 0.0) or 0.0)),
                            )
                            for item in participants
                            if isinstance(item, dict)
                        ),
                        default=0.0,
                    )
                    self.history_dps_value.configure(
                        text=f"{max_taken_share * 100:.1f}%"
                    )
                else:
                    self.history_dps_value.configure(
                        text=format_number(
                            record.get(
                                "team_hps" if healing_mode else "team_dps",
                                0,
                            )
                        )
                    )
                self.history_dps_value._caption_label.configure(
                    text=(
                        "团队 HPS"
                        if healing_mode
                        else "归类比例"
                        if boss_mode
                        else "最高承伤占比" if taken_mode else "总 DPS"
                    )
                )
            if self.history_team_value is not None:
                if boss_mode:
                    self.history_team_value.configure(
                        text=(
                            self._history_optional_number(
                                boss_damage.get("team_taken")
                            )
                            if boss_data_available
                            else "--"
                        ),
                        fg=TEXT,
                    )
                    self.history_team_value._caption_label.configure(
                        text="团队总承伤"
                    )
                elif modern_history and self.history_page_mode == "detail":
                    result_text, result_color = self._history_result_presentation(
                        summary.get("result") if isinstance(summary, dict) else ""
                    )
                    self.history_team_value.configure(
                        text=result_text, fg=result_color
                    )
                    self.history_team_value._caption_label.configure(
                        text="战斗结果"
                    )
                else:
                    self.history_team_value.configure(text=f"{team_size} 人")
            if self.history_favorite_button is not None:
                favorite = bool(record.get("favorite"))
                self.history_favorite_button.configure(
                    text="★ 已收藏" if favorite else "☆ 收藏",
                    fg=ACCENT if favorite else MUTED,
                )
            selected_participant = next(
                (
                    item
                    for item in participants
                    if int(
                        item.get("entity_id" if boss_mode else "actor_id", 0)
                        or 0
                    )
                    == self.history_selected_actor
                ),
                None,
            )
            if modern_history and getattr(self, "history_duration_value", None) is not None:
                self.history_duration_value.configure(
                    text=format_duration(
                        self._history_display_duration(record, healing_mode)
                    )
                )
            if self.history_detail_label is not None:
                if boss_mode:
                    coverage_text, _coverage_color = (
                        self._history_boss_coverage_text(boss_damage)
                    )
                    self.history_detail_label.configure(text=coverage_text)
                elif healing_mode:
                    if not isinstance(selected_participant, dict):
                        self.history_detail_label.configure(text="暂无治疗详情")
                        selected_participant = None
                    else:
                        response = selected_participant.get("response", {})
                        response = response if isinstance(response, dict) else {}
                        self.history_detail_label.configure(
                            text=(
                                "响应 快"
                                f"{format_response_time(response.get('fastest_ms'))} / "
                                f"慢{format_response_time(response.get('slowest_ms'))}"
                            )
                        )
                elif taken_mode:
                    self.history_detail_label.configure(
                        text="承伤当前仅提供玩家汇总，暂无可靠的技能归属"
                    )
                else:
                    critical_rate = (
                        selected_participant.get("critical_rate")
                        if isinstance(selected_participant, dict)
                        else None
                    )
                    try:
                        critical_text = (
                            f"{float(critical_rate) * 100:.1f}%"
                            if critical_rate is not None
                            else "--"
                        )
                    except (TypeError, ValueError, OverflowError):
                        critical_text = "--"
                    penetration_rate = (
                        selected_participant.get("penetration_rate")
                        if isinstance(selected_participant, dict)
                        else None
                    )
                    try:
                        penetration_text = (
                            f"{float(penetration_rate) * 100:.1f}%"
                            if penetration_rate is not None
                            else "--"
                        )
                    except (TypeError, ValueError, OverflowError):
                        penetration_text = "--"
                    try:
                        deaths = max(
                            0,
                            int(selected_participant.get("deaths", 0) or 0),
                        )
                    except (AttributeError, TypeError, ValueError, OverflowError):
                        deaths = 0
                    try:
                        revives = max(
                            0,
                            int(selected_participant.get("revives", 0) or 0),
                        )
                        death_duration = max(
                            0.0,
                            float(
                                selected_participant.get(
                                    "death_duration_seconds", 0.0
                                )
                                or 0.0
                            ),
                        )
                    except (AttributeError, TypeError, ValueError, OverflowError):
                        revives = 0
                        death_duration = 0.0
                    detail_status = str(
                        selected_participant.get("skill_detail_status", "")
                        if isinstance(selected_participant, dict)
                        else ""
                    )
                    try:
                        server_damage_difference = max(
                            0,
                            int(
                                selected_participant.get(
                                    "server_damage_difference", 0
                                )
                                or 0
                            ),
                        )
                    except (AttributeError, TypeError, ValueError, OverflowError):
                        server_damage_difference = 0
                    detail_suffix = (
                        "  ·  服务器未返回技能明细"
                        if detail_status == "pending_server_detail"
                        else (
                            "  ·  结算未归类 "
                            f"{format_number(server_damage_difference)}"
                            if server_damage_difference > 0
                            else ""
                        )
                    )
                    self.history_detail_label.configure(
                        text=(
                            f"暴击率 {critical_text}  ·  穿刺率 {penetration_text}  ·  "
                            f"死亡 {deaths}  ·  "
                            f"复活 {revives}  ·  死亡时间 {format_duration(death_duration)}"
                            f"{detail_suffix}"
                        )
                    )
        local_modules_visible = self._sync_history_local_detail_modules()
        self._sync_history_detail_metric_copy(
            healing_mode=healing_mode,
            taken_mode=taken_mode,
            boss_mode=boss_mode,
        )
        if modern_history:
            self._update_history_team_average_rating(record)
        if boss_mode:
            self._render_history_boss_source_summary(
                record if isinstance(record, dict) else None,
                participants,
                selected_participant,
            )
        else:
            self._render_history_player_summary(
                record if isinstance(record, dict) else None,
                participants,
                selected_participant,
                healing_mode=healing_mode,
                taken_mode=taken_mode,
            )
        self._set_history_detail_mode(self.history_detail_mode)
        self._draw_history_list()
        self._draw_history_participant_header()
        self._draw_history_participants()
        self._draw_history_skills()
        self._draw_history_detail_result()
        self._draw_history_detail_trend()
        self._draw_history_detail_hero()
        self._draw_history_skill_share()
        if local_modules_visible:
            self._draw_history_skill_quality()
            self._draw_history_critical_luck()
            self._draw_history_skill_timeline()

    def _history_participant_columns(self, width: int) -> dict[str, int]:
        meter_mode = getattr(self, "history_meter_mode", "dps")
        if meter_mode == "hps":
            enabled = list(self._enabled_healing_metrics())
        elif meter_mode == "dt":
            enabled = list(self._enabled_taken_metrics())
        else:
            enabled = list(self._enabled_damage_metrics())
        right_edge = max(100, width - 16)
        if len(enabled) <= 1:
            name_ratio = 0.45
        elif len(enabled) == 2:
            name_ratio = 0.38
        elif len(enabled) == 3:
            name_ratio = 0.33
        else:
            name_ratio = 0.27
        reserved = max(36, 42 * len(enabled))
        name_limit = min(
            220,
            right_edge - reserved,
            max(120, int(width * name_ratio)),
        )
        name_limit = max(90, name_limit)
        columns = {
            "rank": 28,
            "profession_icon": 48,
            "name": 76,
            "name_limit": name_limit,
        }
        if not enabled:
            return columns
        columns.update(self._weighted_metric_columns(enabled, name_limit, right_edge))
        return columns

    def _draw_history_participant_header(self) -> None:
        canvas = self.history_participant_header_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        if getattr(self, "history_meter_mode", "dps") == "boss_damage":
            for text, x, anchor in (
                ("首领 / 机制", 12, "w"),
                ("已归类伤害", int(width * 0.67), "e"),
                ("占比", width - 14, "e"),
            ):
                canvas.create_text(
                    x,
                    15,
                    text=text,
                    fill=MUTED,
                    anchor=anchor,
                    font=self._ui_font("table_header"),
                )
            return
        columns = self._history_participant_columns(width)
        for text, x, anchor in (
            ("排名", 12, "w"),
            ("玩家名称", columns["name"], "w"),
        ):
            canvas.create_text(
                x,
                15,
                text=text,
                fill=MUTED,
                anchor=anchor,
                font=self._ui_font("table_header"),
            )
        captions = {
            "damage": "总伤害",
            "dps": "秒伤",
            "share": "占比",
            "critical": "暴击率",
            "penetration": "穿刺率",
            "deaths": "死亡",
            "revives": "复活",
            "death_time": "死亡时间",
            "effective": "有效治疗",
            "hps": "HPS",
            "overheal": "过量率",
            "taken": "总承伤",
            "taken_share": "承伤占比",
        }
        meter_mode = getattr(self, "history_meter_mode", "dps")
        if meter_mode == "hps":
            metric_keys = ("effective", "hps", "overheal")
        elif meter_mode == "dt":
            metric_keys = ("taken", "taken_share")
        else:
            metric_keys = (
                "damage",
                "dps",
                "share",
                "critical",
                "penetration",
                "deaths",
                "revives",
                "death_time",
