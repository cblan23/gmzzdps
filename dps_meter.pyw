        # Keep the action reachable even when a long server/status message
        # temporarily increases the requested height of the content column.
        self.login_button.pack(side="bottom", fill="x")
        self.login_button.bind(
            "<Enter>", lambda _event: self._sync_login_disclaimer_state(hover=True)
        )
        self.login_button.bind(
            "<Leave>", lambda _event: self._sync_login_disclaimer_state()
        )
        self.login_button.bind(
            "<Button-1>", lambda _event: self._complete_card_login()
        )
        self._sync_login_disclaimer_state()

        window.bind("<Return>", lambda _event: self._complete_card_login())
        window.update_idletasks()
        fitted_width = max(width, window.winfo_reqwidth())
        fitted_height = max(height, window.winfo_reqheight())
        if (fitted_width, fitted_height) != (width, height):
            x = max(0, (self.root.winfo_screenwidth() - fitted_width) // 2)
            y = max(0, (self.root.winfo_screenheight() - fitted_height) // 2)
            window.geometry(
                format_absolute_tk_geometry(
                    fitted_width, fitted_height, x, y
                )
            )
            window.update_idletasks()
        if not activate:
            self._sync_login_window_taskbar(window, no_activate=True)
        window.deiconify()
        self._sync_login_window_taskbar(window, no_activate=not activate)
        window.after(20, lambda: self._apply_windows_style(window))
        window.after(
            45,
            lambda: self._finish_login_window_presentation(window, activate),
        )
        if activate:
            window.after(50, self.login_card_entry.focus_set)
            window.lift()
            window.focus_force()

        # Tk can recalculate wrapped labels once the toplevel is mapped. Fit
        # once more after mapping so the bottom action is not clipped at high
        # DPI or after a long login error is displayed.
        window.after_idle(self._fit_login_window)

    def _fit_login_window(self) -> None:
        """Keep the login action inside the visible, DPI-scaled toplevel."""

        window = self.login_window
        if self.closing or window is None or not window.winfo_exists():
            return
        try:
            window.update_idletasks()
            dpi = get_window_dpi(window)
            base_width, base_height = login_window_dimensions(
                dpi, self.process_is_elevated
            )
            width = max(base_width, int(window.winfo_reqwidth()))
            height = max(base_height, int(window.winfo_reqheight()))
            parsed = parse_absolute_tk_geometry(window.geometry())
            if parsed is None:
                x = max(0, (window.winfo_screenwidth() - width) // 2)
                y = max(0, (window.winfo_screenheight() - height) // 2)
            else:
                _old_width, _old_height, x, y = parsed
            areas = self._monitor_work_areas()
            area = next(
                (
                    candidate
                    for candidate in areas
                    if candidate[0] <= x < candidate[2]
                    and candidate[1] <= y < candidate[3]
                ),
                areas[0]
                if areas
                else (0, 0, window.winfo_screenwidth(), window.winfo_screenheight()),
            )
            left, top, right, bottom = area
            width = min(width, max(1, right - left))
            height = min(height, max(1, bottom - top))
            x = min(max(x, left), right - width)
            y = min(max(y, top), bottom - height)
            geometry = format_absolute_tk_geometry(width, height, x, y)
            if window.geometry() != geometry:
                window.geometry(geometry)
                window.update_idletasks()
        except (AttributeError, RuntimeError, TypeError, ValueError, tk.TclError):
            return

    def _finish_login_window_presentation(
        self, window: tk.Misc, activate: bool
    ) -> None:
        if self.closing or not window.winfo_exists():
            return
        # ``WS_EX_NOACTIVATE`` is used only while an expired session returns to
        # this window.  Clear it after the map so the user can interact with the
        # login page normally when they choose it from the taskbar.
        self._sync_login_window_taskbar(window, no_activate=False)
        self._set_window_topmost_noactivate(window, False)
        if activate:
            window.lift()

    def _minimize_login_window(self) -> None:
        window = self.login_window
        if self.closing or window is None or not window.winfo_exists():
            return
        try:
            window.grab_release()
        except tk.TclError:
            pass
        if sys.platform == "win32":
            try:
                import ctypes
                from ctypes import wintypes

                hwnd = self._win32_root_handle(window)
                if hwnd:
                    user32 = ctypes.WinDLL("user32", use_last_error=True)
                    show_window = user32.ShowWindow
                    show_window.argtypes = (wintypes.HWND, ctypes.c_int)
                    show_window.restype = wintypes.BOOL
                    show_window(hwnd, 6)  # SW_MINIMIZE
                    return
            except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
                pass
        # An override-redirect window cannot be iconified on every Tk build.
        # With no native taskbar support available, hiding it keeps the login
        # page reachable from the tray without leaving it over another game.
        window.withdraw()

    def _show_user_notice(self) -> None:
        parent = self.login_window
        if parent is None or not parent.winfo_exists():
            return
        if self.user_notice_window is not None and self.user_notice_window.winfo_exists():
            self.user_notice_window.deiconify()
            self.user_notice_window.lift(parent)
            self.user_notice_window.focus_force()
            return

        parent.update_idletasks()
        notice_font_growth = max(
            0, min(5, int(getattr(self, "ui_font_size", 13)) - 13)
        )
        logical_width = 720
        logical_height = 510 + notice_font_growth * 16
        initial_dpi = get_window_dpi(parent)
        width = logical_pixels_to_physical(logical_width, initial_dpi)
        height = logical_pixels_to_physical(logical_height, initial_dpi)
        x = parent.winfo_rootx() + (parent.winfo_width() - width) // 2
        y = parent.winfo_rooty() + (parent.winfo_height() - height) // 2
        window = tk.Toplevel(parent)
        window.withdraw()
        self.user_notice_window = window
        window.title(f"{UI_BRAND} · 用户须知")
        window.transient(parent)
        window.configure(bg=BORDER)
        window.geometry(
            self._visible_geometry(
                format_absolute_tk_geometry(width, height, x, y), width, height
            )
