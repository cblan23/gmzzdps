        self.targetless_team_last_progress_at = 0.0
        self.targetless_team_last_snapshot_at = 0.0
        self.targetless_team_duration_seconds = 0.0
        self.targetless_team_server_duration_seconds = 0.0
        self.targetless_team_full_snapshot_seen = False
        self.targetless_team_pending_time_100ns = 0
        self.targetless_team_pending_tokens: set[str] = set()
        self.targetless_team_pending_rows: dict[
            str, tuple[int, int, int, int]
        ] = {}
        self.targetless_team_last_committed_time_100ns = 0
        self.team_taken_states: dict[int, TeamTakenState] = {}
        self.team_healing_states: dict[int, TeamHealingState] = {}
        self.stage_actor_taken: dict[int, int] = {}
        self.team_server_time = 0
        self.team_counter_regressions: list[dict] = []
        self.team_server_update_100ns = 0
        self.encounter_start_signal_100ns = 0
        self.enrage_countdown_signal = ""
        self.enrage_countdown_start_100ns = 0
        self.team_zero_baseline_signal_100ns = 0
        self.stage_summaries: dict[str, dict] = {}
        self.stage_actor_metrics: dict[int, tuple[int, int]] = {}
        self.stage_actor_penetration_metrics: dict[int, tuple[int, int]] = {}
        self.stage_skill_snapshots: dict[int, StageSkillSnapshot] = {}
        self.pending_stage_skill_snapshots: dict[int, StageSkillSnapshot] = {}
        self.pending_stage_actor_taken: dict[int, tuple[int, int, str, int]] = {}
        self.stage_healing_snapshots: dict[int, StageHealingSnapshot] = {}
        # A formal server settlement can be the only complete team-wide
        # source when passive capture observed only the local actor.  Keep the
        # rows separate from live counters so ordinary Common/Dirty updates
        # cannot accidentally turn a final table into a new cumulative epoch.
        self.stage_authoritative_stats: dict[int, ActorStats] = {}
        self.stage_authoritative_summary_id = ""
        self.stage_authoritative_summary_time_100ns = 0
        self.seen_stage_summary_ids: set[str] = set()
        self.rejected_stage_summary_ids: set[str] = set()
