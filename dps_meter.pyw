    def _toggle_lock_from_header(self, _event=None) -> str:
        self.toggle_window_lock()
        return "break"

    def _compact_lock_enter(self, _event=None) -> None:
        self.header_canvas.configure(cursor="hand2")
        self.header_canvas.itemconfigure("compact_lock_bg", fill=PANEL_2)

    def _compact_lock_leave(self, _event=None) -> None:
        self.header_canvas.configure(cursor="")
        self.header_canvas.itemconfigure("compact_lock_bg", fill=SURFACE)

    def _restore_compact_from_header(self, _event=None) -> str:
        if self.compact_mode and not self.window_locked:
            self.toggle_compact_mode()
        return "break"

    def _compact_restore_enter(self, _event=None) -> None:
        self.header_canvas.configure(cursor="hand2")
        self.header_canvas.itemconfigure("compact_restore_bg", fill=PANEL_2)

    def _compact_restore_leave(self, _event=None) -> None:
        self.header_canvas.configure(cursor="")
        self.header_canvas.itemconfigure("compact_restore_bg", fill=SURFACE)

    def _invalidate_team_rating_preview_rows(
        self,
        *actor_ids: object,
        clear_profiles: bool = False,
    ) -> None:
        self.team_rating_preview_rows_dirty = True
        profile_cache = getattr(
            self, "team_rating_preview_profile_cache", None
        )
        if not isinstance(profile_cache, dict):
            self.team_rating_preview_profile_cache = {}
            profile_cache = self.team_rating_preview_profile_cache
        profile_signatures = getattr(
            self, "team_rating_preview_profile_signatures", None
        )
        if not isinstance(profile_signatures, dict):
            self.team_rating_preview_profile_signatures = {}
            profile_signatures = self.team_rating_preview_profile_signatures
        if clear_profiles:
            profile_cache.clear()
            profile_signatures.clear()
            self.team_rating_preview_roster_signature = None
            return
        for actor_id in actor_ids:
            try:
                parsed_actor_id = int(actor_id or 0)
            except (TypeError, ValueError, OverflowError):
                continue
            if parsed_actor_id:
                profile_cache.pop(parsed_actor_id, None)
                profile_signatures.pop(parsed_actor_id, None)

    def _clear_team_equipment_profiles(self) -> None:
        profiles = getattr(self, "team_equipment_profiles", None)
        if isinstance(profiles, dict) and profiles:
            profiles.clear()
        requested_tokens = getattr(
            self, "team_equipment_requested_tokens", None
        )
        if isinstance(requested_tokens, set):
            requested_tokens.clear()
        for attribute in (
            "team_equipment_profile_ratings",
            "team_equipment_requested_ratings",
            "team_equipment_requested_at",
            "team_equipment_attempts",
            "team_equipment_attempt_ratings",
            "team_equipment_profile_capture_sessions",
        ):
            values = getattr(self, attribute, None)
            if isinstance(values, dict):
                values.clear()
        self.team_equipment_context = None
        self.team_equipment_next_retry_check_at = 0.0
        self._invalidate_team_rating_preview_rows(clear_profiles=True)

    def _current_team_equipment_tokens(self) -> set[str]:
        model = getattr(self, "model", None)
        pvp_members = self._pvp_equipment_members()
        if self._pvp_equipment_context_active():
            # A formal arena roster is a separate lifetime from the ordinary
            # PVE party. Never mix a stale/pre-entry party into this match.
            return {
                str(member.get("user_token", "") or "").strip()
                for member in pvp_members
                if str(member.get("user_token", "") or "").strip()
            }
        values = getattr(model, "party_user_tokens", set())
        tokens = {
            str(value or "").strip()
            for value in values
            if str(value or "").strip()
        }
        self_token = str(
            getattr(model, "self_character_id", "") or ""
        ).strip()
        if self_token:
            tokens.add(self_token)
        for member in pvp_members:
            token = str(member.get("user_token", "") or "").strip()
            if token:
                tokens.add(token)
        return tokens

    def _pvp_equipment_members(self) -> list[dict[str, object]]:
        """Return only the roster belonging to the currently entered PVP map."""

        recording = getattr(self, "pvp_recording", None)
        if recording is None or not self._pvp_equipment_context_active():
            return []
        tracker = getattr(recording, "display_tracker", None)
        if tracker is None:
            return []
        if getattr(tracker, "duel", False):
            # An active duel has exactly two verified participants even if a
            # retained arena/party roster still exists on the tracker.
            result: list[dict[str, object]] = []
            self_token = str(getattr(tracker, "self_token", "") or "").strip()
            self_profile = dict(getattr(tracker, "profiles", {}).get(
                getattr(tracker, "self_id", 0), {}
            ))
            if self_token:
                result.append({
                    **self_profile,
                    "user_token": self_token,
                    "actor_id": int(getattr(tracker, "self_id", 0) or 0),
                    "is_self": True,
                    "side": "ally",
                    "entity_type": "Player",
                })
            opponent_token = str(
                getattr(tracker, "duel_opponent_token", "") or ""
            ).strip()
            opponent_actor = int(
                getattr(tracker, "duel_opponent_actor", 0) or 0
            )
            opponent_profile = dict(
                getattr(tracker, "profiles", {}).get(opponent_actor, {})
            )
            if opponent_token and opponent_token != self_token:
                result.append({
                    **opponent_profile,
                    "user_token": opponent_token,
                    "actor_id": opponent_actor,
                    "is_self": False,
                    "side": "enemy",
                    "entity_type": "Player",
                })
            return result
        reader = getattr(tracker, "pvp_team_members", None)
        if not callable(reader):
            return []
        recording_data = getattr(recording, "recording", None)
        finalized = getattr(recording, "last_finalized", None)
        map_id = (
            recording_data.get("map_id") if isinstance(recording_data, dict)
            else finalized.get("map_id") if isinstance(finalized, dict)
            else getattr(tracker, "map_id", None)
        )
        league = getattr(tracker, "pvp_league_roster", {}) or {}
        if league.get("raids"):
            return [
                dict(member, side="ally",
                     actor_id=int(getattr(tracker, "tokens", {}).get(member["user_token"], 0) or 0))
                for raid in sorted(league["raids"].values(), key=lambda item: item["number"])
                for group_number in sorted(raid["groups"])
                for member in raid["groups"][group_number]
            ][:PVP_MAX_TEAM_MEMBERS]
        if map_id in HUNTER_CITY_MAPS:
            members = reader(include_self=True)
            allies = {
                str(token).strip()
                for token in (
                    getattr(recording, "party_tokens", set())
                    | set(getattr(tracker, "pvp_allies", {}))
                )
                if str(token or "").strip()
            }
            allies.add(str(getattr(tracker, "self_token", "") or "").strip())
            known = {str(row.get("user_token") or "").strip() for row in members}
            interacted = set(getattr(tracker, "outgoing", {})) | set(
                getattr(tracker, "incoming", {})
            )
            interacted.update(getattr(tracker, "pvp_enemies", {}))
            for key in sorted(interacted):
                interaction = (
                    getattr(tracker, "outgoing", {}).get(key)
                    or getattr(tracker, "incoming", {}).get(key)
                    or {}
                )
                actor = int(interaction.get("actor_id") or 0)
                profile = {
                    **getattr(tracker, "token_profiles", {}).get(key, {}),
                    **getattr(tracker, "profiles", {}).get(actor, {}),
                }
                token = str(profile.get("user_token") or key).strip()
                if (not token or token.startswith("entity:") or token in allies
                        or token in known or profile.get("is_ai") is True
                        or (profile.get("entity_type") == "NPC"
                            and key not in getattr(tracker, "pvp_enemies", {}))):
                    continue
                members.append({
                    **profile,
                    "user_token": token,
                    "actor_id": actor,
                    "is_self": False,
                    "side": "enemy",
                })
                known.add(token)
            return members
        if not getattr(tracker, "pvp_allies", None):
            return []
        members = reader(include_self=True)
        enemy_members = reader(side="enemy")
        if enemy_members:
            known_tokens = {
                str(row.get("user_token") or "").strip()
                for row in members
                if str(row.get("user_token") or "").strip()
            }
            members.extend(
                row
                for row in enemy_members
                if str(row.get("user_token") or "").strip()
                not in known_tokens
            )
        if members:
            return members
        return []

    def _team_equipment_local_token(self) -> str:
        model = getattr(self, "model", None)
        if self._pvp_equipment_context_active():
            recording = getattr(self, "pvp_recording", None)
            tracker = getattr(recording, "display_tracker", None)
            token = str(getattr(tracker, "self_token", "") or "").strip()
            if token:
                return token
        token = str(
            getattr(model, "self_character_id", "") or ""
        ).strip()
        if token:
            return token
        return next(
            (
                str(member.get("user_token", "") or "").strip()
                for member in self._pvp_equipment_members()
                if bool(member.get("is_self"))
                and str(member.get("user_token", "") or "").strip()
            ),
            "",
        )

    def _current_team_equipment_capture_session_id(self) -> int:
        try:
            session_id = int(
                getattr(self, "active_capture_session_id", 0) or 0
            )
        except (TypeError, ValueError, OverflowError):
            session_id = 0
        if session_id > 0:
            return session_id
        worker = getattr(self, "worker", None)
        session_reader = getattr(worker, "equipment_session", None)
        if not callable(session_reader):
            return 0
        try:
            _game_pid, session_id = session_reader()
            return max(0, int(session_id or 0))
        except (TypeError, ValueError, OverflowError):
            return 0

    def _team_equipment_party_session_id(self) -> int:
        """Return one stable live-team identity for either PVE or PVP."""

        model = getattr(self, "model", None)
        recording = getattr(self, "pvp_recording", None)
        if self._pvp_equipment_context_active():
            match_id = ""
            for candidate in (
                getattr(recording, "recording", None),
                getattr(recording, "duel_recording", None),
            ):
                if isinstance(candidate, dict):
                    match_id = str(candidate.get("match_id") or "").strip()
                    if match_id:
                        break
            if not match_id:
                match_id = str(
                    getattr(recording, "finalized_equipment_match_id", "")
                    or getattr(recording, "presented_match_id", "")
                    or ""
                ).strip()
            tracker = getattr(recording, "display_tracker", None)
            identity = "|".join(
                [
                    "pvp",
                    match_id,
                    str(getattr(tracker, "map_id", 0) or 0),
                    str(getattr(tracker, "instance_id", 0) or 0),
                ]
            )
            return int.from_bytes(
                hashlib.sha256(identity.encode("utf-8")).digest()[:4], "little"
            ) or 1
        party_session_id = int(
            getattr(model, "party_session_id", 0) or 0
        )
        if bool(getattr(model, "party_active", False)) and party_session_id > 0:
            return party_session_id
        members = self._pvp_equipment_members()
        tokens = sorted(
            str(member.get("user_token", "") or "").strip()
            for member in members
            if str(member.get("user_token", "") or "").strip()
        )
        if not tokens:
            # The shape RPC can also return the local role. Use a deterministic
            # solo context so a PVE player is queried without inventing a team
            # member or accepting a response from a previous character.
            local_token = str(
                getattr(model, "self_character_id", "") or ""
            ).strip()
            if not local_token:
                return 0
            identity = "solo|" + local_token
            return int.from_bytes(
                hashlib.sha256(identity.encode("utf-8")).digest()[:4], "little"
            ) or 1
        tracker = (
            recording.display_tracker
            if recording is not None
            else getattr(self, "pvp_tracker", None)
        )
        pvp_party_session_id = int(
            getattr(recording, "party_session_id", 0) or 0
        )
        if pvp_party_session_id > 0:
            return pvp_party_session_id
        identity = "|".join(
            [
                str(getattr(tracker, "map_id", 0) or 0),
                str(getattr(tracker, "instance_id", 0) or 0),
                str(getattr(recording, "map_entered_at_ns", 0) or 0),
            ]
        )
        return int.from_bytes(
            hashlib.sha256(identity.encode("utf-8")).digest()[:4], "little"
        ) or 1

    def _schedule_team_equipment_profiles(
        self,
        *,
        extra_attempt_tokens: set[str] | None = None,
        refresh_token: str = "",
    ) -> bool:
        model = getattr(self, "model", None)
        worker = getattr(self, "worker", None)
        submit = getattr(worker, "schedule_equipment_profiles", None)
        session_reader = getattr(worker, "equipment_session", None)
        if model is None or not callable(submit) or not callable(session_reader):
            return False
        extra_attempt_tokens = {
            str(token or "").strip()
            for token in (extra_attempt_tokens or set())
            if str(token or "").strip()
        }
        refresh_token = str(refresh_token or "").strip()
        game_pid, capture_session_id = session_reader()
        party_session_id = self._team_equipment_party_session_id()
        local_token = self._team_equipment_local_token()
        if (
            int(game_pid or 0) <= 0
            or int(capture_session_id or 0) <= 0
            or party_session_id <= 0
            or not local_token
        ):
            return False

        actor_tokens = getattr(model, "actor_character_ids", {})
        token_actors = {
            str(token or "").strip(): int(actor_id)
            for actor_id, token in (
                actor_tokens.items() if isinstance(actor_tokens, dict) else ()
            )
            if str(token or "").strip()
        }
        pvp_context = self._pvp_equipment_context_active()
        pvp_members = {
            str(member.get("user_token", "") or "").strip(): dict(member)
            for member in self._pvp_equipment_members()
            if str(member.get("user_token", "") or "").strip()
        }
        cached_profiles = getattr(worker, "team_profile_cache", {})
        if not isinstance(cached_profiles, dict):
            cached_profiles = {}
        members: list[dict[str, object]] = []
        member_tokens = sorted(self._current_team_equipment_tokens())
        recording = getattr(self, "pvp_recording", None)
        active_match = getattr(recording, "recording", None)
        if (
            isinstance(active_match, dict)
            and (
                active_match.get("map_id") in HUNTER_CITY_MAPS
                or int(RECORDABLE_MAPS.get(active_match.get("map_id"), {}).get("team_size", 0) or 0) == 6
            )
        ):
            member_tokens.sort(
                key=lambda token: (
                    pvp_members.get(token, {}).get("side") != "enemy", token
                )
            )
        else:
            member_tokens.sort(key=lambda token: (token != local_token, token))
        for token in member_tokens:
            pvp_member = pvp_members.get(token, {})
            cached_profile = cached_profiles.get(token, {})
            if not isinstance(cached_profile, dict):
                cached_profile = {}
            actor_id = int(
                token_actors.get(token, 0)
                or pvp_member.get("actor_id", 0)
                or 0
            )
            name = (
                str(model.display_name(actor_id) or "").strip()
                if actor_id
                else ""
            )
            if not name:
                name = str(pvp_member.get("name", "") or "").strip()
            if not name:
                name = str(cached_profile.get("name", "") or "").strip()
            actor_is_ai = getattr(model, "actor_is_ai", None)
            is_ai = (
                bool(pvp_member.get("is_ai"))
                or pvp_bot_evidence({**pvp_member, "name": name})
                or bool(
                    actor_id
                    and callable(actor_is_ai)
                    and actor_is_ai(actor_id)
                )
                or (
                    not pvp_context
                    and name.endswith(PROJECTION_NAME_SUFFIX)
                )
            )
            rating = normalize_extraordinary_rating(
                pvp_member.get("extraordinary_rating")
            )
            if rating is None and actor_id and not is_ai:
                rating = self._main_extraordinary_rating(actor_id)
            members.append(
                {
                    "user_token": token,
                    "actor_id": actor_id,
                    "name": name,
                    "is_ai": is_ai,
                    "side": pvp_member.get("side", ""),
                    "extraordinary_rating": rating if not is_ai else None,
                }
            )
        if not any(not bool(member["is_ai"]) for member in members):
            return False
        requested_tokens = getattr(
            self, "team_equipment_requested_tokens", None
        )
        if not isinstance(requested_tokens, set):
            requested_tokens = set()
            self.team_equipment_requested_tokens = requested_tokens
        profile_ratings = getattr(
            self, "team_equipment_profile_ratings", None
        )
        if not isinstance(profile_ratings, dict):
            profile_ratings = {}
            self.team_equipment_profile_ratings = profile_ratings
        profile_capture_sessions = getattr(
            self, "team_equipment_profile_capture_sessions", None
        )
        if not isinstance(profile_capture_sessions, dict):
            profile_capture_sessions = {}
            self.team_equipment_profile_capture_sessions = profile_capture_sessions
        for token in self.team_equipment_profiles:
            profile_capture_sessions.setdefault(token, int(capture_session_id))
        requested_ratings = getattr(
            self, "team_equipment_requested_ratings", None
        )
        if not isinstance(requested_ratings, dict):
            requested_ratings = {}
            self.team_equipment_requested_ratings = requested_ratings
        requested_at = getattr(self, "team_equipment_requested_at", None)
        if not isinstance(requested_at, dict):
            requested_at = {}
            self.team_equipment_requested_at = requested_at
        attempts = getattr(self, "team_equipment_attempts", None)
        if not isinstance(attempts, dict):
            attempts = {}
            self.team_equipment_attempts = attempts
        attempt_ratings = getattr(self, "team_equipment_attempt_ratings", None)
        if not isinstance(attempt_ratings, dict):
            attempt_ratings = {}
            self.team_equipment_attempt_ratings = attempt_ratings
        current_tokens = {str(member["user_token"]) for member in members}
        current_member_ratings = {
            str(member["user_token"]): normalize_extraordinary_rating(
                member.get("extraordinary_rating")
            )
            for member in members
        }
        context = (int(game_pid), local_token, party_session_id)
        previous_context = getattr(self, "team_equipment_context", None)
        if context != previous_context:
            same_character = bool(
                isinstance(previous_context, tuple)
                and len(previous_context) == 3
                and previous_context[:2] == context[:2]
            )
            retained_profiles = {
                token: profile
                for token, profile in self.team_equipment_profiles.items()
                if same_character
                and token in current_tokens
            }
            retained_ratings = {}
            for token in retained_profiles:
                current_rating = current_member_ratings.get(token)
                retained_ratings[token] = (
                    current_rating
                    if current_rating is not None
                    else profile_ratings.get(token)
                )
            self.team_equipment_profiles.clear()
            self.team_equipment_profiles.update(retained_profiles)
            requested_tokens.clear()
            profile_ratings.clear()
            profile_ratings.update(retained_ratings)
            requested_ratings.clear()
            requested_at.clear()
            attempts.clear()
            attempt_ratings.clear()
            self.team_equipment_context = context
            self._invalidate_team_rating_preview_rows(clear_profiles=True)
        for stale in set(self.team_equipment_profiles) - current_tokens:
            self.team_equipment_profiles.pop(stale, None)
        requested_tokens.intersection_update(current_tokens)
        for mapping in (
            profile_ratings, requested_ratings, requested_at,
            attempts, attempt_ratings, profile_capture_sessions,
        ):
            for stale in set(mapping) - current_tokens:
                mapping.pop(stale, None)

        # Teammate snapshots wait for a manual refresh after their rating
        # changes. The local player's snapshot refreshes automatically.
        for member in members:
            if bool(member["is_ai"]):
                continue
            token = str(member["user_token"])
            current_rating = normalize_extraordinary_rating(
                member.get("extraordinary_rating")
            )
            if (
                current_rating is not None
                and token in attempt_ratings
                and current_rating != attempt_ratings[token]
            ):
                attempts.pop(token, None)
                attempt_ratings.pop(token, None)
            if (
                token in requested_tokens
                and token not in self.team_equipment_profiles
                and token in requested_ratings
                and current_rating is not None
                and current_rating != requested_ratings.get(token)
            ):
                requested_tokens.discard(token)
                requested_ratings.pop(token, None)
                requested_at.pop(token, None)
            if token not in self.team_equipment_profiles:
                continue
            if token not in profile_ratings:
                profile_ratings[token] = current_rating
                continue
            previous_rating = profile_ratings.get(token)
            if current_rating is None or current_rating == previous_rating:
                continue
            if current_rating == normalize_extraordinary_rating(
                self.team_equipment_profiles[token].get("extraordinary_rating")
            ):
                # The shape response can already contain the rating that a
                # later roster update restores. Keep that matching snapshot.
                profile_ratings[token] = current_rating
                continue
        now = time.monotonic()
        for token in tuple(requested_tokens):
            requested_time = float(requested_at.get(token, 0.0) or 0.0)
            if (
                requested_time > 0
                and now - requested_time >= TEAM_EQUIPMENT_REQUEST_TIMEOUT_SECONDS
            ):
                requested_tokens.discard(token)
                requested_ratings.pop(token, None)
                requested_at.pop(token, None)
        if refresh_token:
            members_to_query = [
                member for member in members
                if str(member["user_token"]) == refresh_token
                and not bool(member["is_ai"])
                and refresh_token not in requested_at
                and self._equipment_refresh_fields(
                    int(member["actor_id"]), refresh_token,
                    member.get("extraordinary_rating"),
                )
            ]
        else:
            members_to_query = []
            for member in members:
                if bool(member["is_ai"]):
                    continue
                token = str(member["user_token"])
                attempt_limit = TEAM_EQUIPMENT_MAX_ATTEMPTS_PER_RATING + (
                    1 if token in extra_attempt_tokens else 0
                )
                if attempts.get(token, 0) >= attempt_limit:
                    continue
                if token not in self.team_equipment_profiles:
                    if token not in requested_tokens:
                        members_to_query.append(member)
                    continue
                if (
                    token == local_token
                    and token not in requested_at
                    and self._equipment_profile_refresh_token(
                        int(member["actor_id"]),
                        token,
                        member.get("extraordinary_rating"),
                    ) == token
                ):
                    members_to_query.append(member)
        if not members_to_query:
            return False
        # PVE and PVP both query one player at a time. Keep the HUD roster
        # unbounded and mark each member only after the worker accepts it.
        scheduled_any = False
        for start in range(0, len(members_to_query), EQUIPMENT_QUERY_BATCH_SIZE):
            batch = members_to_query[
                start : start + EQUIPMENT_QUERY_BATCH_SIZE
            ]
            try:
                scheduled = bool(
                    submit(
                        {
                            "local_user_token": local_token,
                            "party_session_id": party_session_id,
                            "member_count": int(
                                max(
                                    int(getattr(model, "party_member_count", 0) or 0),
                                    len(members),
                                )
                            ),
                            "members": batch,
                            "priority": any(
                                member.get("side") == "enemy" for member in batch
                            ),
                        }
                    )
                )
            except (AttributeError, TypeError, ValueError, RuntimeError):
                scheduled = False
            if not scheduled:
                continue
            scheduled_any = True
            # Teammates use an explicit click; the local player reaches this
            # path automatically after a verified rating change.
            for member in batch:
                token = str(member["user_token"])
                requested_tokens.add(token)
                requested_ratings[token] = normalize_extraordinary_rating(
                    member.get("extraordinary_rating")
                )
                requested_at[token] = now
                attempts[token] = attempts.get(token, 0) + 1
                attempt_ratings[token] = requested_ratings[token]
        return scheduled_any

    def _queue_equipment_snapshot_upload(self, payload: dict[str, object]) -> bool:
        recording = getattr(self, "pvp_recording", None)
        account_key = str(getattr(recording, "account_key", "") or "")
        uploader = getattr(self, "pvp_upload_worker", None)
        enqueue = getattr(uploader, "enqueue_equipment_snapshot", None)
        if not account_key or not callable(enqueue):
            return False
        try:
            return bool(enqueue(account_key, payload))
        except (TypeError, ValueError, OverflowError, OSError, RuntimeError) as error:
            experiment = getattr(self, "settlement_experiment", None)
            if experiment is not None:
                experiment.lifecycle(
                    "equipment_snapshot_queue_failed",
                    component="main_window",
                    error_type=type(error).__name__,
                    details=str(error)[:512],
                )
            return False

    def _ingest_team_equipment_profile(self, payload: object) -> bool:
        if not isinstance(payload, dict):
            return False
        worker = getattr(self, "worker", None)
        session_reader = getattr(worker, "equipment_session", None)
        if not callable(session_reader):
            return False
        game_pid, capture_session_id = session_reader()
        model = self.model
        local_token = self._team_equipment_local_token()
        party_session_id = self._team_equipment_party_session_id()
        current_tokens = sorted(self._current_team_equipment_tokens())
        if not profile_matches_session(
            payload,
            game_pid=game_pid,
            capture_session_id=capture_session_id,
            local_user_token=local_token,
            party_session_id=party_session_id,
            current_tokens=current_tokens,
        ):
            return False
        token = str(payload.get("user_token", "") or "").strip()
        name = str(payload.get("name", "") or "").strip()
        actor_tokens = getattr(model, "actor_character_ids", {})
        actor_id = next(
            (
                int(actor)
                for actor, candidate in (
                    actor_tokens.items()
                    if isinstance(actor_tokens, dict)
                    else ()
                )
                if str(candidate or "").strip() == token
            ),
            0,
        )
        pvp_context = self._pvp_equipment_context_active()
        pvp_members = {
            str(member.get("user_token", "") or "").strip(): dict(member)
            for member in self._pvp_equipment_members()
            if str(member.get("user_token", "") or "").strip()
        }
        pvp_member = pvp_members.get(token, {})
        cached_profiles = getattr(worker, "team_profile_cache", {})
        cached_profile = (
            cached_profiles.get(token, {})
            if isinstance(cached_profiles, dict)
            else {}
        )
        if not isinstance(cached_profile, dict):
            cached_profile = {}
        known_name = (
            name
            or str(pvp_member.get("name", "") or "").strip()
            or str(cached_profile.get("name", "") or "").strip()
        )
        actor_is_ai = getattr(model, "actor_is_ai", None)
        is_ai = (
            bool(pvp_member.get("is_ai"))
            or pvp_bot_evidence({**pvp_member, "name": known_name})
            or bool(
                actor_id
                and callable(actor_is_ai)
                and actor_is_ai(actor_id)
            )
            or (
                not pvp_context
                and known_name.endswith(PROJECTION_NAME_SUFFIX)
            )
        )
        if is_ai:
            self.team_equipment_profiles.pop(token, None)
            requested_tokens = getattr(
                self, "team_equipment_requested_tokens", None
            )
            if isinstance(requested_tokens, set):
                requested_tokens.discard(token)
            for attribute in (
                "team_equipment_profile_ratings",
                "team_equipment_requested_ratings",
                "team_equipment_requested_at",
                "team_equipment_attempts",
                "team_equipment_attempt_ratings",
                "team_equipment_profile_capture_sessions",
            ):
                values = getattr(self, attribute, None)
                if isinstance(values, dict):
                    values.pop(token, None)
            self._invalidate_team_rating_preview_rows(actor_id)
            return False
        next_profile = {
            "user_token": token,
            "name": name,
            "equipment_count": max(
                0, int(payload.get("equipment_count", 0) or 0)
            ),
            "pvp_equipment_count": max(
                0, int(payload.get("pvp_equipment_count", 0) or 0)
            ),
            "active_word_count": max(
                0, int(payload.get("active_word_count", 0) or 0)
            ),
            "total_word_count": max(
                0, int(payload.get("total_word_count", 0) or 0)
            ),
            "batch_id": str(payload.get("batch_id", "") or ""),
            "correlation": int(payload.get("correlation", 0) or 0),
            "profession_id": int(payload.get("profession_id", 0) or 0),
            "extraordinary_rating": normalize_extraordinary_rating(
                payload.get("extraordinary_rating")
            ),
            "equipment_snapshot": deepcopy(
                payload.get("equipment_snapshot")
                if isinstance(payload.get("equipment_snapshot"), dict)
                else None
            ),
        }
        self._queue_equipment_snapshot_upload(payload)
        previous_profile = self.team_equipment_profiles.get(token)
        self.team_equipment_profiles[token] = next_profile
        profile_capture_sessions = getattr(
            self, "team_equipment_profile_capture_sessions", None
        )
        if not isinstance(profile_capture_sessions, dict):
            profile_capture_sessions = {}
            self.team_equipment_profile_capture_sessions = profile_capture_sessions
        profile_capture_sessions[token] = int(capture_session_id)
        requested_ratings = getattr(
            self, "team_equipment_requested_ratings", None
        )
        if not isinstance(requested_ratings, dict):
            requested_ratings = {}
            self.team_equipment_requested_ratings = requested_ratings
        profile_ratings = getattr(
            self, "team_equipment_profile_ratings", None
        )
        if not isinstance(profile_ratings, dict):
            profile_ratings = {}
            self.team_equipment_profile_ratings = profile_ratings
        if token in requested_ratings:
            requested_rating = requested_ratings.pop(token)
            profile_ratings[token] = (
                requested_rating
                if requested_rating is not None
                else next_profile["extraordinary_rating"]
            )
        else:
            profile_ratings[token] = (
                self._main_extraordinary_rating(actor_id)
                if actor_id
                else next_profile["extraordinary_rating"]
            )
        attempt_ratings = getattr(self, "team_equipment_attempt_ratings", None)
        if isinstance(attempt_ratings, dict) and profile_ratings[token] is not None:
            attempt_ratings[token] = profile_ratings[token]
        requested_at = getattr(self, "team_equipment_requested_at", None)
        if isinstance(requested_at, dict):
            requested_at.pop(token, None)
        self._invalidate_team_rating_preview_rows(actor_id)
        return previous_profile != next_profile

    def _rebaseline_team_equipment_rating_after_capture_change(
        self, payload: object
    ) -> bool:
        if not isinstance(payload, dict) or payload.get("source_method") == (
            "PeriodicLiveTeamRatingSnapshot"
        ):
            return False
        rating = normalize_extraordinary_rating(payload.get("extraordinary_rating"))
        if rating is None:
            return False
        try:
            actor_id = int(payload.get("entity_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            actor_id = 0
        token = str(payload.get("user_token", "") or "").strip()
        actor_tokens = getattr(self.model, "actor_character_ids", {})
        if not token and actor_id > 0 and isinstance(actor_tokens, dict):
            token = str(actor_tokens.get(actor_id, "") or "").strip()
        profiles = getattr(self, "team_equipment_profiles", {})
        if not token or token not in profiles:
            return False
        capture_session_id = self._current_team_equipment_capture_session_id()
        profile_capture_sessions = getattr(
            self, "team_equipment_profile_capture_sessions", None
        )
        if not isinstance(profile_capture_sessions, dict):
            profile_capture_sessions = {}
            self.team_equipment_profile_capture_sessions = profile_capture_sessions
        previous_session_id = int(profile_capture_sessions.get(token, 0) or 0)
        if (
            capture_session_id <= 0
            or previous_session_id <= 0
            or capture_session_id == previous_session_id
        ):
            return False
        profile_ratings = getattr(self, "team_equipment_profile_ratings", None)
        if not isinstance(profile_ratings, dict):
            profile_ratings = {}
            self.team_equipment_profile_ratings = profile_ratings
        profile_ratings[token] = rating
        profile_capture_sessions[token] = capture_session_id
        requested_tokens = getattr(self, "team_equipment_requested_tokens", None)
        if isinstance(requested_tokens, set):
            requested_tokens.discard(token)
        for attribute in (
            "team_equipment_requested_ratings",
            "team_equipment_requested_at",
            "team_equipment_attempts",
            "team_equipment_attempt_ratings",
        ):
            values = getattr(self, attribute, None)
            if isinstance(values, dict):
                values.pop(token, None)
        return True

    def _equipment_summary_for_actor(
        self, actor_id: int, user_token: object = ""
    ) -> dict[str, object]:
        model = self.model
        actor_tokens = getattr(model, "actor_character_ids", {})
        token = str(user_token or "").strip() or (
            str(actor_tokens.get(actor_id, "") or "").strip()
            if isinstance(actor_tokens, dict)
            else ""
        )
        if not token and actor_id == int(getattr(model, "self_id", 0) or 0):
            token = str(
                getattr(model, "self_character_id", "") or ""
            ).strip()
        profile = getattr(self, "team_equipment_profiles", {}).get(token)
        return dict(profile) if isinstance(profile, dict) else {}

    def _equipment_profile_refresh_token(
        self, actor_id: int, user_token: object = "", rating: object = None,
    ) -> str:
        profile = self._equipment_summary_for_actor(actor_id, user_token)
        token = str(profile.get("user_token") or user_token or "").strip()
        if not token:
            token = str(getattr(self.model, "actor_character_ids", {}).get(actor_id, "") or "").strip()
        if not token and actor_id == int(getattr(self.model, "self_id", 0) or 0):
            token = str(getattr(self.model, "self_character_id", "") or "").strip()
        if not profile or not token:
            return ""
        profile_capture_session_id = int(
            getattr(self, "team_equipment_profile_capture_sessions", {}).get(
                token, 0
            )
            or 0
        )
        current_capture_session_id = (
            self._current_team_equipment_capture_session_id()
        )
        if (
            profile_capture_session_id > 0
            and current_capture_session_id > 0
            and profile_capture_session_id != current_capture_session_id
        ):
            # A scene edge rotates passive capture before the new map's live
            # roster score arrives. Keep the equipment visible while waiting
            # for that direct score instead of showing a false refresh.
            return ""
        if rating is None:
            rating = getattr(self.model, "entity_extraordinary_ratings", {}).get(actor_id)
        current = normalize_extraordinary_rating(rating)
        previous = normalize_extraordinary_rating(
            getattr(self, "team_equipment_profile_ratings", {}).get(token)
        )
        if previous is None:
            previous = normalize_extraordinary_rating(profile.get("extraordinary_rating"))
        if (current is None or previous is None or current == previous
                or current == normalize_extraordinary_rating(profile.get("extraordinary_rating"))):
            return ""
        return token

    def _equipment_refresh_fields(
        self, actor_id: int, user_token: object = "", rating: object = None,
    ) -> dict[str, object]:
        token = self._equipment_profile_refresh_token(
            actor_id, user_token, rating
        )
        if not token:
            return {}
        self_id = int(getattr(self.model, "self_id", 0) or 0)
        if actor_id == self_id or token == self._team_equipment_local_token():
            return {}
        requested_at = float(getattr(self, "team_equipment_requested_at", {}).get(token, 0.0) or 0.0)
        return {
            "equipment_refresh_token": token,
            "equipment_refresh_pending": bool(
                requested_at > 0
                and time.monotonic() - requested_at < TEAM_EQUIPMENT_REQUEST_TIMEOUT_SECONDS
            ),
        }

    def _team_rating_preview_profile_signature(
        self, actor_id: int
    ) -> tuple[object, ...]:
        """Track local profile changes without issuing another game request."""

        model = self.model
        names = getattr(model, "entity_names", {})
        professions = getattr(model, "entity_professions", {})
        ratings = getattr(model, "entity_extraordinary_ratings", {})
        ai_states = getattr(model, "entity_ai_states", {})
        fight_attributes = getattr(model, "entity_fight_attributes", {})
        name = names.get(actor_id) if isinstance(names, dict) else None
        profession_id = (
            professions.get(actor_id) if isinstance(professions, dict) else None
        )
        rating = ratings.get(actor_id) if isinstance(ratings, dict) else None
        ai_state = (
            ai_states.get(actor_id) if isinstance(ai_states, dict) else None
        )
        attributes = (
            fight_attributes.get(actor_id, {})
            if isinstance(fight_attributes, dict)
            else {}
        )
        equipment = self._equipment_summary_for_actor(actor_id)
        return (
            str(name or ""),
            int(profession_id or 0),
            normalize_extraordinary_rating(rating),
            ai_state,
            int(equipment.get("equipment_count", 0) or 0),
            int(equipment.get("pvp_equipment_count", 0) or 0),
            int(equipment.get("active_word_count", 0) or 0),
            int(equipment.get("total_word_count", 0) or 0),
            str(equipment.get("batch_id", "") or ""),
            *(attributes.get(key) for key in (
                "physical_critical",
                "magical_critical",
                "physical_penetration",
                "magical_penetration",
            )),
        )

    def _team_rating_preview_profile(
        self, actor_id: int
    ) -> dict[str, object]:
        profile_cache = getattr(
            self, "team_rating_preview_profile_cache", None
        )
        if not isinstance(profile_cache, dict):
            self.team_rating_preview_profile_cache = {}
            profile_cache = self.team_rating_preview_profile_cache
        cached = profile_cache.get(actor_id)
        if cached is not None:
            return cached
        model = self.model
        display_name = str(model.display_name(actor_id) or "").strip()
        fight_attributes = getattr(model, "entity_fight_attributes", {})
        attributes = (
            fight_attributes.get(actor_id, {})
            if isinstance(fight_attributes, dict)
            else {}
        )
        profile = {
            "actor_id": actor_id,
            "profession_id": int(model.actor_profession_id(actor_id) or 0),
            "extraordinary_rating": self._main_extraordinary_rating(actor_id),
            "display_name": display_name,
            "is_ai": self._main_actor_is_ai(actor_id),
            "fight_attributes": dict(attributes),
        }
        equipment = self._equipment_summary_for_actor(actor_id)
        if equipment:
            profile.update(
                {
                    "equipment_profile_ready": True,
                    "equipment_count": int(
                        equipment.get("equipment_count", 0) or 0
                    ),
                    "pvp_equipment_count": int(
                        equipment.get("pvp_equipment_count", 0) or 0
                    ),
                    "active_word_count": int(
                        equipment.get("active_word_count", 0) or 0
                    ),
                    "total_word_count": int(
                        equipment.get("total_word_count", 0) or 0
                    ),
                }
            )
        profile_cache[actor_id] = profile
        return profile

    def _team_rating_preview_rows(self) -> list[dict[str, object]]:
        model = getattr(self, "model", None)
        current_members = getattr(model, "_current_member_ids", None)
        if not callable(current_members):
            rows: list[dict[str, object]] = []
            self.team_rating_preview_rows_cache = rows
            self.team_rating_preview_rows_dirty = False
            self.team_rating_preview_roster_signature = None
            return rows
        try:
            members = self._main_visible_roster_members()
        except (AttributeError, TypeError, ValueError):
            rows = []
            self.team_rating_preview_rows_cache = rows
            self.team_rating_preview_rows_dirty = False
            self.team_rating_preview_roster_signature = None
            return rows
        members.difference_update(
            getattr(model, "non_player_actor_ids", set())
        )
        ordered = [
            actor_id
            for actor_id in getattr(model, "friend_order", [])
            if actor_id in members
        ]
        self_id = getattr(model, "self_id", None)
        if self_id in members and self_id not in ordered:
            ordered.insert(0, self_id)
        elif self_id in ordered:
            ordered.remove(self_id)
            ordered.insert(0, self_id)
        ordered.extend(
            sorted(actor_id for actor_id in members if actor_id not in ordered)
        )
        try:
            expected = int(getattr(model, "party_member_count", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            expected = 0
        roster_signature = (expected, *ordered)
        previous_roster_signature = getattr(
            self, "team_rating_preview_roster_signature", None
        )
        if roster_signature != previous_roster_signature:
            self.team_rating_preview_rows_dirty = True
            self.team_rating_preview_roster_signature = roster_signature

        profile_cache = getattr(self, "team_rating_preview_profile_cache", None)
        if not isinstance(profile_cache, dict):
            self.team_rating_preview_profile_cache = {}
            profile_cache = self.team_rating_preview_profile_cache
        profile_signatures = getattr(
            self, "team_rating_preview_profile_signatures", None
        )
        if not isinstance(profile_signatures, dict):
            self.team_rating_preview_profile_signatures = {}
            profile_signatures = self.team_rating_preview_profile_signatures
        current_ids = set(ordered)
        for stale_actor_id in set(profile_cache) - current_ids:
            profile_cache.pop(stale_actor_id, None)
        for stale_actor_id in set(profile_signatures) - current_ids:
            profile_signatures.pop(stale_actor_id, None)
        for actor_id in ordered:
            parsed_actor_id = int(actor_id)
            signature = self._team_rating_preview_profile_signature(parsed_actor_id)
            if profile_signatures.get(parsed_actor_id) != signature:
                profile_cache.pop(parsed_actor_id, None)
                profile_signatures[parsed_actor_id] = signature
                self.team_rating_preview_rows_dirty = True

        if not bool(getattr(self, "team_rating_preview_rows_dirty", True)):
            return getattr(self, "team_rating_preview_rows_cache", [])
        rows = []
        for index, actor_id in enumerate(ordered):
            parsed_actor_id = int(actor_id)
            profile = dict(self._team_rating_preview_profile(parsed_actor_id))
            profile["anonymous_name"] = f"玩家{index + 1}"
            rows.append(profile)
        self.team_rating_preview_rows_cache = rows
        self.team_rating_preview_rows_dirty = False
        return rows

    def _main_visible_roster_members(self) -> set[int]:
        """Omit synthetic slots, never a member in the current party roster."""
        model = self.model
        reader = getattr(model, '_current_member_ids', None)
        members = set(reader()) if callable(reader) else set()
        official_party_ids = set(getattr(model, 'party_ids', ()) or ())
        self_id = getattr(model, 'self_id', None)
        if self_id:
            members.add(self_id)
        names = getattr(model, 'entity_names', {})
        professions = getattr(model, 'entity_professions', {})
        ai_states = getattr(model, 'entity_ai_states', {})
        actor_tokens = getattr(model, 'actor_character_ids', {})
        roster_tokens = getattr(model, 'party_user_tokens', set())
        result = set()
        for actor_id in members:
            if actor_id in getattr(model, 'non_player_actor_ids', set()):
                continue
            # Full roster packets can precede member profile and scene-actor
            # binding. Their stable token actors are negative during that
            # short window, but membership is already authoritative.
            if actor_id in official_party_ids:
                result.add(actor_id)
                continue
            name = str(names.get(actor_id, '') or '').strip()
            if (
                actor_id < 0
                and ai_states.get(actor_id) is True
                and not professions.get(actor_id)
                and (not name or re.fullmatch(r'玩家\s*\d+', name))
            ):
                continue
            if (actor_id == self_id or actor_id > 0
                    or actor_tokens.get(actor_id) in roster_tokens):
                result.add(actor_id)
                continue
            # A negative token ID with a genuine profile is still a member.
            # Only empty, unbound counter slots are excluded from the HUD.
            if ((name and re.fullmatch(r'玩家\s*\d+', name) is None)
                    or professions.get(actor_id)
                    or ai_states.get(actor_id) is True):
                result.add(actor_id)
        return result

    @staticmethod
    def _main_boundary_timestamp_ns(payload: object) -> int:
        """Convert a passive packet boundary into the Encounter clock domain."""

        if not isinstance(payload, dict):
            return 0
        try:
            direct = int(payload.get("capture_timestamp_ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            direct = 0
        if direct > 0:
            return direct
        try:
            filetime = int(
                payload.get(
                    "dungeon_context_filetime",
                    payload.get("filetime_100ns", 0),
                )
                or 0
            )
        except (TypeError, ValueError, OverflowError):
            return 0
        windows_epoch = 116_444_736_000_000_000
        return (filetime - windows_epoch) * 100 if filetime > windows_epoch else 0

    def _main_context_display_is_stale(self) -> bool:
        """Hide the old model accumulator until the next Encounter is created."""

        hidden_id = str(
            getattr(self, "main_hidden_combat_encounter_id", "") or ""
        )
        if not hidden_id:
            return False
        current_id = str(getattr(self.model, "encounter_id", "") or "")
        if current_id != hidden_id:
            self.main_hidden_combat_encounter_id = ""
            return False
        return True

    def _reset_main_visible_context(
        self,
        *,
        boundary_ns: int = 0,
        hide_current_encounter: bool = False,
    ) -> None:
        """Start a new HUD scope without deleting durable battle history."""

        try:
            parsed_boundary = max(0, int(boundary_ns or 0))
        except (TypeError, ValueError, OverflowError):
            parsed_boundary = 0
        if parsed_boundary:
            self.main_recent_battle_scope_started_ns = max(
                parsed_boundary,
                int(
                    getattr(
                        self, "main_recent_battle_scope_started_ns", 0
                    )
                    or 0
                ),
            )

        current_id = str(getattr(self.model, "encounter_id", "") or "")
        previous = getattr(self, "main_last_battle_result", None) or {}
        discarded = deque(
            getattr(self, "main_cleared_encounter_ids", ()), maxlen=64
        )
        for encounter_id in (
            current_id if hide_current_encounter else "",
            str(previous.get("encounter_id") or ""),
        ):
            if encounter_id and encounter_id not in discarded:
                discarded.append(encounter_id)
        self.main_cleared_encounter_ids = discarded
        self.main_hidden_combat_encounter_id = (
            current_id if hide_current_encounter and current_id else ""
        )
        self.main_manual_clear_state = None
        self.main_last_battle_result = None
        self.main_last_live_display_snapshot = None
        self.main_scroll_offset = 0
        self.main_time_text = "00:00"
        self.team_dps_text = "0"
        self.latest_healing_summary = {
            "team_hps": 0.0,
            "team_effective_healing": 0,
            "healers": [],
        }
        self.enrage_prediction = None
        self.enrage_prediction_visible = False
        hide_tooltip = getattr(self, "_hide_enrage_tooltip", None)
        if callable(hide_tooltip):
            hide_tooltip()

    def _main_display_is_cleared(self) -> bool:
        if self._main_context_display_is_stale():
            return True
        cleared = getattr(self, 'main_manual_clear_state', None)
        if cleared is None:
            return False
        if self._main_clear_blocked():
            self.main_manual_clear_state = None
            current = str(getattr(self.model, 'encounter_id', ''))
            self.main_cleared_encounter_ids = deque(
                (value for value in getattr(self, 'main_cleared_encounter_ids', ()) if value != current), maxlen=64)
            return False
        encounter_id, was_started = cleared
        started = getattr(self.model, '_encounter_started', lambda: False)()
        return encounter_id == str(getattr(self.model, 'encounter_id', '')) and (was_started or not started)

    def _main_clear_blocked(self) -> bool:
        if self._startup_interaction_blocked():
            return True
        reader = getattr(self.model, 'combat_in_progress', None)
        if callable(reader) and reader():
            return True
        if getattr(self.model, 'combat_end_time', 0):
            return False
        states = getattr(self.model, 'entity_combat_states', {})
        members = self._main_visible_roster_members()
        target_id = getattr(self.model, 'combat_target_id', None)
        dummy_reader = getattr(self.model, "_is_dummy_target", None)
        target_is_dummy = bool(
            target_id is not None
            and callable(dummy_reader)
            and dummy_reader(target_id)
        )
        if not target_is_dummy:
            members.add(target_id)
        return isinstance(states, dict) and any(states.get(actor) is True for actor in members)

    def _clear_main_display(self) -> None:
        """Clear only outside battle; never hide the next pull's live values."""
        if self._main_clear_blocked():
            return
        encounter_id = str(getattr(self.model, 'encounter_id', ''))
        started = bool(getattr(self.model, '_encounter_started', lambda: False)())
        self.main_manual_clear_state = (encounter_id, started)
        discarded = deque(getattr(self, 'main_cleared_encounter_ids', ()), maxlen=64)
        old = (getattr(self, 'main_last_battle_result', None) or {}).get('encounter_id')
        for value in (encounter_id if started else None, old):
            if value and value not in discarded:
                discarded.append(value)
        self.main_cleared_encounter_ids = discarded
        self.main_last_battle_result = None
        self.main_last_live_display_snapshot = None
        self.main_scroll_offset = 0
        self._hide_enrage_tooltip()
        self._render_layered_main_hud()

    def _main_has_battle_values(self) -> bool:
        if self._main_display_is_cleared():
            return False
        reader = getattr(self.model, '_encounter_started', None)
        if callable(reader):
            return bool(reader())
        return bool(getattr(self.model, 'first_damage_time', 0)
                    or getattr(self.model, 'first_healing_time', 0)
                    or getattr(self.model, 'combat_end_time', 0))

    def _main_battle_signal_active(self) -> bool:
        """Use accepted fight-mode signals for UI priority, not DPS arming."""
        if self._main_display_is_cleared():
            return False
        dummy_reader = getattr(self.model, "_is_dummy_encounter", None)
        if callable(dummy_reader) and dummy_reader():
            # Other players can put the shared dummy itself in FightMode. It
            # is not evidence that this character started a pull; local
            # positive damage is represented by _main_has_battle_values().
            return False
        states = getattr(self.model, 'entity_combat_states', {})
        if not isinstance(states, dict):
            return False
        self_id = getattr(self.model, 'self_id', None)
        target_id = getattr(self.model, 'combat_target_id', None)
        participants = self._main_visible_roster_members()
        participants.update(value for value in (self_id, target_id) if value is not None)
        return any(states.get(actor_id) is True for actor_id in participants)

    def _remember_main_battle_result(self, record: dict) -> None:
        """Retain only display fields; capture/reset/history are unchanged."""
        if getattr(self, 'authorization_resetting', False) or getattr(self, 'closing', False):
            return
        current_character_id = str(getattr(self, 'current_character_id', '') or '')
        record_character_id = str(record.get('self_character_id') or '')
        if current_character_id and record_character_id and current_character_id != record_character_id:
            return
        if str(record.get('encounter_id', '')) in getattr(self, 'main_cleared_encounter_ids', ()):
            return
        participant_keys = ('actor_id', 'name', 'is_self', 'profession_id',
                            'is_ai', 'extraordinary_rating', 'damage', 'dps',
                            'taken', 'deaths')
        participants = [
            {key: row.get(key) for key in participant_keys}
            for row in (record.get('participants') or ())
            if isinstance(row, dict) and row.get('actor_id')
        ]
        known_ids = {int(row['actor_id']) for row in participants}
        for healer in record.get('healers') or ():
            if isinstance(healer, dict) and healer.get('actor_id') and int(healer['actor_id']) not in known_ids:
                participants.append({key: healer.get(key) for key in participant_keys})
                known_ids.add(int(healer['actor_id']))
        if not participants:
            return
        previous = getattr(self, 'main_last_battle_result', None) or {}
        ended = float(record.get('ended_at_epoch', 0) or 0)
        if ended < float(previous.get('ended_at_epoch', 0) or 0):
            return
        self.main_last_battle_result = {
            'encounter_id': record.get('encounter_id'),
            'ended_at_epoch': ended,
            'duration_seconds': record.get('duration_seconds', 0),
            'dps_duration_seconds': record.get('dps_duration_seconds', 0),
            'team_dps': record.get('team_dps', 0),
            'participants': participants,
            'monster': dict(record.get('monster') or {}),
            'healers': [{key: row.get(key) for key in ('actor_id', 'hps', 'effective_healing')}
                        for row in (record.get('healers') or ()) if isinstance(row, dict)],
        }
        # Preserve the last rendered dual target only for that same encounter.
        last = getattr(self, 'main_last_live_display_snapshot', None)
        if last and last.get('encounter_id') == record.get('encounter_id'):
            last_bosses = list(last.get('bosses', []) or [])
            # The cached list exists to retain a genuine dual-Boss layout.  A
            # single cached row is merely the previous rendered frame and must
            # not override a later archived HP=0/death-tail correction.
            if len(last_bosses) > 1:
                self.main_last_battle_result['bosses'] = last_bosses

    def _main_retained_battle_active(self) -> bool:
        return bool(getattr(self, 'main_last_battle_result', None)
                    and not self._main_has_battle_values()
                    and not self._main_battle_signal_active())

    def _main_player_display_metric(self, profession_id: object, dps: object) -> str:
        selected = self._profession_display_metric(profession_id)
        try:
            profession = int(profession_id or 0)
            rate = float(dps)
        except (TypeError, ValueError, OverflowError):
            return selected
        if profession == AUDIENCE_PROFESSION_ID and math.isfinite(rate) and rate > 5000:
            return 'dps'
        return selected

    def _main_retained_battle_rows(self) -> list[dict]:
        record = self.main_last_battle_result
        healers = {int(row.get('actor_id', 0) or 0): row for row in record['healers']}
        divisor = float(record.get('dps_duration_seconds') or dps_duration_seconds(record['duration_seconds']))
        rows = []
        for index, raw in enumerate(sorted(record['participants'], key=lambda r: -int(r.get('damage') or 0))):
            actor_id = int(raw['actor_id'])
            metric = self._main_player_display_metric(raw.get('profession_id'), raw.get('dps'))
            if metric == 'hps':
                healing = healers.get(actor_id, {})
                total, rate = healing.get('effective_healing'), healing.get('hps')
            elif metric == 'dt':
                total = raw.get('taken')
                rate = float(total) / divisor if total is not None and divisor else None
            else:
                total, rate = raw.get('damage'), raw.get('dps')
            rows.append(dict(raw, name=f'玩家{index + 1}' if getattr(self, 'hide_names', False) else raw.get('name', ''),
                             metric=metric, total_value=total, stat_value=rate))
        return rows

    def _team_rating_preview_active(self) -> bool:
        if not TEAM_RATING_PREVIEW_AVAILABLE or not bool(
            getattr(self, "team_rating_preview_enabled", False)
        ):
            return False
        if self._main_display_is_cleared():
            return True
        # New display priority: live battle > retained result > pre-pull
        # rating preview. Ending the fight no longer exposes equipment scores.
        if self._main_battle_signal_active() or self._main_has_battle_values() or getattr(self, 'main_last_battle_result', None):
            return False
        model = getattr(self, "model", None)
        combat_in_progress = getattr(model, "combat_in_progress", None)
        if not callable(combat_in_progress):
            combat_in_progress = getattr(model, "active", None)
        if not callable(combat_in_progress):
            combat_in_progress = getattr(model, "_encounter_started", None)
        if callable(combat_in_progress):
            try:
                if combat_in_progress():
                    return False
            except (AttributeError, TypeError, ValueError):
                return False
        try:
            expected = int(getattr(model, "party_member_count", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            expected = 0
        rows = self._team_rating_preview_rows()
        return (
            bool(getattr(model, "party_active", False))
            or expected > 1
            or len(rows) > 1
        )

    def _sync_team_rating_preview_layout(self, active: bool) -> None:
        active = bool(active)
        changed = active != bool(
            getattr(self, "team_rating_preview_layout_active", False)
        )
        self.team_rating_preview_layout_active = active
        if changed:
            self._draw_main_header()

    def _main_display_columns(
        self, width: int, *, rating_preview: bool = False
    ) -> dict[str, int]:
        """Return stable right-aligned columns for the schema v1 player row."""

        right = max(self._main_px(176), int(width) - self._main_px(3))
        columns: dict[str, int] = {
            "icon": self._main_px(2),
            "name": self._main_px(40),
        }
        if bool(getattr(self, "show_deaths", True)):
            # Mirror the layered artwork adjustment: move the death value
            # slightly left while letting the DPS/total pair move right.
            columns["deaths"] = right - self._main_px(4)
            # Keep the death value close to the total without letting their
            # outlines touch.  The former reserve left a conspicuous empty
            # column between the two values.
            right -= self._main_px(20)
        if bool(getattr(self, "show_main_totals", True)) and not rating_preview:
            columns["total"] = right
            right -= self._main_px(74)
        columns["stat"] = right
        stat_reserve = 116 if rating_preview else 96
        columns["name_right"] = max(
            columns["name"] + self._main_px(42),
            right - self._main_px(stat_reserve),
        )
        return columns

    def _main_combat_display_rows(
        self, now: float | None = None
    ) -> list[dict[str, object]]:
        """Join existing DPS/HPS/DT sources without changing their values."""

        now = time.time() if now is None else float(now)
        current_stats = getattr(self.model, "current_stats", None)
        raw_damage_rows = list(current_stats()) if callable(current_stats) else []
        damage_by_actor = {
            int(row.actor_id): row
            for row in raw_damage_rows
            if int(row.actor_id or 0) != 0
        }
        healing_summary = getattr(self, "latest_healing_summary", {})
        raw_healers = (
            healing_summary.get("healers", [])
            if isinstance(healing_summary, dict)
            else []
        )
        healing_by_actor = {
            int(row.get("actor_id", 0) or 0): row
            for row in raw_healers
            if isinstance(row, dict) and int(row.get("actor_id", 0) or 0) != 0
        }
        current_taken_rows = getattr(self.model, "current_taken_rows", None)
        raw_taken_rows = (
            list(current_taken_rows()) if callable(current_taken_rows) else []
        )
        taken_by_actor = {
            int(row.get("actor_id", 0) or 0): row
            for row in raw_taken_rows
            if isinstance(row, dict) and int(row.get("actor_id", 0) or 0) != 0
        }

        actor_ids: set[int] = (
            set(damage_by_actor) | set(healing_by_actor)
            | {actor_id for actor_id, row in taken_by_actor.items() if row.get('taken') is not None}
            | set(getattr(self.model, 'encounter_member_ids', ()))
        )
        current_members = getattr(self.model, "_current_member_ids", None)
        if callable(current_members):
            try:
                if not getattr(self.model, 'combat_end_time', 0):
                    actor_ids.update(self._main_visible_roster_members())
            except (AttributeError, TypeError, ValueError):
                pass
        actor_ids.difference_update(
            getattr(self.model, "non_player_actor_ids", set())
        )
        actor_ids.discard(0)
        self_id = getattr(self.model, 'self_id', None)
        if self_id and self_id not in getattr(self.model, 'non_player_actor_ids', ()):
            # Preserve the identified local member before their first hit or
            # heal and through temporary roster refreshes.
            actor_ids.add(self_id)

        friend_order = [
            int(actor_id)
            for actor_id in getattr(self.model, "friend_order", [])
            if int(actor_id or 0) != 0
        ]
        friend_index = {
            actor_id: index for index, actor_id in enumerate(friend_order)
        }
        actor_ids_sorted = sorted(
            actor_ids,
            key=lambda actor_id: (
                -int(
                    getattr(damage_by_actor.get(actor_id), "damage", 0) or 0
                ),
                friend_index.get(actor_id, len(friend_index)),
                actor_id,
            ),
        )
        duration_reader = getattr(self.model, "duration", None)
        if callable(duration_reader):
            try:
                raw_duration = duration_reader(now)
            except TypeError:
                raw_duration = duration_reader()
        else:
            raw_duration = 0.0
        duration = dps_duration_seconds(raw_duration)
        deaths = getattr(self.model, "member_death_counts", {})
        profession_reader = getattr(self.model, "actor_profession_id", None)
        team_damage_states = getattr(self.model, "team_damage_states", {})
        rows: list[dict[str, object]] = []
        for actor_id in actor_ids_sorted:
            damage_row = damage_by_actor.get(actor_id)
            healer_row = healing_by_actor.get(actor_id)
            taken_row = taken_by_actor.get(actor_id)
            profession_id = int(
                (
                    profession_reader(actor_id)
                    if callable(profession_reader)
                    else 0
                )
                or 0
            )
            if not profession_id and healer_row is not None:
                profession_id = int(healer_row.get("profession_id", 0) or 0)
            damage_state = (
                team_damage_states.get(actor_id)
                if isinstance(team_damage_states, dict)
                else None
            )
            cached_live_dps = (
                getattr(damage_state, "live_dps", None)
                if bool(
                    getattr(damage_state, "authoritative_snapshot", False)
                )
                else None
            )
            player_dps = (
                float(cached_live_dps)
                if cached_live_dps is not None
                else float(damage_row.damage) / duration
                if damage_row is not None and duration
                else None
            )
            metric = self._main_player_display_metric(profession_id, player_dps)
            stat_value: float | int | None
            total_value: float | int | None
            if metric == "hps":
                stat_value = (
                    healer_row.get("hps") if healer_row is not None else None
                )
                total_value = (
                    healer_row.get("effective_healing")
                    if healer_row is not None
                    else None
                )
            elif metric == "dt":
                total_value = (
                    taken_row.get("taken") if taken_row is not None else None
                )
                stat_value = (
                    float(total_value) / duration
                    if total_value is not None and duration
                    else None
                )
            else:
                total_value = (
                    int(damage_row.damage) if damage_row is not None else None
                )
                stat_value = player_dps
            rows.append(
                {
                    "actor_id": actor_id,
                    "profession_id": profession_id,
                    "name": self._shown_actor_name(actor_id),
                    "metric": metric,
                    "stat_value": stat_value,
                    "total_value": total_value,
                    "dps_value": player_dps,
                    "damage_sort": int(
                        getattr(damage_row, "damage", 0) or 0
                    ),
                    "deaths": int(deaths.get(actor_id, 0) or 0),
                    "rating": None,
                    "rating_text": "",
                    "inline_rating_text": "",
                    "is_ai": self._main_actor_is_ai(actor_id),
                    "is_self": actor_id == getattr(self.model, "self_id", None),
                }
            )
        return rows

    def _main_targetless_team_data(
        self, now: float | None = None
    ) -> tuple[list[ActorStats], float] | None:
        model = self.model
        stats_reader = getattr(model, "targetless_team_statistics", None)
        duration_reader = getattr(model, "targetless_team_duration", None)
        if not callable(stats_reader) or not callable(duration_reader):
            return None
        now = time.time() if now is None else float(now)
        try:
            stats = list(stats_reader(now))
            duration = float(duration_reader(now))
        except (AttributeError, TypeError, ValueError, OverflowError):
            return None
        if len(stats) < 2 or duration <= 0:
            return None
        return stats, duration

    def _main_live_hud_dps_segment_state(
        self, now: float | None = None
    ) -> dict[str, object] | None:
        """Return the visible live-only DPS segment without touching the model."""

        state = getattr(self, "live_hud_dps_segment", None)
        if not isinstance(state, dict):
            return None
        try:
            started_at = float(state.get("started_at_epoch", 0.0) or 0.0)
            ended_at = float(state.get("ended_at_epoch", 0.0) or 0.0)
        except (TypeError, ValueError, OverflowError):
            return None
        if not math.isfinite(started_at) or started_at <= 0:
            return None
        if state.get("active"):
            return state
        now = time.time() if now is None else float(now)
        if state.get("kind") == "small_monsters" and (
            math.isfinite(ended_at) and ended_at >= started_at
        ):
            return state
        if (
            math.isfinite(ended_at)
            and ended_at >= started_at
            and now - ended_at <= TARGETLESS_TEAM_SNAPSHOT_STALE_SECONDS
        ):
            return state
        return None

    def _main_live_hud_projection_active(self, now: float | None = None) -> bool:
        """Return whether the packet-only DPS projection is still in combat."""

        combat_state = getattr(self, "live_hud_combat_state", None)
        if isinstance(combat_state, dict) and combat_state.get("active"):
            return True
        boss_state = getattr(self, "live_hud_boss_state", None)
        if isinstance(boss_state, dict) and boss_state.get("active"):
            return True
        segment = self._main_live_hud_dps_segment_state(now)
        if isinstance(segment, dict):
            return bool(segment.get("active"))
        # A full team snapshot is sufficient live evidence when capture began
        # after the NPC FightMode edge.  An explicitly ended segment above
        # still wins, so its final rows do not look like a new pull.
        return self._main_targetless_team_data(now) is not None

    def _main_live_hud_dps_duration(self, now: float | None = None) -> float | None:
        state = self._main_live_hud_dps_segment_state(now)
        if state is None:
            return None
        now = time.time() if now is None else float(now)
        if state.get("kind") == "small_monsters":
            if state.get("official_team_clock"):
                snapshot_epoch = (
                    int(state.get("last_snapshot_time_100ns", 0) or 0)
                    - 116_444_736_000_000_000
                ) / 10_000_000
                endpoint = max(
                    snapshot_epoch,
                    now if state.get("active")
                    else float(state.get("ended_at_epoch", 0.0) or 0.0),
                )
                return max(
                    (
                        self.model._live_dps_duration_for_snapshot(
                            event_time=endpoint,
                            server_time=counter["server_time"],
                            combat_seconds_total=counter["combat_seconds_total"],
                            fallback_duration=counter["duration"],
                        )
                        for counter in state.get("counter_states", {}).values()
                    ),
                    default=float(state.get("snapshot_duration", 0.0) or 0.0),
                )
            try:
                elapsed = max(
                    0.0, float(state.get("elapsed_seconds", 0.0) or 0.0)
                )
                active_started_at = float(
                    state.get("active_started_at_epoch", 0.0) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                return None
            if state.get("active") and active_started_at > 0:
                elapsed += max(0.0, now - active_started_at)
            try:
                server_duration = max(
                    0.0,
                    float(
                        getattr(
                            self.model,
                            "targetless_team_server_duration_seconds",
                            0.0,
                        )
                        or 0.0
                    ),
                )
            except (TypeError, ValueError, OverflowError):
                server_duration = 0.0
            return max(elapsed, server_duration)
        started_at = float(state["started_at_epoch"])
        ended_at = float(state.get("ended_at_epoch", 0.0) or 0.0)
        endpoint = now if state.get("active") or ended_at <= 0 else ended_at
        return max(0.0, endpoint - started_at)

    def _begin_live_hud_dps_segment(
        self,
        *,
        kind: str,
        segment_key: object,
        started_at_epoch: object,
        active_at_epoch: object = 0.0,
    ) -> bool:
        """Reset only the HUD projection at a confirmed live combat boundary."""

        try:
            signal_started_at = float(started_at_epoch or 0.0)
            active_at = float(active_at_epoch or signal_started_at)
        except (TypeError, ValueError, OverflowError):
            return False
        if not math.isfinite(signal_started_at) or signal_started_at <= 0:
            return False
        if not math.isfinite(active_at) or active_at <= 0:
            active_at = signal_started_at
        key = (str(kind), str(segment_key), signal_started_at)
        current = getattr(self, "live_hud_dps_segment", None)
        if isinstance(current, dict) and current.get("key") == key:
            if str(kind) != "small_monsters" or current.get("active"):
                return False
            current["active"] = True
            current["active_started_at_epoch"] = max(
                float(current.get("ended_at_epoch", 0.0) or 0.0),
                active_at,
            )
            current["ended_at_epoch"] = 0.0
            # Common counters can pause between small-monster waves. Keep the
            # last complete team rows visible until the next snapshot replaces
            # them; confirmed round/scene/Boss boundaries clear their own data.
            return True

        model = getattr(self, "model", None)
        started_at = signal_started_at
        anchored_to_team_snapshot = False
        if str(kind) == "small_monsters":
            try:
                team_started_at = float(
                    getattr(model, "targetless_team_started_at", 0.0) or 0.0
                )
                team_snapshot_at = float(
                    getattr(model, "targetless_team_last_snapshot_at", 0.0)
                    or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                team_started_at = 0.0
                team_snapshot_at = 0.0
            if (
                0 < team_started_at <= signal_started_at
                and team_snapshot_at >= team_started_at
                and signal_started_at - team_snapshot_at
                <= TARGETLESS_TEAM_SNAPSHOT_STALE_SECONDS
            ):
                started_at = team_started_at
                anchored_to_team_snapshot = True
        states = getattr(model, "targetless_team_states", {})
        baselines: dict[str, tuple[int, int]] = {}
        raw_baselines: dict[str, tuple[int, int]] = {}
        if isinstance(states, dict):
            for actor_id, state in states.items():
                token = str(getattr(state, "user_token", "") or "").strip()
                state_key = token or f"actor:{int(actor_id or 0)}"
                try:
                    total_damage = max(
                        0, int(getattr(state, "total_damage", 0) or 0)
                    )
                    server_time = max(
                        0, int(getattr(state, "server_time", 0) or 0)
                    )
                    last_absolute = max(
                        0,
                        int(
                            getattr(state, "last_absolute", total_damage) or 0
                        ),
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
                baselines[state_key] = (
                    (0, 0)
                    if anchored_to_team_snapshot
                    else (total_damage, server_time)
                )
                raw_baseline = (
                    (0, 0)
                    if anchored_to_team_snapshot
                    else (last_absolute, server_time)
                )
                raw_baselines[state_key] = raw_baseline
                raw_baselines[f"actor:{int(actor_id or 0)}"] = raw_baseline
        try:
            boundary_snapshot = int(
                getattr(model, "targetless_team_last_committed_time_100ns", 0)
                or 0
            )
        except (TypeError, ValueError, OverflowError):
            boundary_snapshot = 0
        self.live_hud_dps_segment = {
            "key": key,
            "kind": str(kind),
            "active": True,
            "started_at_epoch": started_at,
            "active_started_at_epoch": started_at,
            "elapsed_seconds": 0.0,
            "ended_at_epoch": 0.0,
            "boundary_snapshot_time_100ns": boundary_snapshot,
            "last_snapshot_time_100ns": boundary_snapshot,
            "baseline_states": baselines,
            "raw_baseline_states": raw_baselines,
            "pending_snapshot_time_100ns": 0,
            "pending_snapshot_tokens": set(),
            "pending_snapshot_rows": {},
            "counter_states": {},
            "team_snapshot_projection_started": False,
            "rows": [],
            "snapshot_duration": 0.0,
        }
        self.main_scroll_offset = 0
        return True

    def _ingest_live_hud_team_stat(self, payload: object) -> bool:
        """Keep official Common counters and their own clocks together."""

        segment = self._main_live_hud_dps_segment_state()
        if (
            not isinstance(segment, dict)
            or segment.get("kind") not in {"boss", "small_monsters"}
            or not isinstance(payload, dict)
            or not payload.get("full_snapshot")
        ):
            return False
        try:
            timestamp = int(payload.get("filetime_100ns", 0) or 0)
            actor_id = int(payload.get("actor_id", 0) or 0)
            absolute_damage = max(
                0, int(payload.get("absolute_damage", 0) or 0)
            )
            server_time = max(0, int(payload.get("server_time", 0) or 0))
            combat_seconds_total = max(
                0, int(payload.get("combat_seconds_total", 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            return False
        token = str(payload.get("user_token", "") or "").strip()[:128]
        raw_tokens = payload.get("snapshot_tokens")
        if not isinstance(raw_tokens, (list, tuple, set)):
            raw_tokens = payload.get("team_tokens")
        if not timestamp or not actor_id or not token or not isinstance(
            raw_tokens, (list, tuple, set)
        ):
            return False
        snapshot_tokens = {
            str(value or "").strip()[:128]
            for value in raw_tokens
            if str(value or "").strip()
        }
        if len(snapshot_tokens) < 2 or token not in snapshot_tokens:
            return False

        if timestamp != int(
            segment.get("pending_snapshot_time_100ns", 0) or 0
        ):
            segment["pending_snapshot_time_100ns"] = timestamp
            segment["pending_snapshot_tokens"] = snapshot_tokens
            segment["pending_snapshot_rows"] = {}
        elif snapshot_tokens != set(
            segment.get("pending_snapshot_tokens", set()) or set()
        ):
            segment["pending_snapshot_tokens"] = snapshot_tokens
            pending = segment.get("pending_snapshot_rows", {})
            segment["pending_snapshot_rows"] = {
                key: value
                for key, value in pending.items()
                if key in snapshot_tokens
            } if isinstance(pending, dict) else {}

        pending_rows = segment.get("pending_snapshot_rows", {})
        if not isinstance(pending_rows, dict):
            pending_rows = {}
            segment["pending_snapshot_rows"] = pending_rows
        pending_rows[token] = (
            actor_id,
            absolute_damage,
            server_time,
            bool(payload.get("omitted_zero")),
            combat_seconds_total,
        )
        if not snapshot_tokens.issubset(pending_rows):
            return False

        snapshot_epoch = (
            timestamp - 116_444_736_000_000_000
        ) / 10_000_000
        started_at = float(segment.get("started_at_epoch", 0.0) or 0.0)
        if snapshot_epoch < started_at:
            return False
        duration = max(1.0, dps_duration_seconds(snapshot_epoch - started_at))
        duration_reader = getattr(
            self.model, "_live_dps_duration_for_snapshot", None
        )
        clock_offset = getattr(self.model, "server_clock_offset_seconds", None)
        official_durations: dict[str, float] = {}
        if callable(duration_reader):
            for member_token in snapshot_tokens:
                _actor, _damage, member_start, _omitted, member_seconds = (
                    pending_rows[member_token]
                )
                if member_start and clock_offset is None:
                    continue
                member_duration = duration_reader(
                    event_time=snapshot_epoch,
                    server_time=member_start,
                    combat_seconds_total=member_seconds,
                    fallback_duration=0.0,
                )
                if member_duration > 0:
                    official_durations[member_token] = member_duration
        official_clock = bool(
            official_durations
            and all(
                token in official_durations or pending_rows[token][1] == 0
                for token in snapshot_tokens
            )
        )
        if not official_clock and segment.get("official_team_clock"):
            # Once rows use the server clock, never replace them with a weaker
            # fallback snapshot.  A small-monster segment that has no server
            # clock yet can still use its packet-confirmed FightMode start;
            # otherwise valid Common counters disappear from the live HUD.
            return False
        if official_clock:
            duration = max(official_durations.values())
        raw_baselines = segment.get("raw_baseline_states", {})
        if not isinstance(raw_baselines, dict):
            raw_baselines = {}
        counter_states = segment.get("counter_states", {})
        if not isinstance(counter_states, dict):
            counter_states = {}

        projected: list[tuple[int, int, float]] = []
        next_counter_states: dict[str, dict[str, int | float]] = {}
        for member_token in snapshot_tokens:
            member_actor, raw_damage, member_server_time, omitted_zero, member_seconds = (
                pending_rows[member_token]
            )
            previous = counter_states.get(member_token)
            baseline = raw_baselines.get(
                member_token,
                raw_baselines.get(f"actor:{int(member_actor or 0)}"),
            )
            baseline_damage, baseline_server_time = (
                baseline if isinstance(baseline, tuple) and len(baseline) == 2
                else (0, 0)
            )
            if omitted_zero:
                previous_absolute = (
                    int(previous.get("last_absolute", 0) or 0)
                    if isinstance(previous, dict)
                    else int(baseline_damage or 0)
                )
                previous_server_time = (
                    int(previous.get("server_time", 0) or 0)
                    if isinstance(previous, dict)
                    else int(baseline_server_time or 0)
                )
                if previous_absolute > 0 and (
                    not member_server_time
                    or member_server_time == previous_server_time
                ):
                    raw_damage = previous_absolute
            member_duration = official_durations.get(member_token, duration)
            if official_clock:
                # Daily dungeons can keep trash damage when a Boss starts;
                # raids can reset it. The server clock describes that same
                # counter's scope in either case, independently per member.
                damage = raw_damage
            elif isinstance(previous, dict):
                previous_absolute = int(previous.get("last_absolute", 0) or 0)
                damage = max(0, int(previous.get("damage", 0) or 0))
                damage += (
                    raw_damage - previous_absolute
                    if raw_damage >= previous_absolute
                    else raw_damage
                )
            else:
                damage = (
                    raw_damage - int(baseline_damage or 0)
                    if raw_damage >= int(baseline_damage or 0)
                    else raw_damage
                )
            damage = max(0, int(damage))
            next_counter_states[member_token] = {
                "actor_id": int(member_actor),
                "last_absolute": int(raw_damage),
                "server_time": int(member_server_time),
                "damage": damage,
                "combat_seconds_total": int(member_seconds),
                "duration": member_duration,
            }
            projected.append((int(member_actor), damage, damage / member_duration))

        friend_order = [
            int(actor)
            for actor in getattr(self.model, "friend_order", [])
            if int(actor or 0)
        ]
        friend_index = {
            actor: index for index, actor in enumerate(friend_order)
        }
        profession_reader = getattr(self.model, "actor_profession_id", None)
        self_id = int(getattr(self.model, "self_id", 0) or 0)
        rows: list[dict[str, object]] = []
        for member_actor, damage, player_dps in sorted(
            projected,
            key=lambda value: (
                -value[1],
                friend_index.get(value[0], len(friend_index)),
                value[0],
            ),
        ):
            try:
                profession_id = int(
                    profession_reader(member_actor)
                    if callable(profession_reader)
                    else 0
                )
            except (TypeError, ValueError, OverflowError):
                profession_id = 0
            rows.append(
                {
                    "actor_id": member_actor,
                    "profession_id": profession_id,
                    "name": self._shown_actor_name(member_actor),
                    "metric": "dps",
                    "stat_value": player_dps,
                    "total_value": damage,
                    "dps_value": player_dps,
                    "damage_sort": damage,
                    "deaths": 0,
                    "hide_deaths": True,
                    "rating": None,
                    "rating_text": "",
                    "inline_rating_text": "",
                    "is_ai": self._main_actor_is_ai(member_actor),
                    "is_self": member_actor == self_id,
                    "targetless_team_live": True,
                }
            )
        segment["counter_states"] = next_counter_states
        segment["last_snapshot_time_100ns"] = timestamp
        segment["snapshot_duration"] = duration
        segment["team_snapshot_projection_started"] = True
        segment["official_team_clock"] = official_clock
        segment["rows"] = rows
        return True

    def _end_live_hud_dps_segment(self, ended_at_epoch: object) -> None:
        state = getattr(self, "live_hud_dps_segment", None)
        if not isinstance(state, dict) or not state.get("active"):
            return
        try:
            ended_at = float(ended_at_epoch or 0.0)
        except (TypeError, ValueError, OverflowError):
            ended_at = 0.0
        started_at = float(state.get("started_at_epoch", 0.0) or 0.0)
        if state.get("kind") == "small_monsters":
            try:
                active_started_at = float(
                    state.get("active_started_at_epoch", started_at) or started_at
                )
                elapsed = float(state.get("elapsed_seconds", 0.0) or 0.0)
            except (TypeError, ValueError, OverflowError):
                active_started_at = started_at
                elapsed = 0.0
            state["elapsed_seconds"] = max(
                0.0, elapsed + max(0.0, (ended_at or time.time()) - active_started_at)
            )
            state["active_started_at_epoch"] = 0.0
        state["active"] = False
        state["ended_at_epoch"] = max(started_at, ended_at or time.time())

    def _clear_live_hud_dps_segment(self) -> None:
        self.live_hud_combat_state = None
        self.live_hud_dps_segment = None

    def _main_live_hud_boss_state(self) -> dict[str, object] | None:
        """Return the packet projection used only by the live targetless HUD."""

        state = getattr(self, "live_hud_boss_state", None)
        if not isinstance(state, dict) or not state.get("active"):
            return None
        try:
            entity_id = int(state.get("entity_id", 0) or 0)
            template_id = int(state.get("template_id", 0) or 0)
            boss_type = int(state.get("boss_type", 0) or 0)
            started_at = float(state.get("started_at_epoch", 0.0) or 0.0)
        except (TypeError, ValueError, OverflowError):
            return None
        if (
            not entity_id
            or template_id <= 0
            or (
                boss_type != 3
                and template_id not in LIVE_HUD_BOSS_ALIASES
            )
            or not math.isfinite(started_at)
            or started_at <= 0
        ):
            return None
        return state

    def _main_targetless_mode_name(self) -> str:
        catalog = getattr(self, "_map_display_catalog", None)
        if not isinstance(catalog, dict):
            catalog = load_map_display_catalog()
            self._map_display_catalog = catalog
        try:
            scene_id = int(getattr(self.model, "scene_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            scene_id = 0
        try:
            dungeon_id = int(
                getattr(self.model, "current_dungeon_id", 0) or 0
            )
        except (TypeError, ValueError, OverflowError):
            dungeon_id = 0
        by_scene = catalog.get("scene", {})
        by_dungeon = catalog.get("dungeon", {})
        if isinstance(by_scene, dict) and scene_id in by_scene:
            return str(by_scene[scene_id] or "团队战斗")
        if isinstance(by_dungeon, dict) and dungeon_id in by_dungeon:
            return str(by_dungeon[dungeon_id] or "团队战斗")
        return "团队战斗"

    def _main_targetless_team_rows(
        self, now: float | None = None
    ) -> list[dict[str, object]] | None:
        segment = self._main_live_hud_dps_segment_state(now)
        data = self._main_targetless_team_data(now)
        if segment is not None:
            cached_rows = [
                dict(row)
                for row in segment.get("rows", [])
                if isinstance(row, dict)
            ]
            if (
                segment.get("team_snapshot_projection_started")
                and (
                    segment.get("kind") == "boss"
                    or segment.get("official_team_clock")
                )
            ):
                return cached_rows
            server_duration = 0.0
            if segment.get("kind") == "small_monsters":
                try:
                    server_duration = max(
                        0.0,
                        float(
                            getattr(
                                self.model,
                                "targetless_team_server_duration_seconds",
                                0.0,
                            )
                            or 0.0
                        ),
                    )
                except (TypeError, ValueError, OverflowError):
                    server_duration = 0.0
            try:
                cached_duration = float(
                    segment.get("snapshot_duration", 0.0) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                cached_duration = 0.0
            server_duration_advanced = bool(
                server_duration > cached_duration and cached_rows
            )
            def retimed_cached_rows() -> list[dict[str, object]]:
                if server_duration_advanced:
                    duration = dps_duration_seconds(server_duration)
                    for row in cached_rows:
                        try:
                            damage = max(
                                0, int(row.get("total_value", 0) or 0)
                            )
                        except (TypeError, ValueError, OverflowError):
                            damage = 0
                        player_dps = damage / duration
                        row["stat_value"] = player_dps
                        row["dps_value"] = player_dps
                    segment["snapshot_duration"] = duration
                    segment["rows"] = cached_rows
                return [dict(row) for row in cached_rows]
            if data is None:
                return retimed_cached_rows()
            try:
                snapshot_time = int(
                    getattr(
                        self.model,
                        "targetless_team_last_committed_time_100ns",
                        0,
                    )
                    or 0
                )
                last_snapshot_time = int(
                    segment.get("last_snapshot_time_100ns", 0) or 0
                )
            except (TypeError, ValueError, OverflowError):
                return cached_rows
            if snapshot_time <= last_snapshot_time:
                return retimed_cached_rows()
            snapshot_epoch = (
                snapshot_time - 116_444_736_000_000_000
            ) / 10_000_000
            started_at = float(segment["started_at_epoch"])
            if snapshot_epoch < started_at:
                return cached_rows

            stats, _raw_duration = data
            ended_at = float(segment.get("ended_at_epoch", 0.0) or 0.0)
            if segment.get("kind") == "small_monsters":
                elapsed = max(
                    0.0,
                    float(segment.get("elapsed_seconds", 0.0) or 0.0),
                )
                active_started_at = float(
                    segment.get("active_started_at_epoch", 0.0) or 0.0
                )
                if segment.get("active") and active_started_at > 0:
                    elapsed += max(0.0, snapshot_epoch - active_started_at)
                elapsed = max(elapsed, server_duration)
                duration = dps_duration_seconds(elapsed)
            else:
                duration_endpoint = (
                    min(snapshot_epoch, ended_at)
                    if not segment.get("active") and ended_at >= started_at
                    else snapshot_epoch
                )
                duration = dps_duration_seconds(duration_endpoint - started_at)
            targetless_states = getattr(
                self.model, "targetless_team_states", {}
            )
            baselines = segment.get("baseline_states", {})
            if not isinstance(targetless_states, dict) or not isinstance(
                baselines, dict
            ):
                return cached_rows
            friend_order = [
                int(actor_id)
                for actor_id in getattr(self.model, "friend_order", [])
                if int(actor_id or 0)
            ]
            friend_index = {
                actor_id: index for index, actor_id in enumerate(friend_order)
            }
            profession_reader = getattr(
                self.model, "actor_profession_id", None
            )
            self_id = int(getattr(self.model, "self_id", 0) or 0)
            projected: list[tuple[ActorStats, int, float]] = []
            for actor in stats:
                actor_id = int(getattr(actor, "actor_id", 0) or 0)
                state = targetless_states.get(actor_id)
                if not actor_id or state is None:
                    continue
                token = str(getattr(state, "user_token", "") or "").strip()
                state_key = token or f"actor:{actor_id}"
                try:
                    total_damage = max(
                        0,
                        int(
                            getattr(
                                state,
                                "total_damage",
                                getattr(actor, "damage", 0),
                            )
                            or 0
                        ),
                    )
                    server_time = max(
                        0, int(getattr(state, "server_time", 0) or 0)
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
                baseline = baselines.get(state_key)
                if baseline is None:
                    damage = total_damage
                else:
                    baseline_damage, _baseline_server_time = baseline
                    damage = (
                        total_damage - baseline_damage
                        if total_damage >= baseline_damage
                        else total_damage
                    )
                damage = max(0, int(damage))
                projected.append((actor, damage, damage / duration))

            rows: list[dict[str, object]] = []
            for actor, damage, player_dps in sorted(
                projected,
                key=lambda value: (
                    -value[1],
                    friend_index.get(
                        int(getattr(value[0], "actor_id", 0) or 0),
                        len(friend_index),
                    ),
                    int(getattr(value[0], "actor_id", 0) or 0),
                ),
            ):
                actor_id = int(getattr(actor, "actor_id", 0) or 0)
                try:
                    profession_id = int(
                        profession_reader(actor_id)
                        if callable(profession_reader)
                        else 0
                    )
                except (TypeError, ValueError, OverflowError):
                    profession_id = 0
                rows.append(
                    {
                        "actor_id": actor_id,
                        "profession_id": profession_id,
                        "name": self._shown_actor_name(actor_id),
                        "metric": "dps",
                        "stat_value": player_dps,
                        "total_value": damage,
                        "dps_value": player_dps,
                        "damage_sort": damage,
                        "deaths": 0,
                        "hide_deaths": True,
                        "rating": None,
                        "rating_text": "",
                        "inline_rating_text": "",
                        "is_ai": self._main_actor_is_ai(actor_id),
                        "is_self": actor_id == self_id,
                        "targetless_team_live": True,
                    }
                )
            segment["last_snapshot_time_100ns"] = snapshot_time
            segment["snapshot_duration"] = duration
            segment["rows"] = rows
            return [dict(row) for row in rows]
        if data is None:
            return None
        stats, raw_duration = data
        duration = dps_duration_seconds(raw_duration)
        targetless_states = getattr(self.model, "targetless_team_states", {})
        friend_order = [
            int(actor_id)
            for actor_id in getattr(self.model, "friend_order", [])
            if int(actor_id or 0)
        ]
        friend_index = {
            actor_id: index for index, actor_id in enumerate(friend_order)
        }
        profession_reader = getattr(self.model, "actor_profession_id", None)
        self_id = int(getattr(self.model, "self_id", 0) or 0)
        rows = []
        for actor in sorted(
            stats,
            key=lambda value: (
                -int(getattr(value, "damage", 0) or 0),
                friend_index.get(
                    int(getattr(value, "actor_id", 0) or 0),
                    len(friend_index),
                ),
                int(getattr(value, "actor_id", 0) or 0),
            ),
        ):
            actor_id = int(getattr(actor, "actor_id", 0) or 0)
            if not actor_id:
                continue
            damage = max(0, int(getattr(actor, "damage", 0) or 0))
            state = (
                targetless_states.get(actor_id)
                if isinstance(targetless_states, dict)
                else None
            )
            cached_live_dps = getattr(state, "live_dps", None)
            player_dps = (
                float(cached_live_dps)
                if cached_live_dps is not None
                else damage / duration
                if duration
                else 0.0
            )
            try:
                profession_id = int(
                    profession_reader(actor_id)
                    if callable(profession_reader)
                    else 0
                )
            except (TypeError, ValueError, OverflowError):
                profession_id = 0
            rows.append(
                {
                    "actor_id": actor_id,
                    "profession_id": profession_id,
                    "name": self._shown_actor_name(actor_id),
                    "metric": "dps",
                    "stat_value": player_dps,
                    "total_value": damage,
                    "dps_value": player_dps,
                    "damage_sort": damage,
                    "deaths": 0,
                    "hide_deaths": True,
                    "rating": None,
                    "rating_text": "",
                    "inline_rating_text": "",
                    "is_ai": self._main_actor_is_ai(actor_id),
                    "is_self": actor_id == self_id,
                    "targetless_team_live": True,
                }
            )
        return rows or None

    def _main_authoritative_live_team_rows(
        self, now: float | None = None
    ) -> list[dict[str, object]] | None:
        """Return live team rows only after a server team snapshot arrived."""

        model = self.model
        current_monster = getattr(model, "current_monster", None)
        model_monster = current_monster() if callable(current_monster) else None
        if model_monster is None:
            current_bosses = getattr(model, "current_bosses", None)
            model_bosses = (
                list(current_bosses()) if callable(current_bosses) else []
            )
            model_monster = model_bosses[0] if model_bosses else None
        if self._main_live_hud_projection_active(now) and (
            self._main_live_hud_boss_state() is not None
            or model_monster is None
        ):
            targetless_rows = self._main_targetless_team_rows(now)
            # An empty list means that the new live segment is waiting for its
            # first snapshot; let the settlement projection handle that gap.
            if targetless_rows:
                return targetless_rows
            segment = self._main_live_hud_dps_segment_state(now)
            if (
                self._main_live_hud_boss_state() is not None
                and isinstance(segment, dict)
                and segment.get("kind") == "boss"
            ):
                # The Boss edge resets the visible list immediately.  Do not
                # leak the model's stage-wide counters while the first clean
                # Boss-only team snapshot is still being assembled.
                return []

        combat_in_progress = getattr(model, "combat_in_progress", None)
        if not callable(combat_in_progress):
            return None
        try:
            active = bool(combat_in_progress(now))
        except TypeError:
            active = bool(combat_in_progress())
        if not active:
            return None

        states = getattr(model, "team_damage_states", {})
        if not isinstance(states, dict):
            return None
        authoritative_ids = {
            int(actor_id)
            for actor_id, state in states.items()
            if int(actor_id or 0)
            and bool(getattr(state, "authoritative_snapshot", False))
            and int(getattr(state, "snapshot_time_100ns", 0) or 0) > 0
        }
        self_id = int(getattr(model, "self_id", 0) or 0)
        if not authoritative_ids or not any(
            actor_id != self_id for actor_id in authoritative_ids
        ):
            return None

        rows = [
            row
            for row in self._main_combat_display_rows(now)
            if int(row.get("actor_id", 0) or 0) in authoritative_ids
        ]
        return rows or None

    def _main_display_rows(
        self, now: float | None = None
    ) -> tuple[list[dict[str, object]], bool]:
        live_team_rows = self._main_authoritative_live_team_rows(now)
        if live_team_rows:
            live_self = self._main_live_self_dps_row(now)
            try:
                self_id = int(getattr(self.model, "self_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                self_id = 0
            team_self = next(
                (
                    row
                    for row in live_team_rows
                    if row.get("is_self")
                    or (self_id and int(row.get("actor_id", 0) or 0) == self_id)
                ),
                None,
            )
            if live_self is None and team_self is not None:
                live_self = dict(team_self, is_self=True, is_live_self=True)
            missing_live_dps = bool(
                live_self is not None
                and team_self is not None
                and live_self.get("metric") == "dps"
                and live_self.get("stat_value") is None
                and live_self.get("total_value") is None
            )
            segment = self._main_live_hud_dps_segment_state(now)
            small_monster_self_dps = bool(
                live_self is not None
                and team_self is not None
                and team_self.get("targetless_team_live")
                and isinstance(segment, dict)
                and segment.get("kind") == "small_monsters"
                and self._main_player_display_metric(
                    live_self.get("profession_id"), team_self.get("dps_value")
                )
                == "dps"
            )
            if missing_live_dps or small_monster_self_dps:
                # Local hit events intentionally exclude ordinary monsters.
                # The complete Common team snapshot is therefore the local
                # player's live source here, including the audience >5000 DPS
                # override.  Boss projection keeps its existing path.
                if small_monster_self_dps:
                    live_self["metric"] = "dps"
                for key in (
                    "stat_value",
                    "total_value",
                    "dps_value",
                    "damage_sort",
                    "deaths",
                    "hide_deaths",
                ):
                    if key in team_self:
                        live_self[key] = team_self[key]
            rows: list[dict[str, object]] = []
            if live_self is not None:
                rows.append(live_self)
            rows.append(
                {
                    "row_kind": "section",
                    "section_text": "实时战斗/战斗记录",
                    "expanded": True,
                }
            )
            rows.extend(live_team_rows)
            return rows, False
        settlement_rows = self._settlement_main_rows(now)
        if settlement_rows is not None:
            return settlement_rows, False
        rating_preview = self._team_rating_preview_active()
        if not rating_preview:
            if self._main_retained_battle_active():
                retained_rows = self._main_retained_battle_rows()
                if getattr(self, 'settlement_ui', None) is not None:
                    retained_rows = [row for row in retained_rows if row.get('is_self')]
                return retained_rows, False
            cached_targetless_rows = self._main_targetless_team_rows(now)
            if cached_targetless_rows:
                return cached_targetless_rows, False
            rows = self._main_combat_display_rows(now)
            if getattr(self, 'settlement_ui', None) is not None:
                rows = [row for row in rows if row.get('is_self')]
            if self._main_display_is_cleared():
                rows = [dict(row, stat_value=None, total_value=None, sort_damage=0, deaths=0) for row in rows]
            return rows, False
        return self._main_rating_display_rows(), True

    def _main_rating_display_rows(self) -> list[dict[str, object]]:
        if not TEAM_RATING_PREVIEW_AVAILABLE or not bool(
            getattr(self, "team_rating_preview_enabled", False)
        ):
            return []
        rows: list[dict[str, object]] = []
        for raw in self._team_rating_preview_rows():
            actor_id = int(raw.get("actor_id", 0) or 0)
            name = (
                raw.get("anonymous_name", "")
                if bool(getattr(self, "hide_names", False))
                else raw.get("display_name", "")
                or raw.get("anonymous_name", "")
            )
            rating = normalize_extraordinary_rating(
                raw.get("extraordinary_rating")
            )
            is_ai = self._main_actor_is_ai(actor_id, raw)
            rows.append(
                {
                    "actor_id": actor_id,
                    "profession_id": int(raw.get("profession_id", 0) or 0),
                    "name": str(name or ""),
                    "metric": "rating",
                    "rating": rating,
                    "equipment_profile_ready": bool(
                        raw.get("equipment_profile_ready", False)
                    ),
                    "equipment_count": int(
                        raw.get("equipment_count", 0) or 0
                    ),
                    "pvp_equipment_count": int(
                        raw.get("pvp_equipment_count", 0) or 0
                    ),
                    "active_word_count": int(
                        raw.get("active_word_count", 0) or 0
                    ),
                    "total_word_count": int(
                        raw.get("total_word_count", 0) or 0
                    ),
                    "is_ai": is_ai,
                    "rating_text": (
                        "人机" if is_ai else "--" if rating is None else str(rating)
                    ),
                    "inline_rating_text": (
                        "人机" if is_ai else "" if rating is None else str(rating)
                    ),
                    # Equipment ratings are independent of the active pull.
                    # Never leak current-fight deaths into this tab.
                    "deaths": 0,
                    "hide_deaths": True,
                    "is_self": actor_id == getattr(self.model, "self_id", None),
                    "highlight_self_row": False,
                }
            )
        return rows

    def _main_team_rating_summary_text(self) -> str:
        """Return the current real-player team average for the HUD footer."""

        profiles = [dict(row) for row in self._team_rating_preview_rows()]
        average, _rated_count, _team_size = team_average_extraordinary_rating(
            profiles
        )
        return format_extraordinary_rating(average)

    def _main_columns(self, width: int) -> dict[str, int]:
        compact = bool(getattr(self, "compact_mode", False))
        enabled = list(self._enabled_main_metrics())
        content_width = max(
            120, width - (MINI_ACTION_AREA_WIDTH if compact else 0)
        )
        right_edge = max(100, content_width - (8 if compact else 18))
        if compact:
            if len(enabled) <= 1:
                name_ratio = 0.50
            elif len(enabled) == 2:
                name_ratio = 0.40
            elif len(enabled) == 3:
                name_ratio = 0.32
            else:
                name_ratio = 0.25
        else:
            if len(enabled) <= 1:
                name_ratio = 0.45
            elif len(enabled) == 2:
                name_ratio = 0.38
            elif len(enabled) == 3:
                name_ratio = 0.33
            else:
                name_ratio = 0.27
        reserved_per_metric = 28 if compact else 42
        reserved = max(32, reserved_per_metric * len(enabled))
        name_limit = min(
            160 if compact else 220,
            right_edge - reserved,
            max(
                72 if compact else 120,
                int(content_width * name_ratio),
            ),
        )
        compact_name_floor = (
            112 if compact and right_edge - reserved >= 112 else 56
        )
        name_limit = max(compact_name_floor if compact else 90, name_limit)
        columns = {"name_limit": name_limit}
        if not enabled:
            return columns
        columns.update(self._weighted_metric_columns(enabled, name_limit, right_edge))
        return columns

    @staticmethod
    def _weighted_metric_columns(
        enabled: list[str] | tuple[str, ...],
        left_edge: int,
        right_edge: int,
    ) -> dict[str, int]:
        """Keep names compact while reserving readable numeric/time columns."""
        keys = tuple(enabled)
        if not keys:
            return {}
        weights = [max(0.1, METRIC_COLUMN_WEIGHTS.get(key, 1.0)) for key in keys]
        total_weight = sum(weights)
        available = max(len(keys), int(right_edge) - int(left_edge))
        cursor = float(left_edge)
        columns: dict[str, int] = {}
        for index, (key, weight) in enumerate(zip(keys, weights)):
            cursor += available * weight / total_weight
            columns[key] = (
                int(right_edge) if index == len(keys) - 1 else int(round(cursor))
            )
        return columns

    def _main_row_height(self) -> int:
        if self._layered_main_active():
            return max(
                1,
                logical_pixels_to_physical(
                    HUD_ROW_HEIGHT
                    * float(getattr(self, "main_ui_scale", 1.0) or 1.0),
                    getattr(self, "window_dpi", DEFAULT_DPI),
                ),
            )
        return self._main_px(max(MAIN_ROW_BASE_HEIGHT, self.ui_font_size + 22))

    def _scroll_main(self, event) -> str:
        if (
            bool(getattr(self, "window_locked", False))
            or self._startup_interaction_blocked()
        ):
            return "break"
        try:
            delta = int(getattr(event, "delta", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            delta = 0
        try:
            button = int(getattr(event, "num", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            # Tk reports "??" here for native Windows <MouseWheel> events.
            button = 0
        if button == 4:
            direction, steps = -1, 1
        elif button == 5:
            direction, steps = 1, 1
        elif delta:
            direction = -1 if delta > 0 else 1
            steps = max(1, abs(delta) // 120)
        else:
            return "break"
        if getattr(self, "main_combat_mode", "pve") == "pvp" and self._layered_main_active():
            region = self._layered_main_region_at(
                int(getattr(event, "x", -1)), int(getattr(event, "y", -1))
            )
            if region.startswith(("action:refresh_equipment:", "equipment_refresh_pending:")):
                x, y = int(getattr(event, "x", -1)), int(getattr(event, "y", -1))
                for key, (left, top, right, bottom) in getattr(self, "layered_main_hit_regions", {}).items():
                    if key.startswith("scroll:pvp_") and left <= x <= right and top <= y <= bottom:
                        region = key
                        break
            direction_name = (
                region.removeprefix("scrollbar:pvp_")
                if region.startswith("scrollbar:pvp_")
                else region.removeprefix("scroll:pvp_")
            )
            if direction_name == "team":
                tracker = getattr(getattr(self, "pvp_recording", None), "display_tracker", None)
                league = getattr(tracker, "pvp_league_roster", {}) or {}
                offset = int(getattr(self, "pvp_team_offset", 0))
                if league.get("raids"):
                    snapshot = self._pvp_layered_main_snapshot()
                    selected = int(snapshot.get("pvp_league_selected_raid", 0) or 0)
                    selected = selected or int(league.get("raid_number", 1) or 1)
                    count = sum(
                        int(row.get("raid_number", 0) or 0) == selected
                        for row in snapshot.get("pvp_team_rows", ())
                    )
                    visible = max(1, max(12, int(snapshot.get("visible_rows", 12))) - 2)
                    next_offset = min(max(0, count - visible), max(0, offset + direction * steps))
                else:
                    count = getattr(self, "pvp_team_row_count", None)
                    if count is None:
                        count = len(self._pvp_team_composition_rows())
                    count = min(PVP_MAX_TEAM_MEMBERS, max(0, int(count)))
                    pages = max(
                        1,
                        min(
                            PVP_MAX_TEAM_PAGES,
                            (count + PVP_TEAM_PAGE_SIZE - 1) // PVP_TEAM_PAGE_SIZE,
                        ),
                    )
                    page = min(pages - 1, max(0, offset // PVP_TEAM_PAGE_SIZE))
                    page_start = page * PVP_TEAM_PAGE_SIZE
                    page_count = min(PVP_TEAM_PAGE_SIZE, max(0, count - page_start))
                    visible = max(1, max(12, int(getattr(self, "pvp_visible_rows", 12))) - 2)
                    local = max(0, offset - page_start)
                    local = min(max(0, page_count - visible), local)
                    next_local = min(
                        max(0, page_count - visible),
                        max(0, local + direction * steps),
                    )
                    next_offset = page_start + next_local
                if next_offset != offset:
                    self.pvp_team_offset = next_offset
                    self._schedule_layered_main_render()
                return "break"
            if direction_name == "teammates":
                snapshot = self._pvp_layered_main_snapshot()
                maximum = max(0, len(snapshot.get("pvp_teammates", ())) - 1)
                offset = int(getattr(self, "pvp_teammate_offset", 0))
                next_offset = min(maximum, max(0, offset + direction * steps))
                if next_offset != offset:
                    self.pvp_teammate_offset = next_offset
                    self._schedule_layered_main_render()
                return "break"
            if direction_name in ("outgoing", "incoming", "allies", "enemies"):
                snapshot = self._pvp_layered_main_snapshot()
                maximum = max(0, len(snapshot.get("pvp_" + direction_name, ())) - 4)
                offset_name = "pvp_" + direction_name + "_offset"
                offset = int(getattr(self, offset_name, 0))
                next_offset = min(maximum, max(0, offset + direction * steps))
                if next_offset != offset:
                    setattr(self, offset_name, next_offset)
                    self._schedule_layered_main_render()
            return "break"
        if self._layered_main_active():
            scroll_region = getattr(
                self, "layered_main_hit_regions", {}
            ).get("scroll:rows")
            if (
                scroll_region
                and hasattr(event, "x")
                and hasattr(event, "y")
            ):
                left, top, right, bottom = scroll_region
                if not left <= event.x <= right or not top <= event.y <= bottom:
                    return "break"
            elif not scroll_region:
                regions = getattr(self, "layered_main_actor_regions", ())
                if (
                    regions
                    and hasattr(event, "x")
                    and hasattr(event, "y")
                    and not any(
                        left <= event.x <= right and top <= event.y <= bottom
                        for (left, top, right, bottom), _actor in regions
                    )
                ):
                    return "break"
            snapshot = self._layered_main_snapshot()
            rows = snapshot.get("rows", ())
            row_height = self._main_row_height()
            viewport_rows = max(1, int(snapshot.get("visible_rows", 1) or 1))
            viewport_height = row_height * viewport_rows
            content_height = max(viewport_height, row_height * len(rows))
            maximum_offset = max(0, content_height - viewport_height)
            current_offset = min(
                maximum_offset,
                max(0, int(getattr(self, "main_scroll_offset", 0))),
            )
            self.main_scroll_content_height = content_height
            self.main_scroll_offset = min(
                maximum_offset,
                max(0, current_offset + direction * steps * row_height),
            )
            self._schedule_layered_main_render()
            return "break"
        canvas = self.rows_canvas
        viewport_height = max(1, canvas.winfo_height())
        content_height = max(
            viewport_height,
            int(getattr(self, "main_scroll_content_height", viewport_height)),
        )
        maximum_offset = max(0, content_height - viewport_height)
        current_offset = min(
            maximum_offset,
            max(0, int(getattr(self, "main_scroll_offset", 0))),
        )
        self.main_scroll_offset = min(
            maximum_offset,
            max(
                0,
                current_offset + direction * steps * self._main_row_height(),
            ),
        )
        canvas.yview_moveto(self.main_scroll_offset / max(1, content_height))
        self._draw_main_scroll_indicator(
            canvas.winfo_width(), viewport_height, content_height
        )
        return "break"

    def _draw_main_scroll_indicator(
        self, width: int, viewport_height: int, content_height: int
    ) -> None:
        canvas = self.rows_canvas
        canvas.delete("main_scroll_indicator")
        if content_height <= viewport_height:
            return
        maximum_offset = max(1, content_height - viewport_height)
        thumb_height = max(
            14, int(viewport_height * viewport_height / content_height)
        )
        travel = max(1, viewport_height - thumb_height - 4)
        thumb_top = 2 + int(
            travel * min(maximum_offset, self.main_scroll_offset) / maximum_offset
        )
        visible_top = float(canvas.canvasy(0))
        canvas.create_rectangle(
            max(0, width - 4),
            visible_top + thumb_top,
            max(1, width - 1),
            visible_top + min(viewport_height - 2, thumb_top + thumb_height),
            fill=MUTED,
            outline="",
            tags=("main_scroll_indicator",),
        )

    def _shown_actor_name(self, actor_id: int) -> str:
        if not self.hide_names:
            display_name = self.model.display_name(actor_id)
            if display_name:
                return display_name
        ordered = list(self.model.friend_order)
        if actor_id not in ordered:
            ordered.extend(value for value in self.model.stats if value not in ordered)
        try:
            index = ordered.index(actor_id)
        except ValueError:
            index = len(ordered)
        return f"玩家{index + 1}"

    def _fit_ui_text(
        self,
        value: object,
        maximum_width: int,
        font_role: str = "strong",
    ) -> str:
        text = str(value or "").strip()
        if not text or maximum_width <= 0:
            return text
        font = self._ui_font(font_role)
        if font.measure(text) <= maximum_width:
            return text
        suffix = "..."
        while text and font.measure(text + suffix) > maximum_width:
            text = text[:-1]
        return text + suffix if text else suffix

    def _fit_main_actor_name(self, value: object, maximum_width: int) -> str:
        return self._fit_ui_text(value, maximum_width, "strong")

    def _main_extraordinary_rating(
        self, actor_id: int, row: object = None
    ) -> int | None:
        raw_rating = row.get("extraordinary_rating") if isinstance(row, dict) else None
        if raw_rating is None:
            ratings = getattr(self.model, "entity_extraordinary_ratings", {})
            if isinstance(ratings, dict):
                raw_rating = ratings.get(actor_id)
        rating = normalize_extraordinary_rating(raw_rating)
        if rating is not None:
            return rating
        token = row.get("user_token", "") if isinstance(row, dict) else ""
        equipment = self._equipment_summary_for_actor(actor_id, token)
        return normalize_extraordinary_rating(
            equipment.get("extraordinary_rating")
        )

    def _main_extraordinary_rating_visible(self, *, rating_preview: bool) -> bool:
        """Keep the dedicated pre-combat preview independent from row display."""

        return bool(
            rating_preview
            or getattr(self, "show_extraordinary_rating", False)
        )

    def _main_actor_is_ai(self, actor_id: int, row: object = None) -> bool:
        if isinstance(row, dict) and "is_ai" in row:
            return bool(row.get("is_ai"))
        ai_states = getattr(self.model, "entity_ai_states", {})
        if isinstance(ai_states, dict) and actor_id in ai_states:
            return bool(ai_states[actor_id])
        return False

    def _main_rating_badge_layout(
        self,
        *,
        name_x: int,
        name_limit: int,
        top: int,
        row_height: int,
        compact: bool,
        identity_label: str = "",
        displayed_name_width: int | None = None,
    ) -> dict[str, object] | None:
        """Place the rating after the visible name without moving metric columns."""

        font_size = max(9, int(getattr(self, "ui_font_size", 14) or 14))
        right_padding = 7 if compact else 5
        gap = 4 if compact else 6
        right = int(name_limit) - right_padding
        available = right - int(name_x)
        full_width = max(92, int(round(font_size * 6.6)))
        compact_width = max(44, int(round(font_size * 3.15)))
        identity_label = str(identity_label or "").strip()
        identity_width = max(38, int(round(font_size * len(identity_label) + 14)))
        full_name_floor = max(35, int(round(font_size * 2.5)))
        use_compact = bool(
            identity_label
            or compact
            or available < full_width + gap + full_name_floor
        )
        badge_width = (
            identity_width
            if identity_label
            else compact_width
            if use_compact
            else full_width
        )
        name_floor = max(14, int(round(font_size * (1.15 if use_compact else 2.5))))
        if available < badge_width + gap + name_floor:
            return None
        badge_height = min(
            max(14, row_height - 6),
            max(20, font_size + (5 if compact else 7)),
        )
        middle = top + row_height // 2
        left = right - badge_width
        if displayed_name_width is not None:
            inline_left = int(name_x) + max(0, int(displayed_name_width)) + gap
            left = min(left, inline_left)
            right = left + badge_width
        return {
            "bounds": (
                left,
                middle - badge_height // 2,
                right,
                middle + (badge_height + 1) // 2,
            ),
            "compact": use_compact,
            "name_width": max(8, left - gap - name_x),
        }

    def _draw_main_rating_badge(
        self,
        canvas: tk.Canvas,
        *,
        rating: int | None,
        layout: dict[str, object],
        actor_tag: str,
        identity_label: str = "",
    ) -> None:
        create_polygon = getattr(canvas, "create_polygon", None)
        if not callable(create_polygon):
            return
        left, top, right, bottom = layout["bounds"]
        compact = bool(layout.get("compact"))
        identity_label = str(identity_label or "").strip()
        is_ai = identity_label == "人机"
        missing = rating is None and not identity_label
        fill = "#152329" if is_ai else "#14171a" if missing else "#2a2319"
        outline = "#315563" if is_ai else "#343c44" if missing else "#685936"
        foreground = "#8bc7d4" if is_ai else SUBTLE if missing else "#efc77d"
        diamond_color = "#67aebe" if is_ai else SUBTLE if missing else "#e8b85f"
        cut = max(2, min(4, int((bottom - top) // 5)))
        create_polygon(
            left + cut,
            top,
            right - cut,
            top,
            right,
            top + cut,
            right,
            bottom - cut,
            right - cut,
            bottom,
            left + cut,
            bottom,
            left,
            bottom - cut,
            left,
            top + cut,
            fill=fill,
            outline=outline,
            width=1,
            tags=(actor_tag, "main-rating"),
        )
        middle = (top + bottom) / 2
        diamond_x = left + (8 if compact else 10)
        canvas.create_text(
            diamond_x,
            middle,
            text="◆",
            fill=diamond_color,
            anchor="center",
            font=self._ui_font("micro"),
            state="disabled",
            tags=(actor_tag, "main-rating-glyph"),
        )
        value = identity_label or format_extraordinary_rating(rating, compact=compact)
        canvas.create_text(
            left + (15 if compact else 20),
            middle,
            text=value if compact or identity_label else f"非凡 {value}",
            fill=foreground,
            anchor="w",
            font=self._ui_font("micro"),
            state="disabled",
            tags=(actor_tag, "main-rating-text"),
        )

    @staticmethod
    def _actor_critical_text(actor: ActorStats | None) -> str:
        if (
            actor is None
            or not actor.damage_hits
            or actor.critical_hits is None
        ):
            return "--"
        return f"{actor.critical_hits / actor.damage_hits * 100:.1f}%"

    @staticmethod
    def _actor_penetration_text(actor: ActorStats | None) -> str:
        if (
            actor is None
            or not actor.damage_hits
            or actor.penetration_hits is None
        ):
            return "--"
        return f"{actor.penetration_hits / actor.damage_hits * 100:.1f}%"

    def _profession_info(self, class_id: int | None) -> tuple[str, str]:
        value = self.professions.get(str(class_id or 0), {})
        name = value.get("name", "") if isinstance(value, dict) else ""
        color = PROFESSION_COLORS.get(int(class_id or 0), SUBTLE)
        return (str(name).strip() or "职业识别中", color)

    def _draw_main_rows(self) -> None:
        if self._layered_main_active():
            self._hide_main_content_overlay()
            self._schedule_layered_main_render()
            return
        self._hide_main_content_overlay()
        self._draw_main_rows_on_canvas(
            self.rows_canvas,
            update_scroll_state=True,
        )

    def _draw_main_rows_on_canvas(
        self,
        canvas: tk.Canvas,
        *,
        update_scroll_state: bool,
        draw_empty_state: bool = True,
        draw_content: bool = True,
        draw_bars: bool = True,
        opaque_bar_layer: bool = False,
    ) -> None:
        del draw_bars, opaque_bar_layer
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        rows, rating_preview = self._main_display_rows()
        application_rows = self._team_application_section_rows()
        if update_scroll_state:
            self._sync_main_content_height(len(rows))
            try:
                height = max(1, int(canvas.cget("height")))
            except (AttributeError, TypeError, ValueError, tk.TclError):
                pass
        row_height = self._main_row_height()
        content_height = max(height, len(rows) * row_height)

        if not rows and str(getattr(self, "main_combat_mode", "pve")).casefold() != "pvp":
            if update_scroll_state:
                self.main_scroll_offset = 0
                self.main_scroll_content_height = height
            if draw_empty_state and draw_content:
                canvas_outlined_text(
                    canvas,
                    width // 2,
                    height // 2,
                    text=(
                        "正在等待队伍资料"
                        if rating_preview
                        else "等待战斗数据"
                    ),
                    fill="#a5b1bf",
                    outline="#071019",
                    font=self._ui_font("main_strong"),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            canvas.yview_moveto(0.0)
            return

        scroll_offset = min(
            max(0, content_height - height),
            max(0, int(getattr(self, "main_scroll_offset", 0))),
        )
        if update_scroll_state:
            self.main_scroll_content_height = content_height
            self.main_scroll_offset = scroll_offset
        canvas.configure(
            yscrollincrement=1,
            scrollregion=(0, 0, width, content_height),
        )
        canvas.yview_moveto(scroll_offset / max(1, content_height))
        if not draw_content:
            return

        columns = self._main_display_columns(
            width, rating_preview=rating_preview
        )
        mask_opacity = clamp_percent(
            getattr(self, "main_row_mask_opacity", 0), 0
        )
        mask_stipple = main_row_mask_stipple(mask_opacity)
        icon_base_size = max(32, min(36, self.ui_font_size + 20))
        icon_logical_size = icon_base_size * float(
            getattr(self, "main_ui_scale", 1.0) or 1.0
        )
        icon_size = self._main_px(icon_base_size)
        name_width = max(
            self._main_px(24), columns["name_right"] - columns["name"]
        )
        for index, row in enumerate(rows):
            top = index * row_height
            bottom = top + row_height
            row_kind = str(row.get("row_kind") or "")
            if row_kind == "team_application":
                margin = self._main_px(5)
                canvas_rounded_rectangle(
                    canvas,
                    margin,
                    top + self._main_px(7),
                    width - margin,
                    bottom - self._main_px(7),
                    self._main_px(8),
                    fill="#129750",
                    outline="#66ffa6",
                    width=max(1, self._main_px(1)),
                    tags=("main-team-application",),
                )
                canvas_outlined_text(
                    canvas,
                    width // 2,
                    top + row_height // 2,
                    text=str(
                        row.get("application_text") or "入队申请"
                    ),
                    fill="#f7fffa",
                    outline="#07552d",
                    outline_width=max(1, self._main_px(1)),
                    font=self._ui_font("main_text"),
                )
                continue
            if row_kind == "section":
                canvas_outlined_text(
                    canvas,
                    width // 2,
                    top + row_height // 2,
                    text=str(row.get("section_text") or "实时战斗/战斗记录"),
                    fill="#a6bbcf",
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    font=self._ui_font("main_text"),
                )
                continue
            if row_kind == "message":
                canvas_outlined_text(
                    canvas,
                    width // 2,
                    top + row_height // 2,
                    text=str(row.get("message_text") or "等待战斗数据"),
                    fill="#b7c8d8",
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    font=self._ui_font("main_text"),
                )
                continue
            if row_kind == "recent_boss":
                margin = self._main_px(5)
                canvas_rounded_rectangle(
                    canvas,
                    margin,
                    top + self._main_px(7),
                    width - margin,
                    bottom - self._main_px(7),
                    self._main_px(8),
                    fill="#08131d",
                    outline="#5b7790",
                    width=max(1, self._main_px(1)),
                    tags=("main-recent-boss",),
                )
                portrait_size = min(
                    self._main_px(38), row_height - self._main_px(14)
                )
                boss_icon = str(row.get("boss_icon") or "").strip()
                boss_name = str(row.get("boss_name") or "Boss")
                portrait = (
                    self.icons.boss(
                        boss_icon,
                        boss_name,
                        max(16, portrait_size),
                    )
                    if boss_icon
                    else self.icons.main_boss_icon(max(16, portrait_size))
                )
                canvas.create_image(
                    margin + self._main_px(4),
                    top + row_height // 2,
                    image=portrait,
                    anchor="w",
                    tags=("main-recent-boss",),
                )
                bar_left = margin + portrait_size + self._main_px(8)
                bar_right = width - margin - self._main_px(5)
                bar_top = top + self._main_px(8)
                bar_bottom = bottom - self._main_px(8)
                canvas_rounded_rectangle(
                    canvas,
                    bar_left,
                    bar_top,
                    bar_right,
                    bar_bottom,
                    self._main_px(5),
                    fill="#04070c",
                    outline="#b23748",
                    width=max(1, self._main_px(1)),
                    tags=("main-recent-boss",),
                )
                try:
                    ratio = max(
                        0.0, min(1.0, float(row.get("boss_ratio")))
                    )
                except (TypeError, ValueError, OverflowError):
                    ratio = 0.0
                if row.get("boss_ratio") is not None and ratio > 0:
                    canvas_rounded_rectangle(
                        canvas,
                        bar_left + self._main_px(1),
                        bar_top + self._main_px(1),
                        max(
                            bar_left + self._main_px(3),
                            bar_left + (bar_right - bar_left) * ratio,
                        ),
                        bar_bottom - self._main_px(1),
                        self._main_px(4),
                        fill="#e11239",
                        outline="",
                        width=0,
                        tags=("main-recent-boss",),
                    )
                health_text = "  ".join(
                    value for value in (
                        str(row.get("boss_hp") or "").strip(),
                        str(row.get("boss_percent") or "").strip(),
                    ) if value
                ) or "血量未记录"
                text_gap = self._main_px(8)
                name_left = bar_left + self._main_px(8)
                name_width = max(
                    self._main_px(54),
                    min(
                        self._main_px(100),
                        (bar_right - bar_left) // 3,
                    ),
                )
                canvas_outlined_text(
                    canvas,
                    name_left,
                    top + row_height // 2,
                    text=self._fit_ui_text(
                        boss_name,
                        name_width,
                        "main_text",
                    ),
                    fill="#f6eef0",
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    anchor="w",
                    font=self._ui_font("main_text"),
                    tags=("main-recent-boss",),
                )
                canvas_outlined_text(
                    canvas,
                    bar_right - self._main_px(7),
                    top + row_height // 2,
                    text=self._fit_ui_text(
                        health_text,
                        max(
                            self._main_px(70),
                            bar_right
                            - name_left
                            - name_width
                            - text_gap
                            - self._main_px(7),
                        ),
                        "main_number_small",
                    ),
                    fill="#f3dde1",
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    anchor="e",
                    font=self._ui_font("main_number_small"),
                    tags=("main-recent-boss",),
                )
                continue
            actor_id = int(row.get("actor_id", 0) or 0)
            is_self = bool(
                row.get("is_self")
                and getattr(self, "highlight_self", True)
            )
            if is_self:
                actor_tags = (f"actor:{actor_id}", "main-row-mask")
                radius = max(2, (bottom - top) // 2 - self._main_px(1))
                canvas_rounded_rectangle(
                    canvas,
                    self._main_px(1),
                    top + self._main_px(1),
                    width - self._main_px(1),
                    bottom - self._main_px(1),
                    radius,
                    fill="",
                    outline="#079ee8",
                    width=max(2, self._main_px(2)),
                    tags=actor_tags,
                )
                canvas_rounded_rectangle(
                    canvas,
                    self._main_px(3),
                    top + self._main_px(3),
                    width - self._main_px(3),
                    bottom - self._main_px(3),
                    max(1, radius - self._main_px(2)),
                    fill="",
                    outline="#7bd5ff",
                    width=max(1, self._main_px(1)),
                    tags=actor_tags,
                )
            elif mask_opacity > 0:
                rectangle_options = {
                    "fill": "#08121b",
                    "outline": "",
                    "width": 0,
                    "tags": (f"actor:{actor_id}", "main-row-mask"),
                }
                if mask_stipple:
                    rectangle_options["stipple"] = mask_stipple
                canvas.create_rectangle(0, top, width, bottom, **rectangle_options)

            profession_id = int(row.get("profession_id", 0) or 0)
            main_profession_icon = getattr(self.icons, "main_profession", None)
            icon = (
                main_profession_icon(profession_id, icon_logical_size)
                if callable(main_profession_icon)
                else self.icons.profession(profession_id, icon_logical_size)
            )
            canvas.create_image(
                columns["icon"],
                top + (row_height - icon_size) // 2,
                image=icon,
                anchor="nw",
                tags=(f"actor:{actor_id}",),
            )
            row_rating_mode = bool(
                rating_preview or row.get("metric") == "rating"
            )
            inline_rating = str(
                row.get("inline_rating_text", "") or ""
            ).strip()
            rating_is_ai = bool(row.get("is_ai", False))
            if row_rating_mode:
                rating_value = normalize_extraordinary_rating(row.get("rating"))
                inline_rating = (
                    "人机"
                    if rating_is_ai
                    else "--"
                    if rating_value is None
                    else str(rating_value)
                )
            inline_rating_text = (
                f"（{inline_rating}）" if inline_rating else ""
            )
            name_font = self._ui_font("main_text")
            rating_font = self._ui_font("main_number_strong")
            inline_rating_gap = self._main_px(8)
            rating_width = (
                rating_font.measure(inline_rating_text) + inline_rating_gap
                if inline_rating_text
                else 0
            )
            actor_name = self._fit_ui_text(
                row.get("name", "") or "玩家",
                max(self._main_px(24), name_width - rating_width),
                "main_text",
            )
            canvas_outlined_text(
                canvas,
                columns["name"],
                top + row_height // 2,
                text=actor_name,
                fill="#f4f7fb",
                outline="#071019",
                outline_width=max(1, self._main_px(1)),
                anchor="w",
                font=self._ui_font("main_text"),
                tags=(f"actor:{actor_id}",),
            )
            if inline_rating_text:
                canvas_outlined_text(
                    canvas,
                    columns["name"]
                    + name_font.measure(actor_name)
                    + inline_rating_gap,
                    top + row_height // 2,
                    text=inline_rating_text,
                    fill=(
                        "#74d2eb"
                        if rating_is_ai
                        else "#f7cf6d"
                        if inline_rating != "--"
                        else "#b4c0cd"
                    ),
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    anchor="w",
                    font=rating_font,
                    tags=(f"actor:{actor_id}", "main-inline-rating"),
                )

            if row_rating_mode and bool(
                row.get("equipment_profile_ready", False)
            ):
                pvp_count = max(
                    0, int(row.get("pvp_equipment_count", 0) or 0)
                )
                active_words = max(
                    0, int(row.get("active_word_count", 0) or 0)
                )
                total_words = max(
                    0, int(row.get("total_word_count", 0) or 0)
                )
                badge_base_size = 18
                badge_logical_size = badge_base_size * float(
                    getattr(self, "main_ui_scale", 1.0) or 1.0
                )
                badge_size = self._main_px(badge_base_size)
                badge_gap = self._main_px(4)
                value_gap = self._main_px(7)
                value_font = self._ui_font("main_number_strong")
                word_text = f"{active_words}/{total_words}"
                word_right = columns["stat"]
                canvas_outlined_text(
                    canvas,
                    word_right,
                    top + row_height // 2,
                    text=word_text,
                    fill="#ffdd49",
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    anchor="e",
                    font=value_font,
                    tags=(f"actor:{actor_id}", "main-equipment-word-count"),
                )
                word_icon_right = (
                    word_right - value_font.measure(word_text) - badge_gap
                )
                word_icon = self.icons.equipment_badge(
                    "word", badge_logical_size
                )
                canvas.create_image(
                    word_icon_right,
                    top + row_height // 2,
                    image=word_icon,
                    anchor="e",
                    tags=(f"actor:{actor_id}", "main-equipment-word-icon"),
                )
                pvp_text, equipment_is_pvp = equipment_type_badge(pvp_count)
                pvp_right = word_icon_right - badge_size - value_gap
                pvp_font = self._ui_font("main_text")
                pvp_badge_width = pvp_font.measure(pvp_text) + self._main_px(14)
                pvp_badge_height = self._main_px(22)
                pvp_center_y = top + row_height // 2
                canvas_rounded_rectangle(
                    canvas,
                    pvp_right - pvp_badge_width,
                    pvp_center_y - pvp_badge_height / 2,
                    pvp_right,
                    pvp_center_y + pvp_badge_height / 2,
                    self._main_px(7),
                    fill="#43101f" if equipment_is_pvp else "#0a3154",
                    outline="#dd3d63" if equipment_is_pvp else "#2d97e2",
                    width=max(1, self._main_px(1)),
                    tags=(f"actor:{actor_id}", "main-equipment-type-badge"),
                )
                canvas_outlined_text(
                    canvas,
                    pvp_right - self._main_px(7),
                    pvp_center_y,
                    text=pvp_text,
                    fill="#ff91a1" if equipment_is_pvp else "#69caff",
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    anchor="e",
                    font=pvp_font,
                    tags=(
                        f"actor:{actor_id}",
                        "main-equipment-pvp-count",
                        "main-equipment-type-label",
                    ),
                )

            if row_rating_mode:
                pass
            else:
                metric = str(row.get("metric", "dps") or "dps").casefold()
                stat_color = {
                    "hps": "#75e6a1",
                    "dt": "#f1cf68",
                }.get(metric, "#ffffff")
                canvas_outlined_text(
                    canvas,
                    columns["stat"],
                    top + row_height // 2,
                    text=format_main_rate(row.get("stat_value")),
                    fill=stat_color,
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    anchor="e",
                    font=self._ui_font("main_number_strong"),
                    tags=(f"actor:{actor_id}",),
                )
                if "total" in columns:
                    canvas_outlined_text(
                        canvas,
                        columns["total"],
                        top + row_height // 2,
                        text=format_main_total(row.get("total_value")),
                        fill="#c7d0da",
                        outline="#071019",
                        outline_width=max(1, self._main_px(1)),
                        anchor="e",
                        font=self._ui_font("main_number_small"),
                        tags=(f"actor:{actor_id}",),
                    )
            if "deaths" in columns:
                canvas_outlined_text(
                    canvas,
                    columns["deaths"],
                    top + row_height // 2,
                    text=f"☠ {max(0, int(row.get('deaths', 0) or 0))}",
                    fill="#d2d7dd",
                    outline="#071019",
                    outline_width=max(1, self._main_px(1)),
                    anchor="e",
                    font=self._ui_font("main_number_small"),
                    tags=(f"actor:{actor_id}",),
                )

        # Applications float over the list instead of becoming list rows.
        # Their lifetime therefore cannot clear, shift, or scroll the rating /
        # DPS content underneath.  Keep every notice in the queue; the current
        # viewport naturally clips a burst larger than the visible area.
        if draw_content and application_rows:
            for index, row in enumerate(application_rows):
                # Keep the local-player row visible; notices begin over the
                # DPS/rating rows beneath it.
                top = scroll_offset + (index + 1) * row_height
                bottom = top + row_height
                if top >= scroll_offset + height:
                    break
                margin = self._main_px(5)
                canvas_rounded_rectangle(
                    canvas,
                    margin,
                    top + self._main_px(7),
                    width - margin,
                    bottom - self._main_px(7),
                    self._main_px(8),
                    fill="#129750",
                    outline="#66ffa6",
                    width=max(1, self._main_px(1)),
                    tags=("main-team-application-overlay",),
                )
                canvas_outlined_text(
                    canvas,
                    width // 2,
                    top + row_height // 2,
                    text=str(row.get("application_text") or "入队申请"),
                    fill="#f7fffa",
                    outline="#07552d",
                    outline_width=max(1, self._main_px(1)),
                    font=self._ui_font("main_text"),
                    tags=("main-team-application-overlay",),
                )

        if update_scroll_state:
            self._draw_main_scroll_indicator(width, height, content_height)

    def _draw_retired_main_rows_on_canvas(
        self,
        canvas: tk.Canvas,
        *,
        update_scroll_state: bool,
        draw_empty_state: bool = True,
        draw_content: bool = True,
        draw_bars: bool = True,
        opaque_bar_layer: bool = False,
    ) -> None:
        meter_mode = getattr(self, "main_meter_mode", "dps")
        rating_preview = self._team_rating_preview_active()
        healing_mode = meter_mode == "hps"
        taken_mode = meter_mode == "dt"
        boss_mode = meter_mode == "boss"
        if healing_mode:
            healing_duration = getattr(self.model, "healing_duration", None)
            raw_duration = (
                healing_duration()
                if callable(healing_duration)
                else self.model.duration()
            )
        else:
            raw_duration = self.model.duration()
        duration = dps_duration_seconds(raw_duration)
        if rating_preview:
            rows = self._team_rating_preview_rows()
            total = 0
            highest_value = 0
            empty_text = "正在等待队伍资料"
        elif boss_mode:
            boss_summary = self.model.current_boss_damage_summary()
            raw_rows = boss_summary.get("skills", [])
            rows = (
                [row for row in raw_rows if isinstance(row, dict)]
                if isinstance(raw_rows, list)
                else []
            )
            rows.sort(
                key=lambda item: int(item.get("damage", 0) or 0),
                reverse=True,
            )
            total = max(0, int(boss_summary.get("observed_damage", 0) or 0))
            highest_value = max(
                (int(row.get("damage", 0) or 0) for row in rows),
                default=0,
            )
            empty_text = (
                "训练目标不会主动造成伤害"
                if boss_summary.get("unavailable_reason") == "training_dummy"
                else "该场暂未记录首领伤害"
            )
        elif healing_mode:
            healing = getattr(self, "latest_healing_summary", {})
            if not isinstance(healing, dict):
                healing = {}
            rows = [
                row
                for row in healing.get("healers", [])
                if isinstance(row, dict)
                and (
                    int(row.get("effective_healing", 0) or 0) > 0
                    or int(row.get("observed_total_healing", 0) or 0) > 0
                )
            ]
            rows.sort(
                key=lambda item: int(item.get("effective_healing", 0) or 0),
                reverse=True,
            )
            total = sum(int(row.get("effective_healing", 0) or 0) for row in rows)
            highest_value = max(
                (int(row.get("effective_healing", 0) or 0) for row in rows),
                default=0,
            )
            empty_text = "暂无治疗记录"
        elif taken_mode:
            rows = (
                self.model.current_taken_rows()
                if self.model._encounter_started()
                else []
            )
            known_taken = [
                int(row["taken"])
                for row in rows
                if row.get("taken") is not None
            ]
            total = sum(known_taken)
            highest_value = max(known_taken, default=0)
            empty_text = "暂无承伤记录"
        else:
            rows = sorted(
                self.model.current_stats(),
                key=lambda item: item.damage,
                reverse=True,
            )
            total = sum(row.damage for row in rows)
            highest_value = max((row.damage for row in rows), default=0)
            empty_text = "暂无伤害记录"
        columns = self._main_columns(width)
        compact = bool(getattr(self, "compact_mode", False))
        row_height = self._main_row_height()
        icon_size = 20 if compact else 24
        name_x = 31 if compact else 38
        table_font = self._ui_font("table_compact" if compact else "table")
        if not rows:
            if update_scroll_state:
                self.main_scroll_offset = 0
                self.main_scroll_content_height = height
            if draw_empty_state and draw_content:
                canvas.create_text(
                    width // 2,
                    height // 2,
                    text=empty_text,
                    fill=MUTED,
                    font=self._ui_font("strong"),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            canvas.yview_moveto(0.0)
            return
        if not draw_content and not draw_bars:
            content_height = max(height, len(rows) * row_height)
            scroll_offset = min(
                max(0, content_height - height),
                max(0, int(getattr(self, "main_scroll_offset", 0))),
            )
            if update_scroll_state:
                self.main_scroll_content_height = content_height
                self.main_scroll_offset = scroll_offset
            canvas.configure(
                yscrollincrement=1,
                scrollregion=(0, 0, width, content_height),
            )
            canvas.yview_moveto(scroll_offset / max(1, content_height))
            if update_scroll_state:
                self._draw_main_scroll_indicator(width, height, content_height)
            return
        for index, row in enumerate(rows):
            top = index * row_height
            bottom = top + row_height
            if rating_preview:
                actor_id = int(row.get("actor_id", 0) or 0)
                primary_value = 0
                class_id = int(row.get("profession_id", 0) or 0)
                if not class_id:
                    class_id = self.model.actor_profession_id(actor_id)
            elif boss_mode:
                actor_id = int(row.get("skill_id", 0) or 0)
                primary_value = int(row.get("damage", 0) or 0)
                class_id = 0
            elif healing_mode:
                actor_id = int(row.get("actor_id", 0) or 0)
                primary_value = int(row.get("effective_healing", 0) or 0)
                class_id = int(row.get("profession_id", 0) or 0)
                if not class_id:
                    class_id = self.model.actor_profession_id(actor_id)
            elif taken_mode:
                actor_id = int(row.get("actor_id", 0) or 0)
                primary_value = int(row.get("taken", 0) or 0)
                class_id = self.model.actor_profession_id(actor_id)
            else:
                actor_id = row.actor_id
                primary_value = row.damage
                class_id = self.model.actor_profession_id(actor_id)
            share = (
                row.get("share")
                if taken_mode or boss_mode
                else primary_value / total if total else 0.0
            )
            bar_ratio = relative_damage_bar_ratio(primary_value, highest_value)
            _profession, color = self._profession_info(class_id)
            if boss_mode:
                color = "#e67d72"
            tag = (
                f"boss-skill:{actor_id}:{index}"
                if boss_mode
                else f"actor:{actor_id}"
            )
            if draw_bars and not rating_preview:
                bar = (
                    color
                    if opaque_bar_layer
                    else blend_color(BG, color, DPS_BAR_COLOR_STRENGTH)
                )
                canvas.create_rectangle(
                    0,
                    top,
                    max(5, int((width - 12) * bar_ratio)),
                    bottom,
                    fill=bar,
                    outline="",
                    tags=(tag,),
                )
            if not draw_content:
                continue
            icon = (
                self.icons.skill(
                    actor_id,
                    str(row.get("name", "") or "首领技能"),
                    0,
                    icon_size,
                )
                if boss_mode
                else self.icons.profession(class_id, icon_size)
            )
            canvas.create_image(
                5 if compact else 6,
                top + (row_height - icon_size) // 2,
                image=icon,
                anchor="nw",
                tags=(tag,),
            )
            rating_layout = None
            rating = self._main_extraordinary_rating(actor_id, row)
            rating_identity_label = (
                "人机" if self._main_actor_is_ai(actor_id, row) else ""
            )
            if (
                not boss_mode
                and not bool(getattr(self, "hide_names", False))
                and self._main_extraordinary_rating_visible(
                    rating_preview=rating_preview
                )
            ):
                rating_layout = self._main_rating_badge_layout(
                    name_x=name_x,
                    name_limit=columns["name_limit"],
                    top=top,
                    row_height=row_height,
                    compact=compact,
                    identity_label=rating_identity_label,
                )
            name_width = (
                int(rating_layout["name_width"])
                if rating_layout is not None
                else max(24, columns["name_limit"] - name_x - 6)
            )
            if boss_mode:
                actor_name_value = str(row.get("name", "")).strip() or "未命名技能"
            elif rating_preview:
                actor_name_value = (
                    row.get("anonymous_name", "")
                    if bool(getattr(self, "hide_names", False))
                    else row.get("display_name", "")
                    or row.get("anonymous_name", "")
                )
            else:
                actor_name_value = self._shown_actor_name(actor_id)
            actor_name = self._fit_main_actor_name(actor_name_value, name_width)
            if rating_layout is not None:
                rating_layout = self._main_rating_badge_layout(
                    name_x=name_x,
                    name_limit=columns["name_limit"],
                    top=top,
                    row_height=row_height,
                    compact=compact,
                    identity_label=rating_identity_label,
                    displayed_name_width=table_font.measure(actor_name),
                )
            canvas.create_text(
                name_x,
                top + row_height // 2,
                text=actor_name,
                fill=color,
                anchor="w",
                font=table_font,
                tags=(tag,),
            )
            if rating_layout is not None:
                self._draw_main_rating_badge(
                    canvas,
                    rating=rating,
                    layout=rating_layout,
                    actor_tag=tag,
                    identity_label=rating_identity_label,
                )
            if rating_preview:
                continue
            if boss_mode:
                values = {
                    "boss_damage": format_number(primary_value),
                    "boss_share": f"{float(share or 0.0) * 100:.1f}%",
                    "boss_hits": str(max(0, int(row.get("hits", 0) or 0))),
                    "boss_max_hit": format_number(
                        max(0, int(row.get("max_hit", 0) or 0))
                    ),
                }
                for key in (
                    "boss_damage",
                    "boss_share",
                    "boss_hits",
                    "boss_max_hit",
                ):
                    if key not in columns:
                        continue
                    canvas.create_text(
                        columns[key],
                        top + row_height // 2,
                        text=values[key],
                        fill=TEXT,
                        anchor="e",
                        font=table_font,
                        tags=(tag,),
                    )
            elif healing_mode:
                overheal_rate = row.get("overheal_rate")
                values = {
                    "effective": format_number(primary_value),
                    "hps": format_number(row.get("hps", 0)),
                    "overheal": format_overheal_rate(
                        overheal_rate,
                        partial=bool(row.get("overheal_rate_partial")),
                    ),
                }
                for key in ("effective", "hps", "overheal"):
                    if key not in columns:
                        continue
                    canvas.create_text(
                        columns[key],
                        top + row_height // 2,
                        text=values[key],
                        fill=TEXT,
                        anchor="e",
                        font=table_font,
                        tags=(tag,),
                    )
            elif taken_mode:
                taken = row.get("taken")
                values = {
                    "taken": format_number(taken or 0),
                    "taken_share": (
                        f"{float(share or 0.0) * 100:.1f}%"
                    ),
                }
                for key in ("taken", "taken_share"):
                    if key not in columns:
                        continue
                    canvas.create_text(
                        columns[key],
                        top + row_height // 2,
                        text=values[key],
                        fill=TEXT,
                        anchor="e",
                        font=table_font,
                        tags=(tag,),
                    )
            else:
                critical_text = self._actor_critical_text(row)
                penetration_text = self._actor_penetration_text(row)
                values = {
                    "damage": format_number(row.damage),
                    "dps": format_number(
                        row.damage / duration if duration else 0
                    ),
                    "share": f"{share * 100:.1f}%",
                    "critical": critical_text,
                    "penetration": penetration_text,
                    "deaths": str(
                        getattr(self.model, "member_death_counts", {}).get(
                            actor_id, 0
                        )
                    ),
                    "revives": str(
                        getattr(self.model, "member_revive_counts", {}).get(
                            actor_id, 0
                        )
                    ),
                    "death_time": format_duration(
                        self.model.member_death_duration(actor_id)
                        if callable(
                            getattr(self.model, "member_death_duration", None)
                        )
                        else 0.0
                    ),
                }
                for key in (
                    "damage",
                    "dps",
                    "share",
                    "critical",
                    "penetration",
                    "deaths",
                    "revives",
                    "death_time",
                ):
                    if key not in columns:
                        continue
                    canvas.create_text(
                        columns[key],
                        top + row_height // 2,
                        text=values[key],
                        fill=TEXT,
                        anchor="e",
                        font=table_font,
                        tags=(tag,),
                    )
        content_height = max(height, len(rows) * row_height)
        scroll_offset = min(
            max(0, content_height - height),
            max(0, int(getattr(self, "main_scroll_offset", 0))),
        )
        if update_scroll_state:
            self.main_scroll_content_height = content_height
            self.main_scroll_offset = scroll_offset
        canvas.configure(
            yscrollincrement=1,
            scrollregion=(0, 0, width, content_height),
        )
        canvas.yview_moveto(scroll_offset / max(1, content_height))
        if update_scroll_state:
            self._draw_main_scroll_indicator(width, height, content_height)

    def _drag_start(self, event, window: tk.Misc) -> None:
        if window is self.root and (
            self.window_locked or self._startup_interaction_blocked()
        ):
            return
        if id(window) in self.restore_geometry:
            return
        self._flush_window_geometry(window)
        key = id(window)
        self.drag_state[key] = (
            event.x_root - window.winfo_x(),
            event.y_root - window.winfo_y(),
        )
        drag_press_origins = getattr(self, "drag_press_origins", None)
        if not isinstance(drag_press_origins, dict):
            drag_press_origins = self.drag_press_origins = {}
        drag_press_origins[key] = (
            int(event.x_root),
            int(event.y_root),
        )

    def _drag_move(self, event, window: tk.Misc) -> None:
        if window is self.root and (
            self.window_locked or self._startup_interaction_blocked()
        ):
            return
        key = id(window)
        offset = self.drag_state.get(key)
        if offset is None or key in self.restore_geometry:
            return
        press_origin = getattr(self, "drag_press_origins", {}).get(key)
        if press_origin is not None:
            delta_x = int(event.x_root) - press_origin[0]
            delta_y = int(event.y_root) - press_origin[1]
            if (
                delta_x * delta_x + delta_y * delta_y
                < LAYERED_MAIN_DRAG_THRESHOLD * LAYERED_MAIN_DRAG_THRESHOLD
            ):
                return
            self.drag_press_origins.pop(key, None)
        x = event.x_root - offset[0]
        y = event.y_root - offset[1]
        try:
            # Keep drag handling entirely inside Tk.  Calling the native
            # synchronous move loop from a Tk callback is fatal on Python
            # 3.14 because Windows re-enters Tk while ctypes has released the
            # interpreter state.  Position-only geometry updates are both
            # safe and immediate; resize events continue to be coalesced.
            window.geometry(format_absolute_tk_position(x, y))
        except tk.TclError:
            self.drag_state.pop(key, None)
            getattr(self, "drag_press_origins", {}).pop(key, None)

    def _drag_end(self, _event, window: tk.Misc) -> None:
        key = id(window)
        was_dragging = self.drag_state.pop(key, None) is not None
        getattr(self, "drag_press_origins", {}).pop(key, None)
        if not was_dragging:
            return
        if window is self.root:
            self._remember_root_geometry()

    def _resize_start(self, event, window: tk.Misc) -> None:
        if window is self.root and (
            self.window_locked or self._startup_interaction_blocked()
        ):
            return
        self._flush_window_geometry(window)
        key = id(window)
        restore_geometry = getattr(self, "restore_geometry", {})
        if key in restore_geometry:
            # A size grip is an explicit request to leave maximized mode.  Use
            # the saved normal geometry as the resize origin so motion is not
            # ignored and cannot jump from the full work-area dimensions.
            try:
                window.geometry(restore_geometry.pop(key))
                window.update_idletasks()
            except (AttributeError, tk.TclError):
                restore_geometry.pop(key, None)
            button = self._maximize_button_for(window)
            if button is not None:
                if hasattr(button, "_icon_name"):
                    self._set_titlebar_icon(button, "maximize")
                else:
                    button.configure(text="□")
        self.resize_state[key] = (
            event.x_root,
            event.y_root,
            window.winfo_width(),
            window.winfo_height(),
        )

    def _resize_move(self, event, window: tk.Misc, minimum_width: int, minimum_height: int) -> None:
        if window is self.root and (
            self.window_locked or self._startup_interaction_blocked()
        ):
            return
        state = self.resize_state.get(id(window))
        if not state or id(window) in self.restore_geometry:
            return
        x, y, width, height = state
        self._schedule_window_geometry(
            window,
            f"{max(minimum_width, width + event.x_root - x)}x"
            f"{max(minimum_height, height + event.y_root - y)}",
        )

    def _resize_end(self, _event, window: tk.Misc) -> None:
        key = id(window)
        was_resizing = self.resize_state.pop(key, None) is not None
        # Apply the final coalesced geometry immediately.  Leaving a scheduled
        # resize alive lets it overwrite a later maximize click, which made
        # both the top-right button and bottom-right grip appear unreliable.
        self._flush_window_geometry(window)
        if (
            was_resizing
            and window is self.root
            and key not in getattr(self, "restore_geometry", {})
        ):
            self._remember_root_geometry()

    def _schedule_window_geometry(self, window: tk.Misc, geometry: str) -> None:
        key = id(window)
        self.pending_window_geometry[key] = (window, geometry)
        if key in self.window_geometry_after_ids:
            return

        def apply_latest() -> None:
            self.window_geometry_after_ids.pop(key, None)
            pending = self.pending_window_geometry.pop(key, None)
            if pending is None:
                return
            target, value = pending
            try:
                if target.winfo_exists():
                    target.geometry(value)
            except tk.TclError:
                return

        self.window_geometry_after_ids[key] = self.root.after(16, apply_latest)

    def _flush_window_geometry(self, window: tk.Misc) -> None:
        key = id(window)
        after_id = self.window_geometry_after_ids.pop(key, None)
        if after_id is not None:
            try:
                self.root.after_cancel(after_id)
            except tk.TclError:
                pass
        pending = self.pending_window_geometry.pop(key, None)
        if pending is None:
            return
        target, value = pending
        try:
            if target.winfo_exists():
                target.geometry(value)
        except tk.TclError:
            return

    def _work_area(self, window: tk.Misc) -> tuple[int, int, int, int]:
        if sys.platform == "win32":
            try:
                import ctypes
                from ctypes import wintypes

                class MonitorInfo(ctypes.Structure):
                    _fields_ = [
                        ("cbSize", wintypes.DWORD),
                        ("rcMonitor", wintypes.RECT),
                        ("rcWork", wintypes.RECT),
                        ("dwFlags", wintypes.DWORD),
                    ]

                # ctypes caches functions accessed through ``windll.user32``.
                # Other monitor helpers bind GetMonitorInfoW to their own local
                # MonitorInfo class, so reusing that cached function makes this
                # (equivalent but distinct) structure fail its pointer check.
                monitor_api = ctypes.WinDLL("user32", use_last_error=True)
                monitor_api.MonitorFromWindow.argtypes = (
                    wintypes.HWND,
                    wintypes.DWORD,
                )
                monitor_api.MonitorFromWindow.restype = wintypes.HMONITOR
                monitor_api.GetMonitorInfoW.argtypes = (
                    wintypes.HMONITOR,
                    ctypes.POINTER(MonitorInfo),
                )
                monitor_api.GetMonitorInfoW.restype = wintypes.BOOL

                info = MonitorInfo()
                info.cbSize = ctypes.sizeof(info)
                monitor = monitor_api.MonitorFromWindow(window.winfo_id(), 2)
                if monitor and monitor_api.GetMonitorInfoW(
                    monitor, ctypes.byref(info)
                ):
                    work = info.rcWork
                    return work.left, work.top, work.right - work.left, work.bottom - work.top
            except (AttributeError, OSError, TypeError, ValueError, ctypes.ArgumentError):
                pass
        return 0, 0, window.winfo_screenwidth(), window.winfo_screenheight()

    def _maximize_button_for(self, window: tk.Misc):
        if window is self.root:
            return getattr(self, "max_button", None)
        if window is getattr(self, "history_window", None):
            return getattr(self, "history_max_button", None)
        return getattr(self, "skill_max_button", None)

    def _toggle_maximize(self, window: tk.Misc) -> None:
        if window is self.root and self.window_locked:
            return
        if window in {
            getattr(self, "login_window", None),
            getattr(self, "user_notice_window", None),
        }:
            return
        self._resize_end(None, window)
        key = id(window)
        button = self._maximize_button_for(window)
        if key in self.restore_geometry:
            window.geometry(self.restore_geometry.pop(key))
            if button is not None:
                if hasattr(button, "_icon_name"):
                    self._set_titlebar_icon(button, "maximize")
                else:
                    button.configure(text="□")
            return
        self.restore_geometry[key] = window.geometry()
        x, y, width, height = self._work_area(window)
        window.geometry(f"{width}x{height}+{x}+{y}")
        if button is not None:
            if hasattr(button, "_icon_name"):
                self._set_titlebar_icon(button, "restore")
            else:
                button.configure(text="❐")

    def minimize(self) -> None:
        if self.closing:
            return
        self._remember_root_geometry()
        self.tray_skill_hidden = bool(
            self.skill_window is not None
            and self.skill_window.winfo_exists()
            and self.skill_window.state() == "normal"
        )
        self.tray_history_hidden = bool(
            self.history_window is not None
            and self.history_window.winfo_exists()
            and self.history_window.state() == "normal"
        )
        self.tray_feedback_hidden = bool(
            self.feedback_window is not None
            and self.feedback_window.winfo_exists()
            and self.feedback_window.state() == "normal"
        )
        if self.tray_skill_hidden:
            self.skill_window.withdraw()
        if self.tray_history_hidden:
            self.history_window.withdraw()
        if self.tray_feedback_hidden:
            self.feedback_window.withdraw()
        self._destroy_unlock_window()
        if (
            self.main_content_overlay_window is not None
            and self.main_content_overlay_window.winfo_exists()
        ):
            self.main_content_overlay_window.withdraw()
        self.main_window_intentionally_hidden = True
        self.root.withdraw()
        save_config(self.config)

    def _application_window_is_visible(self) -> bool:
        for window in (
            self.root,
            self.skill_window,
            self.history_window,
            self.feedback_window,
        ):
            if window is None or not window.winfo_exists():
                continue
            try:
                if window.state() in {"normal", "zoomed"}:
                    return True
            except tk.TclError:
                continue
        return False

    def toggle_application_visibility(self) -> None:
        if self.closing:
            return
        if self.login_window is not None and self.login_window.winfo_exists():
            try:
                login_visible = self.login_window.state() in {"normal", "zoomed"}
            except tk.TclError:
                login_visible = False
            if login_visible:
                self._minimize_login_window()
            else:
                self.show_from_tray()
            return
        if self._application_window_is_visible():
            self.minimize()
        else:
            self.show_from_tray()

    def show_from_tray(self) -> None:
        if self.closing:
            return
        if self.login_window is not None and self.login_window.winfo_exists():
            login_width, login_height = login_window_dimensions(
                get_window_dpi(self.login_window), self.process_is_elevated
            )
            self.login_window.geometry(
                self._visible_geometry(
                    self.login_window.geometry(), login_width, login_height
                )
            )
            self.login_window.attributes("-topmost", False)
            self.login_window.deiconify()
            self.login_window.update_idletasks()
            self._fit_login_window()
            self._sync_login_window_taskbar(
                self.login_window,
                no_activate=False,
            )
            self._prepare_toplevel_dpi(self.login_window)
            self.login_window.lift()
            self.login_window.focus_force()
            return
        self.root.geometry(
            self._visible_geometry(
                self.root.geometry(),
                max(self._main_minimum_width(), self._main_px(MAIN_DEFAULT_WIDTH)),
                max(MAIN_MIN_HEIGHT, self._main_px(MAIN_DEFAULT_HEIGHT)),
            )
        )
        self.root.overrideredirect(True)
        self.main_window_intentionally_hidden = False
        self.root.deiconify()
        self.root.update_idletasks()
        self._apply_window_dpi_if_changed(force=True)
        self.root.lift()
        if not self.window_locked:
            self.root.focus_force()
        self._apply_windows_style(self.root)
        self._apply_main_transparency()
        self.root.after(20, self._apply_window_lock_state)
        if (
            self.tray_skill_hidden
            and self.skill_window is not None
            and self.skill_window.winfo_exists()
        ):
            self.skill_window.geometry(
                self._visible_geometry(self.skill_window.geometry(), 560, 360)
            )
            self.skill_window.deiconify()
            self.skill_window.update_idletasks()
            self._prepare_toplevel_dpi(self.skill_window)
            self.skill_window.lift()
        if (
            self.tray_history_hidden
            and self.history_window is not None
            and self.history_window.winfo_exists()
        ):
            self.history_window.geometry(
                self._visible_geometry(
                    self.history_window.geometry(), BACKEND_WIDTH, BACKEND_HEIGHT
                )
            )
            self.history_window.deiconify()
            self.history_window.update_idletasks()
            self._prepare_toplevel_dpi(self.history_window)
            self.history_window.lift()
            self._sync_backend_window_topmost()
        if (
            self.tray_feedback_hidden
            and self.feedback_window is not None
            and self.feedback_window.winfo_exists()
        ):
            feedback_width, feedback_height = self._feedback_window_dimensions()
            self.feedback_window.geometry(
                self._visible_geometry(
                    self.feedback_window.geometry(),
                    feedback_width,
                    feedback_height,
                )
            )
            self.feedback_window.deiconify()
            self.feedback_window.update_idletasks()
            self._prepare_toplevel_dpi(self.feedback_window)
            self.feedback_window.lift()
        self.tray_skill_hidden = False
        self.tray_history_hidden = False
        self.tray_feedback_hidden = False

    def restore_window_from_tray(self) -> None:
        """Restore a reachable, unlocked main window without clearing user data."""

        if self.closing:
            return
        self._flush_window_geometry(self.root)
        self.drag_state.pop(id(self.root), None)
        self.resize_state.pop(id(self.root), None)
        self.restore_geometry.pop(id(self.root), None)
        self._destroy_unlock_window()

        self.window_locked = False
        self.compact_mode = False
        self.config["window_locked"] = False
        self.config["compact_mode"] = False
        self._apply_layout_mode()

        width = max(
            self._main_minimum_width(), self._main_px(MAIN_DEFAULT_WIDTH)
        )
        height = max(MAIN_MIN_HEIGHT, self._main_px(MAIN_DEFAULT_HEIGHT))
        geometry = format_absolute_tk_geometry(width, height, 32, 120)
        self.root.minsize(self._main_minimum_width(), MAIN_MIN_HEIGHT)
        self.root.geometry(geometry)
        self.config["geometry"] = geometry
        if float(getattr(self, "window_alpha", 1.0) or 0.0) <= 0.0:
            self.window_alpha = 1.0
            self.config["alpha"] = 1.0
            opacity_variable = getattr(self, "settings_opacity_var", None)
            if opacity_variable is not None:
                try:
                    opacity_variable.set(100)
                except tk.TclError:
                    pass
            opacity_label = getattr(self, "opacity_value_label", None)
            if opacity_label is not None and opacity_label.winfo_exists():
                opacity_label.configure(text="100%")

        login_window = self.login_window
        if login_window is not None and login_window.winfo_exists():
            login_width, login_height = login_window_dimensions(
                get_window_dpi(login_window), self.process_is_elevated
            )
            login_x = max(
                0, (self.root.winfo_screenwidth() - login_width) // 2
            )
            login_y = max(
                0, (self.root.winfo_screenheight() - login_height) // 2
            )
            login_window.geometry(
                format_absolute_tk_geometry(
                    login_width,
                    login_height,
                    login_x,
                    login_y,
                )
            )

        save_config(self.config)
        self.show_from_tray()

    def _restore_borderless(self) -> None:
        if self.closing:
            return
        if self.root.state() == "normal":
            self.root.overrideredirect(True)
            self._apply_windows_style(self.root)
            self._apply_main_transparency()
            self.root.lift()
        else:
            self.root.after(120, self._restore_borderless)

    @staticmethod
    def _apply_windows_style(window: tk.Misc) -> None:
        if sys.platform != "win32":
            return
        try:
            import ctypes

            window.update_idletasks()
            hwnd = DpsWindow._win32_root_handle(window)
            if not hwnd:
                return
            style = DpsWindow._win32_extended_style(hwnd)
            if style is not None:
                overlay_style = window_exstyle_for_overlay(style)
                if overlay_style != style:
                    DpsWindow._set_win32_extended_style(hwnd, overlay_style)

            # A transparent HUD must not inherit Windows 11's ordinary app
            # rounding or drop shadow. Those effects expose the rectangular
            # backing surface most clearly over a white desktop.
            no_non_client = ctypes.c_int(1)  # DWMNCRP_DISABLED
            no_rounding = ctypes.c_int(1)  # DWMWCP_DONOTROUND
            ctypes.windll.dwmapi.DwmSetWindowAttribute(
                hwnd,
                2,
                ctypes.byref(no_non_client),
                ctypes.sizeof(no_non_client),
            )
            ctypes.windll.dwmapi.DwmSetWindowAttribute(
                hwnd,
                33,
                ctypes.byref(no_rounding),
                ctypes.sizeof(no_rounding),
            )
        except (AttributeError, OSError, tk.TclError):
            pass

    def _apply_main_transparency(self) -> None:
        if self.closing or not self.root.winfo_exists():
            return
        self.window_alpha = 1.0
        if isinstance(getattr(self, 'config', None), dict):
            self.config['alpha'] = 1.0
        if self._layered_main_active():
            try:
                self.root.update_idletasks()
                if bool(getattr(self, "window_locked", False)):
                    self._set_window_click_through(self.root, True)
            except tk.TclError:
                return
            # SourceConstantAlpha is applied by UpdateLayeredWindow; using
            # Tk's -alpha or -transparentcolor here would switch the HWND back
            # to SetLayeredWindowAttributes and reintroduce fringe artifacts.
            self._schedule_layered_main_render()
            return
        try:
            self.root.update_idletasks()
            self.root.configure(bg=MAIN_TRANSPARENT_KEY)
            if sys.platform == "win32":
                try:
                    self.root.attributes("-transparentcolor", MAIN_TRANSPARENT_KEY)
                except tk.TclError:
                    # Some Tk test doubles and older Windows Tk builds expose
                    # alpha but not the color-key option. Alpha still applies.
                    pass
            # A withdrawn root is still backed by an HWND. Keep that bootstrap
            # surface opaque; applying the configured alpha before the first
            # map can make DWM cache it at the wrong DPI and soften all text.
            try:
                root_is_visible = self.root.state() == "normal"
            except (AttributeError, tk.TclError):
                # Lightweight test doubles and older Tk builds may not expose
                # ``state``; those roots are treated as visible.
                root_is_visible = True
            if root_is_visible:
                self.root.attributes("-alpha", self.window_alpha)
            else:
                self.root.attributes("-alpha", 1.0)
            if bool(getattr(self, "window_locked", False)):
                self._set_window_click_through(self.root, True)
        except tk.TclError:
            pass
        self._schedule_main_content_overlay_sync()

    def _ensure_backend_window_opaque(self) -> None:
        """Keep History and Settings independent from the main alpha."""

        window = getattr(self, "history_window", None)
        try:
            exists = window is not None and window.winfo_exists()
        except (AttributeError, tk.TclError):
            exists = False
        if not exists:
            return
        try:
            window.attributes("-alpha", 1.0)
        except tk.TclError:
            pass

    def _reassert_main_transparency_after_lock(self, locked: bool) -> None:
        """Restore alpha after Windows has finished changing lock styles."""

        if (
            self.closing
            or bool(getattr(self, "window_locked", False)) != bool(locked)
            or not self.root.winfo_exists()
        ):
            return
        self.window_alpha = 1.0
        if self._layered_main_active():
            if locked:
                self._set_window_click_through(self.root, True)
            self._schedule_layered_main_render()
            return
        try:
            if self.root.state() != "normal":
                return
            self.root.attributes("-alpha", self.window_alpha)
            if locked:
                self._set_window_click_through(self.root, True)
        except (AttributeError, tk.TclError):
            return
        self._schedule_main_content_overlay_sync(restart=True)

    def _reset_for_capture_session_change(self, timestamp_ns=None) -> None:
        """Drop every role-scoped value before accepting a new stream."""
        pvp_recording = getattr(self, "pvp_recording", None)
        if pvp_recording is not None:
            finalized = pvp_recording.reset_context(
                timestamp_ns,
                reason="capture_session_changed",
            )
            if finalized is not None:
                pvp_uploader = getattr(self, "pvp_upload_worker", None)
                if pvp_uploader is not None:
                    pvp_uploader.wake()
            self.pvp_tracker = pvp_recording.current
            self.pvp_hud_state = pvp_recording.snapshot()
        else:
            tracker = getattr(self, "pvp_tracker", None)
            if tracker is not None:
                tracker.reset()
                self.pvp_hud_state = tracker.snapshot()
        controller = getattr(self, "settlement_ui", None)
        if controller is not None:
            controller.reset_capture_session(timestamp_ns)
            adapter = getattr(self, "settlement_history_adapter", None)
            if adapter is not None:
                try:
                    self._sync_settlement_history_for_upload(
                        adapter, controller.tracker
                    )
                except (ValueError, OSError, TypeError):
                    pass

        model = self.model
        model.reset(
            keep_identity=False,
            keep_monsters=False,
            archive_reason="capture_session_changed",
        )
        model.entity_names.clear()
        model.entity_professions.clear()
        model.entity_extraordinary_ratings.clear()
        model.entity_ai_states.clear()
        for mapping_name in (
            "entity_fight_attributes",
            "entity_fight_attribute_times",
        ):
            mapping = getattr(model, mapping_name, None)
            if isinstance(mapping, dict):
                mapping.clear()
        model.local_player_name = ""
        model.scene_id = None
        model.current_dungeon_id = 0
        model.current_map_id = 0
        model.current_in_dungeon = None
        model.current_dungeon_stage_id = 0
        model.current_dungeon_stage_phase = 0
        model.current_dungeon_context_filetime = 0
        model.current_dungeon_context_source = ""
        model.current_brass_tome_status = "unknown"
        model.current_brass_tome_challenge_ids = []
        model.current_brass_tome_source = ""
        model.encounter_dungeon_id = 0
        model.encounter_map_id = 0
        model.encounter_dungeon_stage_id = 0
        model.encounter_dungeon_stage_phase = 0
        model.encounter_dungeon_context_filetime = 0
        model.encounter_dungeon_context_source = ""
        model.encounter_brass_tome_status = "unknown"
        model.encounter_brass_tome_challenge_ids = []
        model.encounter_brass_tome_source = ""
        model.closed_encounter_target_ids.clear()
        model.awaiting_post_exit_context = False

        self.current_character_id = ""
        self.current_character_name = ""
        self.current_character_profession_id = 0
        self.startup_identity_pending = True
        self.startup_capture_pending = True
        self.capture_transport_resyncing = False
        self.startup_wait_reason = "starting"
        self.startup_wait_started_at = time.monotonic()
        self.upload_profile = None
        self.profile_resolved_character_id = ""
        self.profile_resolve_in_progress = False
        self.pending_clock_records.clear()
        self.main_last_battle_result = None
        self.main_last_live_display_snapshot = None
        self.live_hud_combat_state = None
        self.live_hud_boss_state = None
        self.live_hud_dps_segment = None
        self.main_manual_clear_state = None
        self.main_cleared_encounter_ids = deque(maxlen=64)
        self.main_hidden_combat_encounter_id = ""
        self.main_recent_battle_scope_started_ns = 0
        self.main_recent_battle_expanded = True
        self.team_application_notices = deque()
        self._clear_team_equipment_profiles()
        self.main_scroll_offset = 0
        self.main_time_text = "00:00"
        self.team_dps_text = "0"
        self.latest_healing_summary = {
            "team_hps": 0.0,
            "team_effective_healing": 0,
            "healers": [],
        }
        self.enrage_prediction = None
        self.enrage_prediction_visible = False
        self._flush_combat_history(force=True)
        self._schedule_layered_main_render()

    def _identity_session_change_is_proven(self, payload: object) -> bool:
        """Require a different role token before dropping live PvE state."""

        if not isinstance(payload, dict):
            return False
        next_token = str(payload.get("user_token", "") or "").strip()
        if not next_token:
            return False
        current_token = str(
            getattr(self, "current_character_id", "") or ""
        ).strip()
        if current_token:
            return next_token != current_token
        previous_token = str(
            payload.get("previous_user_token", "") or ""
        ).strip()
        return bool(previous_token and previous_token != next_token)

    def _refresh_pvp_history_after_change(self) -> None:
        self.pvp_history_refresh_after_id = None
        window = getattr(self, "history_window", None)
        if (
            getattr(self, "backend_current_page", "history") == "kings"
            and window is not None
            and window.winfo_exists()
            and window.state() == "normal"
        ):
            self.history_loaded_record = None
            self._query_history_records()

    def _dispatch_message(self, kind: str, payload: object) -> None:
        if kind == "pvp_backend_response":
            if isinstance(payload, dict):
                page = getattr(self, "backend_pages", {}).get(payload.get("page"))
                if isinstance(page, (PvpHistoryPage, PvpAlliancePage)):
                    page.receive(payload)
            return
        if kind == "pvp_history_changed":
            page = getattr(self, "pvp_history_page", None)
            if page is not None and page.principal() == page.account_key:
                page.reload_local()
            window = getattr(self, "history_window", None)
            if (
                getattr(self, "backend_current_page", "history") == "kings"
                and window is not None
                and window.winfo_exists()
                and window.state() == "normal"
                and getattr(self, "pvp_history_refresh_after_id", None) is None
            ):
                self.pvp_history_refresh_after_id = window.after(
                    250, self._refresh_pvp_history_after_change
                )
            return
        if kind == "pvp_matchups_result":
            self._handle_pvp_matchups_result(payload)
            return
        if kind == "live_hud_combat":
            next_state = dict(payload) if isinstance(payload, dict) else {}
            previous_state = getattr(self, "live_hud_combat_state", None)
            entering_combat = bool(
                next_state.get("active")
                and not (
                    isinstance(previous_state, dict)
                    and previous_state.get("active")
                )
                and not next_state.get("resumed")
            )
            if next_state.get("active"):
                self.live_hud_combat_state = next_state
                if (
                    entering_combat
                    and str(getattr(self, "main_combat_mode", "pve")).casefold()
                    == "pve"
                ):
                    self._set_pve_hud_view("recent_battle")
                if self._main_live_hud_boss_state() is None:
                    self._begin_live_hud_dps_segment(
                        kind="small_monsters",
                        segment_key=next_state.get("segment_id", 0),
                        started_at_epoch=next_state.get("started_at_epoch", 0.0),
                        active_at_epoch=next_state.get(
                            "resumed_at_epoch",
                            next_state.get("started_at_epoch", 0.0),
                        ),
                    )
            else:
                self.live_hud_combat_state = None
                self._end_live_hud_dps_segment(
                    next_state.get("ended_at_epoch", 0.0)
                )
            self._schedule_layered_main_render()
            return
        if kind == "live_hud_boss":
            previous_state = getattr(self, "live_hud_boss_state", None)
            terminal_state = (
                dict(payload)
                if isinstance(payload, dict) and payload.get("terminal_zero")
                else None
            )
            next_state = (
                dict(payload)
                if isinstance(payload, dict) and payload.get("active")
                else None
            )
            self.live_hud_boss_state = next_state or terminal_state
            if next_state is not None:
                previous_key = (
                    int(previous_state.get("entity_id", 0) or 0),
                    float(previous_state.get("started_at_epoch", 0.0) or 0.0),
                ) if isinstance(previous_state, dict) else (0, 0.0)
                next_key = (
                    int(next_state.get("entity_id", 0) or 0),
                    float(next_state.get("started_at_epoch", 0.0) or 0.0),
                )
                if next_key != previous_key:
                    self._begin_live_hud_dps_segment(
                        kind="boss",
                        segment_key=next_key[0],
                        started_at_epoch=next_key[1],
                    )
            elif isinstance(
                getattr(self, "live_hud_dps_segment", None), dict
            ) and self.live_hud_dps_segment.get("kind") == "boss":
                ended_at = (
                    payload.get("ended_at_epoch", 0.0)
                    if isinstance(payload, dict)
                    else 0.0
                )
                self._end_live_hud_dps_segment(ended_at)
            self._schedule_layered_main_render()
            return
        pvp_recording = getattr(self, "pvp_recording", None)
        tracker = getattr(self, "pvp_tracker", None)
        if kind in {"profile", "name", "identity", "self_character", "party"}:
            if pvp_recording is not None:
                previous_match_id = (getattr(pvp_recording, "recording", None) or {}).get("match_id")
                finalized = pvp_recording.ingest_update(kind, payload)
                self._show_hunter_match_on_entry(previous_match_id)
                if finalized is not None:
                    self._dispatch_message("pvp_history_changed", None)
                    pvp_uploader = getattr(self, "pvp_upload_worker", None)
                    if pvp_uploader is not None:
                        pvp_uploader.wake()
                self.pvp_tracker = pvp_recording.current
                tracker = pvp_recording.display_tracker
                if self.main_combat_mode == "pvp":
                    self._schedule_layered_main_render()
            elif tracker is not None:
                if tracker.ingest_update(kind, payload) and self.main_combat_mode == "pvp":
                    self._schedule_layered_main_render()
        if kind == "scene" and pvp_recording is not None:
            previous_match_id = (getattr(pvp_recording, "recording", None) or {}).get("match_id")
            finalized = pvp_recording.ingest_scene(payload)
            self._show_hunter_match_on_entry(previous_match_id)
            if finalized is not None:
                self._dispatch_message("pvp_history_changed", None)
                pvp_uploader = getattr(self, "pvp_upload_worker", None)
                if pvp_uploader is not None:
                    pvp_uploader.wake()
            tracker = pvp_recording.display_tracker
            if self.main_combat_mode == "pvp":
                self._schedule_layered_main_render()
        if kind == 'settlement_capture_gap':
            controller = getattr(self, 'settlement_ui', None)
            if controller is not None:
                controller.mark_gap()
            if tracker is not None:
                tracker.mark_gap()
        elif kind == 'pvp_observation':
            self._handle_pvp_observation(payload)
        elif kind == 'settlement_observation':
            self._handle_settlement_observation(payload)
        elif kind == 'settlement_experiment_record':
            experiment = getattr(self, 'settlement_experiment', None)
            if experiment is not None:
                experiment.statistics_received(payload)
        elif kind == 'immediate_settlement_experiment':
            experiment = getattr(self, 'settlement_experiment', None)
            if experiment is not None:
                experiment.query_event(payload)
        elif kind == "identity_session_reset":
            timestamp_ns = 0
            if isinstance(payload, dict):
                try:
                    timestamp_ns = int(
                        payload.get("capture_timestamp_ns", 0) or 0
                    )
                except (TypeError, ValueError, OverflowError):
                    timestamp_ns = 0
            if self._identity_session_change_is_proven(payload):
                self._reset_for_capture_session_change(timestamp_ns or None)
            else:
                # The passive transport can rebuild inside the same dungeon
                # before it has rediscovered the current token. Preserve the
                # live encounter, delayed settlement, clock and Boss warning;
                # the next profile will issue a proven reset if the role did
                # actually change.
                self.capture_transport_resyncing = True
        elif kind == "event":
            adapter = getattr(self, "settlement_history_adapter", None)
            if adapter is not None:
                adapter.observe_detail(kind, payload)
            self._ingest_combat_event(payload)
        elif kind == "skill_cast":
            adapter = getattr(self, "settlement_history_adapter", None)
            if adapter is not None:
                adapter.observe_detail(kind, payload)
            self.model.ingest_skill_cast(payload)
        elif kind == "boss_damage_event":
            self.model.ingest_boss_damage(payload)
        elif kind == "boss_health_observation":
            controller = getattr(self, "settlement_ui", None)
            if controller is not None and controller.observe_boss_health(payload):
                adapter = getattr(self, "settlement_history_adapter", None)
                if adapter is not None:
                    self._sync_settlement_history_for_upload(adapter, controller.tracker)
        elif kind == "heal":
            adapter = getattr(self, "settlement_history_adapter", None)
            if adapter is not None:
                adapter.observe_detail(kind, payload)
            if pvp_recording is not None:
                tracker_before = pvp_recording.display_tracker.generation
                pvp_recording.ingest_update("heal", payload)
                self.pvp_tracker = pvp_recording.current
                if (
                    pvp_recording.display_tracker.generation != tracker_before
                    and self.main_combat_mode == "pvp"
                ):
                    self._schedule_layered_main_render(delay=120)
            self.model.ingest_heal(payload)
        elif kind == "actor_health":
            if pvp_recording is not None:
                pvp_recording.ingest_update(kind, payload)
            self.model.ingest_actor_health(payload)
        elif kind == "active_boss":
            if self.model.ingest_active_boss(payload):
                # Boss promotion can be the only packet at a room boundary;
                # make the new target and archived-row transition visible even
                # before its first HP/damage sample arrives.
                self._schedule_layered_main_render()
        elif kind == "identity":
            if self.model.ingest_identity(payload):
                self._invalidate_team_rating_preview_rows(clear_profiles=True)
                self._schedule_layered_main_render()
            self._sync_startup_identity_state()
            self._schedule_team_equipment_profiles()
        elif kind == "actor_merge":
            if self.model.merge_actor(payload):
                self._invalidate_team_rating_preview_rows(
                    payload.get("from_actor_id", 0),
                    payload.get("to_actor_id", 0),
                )
                self._schedule_team_equipment_profiles()
        elif kind == "team_actor_rebind":
            if self.model.rebind_team_actors(payload):
                self._invalidate_team_rating_preview_rows()
                self._schedule_team_equipment_profiles()
        elif kind == "party":
            previous_party_session_id = int(
                getattr(self.model, "party_session_id", 0) or 0
            )
            encounter_started = getattr(
                self.model, "_encounter_started", None
            )
            had_battle_values = bool(
                callable(encounter_started) and encounter_started()
            )
            combat_in_progress = getattr(
                self.model, "combat_in_progress", None
            )
            was_in_combat = bool(
                callable(combat_in_progress) and combat_in_progress()
            )
            party_changed = self.model.ingest_party(payload)
            next_party_session_id = int(
                getattr(self.model, "party_session_id", 0) or 0
            )
            tracker = getattr(getattr(self, "settlement_ui", None), "tracker", None)
            settlement_controller = getattr(self, "settlement_ui", None)
            current = getattr(tracker, "encounters", {}).get(
                getattr(tracker, "current_id", None)
            )
            recent = self._main_recent_settlement_record(settled_only=True)
            current_instance = (
                getattr(current, "instance_id", None)
                if current is not None
                else getattr(settlement_controller, "instance_id", None)
            )
            same_recent_instance = bool(
                recent is not None
                and current_instance
                and str(getattr(recent, "instance_id", "") or "")
                == str(current_instance)
            )
            preserve_recent = bool(
                previous_party_session_id > 0
                and next_party_session_id == 0
                and had_battle_values
                and (
                    (
                        current is not None
                        and current.result == "IN_PROGRESS"
                        and int(current.party_session_id or 0)
                        == previous_party_session_id
                        and recent is not None
                        and recent.settlement_status == "SETTLED"
                    )
                    or (
                        current is None
                        and same_recent_instance
                        and recent.settlement_status == "SETTLED"
                    )
                )
            )
            if (
                next_party_session_id != previous_party_session_id
                and not was_in_combat
                and not preserve_recent
            ):
                # Membership changes inside one team session update only the
                # live roster. The completed battle remains bound to its
                # frozen participant snapshot.
                self._reset_main_visible_context(
                    boundary_ns=(
                        0
                        if same_recent_instance
                        else self._main_boundary_timestamp_ns(payload)
                        or time.time_ns()
                    ),
                    hide_current_encounter=had_battle_values
                )
            if party_changed:
                self._invalidate_team_rating_preview_rows()
                self._schedule_layered_main_render()
            self._schedule_team_equipment_profiles()
        elif kind == "team_application":
            if self._ingest_team_application(payload):
                # Transient applications always occupy the top of the DPS
                # viewport, even if the user had scrolled older rows down.
                self.main_scroll_offset = 0
                self._schedule_layered_main_render()
        elif kind == "profile":
            profile_changed = self.model.ingest_profile(payload)
            rating_rebaselined = (
                self._rebaseline_team_equipment_rating_after_capture_change(
                    payload
                )
            )
            periodic_rating_refresh = bool(
                isinstance(payload, dict)
                and payload.get("source_method")
                == "PeriodicLiveTeamRatingSnapshot"
            )
            if profile_changed or periodic_rating_refresh or rating_rebaselined:
                self._invalidate_team_rating_preview_rows(
                    payload.get("entity_id", 0)
                )
                if any(key in payload for key in ('extraordinary_rating', 'is_ai', 'name', 'profession_id')):
                    # Received roster/rating data should be painted immediately,
                    # not wait behind the regular summary/housekeeping timer.
                    self._schedule_layered_main_render(force=True)
            self._sync_startup_identity_state()
            self._schedule_team_equipment_profiles()
        elif kind == "fight_attributes":
            if self.model.ingest_fight_attributes(payload):
                self._invalidate_team_rating_preview_rows(
                    payload.get("entity_id", 0)
                    if isinstance(payload, dict)
                    else 0
                )
                self._schedule_layered_main_render()
        elif kind == "self_character":
            self._handle_self_character(payload)
            self._schedule_team_equipment_profiles()
        elif kind == "equipment_profile":
            equipment_changed = self._ingest_team_equipment_profile(payload)
            if equipment_changed:
                if pvp_recording is not None:
                    pvp_recording.ingest_update("equipment_profile", payload)
                    self._dispatch_message("pvp_history_changed", None)
                self._schedule_layered_main_render()
            self._schedule_team_equipment_profiles()
        elif kind == "monster":
            hp_changed = self._ingest_monster_update(payload)
            if hp_changed and isinstance(payload, dict) and ('current_hp' in payload or 'max_hp' in payload):
                # HP is already validated and bound by the parser/model.
                # Paint it on receipt, without waiting for the DPS timer.
                self._schedule_layered_main_render()
        elif kind == "team_stat":
            live_hud_changed = self._ingest_live_hud_team_stat(payload)
            if self.model.ingest_team_stat(payload) or live_hud_changed:
                self._schedule_layered_main_render()
        elif kind == "stage_summary":
            if (
                pvp_recording is not None
                and (
                    pvp_recording.active
                    or getattr(pvp_recording, "map_id", None) in RECORDABLE_MAPS
                )
            ):
                pvp_recording.ingest_update("pvp_team_summary", payload)
                if self.main_combat_mode == "pvp":
                    self._schedule_layered_main_render()
            self._ingest_stage_summary(payload)
        elif kind == "dungeon_context":
            previous_dungeon_id = int(
                getattr(self.model, "current_dungeon_id", 0) or 0
            )
            encounter_started = getattr(
                self.model, "_encounter_started", None
            )
            had_battle_values = bool(
                callable(encounter_started) and encounter_started()
            )
            combat_in_progress = getattr(
                self.model, "combat_in_progress", None
            )
            was_in_combat = bool(
                callable(combat_in_progress) and combat_in_progress()
            )
            self.model.ingest_dungeon_context(payload)
            next_dungeon_id = int(
                getattr(self.model, "current_dungeon_id", 0) or 0
            )
            if (
                next_dungeon_id > 0
                and next_dungeon_id != previous_dungeon_id
                and not was_in_combat
            ):
                self._clear_live_hud_dps_segment()
                self.live_hud_boss_state = None
                boundary_ns = self._main_boundary_timestamp_ns(payload)
                self._reset_main_visible_context(
                    boundary_ns=boundary_ns or time.time_ns(),
                    hide_current_encounter=had_battle_values,
                )
                self._schedule_layered_main_render()
        elif kind == "enrage_countdown":
            self.model.ingest_enrage_countdown(payload)
        elif kind == "combat_state":
            was_live = self._main_battle_signal_active()
            self._ingest_combat_state(payload)
            if not was_live and self._main_battle_signal_active() and self._layered_main_active():
                self._render_layered_main_hud()
            else:
                self._schedule_layered_main_render()
        elif kind == "life":
            self.model.ingest_life(payload)
        elif kind == "scene":
            changed = self.model.ingest_scene(payload)
            if isinstance(payload, dict) and payload.get("transition"):
                self._clear_live_hud_dps_segment()
                self.live_hud_boss_state = None
            if changed:
                self._invalidate_team_rating_preview_rows()
            if (changed or (isinstance(payload, dict) and payload.get('transition'))) and not getattr(self.model, 'long_gap_phase_suspended', False):
                # A scene edge can be the final-Boss exit. Keep its completed
                # table visible; a confirmed new dungeon context owns the next
                # display reset.
                self.main_scroll_offset = 0
                self.enrage_prediction = None
                self.enrage_prediction_visible = False
                self._schedule_layered_main_render()
        elif kind == "tray_restore":
            self.show_from_tray()
        elif kind == "tray_restore_window":
            self.restore_window_from_tray()
        elif kind == "hotkey_toggle_visibility":
            self.toggle_application_visibility()
        elif kind == "hotkey_toggle_hud_view":
            if (
                getattr(self, "hud_view_hotkey_enabled", False)
                and getattr(self, "hud_view_hotkey_registered", False)
                and not getattr(self, "hud_view_hotkey_capture_active", False)
            ):
                self._toggle_hud_content_view()
        elif kind == "hotkey_unlock_window":
            tray = getattr(self, "tray_icon", None)
            if (
                getattr(self, "lock_toggle_hotkey_enabled", False)
                and getattr(self, "unlock_hotkey_registered", False)
                and tray is not None and tray.alive
            ) or self._hotkey_only_lock_active():
                self.toggle_window_lock()
        elif kind == "tray_exit":
            self.close()
        elif kind == "trial_claim_result":
            self._handle_trial_claim_result(payload)
        elif kind == "feedback_result":
            self._handle_feedback_result(payload)
        elif kind == "profile_resolve_result":
            self._handle_profile_resolve_result(payload)
        elif kind == "profile_mutation_result":
            self._handle_profile_mutation_result(payload)
        elif kind == "profile_link_code_result":
            self._handle_profile_link_code_result(payload)
        elif kind == "profile_uploads_result":
            self._handle_profile_uploads_result(payload)
        elif kind == "encounter_upload_result":
            self._handle_encounter_upload_result(payload)
        elif kind == "update_check_result":
            self._handle_update_check_result(payload)
        elif kind == "rollback_check_result":
            self._handle_rollback_check_result(payload)
        elif kind == "update_available" and isinstance(payload, UpdateInfo):
            self._cache_available_update(payload)
        elif kind == "update_download_progress":
            self._handle_update_download_progress(payload)
        elif kind == "update_downloaded":
            self._handle_update_downloaded(payload)
        elif kind == "update_download_failed":
            self._handle_update_download_failed(payload)
        elif kind == "combat_clock_result" and isinstance(
            payload, CombatClockResult
        ):
            self._handle_combat_clock_result(payload)
        elif kind == "name":
            self.model.ingest_name(payload)
        elif kind == "skill_name":
            if self.model.ingest_skill_name(payload):
                self._save_preferences()
        elif kind in ("capture_initializing", "capture_waiting") and isinstance(payload, dict):
            initializing_pid = int(payload.get("pid", 0) or 0)
            initializing_session_id = int(payload.get("session_id", 0) or 0)
            same_process = bool(
                not initializing_pid
                or not self.active_capture_game_pid
                or initializing_pid == self.active_capture_game_pid
            )
            same_session = bool(
                not initializing_session_id
                or not self.active_capture_session_id
                or initializing_session_id == self.active_capture_session_id
            )
            if same_process and same_session:
                resynchronizing = bool(
                    self.connected
                    and initializing_pid
                    and initializing_pid == self.active_capture_game_pid
                    and self.active_capture_session_id
                    and not getattr(self, "startup_identity_pending", False)
                    and not getattr(self, "startup_capture_pending", False)
                )
                if resynchronizing:
                    self.capture_transport_resyncing = True
                    self.startup_wait_reason = "transport_resync"
                    self.dot.configure(fg=ACCENT)
                    self.status_label.configure(text="场景同步", fg=MUTED)
                    self._schedule_layered_main_render()
                    return
                was_capture_pending = bool(
                    getattr(self, "startup_capture_pending", False)
                )
                self.startup_capture_pending = True
                if not was_capture_pending:
                    self.startup_wait_started_at = time.monotonic()
                self.startup_wait_reason = (
                    str(payload.get('reason', 'connection_change'))
                    if kind == 'capture_waiting'
                    else
                    "starting"
                    if getattr(self, "startup_identity_pending", False)
                    else "capture"
                )
                self.dot.configure(fg=WARN)
                self.status_label.configure(
                    text=("自动重试中" if self.startup_wait_reason == "initial_state"
                          else "连接中"), fg=WARN
                )
                self._schedule_layered_main_render()
        elif kind == "connected":
            payload = payload if isinstance(payload, dict) else {}
            next_session_id = int(payload.get("session_id", 0) or 0)
            next_game_pid = int(payload.get("pid", 0) or 0)
            previous_session_id = int(
                getattr(self, "active_capture_session_id", 0) or 0
            )
            previous_game_pid = int(
                getattr(self, "active_capture_game_pid", 0)
                or getattr(self, "game_pid", 0)
                or 0
            )
            if (
                previous_game_pid
                and next_game_pid
                and previous_game_pid != next_game_pid
            ):
                self._reset_for_capture_session_change()
            same_process_resync = bool(
                previous_game_pid
                and next_game_pid
                and previous_game_pid == next_game_pid
                and previous_session_id > 0
            )
            if next_session_id:
                self.active_capture_session_id = next_session_id
            if next_game_pid:
                # Preserve the identity epoch across a recoverable transport
                # resync. ``game_pid`` is connection status and may briefly be
                # zero; only an actual process change is a hard reset here.
                self.active_capture_game_pid = next_game_pid
            self.connected = True
            self.game_pid = next_game_pid
            if same_process_resync:
                # A new passive transport session for the same game process
                # is recoverable. Keep the already-rendered HUD interactive;
                # late packets will repopulate identity/ratings in place.
                self.startup_capture_pending = False
                self.capture_transport_resyncing = True
                self.startup_wait_started_at = 0.0
                self.startup_wait_reason = "transport_resync"
            else:
                self.startup_capture_pending = True
                self.capture_transport_resyncing = False
                self.startup_wait_started_at = time.monotonic()
                self.startup_wait_reason = (
                    "starting"
                    if getattr(self, "startup_identity_pending", False)
                    else "capture"
                )
            if self.heartbeat_worker is not None:
                self.heartbeat_worker.update_state(
                    using=True,
                    character_name=self.model.display_name(
                        int(self.model.self_id or 0)
                    ),
                    game_pid=self.game_pid,
                )
            self.dot.configure(fg=WARN if not same_process_resync else ACCENT)
            self.status_label.configure(
                text="场景同步" if same_process_resync else "初始化",
                fg=WARN if not same_process_resync else MUTED,
            )
            self._schedule_layered_main_render()
        elif kind == "capture_ready" and isinstance(payload, dict):
            ready_session_id = int(payload.get("session_id", 0) or 0)
            ready_game_pid = int(payload.get("pid", 0) or 0)
            if (
                ready_session_id == self.active_capture_session_id
                and ready_game_pid == self.active_capture_game_pid
            ):
                self.capture_restart_attempts = 0
                self.capture_fatal_payload = None
                self.capture_recovery_notice_shown = False
                self.startup_capture_pending = False
                self.capture_transport_resyncing = False
                self.startup_wait_reason = (
                    "identity"
                    if getattr(self, "startup_identity_pending", False)
                    else ""
                )
                if not getattr(self, "startup_identity_pending", False):
                    self.startup_wait_started_at = 0.0
                self.dot.configure(fg=ACCENT)
                self.status_label.configure(text="运行中", fg=MUTED)
                self._schedule_team_equipment_profiles()
                self._schedule_layered_main_render()
        elif kind == "stopped":
            self._handle_capture_worker_stopped(payload)
        elif kind == "waiting":
            self.connected = False
            self.game_pid = 0
            self.capture_transport_resyncing = False
            self._clear_team_equipment_profiles()
            self.startup_capture_pending = True
            self.startup_wait_reason = "game_not_found"
            self.startup_wait_started_at = 0.0
            if self.heartbeat_worker is not None:
                self.heartbeat_worker.update_state(using=False)
            self.dot.configure(fg=WARN)
            self.status_label.configure(text="待机", fg=MUTED)
            self._schedule_layered_main_render()
        elif kind in ("error", "fatal"):
            if kind == "fatal":
                self.capture_fatal_payload = payload
            self.connected = False
            self.game_pid = 0
            self.capture_transport_resyncing = False
            self._clear_team_equipment_profiles()
            self.startup_capture_pending = True
            self.startup_wait_reason = "capture_error"
            self.startup_wait_started_at = 0.0
            if self.heartbeat_worker is not None:
                self.heartbeat_worker.update_state(using=False)
            transient_capture_failure = (
                kind == "fatal" and capture_failure_can_retry(payload)
            )
            self.dot.configure(fg=WARN if transient_capture_failure else ERROR)
            self.status_label.configure(
                text=(
                    "采集资源不足，正在重新连接"
                    if transient_capture_failure
                    else chinese_error_message(payload)
                ),
                fg=WARN if transient_capture_failure else ERROR,
            )
            self._schedule_layered_main_render()
        elif kind == "license_reconnecting":
            self.license_network_reconnecting = True
        elif kind == "license_capture_expired":
            self._pause_for_license_network()
        elif kind == "license_reconnected":
            self.license_network_reconnecting = False
        elif kind == "server_clock" and isinstance(payload, dict):
            if self.model.ingest_server_clock(
                payload.get("server_time", 0.0),
                payload.get("received_at"),
            ):
                self._schedule_layered_main_render()
        elif kind == "runtime_capability" and isinstance(
            payload, RuntimeCapability
        ):
            try:
                if not getattr(self, "license_network_paused", False):
                    self.worker.refresh_runtime_capability(payload)
            except RuntimeCapabilityError as exc:
                self._return_to_login(
                    SYSTEM_TIME_SYNC_MESSAGE
                    if isinstance(exc, RuntimeCapabilityTimeError)
                    else "采集授权续期失败，请重新登录。"
                )
        elif kind == "license_required":
            self._return_to_login(str(payload))

    def _drain_messages(self) -> None:
        self.drain_after_id = None
        if self.closing:
            return

        control_queue = getattr(self, "control_messages", None)
        control_drained = control_queue is None
        if control_queue is not None:
            try:
                for _index in range(CONTROL_MESSAGE_DRAIN_BATCH_SIZE):
                    kind, payload = control_queue.get_nowait()
                    self._dispatch_message(kind, payload)
                    if self.closing:
                        return
            except queue.Empty:
                control_drained = True

        queue_drained = False
        deadline = time.perf_counter() + MESSAGE_DRAIN_TIME_BUDGET_SECONDS
        try:
            for _index in range(MESSAGE_DRAIN_BATCH_SIZE):
                kind, payload = self.messages.get_nowait()
                self._dispatch_message(kind, payload)
                if self.closing or time.perf_counter() >= deadline:
                    break
        except queue.Empty:
            queue_drained = True
        if not self.closing:
            self._release_stalled_startup_gate()
            self._check_license_network_recovery()
            # Continuous combat can keep the capture queue non-empty forever.
            # Control results are handled first, then combat is bounded so Tk
            # still receives paint and input events between batches.
            delay = 50 if queue_drained and control_drained else 1
            try:
                self.drain_after_id = self.root.after(delay, self._drain_messages)
            except (AttributeError, tk.TclError):
                self.drain_after_id = None

    def _pause_for_license_network(self) -> None:
        if self.closing or self.authorization_resetting or getattr(self, 'license_network_paused', False):
            return
        self.license_network_paused = True
        self.license_network_saved = False
        policy = getattr(getattr(self, 'heartbeat_worker', None), 'recovery', None)
        try:
            renewal_count = max(
                0, int(getattr(policy, 'successful_renewals', 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            renewal_count = 0
        try:
            failure_count = max(
                0, int(getattr(policy, 'failures', 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            failure_count = 0
        capability = getattr(self.licensing.session, "runtime_capability", None)
        card_expiry = getattr(self.licensing.session, "expires_at", None)
        try:
            card_expires_at = float(card_expiry.timestamp()) if card_expiry else 0.0
        except (AttributeError, OSError, TypeError, ValueError, OverflowError):
            card_expires_at = 0.0
        self.license_resume_after_renewal = renewal_count + 1
        # ``RecoveryPolicy.last_success`` is normally a monotonic float, but
        # tests and older persisted workers may expose ``None`` or a proxy
        # object.  Treat anything that is not a finite number as unavailable
        # instead of letting the pause path stop the UI with ``TypeError``.
        raw_last_success = getattr(policy, "last_success", 0.0)
        try:
            last_success = float(raw_last_success or 0.0)
        except (TypeError, ValueError, OverflowError):
            last_success = 0.0
        if not math.isfinite(last_success):
            last_success = 0.0
        self._request_capture_stop(
            "license_network_pause",
            reconnecting=bool(getattr(policy, 'reconnecting', False)),
            failures=failure_count,
            successful_renewals=renewal_count,
            capability_expires_at=float(
                getattr(capability, "expires_at", 0.0) or 0.0
            ),
            card_expires_at=card_expires_at,
            wall_time=time.time(),
            last_success_age_seconds=max(
                0.0,
                time.monotonic() - last_success,
            ),
        )
        self.connected = False

    def _check_license_network_recovery(self) -> None:
        heartbeat = getattr(self, 'heartbeat_worker', None)
        if getattr(self, 'authorization_resetting', False) or self.closing or heartbeat is None:
            return
        policy = getattr(heartbeat, 'recovery', None)
        if policy is None:
            return
        if policy.must_pause(self.licensing.session):
            self._pause_for_license_network()
        if getattr(self, 'license_network_paused', False):
            self.connected = False
            if self.worker.is_alive():
                return  # Let Hook cleanup finish; never force terminate it.
            if not getattr(self, 'license_network_saved', False):
                if not self._ingest_pending_capture_messages():
                    return
                record = self.model.build_combat_record('capture_stopped')
                if record:
                    self._remember_main_battle_result(record)
                self.model.reset(keep_identity=True, archive_reason='capture_stopped')
                self._flush_combat_history(force=True)
                self.license_network_saved = True
                self.capture_started = False
            if (not policy.reconnecting and not policy.must_pause(self.licensing.session)
                    and policy.successful_renewals >= getattr(self, 'license_resume_after_renewal', 0)):
                experiment = getattr(self, "settlement_experiment", None)
                if experiment is not None:
                    experiment.lifecycle(
                        "license_network_recovered",
                        component="main_window",
                        successful_renewals=int(policy.successful_renewals),
                    )
                self.license_network_paused = False
                self.license_network_reconnecting = False
                self._start_capture()
        if getattr(self, 'license_network_paused', False):
            self.status_label.configure(text='战斗已保存，等待授权恢复', fg=WARN)
        elif policy.reconnecting:
            self.status_label.configure(text='正在重连授权服务器', fg=WARN)

    def _ingest_combat_event(self, payload: object) -> None:
        if not isinstance(payload, dict):
            return
        self.model.ingest(payload)
        self._bind_active_settlement_history()
        try:
            attacker_id = int(payload.get("attacker_id", 0) or 0)
            target_id = int(payload.get("target_id", 0) or 0)
            damage = int(payload.get("damage", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return
        dummy_reader = getattr(self.model, "_is_dummy_target", None)
        if (
            damage > 0
            and attacker_id == int(getattr(self.model, "self_id", 0) or 0)
            and callable(dummy_reader)
            and dummy_reader(target_id)
        ):
            # Damage events arrive on the UI dispatch thread.  Coalesce the
            # paint, but do not wait for the 180 ms housekeeping pass before
            # reflecting a local training-dummy hit.
            self._schedule_layered_main_render()

    def _handle_pvp_observation(self, payload: object) -> None:
        record = payload.get("record", {}) if isinstance(payload, dict) else {}
        method = str(record.get("method") or "") if isinstance(record, dict) else ""
        immediate = method in {
            "RetGetTeamArenaBattleInfo",
            "OnMsgSyncTeamPVPInfo",
            "OnMsgTeamPVPSettlement",
            "OnMsgIndividualPVPResult",
        }
        pvp_recording = getattr(self, "pvp_recording", None)
        if pvp_recording is not None:
            before = pvp_recording.display_tracker.generation
            previous_match_id = (getattr(pvp_recording, "recording", None) or {}).get("match_id")
            finalized = pvp_recording.observe(payload)
            self._show_hunter_match_on_entry(previous_match_id)
            self.pvp_tracker = pvp_recording.current
            tracker = pvp_recording.display_tracker
            if finalized is not None or (
                tracker.generation != before
                and method in {"RetGetTeamArenaBattleInfo", "OnMsgSyncTeamPVPInfo"}
            ):
                # A result packet can be the first complete 3V3/6V6/12V12
                # roster; an entry roster can arrive first. Query its human
                # roles immediately. Ordinary hits keep the periodic check.
                self._schedule_team_equipment_profiles()
            if finalized is not None:
                pvp_uploader = getattr(self, "pvp_upload_worker", None)
                if pvp_uploader is not None:
                    pvp_uploader.wake()
                self._dispatch_message("pvp_history_changed", None)
            if (
                finalized is not None
                or tracker.generation != before
            ) and getattr(self, "main_combat_mode", "pve") == "pvp":
                if immediate or finalized is not None:
                    pending = getattr(self, "layered_main_after_id", None)
                    if pending is not None:
                        try:
                            self.root.after_cancel(pending)
                            self.layered_main_after_id = None
                        except (AttributeError, tk.TclError):
                            pass
                self._schedule_layered_main_render(
                    delay=0 if immediate or finalized is not None else 200
                )
            return
        tracker = getattr(self, "pvp_tracker", None)
        if tracker is not None and tracker.consume(payload):
            if getattr(self, "main_combat_mode", "pve") == "pvp":
                if immediate:
                    pending = getattr(self, "layered_main_after_id", None)
                    if pending is not None:
                        try:
                            self.root.after_cancel(pending)
                            self.layered_main_after_id = None
                        except (AttributeError, tk.TclError):
                            pass
                self._schedule_layered_main_render(
                    delay=0 if immediate else 200
                )

    def _render(self) -> None:
        """Always reschedule the main window after one malformed frame."""
        self.render_after_id = None
        if self.closing:
            return
        try:
            self._render_unsafe()
            self._main_render_last_error = ""
        except Exception as exc:
            error = f"{type(exc).__name__}: {exc}"
            if error != getattr(self, "_main_render_last_error", ""):
                print(f"[main-render] {error}", file=sys.stderr)
                self._main_render_last_error = error
        finally:
            if not self.closing:
                try:
                    self.render_after_id = self.root.after(180, self._render)
                except (AttributeError, tk.TclError):
                    self.render_after_id = None

    def _render_unsafe(self) -> None:
        if (
            getattr(self, "main_window_intentionally_hidden", False)
            and getattr(self, "history_window", None) is not None
        ):
            try:
                backend_visible = (
                    self.history_window.winfo_exists()
                    and self.history_window.state() == "normal"
                )
            except (AttributeError, tk.TclError):
                backend_visible = False
        else:
            backend_visible = False
        if (
            getattr(self, "window_locked", False)
            and getattr(self, "unlock_hotkey_enabled", False)
            and not self._hotkey_only_lock_active()
        ):
            self._show_unlock_window()
        pvp_recording = getattr(self, "pvp_recording", None)
        if pvp_recording is not None:
            finalized_pvp = pvp_recording.poll(time.time_ns())
            if finalized_pvp is not None:
                pvp_uploader = getattr(self, "pvp_upload_worker", None)
                if pvp_uploader is not None:
                    pvp_uploader.wake()
                self._dispatch_message("pvp_history_changed", None)
                if getattr(self, "main_combat_mode", "pve") == "pvp":
                    self._schedule_layered_main_render()
        equipment_check_at = float(
            getattr(self, "team_equipment_next_retry_check_at", 0.0) or 0.0
        )
        monotonic_now = time.monotonic()
        if monotonic_now >= equipment_check_at:
            self.team_equipment_next_retry_check_at = (
                monotonic_now + TEAM_EQUIPMENT_RETRY_CHECK_SECONDS
            )
            self._schedule_team_equipment_profiles()
        experiment = getattr(self, 'settlement_experiment', None)
        controller = getattr(self, 'settlement_ui', None)
        if experiment is not None and controller is not None:
            experiment.poll(controller.tracker.encounters)
        now = time.time()
        self.model.sample_team_damage(now)
        self.model.flush_pending_member_deaths()
        self.model.finalize_if_idle(now)
        if self.combat_clock_worker is not None:
            self.combat_clock_worker.submit(
                self.model.combat_clock_snapshot(now)
            )
        self._flush_combat_history()

        if backend_visible and self._layered_main_active():
            # The combat model keeps collecting above. The hidden layered HUD
            # does not need the legacy PVE row/skill/health paint pass every
            # 180 ms while Settings or battle history owns the screen.
            if self.heartbeat_worker is not None:
                self.heartbeat_worker.update_state(
                    using=self.connected,
                    character_name=(
                        self.model.display_name(int(self.model.self_id or 0))
                        if self.model.self_id is not None else ""
                    ),
                    game_pid=self.game_pid,
                )
            self._sync_backend_sidebar_status()
            return

        targetless_team_data = self._main_targetless_team_data(now)
        if targetless_team_data is not None:
            targetless_stats, targetless_duration = targetless_team_data
            duration = targetless_duration
            display_duration = targetless_duration
            damage_total = sum(row.damage for row in targetless_stats)
        else:
            duration = self.model.duration(now)
            display_duration_reader = getattr(
                self.model, "display_duration", None
            )
            display_duration = (
                float(display_duration_reader(now))
                if callable(display_duration_reader)
                else duration
            )
            damage_total = sum(
                row.damage for row in self.model.current_stats()
            )
        dps_duration = dps_duration_seconds(duration)
        self.latest_healing_summary = self.model.healing_summary(duration)
        combat_active = bool(self.model.combat_in_progress(now))
        rating_preview = self._team_rating_preview_active()
        self._sync_team_rating_preview_layout(rating_preview)

        if self.show_combat_time:
            self._set_main_time_value(format_duration(display_duration))
        if targetless_team_data is not None:
            boss = None
        else:
            current_bosses_reader = getattr(
                self.model, "current_bosses", None
            )
            current_bosses = (
                list(current_bosses_reader())
                if callable(current_bosses_reader) else None
            )
            boss = (
                current_bosses[0] if current_bosses
                else self.model.current_monster()
                if current_bosses is None
                else None
            )
        live_team_dps = damage_total / dps_duration if dps_duration else 0.0
        if combat_active:
            sampled = self.model.sample_display_team_dps(now, live_team_dps)
            adapter = getattr(self, "settlement_history_adapter", None)
            controller = getattr(self, "settlement_ui", None)
            if sampled and adapter is not None and controller is not None:
                adapter.sample_live_team_dps(
                    controller.tracker, now, live_team_dps,
                    boss_template_id=int(getattr(boss, "template_id", 0) or 0),
                )
        if self.show_team_dps:
            if getattr(self, "pve_hud_view", "team") == "team":
                self.main_dps_caption_text = "团队超凡评分"
                footer_text = (
                    self._main_team_rating_summary_text()
                    if TEAM_RATING_PREVIEW_AVAILABLE
                    and bool(getattr(self, "team_rating_preview_enabled", False))
                    else "0"
                )
            else:
                self.main_dps_caption_text = "团队总秒伤"
                footer_text = self._main_recent_battle_team_dps_text() or "--"
            self._set_team_dps_value(footer_text)

        team_health = self.worker.team_stats_health_state()
        encounter_known = bool(self.model._encounter_started())
        recovering_team_data = team_health in {
            "rearmed_waiting",
            "reinstalling",
            "reinstalled_waiting",
        }
        incomplete_team_data = team_health in {
            "hook_missing",
            "recovery_failed",
            "unhealthy",
        }
        if self.connected and encounter_known and (
            recovering_team_data or incomplete_team_data
        ):
            self._team_stats_warning_active = True
            self.dot.configure(fg=WARN)
            self.status_label.configure(
                text=(
                    "队伍数据正在恢复"
                    if recovering_team_data
                    else "队伍数据不完整"
                ),
                fg=WARN,
            )
        elif getattr(self, "_team_stats_warning_active", False):
            self._team_stats_warning_active = False
            if self.connected:
                self.dot.configure(fg=ACCENT)
                self.status_label.configure(text="运行中", fg=MUTED)

        if self.heartbeat_worker is not None:
            self.heartbeat_worker.update_state(
                using=self.connected,
                character_name=(
                    self.model.display_name(int(self.model.self_id or 0))
                    if self.model.self_id is not None
                    else ""
                ),
                game_pid=self.game_pid,
            )
        self._update_enrage_prediction(now)
        self._draw_monster_hp()
        self._draw_main_rows()
        self._render_skill_details()
        self._sync_action_buttons()
        self._sync_expiry_label()
        self._sync_backend_sidebar_status()
        self._sync_unlock_window_position()
        # The recurring callback is scheduled by ``_render``.  Keeping a
        # single owner prevents two independent render loops from accumulating
        # after a mode switch and makes shutdown cancellation deterministic.

    def _render_retired_main_modes(self) -> None:
        if self.closing:
            return
        now = time.time()
        self.model.sample_team_damage(now)
        self.model.flush_pending_member_deaths()
        self.model.finalize_if_idle(now)
        if self.combat_clock_worker is not None:
            self.combat_clock_worker.submit(
                self.model.combat_clock_snapshot(now)
            )
        self._flush_combat_history()
        main_meter_mode = getattr(self, "main_meter_mode", "dps")
        duration = (
            self.model.healing_duration(now)
            if main_meter_mode == "hps"
            else self.model.duration(now)
        )
        display_duration_reader = getattr(self.model, "display_duration", None)
        display_duration = (
            float(display_duration_reader(now))
            if main_meter_mode != "hps" and callable(display_duration_reader)
            else duration
        )
        dps_duration = dps_duration_seconds(duration)
        damage_total = sum(row.damage for row in self.model.current_stats())
        healing_detail_visible = bool(
            getattr(self, "skill_panel_mode", "damage") == "healing"
            and getattr(self, "skill_window", None) is not None
            and self.skill_window.winfo_exists()
        )
        if main_meter_mode == "hps" or healing_detail_visible:
            summary_duration = (
                self.model.healing_duration(now)
                if main_meter_mode == "hps"
                else self.model.duration(now)
            )
            self.latest_healing_summary = self.model.healing_summary(
                summary_duration
            )
        if main_meter_mode == "boss":
            boss_summary = self.model.current_boss_damage_summary()
            shown_total = int(boss_summary.get("observed_damage", 0) or 0)
            shown_rate = boss_summary.get("classification_ratio")
            self.total_caption.configure(text="已归类首领伤害")
            self.dps_caption.configure(text="归类比例")
        elif main_meter_mode == "hps":
            shown_total = int(
                self.latest_healing_summary.get(
                    "team_effective_healing", 0
                )
                or 0
            )
            shown_rate = float(
                self.latest_healing_summary.get("team_hps", 0.0) or 0.0
            )
            self.total_caption.configure(text="总有效治疗")
            self.dps_caption.configure(text="团队 HPS")
        elif main_meter_mode == "dt":
            taken_rows = self.model.current_taken_rows()
            taken_complete = bool(taken_rows) and all(
                row.get("taken") is not None for row in taken_rows
            )
            shown_total = (
                sum(int(row.get("taken", 0) or 0) for row in taken_rows)
                if taken_complete
                else 0
            )
            shown_rate = max(
                (
                    max(0.0, min(1.0, float(row.get("share", 0.0) or 0.0)))
                    for row in taken_rows
                ),
                default=0.0,
            )
            self.total_caption.configure(text="团队总承伤")
            self.dps_caption.configure(text="最高承伤占比")
        else:
            shown_total = damage_total
            shown_rate = (
                damage_total / dps_duration if dps_duration else 0.0
            )
            self.total_caption.configure(text="总伤害")
            self.dps_caption.configure(text="总 DPS")
        self.total_value.configure(
            text=format_number(shown_total) if shown_total is not None else "--"
        )
        dps_text = (
            f"{shown_rate * 100:.1f}%"
            if main_meter_mode in {"dt", "boss"} and shown_rate is not None
            else format_number(shown_rate) if shown_rate is not None else "--"
        )
        self.dps_value.configure(text=dps_text)
        rating_preview = self._team_rating_preview_active()
        self._sync_team_rating_preview_layout(rating_preview)
        if main_meter_mode == "boss":
            state = (
                "战斗中"
                if self.model.active(now)
                else (
                    "已结束"
                    if self.model._encounter_started() or shown_total
                    else "待机"
                )
            )
        elif main_meter_mode == "hps":
            healing_total = int(
                self.latest_healing_summary.get(
                    "team_effective_healing", 0
                )
                or 0
            )
            state = (
                "战斗中"
                if self.model.healing_active(now)
                else ("已结束" if healing_total else "待机")
            )
        elif main_meter_mode == "dt":
            state = (
                "战斗中"
                if self.model.active(now)
                else ("已结束" if self.model._encounter_started() else "待机")
            )
        else:
            state = (
                "战斗中"
                if self.model.active(now)
                else ("已结束" if damage_total else "待机")
            )
        team_health = self.worker.team_stats_health_state()
        encounter_known = bool(self.model._encounter_started())
        recovering_team_data = team_health in {
            "rearmed_waiting",
            "reinstalling",
            "reinstalled_waiting",
        }
        incomplete_team_data = team_health in {
            "hook_missing",
            "recovery_failed",
            "unhealthy",
        }
        if self.connected and encounter_known and (
            recovering_team_data or incomplete_team_data
        ):
            self._team_stats_warning_active = True
            self.dot.configure(fg=WARN)
            self.status_label.configure(
                text=(
                    "队伍数据正在恢复"
                    if recovering_team_data
                    else "队伍数据不完整"
                ),
                fg=WARN,
            )
        elif getattr(self, "_team_stats_warning_active", False):
            self._team_stats_warning_active = False
            if self.connected:
                self.dot.configure(fg=ACCENT)
                self.status_label.configure(text="运行中", fg=MUTED)
        self._set_main_time_value(format_duration(display_duration))
        if self.heartbeat_worker is not None:
            self.heartbeat_worker.update_state(
                using=self.connected,
                character_name=(
                    self.model.display_name(int(self.model.self_id or 0))
                    if self.model.self_id is not None
                    else ""
                ),
                game_pid=self.game_pid,
            )
        self._update_enrage_prediction(now)
        if not self.compact_mode:
            self._draw_monster_hp()
        self._draw_main_rows()
        self._render_skill_details()
        self._sync_main_meter_tabs()
        self._sync_action_buttons()
        self._sync_expiry_label()
        self._sync_backend_sidebar_status()
        self._sync_unlock_window_position()
        self._schedule_main_content_overlay_sync()

    def toggle_names(self) -> None:
        self.hide_names = not self.hide_names
        if self.settings_show_names_var is not None:
            self.settings_show_names_var.set(not self.hide_names)
        self._sync_action_buttons()
        self._save_preferences()
        self._draw_main_rows()
        self._render_skill_details()
        self._draw_history_list()
        self._draw_history_participants()

    def toggle_topmost(self) -> None:
        if (
            getattr(self, "window_locked", False)
            or self._startup_interaction_blocked()
        ):
            return
        value = not self._preferred_main_topmost()
        self._set_main_topmost(value)
        if self.skill_window is not None and self.skill_window.winfo_exists():
            self.skill_window.attributes("-topmost", value)
        if self.feedback_window is not None and self.feedback_window.winfo_exists():
            self.feedback_window.attributes("-topmost", value)
        self._sync_action_buttons()
        self._save_preferences()

    def _set_window_alpha(self, value, *, persist: bool = True) -> None:
        # Kept for old integrations only; the slider has been removed.
        del value
        percent = 100
        self.window_alpha = 1.0
        # Reapply even when the stored value is unchanged. Windows can rebuild
        # a borderless HWND after lock/topmost changes while the Python value
        # remains correct but the native surface has returned to full opacity.
        self._apply_main_transparency()
        if (
            self.opacity_value_label is not None
            and self.opacity_value_label.winfo_exists()
        ):
            self.opacity_value_label.configure(text=f"{percent}%")
        if self.settings_opacity_var is not None:
            try:
                if int(self.settings_opacity_var.get()) != percent:
                    self.settings_opacity_var.set(percent)
            except tk.TclError:
                pass
        self.config["alpha"] = self.window_alpha
        if persist:
            save_config(self.config)

    def reset(self) -> None:
        if self._main_clear_blocked():
            return
        self.model.reset(
            keep_identity=True,
            keep_monsters=True,
            preserve_active_target=True,
            archive_reason="manual_reset",
        )
        self._flush_combat_history()
        self.main_last_battle_result = None
        self._draw_main_rows()
        self._render_skill_details()

    def show_skill_details(
        self, actor_id: int, detail_kind: str | None = None
    ) -> None:
        if self.compact_mode:
            return
        self.skill_actor_id = int(actor_id)
        requested_kind = str(detail_kind or "").casefold()
        if requested_kind not in {"damage", "healing"}:
            requested_kind = (
                "healing"
                if getattr(self, "main_meter_mode", "dps") == "hps"
                else "damage"
            )
        self.skill_panel_mode = requested_kind
        if self.skill_window is None or not self.skill_window.winfo_exists():
            self._build_skill_window()
        else:
            self.skill_window.deiconify()
            self.skill_window.lift()
            self.skill_window.focus_force()
        self._render_skill_details()

    def _initial_skill_geometry(self, x: int, y: int) -> str:
        saved = str(self.config.get("skill_geometry", ""))
        parsed = parse_absolute_tk_geometry(saved)
        if parsed is not None:
            saved_width, saved_height, saved_x, saved_y = parsed
            normalized = format_absolute_tk_geometry(
                saved_width, saved_height, saved_x, saved_y
            )
            position_x, position_y = saved_x, saved_y
        else:
            normalized = format_absolute_tk_geometry(580, 390, x, y)
            position_x, position_y = x, y
        if int(self.config.get("skill_layout_version", 0)) < 3:
            return self._visible_geometry(
                format_absolute_tk_geometry(580, 390, position_x, position_y),
                580,
                390,
            )
        return self._visible_geometry(normalized, 580, 390)

