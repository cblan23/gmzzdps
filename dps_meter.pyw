    def close(self) -> None:
        if self.closing:
            return
        self.closing = True
        for name in (
            "drain_after_id",
            "render_after_id",
            "layered_main_after_id",
            "capture_restart_after_id",
        ):
            after_id = getattr(self, name, None)
            if after_id is not None:
                try:
                    self.root.after_cancel(after_id)
                except (AttributeError, tk.TclError):
                    pass
                setattr(self, name, None)
        self.close_started_at = time.monotonic()
        self.pvp_close_timestamp_ns = time.time_ns()
        # Preserve the active tracker until capture has stopped and queued
        # pre-close observations have drained, including the final hit.
        pvp_uploader = getattr(self, "pvp_upload_worker", None)
        if pvp_uploader is not None:
            pvp_uploader.close()
        self._hide_main_tooltip()
        self._set_window_click_through(self.root, False)
        self._destroy_unlock_window()
        self._destroy_main_content_overlay()
        if self.tray_icon is not None:
            self.tray_icon.stop()
            self.tray_icon = None
        self._close_notice_window()
        self._close_user_notice()
        if self.login_window is not None and self.login_window.winfo_exists():
            try:
                self.login_window.grab_release()
            except tk.TclError:
                pass
            self.login_window.destroy()
        self.login_window = None
        self.login_card_entry = None
        self.login_status_label = None
        self.login_consent_row = None
        self.login_button = None
        self.login_trial_button = None
        self.login_disclaimer_var = None
        self._close_skill_window()
        self._close_hunter_team_panel()
        self._close_history_window(destroy=True)
        self._close_feedback_window()
        self.status_label.configure(
            text=self.close_status_text or "正在安全停止并退出…", fg=WARN
        )
        self._save_preferences()
        self.heartbeat_stop_event.set()
        self.combat_clock_stop_event.set()
        self._request_capture_stop("window_close")
        self.root.after(50, self._finish_close)

    def _ingest_pending_capture_messages(self) -> bool:
        handlers = {
            'pvp_observation': self._handle_pvp_observation,
            'settlement_observation': self._handle_settlement_observation,
            'settlement_capture_gap': lambda payload: self.settlement_ui.mark_gap(),
            'settlement_experiment_record': (
                lambda payload: self.settlement_experiment.statistics_received(
                    payload
                )
            ),
            'immediate_settlement_experiment': (
                lambda payload: self.settlement_experiment.query_event(payload)
            ),
            "event": self._ingest_combat_event,
            "boss_damage_event": self.model.ingest_boss_damage,
            "active_boss": self.model.ingest_active_boss,
            "identity": self.model.ingest_identity,
            "actor_merge": self.model.merge_actor,
            "team_actor_rebind": self.model.rebind_team_actors,
            "party": self.model.ingest_party,
            "profile": self.model.ingest_profile,
            "monster": self._ingest_monster_update,
            "team_stat": self.model.ingest_team_stat,
            "stage_summary": self._ingest_stage_summary,
            "heal": self.model.ingest_heal,
            "actor_health": self.model.ingest_actor_health,
            "combat_state": self._ingest_combat_state,
            "life": self.model.ingest_life,
            "scene": self.model.ingest_scene,
            "name": self.model.ingest_name,
            "skill_name": self.model.ingest_skill_name,
            # ``_finish_close`` drains this queue itself after the normal UI
            # message pump has stopped.  Keep the worker's terminal state in
            # sync here as well; otherwise ``capture_started`` stays true and
            # the updater mistakes an already stopped passive receiver for an
            # unsafe Npcap/Hook shutdown.
            "stopped": self._handle_capture_worker_stopped,
        }
        deadline = time.perf_counter() + CLOSE_DRAIN_TIME_BUDGET_SECONDS
        for _index in range(MESSAGE_DRAIN_BATCH_SIZE):
            try:
                kind, payload = self.messages.get_nowait()
            except queue.Empty:
                return True
            handler = handlers.get(kind)
            if handler is not None:
                pvp_recording = getattr(self, "pvp_recording", None)
                if pvp_recording is not None:
                    if kind in {"identity", "profile", "name", "self_character"}:
                        pvp_recording.ingest_update(kind, payload)
                    elif kind == "scene":
                        pvp_recording.ingest_scene(payload)
                    elif kind == "pvp_observation" and isinstance(payload, dict):
                        if int(payload.get("timestamp_ns") or 0) > getattr(self, "pvp_close_timestamp_ns", time.time_ns()):
                            continue
                handler(payload)
            if time.perf_counter() >= deadline:
                return False
        return self.messages.empty()

    def _show_shutdown_error(self, title: str, message: str) -> None:
        """Keep final update failures inside the application's visual system."""

        try:
            window = tk.Toplevel(self.root)
            self.notice_window = window
            self.notice_parent = self.root
            self.notice_modal = True
            window.withdraw()
            window.title(f"{UI_BRAND} · {title}")
            window.configure(bg=ERROR)
            width, height = 480, 226
            x = max(0, (window.winfo_screenwidth() - width) // 2)
            y = max(0, (window.winfo_screenheight() - height) // 2)
            window.geometry(format_absolute_tk_geometry(width, height, x, y))
            self._prepare_toplevel_dpi(window)
            window.resizable(False, False)
            window.attributes("-topmost", True)
            window.attributes("-alpha", 1.0)
            window.overrideredirect(True)

            def exit_program() -> None:
                self.notice_window = None
                try:
                    window.grab_release()
                except tk.TclError:
                    pass
                try:
                    window.destroy()
                finally:
                    self.root.destroy()

            window.protocol("WM_DELETE_WINDOW", exit_program)
            window.bind("<Escape>", lambda _event: exit_program())
            card = tk.Frame(window, bg=MODAL_SURFACE)
            card.pack(fill="both", expand=True, padx=1, pady=1)
            header = tk.Frame(card, bg=MODAL_HEADER, height=48)
            header.pack(fill="x")
            header.pack_propagate(False)
            tk.Frame(header, bg=ERROR, width=4).pack(side="left", fill="y")
            tk.Label(
                header,
                text=title,
                bg=MODAL_HEADER,
                fg=TEXT,
                anchor="w",
                font=self._ui_font("title"),
            ).pack(side="left", fill="both", expand=True, padx=14)
            self._titlebar_icon_button(
                header,
                "close",
                exit_program,
                width=48,
                height=48,
                bg=MODAL_HEADER,
                hover="#562631",
                fg="#b8c3ce",
            ).pack(side="right", fill="y")
            content = tk.Frame(card, bg=MODAL_SURFACE)
            content.pack(fill="both", expand=True, padx=22, pady=(18, 16))
            tk.Label(
                content,
                text=message,
                bg=MODAL_SURFACE,
                fg=TEXT,
                justify="left",
                anchor="nw",
                wraplength=432,
                font=self._ui_font("small"),
            ).pack(fill="both", expand=True)
            self._history_modal_action(
                content,
                "退出程序",
                exit_program,
                danger=True,
            ).pack(side="right")
            window.deiconify()
            window.lift()
            window.grab_set()
            window.focus_force()
        except tk.TclError:
            print(f"{title}: {message}", file=sys.stderr)
            self.root.destroy()

    def _finish_close(self) -> None:
        if self.close_finalized:
            return
        if self.worker.is_alive():
            if getattr(self, "pending_update_install", None) is not None:
                elapsed = max(0.0, time.monotonic() - self.close_started_at)
                if elapsed >= UPDATE_CLOSE_GAME_NOTICE_SECONDS:
                    text = (
                        "采集组件仍在安全退出；请关闭游戏，关闭后将自动继续更新。"
                    )
                elif elapsed >= CAPTURE_PROCESS_SLOW_SHUTDOWN_SECONDS:
                    text = "正在等待采集组件安全退出，请勿强制结束程序…"
                else:
                    text = "正在安全停止采集…"
                self.status_label.configure(text=text, fg=WARN)
                if self.update_status_label is not None:
                    self.update_status_label.configure(text=text, fg=WARN)
            self.root.after(50, self._finish_close)
            return
        heartbeat_alive = bool(
            self.heartbeat_worker is not None and self.heartbeat_worker.is_alive()
        )
        heartbeat_grace_active = bool(
            heartbeat_alive
            and time.monotonic() - self.close_started_at
            < CLOSE_HEARTBEAT_GRACE_SECONDS
        )
        if heartbeat_grace_active:
            self.root.after(50, self._finish_close)
            return
        if not self._ingest_pending_capture_messages():
            self.root.after(1, self._finish_close)
            return
        pvp_recording = getattr(self, "pvp_recording", None)
        if pvp_recording is not None:
            pvp_recording.reset_context(
                getattr(self, "pvp_close_timestamp_ns", None), reason="application_exit"
            )
            pvp_recording.bind_account("")
        pvp_uploader = getattr(self, "pvp_upload_worker", None)
        if pvp_uploader is not None:
            finish_equipment = getattr(
                pvp_uploader, "finish_equipment_snapshots", None
            )
            if callable(finish_equipment) and not finish_equipment():
                experiment = getattr(self, "settlement_experiment", None)
                if experiment is not None:
                    experiment.lifecycle(
                        "equipment_snapshot_queue_failed",
                        component="main_window",
                        error_type="PersistenceIncomplete",
                    )
            pvp_uploader.unbind_request()
        self.close_finalized = True
        self.model.archive_current("exit")
        self._flush_combat_history(force=True)
        self._save_preferences()
        pending_install = getattr(self, "pending_update_install", None)
        shutdown_error: tuple[str, str] | None = None
        if pending_install is not None:
            diagnostics = self.worker.diagnostic_snapshot()
            # Reaching this point means the capture worker has exited and its
            # ``finally`` cleanup has completed.  The default Windows packet
            # source is receive-only and has no Npcap driver to stop.  Block an
            # update only for an explicit in-process cleanup failure, not for a
            # stale/missing historical ``hook_cleanup_verified`` flag.
            cleanup_error_component = str(
                diagnostics.get("hook_cleanup_error_component", "") or ""
            ).strip()
            if cleanup_error_component:
                self.pending_update_install = None
                shutdown_error = (
                    "更新已取消",
                    "检测到游戏内采集调用恢复失败。本次不会强制安装；"
                    "请先关闭游戏，再重新打开程序进行更新。",
                )
            else:
                update_path, target_path, previous_path = pending_install
                try:
                    self._launch_update_replacer(
                        update_path,
                        target_path=target_path,
                        legacy_target_path=previous_path,
                    )
                except OSError as exc:
                    shutdown_error = (
                        "无法启动更新程序",
                        f"更新包已下载，但安装程序启动失败：{exc}",
                    )
        if shutdown_error is not None:
            self._show_shutdown_error(*shutdown_error)
            return
        layered_after = getattr(self, "layered_main_after_id", None)
        if layered_after is not None:
            try:
                self.root.after_cancel(layered_after)
            except tk.TclError:
                pass
            self.layered_main_after_id = None
        layered_presenter = getattr(self, "layered_main_presenter", None)
        if layered_presenter is not None:
            layered_presenter.close()
            self.layered_main_presenter = None
        self.root.destroy()

    def run(self) -> None:
        self.root.mainloop()


def verify_official_runtime() -> None:
    """Reject incomplete, modified, or repackaged protected distributions."""
    if not IS_FROZEN:
        return
    if not RELEASE_IDENTITY.valid_build:
        raise RuntimeError(
            RELEASE_IDENTITY.error or "正式发行包缺少有效的 Build ID。"
        )
    if (
        RELEASE_IDENTITY.version != APP_VERSION
        or RELEASE_IDENTITY.client_build != CLIENT_BUILD
    ):
        raise RuntimeError("发行身份与客户端版本不一致。")
    if not (RELEASE_IDENTITY.official or RELEASE_IDENTITY.protected):
        # Development binaries receive unique identities but may use the
        # explicit local runtime profile and are never registered as protected.
        return
    if RELEASE_IDENTITY.protected:
        if not RELEASE_IDENTITY.valid_protected:
            raise RuntimeError("受保护发行包缺少可信的采集授权公钥。")
        if (BUNDLE_DIR / "runtime-profile.dev.json").is_file():
            raise RuntimeError("受保护发行包错误地包含了开发采集配置。")
    resources_valid, resource_error = verify_release_resources(
        RELEASE_IDENTITY, BUNDLE_DIR
    )
    if not resources_valid:
        raise RuntimeError(resource_error)
    if not RELEASE_IDENTITY.official:
        return
    publisher = verify_windows_publisher(
        APP_EXECUTABLE_PATH,
        RELEASE_IDENTITY.publisher_thumbprints,
        require_trusted_chain=True,
    )
    if not publisher.verified:
        raise RuntimeError(
            publisher.message or "正式客户端的发布者签名验证失败。"
        )


def prepare_windows_startup() -> bool:
    """Elevate the portable executable, then probe the passive packet source."""
    if not is_process_elevated():
        relaunch_as_admin(
            frozen=IS_FROZEN,
            application_path=APP_EXECUTABLE_PATH,
            source_path=Path(__file__).resolve(),
            python_executable=Path(sys.executable),
            arguments=sys.argv[1:],
            working_directory=APP_DIR,
        )
        return False
    ensure_passive_capture_ready(BUNDLE_DIR, CAPTURE_BACKEND_NAME)
    return True


def main() -> None:
    instance_guard = (
        SingleInstanceGuard(CAPTURE_MUTEX_NAME)
        if CAPTURE_MUTEX_NAME
        else SingleInstanceGuard()
    )
    try:
        verify_official_runtime()
        if not prepare_windows_startup():
            return
        instance_guard.acquire()
        if instance_guard.already_running:
            if CAPTURE_TRAY_CLASS_PREFIX:
                activate_existing_instance(
                    attempts=20,
                    tray_class_prefix=CAPTURE_TRAY_CLASS_PREFIX,
                )
            else:
                activate_existing_instance(attempts=20)
            return
        # Select process DPI awareness before Tk creates its first HWND.
        enable_windows_dpi_awareness()
        DpsWindow().run()
    except StartupBootstrapError as exc:
        show_startup_message(str(exc), title=exc.title)
    except Exception:
        details = traceback.format_exc()
        try:
            (APP_DIR / "dps_error.log").write_text(details, encoding="utf-8")
        except Exception:
            pass
    finally:
        instance_guard.close()


if __name__ == "__main__":
    multiprocessing.freeze_support()
    main()
