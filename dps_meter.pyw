    def ingest_dungeon_context(self, payload: object) -> None:
        """Attach protocol-confirmed dungeon IDs to the current archive only."""
        if not isinstance(payload, dict):
            return
        try:
            dungeon_id = max(0, int(payload.get("dungeon_id", 0) or 0))
            stage_id = max(
                0, int(payload.get("dungeon_stage_id", 0) or 0)
            )
            stage_phase = max(
                0, int(payload.get("dungeon_stage_phase", 0) or 0)
            )
            context_filetime = max(
                0, int(payload.get("dungeon_context_filetime", 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            return
        if dungeon_id:
            self.current_dungeon_id = dungeon_id
        if stage_id:
            self.current_dungeon_stage_id = stage_id
        self.current_dungeon_stage_phase = stage_phase
        self.current_dungeon_context_filetime = max(
            self.current_dungeon_context_filetime, context_filetime
        )

        combat_started = bool(self.first_damage_time or self.first_healing_time)
        if not combat_started:
            self.encounter_dungeon_id = self.current_dungeon_id
            self.encounter_dungeon_stage_id = self.current_dungeon_stage_id
            self.encounter_dungeon_stage_phase = self.current_dungeon_stage_phase
            self.encounter_dungeon_context_filetime = (
                self.current_dungeon_context_filetime
            )
            return
        if not self.encounter_dungeon_id and self.current_dungeon_id:
            self.encounter_dungeon_id = self.current_dungeon_id
        if not self.encounter_dungeon_stage_id and self.current_dungeon_stage_id:
            self.encounter_dungeon_stage_id = self.current_dungeon_stage_id
        if not self.encounter_dungeon_stage_phase and stage_phase:
            self.encounter_dungeon_stage_phase = stage_phase
        if not self.encounter_dungeon_context_filetime and context_filetime:
            self.encounter_dungeon_context_filetime = context_filetime

    def ingest_enrage_countdown(self, payload: object) -> bool:
        """Retain a verified phase edge for the read-only enrage predictor."""

        if not isinstance(payload, dict):
            return False
        signal = str(payload.get("signal", "") or "").strip()
        try:
            timestamp = max(0, int(payload.get("filetime_100ns", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            return False
        if not signal or not timestamp:
            return False
        if (
            signal == self.enrage_countdown_signal
            and self.enrage_countdown_start_100ns
        ):
            return False
        self.enrage_countdown_signal = signal
        self.enrage_countdown_start_100ns = timestamp
        return True

    def _catalog_target_metadata(self, template_id: object) -> dict:
        try:
            parsed_template_id = int(template_id or 0)
        except (TypeError, ValueError, OverflowError):
            return {}
        metadata = self.target_catalog.get(str(parsed_template_id), {})
        return metadata if isinstance(metadata, dict) else {}

    def _catalog_marks_known_non_boss(self, template_id: object) -> bool:
        """Return whether exact exported metadata forbids Boss promotion."""
        try:
            parsed_template_id = int(template_id or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            parsed_template_id <= 0
            or parsed_template_id in EXPLICIT_NON_TYPE3_BOSS_TEMPLATE_IDS
            or parsed_template_id in DAMAGE_TARGET_TEMPLATE_IDS
        ):
            return False
        metadata = self._catalog_target_metadata(parsed_template_id)
        if not metadata or "boss_type" not in metadata:
            return False
        try:
            return int(metadata.get("boss_type", 0) or 0) != 3
        except (TypeError, ValueError, OverflowError):
            return False

    def _apply_catalog_target_identity(self, monster: MonsterStats) -> bool:
        """Fill exact target identity from its captured template ID.

        A useful live/localized name always wins.  The catalog is consulted
        only for an empty or placeholder name, so late generic labels such as
        ``Boss``/``未知目标`` cannot erase a verified target identity.
        """
        metadata = self._catalog_target_metadata(monster.template_id)
        if not metadata:
            return False
        changed = False
        canonical_name = _catalog_boss_name(
            self.target_catalog, monster.template_id
        )
        existing_name = (
            monster.name or self.entity_names.get(monster.entity_id, "")
        ).strip()
        authoritative_name = (
            int(monster.template_id or 0)
            in AUTHORITATIVE_BOSS_NAME_TEMPLATE_IDS
        )
        if canonical_name and (
            authoritative_name
            or not existing_name
            or boss_name_is_placeholder(existing_name)
        ):
            if monster.name != canonical_name:
                monster.name = canonical_name
                changed = True
            if self.entity_names.get(monster.entity_id) != canonical_name:
                self.entity_names[monster.entity_id] = canonical_name
                changed = True
        canonical_level = _catalog_boss_level(
            self.target_catalog, monster.template_id
        )
        if canonical_level is not None and not monster.level:
            monster.level = canonical_level
            changed = True
        return changed

    def set_boss_only(self, value: bool) -> bool:
        value = bool(value)
        if value == self.boss_only:
            return False
        self.reset(
            keep_identity=True,
            keep_monsters=True,
            archive_reason="target_filter_changed",
        )
        self.boss_only = value
        self._resolve_combat_sides()
        self._recompute()
        return True

    def reset(
        self,
        *,
        keep_identity: bool = True,
        keep_monsters: bool = False,
        preserve_active_target: bool = False,
        archive_reason: str = "reset",
        archive_current_record: bool = True,
    ) -> None:
        preserved_target_id: int | None = None
        carried_skill_cast_events: list[dict] = []
        if archive_reason in {"new_encounter", "team_counter_reset"}:
            previous_end = (
                self.combat_end_time
                or self.healing_end_time
                or self.last_damage_time
                or self.last_healing_time
            )
            if previous_end:
                for event in self.skill_cast_events:
                    try:
                        if self._event_seconds(event) > previous_end:
                            carried_skill_cast_events.append(event)
                    except (KeyError, TypeError, ValueError, OverflowError):
                        continue
        if preserve_active_target and not self.combat_end_time:
            candidate = self.monsters.get(int(self.combat_target_id or 0))
            if (
                candidate is not None
                and self._is_priority_target(candidate.entity_id)
                and not (
                    candidate.death_confirmed
                    and candidate.current_hp is not None
                    and candidate.current_hp <= 0
                )
            ):
                preserved_target_id = candidate.entity_id
        if archive_current_record:
            self.archive_current(archive_reason)
        self.long_gap_phase_suspended = False
        self.long_gap_phase_predecessor_entity_id = 0
        self.long_gap_phase_predecessor_template_id = 0
        self.long_gap_phase_suspended_at_100ns = 0
