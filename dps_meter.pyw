    def _sync_history_player_heading_layout(self, width: int | None = None) -> None:
        heading = getattr(self, "history_player_heading", None)
        stats = getattr(self, "history_player_stats_frame", None)
        identity = getattr(self, "history_player_identity_frame", None)
        pairs = getattr(self, "history_player_stat_pairs", ())
        if heading is None or stats is None or identity is None or len(pairs) != 4:
            return
        try:
            if not heading.winfo_exists():
                return
        except tk.TclError:
            return
        panel = heading.master
        width = max(1, int(width if width is not None else panel.winfo_width()))
        micro = self._ui_font("micro")
        minimum_identity = max(
            320,
            self._ui_font("title").measure("请选择队员")
            + micro.measure("非凡评分 999,999") + 95,
        )
        number_width = self._ui_font("number_strong").measure("59,392,271") + 22
        minimum_stats = sum(
            max(int(card.cget("width")), number_width) for card, _, _ in pairs
        )
        compact = width < minimum_stats + minimum_identity
        identity_height = max(
            92,
            self._ui_font("title").metrics("linespace")
            + 2 * micro.metrics("linespace") + 40,
        )
        row_height = max(
            58, micro.metrics("linespace")
            + self._ui_font("number_strong").metrics("linespace") + 18,
        )
        state = (compact, identity_height, row_height)
        if state == getattr(self, "history_player_heading_layout_state", None):
            return
        self.history_player_heading_layout_state = state
        stats.pack_forget()
        identity.pack_forget()
        stats.pack_propagate(False)
        stats.grid_propagate(False)
        if compact:
            identity.pack(side="top", fill="x", padx=(12, 5))
            stats.configure(height=2 * row_height)
            stats.pack(side="top", fill="x")
        else:
            stats.configure(
                width=sum(int(card.cget("width")) for card, _, _ in pairs),
                height=identity_height,
            )
            stats.pack(side="right", fill="y")
            identity.pack(side="left", fill="both", expand=True, padx=(12, 5))
        for column in range(4):
            stats.grid_columnconfigure(column, weight=1 if compact and column < 2 else 0)
        stats.grid_rowconfigure(0, weight=1)
        stats.grid_rowconfigure(1, weight=1 if compact else 0)
        for index, (card, caption, value) in enumerate(pairs):
            card.grid_configure(
                row=index // 2 if compact else 0,
                column=index % 2 if compact else index,
            )
            caption.pack_configure(pady=(6 if compact else 21, 0))
            value.pack_configure(pady=(2 if compact else 4, 0))
        heading.configure(height=identity_height + (2 * row_height if compact else 0))

