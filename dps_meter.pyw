    def _update_history_overview(self) -> None:
        data = getattr(self, "history_overview_data", {})
        if getattr(self, "backend_current_page", "history") == "kings":
            values = {
                "battle_count": f"{int(data.get('battle_count', 0) or 0):,}",
                "today_count": self._history_optional_number(
                    data.get("total_kills")
                ),
                "average_dps": self._history_optional_number(
                    data.get("total_assists")
                ),
                "highest_damage": self._history_optional_number(
                    data.get("total_deaths")
                ),
            }
            for key, value in values.items():
                label = self.history_overview_labels.get(key)
                if label is not None:
                    label.configure(text=value)
            for key, caption in (
                ("battle_count", "总场次"),
                ("today_count", "总击杀"),
                ("average_dps", "总助攻"),
                ("highest_damage", "总阵亡"),
            ):
                label = self.history_overview_labels.get(f"{key}_caption")
                if label is not None:
                    label.configure(text=caption)
            for key, text in (
                ("battle_count_subtitle", "当前筛选条件"),
                ("today_count_subtitle", "本人最终击杀"),
                ("highest_damage_subtitle", "本人累计阵亡"),
            ):
                label = self.history_overview_labels.get(key)
                if label is not None:
                    label.configure(text=text)
            return
        mode = getattr(self, "history_meter_mode", "dps")
        boss_mode = mode == "boss_damage"
        average_key, average_caption = {
            "dps": ("average_dps", "平均 DPS"),
            "hps": ("average_hps", "平均 HPS"),
            "dt": ("average_taken", "平均承伤"),
            "boss_damage": (
                "average_boss_classification_ratio",
                "平均归类比例",
            ),
        }.get(mode, ("average_dps", "平均 DPS"))
        average_value = (
            self._history_rate_text(data.get(average_key))
            if boss_mode
            else self._history_optional_number(data.get(average_key))
        )
        values = {
            "battle_count": f"{int(data.get('battle_count', 0) or 0):,}",
            "today_count": f"{int(data.get('today_count', 0) or 0):,}",
            "average_dps": average_value,
            "highest_damage": self._history_optional_number(
                data.get(
                    "highest_boss_observed_damage"
                    if boss_mode
                    else "highest_damage"
                )
            ),
            "average_duration": (
                format_duration(float(data.get("average_duration")))
                if data.get("average_duration") is not None
                else "--"
            ),
        }
        for key, value in values.items():
            label = self.history_overview_labels.get(key)
            if label is not None:
                label.configure(text=value)
        average_caption_label = self.history_overview_labels.get(
            "average_dps_caption"
        )
        if average_caption_label is not None:
            average_caption_label.configure(text=average_caption)
        highest_caption_label = self.history_overview_labels.get(
            "highest_damage_caption"
        )
        if highest_caption_label is not None:
            highest_caption_label.configure(
                text="最高已归类伤害" if boss_mode else "最高伤害"
            )
        today_subtitle = self.history_overview_labels.get("today_count_subtitle")
        if today_subtitle is not None:
            today_subtitle.configure(text=dt.datetime.now().strftime("%m月%d日 · 今日"))
        highest_dungeon = str(
            data.get(
                "highest_boss_dungeon_name"
                if boss_mode
                else "highest_dungeon_name",
                "",
            )
        ).strip()
        highest_boss = str(
            data.get(
                "highest_boss_damage_name"
                if boss_mode
                else "highest_boss_name",
                "",
            )
        ).strip()
        highest_subtitle = self.history_overview_labels.get(
            "highest_damage_subtitle"
        )
        if highest_subtitle is not None:
            available = max(80, highest_subtitle.winfo_width() - 20)
            source_lines = []
            if highest_boss:
                source_lines.append(
                    f"Boss · {self._fit_ui_text(highest_boss, available, 'micro')}"
                )
            if highest_dungeon:
                source_lines.append(
                    f"副本 · {self._fit_ui_text(highest_dungeon, available, 'micro')}"
                )
            highest_subtitle.configure(
                text="\n".join(source_lines)
                if source_lines
                else "暂无首领伤害数据"
                if boss_mode
                else "暂无有效本人数据"
            )
        duration_subtitle = self.history_overview_labels.get(
            "average_duration_subtitle"
        )
        if duration_subtitle is not None:
            timed_count = int(data.get("timed_count", 0) or 0)
            duration_subtitle.configure(
                text=f"有效计时 {timed_count} 场" if timed_count else "暂无有效计时"
            )

    @staticmethod
    def _feedback_history_batch_summary(record: dict) -> dict[str, object]:
        """Keep multi-battle feedback useful without exceeding the server body limit."""

        summary = DpsWindow._feedback_history_summary(record)
        compact_participants: list[dict[str, object]] = []
        for participant in summary.get("participants", []):
            if not isinstance(participant, dict):
                continue
            compact = {
                key: participant.get(key)
                for key in (
                    "actor_id",
                    "name",
                    "is_self",
                    "profession_id",
                    "damage",
                    "dps",
                    "share",
                    "hits",
                    "max_hit",
                    "damage_hits",
                    "critical_hits",
                    "critical_rate",
                    "penetration_hits",
                    "penetration_rate",
                    "deaths",
                    "revives",
                    "death_duration_seconds",
                    "is_ai",
                    "extraordinary_rating",
                )
            }
            skills = [
                skill
                for skill in participant.get("skills", [])
                if isinstance(skill, dict)
            ]
            skills.sort(
                key=lambda skill: int(skill.get("damage", 0) or 0),
                reverse=True,
            )
            compact["skills"] = [
                {
                    key: skill.get(key)
                    for key in (
                        "skill_id",
                        "name",
                        "damage",
                        "hits",
                        "max_hit",
                        "critical_hits",
                        "penetration_hits",
                    )
                }
                for skill in skills[:3]
            ]
            targets = [
                target
                for target in participant.get("targets", [])
                if isinstance(target, dict)
            ]
            targets.sort(
                key=lambda target: int(target.get("damage", 0) or 0),
                reverse=True,
            )
            compact["targets"] = [
                {
                    key: target.get(key)
                    for key in ("entity_id", "name", "kind", "damage")
                }
                for target in targets[:2]
            ]
            compact_participants.append(compact)
        summary["participants"] = compact_participants
        accounting = summary.get("damage_accounting")
        summary["damage_accounting"] = (
            {
                key: value
                for key, value in accounting.items()
                if not isinstance(value, (dict, list, tuple, set))
            }
            if isinstance(accounting, dict)
            else {}
        )
        summary.pop("capture_pipeline_at_archive", None)
        return summary

    @staticmethod
    def _history_optional_number(value: object) -> str:
        if value is None:
            return "--"
        try:
            parsed = float(value)
        except (TypeError, ValueError, OverflowError):
            return "--"
        return format_number(parsed) if math.isfinite(parsed) else "--"

    @staticmethod
    def _history_numeric_float(value: object) -> float:
        if isinstance(value, str):
            value = value.replace(",", "").replace("，", "").strip()
        try:
            parsed = float(value or 0.0)
        except (TypeError, ValueError, OverflowError):
            return 0.0
        return parsed if math.isfinite(parsed) else 0.0

    @staticmethod
    def _history_optional_ratio(value: object) -> float | None:
        if value is None or isinstance(value, bool):
            return None
        try:
            parsed = float(value)
        except (TypeError, ValueError, OverflowError):
            return None
        if not math.isfinite(parsed):
            return None
        return max(0.0, min(1.0, parsed))

    @staticmethod
    def _history_optional_duration(value: object) -> str:
        if value is None:
            return "--"
        try:
            parsed = float(value)
        except (TypeError, ValueError, OverflowError):
            return "--"
        return format_duration(parsed) if parsed > 0 else "--"

    @staticmethod
    def _history_settlement_presentation(
        value: object,
    ) -> tuple[str, str] | None:
        """History shows outcomes and metrics, not internal settlement flags."""

        del value
        return None

    @staticmethod
    def _history_skill_count_presentation(
        participant: object,
    ) -> tuple[str, str]:
        if (
            isinstance(participant, dict)
            and str(participant.get("combat_mode", "")).casefold() == "pvp"
        ):
            return "命中 / 释放", "命中和释放来自不同协议事件，分别统计"
        return "次数", ""

    @staticmethod
    def _history_encounter_title(summary: dict) -> str:
        stage_name = str(summary.get("stage_name", "")).strip()
        dungeon_name = str(summary.get("dungeon_name", "")).strip()
        boss_name = str(summary.get("boss_name", "")).strip()
        monster = summary.get("monster")
        monster_name = (
            str(monster.get("name", "")).strip()
            if isinstance(monster, dict) else ""
        )
        try:
            boss_count = int(summary.get("boss_count", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            boss_count = 0
        if boss_count > 1:
            return stage_name or dungeon_name or boss_name or monster_name or "未知关卡"
        return stage_name or boss_name or monster_name or dungeon_name or "未知关卡"

    @staticmethod
    def _balanced_history_page_size(total: object, maximum: object) -> int:
        """Distribute records evenly so the last page is not mostly empty."""

        try:
            total_count = max(0, int(total or 0))
            maximum_count = max(1, int(maximum or 1))
        except (TypeError, ValueError, OverflowError):
            return 1
        if total_count <= maximum_count:
            return maximum_count
        page_count = (total_count + maximum_count - 1) // maximum_count
        return (total_count + page_count - 1) // page_count

    def _history_list_performance(self, summary: dict) -> tuple[str, str]:
        if getattr(self, "backend_current_page", "history") == "kings":
            return (
                f"击 {self._history_optional_number(summary.get('kills'))}  ·  "
                f"助 {self._history_optional_number(summary.get('assists'))}  ·  "
                f"亡 {self._history_optional_number(summary.get('deaths'))}",
                "本场战果 · 伤害 "
                f"{self._history_optional_number(summary.get('my_damage'))}",
            )
        mode = getattr(self, "history_meter_mode", "dps")
        if mode == "boss_damage":
            coverage = str(summary.get("boss_damage_coverage", ""))
            if coverage not in {"complete", "observed_partial", "conflict"}:
                if (
                    summary.get("boss_damage_unavailable_reason")
                    == "training_dummy"
                ):
                    return "训练目标", "不会主动造成伤害"
                return "首领伤害 --", "该场未记录首领伤害"
            damage = self._history_optional_number(
                summary.get("boss_observed_damage")
            )
            return (
                f"{damage} 首领伤害" if damage != "--" else "首领伤害 --",
                "",
            )
        if mode == "hps":
            hps = self._history_optional_number(summary.get("my_hps"))
            healing = self._history_optional_number(
                summary.get("my_effective_healing")
            )
            return (
                f"{hps} HPS" if hps != "--" else "HPS --",
                f"{healing} 有效治疗" if healing != "--" else "有效治疗 --",
            )
        if mode == "dt":
            taken = self._history_optional_number(summary.get("my_taken"))
            try:
                my_taken = float(summary.get("my_taken"))
                team_taken = float(summary.get("team_taken"))
                share = (
                    f"承伤占比 {max(0.0, my_taken) / team_taken * 100:.1f}%"
                    if team_taken > 0
                    else "承伤占比 --"
                )
            except (TypeError, ValueError, OverflowError):
                share = "承伤占比 --"
            return (
                f"{taken} DT" if taken != "--" else "DT --",
                share,
            )
        team_dps = self._history_optional_number(summary.get("team_dps"))
        my_dps = self._history_optional_number(summary.get("my_dps"))
        return (
            f"团队 {team_dps} DPS" if team_dps != "--" else "团队 DPS --",
            f"我的 {my_dps} DPS" if my_dps != "--" else "我的 DPS --",
        )

    def _set_history_page(self, page: int) -> None:
        page = min(self.history_page_count, max(1, int(page)))
        if page == self.history_page_number:
            return
        self.history_page_number = page
        self._query_history_records()

    def _draw_history_pagination(self) -> None:
        control = getattr(self, "history_pagination_control", None)
        if control is None:
            return
        page = self.history_page_number
        count = self.history_page_count
        control.set(page, count)
        range_label = getattr(self, "history_page_range_label", None)
        if range_label is None:
            return
        total = max(0, int(getattr(self, "history_total_records", 0) or 0))
        if not total:
            range_label.configure(text="暂无记录")
            return
        effective_size = max(
            1,
            int(
                getattr(
                    self,
                    "history_effective_page_size",
                    self.history_page_size,
                )
                or self.history_page_size
            ),
        )
        start = (page - 1) * effective_size + 1
        shown_count = len(getattr(self, "history_records", ()))
        end = min(total, start + max(0, shown_count - 1))
        range_label.configure(text=f"当前 {start}–{end} 条")

    def _toggle_history_select_all(self) -> None:
        page_ids = {
            str(row.get("battle_id", row.get("encounter_id", "")))
            for row in self.history_records
            if str(row.get("battle_id", row.get("encounter_id", "")))
        }
        if page_ids and page_ids.issubset(self.history_selected_ids):
            self.history_selected_ids.difference_update(page_ids)
        else:
            self.history_selected_ids.update(page_ids)
        self._sync_history_selection_controls()
        self._draw_history_list()

    def _toggle_history_row_selection(self, battle_id: str) -> None:
        battle_id = str(battle_id)
        if battle_id in self.history_selected_ids:
            self.history_selected_ids.discard(battle_id)
        elif battle_id:
            self.history_selected_ids.add(battle_id)
        self._sync_history_selection_controls()
        self._draw_history_list()

    def _sync_history_selection_controls(self) -> None:
        selected_count = len(self.history_selected_ids)
        self._draw_history_list_header()
        button = getattr(self, "history_feedback_button", None)
        if button is not None:
            button._disabled = not bool(selected_count)
            button._normal_fg = TEXT if selected_count else SUBTLE
            button.configure(
                fg=TEXT if selected_count else SUBTLE,
                cursor="hand2" if selected_count else "arrow",
            )
        if self.history_count_label is not None:
            suffix = f" · 已选 {selected_count}" if selected_count else ""
            self.history_count_label.configure(
                text=f"共 {self.history_total_records} 场{suffix}"
            )

    def _select_highest_history_record(self) -> None:
        overview = getattr(self, "history_overview_data", {})
        battle_id = str(
            overview.get(
                "highest_boss_battle_id"
                if getattr(self, "history_meter_mode", "dps") == "boss_damage"
                else "highest_battle_id",
                "",
            )
        )
        if not battle_id:
            return
        if self.history_sort_var is not None:
            self.history_sort_var.set("伤害最高")
        self.history_page_number = 1
        self._query_history_records()
        if any(
            str(row.get("battle_id", "")) == battle_id
            for row in self.history_records
        ):
            self._select_history(battle_id)

    @staticmethod
    def _history_result_presentation(result: object) -> tuple[str, str]:
        return {
            RESULT_DEFEATED: ("胜利", ACCENT),
            "success": ("胜利", ACCENT),
            RESULT_FAILED: ("失败", ERROR),
            "failure": ("失败", ERROR),
            RESULT_INTERRUPTED: ("中断", WARN),
            "pvp_unknown": ("未知", WARN),
            "pvp_no_result": ("该类型无结果", MUTED),
        }.get(str(result), ("中断", WARN))

    def _draw_history_detail_result(self) -> None:
        canvas = getattr(self, "history_detail_result_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        summary = self._selected_history_summary()
        if summary is None:
            canvas.create_text(
                width - 2,
                height // 2,
                text="--",
                fill=MUTED,
                anchor="e",
                font=self._ui_font("title"),
            )
            return
        self._draw_history_result_badge(
            canvas,
            width - 2,
            height // 2,
            summary.get("result"),
            PANEL,
        )

    def _draw_history_player_share(self) -> None:
        canvas = getattr(self, "history_player_share_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        mode = getattr(self, "history_meter_mode", "dps")
        rows = (
            self._history_boss_sources(record)
            if mode == "boss_damage"
            else record.get(
                "healers"
                if mode == "hps"
                else "damage_taken" if mode == "dt" else "participants",
                [],
            )
            if isinstance(record, dict)
            else []
        )
        rows = rows if isinstance(rows, list) else []
        participant = next(
            (
                row
                for row in rows
                if isinstance(row, dict)
                and int(
                    row.get(
                        "entity_id" if mode == "boss_damage" else "actor_id",
                        0,
                    )
                    or 0
                )
                == int(getattr(self, "history_selected_actor", 0) or 0)
            ),
            None,
        )
        ratio = 0.0
        color = ACCENT
        if isinstance(participant, dict):
            if mode == "boss_damage":
                color = "#e67d72"
            else:
                class_id = int(participant.get("profession_id", 0) or 0)
                _profession, color = self._profession_info(class_id)
            try:
                if mode == "hps":
                    total = max(
                        0.0,
                        float(record.get("team_effective_healing", 0.0) or 0.0),
                    )
                    value = max(
                        0.0,
                        float(participant.get("effective_healing", 0.0) or 0.0),
                    )
                    ratio = value / total if total else 0.0
                else:
                    ratio = float(participant.get("share", 0.0) or 0.0)
            except (TypeError, ValueError, OverflowError):
                ratio = 0.0
        ratio = max(0.0, min(1.0, ratio))
        canvas.create_rectangle(0, 0, width, height, fill="#22272d", outline="")
        if ratio > 0:
            canvas.create_rectangle(
                0,
                0,
                max(3, int(width * ratio)),
                height,
                fill=color,
                outline="",
            )

    def _draw_history_result_badge(
        self,
        canvas: tk.Canvas,
        right_x: int,
        center_y: int,
        result: object,
        background: str,
        tags: tuple[str, ...] = (),
    ) -> int:
        """Draw one of the three battle-result states as a themed status badge."""

        result_key = str(result)
        if result_key in {RESULT_DEFEATED, "success"}:
            kind = "victory"
        elif result_key in {RESULT_FAILED, "failure"}:
            kind = "failed"
        else:
            kind = "interrupted"
        text, color = self._history_result_presentation(result_key)
        font = self._ui_font("micro")
        badge_width = max(64, font.measure(text) + 36)
        badge_height = 26
        right = int(right_x)
        left = right - badge_width
        top = int(center_y) - badge_height // 2
        bottom = top + badge_height
        cut = 5
        if kind == "victory":
            points = (
                left + cut,
                top,
                right - cut,
                top,
                right,
                top + cut,
                right,
                bottom,
                left + cut,
                bottom,
                left,
                center_y,
            )
        elif kind == "failed":
            points = (
                left + cut,
                top,
                right - cut,
                top,
                right,
                top + cut,
                right - cut,
                bottom,
                left + cut,
                bottom,
                left,
                bottom - cut,
                left,
                top + cut,
            )
        else:
            points = (
                left,
                top,
                right - cut,
                top,
                right,
                top + cut,
                right,
                bottom - cut,
                right - cut,
                bottom,
                left,
                bottom,
                left + cut,
                center_y,
            )
        canvas.create_polygon(
            points,
            fill=blend_color(background, color, 0.13),
            outline=blend_color(background, color, 0.72),
            width=1,
            tags=tags,
        )
        canvas.create_line(
            left + 7,
            top + 2,
            right - 7,
            top + 2,
            fill=blend_color(background, color, 0.42),
            width=1,
            tags=tags,
        )
        symbol_x = left + 15
        if kind == "victory":
            canvas.create_line(
                symbol_x - 5,
                center_y,
                symbol_x - 1,
                center_y + 4,
                symbol_x + 6,
                center_y - 5,
                fill=color,
                width=2,
                capstyle=tk.ROUND,
                joinstyle=tk.ROUND,
                tags=tags,
            )
        elif kind == "failed":
            for direction in (-1, 1):
                canvas.create_line(
                    symbol_x - 5,
                    center_y - direction * 5,
                    symbol_x + 5,
                    center_y + direction * 5,
                    fill=color,
                    width=2,
                    capstyle=tk.ROUND,
                    tags=tags,
                )
        else:
            canvas.create_rectangle(
                symbol_x - 5,
                center_y - 5,
                symbol_x - 2,
                center_y + 5,
                fill=color,
                outline="",
                tags=tags,
            )
            canvas.create_rectangle(
                symbol_x + 2,
                center_y - 5,
                symbol_x + 5,
                center_y + 5,
                fill=color,
                outline="",
                tags=tags,
            )
        canvas.create_text(
            left + 29,
            center_y,
            text=text,
            fill=color,
            anchor="w",
            font=font,
            tags=tags,
        )
        return badge_width

    def _draw_history_snapshot_result(self) -> None:
        canvas = getattr(self, "history_snapshot_result_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        summary = self._selected_history_summary()
        if summary is None:
            canvas.create_text(
                0,
                height // 2,
                text="--",
                fill=MUTED,
                anchor="w",
                font=self._ui_font("number_strong"),
            )
            return
        self._draw_history_result_badge(
            canvas,
            min(width - 1, 72),
            height // 2,
            summary.get("result"),
            SURFACE,
        )

    def _render_history_snapshot_identity(
        self,
        available_width: int | None = None,
        *,
        summary: dict | None = None,
    ) -> None:
        if summary is None:
            summary = self._selected_history_summary()
        labels = getattr(self, "history_snapshot_labels", {})
        identity_text = getattr(self, "history_snapshot_identity_text", None)
        if available_width is None and identity_text is not None:
            available_width = identity_text.winfo_width()
        if not available_width or available_width <= 1:
            available_width = 210
        text_width = max(48, int(available_width) - 6)
        icon_label = getattr(self, "history_snapshot_icon_label", None)
        if summary is None:
            if icon_label is not None:
                icon_label.configure(image="", text="♜")
                icon_label.image = None
            for key, value, role in (
                (
                    "boss",
                    "暂无竞技战斗记录"
                    if getattr(self, "backend_current_page", "history") == "kings"
                    else "暂无战斗记录",
                    "title",
                ),
                (
                    "dungeon",
                    "PvP 记录会在一场比赛结束后自动保存"
                    if getattr(self, "backend_current_page", "history") == "kings"
                    else "完成一场 Boss 战斗后会自动保存",
                    "micro",
                ),
                ("time", "--", "micro"),
            ):
                if key in labels:
                    labels[key].configure(
                        text=self._fit_ui_text(value, text_width, role),
                        fg=MUTED,
                    )
            return

        encounter_title = self._history_encounter_title(summary)
        boss_name = str(summary.get("boss_name", "")).strip() or encounter_title
        dungeon_name = str(summary.get("dungeon_name", "")).strip() or "未知区域"
        difficulty = str(summary.get("difficulty", "")).strip()
        if difficulty:
            dungeon_name = f"{dungeon_name} · {difficulty}"
        time_text = self._history_timestamp(summary)
        for key, value, color, role in (
            ("boss", encounter_title, TEXT, "title"),
            ("dungeon", dungeon_name, MUTED, "micro"),
            ("time", time_text, SUBTLE, "micro"),
        ):
            if key in labels:
                labels[key].configure(
                    text=self._fit_ui_text(value, text_width, role), fg=color
                )
        if icon_label is not None:
            if getattr(self, "backend_current_page", "history") == "kings":
                portrait = self.icons.pvp_mode(
                    summary.get("stage_name", "PvP"),
                    summary.get("dungeon_name", ""),
                    summary.get("team_size", 0),
                    size=82,
                )
            else:
                portrait = self.icons.boss(
                    summary.get("boss_icon", ""), boss_name, size=82
                )
            icon_label.configure(image=portrait, text="")
            icon_label.image = portrait

    def _render_history_snapshot(self) -> None:
        summary = self._selected_history_summary()
        labels = getattr(self, "history_snapshot_labels", {})
        mode = getattr(self, "history_meter_mode", "dps")
        boss_mode = mode == "boss_damage"
        captions = {
            "dps": ("我的 DPS", "我的伤害", "伤害占比"),
            "hps": ("我的 HPS", "我的治疗", "治疗占比"),
            "dt": ("我的承伤", "团队承伤", "承伤占比"),
        }.get(mode, ("我的 DPS", "我的伤害", "伤害占比"))
        for key, caption in zip(
            ("my_dps", "my_damage", "my_share"), captions
        ):
            label = labels.get(f"{key}_caption")
            if label is not None:
                label.configure(text=caption)
        if boss_mode:
            for key, caption in (
                ("team_dps", "团队总承伤"),
                ("my_dps", "已归类伤害"),
                ("my_damage", "归类比例"),
                ("my_share", "最高一击"),
            ):
                label = labels.get(f"{key}_caption")
                if label is not None:
                    label.configure(text=caption)
        else:
            team_caption = labels.get("team_dps_caption")
            if team_caption is not None:
                team_caption.configure(text="团队 DPS")
        if self.history_snapshot_trend_title_label is not None:
            self.history_snapshot_trend_title_label.configure(
                text={
                    "dps": "团队 DPS 趋势",
                    "hps": "HPS 数据",
                    "dt": "DT 数据",
                    "boss_damage": "首领伤害数据",
                }.get(
                    mode, "团队 DPS 趋势"
                )
            )
        self._render_history_snapshot_identity(summary=summary)
        if summary is None:
            for key, value in (
                ("team_dps", "--"),
                ("my_dps", "--"),
                ("my_damage", "--"),
                ("my_share", "--"),
                ("team_size", "--"),
                ("duration", "--"),
                ("result", "--"),
            ):
                if key in labels:
                    labels[key].configure(text=value, fg=MUTED)
            if self.history_snapshot_status_label is not None:
                self.history_snapshot_status_label.configure(text="--", fg=MUTED)
            self._draw_history_snapshot_result()
            self._draw_history_snapshot_trend()
            return

        if getattr(self, "backend_current_page", "history") == "kings":
            mode_name = str(summary.get("stage_name") or "PvP")
            result_text = str(summary.get("pvp_result") or "未知")
            try:
                team_size = int(summary.get("team_size", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                team_size = 0
            allies, enemies, _resolved_size = self._pvp_snapshot_rosters(summary)
            try:
                hunter_city = int(summary.get("map_id", 0) or 0) in HUNTER_CITY_MAPS
            except (TypeError, ValueError, OverflowError):
                hunter_city = False
            record_text = " / ".join(
                self._history_optional_number(summary.get(key))
                for key in (("kills", "deaths") if hunter_city
                            else ("kills", "deaths", "assists"))
            )
            opponent = enemies[0] if enemies else {}
            enemy_average = summary.get("pvp_enemy_average_rating")
            if enemy_average is None and opponent:
                enemy_average = opponent.get("extraordinary_rating")
            secondary_value = (
                self._history_optional_number(
                    self._pvp_roster_rating_stats(allies).get("average")
                ) if hunter_city
                else self._history_optional_number(enemy_average)
            )
            performance_caption = "击杀 / 阵亡" if hunter_city else "K/D/A"
            secondary_caption = "我方平均评分" if hunter_city else "敌方平均评分"
            for key, value in (
                ("team_dps", record_text),
                ("my_dps", self._history_optional_number(summary.get("extraordinary_rating"))),
                ("my_damage", self._history_optional_number(summary.get("my_damage"))),
                ("my_share", secondary_value),
                ("team_size", "猎龙战" if hunter_city else f"{team_size}V{team_size}" if team_size else "--"),
                ("duration", self._history_optional_duration(summary.get("duration_seconds"))),
            ):
                label = labels.get(key)
                if label is not None:
                    label.configure(text=value, fg=TEXT if value != "--" else MUTED)
            for key, caption in (
                ("team_dps", performance_caption),
                ("my_dps", "我的非凡评分"),
                ("my_damage", "我的伤害"),
                ("my_share", secondary_caption),
                ("team_size", "模式"),
                ("duration", "战斗时长"),
            ):
                label = labels.get(f"{key}_caption")
                if label is not None:
                    label.configure(text=caption)
            self._draw_history_snapshot_result()
            status = getattr(self, "history_snapshot_status_label", None)
            if status is not None:
                status.configure(text=result_text, fg=ACCENT if result_text == "胜利" else ERROR if result_text == "失败" else WARN)
            trend_title = getattr(self, "history_snapshot_trend_title_label", None)
            if trend_title is not None:
                trend_title.configure(
                    text=(
                        "猎龙之城 · 我方阵容"
                        if hunter_city
                        else "1V1 · 我 VS 对手"
                        if team_size == 1
                        else f"{team_size}V{team_size} · 双方阵容"
                        if team_size in (3, 6, 12)
                        else f"{mode_name} · 战斗快照"
                    )
                )
            self._draw_pvp_history_snapshot(summary)
            return
        values = {
            "team_dps": self._history_optional_number(
                summary.get("boss_team_taken")
                if boss_mode
                else summary.get("team_dps")
            ),
            "team_size": (
                f"{int(summary.get('team_size'))} 人"
                if summary.get("team_size") is not None
                else "--"
            ),
            "duration": (
                format_duration(float(summary.get("duration_seconds")))
                if summary.get("duration_seconds") is not None
                else "--"
            ),
        }
        if boss_mode:
            coverage = str(summary.get("boss_damage_coverage", ""))
            available = coverage in {
                "complete",
                "observed_partial",
                "conflict",
            }
            values["my_dps"] = (
                self._history_optional_number(
                    summary.get("boss_observed_damage")
                )
                if available
                else "--"
            )
            values["my_damage"] = (
                self._history_rate_text(
                    summary.get("boss_classification_ratio")
                )
                if available
                else "--"
            )
            values["my_share"] = (
                self._history_optional_number(summary.get("boss_max_hit"))
                if available
                else "--"
            )
            if not available:
                values["team_dps"] = "--"
        elif mode == "hps":
            values["my_dps"] = self._history_optional_number(
                summary.get("my_hps")
            )
            values["my_damage"] = self._history_optional_number(
                summary.get("my_effective_healing")
            )
            try:
                total_healing = max(0.0, float(summary.get("team_hps"))) * max(
                    0.0, float(summary.get("duration_seconds"))
                )
                my_healing = max(
                    0.0, float(summary.get("my_effective_healing"))
                )
                values["my_share"] = (
                    f"{my_healing / total_healing * 100:.1f}%"
                    if total_healing > 0
                    else "--"
                )
            except (TypeError, ValueError, OverflowError):
                values["my_share"] = "--"
        elif mode == "dt":
            values["my_dps"] = self._history_optional_number(
                summary.get("my_taken")
            )
            values["my_damage"] = self._history_optional_number(
                summary.get("team_taken")
            )
            try:
                team_taken = max(0.0, float(summary.get("team_taken")))
                my_taken = max(0.0, float(summary.get("my_taken")))
                values["my_share"] = (
                    f"{my_taken / team_taken * 100:.1f}%"
                    if team_taken > 0
                    else "--"
                )
            except (TypeError, ValueError, OverflowError):
                values["my_share"] = "--"
        else:
            values["my_dps"] = self._history_optional_number(
                summary.get("my_dps")
            )
            values["my_damage"] = self._history_optional_number(
                summary.get("my_damage")
            )
            values["my_share"] = (
                f"{float(summary.get('my_share')) * 100:.1f}%"
                if summary.get("my_share") is not None
                else "--"
            )
        result_text, result_color = self._history_result_presentation(
            summary.get("result")
        )
        values["result"] = result_text
        for key, value in values.items():
            if key in labels:
                labels[key].configure(
                    text=value,
                    fg=result_color if key == "result" else TEXT,
                )
        if boss_mode:
            completeness_text, completeness_color = (
                self._history_boss_coverage_text(
                    {
                        "coverage": summary.get("boss_damage_coverage"),
                        "unavailable_reason": summary.get(
                            "boss_damage_unavailable_reason"
                        ),
                    }
                )
            )
        else:
            completeness = str(summary.get("completeness", ""))
            completeness_text, completeness_color = {
                COMPLETENESS_COMPLETE: ("数据完整", ACCENT),
                COMPLETENESS_LIMITED: ("基础数据", WARN),
            }.get(completeness, ("部分缺失", WARN))
            settlement = self._history_settlement_presentation(summary)
            if settlement is not None:
                completeness_text, completeness_color = settlement
        if self.history_snapshot_status_label is not None:
            self.history_snapshot_status_label.configure(
                text=completeness_text, fg=completeness_color
            )
        self._draw_history_snapshot_result()
        self._draw_history_snapshot_trend()

    def _history_snapshot_team_dps_points(self) -> list[tuple[float, float]]:
        record = self._selected_history_record() if self.history_selected_id else None
        if not isinstance(record, dict):
            self.history_trend_record_id = ""
            self.history_trend_record_signature = None
            self.history_trend_points = []
            self.history_trend_source = "settlement_average"
            self.history_participant_trend_record_id = ""
            self.history_participant_trend_points = {}
            self.history_participant_trend_scope = "team_only"
            return []
        record_id = str(
            record.get("encounter_id", record.get("battle_id", ""))
        )
        boss_sample_log = record.get("boss_hp_damage_samples")
        boss_sample_rows = (
            boss_sample_log.get("rows", ())
            if isinstance(boss_sample_log, dict) else ()
        )
        signature = (
            record_id, record.get("settlement_revision"),
            record.get("duration_seconds"), record.get("dps_duration_seconds"),
            record.get("total_damage"), record.get("team_dps"),
            len(record.get("team_dps_timeline", ()) or ()),
            len(boss_sample_rows or ()),
        )
        if (record_id == self.history_trend_record_id
                and signature == getattr(self, "history_trend_record_signature", None)):
            return self.history_trend_points

        # Old saved lines can include a settlement total injected at the final
        # second. Rebuild from the recorded source before showing a curve.
        points = rebuild_team_dps_timeline(record)
        parsed: list[tuple[float, float]] = []
        if isinstance(points, list):
            for row in points:
                if not isinstance(row, dict):
                    continue
                try:
                    parsed.append(
                        (
                            max(
                                0.0,
                                float(row.get("time_seconds", 0.0) or 0.0),
                            ),
                            max(
                                0.0,
                                float(
                                    row.get("team_dps", row.get("dps", 0.0))
                                    or 0.0
                                ),
                            ),
                        )
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
        parsed.sort(key=lambda value: value[0])
        source = ""
        if points and isinstance(points[0], dict):
            source = str(points[0].get("source", "") or "")
        if source not in {
            "live_team_cumulative", "complete_damage_events", "observed_boss_hp_loss",
            "live_display_team_dps",
        }:
            source = "settlement_average"
            parsed = []
            duration = max(
                0.0,
                self._history_numeric_float(
                    record.get("dps_duration_seconds")
                    or record.get("duration_seconds")
                ),
            )
            average = max(0.0, self._history_numeric_float(record.get("team_dps")))
            if average <= 0 and duration > 0:
                average = max(
                    0.0, self._history_numeric_float(record.get("total_damage"))
                ) / duration
            if duration > 0 and average > 0:
                parsed = [(0.0, average), (duration, average)]
        self.history_trend_record_id = record_id
        self.history_trend_record_signature = signature
        self.history_trend_points = parsed
        self.history_trend_source = source
        return parsed

    def _history_snapshot_participant_dps_points(
        self,
    ) -> dict[int, list[tuple[float, float]]]:
        record = self._selected_history_record() if self.history_selected_id else None
        if not isinstance(record, dict):
            self.history_participant_trend_record_id = ""
            self.history_participant_trend_points = {}
            self.history_participant_trend_scope = "team_only"
            return {}
        record_id = str(record.get("encounter_id", record.get("battle_id", "")))
        if record_id == self.history_participant_trend_record_id:
            return self.history_participant_trend_points

        rebuilt = rebuild_participant_dps_timelines(record)
        parsed: dict[int, list[tuple[float, float]]] = {}
        for raw_actor_id, rows in rebuilt.items():
            try:
                actor_id = int(raw_actor_id)
            except (TypeError, ValueError, OverflowError):
                continue
            values: list[tuple[float, float]] = []
            if not isinstance(rows, list):
                continue
            for row in rows:
                if not isinstance(row, dict):
                    continue
                try:
                    values.append(
                        (
                            max(0.0, float(row.get("time_seconds", 0.0) or 0.0)),
                            max(0.0, float(row.get("dps", 0.0) or 0.0)),
                        )
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
            if values:
                values.sort(key=lambda value: value[0])
                parsed[actor_id] = values

        scope = "all_players" if parsed else "team_only"
        if not parsed:
            # Old records can still provide one exact local-player curve from
            # their observed event log.  Keep it visibly distinct from full
            # all-player coverage.
            local = rebuild_dps_timeline(record)
            self_row = next(
                (
                    row for row in record.get("participants", [])
                    if isinstance(row, dict) and row.get("is_self") is True
                ),
                None,
            )
            if isinstance(self_row, dict) and isinstance(local, list):
                actor_id = int(self_row.get("actor_id", 0) or 0)
                values = []
                for row in local:
                    if not isinstance(row, dict):
                        continue
                    try:
                        values.append(
                            (
                                max(0.0, float(row.get("time_seconds", 0.0) or 0.0)),
                                max(0.0, float(row.get("dps", 0.0) or 0.0)),
                            )
                        )
                    except (TypeError, ValueError, OverflowError):
                        continue
                if actor_id > 0 and values:
                    parsed[actor_id] = values
                    scope = "team_and_self"
        self.history_participant_trend_record_id = record_id
        self.history_participant_trend_points = parsed
        self.history_participant_trend_scope = scope
        return parsed

    @staticmethod
    def _pvp_snapshot_number(value: object) -> int | None:
        if value is None or isinstance(value, bool):
            return None
        try:
            return max(0, int(value))
        except (TypeError, ValueError, OverflowError):
            return None

    @staticmethod
    def _pvp_roster_rating_stats(rows: list[dict]) -> dict[str, int | None]:
        ratings = [
            int(row["extraordinary_rating"])
            for row in rows
            if isinstance(row, dict)
            and not row.get("is_ai")
            and row.get("extraordinary_rating") is not None
        ]
        return {
            "average": (
                int(sum(ratings) / len(ratings) + 0.5) if ratings else None
            ),
            "highest": max(ratings) if ratings else None,
            "lowest": min(ratings) if ratings else None,
            "valid": len(ratings),
            "total": sum(
                1
                for row in rows
                if isinstance(row, dict) and not row.get("is_ai")
            ),
        }

    @classmethod
    def _pvp_roster_preview(
        cls,
        allies: list[dict],
        enemies: list[dict],
        team_size: int,
    ) -> dict[str, object]:
        """Select the compact roster shown inside the existing list-row gap."""

        expected = team_size if team_size in {1, 3, 6, 12} else max(
            len(allies), len(enemies), 1
        )

        def side(rows: list[dict], *, friendly: bool) -> dict[str, object]:
            candidates = [dict(row) for row in rows if isinstance(row, dict)]
            candidates = candidates[:expected]
            stats = cls._pvp_roster_rating_stats(candidates)
            rated = [
                (index, int(row["extraordinary_rating"]))
                for index, row in enumerate(candidates)
                if not row.get("is_ai")
                and row.get("extraordinary_rating") is not None
            ]
            # Balanced 3v3 deliberately omits score comparisons.  Keep all
            # three identities, but do not leak ratings through high/low
            # badges when the numeric values themselves are hidden.
            show_rating_markers = expected != 3
            highest_index = (
                max(rated, key=lambda item: item[1])[0]
                if rated and show_rating_markers
                else None
            )
            complete = bool(
                expected
                and len(candidates) >= expected
                and stats["valid"] == expected
            )
            lowest_index = (
                min(rated, key=lambda item: item[1])[0]
                if complete and rated and show_rating_markers
                else None
            )

            if expected <= 3:
                selected = list(range(min(expected, len(candidates))))
            else:
                selected = []
                if friendly:
                    self_index = next(
                        (
                            index
                            for index, row in enumerate(candidates)
                            if row.get("is_self")
                        ),
                        None,
                    )
                    if self_index is not None:
                        selected.append(self_index)
                if highest_index is not None and highest_index not in selected:
                    selected.append(highest_index)
                if lowest_index is not None and lowest_index not in selected:
                    selected.append(lowest_index)
                for index in range(len(candidates)):
                    if index not in selected:
                        selected.append(index)
                    if len(selected) == 3:
                        break

            visible = []
            for index in selected[:3]:
                row = dict(candidates[index])
                row["preview_highest"] = index == highest_index
                row["preview_lowest"] = index == lowest_index
                visible.append(row)
            return {
                "rows": visible,
                "omitted": max(0, expected - len(visible)),
                "complete": complete,
                "stats": stats,
                "expected": expected,
            }

        return {
            "team_size": expected,
            "allies": side(allies, friendly=True),
            "enemies": side(enemies, friendly=False),
        }

    @classmethod
    def _pvp_history_matchup_summary(
        cls,
        allies: list[dict],
        enemies: list[dict],
        team_size: int,
    ) -> dict[str, object]:
        """Build the compact comparison column without inventing data."""

        expected = team_size if team_size in {1, 3, 6, 12} else max(
            len(allies), len(enemies), 1
        )
        if team_size == 3:
            return {
                "title": "双方阵容",
                "rows": (
                    ("我方", f"{min(len(allies), expected)}人"),
                    ("敌方", f"{min(len(enemies), expected)}人"),
                ),
                "footer": "",
                "ratings_visible": False,
            }

        ally_stats = cls._pvp_roster_rating_stats(allies)
        enemy_stats = cls._pvp_roster_rating_stats(enemies)

        def average_text(stats: dict[str, int | None]) -> str:
            value = stats["average"]
            return "--" if value is None else f"{int(value):,}"

        return {
            "title": "双方评分" if team_size == 1 else "双方平均评分",
            "rows": (
                ("我方", average_text(ally_stats)),
                ("敌方", average_text(enemy_stats)),
            ),
            "footer": "",
            "ratings_visible": True,
        }

    def _pvp_history_list_columns(self, width: int) -> dict[str, int]:
        """Reserve enough space for result badges and ratings at the current DPI."""

        micro = self._ui_font("micro")
        result_width = max(64, micro.measure("该类型无结果") + 36)
        matchup_width = max(
            112, micro.measure("我方平均评分") + 12,
            micro.measure("当前名单  999,999") + 12,
        )
        performance_width = max(112, micro.measure("击杀 999  助攻 999") + 12)
        width = max(
            960, int(width or 0),
            66 + 170 + 96 + performance_width + matchup_width + result_width + 8 + 148,
        )
        action_left = max(548, width - 148)
        result_left = action_left - result_width - 8
        matchup_left = result_left - matchup_width
        performance_left = matchup_left - performance_width
        # Keep the mode emblem compact so the match/map and time metadata can
        # use two readable columns without widening the history table.
        info_left = 66
        available = max(0, performance_left - info_left)
        preview_width = min(280, max(96, available - 170))
        preview_left = performance_left - preview_width
        info_meta_left = min(
            info_left + 78,
            max(info_left + 48, preview_left - 68),
        )
        return {
            "width": width,
            "info_left": info_left,
            "info_right": preview_left,
            "info_meta_left": info_meta_left,
            "preview_left": preview_left,
            "preview_right": performance_left,
            "performance_left": performance_left,
            "matchup_left": matchup_left,
            "result_left": result_left,
            "action_left": action_left,
        }

    def _pvp_snapshot_rosters(
        self, summary: dict | None
    ) -> tuple[list[dict], list[dict], int]:
        if not isinstance(summary, dict):
            return [], [], 0
        payload = summary.get("_pvp_record")
        payload = payload if isinstance(payload, dict) else summary
        try:
            team_size = int(
                payload.get("team_size", summary.get("team_size", 0)) or 0
            )
        except (TypeError, ValueError, OverflowError):
            team_size = 0
        player = payload.get("player")
        player = player if isinstance(player, dict) else {}
        data_scope = payload.get("data_scope")
        data_scope = data_scope if isinstance(data_scope, dict) else {}
        self_metrics_scope = str(
            data_scope.get("self_metrics") or ""
        ).strip().casefold()

        def normalized(raw: dict, side: str, *, is_self=False) -> dict:
            equipment = raw.get("equipment_snapshot")
            equipment = equipment if isinstance(equipment, dict) else {}
            rating = raw.get("extraordinary_rating", raw.get("rating"))
            if rating is None:
                rating = equipment.get("extraordinary_rating")
            row_is_self = bool(raw.get("is_self")) or is_self
            metrics_scope = str(
                raw.get("metrics_scope")
                or raw.get("interaction_scope")
                or ""
            ).strip().casefold()
            metrics_trusted = bool(
                metrics_scope == "authoritative"
                or (row_is_self and metrics_scope == "self_exact")
                or (team_size == 1 and metrics_scope == "pair_exact")
                or (team_size == 1 and not data_scope and not metrics_scope)
            )

            def metric(value: object) -> int | None:
                return self._pvp_snapshot_number(value) if metrics_trusted else None

            return {
                "character_id": str(
                    raw.get("character_id") or raw.get("user_token") or ""
                ).strip(),
                "name": str(raw.get("name") or "未知玩家").strip(),
                "profession_id": self._pvp_snapshot_number(
                    raw.get("profession_id")
                ) or 0,
                "extraordinary_rating": normalize_extraordinary_rating(rating),
                "is_ai": pvp_bot_evidence(raw),
                "is_self": row_is_self,
                "side": side,
                "kills": metric(
                    raw.get("kills", raw.get("kills_on"))
                ),
                "assists": metric(raw.get("assists")),
                "deaths": metric(
                    raw.get("deaths", raw.get("defeats", raw.get("deaths_to")))
                ),
                "damage": metric(
                    raw.get("damage", raw.get("damage_done", raw.get("damage_to")))
                ),
                "healing": metric(
                    raw.get(
                        "healing",
                        raw.get("healing_done", raw.get("effective_healing")),
                    )
                ),
                "taken": metric(
                    raw.get("taken", raw.get("damage_taken", raw.get("damage_from")))
                ),
                "current_dead": bool(raw.get("current_dead")),
                "metrics_scope": metrics_scope,
            }

        raw_allies = payload.get("allies")
        raw_enemies = payload.get("enemies")
        allies = [
            normalized(row, "ally")
            for row in raw_allies if isinstance(row, dict)
        ] if isinstance(raw_allies, list) else []
        enemies = [
            normalized(row, "enemy")
            for row in raw_enemies if isinstance(row, dict)
        ] if isinstance(raw_enemies, list) else []
        self_token = str(player.get("character_id") or "").strip()
        local_source = {
            **player,
            "character_id": self_token,
            "kills": payload.get("kills"),
            "assists": payload.get("assists"),
            "deaths": payload.get("deaths"),
            "damage": payload.get("damage", payload.get("damage_done")),
            "healing": payload.get("healing", payload.get("effective_healing")),
            "taken": payload.get("taken", payload.get("damage_taken")),
            "is_self": True,
            "metrics_scope": self_metrics_scope,
        }
        local = normalized(local_source, "ally", is_self=True)
        existing_local = next(
            (
                row
                for row in allies
                if row.get("is_self")
                or (
                    self_token
                    and str(row.get("character_id") or "") == self_token
                )
            ),
            None,
        )
        if existing_local is None:
            allies.insert(0, local)
        else:
            existing_local["is_self"] = True
            for key in (
                "character_id",
                "name",
                "profession_id",
                "extraordinary_rating",
                "kills",
                "assists",
                "deaths",
                "damage",
                "healing",
                "taken",
            ):
                value = local.get(key)
                if value not in (None, "", 0) or key in {
                    "kills", "assists", "deaths", "damage", "healing", "taken"
                } and value == 0:
                    existing_local[key] = value
        opponents = payload.get("opponents")
        opponents = opponents if isinstance(opponents, list) else []
        ally_uids = {
            str(row.get("character_id") or "").strip()
            for row in allies
            if str(row.get("character_id") or "").strip()
        }
        if ally_uids:
            enemies = [
                row
                for row in enemies
                if not str(row.get("character_id") or "").strip()
                or str(row.get("character_id") or "").strip()
                not in ally_uids
            ]
        enemy_by_uid = {
            str(row.get("character_id") or "").strip(): row
            for row in enemies
            if str(row.get("character_id") or "").strip()
        }
        for opponent in opponents:
            if not isinstance(opponent, dict):
                continue
            uid = str(
                opponent.get("character_id")
                or opponent.get("user_token")
                or ""
            ).strip()
            if uid and uid in ally_uids:
                continue
            pair = normalized(
                {
                    **opponent,
                    "metrics_scope": opponent.get("interaction_scope"),
                    "character_id": uid,
                    "kills": opponent.get(
                        "defeats", opponent.get("deaths_to")
                    ),
                    "deaths": opponent.get(
                        "kills", opponent.get("kills_on")
                    ),
                    "damage": opponent.get(
                        "taken", opponent.get("damage_from")
                    ),
                    "taken": opponent.get(
                        "damage", opponent.get("damage_to")
                    ),
                },
                "enemy",
            )
            enemy = enemy_by_uid.get(uid) if uid else None
            if enemy is None:
                if team_size != 1:
                    for key in (
                        "kills", "assists", "deaths", "damage", "healing", "taken"
                    ):
                        pair[key] = None
                enemies.append(pair)
                if uid:
                    enemy_by_uid[uid] = pair
                continue
            for key in (
                "name",
                "profession_id",
                "extraordinary_rating",
                "is_ai",
            ):
                if enemy.get(key) in (None, "", 0):
                    value = pair.get(key)
                    if value not in (None, "", 0):
                        enemy[key] = value
            if team_size == 1:
                for key in (
                    "kills", "assists", "deaths", "damage", "healing", "taken"
                ):
                    if enemy.get(key) is None and pair.get(key) is not None:
                        enemy[key] = pair[key]
        if team_size <= 0:
            team_size = max(len(allies), len(enemies), 1 if enemies else 0)
        try:
            map_id = int(payload.get("map_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            map_id = 0
        if map_id in HUNTER_CITY_MAPS:
            # The Hunter City snapshot is the local alliance composition.
            # Direct opponents remain in the per-person combat detail.
            return allies, [], len(allies)
        return allies, enemies, team_size

    def _pvp_matchup_history(self) -> dict[str, dict[str, object]]:
        controller = getattr(self, "pvp_recording", None)
        account_key = str(getattr(controller, "account_key", "") or "")
        repository = getattr(self, "pvp_history_repository", None)
        records = (
            repository.list(account_key)
            if repository is not None and account_key
            else []
        )
        cache_key = (
            account_key,
            tuple(
                str(record.get("match_id") or record.get("battle_id") or "")
                for record in records if isinstance(record, dict)
            ),
        )
        if cache_key == getattr(self, "history_pvp_matchup_cache_key", None):
            return getattr(self, "history_pvp_matchup_cache", {})
        history: dict[str, dict[str, object]] = {}
        for record in records:
            if not isinstance(record, dict):
                continue
            outcome = str(record.get("result") or "未知").strip()
            enemies = record.get("enemies")
            enemies = enemies if isinstance(enemies, list) else []
            if not enemies:
                enemies = record.get("opponents")
                enemies = enemies if isinstance(enemies, list) else []
            seen = set()
            for enemy in enemies:
                if not isinstance(enemy, dict):
                    continue
                uid = str(
                    enemy.get("character_id") or enemy.get("user_token") or ""
                ).strip()
                if not uid or uid in seen:
                    continue
                seen.add(uid)
                item = history.setdefault(
                    uid,
                    {"total": 0, "wins": 0, "losses": 0, "unknown": 0, "recent": []},
                )
                item["total"] += 1
                if outcome == "胜利":
                    item["wins"] += 1
                    marker = "胜"
                elif outcome == "失败":
                    item["losses"] += 1
                    marker = "负"
                else:
                    item["unknown"] += 1
                    marker = "未"
                if len(item["recent"]) < 5:
                    item["recent"].append(marker)
        self.history_pvp_matchup_cache_key = cache_key
        self.history_pvp_matchup_cache = history
        return history

    def _pvp_server_matchup_key(self, summary: dict | None):
        if not isinstance(summary, dict):
            return None
        allies, enemies, team_size = self._pvp_snapshot_rosters(summary)
        payload = summary.get("_pvp_record") if isinstance(summary, dict) else None
        payload = payload if isinstance(payload, dict) else summary
        if isinstance(payload, dict):
            try:
                hunter_map = int(payload.get("map_id", summary.get("map_id", 0)) or 0) in HUNTER_CITY_MAPS
            except (TypeError, ValueError, OverflowError):
                hunter_map = False
            if hunter_map:
                direct_opponents = payload.get("opponents")
                if isinstance(direct_opponents, list):
                    enemies = [
                        dict(row) for row in direct_opponents
                        if isinstance(row, dict) and str(
                            row.get("character_id") or row.get("user_token") or row.get("opponent_id") or ""
                        ).strip()
                    ]
                    team_size = 1
        opponent_ids = tuple(
            sorted(
                {
                    str(
                        row.get("character_id")
                        or row.get("user_token")
                        or row.get("opponent_id")
                        or ""
                    ).strip()
                    for row in enemies
                    if str(row.get("character_id") or "").strip()
                }
            )
        )
        if not opponent_ids or team_size not in {1, 3, 6, 12}:
            return None
        record_id = str(
            summary.get("battle_id", summary.get("encounter_id", "")) or ""
        )
        controller = getattr(self, "pvp_recording", None)
        account_key = str(getattr(controller, "account_key", "") or "")
        session = getattr(getattr(self, "licensing", None), "session", None)
        session_id = str(getattr(session, "session_id", "") or "")
        return (account_key, session_id, record_id, team_size, opponent_ids)

    def _request_pvp_server_matchups(self, summary: dict | None) -> None:
        """Fetch matchup history off the Tk thread, once per selected roster."""

        key = self._pvp_server_matchup_key(summary)
        if key is None:
            self.history_pvp_matchup_request_key = None
            self.history_pvp_matchup_loading = False
            self.history_pvp_matchup_error = ""
            self.history_pvp_server_matchup_cache_key = None
            self.history_pvp_server_matchup_cache = {}
            return
        if (
            key == getattr(self, "history_pvp_server_matchup_cache_key", None)
            or key == getattr(self, "history_pvp_matchup_request_key", None)
        ):
            return
        licensing = getattr(self, "licensing", None)
        request = getattr(licensing, "pvp_request", None)
        if not callable(request):
            # Lightweight projection tests have no gateway.  Production never
            # uses the local aggregate as a substitute for server history.
            self.history_pvp_matchup_request_key = key
            self.history_pvp_matchup_loading = False
            self.history_pvp_matchup_error = "服务器历史暂不可用"
            return
        _account, _session_id, record_id, team_size, opponent_ids = key
        self.history_pvp_matchup_request_key = key
        self.history_pvp_matchup_loading = True
        self.history_pvp_matchup_error = ""
        payload = {
            "opponent_ids": list(opponent_ids),
            "team_size": team_size,
            "exclude_match_id": record_id,
        }

        def query() -> None:
            try:
                response = request("records/matchups", payload)
                if not isinstance(response, dict) or not response.get("ok"):
                    raise RuntimeError(
                        str(
                            response.get("message")
                            if isinstance(response, dict)
                            else "服务器历史暂不可用"
                        )
                    )
                result = response.get("matchups")
                if not isinstance(result, dict):
                    raise RuntimeError("服务器历史暂不可用")
                outcome = {str(uid): value for uid, value in result.items() if isinstance(value, dict)}
                message = ""
            except Exception as exc:
                outcome = {}
                message = str(exc)[:120] or "服务器历史暂不可用"
            self.control_messages.put(
                (
                    "pvp_matchups_result",
                    {"key": key, "matchups": outcome, "error": message},
                )
            )

        threading.Thread(
            target=query, name="pvp-matchup-history", daemon=True
        ).start()

    def _handle_pvp_matchups_result(self, payload: object) -> None:
        if not isinstance(payload, dict):
            return
        key = payload.get("key")
        if key != getattr(self, "history_pvp_matchup_request_key", None):
            return
        self.history_pvp_matchup_loading = False
        self.history_pvp_matchup_error = str(payload.get("error") or "")
        if self.history_pvp_matchup_error:
            self.history_pvp_server_matchup_cache = {}
        else:
            raw = payload.get("matchups")
            self.history_pvp_server_matchup_cache = (
                {str(uid): value for uid, value in raw.items() if isinstance(value, dict)}
                if isinstance(raw, dict)
                else {}
            )
        self.history_pvp_server_matchup_cache_key = key
        if getattr(self, "backend_current_page", "history") == "kings":
            self._draw_pvp_history_snapshot(self._selected_history_summary())

    def _history_pvp_snapshot_scroll(self, event) -> str | None:
        if getattr(self, "backend_current_page", "history") != "kings":
            return None
        summary = self._selected_history_summary()
        allies, enemies, team_size = self._pvp_snapshot_rosters(summary)
        maximum = max(0, max(len(allies), len(enemies)) - 2)
        try:
            button = int(getattr(event, "num", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            button = 0
        try:
            delta = int(getattr(event, "delta", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            delta = 0
        direction = -1 if button == 4 or delta > 0 else 1
        if team_size in {1, 3, 6, 12}:
            canvas = getattr(self, "history_snapshot_trend_canvas", None)
            if canvas is not None:
                canvas.yview_scroll(direction, "units")
            return "break"
        if team_size <= 1:
            canvas = getattr(self, "history_snapshot_trend_canvas", None)
            if canvas is not None:
                canvas.yview_scroll(direction, "units")
            return "break"
        current = int(getattr(self, "history_pvp_snapshot_offset", 0) or 0)
        next_offset = min(maximum, max(0, current + direction))
        if next_offset != current:
            self.history_pvp_snapshot_offset = next_offset
            self._draw_pvp_history_snapshot(summary)
        else:
            canvas = getattr(self, "history_snapshot_trend_canvas", None)
            if canvas is not None:
                canvas.yview_scroll(direction, "units")
        return "break"

    def _toggle_pvp_snapshot_roster(self) -> str:
        summary = self._selected_history_summary()
        if not isinstance(summary, dict):
            return "break"
        record_id = str(
            summary.get("battle_id", summary.get("encounter_id", "")) or ""
        )
        current_id = str(
            getattr(self, "history_pvp_snapshot_expanded_record_id", "") or ""
        )
        expanded = bool(getattr(self, "history_pvp_snapshot_expanded", False))
        self.history_pvp_snapshot_expanded_record_id = record_id
        self.history_pvp_snapshot_expanded = not expanded if current_id == record_id else True
        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if canvas is not None:
            try:
                canvas.yview_moveto(0.0)
            except tk.TclError:
                pass
        self._draw_pvp_history_snapshot(summary)
        return "break"

    def _draw_pvp_history_home_snapshot(
        self,
        summary: dict,
        allies: list[dict],
        enemies: list[dict],
        team_size: int,
    ) -> None:
        """Draw the mode-specific PvP overview inside the native right pane."""

        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, int(canvas.winfo_width() or 1))
        height = max(1, int(canvas.winfo_height() or 1))
        history_label = getattr(self, "history_snapshot_history_label", None)
        peak_label = getattr(self, "history_snapshot_peak_label", None)
        record_id = str(
            summary.get("battle_id", summary.get("encounter_id", "")) or ""
        )
        if record_id != str(
            getattr(self, "history_pvp_snapshot_record_id", "") or ""
        ):
            self.history_pvp_snapshot_record_id = record_id
            self.history_pvp_snapshot_expanded_record_id = record_id
            self.history_pvp_snapshot_expanded = False
            try:
                canvas.yview_moveto(0.0)
            except tk.TclError:
                pass
        expanded = bool(
            getattr(self, "history_pvp_snapshot_expanded", False)
            and getattr(self, "history_pvp_snapshot_expanded_record_id", "")
            == record_id
        )
        hide_names = self._history_names_hidden()

        def metric(value: object) -> str:
            return "--" if value is None else format_number(value)

        def rating(value: object) -> str:
            return "--" if value is None else f"{int(value):,}"

        def display_name(row: dict, index: int) -> str:
            return self._history_actor_name(row, index, hide_names)

        def panel(left: int, top: int, right: int, bottom: int, color: str) -> None:
            canvas.create_rectangle(
                left,
                top,
                right,
                bottom,
                fill=blend_color(SURFACE, color, 0.08),
                outline=blend_color(BORDER, color, 0.58),
            )

        def team_stats(rows: list[dict]) -> dict[str, int | None]:
            return self._pvp_roster_rating_stats(rows)

        content_bottom = height

        if team_size == 1:
            self._request_pvp_server_matchups(summary)
            opponent = enemies[0] if enemies else {}
            local = next(
                (row for row in allies if row.get("is_self")),
                allies[0] if allies else {},
            )
            gap = 10
            card_width = max(90, (width - 18 - gap) // 2)
            cards = (
                (8, local, "我", ACCENT, 0),
                (8 + card_width + gap, opponent, "对手", ERROR, 1),
            )
            for left, row, caption, color, name_index in cards:
                right = left + card_width
                panel(left, 7, right, 91, color)
                canvas.create_text(
                    left + 8,
                    20,
                    text=caption,
                    fill=color,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                icon = self._history_profession_icon(
                    int(row.get("profession_id", 0) or 0), 24
                )
                canvas.create_image(left + 8, 33, image=icon, anchor="nw")
                canvas.create_text(
                    left + 39,
                    43,
                    text=self._fit_ui_text(
                        display_name(row, name_index),
                        max(38, card_width - 49),
                        "micro",
                    ),
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("strong"),
                )
                canvas.create_text(
                    left + 8,
                    73,
                    text=f"非凡评分  {rating(row.get('extraordinary_rating'))}",
                    fill=(
                        WARN
                        if row.get("extraordinary_rating") is not None
                        else MUTED
                    ),
                    anchor="w",
                    font=self._ui_font("micro"),
                )

            panel(8, 101, width - 8, 181, PVP_MODE_FOREGROUND)
            canvas.create_text(
                17,
                117,
                text="本场对决",
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            duel_rows = (
                ("我击败他", summary.get("kills"), 17, 141, ACCENT),
                ("他击败我", opponent.get("kills"), width // 2 + 4, 141, ERROR),
                ("我的伤害", summary.get("my_damage"), 17, 165, TEXT),
                ("他的伤害", opponent.get("damage"), width // 2 + 4, 165, TEXT),
            )
            for caption, value, x, y, color in duel_rows:
                canvas.create_text(
                    x,
                    y,
                    text=f"{caption}  {metric(value)}",
                    fill=color if value is not None else MUTED,
                    anchor="w",
                    font=self._ui_font("micro"),
                )

            server_key = self._pvp_server_matchup_key(summary)
            loading = bool(getattr(self, "history_pvp_matchup_loading", False))
            error = str(getattr(self, "history_pvp_matchup_error", "") or "")
            matchup = getattr(self, "history_pvp_server_matchup_cache", {})
            item = matchup.get(str(opponent.get("character_id") or ""), {})
            panel(8, 191, width - 8, 245, WARN)
            canvas.create_text(
                17,
                207,
                text="历史交手",
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            if item and not loading and not error:
                history_text = (
                    f"相遇 {int(item.get('total', 0) or 0)} 场  ·  "
                    f"胜 {int(item.get('wins', 0) or 0)}  "
                    f"负 {int(item.get('losses', 0) or 0)}  "
                    f"未知 {int(item.get('unknown', 0) or 0)}"
                )
                history_color = ACCENT
            elif loading:
                history_text, history_color = "正在同步服务器历史…", WARN
            elif server_key is None:
                history_text, history_color = "暂无数据（缺少对手 UID）", MUTED
            else:
                history_text, history_color = "暂无数据", MUTED
            canvas.create_text(
                17,
                229,
                text=history_text,
                fill=history_color,
                anchor="w",
                font=self._ui_font("micro"),
            )
            if history_label is not None:
                history_label.configure(text="历史交手", fg=history_color)
            if peak_label is not None:
                peak_label.configure(text="1V1 · 我 VS 对手")
            content_bottom = 252
            canvas.configure(scrollregion=(0, 0, width, max(height, content_bottom)))
            return

        if history_label is not None:
            ally_stats = team_stats(allies)
            enemy_stats = team_stats(enemies)
            history_label.configure(
                text=(
                    f"我方均 {rating(ally_stats['average'])}"
                    f" · 敌方均 {rating(enemy_stats['average'])}"
                ),
                fg=MUTED,
            )

        def section_title(
            top: int,
            title: str,
            rows: list[dict],
            color: str,
        ) -> int:
            stats = team_stats(rows)
            panel(8, top, width - 8, top + 26, color)
            canvas.create_text(
                16,
                top + 13,
                text=f"{title} {len(rows)}人",
                fill=color,
                anchor="w",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width - 16,
                top + 13,
                text=(
                    f"平均 {rating(stats['average'])}"
                ),
                fill=color if stats["average"] is not None else MUTED,
                anchor="e",
                font=self._ui_font("micro"),
            )
            return top + 26

        def member_rows(
            top: int,
            rows: list[dict],
            color: str,
            *,
            index_offset: int,
        ) -> int:
            row_height = 31
            for item_index, row in enumerate(rows):
                y1 = top + item_index * row_height
                y2 = y1 + row_height - 2
                fill = (
                    blend_color(SURFACE, ACCENT, 0.19)
                    if row.get("is_self")
                    else SURFACE if item_index % 2 == 0 else PANEL_2
                )
                canvas.create_rectangle(
                    8,
                    y1,
                    width - 8,
                    y2,
                    fill=fill,
                    outline=BORDER,
                )
                if row.get("is_self"):
                    canvas.create_rectangle(
                        8, y1, 11, y2, fill=ACCENT, outline=""
                    )
                icon = self._history_profession_icon(
                    int(row.get("profession_id", 0) or 0), 18
                )
                canvas.create_image(16, y1 + 6, image=icon, anchor="nw")
                name = display_name(row, index_offset + item_index)
                if row.get("is_self"):
                    name = f"{name}（我）"
                canvas.create_text(
                    43,
                    y1 + row_height // 2,
                    text=self._fit_ui_text(name, max(70, width - 172), "micro"),
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                canvas.create_text(
                    width - 16,
                    y1 + row_height // 2,
                    text=rating(row.get("extraordinary_rating")),
                    fill=(
                        WARN
                        if row.get("extraordinary_rating") is not None
                        else MUTED
                    ),
                    anchor="e",
                    font=self._ui_font("micro"),
                )
            return top + len(rows) * row_height

        def preview(rows: list[dict]) -> list[dict]:
            if len(rows) <= 3:
                return list(rows)
            indexes = [0, 1, 2]
            self_index = next(
                (index for index, row in enumerate(rows) if row.get("is_self")),
                None,
            )
            if self_index is not None and self_index not in indexes:
                indexes[-1] = self_index
            return [rows[index] for index in sorted(set(indexes))]

        if team_size == 12 and not expanded:
            top = 7
            for title, rows, color in (
                ("我方", allies, ACCENT),
                ("敌方", enemies, ERROR),
            ):
                stats = team_stats(rows)
                panel(8, top, width - 8, top + 96, color)
                canvas.create_text(
                    17,
                    top + 17,
                    text=f"{title} 12人",
                    fill=color,
                    anchor="w",
                    font=self._ui_font("strong"),
                )
                lines = (
                    f"平均评分  {rating(stats['average'])}",
                    f"最高 {rating(stats['highest'])}   最低 {rating(stats['lowest'])}",
                )
                for line_index, line in enumerate(lines):
                    canvas.create_text(
                        17,
                        top + 42 + line_index * 20,
                        text=line,
                        fill=TEXT if "--" not in line else MUTED,
                        anchor="w",
                        font=self._ui_font("micro"),
                    )
                top += 105
            link_top = top + 2
        else:
            shown_allies = allies if expanded or team_size == 3 else preview(allies)
            shown_enemies = enemies if expanded or team_size == 3 else preview(enemies)
            top = 7
            top = section_title(top, "我方", allies, ACCENT)
            top = member_rows(top, shown_allies, ACCENT, index_offset=0)
            top += 7
            top = section_title(top, "敌方", enemies, ERROR)
            top = member_rows(
                top,
                shown_enemies,
                ERROR,
                index_offset=len(allies),
            )
            link_top = top + 5

        if team_size in {6, 12}:
            link_text = "收起完整阵容" if expanded else (
                "查看双方完整阵容" if team_size == 12 else "查看全部6人"
            )
            canvas.create_rectangle(
                8,
                link_top,
                width - 8,
                link_top + 30,
                fill=blend_color(SURFACE, PVP_MODE_FOREGROUND, 0.12),
                outline=blend_color(BORDER, PVP_MODE_FOREGROUND, 0.65),
                tags=("pvp-roster-expand",),
            )
            canvas.create_text(
                width // 2,
                link_top + 15,
                text=f"{link_text}  {'↑' if expanded else '↓'}",
                fill=PVP_MODE_FOREGROUND,
                font=self._ui_font("micro"),
                tags=("pvp-roster-expand",),
            )
            canvas.tag_bind(
                "pvp-roster-expand",
                "<Button-1>",
                lambda _event: self._toggle_pvp_snapshot_roster(),
            )
            canvas.tag_bind(
                "pvp-roster-expand",
                "<Enter>",
                lambda _event: canvas.configure(cursor="hand2"),
            )
            canvas.tag_bind(
                "pvp-roster-expand",
                "<Leave>",
                lambda _event: canvas.configure(cursor=""),
            )
            content_bottom = link_top + 38
        else:
            content_bottom = link_top + 4
        canvas.configure(scrollregion=(0, 0, width, max(height, content_bottom)))
        if peak_label is not None:
            if team_size == 3:
                peak_label.configure(text="双方完整阵容")
            elif expanded:
                peak_label.configure(text="滚轮浏览完整阵容")
            else:
                peak_label.configure(text="阵容摘要")

    def _draw_pvp_history_snapshot(self, summary: dict | None = None) -> None:
        """Draw a readable PvP battle snapshot in the fixed native pane.

        The source screenshot uses five columns, but the native right pane is
        intentionally narrow.  Two-line player cards preserve every required
        field (kills, damage, healing, taken) without changing the window
        dimensions.  The lower panel is reserved for server-side matchup
        history and never falls back to the local cache.
        """

        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if canvas is None:
            return
        if summary is None:
            summary = self._selected_history_summary()
        allies, enemies, team_size = self._pvp_snapshot_rosters(summary)
        if team_size in {1, 3, 6, 12} and isinstance(summary, dict):
            self._draw_pvp_history_home_snapshot(
                summary, allies, enemies, team_size
            )
            return
        canvas.delete("all")
        width = max(1, int(canvas.winfo_width() or 1))
        height = max(1, int(canvas.winfo_height() or 1))
        allies, enemies, team_size = self._pvp_snapshot_rosters(summary)
        history_label = getattr(self, "history_snapshot_history_label", None)
        if not allies and not enemies:
            canvas.create_text(
                width // 2,
                height // 2,
                text="暂无双方结算数据",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            if history_label is not None:
                history_label.configure(text="历史数据  --", fg=MUTED)
            return

        self._request_pvp_server_matchups(summary)
        server_key = self._pvp_server_matchup_key(summary)
        loading = bool(getattr(self, "history_pvp_matchup_loading", False))
        error = str(getattr(self, "history_pvp_matchup_error", "") or "")
        server_ready = bool(
            server_key is not None
            and server_key == getattr(self, "history_pvp_server_matchup_cache_key", None)
            and not loading
            and not error
        )
        matchup = (
            getattr(self, "history_pvp_server_matchup_cache", {})
            if server_ready
            else {}
        )

        if history_label is not None:
            if loading:
                history_label.configure(text="历史数据  同步中…", fg=WARN)
            elif error:
                history_label.configure(text="历史数据  服务器暂不可用", fg=WARN)
            elif server_key is None:
                history_label.configure(text="历史数据  缺少对手 UID", fg=MUTED)
            else:
                history_label.configure(text="历史数据  服务器已同步", fg=ACCENT)

        record_id = str(
            (summary or {}).get("battle_id", (summary or {}).get("encounter_id", ""))
        )
        if record_id != getattr(self, "history_pvp_snapshot_record_id", ""):
            self.history_pvp_snapshot_record_id = record_id
            self.history_pvp_snapshot_offset = 0
            try:
                canvas.yview_moveto(0.0)
            except tk.TclError:
                pass
            if team_size >= 12:
                self_index = next(
                    (index for index, row in enumerate(allies) if row.get("is_self")),
                    0,
                )
                self.history_pvp_snapshot_offset = max(0, self_index - 1)

        def metric(value: object) -> str:
            return "--" if value is None else format_number(value)

        def rating_text(row: dict) -> str:
            rating = row.get("extraordinary_rating")
            return "--" if rating is None else f"{int(rating):,}"

        def average(rows: list[dict]) -> int | None:
            ratings = [
                row.get("extraordinary_rating")
                for row in rows
                if not row.get("is_ai") and row.get("extraordinary_rating") is not None
            ]
            return int(sum(ratings) / len(ratings) + 0.5) if ratings else None

        def draw_person_card(row: dict, top: int, accent: str, side: str) -> int:
            card_height = 66
            base = blend_color(SURFACE, accent, 0.10)
            if row.get("is_self"):
                base = blend_color(SURFACE, ACCENT, 0.20)
            canvas.create_rectangle(
                6,
                top,
                width - 6,
                top + card_height,
                fill=base,
                outline=blend_color(BORDER, accent, 0.70),
            )
            if row.get("is_self"):
                canvas.create_rectangle(6, top, 9, top + card_height, fill=ACCENT, outline="")
            profession = self._history_profession_icon(
                int(row.get("profession_id", 0) or 0), 22
            )
            canvas.create_image(15, top + 14, image=profession, anchor="nw")
            name = self._fit_ui_text(
                str(row.get("name") or "未知玩家"),
                max(60, width - 165),
                "micro",
            )
            canvas.create_text(
                43,
                top + 14,
                text=name,
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width - 14,
                top + 14,
                text=rating_text(row),
                fill=WARN if row.get("extraordinary_rating") is not None else MUTED,
                anchor="e",
                font=self._ui_font("micro"),
            )
            stats = (
                f"击败 {metric(row.get('kills'))}  ·  "
                f"伤害 {metric(row.get('damage'))}  ·  "
                f"治疗 {metric(row.get('healing'))}  ·  "
                f"承伤 {metric(row.get('taken'))}"
            )
            canvas.create_text(
                43,
                top + 42,
                text=self._fit_ui_text(stats, max(80, width - 53), "micro"),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("micro"),
            )
            if row.get("current_dead"):
                canvas.create_text(
                    width - 14,
                    top + 42,
                    text="☠",
                    fill=ERROR,
                    anchor="e",
                    font=self._ui_font("micro"),
                )
            return card_height

        content_bottom = height

        def draw_history_panel(top: int, minimum_height: int = 62) -> int:
            nonlocal content_bottom
            panel_bottom = max(top + minimum_height, height - 6)
            content_bottom = max(content_bottom, panel_bottom + 4)
            canvas.create_rectangle(
                6,
                top,
                width - 6,
                panel_bottom,
                fill=PANEL,
                outline=BORDER,
            )
            canvas.create_rectangle(6, top, 9, panel_bottom, fill=WARN, outline="")
            canvas.create_text(
                17,
                top + 16,
                text="历史数据 · 服务器交手记录",
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            if loading:
                message = "正在同步之前遇到的对手…"
                canvas.create_text(
                    17,
                    top + 48,
                    text=message,
                    fill=WARN,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                return panel_bottom
            if error:
                canvas.create_text(
                    17,
                    top + 48,
                    text="服务器历史暂不可用，本栏不使用本地统计代替",
                    fill=WARN,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                return panel_bottom
            if server_key is None:
                canvas.create_text(
                    17,
                    top + 48,
                    text="本场没有可关联的对手 UID",
                    fill=MUTED,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                return panel_bottom
            history_limit = 5 if team_size >= 12 else len(enemies)
            rows = enemies[:history_limit]
            if not rows:
                canvas.create_text(
                    17,
                    top + 48,
                    text="暂无可展示的对手",
                    fill=MUTED,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                return panel_bottom
            row_top = top + 31
            row_height = max(30, (panel_bottom - row_top - 4) // max(1, len(rows)))
            for index, row in enumerate(rows):
                item = matchup.get(str(row.get("character_id") or ""), {})
                row_y = row_top + index * row_height
                fill = SURFACE if index % 2 == 0 else PANEL_2
                canvas.create_rectangle(
                    12,
                    row_y,
                    width - 12,
                    min(panel_bottom - 3, row_y + row_height - 2),
                    fill=fill,
                    outline="",
                )
                name = self._fit_ui_text(
                    str(row.get("name") or "未知玩家"),
                    max(58, width - 205),
                    "micro",
                )
                if not item:
                    line = f"{name}   暂无交手记录"
                    canvas.create_text(
                        18,
                        row_y + row_height // 2,
                        text=line,
                        fill=MUTED,
                        anchor="w",
                        font=self._ui_font("micro"),
                    )
                    continue
                try:
                    rate = float(item.get("win_rate", 0) or 0) * 100
                except (TypeError, ValueError, OverflowError):
                    rate = 0.0
                line = (
                    f"{name}   {int(item.get('total', 0) or 0)}场  "
                    f"胜率 {rate:.1f}%"
                )
                detail = (
                    f"胜 {int(item.get('wins', 0) or 0)}  ·  "
                    f"负 {int(item.get('losses', 0) or 0)}  ·  "
                    f"未知 {int(item.get('unknown', 0) or 0)}"
                )
                canvas.create_text(
                    18,
                    row_y + 11,
                    text=line,
                    fill=ACCENT,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                canvas.create_text(
                    18,
                    row_y + min(row_height - 7, 26),
                    text=detail,
                    fill=MUTED,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
            return panel_bottom

        if team_size == 1:
            left = allies[0] if allies else {}
            right = enemies[0] if enemies else {}
            draw_person_card(left, 6, ACCENT, "我方")
            canvas.create_text(
                width // 2,
                79,
                text="VS",
                fill=WARN,
                anchor="center",
                font=self._ui_font("strong"),
            )
            draw_person_card(right, 91, ERROR, "对手")
            draw_history_panel(164, 150)
            canvas.configure(scrollregion=(0, 0, width, max(height, content_bottom)))
            peak = getattr(self, "history_snapshot_peak_label", None)
            if peak is not None:
                peak.configure(text="1V1 · 我 VS 对手")
            return

        # Two rows per side keep the history panel visible in the fixed pane;
        # the remaining players are reached with the existing wheel control.
        visible = 2
        maximum = max(0, max(len(allies), len(enemies)) - visible)
        offset = min(
            maximum,
            max(0, int(getattr(self, "history_pvp_snapshot_offset", 0) or 0)),
        )
        self.history_pvp_snapshot_offset = offset
        team_header_height = 24
        row_height = 53
        section_height = team_header_height + visible * row_height + 6

        def draw_team(rows: list[dict], title: str, accent: str, top: int) -> None:
            avg = average(rows)
            half = max(100, (width - 18) // 2)
            left = 6 if title == "我方" else 12 + half
            right = left + half
            canvas.create_rectangle(
                left,
                top,
                right,
                top + team_header_height,
                fill=blend_color(SURFACE, accent, 0.22),
                outline=blend_color(BORDER, accent, 0.72),
            )
            canvas.create_text(
                left + 8,
                top + team_header_height // 2,
                text=f"{title} {len(rows)}人",
                fill=accent,
                anchor="w",
                font=self._ui_font("strong"),
            )
            if team_size >= 6:
                canvas.create_text(
                    right - 8,
                    top + team_header_height // 2,
                    text=(f"均 {avg:,}" if avg is not None else "均 --"),
                    fill=accent,
                    anchor="e",
                    font=self._ui_font("micro"),
                )
            shown = rows[offset : offset + visible]
            canvas.create_rectangle(
                left,
                top + team_header_height,
                right,
                top + section_height - 2,
                fill=PANEL,
                outline=blend_color(BORDER, accent, 0.34),
            )
            for index, row in enumerate(shown):
                row_top = top + team_header_height + index * row_height
                row_bottom = row_top + row_height - 2
                fill = (
                    blend_color(SURFACE, ACCENT, 0.20)
                    if row.get("is_self")
                    else SURFACE if index % 2 == 0 else PANEL_2
                )
                canvas.create_rectangle(
                    left + 1,
                    row_top,
                    right - 1,
                    row_bottom,
                    fill=fill,
                    outline=blend_color(BORDER, accent, 0.24),
                )
                if row.get("is_self"):
                    canvas.create_rectangle(
                        left + 1, row_top, left + 4, row_bottom,
                        fill=ACCENT, outline="",
                    )
                icon = self._history_profession_icon(
                    int(row.get("profession_id", 0) or 0), 17
                )
                canvas.create_image(left + 7, row_top + 5, image=icon, anchor="nw")
                name = self._fit_ui_text(
                    str(row.get("name") or "未知玩家"),
                    max(30, half - 48),
                    "micro",
                )
                rating = row.get("extraordinary_rating")
                if team_size >= 6:
                    name = f"{name}  {rating_text(row)}"
                canvas.create_text(
                    left + 28,
                    row_top + 10,
                    text=self._fit_ui_text(name, max(34, half - 34), "micro"),
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                line_one = (
                    f"击 {metric(row.get('kills'))}  ·  "
                    f"伤 {metric(row.get('damage'))}"
                )
                line_two = (
                    f"治 {metric(row.get('healing'))}  ·  "
                    f"承 {metric(row.get('taken'))}"
                )
                canvas.create_text(
                    left + 7,
                    row_top + 29,
                    text=self._fit_ui_text(line_one, max(34, half - 14), "micro"),
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                canvas.create_text(
                    left + 7,
                    row_top + 44,
                    text=self._fit_ui_text(line_two, max(34, half - 14), "micro"),
                    fill=SUBTLE,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                if row.get("current_dead"):
                    canvas.create_text(
                        right - 7,
                        row_top + 10,
                        text="☠",
                        fill=ERROR,
                        anchor="e",
                        font=self._ui_font("micro"),
                    )
            if not shown:
                canvas.create_text(
                    left + half // 2,
                    top + team_header_height + row_height // 2,
                    text="暂无阵容数据",
                    fill=MUTED,
                    font=self._ui_font("micro"),
                )

        # Teams share the same vertical band, matching the game result
        # screen while leaving a dedicated history band underneath.
        draw_team(allies, "我方", ACCENT, 4)
        draw_team(enemies, "敌方", ERROR, 4)
        history_top = 4 + section_height + 8
        history_count = min(len(enemies), 5 if team_size >= 12 else len(enemies))
        history_height = max(148, 37 + history_count * 30)
        draw_history_panel(history_top, history_height)
        canvas.configure(scrollregion=(0, 0, width, max(height, content_bottom)))
        peak = getattr(self, "history_snapshot_peak_label", None)
        if peak is not None:
            peak.configure(
                text=(
                    f"第 {offset + 1}-{min(offset + visible, max(len(allies), len(enemies)))} 人 · 滚轮查看更多"
                    if maximum
                    else "双方完整阵容"
                )
            )

    def _draw_pvp_history_snapshot_legacy(self, summary: dict | None = None) -> None:
        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if canvas is None:
            return
        if summary is None:
            summary = self._selected_history_summary()
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        allies, enemies, team_size = self._pvp_snapshot_rosters(summary)
        if not allies and not enemies:
            canvas.create_text(
                width // 2, height // 2,
                text="暂无双方结算数据", fill=MUTED,
                font=self._ui_font("strong"),
            )
            return
        self._request_pvp_server_matchups(summary)
        server_key = self._pvp_server_matchup_key(summary)
        if server_key == getattr(self, "history_pvp_server_matchup_cache_key", None):
            matchup = getattr(self, "history_pvp_server_matchup_cache", {})
        else:
            matchup = {}
        history_label = getattr(self, "history_snapshot_history_label", None)
        if history_label is not None:
            if getattr(self, "history_pvp_matchup_loading", False):
                history_label.configure(text="历史数据  加载中…", fg=WARN)
            elif getattr(self, "history_pvp_matchup_error", ""):
                history_label.configure(text="历史数据  服务器暂不可用", fg=WARN)
            else:
                history_label.configure(text="历史数据  服务器已同步", fg=ACCENT)
        record_id = str(
            (summary or {}).get("battle_id", (summary or {}).get("encounter_id", ""))
        )
        if record_id != getattr(self, "history_pvp_snapshot_record_id", ""):
            self.history_pvp_snapshot_record_id = record_id
            self.history_pvp_snapshot_offset = 0
            if team_size >= 12:
                self_index = next(
                    (index for index, row in enumerate(allies) if row.get("is_self")),
                    0,
                )
                self.history_pvp_snapshot_offset = max(0, self_index - 1)

        def metric(value):
            return "--" if value is None else format_number(value)

        def average(rows):
            ratings = [
                row.get("extraordinary_rating") for row in rows
                if not row.get("is_ai") and row.get("extraordinary_rating") is not None
            ]
            return int(sum(ratings) / len(ratings) + 0.5) if ratings else None

        if team_size == 1:
            left_row = allies[0] if allies else {}
            right_row = enemies[0] if enemies else {}
            card_gap = 26
            card_width = max(80, (width - card_gap - 16) // 2)
            for index, (row, left, accent) in enumerate((
                (left_row, 6, ACCENT),
                (right_row, 6 + card_width + card_gap, ERROR),
            )):
                canvas.create_rectangle(
                    left, 8, left + card_width, height - 8,
                    fill=blend_color(SURFACE, accent, 0.08),
                    outline=blend_color(BORDER, accent, 0.55),
                )
                name = str(row.get("name") or "未知玩家")
                rating = row.get("extraordinary_rating")
                canvas.create_text(
                    left + 9, 23, text=name, fill=TEXT, anchor="w",
                    font=self._ui_font("strong"),
                )
                canvas.create_text(
                    left + card_width - 9, 23,
                    text="--" if rating is None else f"{rating:,}",
                    fill=WARN, anchor="e", font=self._ui_font("micro"),
                )
                canvas.create_text(
                    left + 9, 51,
                    text=f"击败 {metric(row.get('kills'))}   伤害 {metric(row.get('damage'))}",
                    fill=MUTED, anchor="w", font=self._ui_font("micro"),
                )
                canvas.create_text(
                    left + 9, 72,
                    text=f"治疗 {metric(row.get('healing'))}   承伤 {metric(row.get('taken'))}",
                    fill=SUBTLE, anchor="w", font=self._ui_font("micro"),
                )
            canvas.create_text(
                width // 2, 48, text="VS", fill=WARN,
                font=self._ui_font("strong"),
            )
            enemy_uid = str(right_row.get("character_id") or "")
            history = matchup.get(enemy_uid, {})
            recent = " ".join(history.get("recent", ()))
            canvas.create_text(
                width // 2, height - 3,
                text=(
                    f"历史数据  {history.get('total', 0)} 场 · "
                    f"胜率 {float(history.get('win_rate', 0) or 0) * 100:.1f}% · "
                    f"胜 {history.get('wins', 0)} · 负 {history.get('losses', 0)} · "
                    f"未知 {history.get('unknown', 0)}"
                    + (f" · 最近5场 {recent}" if recent else "")
                ) if history else "历史数据  暂无服务器交手记录",
                fill=MUTED, anchor="s", font=self._ui_font("micro"),
            )
            history_label = getattr(self, "history_snapshot_history_label", None)
            if history_label is not None:
                if history:
                    try:
                        win_rate = float(history.get("win_rate", 0) or 0) * 100
                    except (TypeError, ValueError, OverflowError):
                        win_rate = 0.0
                    history_label.configure(
                        text=(
                            f"历史数据  {history.get('total', 0)}场 · "
                            f"胜率 {win_rate:.1f}%"
                        ),
                        fg=ACCENT,
                    )
                else:
                    history_label.configure(text="历史数据  暂无交手记录", fg=MUTED)
            peak = getattr(self, "history_snapshot_peak_label", None)
            if peak is not None:
                peak.configure(text="1V1 · 我 VS 对手")
            return

        visible = 3
        maximum = max(0, max(len(allies), len(enemies)) - visible)
        offset = min(
            maximum,
            max(0, int(getattr(self, "history_pvp_snapshot_offset", 0) or 0)),
        )
        self.history_pvp_snapshot_offset = offset
        gap = 8
        half = max(100, (width - gap - 12) // 2)

        def draw_team(rows, left, title, accent, enemy=False):
            avg = average(rows)
            canvas.create_rectangle(
                left, 2, left + half, 29,
                fill=blend_color(SURFACE, accent, 0.24),
                outline=blend_color(BORDER, accent, 0.65),
            )
            canvas.create_text(
                left + 8, 10,
                text=f"{title}  {len(rows)}人" + (
                    f" · 平均 {avg:,}" if avg is not None and team_size >= 6 else ""
                ),
                fill=accent, anchor="w", font=self._ui_font("strong"),
            )
            headings = ("玩家名称", "击败", "伤害", "治疗", "承伤")
            column_ratios = (0.02, 0.50, 0.64, 0.77, 0.96)
            for caption, ratio in zip(headings, column_ratios):
                canvas.create_text(
                    left + int(half * ratio), 25,
                    text=caption, fill=MUTED,
                    anchor="e" if caption != "玩家名称" else "w",
                    font=self._ui_font("micro"),
                )
            shown = rows[offset:offset + visible]
            for index, row in enumerate(shown):
                top = 34 + index * 29
                bottom = top + 28
                canvas.create_rectangle(
                    left, top, left + half, bottom,
                    fill=blend_color(SURFACE, ACCENT, 0.13)
                    if row.get("is_self")
                    else (PANEL if index % 2 == 0 else SURFACE),
                    outline=blend_color(BORDER, accent, 0.24),
                )
                if row.get("is_self"):
                    canvas.create_rectangle(left, top, left + 3, bottom, fill=ACCENT, outline="")
                name = str(row.get("name") or "未知玩家")
                rating = row.get("extraordinary_rating")
                rating_text = (
                    f" ({rating:,})" if rating is not None and team_size >= 6 else ""
                )
                line = self._fit_ui_text(
                    f"{name}{rating_text}", max(40, int(half * 0.46)), "micro"
                )
                canvas.create_text(
                    left + 8, top + 14, text=line, fill=TEXT,
                    anchor="w", font=self._ui_font("micro"),
                )
                for value, ratio in zip(
                    (row.get("kills"), row.get("damage"), row.get("healing"), row.get("taken")),
                    column_ratios[1:],
                ):
                    canvas.create_text(
                        left + int(half * ratio), top + 14,
                        text=metric(value), fill=TEXT if value is not None else MUTED,
                        anchor="e", font=self._ui_font("micro"),
                    )
                if row.get("current_dead"):
                    canvas.create_text(
                        left + half - 5, top + 14, text="☠", fill=ERROR,
                        anchor="e", font=self._ui_font("micro"),
                    )

        draw_team(allies, 6, "我方", ACCENT)
        draw_team(enemies, 6 + half + gap, "敌方", ERROR, enemy=True)
        canvas.create_line(6 + half + gap // 2, 5, 6 + half + gap // 2, height - 5, fill=BORDER)
        history_label = getattr(self, "history_snapshot_history_label", None)
        if history_label is not None:
            history_rows = []
            for row in enemies[:5]:
                item = matchup.get(str(row.get("character_id") or ""), {})
                if not item:
                    continue
                try:
                    rate = float(item.get("win_rate", 0) or 0) * 100
                except (TypeError, ValueError, OverflowError):
                    rate = 0.0
                history_rows.append(
                    f"{str(row.get('name') or '未知玩家')[:8]} {item.get('total', 0)}场/{rate:.1f}%"
                )
            history_label.configure(
                text="历史数据  " + (" · ".join(history_rows) if history_rows else "暂无交手记录"),
                fg=ACCENT if history_rows else MUTED,
            )
        peak = getattr(self, "history_snapshot_peak_label", None)
        if peak is not None:
            peak.configure(
                text=(
                    f"第 {offset + 1}-{min(offset + visible, max(len(allies), len(enemies)))} 人 · 滚轮查看更多"
                    if maximum else "双方完整阵容"
                )
            )

    def _history_snapshot_trend_time(self, x: object) -> float | None:
        if getattr(self, "history_trend_source", "") == "settlement_average":
            return None
        bounds = getattr(self, "history_trend_plot_bounds", None)
        if bounds is None:
            return None
        left, right, max_time = bounds
        try:
            pointer_x = float(x)
        except (TypeError, ValueError, OverflowError):
            return None
        if pointer_x < left or pointer_x > right or right <= left:
            return None
        return round(
            max(0.0, min(max_time, (pointer_x - left) * max_time / (right - left)))
        )

    def _history_snapshot_trend_motion(self, event) -> None:
        if getattr(self, "history_meter_mode", "dps") != "dps":
            return
        selected_time = self._history_snapshot_trend_time(getattr(event, "x", 0))
        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if selected_time is None:
            if canvas is not None:
                canvas.configure(cursor="")
            return
        if canvas is not None:
            canvas.configure(cursor="crosshair")
        if selected_time == self.history_trend_hover_time:
            return
        self.history_trend_hover_time = selected_time
        self._draw_history_snapshot_trend()

    def _history_snapshot_trend_leave(self, _event=None) -> None:
        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if canvas is not None:
            canvas.configure(cursor="")
        if self.history_trend_hover_time is None:
            return
        self.history_trend_hover_time = None
        self._draw_history_snapshot_trend()

    def _history_snapshot_trend_select(self, event) -> str:
        selected_time = self._history_snapshot_trend_time(getattr(event, "x", 0))
        if selected_time is None:
            return "break"
        if self.history_trend_selected_time == selected_time:
            self.history_trend_selected_time = None
        else:
            self.history_trend_selected_time = selected_time
        self.history_trend_hover_time = selected_time
        self._draw_history_snapshot_trend()
        return "break"

