        draw.text(
            (badge_right - (detail_box[2] - detail_box[0]), 91),
            completeness_text,
            font=font_small,
            fill=MUTED,
        )

        summary_top, summary_bottom = 146, 226
        scope_caption = "确认来源" if mode == "boss_damage" else "参战队伍"
        scope_value = f"{len(rows)} 个" if mode == "boss_damage" else f"{team_size} 人"
        summary_values = (
            ("战斗时长", format_duration(duration), "#8ed17c"),
            (mode_copy[1], total_amount_text, ACCENT),
            (mode_copy[2], team_rate_text, "#70b9e6"),
            (scope_caption, scope_value, "#c49bea"),
        )
        cell_width = (width - 36) / len(summary_values)
        for index, (caption, value, color) in enumerate(summary_values):
            left = int(18 + cell_width * index)
            right = int(18 + cell_width * (index + 1))
            draw.rectangle((left, summary_top, right, summary_bottom), fill="#151a20", outline="#2f383f")
            draw.rectangle((left, summary_top, left + 3, summary_bottom), fill=color)
            draw.text((left + 17, summary_top + 13), caption, font=font_small, fill=MUTED)
            draw.text((left + 17, summary_top + 37), value, font=font_number, fill=color)

        section_top = 236
        draw.rectangle((18, section_top, width - 18, section_top + 42), fill="#101419", outline="#2f383f")
        draw.text((34, section_top + 11), mode_copy[3], font=font_heading, fill=TEXT)
        draw.text(
            (205, section_top + 14),
            "颜色条代表来源相对伤害"
            if mode == "boss_damage"
            else "颜色条代表队内相对贡献",
            font=font_small,
            fill=MUTED,
        )
        report_badge = mode_copy[6]
        badge_box = draw.textbbox((0, 0), report_badge, font=font_body_bold)
        draw.text(
            (width - 34 - (badge_box[2] - badge_box[0]), section_top + 12),
            report_badge,
            font=font_body_bold,
            fill=ACCENT,
        )
        table_top = section_top + 42
        draw.rectangle((18, table_top, width - 18, table_top + 34), fill="#0d1115", outline="#2f383f")
        headers = (
            ("排名", 44, "la"),
            ("首领 / 机制" if mode == "boss_damage" else "玩家名称", 112, "la"),
            ("相对强度" if mode == "boss_damage" else "队内贡献", 380, "la"),
            (mode_copy[4], 930, "ra"),
            (mode_copy[5], 1065, "ra"),
            ("占比", 1206, "ra"),
        )
        for caption, x, anchor in headers:
            box = draw.textbbox((0, 0), caption, font=font_small)
            draw_x = x if anchor == "la" else x - (box[2] - box[0])
            draw.text((draw_x, table_top + 9), caption, font=font_small, fill=MUTED)

        if not rows:
            empty_text = (
                self._history_boss_coverage_text(boss_damage)[0]
                if mode == "boss_damage"
                else "暂无可用队伍数据"
            )
            empty_box = draw.textbbox((0, 0), empty_text, font=font_body_bold)
            draw.text(
                (
                    (width - (empty_box[2] - empty_box[0])) / 2,
                    table_top + 50,
                ),
                empty_text,
                font=font_body_bold,
                fill=MUTED,
            )

        highest = max((int(row.get("amount", 0) or 0) for row in rows), default=0)
        for index, row in enumerate(rows):
            top = table_top + 34 + index * row_height
            bottom = top + row_height - 2
            class_id = int(row.get("profession_id", 0) or 0)
            _profession, color = self._profession_info(class_id)
            if mode == "boss_damage":
                color = "#e67d72"
            base = "#12171c" if index % 2 == 0 else "#0f1418"
            draw.rectangle((18, top, width - 18, bottom), fill=base)
            amount = int(row.get("amount", 0) or 0)
            bar_ratio = amount / highest if highest > 0 else 0.0
            if bar_ratio > 0:
                draw.rectangle(
                    (380, top + 14, 380 + int(420 * bar_ratio), bottom - 14),
                    fill=blend_color(base, color, 0.62),
                )
            if mode != "boss_damage" and row.get("is_self") is True:
                draw.rectangle((18, top, 22, bottom), fill=ACCENT)
            rank_text = str(index + 1)
            draw.text((48, top + 15), rank_text, font=font_body_bold, fill=ACCENT if index < 3 else MUTED)
            if mode == "boss_damage":
                icon_name = self._history_boss_icon_name(row)
                icon_path = (
                    ASSET_DIR / "bosses" / Path(icon_name).name
                    if icon_name
                    else Path()
                )
                fallback_text = str(row.get("name", "") or "首领")
                fallback_color = "#5d3331"
            else:
                icon_path = ASSET_DIR / "professions" / f"{class_id}.png"
                fallback_text = IconFactory.PROFESSION_GLYPHS.get(class_id, "?")
                fallback_color = color
            profession_icon = self._history_report_asset(
                icon_path,
                30,
                fallback_text=fallback_text,
                fallback_color=fallback_color,
            )
            image.paste(profession_icon, (78, top + 10), profession_icon)
            display_name = (
                f"玩家 {index + 1:02d}"
                if hidden and mode != "boss_damage"
                else str(row.get("name", "")).strip() or f"玩家 {index + 1:02d}"
            )
            draw.text((118, top + 15), display_name[:16], font=font_body_bold, fill=TEXT)
            if mode != "boss_damage" and row.get("is_self") is True:
                name_box = draw.textbbox((118, top + 15), display_name[:16], font=font_body_bold)
                draw.text((name_box[2] + 9, top + 17), "我", font=font_small, fill=ACCENT)

            def draw_right(value: str, right: int, value_color: str = TEXT) -> None:
                box = draw.textbbox((0, 0), value, font=font_body_bold)
                draw.text((right - (box[2] - box[0]), top + 15), value, font=font_body_bold, fill=value_color)

            draw_right(self._history_report_compact_number(amount), 930)
            rate_text = (
                f"{float(row.get('rate', 0.0) or 0.0) * 100:.1f}%"
                if mode == "dt"
                else str(max(0, int(row.get("rate", 0) or 0)))
                if mode == "boss_damage"
                else format_number(row.get("rate", 0))
            )
            draw_right(rate_text, 1065, ACCENT)
            draw_right(f"{float(row.get('share', 0.0) or 0.0) * 100:.1f}%", 1206)

        footer_top = table_top + 34 + max(1, len(rows)) * row_height
        draw.rectangle((18, footer_top, width - 18, footer_top + 40), fill="#101419", outline="#2f383f")
        draw.text((32, footer_top + 12), f"{UI_BRAND}  ·  本地战斗档案", font=font_small, fill=TEXT)
        generated = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        generated_text = f"战报生成于 {generated}"
        generated_box = draw.textbbox((0, 0), generated_text, font=font_small)
        draw.text((width - 32 - (generated_box[2] - generated_box[0]), footer_top + 12), generated_text, font=font_small, fill=MUTED)
        return image

    def _history_team_report_output_path(self, record: dict, mode: str) -> Path:
        directory = APP_DIR
        boss_name = re.sub(
            r'[<>:"/\\|?*]+', "-", self._history_encounter_title(record)
        ).strip(" .-") or "Boss"
        try:
            stamp = dt.datetime.fromtimestamp(
                float(record.get("started_at_epoch", 0.0) or 0.0)
            ).strftime("%Y%m%d-%H%M%S")
        except (OSError, OverflowError, TypeError, ValueError):
            stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        mode_label = {
            "dps": "DPS",
            "hps": "HPS",
            "dt": "DT",
            "boss_damage": "BOSS",
        }.get(mode, "DPS")
        filename = f"叨叨诡秘-全员战报-{boss_name}-{mode_label}-{stamp}.png"
        path = directory / filename
        suffix = 2
        while path.exists():
            path = directory / f"{Path(filename).stem}-{suffix}.png"
            suffix += 1
        return path

    def _capture_history_team_report_by_id(self, battle_id: str) -> str:
        battle_id = str(battle_id or "")
        summary = next(
            (
                row
                for row in getattr(self, "history_records", [])
                if str(row.get("battle_id", row.get("encounter_id", "")))
                == battle_id
            ),
            None,
        )
        raw_record = self.history_store.load(battle_id) if battle_id else None
        record = self._restore_history_record(raw_record)
        if not isinstance(record, dict) and isinstance(summary, dict) and isinstance(summary.get("participants"), list):
            record = dict(summary)
        if not isinstance(record, dict):
            self._show_notice(
                "全员截图", "这场战斗记录已不存在，请刷新战斗列表。", parent=self.history_window
            )
            return "break"
        if isinstance(summary, dict):
            record = {**record, **summary, "participants": record.get("participants", [])}
        try:
            mode = getattr(self, "history_meter_mode", "dps")
            image = self._render_history_team_report_image(record, mode)
            path = self._history_team_report_output_path(record, mode)
            image.save(path, format="PNG", optimize=True)
        except (OSError, TypeError, ValueError) as exc:
            self._show_notice(
                "全员截图", f"战报图片保存失败：{exc}", parent=self.history_window
            )
            return "break"
        try:
            os.startfile(str(path))
        except (AttributeError, OSError):
            pass
        self._show_notice(
            "全员截图",
            f"已保存并打开全员战报：\n{path}",
            parent=self.history_window,
        )
        return "break"

    @staticmethod
    def _history_is_boss(record: dict) -> bool:
        if str(record.get("target_filter", "")).casefold() == "healing_dummy":
            # Pure HPS records are deliberately not Boss records, but they
            # still belong in the history view when the normal filter is on.
            return True
        monster = record.get("monster")
        if not isinstance(monster, dict):
            return False
        try:
            boss_rank = int(monster.get("boss_rank", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            boss_rank = 0
        try:
            boss_type = int(monster.get("boss_type", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            boss_type = 0
        entity_type = str(monster.get("entity_type", "")).casefold()
        return (
            boss_rank >= 3
            or boss_type == 3
            or "boss" in entity_type
            or "首领" in entity_type
        )

    def _initial_history_geometry(self, x: int, y: int) -> str:
        saved = str(self.config.get("history_geometry", ""))
        parsed = parse_absolute_tk_geometry(saved)
        if parsed is not None:
            saved_width, saved_height, saved_x, saved_y = parsed
            width = max(900, saved_width)
            height = max(600, saved_height)
            x, y = saved_x, saved_y
        else:
            width = BACKEND_WIDTH
            height = BACKEND_HEIGHT
        return self._visible_geometry(
            format_absolute_tk_geometry(width, height, x, y),
            BACKEND_WIDTH,
            BACKEND_HEIGHT,
        )

    def show_history(self) -> None:
        self.show_backend("history")

    def show_main_menu(self) -> None:
        self.show_backend("history")

    def show_settings(self) -> None:
        self.show_backend("settings")

    def show_backend(self, page: str = "history") -> None:
        if self.compact_mode:
            return
        page = str(page or "history")
        if page not in {"history", "updates", "settings"}:
            page = "history"
        # Preserve the requested page while the shared backend window is
        # being built; otherwise opening Settings briefly creates a topmost
        # History page before the second page switch runs.
        self.backend_current_page = page
        if self.history_window is None or not self.history_window.winfo_exists():
            self._build_history_window()
        self._select_backend_page(page)
        self.tray_history_hidden = False
        self._hide_main_tooltip()
        self._close_notice_window()
        self._remember_root_geometry()
        self._destroy_unlock_window()
        self.main_window_intentionally_hidden = True
        self.root.withdraw()
        self.history_window.deiconify()
        self.history_window.lift()
        self._sync_backend_window_topmost()
        if page == "settings":
            self.history_window.focus_set()
        else:
            self.history_window.focus_force()
        if page == "history":
            self._refresh_history_records()

