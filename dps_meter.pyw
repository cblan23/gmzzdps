    def _draw_history_boss_details(self) -> None:
        canvas = self.history_skill_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        boss_damage = self._history_boss_damage(record)
        sources = self._history_boss_sources(record)
        source = next(
            (
                row
                for row in sources
                if int(row.get("entity_id", 0) or 0)
                == int(self.history_selected_actor or 0)
            ),
            None,
        )
        if not isinstance(source, dict):
            message, color = self._history_boss_coverage_text(boss_damage)
            canvas.create_text(
                width // 2,
                height // 2 - 9,
                text=message,
                fill=color,
                font=self._ui_font("strong"),
            )
            if message == "该场未记录首领伤害":
                canvas.create_text(
                    width // 2,
                    height // 2 + 16,
                    text="仅新产生且捕获到精确攻击事件的记录可展示",
                    fill=SUBTLE,
                    font=self._ui_font("micro"),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        target_mode = self.history_detail_mode == "targets"
        raw_rows = source.get("targets" if target_mode else "skills", [])
        rows = (
            [row for row in raw_rows if isinstance(row, dict)]
            if isinstance(raw_rows, list)
            else []
        )
        header_height = 30
        row_height = 42
        top = header_height
        canvas.create_rectangle(
            0, 0, width, header_height, fill=SURFACE, outline=""
        )
        if target_mode:
            columns = {
                "damage": int(width * 0.66),
                "share": int(width * 0.82),
                "hits": width - 14,
            }
            headers = (
                ("受击成员", 12, "w"),
                ("承受伤害", columns["damage"], "e"),
                ("来源占比", columns["share"], "e"),
                ("命中次数", columns["hits"], "e"),
            )
        else:
            columns = {
                "damage": int(width * 0.52),
                "share": int(width * 0.64),
                "hits": int(width * 0.76),
                "average": int(width * 0.88),
                "max_hit": width - 14,
            }
            headers = (
                ("首领技能", 42, "w"),
                ("伤害", columns["damage"], "e"),
                ("占比", columns["share"], "e"),
                ("命中次数", columns["hits"], "e"),
                ("平均命中", columns["average"], "e"),
                ("最高一击", columns["max_hit"], "e"),
            )
        for text_value, x, anchor in headers:
            canvas.create_text(
                x,
                header_height // 2,
                text=text_value,
                fill=MUTED,
                anchor=anchor,
                font=self._ui_font("small"),
            )
        if not rows:
            canvas.create_text(
                width // 2,
                top + row_height // 2,
                text="暂无受击成员明细" if target_mode else "暂无首领技能明细",
                fill=MUTED,
                font=self._ui_font("body"),
            )
            top += row_height

        participant_rows = (
            record.get("participants", []) if isinstance(record, dict) else []
        )
        participant_rows = (
            participant_rows if isinstance(participant_rows, list) else []
        )
        participant_index = {
            int(row.get("actor_id", 0) or 0): index
            for index, row in enumerate(participant_rows)
            if isinstance(row, dict)
        }
        max_damage = max(
            (max(0, int(row.get("damage", 0) or 0)) for row in rows),
            default=0,
        )
        icons: list[object] = []
        name_right = columns["damage"] - 14
        for index, row in enumerate(rows):
            bottom = top + row_height
            base = PANEL if index % 2 == 0 else SURFACE
            damage = max(0, int(row.get("damage", 0) or 0))
            share = max(0.0, min(1.0, float(row.get("share", 0.0) or 0.0)))
            hits = max(0, int(row.get("hits", 0) or 0))
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline=""
            )
            if max_damage:
                canvas.create_rectangle(
                    0,
                    top,
                    max(3, int(width * damage / max_damage)),
                    bottom - 1,
                    fill=blend_color(base, "#e67d72", 0.12),
                    outline="",
                )
            if target_mode:
                actor_id = int(row.get("actor_id", 0) or 0)
                name = str(row.get("name", "")).strip() or "队伍成员"
                if self._history_names_hidden():
                    target_index = participant_index.get(actor_id, index)
                    name = f"玩家{target_index + 1}"
                name_x = 12
            else:
                skill_id = int(row.get("skill_id", 0) or 0)
                name = str(row.get("name", "")).strip() or "未命名技能"
                icon = self.icons.skill(skill_id, name, 0, 24)
                icons.append(icon)
                canvas.create_image(
                    10, top + (row_height - 24) // 2, image=icon, anchor="nw"
                )
                name_x = 42
            canvas.create_text(
                name_x,
                top + row_height // 2,
                text=self._fit_ui_text(
                    name, max(40, name_right - name_x), "strong"
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            for key, text_value in (
                ("damage", format_number(damage)),
                ("share", f"{share * 100:.1f}%"),
                ("hits", str(hits)),
            ):
                canvas.create_text(
                    columns[key],
                    top + row_height // 2,
                    text=text_value,
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font(
                        "number_strong" if key == "damage" else "number"
                    ),
                )
            if not target_mode:
                canvas.create_text(
                    columns["average"],
                    top + row_height // 2,
                    text=format_number(float(row.get("average_hit", 0.0) or 0.0)),
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number"),
                )
                canvas.create_text(
                    columns["max_hit"],
                    top + row_height // 2,
                    text=format_number(max(0, int(row.get("max_hit", 0) or 0))),
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number"),
                )
            top = bottom
        canvas._history_boss_skill_icons = icons
        canvas.configure(scrollregion=(0, 0, width, max(height, top)))

    def _draw_history_skills(self) -> None:
        canvas = self.history_skill_canvas
        if canvas is None:
            return
        if getattr(self, "history_meter_mode", "dps") == "boss_damage":
            self._draw_history_boss_details()
            return
        if getattr(self, "history_meter_mode", "dps") == "hps":
            self._draw_history_healing_details()
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        if getattr(self, "history_meter_mode", "dps") == "dt":
            canvas.create_text(
                width // 2,
                height // 2,
                text="承伤技能归属暂不可用",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        record = self._selected_history_record()
        participants = record.get("participants", []) if record else []
        participants = participants if isinstance(participants, list) else []
        participant = next(
            (
                item
                for item in participants
                if int(item.get("actor_id", 0) or 0)
                == self.history_selected_actor
            ),
            None,
        )
        if not isinstance(participant, dict):
            canvas.create_text(
                width // 2,
                height // 2,
                text="暂无个人详情",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        detail_layout = getattr(self, "history_page_mode", "browser") == "detail"
        row_height = 42 if detail_layout else 38
        header_height = 30
        top = header_height
        if self.history_detail_mode == "targets":
            columns = {
                "type": int(width * 0.60),
                "damage": int(width * 0.80),
                "share": width - 14,
            }
            canvas.create_rectangle(
                0, 0, width, header_height, fill=SURFACE, outline=""
            )
            for text, x, anchor in (
                ("伤害目标", 12, "w"),
                ("类型", columns["type"], "e"),
                ("伤害", columns["damage"], "e"),
                ("占个人总伤", columns["share"], "e"),
            ):
                canvas.create_text(
                    x,
                    header_height // 2,
                    text=text,
                    fill=MUTED,
                    anchor=anchor,
                    font=self._ui_font("small"),
                )
            rows = participant.get("targets", [])
            rows = rows if isinstance(rows, list) else []
            if not rows:
                canvas.create_text(
                    width // 2,
                    top + row_height // 2,
                    text="暂无目标伤害",
                    fill=MUTED,
                    font=self._ui_font("body"),
                )
                top += row_height
            for index, target in enumerate(rows):
                bottom = top + row_height
                base = PANEL if index % 2 == 0 else SURFACE
                kind = str(target.get("kind", "小怪"))
                color = WARN if kind == "Boss" else ACCENT
                name = str(target.get("name", "")).strip() or "未命名目标"
                entity_ids = target.get("entity_ids", [])
                entity_count = len(entity_ids) if isinstance(entity_ids, list) else 0
                if entity_count > 1 and not bool(
                    target.get("history_encounter_group")
                ):
                    name = f"{name} ×{entity_count}"
                share = float(target.get("share", 0.0) or 0.0)
                canvas.create_rectangle(
                    0, top, width, bottom - 1, fill=base, outline=""
                )
                canvas.create_text(
                    12,
                    top + row_height // 2,
                    text=name,
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("strong"),
                )
                canvas.create_text(
                    columns["type"],
                    top + row_height // 2,
                    text=kind,
                    fill=color,
                    anchor="e",
                    font=self._ui_font("small"),
                )
                canvas.create_text(
                    columns["damage"],
                    top + row_height // 2,
                    text=format_number(target.get("damage", 0)),
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number_strong"),
                )
                canvas.create_text(
                    columns["share"],
                    top + row_height // 2,
                    text=f"{share * 100:.1f}%",
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number"),
                )
                top = bottom
        else:
            detail_columns = detail_layout and width >= 600
            columns = (
                {
                    "damage": int(width * 0.52),
                    "share": int(width * 0.64),
                    "dps": int(width * 0.76),
                    "hits": int(width * 0.88),
                    "max_hit": width - 14,
                }
                if detail_columns
                else {
                    "damage": int(width * 0.59),
                    "share": int(width * 0.75),
                    "hits": width - 14,
                }
            )
            canvas.create_rectangle(
                0, 0, width, header_height, fill=SURFACE, outline=""
            )
            headers = [
                ("技能", 42, "w"),
                ("总伤害", columns["damage"], "e"),
                ("占比", columns["share"], "e"),
            ]
            if detail_columns:
                headers.extend(
                    [
                        ("技能 DPS", columns["dps"], "e"),
                        ("打击次数", columns["hits"] - 18, "e"),
                        ("最高一击", columns["max_hit"] - 18, "e"),
                    ]
                )
            for text, x, anchor in headers:
                canvas.create_text(
                    x,
                    header_height // 2,
                    text=text,
                    fill=MUTED,
                    anchor=anchor,
                    font=self._ui_font("small"),
                )
            hits_help_x = columns["hits"] - 5
            hits_help_tag = ("history-skill-hits-help",)
            if not detail_columns:
                canvas.create_text(
                    hits_help_x - 12,
                    header_height // 2,
                    text="打击次数",
                    fill=MUTED,
                    anchor="e",
                    font=self._ui_font("small"),
                    tags=hits_help_tag,
                )
            canvas.create_oval(
                hits_help_x - 7,
                header_height // 2 - 7,
                hits_help_x + 7,
                header_height // 2 + 7,
                fill="#17342c",
                outline=ACCENT,
                width=1,
                tags=hits_help_tag,
            )
            canvas.create_text(
                hits_help_x,
                header_height // 2,
                text="?",
                fill=ACCENT,
                font=self._ui_font("micro"),
                tags=hits_help_tag,
            )
            canvas.tag_bind(
                "history-skill-hits-help",
                "<Enter>",
                lambda _event: (
                    canvas.configure(cursor="hand2"),
                    self._show_history_skill_hits_help(),
                ),
            )
            if detail_columns:
                max_help_x = columns["max_hit"] - 5
                canvas.create_oval(
                    max_help_x - 7,
                    header_height // 2 - 7,
                    max_help_x + 7,
                    header_height // 2 + 7,
                    fill="#17342c",
                    outline=ACCENT,
                    width=1,
                    tags=("history-skill-max-help",),
                )
                canvas.create_text(
                    max_help_x,
                    header_height // 2,
                    text="?",
                    fill=ACCENT,
                    font=self._ui_font("micro"),
                    tags=("history-skill-max-help",),
                )
                canvas.tag_bind(
                    "history-skill-max-help",
                    "<Enter>",
                    lambda _event: self._show_history_skill_help(
                        "history-skill-max-tooltip",
                        "本机角色可由逐次命中准确统计；队友结算明细目前不提供单次最高伤害。",
                    ),
                )
                canvas.tag_bind(
                    "history-skill-max-help",
                    "<Leave>",
                    lambda _event: canvas.delete("history-skill-max-tooltip"),
                )
            canvas.tag_bind(
                "history-skill-hits-help",
                "<Leave>",
                lambda _event: (
                    canvas.configure(cursor=""),
                    self._hide_history_skill_hits_help(),
                ),
            )
            rows = self._history_damage_skills(participant)
            if not rows:
                canvas.create_text(
                    width // 2,
                    top + row_height // 2,
                    text=(
                        TEAMMATE_SKILL_DETAIL_MISSING_MESSAGE
                        if str(participant.get("skill_detail_status", ""))
                        == "pending_server_detail"
                        else "暂无技能详情"
                    ),
                    width=max(120, width - 40),
                    fill=MUTED,
                    font=self._ui_font("body"),
                )
                top += row_height
            class_id = int(participant.get("profession_id", 0) or 0)
            _profession, skill_color = self._profession_info(class_id)
            max_skill_damage = max(
                (
                    max(0, int(row.get("damage", 0) or 0))
                    for row in rows
                    if isinstance(row, dict)
                ),
                default=0,
            )
            for index, skill in enumerate(rows):
                bottom = top + row_height
                base = PANEL if index % 2 == 0 else SURFACE
                try:
                    skill_id = int(skill.get("skill_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    skill_id = 0
                name = str(skill.get("name", "")).strip() or "未命名技能"
                icon = self.icons.skill(skill_id, name, class_id, 24)
                hits_value = skill.get("hits")
                hits_text = "--" if hits_value is None else str(int(hits_value or 0))
                canvas.create_rectangle(
                    0, top, width, bottom - 1, fill=base, outline=""
                )
                try:
                    skill_damage = max(0, int(skill.get("damage", 0) or 0))
                except (TypeError, ValueError, OverflowError):
                    skill_damage = 0
                if detail_layout and max_skill_damage:
                    bar_ratio = skill_damage / max_skill_damage
                    canvas.create_rectangle(
                        0,
                        top,
                        max(3, int(width * bar_ratio)),
                        bottom - 1,
                        fill=blend_color(base, skill_color, 0.13),
                        outline="",
                    )
                canvas.create_image(
                    10,
                    top + (row_height - 24) // 2,
                    image=icon,
                    anchor="nw",
                )
                canvas.create_text(
                    42,
                    top + row_height // 2,
                    text=name,
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("strong"),
                )
                canvas.create_text(
                    columns["damage"],
                    top + row_height // 2,
                    text=format_number(skill.get("damage", 0)),
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number_strong"),
                )
                canvas.create_text(
                    columns["share"],
                    top + row_height // 2,
                    text=f"{float(skill.get('share', 0.0) or 0.0) * 100:.1f}%",
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number"),
                )
                if detail_columns:
                    duration = dps_duration_seconds(
                        (record or {}).get(
                            "dps_duration_seconds",
                            (record or {}).get("duration_seconds", 0),
                        )
                    )
                    skill_dps = skill_damage / duration if duration else 0.0
                    canvas.create_text(
                        columns["dps"],
                        top + row_height // 2,
                        text=format_number(skill_dps),
                        fill=ACCENT,
                        anchor="e",
                        font=self._ui_font("number_strong"),
                    )
                canvas.create_text(
                    columns["hits"],
                    top + row_height // 2,
                    text=hits_text,
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number"),
                )
                if detail_columns:
                    max_hit = skill.get("max_hit")
                    canvas.create_text(
                        columns["max_hit"],
                        top + row_height // 2,
                        text=(
                            "--"
                            if max_hit is None
                            else format_number(max(0, int(max_hit or 0)))
                        ),
                        fill=TEXT if max_hit is not None else SUBTLE,
                        anchor="e",
                        font=self._ui_font("number"),
                    )
                top = bottom
        canvas.configure(scrollregion=(0, 0, width, max(height, top)))

    def _draw_history_healing_details(self) -> None:
        canvas = self.history_skill_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        healers = record.get("healers", []) if record else []
        healers = healers if isinstance(healers, list) else []
        healer = next(
            (
                item
                for item in healers
                if isinstance(item, dict)
                and int(item.get("actor_id", 0) or 0)
                == self.history_selected_actor
            ),
            None,
        )
        if not isinstance(healer, dict):
            canvas.create_text(
                width // 2,
                height // 2,
                text="暂无个人治疗详情",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        rows = healer.get(
            "targets" if self.history_detail_mode == "targets" else "skills",
            [],
        )
        rows = rows if isinstance(rows, list) else []
        header_height = 30
        detail_layout = getattr(self, "history_page_mode", "browser") == "detail"
        row_height = 42 if detail_layout else 38
        effective_x, share_x = int(width * 0.78), width - 14
        canvas.create_rectangle(
            0, 0, width, header_height, fill=SURFACE, outline=""
        )
        for text_value, x, anchor in (
            (
                "治疗目标"
                if self.history_detail_mode == "targets"
                else "治疗技能",
                42 if self.history_detail_mode == "skills" else 12,
                "w",
            ),
            ("有效治疗", effective_x, "e"),
            ("占比", share_x, "e"),
        ):
            canvas.create_text(
                x,
                header_height // 2,
                text=text_value,
                fill=MUTED,
                anchor=anchor,
                font=self._ui_font("small"),
            )
        top = header_height
        if not rows:
            message = (
                "已观测治疗目标为空；服务器不提供目标分布"
                if self.history_detail_mode == "targets"
                and healer.get("coverage")
                == "server_effective_with_partial_callbacks"
                else "暂无治疗明细"
            )
            canvas.create_text(
                width // 2,
                top + row_height // 2,
                text=message,
                fill=MUTED,
                font=self._ui_font("body"),
            )
            top += row_height
        class_id = int(healer.get("profession_id", 0) or 0)
        _profession, healing_color = self._profession_info(class_id)
        max_effective = max(
            (
                max(0, int(row.get("effective_healing", 0) or 0))
                for row in rows
                if isinstance(row, dict)
            ),
            default=0,
        )
        for index, row in enumerate(rows):
            bottom = top + row_height
            base = PANEL if index % 2 == 0 else SURFACE
            name = str(row.get("name", "")).strip() or (
                "未命名玩家"
                if self.history_detail_mode == "targets"
                else "未命名治疗"
            )
            effective = int(row.get("effective_healing", 0) or 0)
            share = max(0.0, min(1.0, float(row.get("share", 0.0) or 0.0)))
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline=""
            )
            if detail_layout and max_effective:
                canvas.create_rectangle(
                    0,
                    top,
                    max(3, int(width * effective / max_effective)),
                    bottom - 1,
                    fill=blend_color(base, healing_color, 0.13),
                    outline="",
                )
            name_x = 12
            if self.history_detail_mode == "skills":
                skill_id = int(row.get("skill_id", 0) or 0)
                icon = self.icons.skill(skill_id, name, class_id, 24)
                canvas.create_image(
                    10, top + (row_height - 24) // 2, image=icon, anchor="nw"
                )
                name_x = 42
            canvas.create_text(
                name_x,
                top + row_height // 2,
                text=name,
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            for x, text_value, strong in (
                (effective_x, format_number(effective), True),
                (share_x, f"{share * 100:.1f}%", False),
            ):
                canvas.create_text(
                    x,
                    top + row_height // 2,
                    text=text_value,
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number_strong" if strong else "number"),
                )
            top = bottom
        canvas.configure(scrollregion=(0, 0, width, max(height, top)))

    def _draw_history_skills_legacy(self) -> None:
        canvas = self.history_skill_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        participants = record.get("participants", []) if record else []
        participants = participants if isinstance(participants, list) else []
        participant = next(
            (
                item
                for item in participants
                if int(item.get("actor_id", 0) or 0) == self.history_selected_actor
            ),
            None,
        )
        if not isinstance(participant, dict):
            canvas.create_text(
                width // 2,
                height // 2,
                text="暂无个人详情",
                fill=MUTED,
                font=tk_font_spec("Microsoft YaHei UI", 9, "bold"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        targets = participant.get("targets", [])
        targets = targets if isinstance(targets, list) else []
        skills = participant.get("skills", []) if isinstance(participant, dict) else []
        skills = skills if isinstance(skills, list) else []
        if not skills and isinstance(participant, dict):
            try:
                aggregate_damage = max(0, int(participant.get("damage", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                aggregate_damage = 0
            if aggregate_damage:
                skills = [
                    {
                        "name": "未归类伤害",
                        "damage": aggregate_damage,
                        "share": 1.0,
                        "hits": None,
                        "max_hit": None,
                    }
                ]
        damage_x, share_x, hits_x = (
            int(width * 0.64),
            int(width * 0.82),
            width - 12,
        )
        row_height = 34
        header_height = 28
        top = 0

        canvas.create_rectangle(0, top, width, top + header_height, fill=SURFACE, outline="")
        canvas.create_text(9, top + 14, text="伤害目标", fill=ACCENT, anchor="w", font=tk_font_spec("Microsoft YaHei UI", 8, "bold"))
        canvas.create_text(int(width * 0.55), top + 14, text="类型", fill=MUTED, anchor="e", font=tk_font_spec("Microsoft YaHei UI", 8, "bold"))
        canvas.create_text(int(width * 0.77), top + 14, text="伤害", fill=MUTED, anchor="e", font=tk_font_spec("Microsoft YaHei UI", 8, "bold"))
