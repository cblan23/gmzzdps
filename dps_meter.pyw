    def _backend_nav_button(
        self,
        parent: tk.Misc,
        key: str,
        icon_name: str,
        caption: str,
        *,
        enabled: bool,
        module_tag: str = "",
    ) -> tk.Frame:
        row = tk.Frame(
            parent,
            bg="#070d12",
            height=54,
            cursor="hand2" if enabled else "arrow",
        )
        row.pack_propagate(False)
        surface = tk.Frame(
            row,
            bg="#070d12",
            height=52,
            highlightthickness=0,
            cursor="hand2" if enabled else "arrow",
        )
        surface.pack(fill="both", expand=True, pady=1)
        surface.pack_propagate(False)
        indicator = tk.Frame(surface, bg="#070d12", width=4)
        indicator.pack(side="left", fill="y")
        icon_surface = tk.Frame(
            surface,
            bg="#070d12",
            width=49,
            height=52,
            highlightthickness=0,
            cursor="hand2" if enabled else "arrow",
        )
        icon_surface.pack(side="left")
        icon_surface.pack_propagate(False)
        icon_image = self.icons.toolbar(
            icon_name, 21, "#c8dcff" if enabled else "#52637a"
        )
        icon_label = tk.Label(
            icon_surface,
            image=icon_image,
            bg="#070d12",
            anchor="center",
            bd=0,
            cursor="hand2" if enabled else "arrow",
        )
        icon_label.image = icon_image
        icon_label.pack(fill="both", expand=True)
        chevron_color = "#b9d4ff" if enabled else "#52637a"
        chevron_image = self.icons.toolbar(
            "chevron_right", 14, chevron_color
        )
        chevron_label = tk.Label(
            surface,
            image=chevron_image,
            bg="#070d12",
            anchor="center",
            bd=0,
            cursor="hand2" if enabled else "arrow",
        )
        chevron_label.image = chevron_image
        chevron_label.pack(side="right", padx=(4, 12))
        normalized_module_tag = str(module_tag or "").strip().upper()
        module_badge = None
        module_badge_label = None
        if normalized_module_tag in {"PVE", "PVP"}:
            badge_background, badge_border, badge_foreground = (
                (
                    PVE_MODE_BACKGROUND,
                    PVE_MODE_BORDER,
                    PVE_MODE_FOREGROUND,
                )
                if normalized_module_tag == "PVE"
                else (
                    PVP_MODE_BACKGROUND,
                    PVP_MODE_BORDER,
                    PVP_MODE_FOREGROUND,
                )
            )
            module_badge = tk.Frame(
                surface,
                bg=badge_background,
                width=38,
                height=20,
                highlightthickness=1,
                highlightbackground=badge_border,
                cursor="hand2" if enabled else "arrow",
            )
            module_badge.pack(side="right", padx=(0, 2))
            module_badge.pack_propagate(False)
            module_badge_label = tk.Label(
                module_badge,
                text=normalized_module_tag,
                bg=badge_background,
                fg=badge_foreground,
                anchor="center",
                bd=0,
                cursor="hand2" if enabled else "arrow",
                font=self._ui_font("sidebar_tag"),
            )
            module_badge_label.pack(fill="both", expand=True)
        caption_label = tk.Label(
            surface,
            text=caption,
            bg="#070d12",
            fg="#d2dae0" if enabled else "#53616d",
            anchor="w",
            bd=0,
            cursor="hand2" if enabled else "arrow",
            font=self._ui_font("nav" if enabled else "body"),
        )
        caption_label.pack(side="left", fill="both", expand=True)
        separator = tk.Frame(row, bg="#102d3b", height=1)
        separator.place(x=38, rely=1.0, relwidth=1.0, width=-48, anchor="sw")
        row._disabled = not enabled
        row._page_key = key
        row._surface = surface
        row._indicator = indicator
        row._icon_surface = icon_surface
        row._icon_label = icon_label
        row._icon_name = icon_name
        row._caption_label = caption_label
        row._chevron_label = chevron_label
        row._module_badge = module_badge
        row._module_badge_label = module_badge_label
        row._module_tag = normalized_module_tag
        row._separator = separator
        if enabled:
            interactive_widgets = (
                row,
                surface,
                indicator,
                icon_surface,
                icon_label,
                caption_label,
                chevron_label,
            )
            if module_badge is not None and module_badge_label is not None:
                interactive_widgets += (module_badge, module_badge_label)
            for widget in interactive_widgets:
                widget.bind(
                    "<Button-1>",
                    lambda _event, page_key=key: self._select_backend_page(
                        page_key
                    ),
                )
                widget.bind(
                    "<Enter>",
                    lambda _event, button=row: (
                        self._style_backend_nav_button(
                            button, "#101b21", "#ecf3f6"
                        )
                        if self.backend_current_page != button._page_key
                        else None
                    ),
                )
                widget.bind(
                    "<Leave>",
                    lambda _event: self._sync_backend_navigation(),
                )
        return row

    def _style_backend_nav_button(
        self,
        button: tk.Frame,
        background: str,
        foreground: str,
        *,
        selected: bool = False,
    ) -> None:
        disabled = bool(getattr(button, "_disabled", False))
        button.configure(bg="#070d12")
        icon_background = background
        icon_color = (
            "#52637a" if disabled else "#4deee8" if selected else foreground
        )
        button._surface.configure(bg=background)
        button._indicator.configure(bg=ACCENT if selected else background)
        button._icon_surface.configure(bg=icon_background)
        icon = self.icons.toolbar(button._icon_name, 21, icon_color)
        button._icon_label.configure(bg=icon_background, image=icon)
        button._icon_label.image = icon
        chevron_color = (
            "#52637a" if disabled else "#61f3ee" if selected else "#b9d4ff"
        )
        chevron = self.icons.toolbar("chevron_right", 14, chevron_color)
        button._chevron_label.configure(bg=icon_background, image=chevron)
        button._chevron_label.image = chevron
        button._separator.configure(
            bg="#146477" if selected else "#102d3b"
        )
        button._caption_label.configure(bg=background, fg=foreground)

    def _sync_backend_navigation(self) -> None:
        for key, button in self.backend_nav_buttons.items():
            if getattr(button, "_disabled", False):
                self._style_backend_nav_button(button, "#070d12", "#66758d")
            elif key == self.backend_current_page:
                self._style_backend_nav_button(
                    button, "#07323a", "#e5ffff", selected=True
                )
            else:
                self._style_backend_nav_button(
                    button, "#070d12", "#d3e1f7"
                )

    def _schedule_backend_sidebar_art(self, _event=None) -> None:
        canvas = getattr(self, "backend_sidebar_art_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        pending = getattr(self, "backend_sidebar_art_after_id", None)
        if pending is not None:
            try:
                canvas.after_cancel(pending)
            except tk.TclError:
                pass
        self.backend_sidebar_art_after_id = canvas.after(
            35, self._draw_backend_sidebar_art
        )

    def _draw_backend_sidebar_art(self) -> None:
        self.backend_sidebar_art_after_id = None
        canvas = getattr(self, "backend_sidebar_art_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        width = max(1, int(canvas.winfo_width()))
        height = max(1, int(canvas.winfo_height()))
        if width < 8 or height < 8:
            self._schedule_backend_sidebar_art()
            return
        image = self.icons.sidebar_art(width, height)
        canvas.delete("all")
        canvas.create_image(
            0,
            0,
            image=image,
            anchor="nw",
            tags=("sidebar-art",),
        )
        canvas._sidebar_art_image = image
        if height >= 104:
            quote_y = min(68, max(40, round(height * 0.16)))
            canvas.create_text(
                width / 2 + 1,
                quote_y + 1,
                text="记录每一次战斗",
                fill="#07111d",
                anchor="center",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width / 2,
                quote_y,
                text="记录每一次战斗",
                fill="#cfe4ff",
                anchor="center",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width / 2 + 1,
                quote_y + 27,
                text="让数据说话",
                fill="#07111d",
                anchor="center",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width / 2,
                quote_y + 26,
                text="让数据说话",
                fill="#b9d4ff",
                anchor="center",
                font=self._ui_font("strong"),
            )
            canvas.create_line(
                width / 2 - 12,
                quote_y + 49,
                width / 2 + 12,
                quote_y + 49,
                fill="#76cfff",
                width=2,
            )

    def _scroll_backend_page(self, event) -> str | None:
        if self.backend_current_page == "updates":
            canvas = getattr(self, "update_log_canvas", None)
        elif self.backend_current_page in {"history", "kings"}:
            canvas = getattr(self, "history_page_canvas", None)
        elif self.backend_current_page == "alliance":
            page = getattr(self, "backend_pages", {}).get(self.backend_current_page)
            child = getattr(page, "child_history", None)
            canvas = getattr(child or page, "canvas", None)
        else:
            return None
        if canvas is None:
            return None
        try:
            delta = int(getattr(event, "delta", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            delta = 0
        try:
            button = int(getattr(event, "num", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            button = 0
        if button == 4:
            amount = -1
        elif button == 5:
            amount = 1
        elif delta:
            steps = max(1, abs(delta) // 120)
            amount = -steps if delta > 0 else steps
        else:
            return "break"
        try:
            canvas.yview_scroll(amount, "units")
        except tk.TclError:
            return None
        return "break"

    def _ensure_backend_page(self, page: str) -> tk.Frame:
        """Build only the requested backend page and cache it until logout."""

        page = str(page or "history")
        existing = self.backend_pages.get(page)
        if existing is not None:
            try:
                if existing.winfo_exists():
                    return existing
            except (AttributeError, tk.TclError):
                # Lightweight test doubles do not need Tk lifetime checks.
                return existing
            self.backend_pages.pop(page, None)

        parent = getattr(self, "backend_page_host", None)
        if parent is None:
            raise tk.TclError("Backend page host is not available")
        if page == "history":
            frame = self._build_backend_history_page(parent)
        elif page == "kings":
            # PVP deliberately uses the exact native PVE history surface.
            # Keep the route separate so its data can be connected later,
            # but do not maintain a second, visually divergent widget tree.
            frame = self._ensure_backend_page("history")
            self.pvp_history_page = None
        elif page == "alliance":
            frame = PvpAlliancePage(
                parent, self, ModernDropdown, ModernScrollbar,
                split_pane=ModernSplitPane,
            )
            self.pvp_alliance_page = frame
        elif page == "updates":
            frame = self._build_backend_updates_page(parent)
        elif page == "settings":
            frame = self._build_backend_settings_page(parent)
        else:
            raise tk.TclError(f"Unknown backend page: {page}")
        self.backend_pages[page] = frame
        return frame

    def _select_backend_page(self, page: str) -> None:
        self._close_hunter_history_detail()
        ModernDropdown.close_active_popup(
            getattr(self, "history_window", None)
        )
        page = str(page or "history")
        if page == "settings" and SETTINGS_TEMPORARILY_DISABLED:
            page = "history"
        if page not in {"history", "kings", "alliance", "updates", "settings"}:
            page = "history"
        selected_frame = self._ensure_backend_page(page)
        if page in {"history", "kings"}:
            self._apply_history_page_identity(page)
        previous_page = self.backend_current_page
        if previous_page == "settings" and page != "settings":
            self._cancel_toggle_hotkey_capture()
            self._cancel_hud_view_hotkey_capture()
        self.backend_current_page = page
        self._sync_history_snapshot_scrollbar_visibility()
        pvp_alliance_page = getattr(self, "pvp_alliance_page", None)
        if pvp_alliance_page is not None and page != "alliance":
            pvp_alliance_page.on_hide()
        for key, frame in self.backend_pages.items():
            if frame is selected_frame:
                frame.grid(row=0, column=0, sticky="nsew")
            else:
                frame.grid_remove()
        self._ensure_backend_window_opaque()
        self._sync_backend_navigation()
        window = getattr(self, "history_window", None)
        if window is not None and window.winfo_viewable():
            self._sync_backend_window_topmost()
        if page == "history" and self.history_window is not None:
            self._refresh_history_records()
        elif page == "kings":
            self._show_pvp_history_replica()
        elif page == "alliance":
            self.backend_pages[page].on_show()

    def _sync_history_snapshot_scrollbar_visibility(self) -> None:
        """Show the fixed-pane scrollbar only for the PvP snapshot surface."""

        scrollbar = getattr(self, "history_snapshot_trend_scrollbar", None)
        if scrollbar is None:
            return
        try:
            visible = getattr(self, "backend_current_page", "history") == "kings"
            managed = str(scrollbar.winfo_manager() or "")
            if visible and managed != "pack":
                scrollbar.pack(side="right", fill="y")
            elif not visible and managed:
                scrollbar.pack_forget()
        except tk.TclError:
            pass

    def _show_pvp_history_replica(self) -> None:
        """Show PvP records through the exact native PVE history surface."""

        self._show_history_browser()
        self._apply_history_page_identity("kings")
        self._query_history_records()

    def _apply_history_page_identity(self, page: str) -> None:
        """Keep the shared native page branded for its selected data domain."""

        pvp = str(page or "history") == "kings"
        next_domain = "pvp" if pvp else "pve"
        if getattr(self, "history_data_domain", "pve") != next_domain:
            self.history_data_domain = next_domain
            self.history_records = []
            self.history_loaded_record = None
            self.history_selected_id = ""
            self.history_selected_ids.clear()
            self.history_selected_actor = 0
            self.history_page_number = 1
            self.history_meter_mode = "dps"
            self.history_pvp_matchup_request_key = None
            self.history_pvp_snapshot_expanded = False
            self.history_pvp_snapshot_expanded_record_id = ""
            self.history_pvp_server_matchup_cache_key = None
            self.history_pvp_server_matchup_cache = {}
            self.history_pvp_matchup_loading = False
            self.history_pvp_matchup_error = ""
        title = "竞技战绩" if pvp else "冒险战绩"
        subtitle = (
            "记录每一场竞技对决与大型团战"
            if pvp
            else "记录每一次副本征途与首领交锋"
        )
        for attribute, value in (
            ("history_page_title_label", title),
            ("history_page_subtitle_label", subtitle),
        ):
            label = getattr(self, attribute, None)
            if label is not None:
                try:
                    label.configure(text=value)
                except (AttributeError, tk.TclError):
                    pass
        query = getattr(self, "history_filter_entries", {}).get("query")
        if query is not None:
            try:
                query.placeholder = (
                    "搜索玩家 / 场次编号 / 地图"
                    if pvp
                    else "搜索副本或 Boss"
                )
                if not query.value():
                    query.reset()
            except (AttributeError, tk.TclError):
                pass

        dungeon_choices = (
            ("玩法类型  全部",)
            if pvp
            else ("全部", *HISTORY_DUNGEON_BOSSES)
        )
        boss_choices = (
            ("模式  全部", "1V1", "3V3", "6V6", "12V12")
            if pvp
            else ("全部",)
        )
        result_choices = (
            ("比赛结果  全部", "胜利", "失败", "未知", "该类型无结果")
            if pvp
            else ("战斗结果  全部", "胜利", "失败", "中断")
        )
        sort_choices = (
            (
                "时间最新",
                "时间最早",
                "击杀最多",
                "助攻最多",
                "阵亡最多",
                "时长最长",
                "时长最短",
            )
            if pvp
            else (
                "时间最新",
                "时间最早",
                "DPS最高",
                "DPS最低",
                "伤害最高",
                "伤害最低",
                "时长最长",
                "时长最短",
            )
        )
        dropdown_specs = (
            ("dungeon", self.history_filter_dungeon_var, dungeon_choices),
            ("boss", self.history_filter_boss_var, boss_choices),
            ("result", self.history_filter_result_var, result_choices),
            ("sort", self.history_sort_var, sort_choices),
        )
        for key, variable, choices in dropdown_specs:
            dropdown = getattr(self, "history_filter_dropdowns", {}).get(key)
            if dropdown is not None:
                dropdown.choices = tuple(choices)
            if variable is not None and variable.get() not in choices:
                variable.set(choices[0])
        # PvP records are already scoped to the uploaded mode/map.  Keep the
        # shared PVE widget tree intact, but remove the meaningless category
        # selector from the visible PvP toolbar.
        dungeon_dropdown = getattr(self, "history_filter_dropdowns", {}).get("dungeon")
        if dungeon_dropdown is not None:
            try:
                if pvp:
                    dungeon_dropdown.pack_forget()
                elif not dungeon_dropdown.winfo_manager():
                    # Reinsert it before the mode selector.  A plain pack()
                    # would append it after the result selector each time the
                    # user switches back from PvP.
                    before = getattr(self, "history_filter_dropdowns", {}).get(
                        "boss"
                    )
                    options = {"side": "left", "padx": (8, 0)}
                    if before is not None:
                        options["before"] = before
                    dungeon_dropdown.pack(**options)
            except (AttributeError, tk.TclError):
                pass

        # Character/rating are intentionally not duplicated in the PvP list;
        # the selected match's snapshot is the authoritative team view.  Keep
        # the controls available for PVE and restore them in their original
        # order when switching back.
        field_controls = getattr(self, "history_field_controls", {})
        for key in ("character", "extraordinary_rating"):
            control = field_controls.get(key)
            if control is None:
                continue
            try:
                if pvp:
                    control.pack_forget()
                elif not control.winfo_manager():
                    before = field_controls.get(
                        "performance"
                    ) or field_controls.get("result")
                    options = {"side": "left", "padx": (0, 10), "pady": 8}
                    if before is not None:
                        options["before"] = before
                    control.pack(**options)
            except (AttributeError, tk.TclError):
                pass

        incomplete_control = getattr(
            self, "history_show_incomplete_control", None
        )
        if incomplete_control is not None:
            try:
                if pvp:
                    incomplete_control.pack_forget()
                elif not incomplete_control.winfo_manager():
                    incomplete_control.pack(
                        side="left", padx=(0, 10), pady=8
                    )
            except (AttributeError, tk.TclError):
                pass

        meter_group = getattr(self, "history_browser_meter_group", None)
        if meter_group is not None:
            try:
                if pvp:
                    meter_group.pack_forget()
                elif not meter_group.winfo_manager():
                    meter_group.pack(side="right", padx=(0, 8), pady=(1, 4))
            except (AttributeError, tk.TclError):
                pass

        overview_captions = (
            {
                "battle_count": "总场次",
                "today_count": "总击杀",
                "average_dps": "总助攻",
                "highest_damage": "总阵亡",
            }
            if pvp
            else {
                "battle_count": "战斗场次",
                "today_count": "今日新增",
                "average_dps": "平均 DPS",
                "highest_damage": "最高伤害",
                "average_duration": "平均时长",
            }
        )
        for key, caption in overview_captions.items():
            label = getattr(self, "history_overview_labels", {}).get(
                f"{key}_caption"
            )
            if label is not None:
                label.configure(text=caption)
        overview = getattr(self, "history_overview_frame", None)
        duration_card = getattr(self, "history_overview_cards", {}).get(
            "average_duration"
        )
        if duration_card is not None:
            try:
                if pvp:
                    duration_card.grid_remove()
                else:
                    duration_card.grid()
            except (AttributeError, tk.TclError):
                pass
        if overview is not None:
            for column in range(5):
                overview.grid_columnconfigure(
                    column,
                    weight=0 if pvp and column == 4 else 1,
                    uniform="history_overview" if not (pvp and column == 4) else "",
                )

        heading_label = getattr(self, "history_snapshot_heading_label", None)
        if heading_label is not None:
            heading_label.configure(text="PvP 战斗快照" if pvp else "战斗快照")
        trend_heading = getattr(self, "history_snapshot_trend_heading", None)
        trend_body = getattr(self, "history_snapshot_trend_body", None)
        if trend_heading is not None:
            try:
                if pvp:
                    trend_heading.pack_forget()
                elif not trend_heading.winfo_manager():
                    trend_heading.pack(fill="x", before=trend_body)
            except (AttributeError, tk.TclError):
                pass
        history_header = getattr(self, "history_snapshot_history_label", None)
        if history_header is not None:
            try:
                if pvp:
                    if not history_header.winfo_manager():
                        history_header.pack(
                            side="right", padx=9, fill="y"
                        )
                    history_header.configure(text="历史数据  等待服务器", fg=WARN)
                else:
                    history_header.pack_forget()
            except (AttributeError, tk.TclError):
                pass
        action_bar = getattr(self, "history_snapshot_button_bar", None)
        if action_bar is not None:
            try:
                if pvp:
                    action_bar.pack_forget()
                elif not action_bar.winfo_manager():
                    action_bar.pack(fill="x", padx=10, pady=(8, 9))
            except (AttributeError, tk.TclError):
                pass
        refresh_button = getattr(self, "history_refresh_button", None)
        for button in (
            getattr(self, "history_feedback_button", None),
            getattr(self, "history_cleanup_button", None),
        ):
            if button is None:
                continue
            try:
                if pvp:
                    button.pack_forget()
                elif not button.winfo_manager():
                    options = {
                        "side": "left",
                        "padx": (7, 0),
                        "pady": 14,
                    }
                    if refresh_button is not None:
                        options["before"] = refresh_button
                    button.pack(**options)
            except (AttributeError, tk.TclError):
                pass

    def _clear_pvp_history_replica_data(self) -> None:
        """Keep the PVP route visually native without reading PVE/PVP data."""

        self.history_records = []
        self.history_loaded_record = None
        self.history_selected_id = ""
        self.history_selected_ids.clear()
        self.history_selected_actor = 0
        self.history_total_records = 0
        self.history_page_number = 1
        self.history_page_count = 1
        self.history_effective_page_size = self.history_page_size
        self.history_pvp_matchup_request_key = None
        self.history_pvp_server_matchup_cache_key = None
        self.history_pvp_server_matchup_cache = {}
        self.history_pvp_matchup_loading = False
        self.history_pvp_matchup_error = ""
        self.history_overview_data = {}
