            participants = (
                self._history_boss_sources(record)
                if boss_mode
                else record.get(
                    (
                        "healers"
                        if healing_mode
                        else "damage_taken" if taken_mode else "participants"
                    ),
                    [],
                )
            )
            participants = participants if isinstance(participants, list) else []
            try:
                team_size = max(
                    len(participants),
                    int(record.get("team_size", len(participants))),
                )
            except (TypeError, ValueError, OverflowError):
                team_size = len(participants)
            actor_ids = [
                int(item.get("entity_id" if boss_mode else "actor_id", 0) or 0)
                for item in participants
            ]
            if self.history_selected_actor not in actor_ids:
                preferred_actor = 0 if boss_mode else next(
                    (
                        int(item.get("actor_id", 0) or 0)
                        for item in participants
                        if item.get("is_self") is True
                    ),
                    0,
                )
                if not preferred_actor and modern_history and not boss_mode:
                    preferred_actor = next(
                        (
                            int(item.get("actor_id", 0) or 0)
                            for item in record.get("participants", [])
                            if isinstance(item, dict) and item.get("is_self") is True
                        ),
                        0,
                    )
                    if preferred_actor not in actor_ids:
                        preferred_actor = 0
                self.history_selected_actor = preferred_actor or (
                    actor_ids[0] if actor_ids else 0
                )
            monster = record.get("monster")
            monster = monster if isinstance(monster, dict) else {}
            target_name = str(monster.get("name", "")).strip() or (
                "Boss战斗" if self._history_is_boss(record) else "怪物战斗"
            )
            level = int(monster.get("level", 0) or 0)
            if level:
                target_name += f"  Lv.{level}"
            summary = self._selected_history_summary() if modern_history else None
            if summary is not None:
                target_name = self._history_encounter_title(summary)
            self.history_target_label.configure(text=target_name, fg=TEXT)
            dungeon_name = (
                str(summary.get("dungeon_name", "")).strip()
                if isinstance(summary, dict)
                else ""
            )
            detail_dungeon_label = getattr(
                self, "history_detail_dungeon_label", None
            )
            if detail_dungeon_label is not None:
                difficulty = (
                    str(summary.get("difficulty", "")).strip()
                    if isinstance(summary, dict)
                    else ""
                )
                dungeon_text = dungeon_name or "未知副本"
                if difficulty:
                    dungeon_text = f"{dungeon_text}  ·  {difficulty}"
                detail_dungeon_label.configure(
                    text=dungeon_text, fg=WARN
                )
            shown_duration = record.get(
                "hps_duration_seconds" if healing_mode else "duration_seconds"
            )
            self.history_time_label.configure(
                text=(
                    f"发生于 {self._history_timestamp(record)}   ·   "
                    f"战斗用时 {self._history_optional_duration(shown_duration)}"
                )
            )
            detail_icon_label = getattr(self, "history_detail_icon_label", None)
            if detail_icon_label is not None:
                if pvp_record:
                    local = next(
                        (
                            row
                            for row in record.get("participants", [])
                            if isinstance(row, dict) and row.get("is_self") is True
                        ),
                        {},
                    )
                    portrait = self._history_profession_icon(
                        int(local.get("profession_id", 0) or 0), size=90
                    )
                else:
                    boss_name = (
                        str(summary.get("boss_name", "")).strip()
                        if isinstance(summary, dict)
                        else str(monster.get("name", "")).strip()
                    ) or target_name
                    portrait = self.icons.boss(
                        summary.get("boss_icon", "") if isinstance(summary, dict) else "",
                        boss_name,
                        size=90,
                    )
                detail_icon_label.configure(image=portrait, text="")
                detail_icon_label.image = portrait
            _result_text, result_color = self._history_result_presentation(
                summary.get("result") if isinstance(summary, dict) else ""
            )
            completeness = (
                str(summary.get("completeness", ""))
                if isinstance(summary, dict)
                else ""
            )
            if boss_mode:
                completeness_text, boss_coverage_color = (
                    self._history_boss_coverage_text(boss_damage)
                )
            else:
                completeness_text = {
                    COMPLETENESS_COMPLETE: "数据完整",
                    COMPLETENESS_LIMITED: "基础数据",
                }.get(completeness, "部分数据")
                boss_coverage_color = WARN
                settlement = self._history_settlement_presentation(
                    summary if isinstance(summary, dict) else record
                )
                if settlement is not None:
                    completeness_text, boss_coverage_color = settlement
            detail_status_label = getattr(
                self, "history_detail_status_label", None
            )
            if detail_status_label is not None:
                detail_status_label.configure(
                    text=completeness_text,
                    fg=(
                        boss_coverage_color
                        if boss_mode
                        or self._history_settlement_presentation(
                            summary if isinstance(summary, dict) else record
                        ) is not None
                        else ACCENT
                        if completeness == COMPLETENESS_COMPLETE
                        else WARN
                    ),
                )
            detail_accent = getattr(self, "history_detail_accent_frame", None)
            if detail_accent is not None:
                detail_accent.configure(bg=result_color)
            if self.history_total_value is not None:
                self.history_total_value.configure(
                    text=(
                        self._history_optional_number(
                            record.get("pvp_ally_damage")
                        )
                        if pvp_record and not healing_mode and not taken_mode
                        else self._history_optional_number(
                            record.get("pvp_ally_healing")
                        )
                        if pvp_record and healing_mode
                        else self._history_optional_number(
                            record.get("pvp_ally_taken")
                        )
                        if pvp_record and taken_mode
                        else
                        self._history_optional_number(
                            record.get("team_effective_healing")
                        )
                        if healing_mode
                        else format_number(
                            boss_damage.get("observed_damage", 0) or 0
                        )
                        if boss_mode and boss_data_available
                        else "--"
                        if boss_mode
                        else self._history_optional_number(record.get("team_taken"))
                        if taken_mode
                        else self._history_optional_number(record.get("total_damage"))
                    )
                )
                self.history_total_value._caption_label.configure(
                    text=(
                        "己方总治疗"
                        if pvp_record and healing_mode
                        else "己方总承伤"
                        if pvp_record and taken_mode
                        else "己方总伤害"
                        if pvp_record
                        else
                        "总有效治疗"
                        if healing_mode
                        else "已归类首领伤害"
                        if boss_mode
                        else "团队总承伤" if taken_mode else "总伤害"
                    )
                )
            if self.history_dps_value is not None:
                if pvp_record:
                    opponent_key = (
                        "pvp_enemy_healing"
                        if healing_mode
                        else "pvp_enemy_taken"
                        if taken_mode
                        else "pvp_enemy_damage"
                    )
                    self.history_dps_value.configure(
                        text=self._history_optional_number(record.get(opponent_key))
                    )
                elif boss_mode:
                    ratio = boss_damage.get("classification_ratio")
                    self.history_dps_value.configure(
                        text=(
                            self._history_rate_text(ratio)
                            if boss_data_available
                            else "--"
                        )
                    )
                elif taken_mode:
                    taken_shares = [
                        ratio
                        for item in participants
                        if isinstance(item, dict)
                        for ratio in (
                            self._history_optional_ratio(item.get("share")),
                        )
                        if ratio is not None
                    ]
                    self.history_dps_value.configure(
                        text=(
                            f"{max(taken_shares) * 100:.1f}%"
                            if taken_shares
                            else "--"
                        )
                    )
                else:
                    self.history_dps_value.configure(
                        text=self._history_optional_number(
                            record.get("team_hps" if healing_mode else "team_dps")
                        )
                    )
                self.history_dps_value._caption_label.configure(
                    text=(
                        "敌方总治疗"
                        if pvp_record and healing_mode
                        else "敌方总承伤"
                        if pvp_record and taken_mode
                        else "敌方总伤害"
                        if pvp_record
                        else
                        "团队 HPS"
                        if healing_mode
                        else "归类比例"
                        if boss_mode
                        else "最高承伤占比" if taken_mode else "总 DPS"
                    )
                )
            if self.history_team_value is not None:
                if boss_mode:
                    self.history_team_value.configure(
                        text=(
                            self._history_optional_number(
                                boss_damage.get("team_taken")
                            )
                            if boss_data_available
                            else "--"
                        ),
                        fg=TEXT,
                    )
                    self.history_team_value._caption_label.configure(
                        text="团队总承伤"
                    )
                elif modern_history and self.history_page_mode == "detail":
                    result_text, result_color = self._history_result_presentation(
                        summary.get("result") if isinstance(summary, dict) else ""
                    )
                    self.history_team_value.configure(
                        text=result_text, fg=result_color
                    )
                    self.history_team_value._caption_label.configure(
                        text="战斗结果"
                    )
                else:
                    self.history_team_value.configure(text=f"{team_size} 人")
            if self.history_favorite_button is not None:
                favorite = bool(record.get("favorite"))
                self.history_favorite_button.configure(
                    text="★ 已收藏" if favorite else "☆ 收藏",
                    fg=ACCENT if favorite else MUTED,
                )
            selected_participant = next(
                (
                    item
                    for item in participants
                    if int(
                        item.get("entity_id" if boss_mode else "actor_id", 0)
                        or 0
                    )
                    == self.history_selected_actor
                ),
                None,
            )
            if modern_history and getattr(self, "history_duration_value", None) is not None:
                self.history_duration_value.configure(
                    text=self._history_optional_duration(shown_duration)
                )
            if self.history_detail_label is not None:
                if boss_mode:
                    coverage_text, _coverage_color = (
                        self._history_boss_coverage_text(boss_damage)
                    )
                    self.history_detail_label.configure(text=coverage_text)
                elif healing_mode:
                    if not isinstance(selected_participant, dict):
                        self.history_detail_label.configure(text="暂无治疗详情")
                        selected_participant = None
                    else:
                        response = selected_participant.get("response", {})
                        response = response if isinstance(response, dict) else {}
                        self.history_detail_label.configure(
                            text=(
                                "响应 快"
                                f"{format_response_time(response.get('fastest_ms'))} / "
                                f"慢{format_response_time(response.get('slowest_ms'))}"
                            )
                        )
                elif taken_mode:
                    self.history_detail_label.configure(
                        text="承伤当前仅提供玩家汇总，暂无可靠的技能归属"
                    )
                else:
                    critical_rate = (
                        selected_participant.get("critical_rate")
                        if isinstance(selected_participant, dict)
                        else None
                    )
                    try:
                        critical_text = (
                            f"{float(critical_rate) * 100:.1f}%"
                            if critical_rate is not None
                            else "--"
                        )
                    except (TypeError, ValueError, OverflowError):
                        critical_text = "--"
                    penetration_rate = (
                        selected_participant.get("penetration_rate")
                        if isinstance(selected_participant, dict)
                        else None
                    )
                    try:
                        penetration_text = (
                            f"{float(penetration_rate) * 100:.1f}%"
                            if penetration_rate is not None
                            else "--"
                        )
                    except (TypeError, ValueError, OverflowError):
                        penetration_text = "--"
                    try:
                        deaths = max(
                            0,
                            int(selected_participant.get("deaths", 0) or 0),
                        )
                    except (AttributeError, TypeError, ValueError, OverflowError):
                        deaths = 0
                    try:
                        revives = max(
                            0,
                            int(selected_participant.get("revives", 0) or 0),
                        )
                        death_duration = max(
                            0.0,
                            float(
                                selected_participant.get(
                                    "death_duration_seconds", 0.0
                                )
                                or 0.0
                            ),
                        )
                    except (AttributeError, TypeError, ValueError, OverflowError):
                        revives = 0
                        death_duration = 0.0
                    detail_status = str(
                        selected_participant.get("skill_detail_status", "")
                        if isinstance(selected_participant, dict)
                        else ""
                    )
                    try:
                        server_damage_difference = max(
                            0,
                            int(
                                selected_participant.get(
                                    "server_damage_difference", 0
                                )
                                or 0
                            ),
                        )
                    except (AttributeError, TypeError, ValueError, OverflowError):
                        server_damage_difference = 0
                    detail_suffix = (
                        "  ·  服务器未返回技能明细"
                        if detail_status == "pending_server_detail"
                        else (
                            "  ·  结算未归类 "
                            f"{format_number(server_damage_difference)}"
                            if server_damage_difference > 0
                            else ""
                        )
                    )
                    self.history_detail_label.configure(
                        text=(
                            f"暴击率 {critical_text}  ·  穿刺率 {penetration_text}  ·  "
                            f"死亡次数 {self._history_optional_number(selected_participant.get('deaths') if isinstance(selected_participant, dict) else None)}  ·  "
                            f"复活 {revives}  ·  死亡时间 {format_duration(death_duration)}"
                            f"{detail_suffix}"
                        )
                    )
        self._sync_history_equipment_panel(record)
        local_modules_visible = self._sync_history_local_detail_modules()
        self._sync_history_detail_metric_copy(
            healing_mode=healing_mode,
            taken_mode=taken_mode,
            boss_mode=boss_mode,
        )
        if modern_history:
            self._update_history_team_average_rating(record)
        if boss_mode:
            self._render_history_boss_source_summary(
                record if isinstance(record, dict) else None,
                participants,
                selected_participant,
            )
        else:
            self._render_history_player_summary(
                record if isinstance(record, dict) else None,
                participants,
                selected_participant,
                healing_mode=healing_mode,
                taken_mode=taken_mode,
            )
        self._set_history_detail_mode(self.history_detail_mode)
        self._draw_history_list()
        self._draw_history_participant_header()
        self._draw_history_participants()
        self._draw_history_skills()
        self._draw_history_detail_result()
        self._draw_history_detail_trend()
        self._draw_history_detail_hero()
        self._draw_history_skill_share()
        self._draw_history_equipment_snapshot()
        if local_modules_visible:
            self._draw_history_skill_quality()
            self._draw_history_critical_luck()
            self._draw_history_skill_timeline()

    def _history_participant_columns(self, width: int) -> dict[str, int]:
        meter_mode = getattr(self, "history_meter_mode", "dps")
        if meter_mode == "hps":
            enabled = list(self._enabled_healing_metrics())
        elif meter_mode == "dt":
            enabled = list(self._enabled_taken_metrics())
        else:
            enabled = list(self._enabled_damage_metrics())
        right_edge = max(100, width - 16)
        if len(enabled) <= 1:
            name_ratio = 0.45
        elif len(enabled) == 2:
            name_ratio = 0.38
        elif len(enabled) == 3:
            name_ratio = 0.33
        else:
            name_ratio = 0.27
        reserved = max(36, 42 * len(enabled))
        name_limit = min(
            220,
            right_edge - reserved,
            max(120, int(width * name_ratio)),
        )
        name_limit = max(90, name_limit)
        columns = {
            "rank": 28,
            "profession_icon": 48,
            "name": 76,
            "name_limit": name_limit,
        }
        if not enabled:
            return columns
        columns.update(self._weighted_metric_columns(enabled, name_limit, right_edge))
        return columns

    def _draw_history_participant_header(self) -> None:
        canvas = self.history_participant_header_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        pvp_record = (
            getattr(self, "backend_current_page", "history") == "kings"
            or getattr(self, "history_data_domain", "pve") == "pvp"
        )
        if pvp_record:
            if width < 720:
                metric_start = max(148, int(width * 0.40))
                metric_width = max(56, (width - metric_start - 8) / 3)
                columns = {
                    "damage": metric_start + metric_width,
                    "healing": metric_start + metric_width * 2,
                    "taken": width - 10,
                }
                for caption, x, anchor in (
                    ("玩家 / 评分 / 击·助·阵", 10, "w"),
                    ("伤害", columns["damage"], "e"),
                    ("治疗", columns["healing"], "e"),
                    ("承伤", columns["taken"], "e"),
                ):
                    canvas.create_text(
                        x,
                        15,
                        text=caption,
                        fill=MUTED,
                        anchor=anchor,
                        font=self._ui_font("table_header"),
                    )
                return
            side_width = max(92, min(122, int(width * 0.18)))
            rating_width = max(72, min(96, int(width * 0.15)))
            metric_width = max(52, int((width - side_width - rating_width - 8) / 6))
            right = width - 10
            columns = {
                "name": 35,
                "rating": side_width + rating_width,
                "damage": side_width + rating_width + metric_width,
                "healing": side_width + rating_width + metric_width * 2,
                "taken": side_width + rating_width + metric_width * 3,
                "kills": side_width + rating_width + metric_width * 4,
                "assists": side_width + rating_width + metric_width * 5,
                "deaths": right,
            }
            for caption, x, anchor in (
                ("阵营 / 玩家", 10, "w"),
                ("超凡评分", columns["rating"], "e"),
                ("伤害", columns["damage"], "e"),
                ("治疗", columns["healing"], "e"),
                ("承伤", columns["taken"], "e"),
                ("击杀", columns["kills"], "e"),
                ("助攻", columns["assists"], "e"),
                ("阵亡", columns["deaths"], "e"),
            ):
                canvas.create_text(x, 15, text=caption, fill=MUTED, anchor=anchor, font=self._ui_font("table_header"))
            return
        if getattr(self, "history_meter_mode", "dps") == "boss_damage":
            for text, x, anchor in (
                ("首领 / 机制", 12, "w"),
                ("已归类伤害", int(width * 0.67), "e"),
                ("占比", width - 14, "e"),
            ):
                canvas.create_text(
                    x,
                    15,
                    text=text,
                    fill=MUTED,
                    anchor=anchor,
                    font=self._ui_font("table_header"),
                )
            return
        columns = self._history_participant_columns(width)
        for text, x, anchor in (
            ("排名", 12, "w"),
            ("玩家名称", columns["name"], "w"),
        ):
            canvas.create_text(
                x,
                15,
                text=text,
                fill=MUTED,
                anchor=anchor,
                font=self._ui_font("table_header"),
            )
        captions = {
            "damage": "总伤害",
            "dps": "秒伤",
            "share": "占比",
            "critical": "暴击率",
            "penetration": "穿刺率",
            "deaths": "死亡次数",
            "revives": "复活",
            "death_time": "死亡时间",
            "effective": "有效治疗",
            "hps": "HPS",
            "overheal": "过量率",
            "taken": "总承伤",
            "taken_share": "承伤占比",
        }
        meter_mode = getattr(self, "history_meter_mode", "dps")
        if meter_mode == "hps":
            metric_keys = ("effective", "hps", "overheal")
        elif meter_mode == "dt":
            metric_keys = ("taken", "taken_share")
        else:
            metric_keys = (
                "damage",
                "dps",
                "share",
                "critical",
                "penetration",
                "deaths",
                "revives",
                "death_time",
            )
        for key in metric_keys:
            if key not in columns:
                continue
            canvas.create_text(
                columns[key],
                15,
                text=captions[key],
                fill=MUTED,
                anchor="e",
                font=self._ui_font("table_header"),
            )

    def _draw_history_boss_sources(self) -> None:
        canvas = self.history_participant_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        boss_damage = self._history_boss_damage(record)
        sources = self._history_boss_sources(record)
        subtitle = getattr(self, "history_team_subtitle_label", None)
        if subtitle is not None:
            subtitle.configure(
                text=f"{len(sources)} 个已确认来源" if sources else "无已确认来源"
            )
        if not sources:
            message, color = self._history_boss_coverage_text(boss_damage)
            canvas.create_text(
                width // 2,
                height // 2 - 10,
                text=message,
                fill=color,
                font=self._ui_font("strong"),
            )
            if message == "该场未记录首领伤害":
                canvas.create_text(
                    width // 2,
                    height // 2 + 16,
                    text="旧记录不会反推或补造首领技能数据",
                    fill=SUBTLE,
                    font=self._ui_font("micro"),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        strong_linespace = self._ui_font("strong").metrics("linespace")
        number_linespace = self._ui_font("number_strong").metrics("linespace")
        micro_linespace = self._ui_font("micro").metrics("linespace")
        row_height = max(58, max(strong_linespace, number_linespace) + micro_linespace + 16)
        icons: list[object] = []
        for index, source in enumerate(sources):
            top = index * row_height
            bottom = top + row_height
            primary_y = top + 6 + max(strong_linespace, number_linespace) / 2
            secondary_y = bottom - 6 - micro_linespace / 2
            entity_id = int(source.get("entity_id", 0) or 0)
            selected = entity_id == int(self.history_selected_actor or 0)
            base = (
                blend_color(PANEL, "#e67d72", 0.11)
                if selected
                else PANEL if index % 2 == 0 else "#11161b"
            )
            tag = f"history-boss-source:{index}"
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline="", tags=(tag,)
            )
            canvas.create_rectangle(
                0,
                top,
                3,
                bottom - 1,
                fill="#e67d72" if selected else BORDER,
                outline="",
                tags=(tag,),
            )
            name = str(source.get("name", "")).strip() or "首领"
            portrait = self.icons.boss(
                self._history_boss_icon_name(source), name, size=34
            )
            icons.append(portrait)
            canvas.create_image(
                10,
                top + (row_height - 34) // 2,
                image=portrait,
                anchor="nw",
                tags=(tag,),
            )
            canvas.create_text(
                52,
                primary_y,
                text=self._fit_ui_text(name, max(70, width - 205), "strong"),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
                tags=(tag,),
            )
            kind = (
                "机制"
                if str(source.get("kind", "boss")).casefold() == "mechanism"
                else "首领"
            )
            canvas.create_text(
                52,
                secondary_y,
                text=f"{kind} · 命中 {max(0, int(source.get('hits', 0) or 0))}",
                fill=WARN if kind == "机制" else MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            canvas.create_text(
                width - 12,
                primary_y,
                text=format_number(max(0, int(source.get("damage", 0) or 0))),
                fill="#e67d72",
                anchor="e",
                font=self._ui_font("number_strong"),
                tags=(tag,),
            )
            canvas.create_text(
                width - 12,
                secondary_y,
                text=f"占比 {max(0.0, min(1.0, float(source.get('share', 0.0) or 0.0))) * 100:.1f}%",
                fill=MUTED,
                anchor="e",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            canvas.tag_bind(
                tag,
                "<Button-1>",
                lambda _event, selected_id=entity_id: self._select_history_actor(
                    selected_id
                ),
            )
            canvas.tag_bind(
                tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2")
            )
            canvas.tag_bind(
                tag, "<Leave>", lambda _event: canvas.configure(cursor="")
            )
        canvas._history_boss_source_icons = icons
        canvas.configure(
            scrollregion=(0, 0, width, max(height, len(sources) * row_height))
        )

    def _draw_history_participants(self) -> None:
        canvas = self.history_participant_canvas
        if canvas is None:
            return
        if getattr(self, "history_meter_mode", "dps") == "boss_damage":
            self._draw_history_boss_sources()
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        if (
            isinstance(record, dict)
            and str(record.get("combat_mode", "")).casefold() == "pvp"
        ):
            self._draw_pvp_history_participants(canvas, record, width, height)
            return
        healing_mode = getattr(self, "history_meter_mode", "dps") == "hps"
        taken_mode = getattr(self, "history_meter_mode", "dps") == "dt"
        participants = (
            record.get(
                (
                    "healers"
                    if healing_mode
                    else "damage_taken" if taken_mode else "participants"
                ),
                [],
            )
            if record
            else []
        )
        participants = participants if isinstance(participants, list) else []
        def participant_sort_value(participant: object) -> tuple[bool, float]:
            if not isinstance(participant, dict):
                return (False, 0.0)
            if healing_mode:
                candidates = ("hps", "effective_healing")
            elif taken_mode:
                candidates = ("taken",)
            else:
                candidates = ("dps", "damage")
            for key in candidates:
                value = participant.get(key)
                if value is None:
                    continue
                try:
                    return (True, max(0.0, float(value)))
                except (TypeError, ValueError, OverflowError):
                    continue
            return (False, 0.0)

        # Sort a display-only copy. Actor IDs and the immutable encounter
        # payload stay untouched, so selecting a row still resolves the same
        # skills and equipment snapshot after switching DPS/HPS/DT tabs.
        participants = sorted(
            participants,
            key=participant_sort_value,
            reverse=True,
        )
        compact_detail_roster = (
            getattr(self, "history_page_mode", "browser") == "detail"
            and getattr(self, "history_participant_header_canvas", None) is None
        )
        subtitle = getattr(self, "history_team_subtitle_label", None)
        if compact_detail_roster and subtitle is not None:
            subtitle.configure(text=f"{len(participants)} 名队员")
        if not participants:
            canvas.create_text(
                width // 2,
                height // 2,
                text=(
                    "暂无团队治疗"
                    if healing_mode
                    else "暂无团队承伤" if taken_mode else "暂无团队伤害"
                ),
                fill=MUTED,
                font=tk_font_spec("Microsoft YaHei UI", 9, "bold"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        highest_damage = max(
            (
                max(
                    0,
                    int(
                        participant.get(
                            (
                                "effective_healing"
                                if healing_mode
                                else "taken" if taken_mode else "damage"
                            ),
                            0,
                        )
                        or 0
                    ),
                )
                for participant in participants
                if isinstance(participant, dict)
            ),
            default=0,
        )
        columns = self._history_participant_columns(width)
        duration = self._history_display_duration(record, healing_mode)
        dps_duration = dps_duration_seconds(
            record.get(
                "hps_duration_seconds" if healing_mode else "dps_duration_seconds",
                duration,
            )
            or duration
        )
        detail_layout = getattr(self, "history_page_mode", "browser") == "detail"
        narrow_detail_roster = compact_detail_roster and width < 500
        strong_linespace = micro_linespace = number_linespace = 0
        if compact_detail_roster:
            strong_linespace = self._ui_font("strong").metrics("linespace")
            micro_linespace = self._ui_font("micro").metrics("linespace")
            number_linespace = self._ui_font("number_strong").metrics("linespace")
        row_height = (
            max(96, strong_linespace + number_linespace + micro_linespace * 2 + 20)
            if narrow_detail_roster
            else max(43, strong_linespace + micro_linespace + 12)
            if compact_detail_roster
            else 40 if detail_layout else 34
        )
        for index, participant in enumerate(participants):
            top = index * row_height
            bottom = top + row_height
            center_y = top + row_height // 2
            actor_id = int(participant.get("actor_id", 0) or 0)
            selected = actor_id == self.history_selected_actor
            class_id = int(participant.get("profession_id", 0) or 0)
            _profession, color = self._profession_info(class_id)
            base = PANEL_2 if selected else (PANEL if index % 2 == 0 else SURFACE)
            if healing_mode:
                raw_effective = participant.get("effective_healing")
                try:
                    effective = (
                        max(0, int(raw_effective))
                        if raw_effective is not None
                        else None
                    )
                except (TypeError, ValueError, OverflowError):
                    effective = None
                raw_team_effective = record.get("team_effective_healing")
                try:
                    team_effective = (
                        max(0, int(raw_team_effective))
                        if raw_team_effective is not None
                        else None
                    )
                except (TypeError, ValueError, OverflowError):
                    team_effective = None
                share = (
                    effective / team_effective
                    if (
                        effective is not None
                        and team_effective is not None
                        and team_effective > 0
                    )
                    else None
                )
                primary_value = effective
            elif taken_mode:
                share = self._history_optional_ratio(participant.get("share"))
                try:
                    raw_taken = participant.get("taken")
                    primary_value = (
                        max(0, int(raw_taken)) if raw_taken is not None else None
                    )
                except (TypeError, ValueError, OverflowError):
                    primary_value = None
            else:
                share = self._history_optional_ratio(participant.get("share"))
                try:
                    raw_damage = participant.get("damage")
                    primary_value = (
                        max(0, int(raw_damage)) if raw_damage is not None else None
                    )
                except (TypeError, ValueError, OverflowError):
                    primary_value = None
            bar_ratio = relative_damage_bar_ratio(
                primary_value or 0, highest_damage
            )
            tag = f"history-actor:{index}"
            if compact_detail_roster:
                base = (
                    blend_color(PANEL, ACCENT, 0.10)
                    if selected
                    else PANEL if index % 2 == 0 else "#11161b"
                )
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline="", tags=(tag,)
            )
            if not compact_detail_roster:
                canvas.create_rectangle(
                    0,
                    top,
                    max(3, int(width * bar_ratio)),
                    bottom - 1,
                    fill=blend_color(base, color, 0.22),
                    outline="",
                    tags=(tag,),
                )
            if compact_detail_roster:
                canvas.create_rectangle(
                    0,
                    top,
                    3,
                    bottom - 1,
                    fill=ACCENT if selected else blend_color(base, color, 0.65),
                    outline="",
                    tags=(tag,),
                )
                if bar_ratio > 0:
                    canvas.create_rectangle(
                        3,
                        bottom - 3,
                        max(5, int(width * bar_ratio)),
                        bottom - 1,
                        fill=blend_color(base, color, 0.78),
                        outline="",
                        tags=(tag,),
                    )
                canvas.create_text(
                    21,
                    top + 6 + strong_linespace / 2 if narrow_detail_roster else center_y,
                    text=str(index + 1),
                    fill=(
                        ACCENT
                        if selected
                        else WARN if index < 3 else MUTED
                    ),
                    font=self._ui_font("number_strong"),
                    tags=(tag,),
                )
                icon = self._history_profession_icon(class_id, 21)
                canvas.create_image(
                    38,
                    top + 6 + (strong_linespace - 21) // 2
                    if narrow_detail_roster else top + (row_height - 21) // 2,
                    image=icon,
                    anchor="nw",
                    tags=(tag,),
                )
                name = self._history_actor_name(
                    participant, index, self._history_names_hidden()
                )
                is_ai = history_participant_is_ai(participant)
                rating = (
                    None
                    if is_ai
                    else normalize_extraordinary_rating(
                        participant.get("extraordinary_rating")
                    )
                )
                if is_ai:
                    rating_text = "非凡评分 人机"
                elif rating is not None:
                    rating_text = f"非凡评分 {format_number(rating)}"
                else:
                    rating_text = "非凡评分 --"
                amount = primary_value
                if healing_mode:
                    rate = participant.get("hps")
                    rate_label = "HPS"
                    amount_label = "治疗"
                elif taken_mode:
                    rate = primary_value
                    rate_label = "承伤"
                    amount_label = "承伤"
                else:
                    raw_rate = participant.get("dps")
                    rate = (
                        float(raw_rate)
                        if raw_rate is not None
                        else primary_value / dps_duration
                        if primary_value is not None and dps_duration
                        else None
                    )
                    rate_label = "DPS"
                    amount_label = "伤害"
                rate_text = f"{self._history_optional_number(rate)}  {rate_label}"
                share_text = f"占比 {share * 100:.1f}%" if share is not None else "占比 --"
                death_text = (
                    f"死亡 {self._history_optional_number(participant.get('deaths'))}"
                )
                if not narrow_detail_roster:
                    rating_text += f" · {death_text}"
                rating_color = "#8bc7d4" if is_ai else ACCENT if rating is not None else SUBTLE
                if narrow_detail_roster:
                    name_y = top + 6 + strong_linespace / 2
                    rate_y = top + 9 + strong_linespace + number_linespace / 2
                    death_y = bottom - 5 - micro_linespace / 2
                    meta_y = death_y - micro_linespace - 4
                    short_rating = (
                        "人机" if is_ai else f"评分 {format_number(rating)}"
                        if rating is not None else "评分 --"
                    )
                    name_width = max(
                        56,
                        width - 65 - self._ui_font("micro").measure(short_rating) - 24,
                    )
                    canvas.create_text(
                        65, name_y,
                        text=self._fit_ui_text(name, name_width, "strong"),
                        fill=TEXT, anchor="w", font=self._ui_font("strong"), tags=(tag,),
                    )
                    canvas.create_text(
                        width - 13, name_y, text=short_rating,
                        fill=rating_color, anchor="e", font=self._ui_font("micro"), tags=(tag,),
                    )
                    amount_text = (
                        f"{amount_label} {self._history_report_compact_number(amount)}"
                        if amount is not None else f"{amount_label} --"
                    )
                    canvas.create_text(
                        65, rate_y, text=rate_text,
                        fill=TEXT, anchor="w", font=self._ui_font("number_strong"), tags=(tag,),
                    )
                    canvas.create_text(
                        65, meta_y, text=amount_text,
                        fill=MUTED, anchor="w", font=self._ui_font("micro"), tags=(tag,),
                    )
                    canvas.create_text(
                        width - 13, meta_y, text=share_text,
                        fill=MUTED, anchor="e", font=self._ui_font("micro"), tags=(tag,),
                    )
                    canvas.create_text(
                        width - 13, death_y, text=death_text,
                        fill="#e47c80", anchor="e", font=self._ui_font("micro"), tags=(tag,),
                    )
                else:
                    detail_text = (
                        share_text if taken_mode
                        else f"{amount_label} {self._history_optional_number(amount)}  ·  {share_text}"
                    )
                    name_width = max(
                        56,
                        width - 65 - max(
                            self._ui_font("number_strong").measure(rate_text),
                            self._ui_font("micro").measure(detail_text),
                        ) - 24,
                    )
                    primary_y = top + 6 + strong_linespace / 2
                    secondary_y = bottom - 6 - micro_linespace / 2
                    canvas.create_text(
                        65, primary_y,
                        text=self._fit_ui_text(name, name_width, "strong"),
                        fill=TEXT, anchor="w", font=self._ui_font("strong"), tags=(tag,),
                    )
                    canvas.create_text(
                        width - 13, primary_y, text=rate_text,
                        fill=TEXT, anchor="e", font=self._ui_font("number_strong"), tags=(tag,),
                    )
                    canvas.create_text(
                        65, secondary_y, text=rating_text,
                        fill=rating_color, anchor="w", font=self._ui_font("micro"), tags=(tag,),
                    )
                    canvas.create_text(
                        width - 13, secondary_y, text=detail_text,
                        fill=MUTED, anchor="e", font=self._ui_font("micro"), tags=(tag,),
                    )
                canvas.create_line(0, bottom - 1, width, bottom - 1, fill="#20262d")
                canvas.tag_bind(
                    tag,
                    "<Button-1>",
                    lambda _event, selected_actor=actor_id: self._select_history_actor(
                        selected_actor
                    ),
                )
                canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
                canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor=""))
                continue
            canvas.create_text(
                columns["rank"],
                center_y,
                text=str(index + 1),
                fill=ACCENT if index < 3 else MUTED,
                anchor="e",
                font=self._ui_font("table"),
                tags=(tag,),
            )
            icon = self._history_profession_icon(class_id, 20)
            canvas.create_image(
                columns["profession_icon"],
                top + (row_height - 20) // 2,
                image=icon,
                anchor="nw",
                tags=(tag,),
            )
            canvas.create_text(
                columns["name"],
                center_y,
                text=self._fit_main_actor_name(
                    self._history_actor_name(
                        participant, index, self._history_names_hidden()
                    ),
                    max(40, columns["name_limit"] - columns["name"] - 8),
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("table"),
                tags=(tag,),
            )
            if healing_mode:
                overheal_rate = participant.get("overheal_rate")
                values = {
                    "effective": self._history_optional_number(primary_value),
                    "hps": self._history_optional_number(participant.get("hps")),
                    "overheal": format_overheal_rate(
                        overheal_rate,
                        partial=bool(
                            participant.get("overheal_rate_partial")
                        ),
                    ),
                }
                keys = ("effective", "hps", "overheal")
            elif taken_mode:
                values = {
                    "taken": self._history_optional_number(primary_value),
                    "taken_share": f"{share * 100:.1f}%" if share is not None else "--",
                }
                keys = ("taken", "taken_share")
            else:
                try:
                    raw_damage = participant.get("damage")
                    damage = (
                        max(0.0, float(raw_damage))
                        if raw_damage is not None
                        else None
                    )
                except (TypeError, ValueError, OverflowError):
                    damage = None
                try:
                    raw_dps = participant.get("dps")
                    dps = (
                        max(0.0, float(raw_dps))
                        if raw_dps is not None
                        else (
                            damage / dps_duration
                            if damage is not None and dps_duration
                            else None
                        )
                    )
                except (TypeError, ValueError, OverflowError):
                    dps = (
                        damage / dps_duration
                        if damage is not None and dps_duration
                        else None
                    )
                critical_rate = participant.get("critical_rate")
                try:
                    critical_text = (
                        f"{float(critical_rate) * 100:.1f}%"
                        if critical_rate is not None
                        else "--"
                    )
                except (TypeError, ValueError, OverflowError):
                    critical_text = "--"
                penetration_rate = participant.get("penetration_rate")
                try:
                    penetration_text = (
                        f"{float(penetration_rate) * 100:.1f}%"
                        if penetration_rate is not None
                        else "--"
                    )
                except (TypeError, ValueError, OverflowError):
                    penetration_text = "--"
                values = {
                    "damage": self._history_optional_number(damage),
                    "dps": self._history_optional_number(dps),
                    "share": f"{share * 100:.1f}%" if share is not None else "--",
                    "critical": critical_text,
                    "penetration": penetration_text,
                    "deaths": str(
                        max(0, int(participant.get("deaths", 0) or 0))
                    ),
                    "revives": str(
                        max(0, int(participant.get("revives", 0) or 0))
                    ),
                    "death_time": format_duration(
                        max(
                            0.0,
                            float(
                                participant.get("death_duration_seconds", 0.0)
                                or 0.0
                            ),
                        )
                    ),
                }
                keys = (
                    "damage",
                    "dps",
                    "share",
                    "critical",
                    "penetration",
                    "deaths",
                    "revives",
                    "death_time",
                )
            for key in keys:
                if key not in columns:
                    continue
                canvas.create_text(
                    columns[key],
                    center_y,
                    text=values[key],
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("table"),
                    tags=(tag,),
                )
            canvas.tag_bind(
                tag,
                "<Button-1>",
                lambda _event, selected_actor=actor_id: self._select_history_actor(
                    selected_actor
                ),
            )
            canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
            canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor=""))
        canvas.configure(
            scrollregion=(0, 0, width, max(height, len(participants) * row_height))
        )

    def _draw_pvp_history_participants(
        self, canvas: tk.Canvas, record: dict, width: int, height: int
    ) -> None:
        """Render the shared native roster with PvP-specific columns.

        This intentionally stays on the PVE detail canvas: only the row data
        and captions change.  Unknown server fields remain ``--`` instead of
        being inferred from the local tracker.
        """
        participants = record.get("participants", [])
        participants = [row for row in participants if isinstance(row, dict)]
        if not participants:
            canvas.create_text(
                width // 2,
                height // 2,
                text="暂无本场 PvP 阵容",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            subtitle = getattr(self, "history_team_subtitle_label", None)
            if subtitle is not None:
                subtitle.configure(text="0 名玩家")
            return

        def metric(value: object) -> str:
            return self._history_optional_number(value)

        def sort_key(row: dict) -> tuple:
            side_order = 0 if row.get("side") == "ally" else 1
            value = row.get("damage")
            try:
                damage = float(value) if value is not None else -1.0
            except (TypeError, ValueError, OverflowError):
                damage = -1.0
            return side_order, damage < 0, -damage

        # Keep the local player at the top of the friendly side, then sort the
        # remaining rows by confirmed damage without changing the two sides.
        ordered = sorted(participants, key=sort_key)
        ordered.sort(key=lambda row: (0 if row.get("is_self") else 1,))
        # The second stable sort above can move the local player before an
        # enemy.  Rebuild the side blocks explicitly for predictable 3/6/12vN
        # presentation.
        allies = [row for row in ordered if row.get("side") == "ally"]
        enemies = [row for row in ordered if row.get("side") != "ally"]
        allies.sort(key=lambda row: (0 if row.get("is_self") else 1, sort_key(row)))
        enemies.sort(key=sort_key)
        ordered = allies + enemies

        compact = width < 720
        if compact:
            metric_start = max(148, int(width * 0.40))
            metric_width = max(56, (width - metric_start - 8) / 3)
            columns = {
                "side": 10,
                "name": 35,
                "damage": metric_start + metric_width,
                "healing": metric_start + metric_width * 2,
                "taken": width - 10,
            }
            row_height = 64
        else:
            side_width = max(92, min(122, int(width * 0.18)))
            rating_width = max(72, min(96, int(width * 0.15)))
            metric_width = max(
                52, int((width - side_width - rating_width - 8) / 6)
            )
            right = width - 10
            columns = {
                "side": 10,
                "name": 35,
                "rating": side_width + rating_width,
                "damage": side_width + rating_width + metric_width,
                "healing": side_width + rating_width + metric_width * 2,
                "taken": side_width + rating_width + metric_width * 3,
                "kills": side_width + rating_width + metric_width * 4,
                "assists": side_width + rating_width + metric_width * 5,
                "deaths": right,
            }
            row_height = (
                48
                if getattr(self, "history_page_mode", "browser") == "detail"
                else 42
            )
        subtitle = getattr(self, "history_team_subtitle_label", None)
        if subtitle is not None:
            side_size = max(len(allies), len(enemies))
            mode_size = record.get("pvp_team_size") or record.get("team_size")
            try:
                mode_size = int(mode_size or 0)
            except (TypeError, ValueError, OverflowError):
                mode_size = 0
            subtitle.configure(
                text=(f"{mode_size}V{mode_size} · {len(ordered)} 名玩家"
                      if mode_size else f"{len(ordered)} 名玩家")
            )
        for index, participant in enumerate(ordered):
            top = index * row_height
            bottom = top + row_height
            center_y = top + row_height // 2
            actor_id = int(participant.get("actor_id", 0) or 0)
            selected = bool(participant.get("is_self")) or actor_id == self.history_selected_actor
            side = "己方" if participant.get("side") == "ally" else "敌方"
            side_color = ACCENT if side == "己方" else "#e47c80"
            base = blend_color(PANEL, side_color, 0.12) if selected else PANEL if index % 2 == 0 else SURFACE
            tag = f"history-pvp-actor:{index}"
            canvas.create_rectangle(0, top, width, bottom - 1, fill=base, outline="", tags=(tag,))
            canvas.create_rectangle(0, top, 4, bottom - 1, fill=ACCENT if selected else side_color, outline="", tags=(tag,))
            class_id = int(participant.get("profession_id", 0) or 0)
            icon = self._history_profession_icon(class_id, 21)
            name = self._history_actor_name(participant, index, self._history_names_hidden())
            rating = None if history_participant_is_ai(participant) else normalize_extraordinary_rating(participant.get("extraordinary_rating"))
            rating_text = "人机" if history_participant_is_ai(participant) else (format_number(rating) if rating is not None else "--")
            if compact:
                canvas.create_text(
                    columns["side"], top + 13, text=side, fill=side_color,
                    anchor="w", font=self._ui_font("micro"), tags=(tag,),
                )
                canvas.create_image(
                    columns["name"] - 2, top + 7, image=icon,
                    anchor="nw", tags=(tag,),
                )
                name_x = columns["name"] + 23
                canvas.create_text(
                    name_x, top + 14,
                    text=self._fit_ui_text(
                        name, max(48, int(width * 0.40) - name_x - 4), "strong"
                    ),
                    fill=TEXT, anchor="w", font=self._ui_font("strong"),
                    tags=(tag,),
                )
                canvas.create_text(
                    name_x, top + 32, text=rating_text,
                    fill=(
                        "#8bc7d4" if history_participant_is_ai(participant)
                        else ACCENT if rating is not None else SUBTLE
                    ),
                    anchor="w", font=self._ui_font("micro"), tags=(tag,),
                )
                kills = metric(participant.get("kills"))
                assists = metric(participant.get("assists"))
                deaths = metric(participant.get("deaths"))
                canvas.create_text(
                    columns["side"], top + 51,
                    text=f"击 {kills}  ·  助 {assists}  ·  阵 {deaths}",
                    fill=SUBTLE, anchor="w", font=self._ui_font("micro"),
                    tags=(tag,),
                )
            else:
                canvas.create_text(columns["side"], center_y - 7, text=side, fill=side_color, anchor="w", font=self._ui_font("micro"), tags=(tag,))
                canvas.create_image(columns["name"] - 2, center_y + 2, image=icon, anchor="w", tags=(tag,))
                canvas.create_text(columns["name"] + 25, center_y - 7, text=self._fit_ui_text(name, max(60, columns["rating"] - columns["name"] - 28), "strong"), fill=TEXT, anchor="w", font=self._ui_font("strong"), tags=(tag,))
                canvas.create_text(columns["name"] + 25, center_y + 10, text=rating_text, fill="#8bc7d4" if history_participant_is_ai(participant) else ACCENT if rating is not None else SUBTLE, anchor="w", font=self._ui_font("micro"), tags=(tag,))
            values = (
                ("伤害", participant.get("damage"), TEXT),
                ("治疗", participant.get("effective_healing", participant.get("healing")), "#78d99b"),
                ("承伤", participant.get("taken"), "#e49a7c"),
                ("击杀", participant.get("kills"), TEXT),
                ("助攻", participant.get("assists"), TEXT),
                ("阵亡", participant.get("deaths"), "#e47c80"),
            )
            metric_keys = (
                ("damage", "healing", "taken")
                if compact
                else ("damage", "healing", "taken", "kills", "assists", "deaths")
            )
            for (caption, value, color), key in zip(values, metric_keys):
                x = columns[key]
                value_y = top + 21 if compact else center_y - 7
                caption_y = top + 41 if compact else center_y + 11
                canvas.create_text(x, value_y, text=metric(value), fill=color if value is not None else MUTED, anchor="e", font=self._ui_font("number_strong"), tags=(tag,))
                canvas.create_text(x, caption_y, text=caption, fill=SUBTLE, anchor="e", font=self._ui_font("micro"), tags=(tag,))
            canvas.tag_bind(tag, "<Button-1>", lambda _event, selected_actor=actor_id: self._select_history_actor(selected_actor))
            canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
            canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor=""))
        canvas.configure(scrollregion=(0, 0, width, max(height, len(ordered) * row_height)))

    def _select_history_actor(self, actor_id: int) -> None:
        next_actor = int(actor_id)
        if next_actor != self.history_selected_actor:
            self.history_equipment_selected_index = 0
            self.history_skill_timeline_selected_hit = None
            self.history_skill_timeline_hover_hit = None
            self.history_skill_timeline_focus_time = None
        self.history_selected_actor = next_actor
        self._render_history_selection()

