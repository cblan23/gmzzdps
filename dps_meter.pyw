    def _history_field_visible(self, key: str) -> bool:
        if (
            getattr(self, "backend_current_page", "history") == "kings"
            and str(key) in {"character", "extraordinary_rating"}
        ):
            return False
        visible = getattr(
            self,
            "history_visible_fields",
            set(HISTORY_LIST_DEFAULT_FIELDS),
        )
        return str(key) in visible

    def _history_visible_field_changed(self, key: str) -> None:
        variable = getattr(self, "history_field_vars", {}).get(str(key))
        if variable is None:
            return
        if bool(variable.get()):
            self.history_visible_fields.add(str(key))
        else:
            self.history_visible_fields.discard(str(key))
        self.config[HISTORY_LIST_FIELD_CONFIG_KEY] = [
            field
            for field in HISTORY_LIST_OPTIONAL_FIELDS
            if field in self.history_visible_fields
        ]
        save_config(self.config)
        canvas = getattr(self, "history_list_canvas", None)
        if canvas is not None:
            try:
                canvas.xview_moveto(0.0)
            except tk.TclError:
                pass
        self._draw_history_list_header()
        self._draw_history_list()

    def _history_show_incomplete_changed(self) -> None:
        variable = getattr(self, "history_show_incomplete_var", None)
        if variable is None:
            return
        self.history_show_incomplete = bool(variable.get())
        self.config[HISTORY_SHOW_INCOMPLETE_CONFIG_KEY] = (
            self.history_show_incomplete
        )
        save_config(self.config)
        if getattr(self, "backend_current_page", "history") == "history":
            self.history_page_number = 1
            self._query_history_records()

    def _history_list_content_width(self, viewport_width: object) -> int:
        try:
            viewport = max(1, int(viewport_width))
        except (TypeError, ValueError, OverflowError):
            viewport = 1
        micro = self._ui_font("micro")
        number = self._ui_font("number_strong")
        time_width = max(
            number.measure("00:00:00"),
            micro.measure("00-00 · 00:00:00"),
        )
        boss_icon_extent = logical_pixels_to_physical(
            50, getattr(self, "window_dpi", DEFAULT_DPI)
        )
        content_x = 36 + time_width + 12 + boss_icon_extent + 8
        operation_width = max(
            HISTORY_ACTION_PANEL_WIDTH, history_action_panel_width(micro)
        )
        minimum = content_x + 104 + 10 + operation_width + 9
        if self._history_field_visible("character"):
            profession_icon_extent = logical_pixels_to_physical(
                22, getattr(self, "window_dpi", DEFAULT_DPI)
            )
            minimum += max(
                128,
                micro.measure("角色名称") + profession_icon_extent + 34,
            ) + 12
        if self._history_field_visible("extraordinary_rating"):
            minimum += max(80, micro.measure("非凡评分") + 18) + 12
        if self._history_field_visible("performance"):
            minimum += max(124, micro.measure("团队 999,999 DPS") + 18) + 12
        if self._history_field_visible("result"):
            minimum += max(74, micro.measure("战斗结果") + 22) + 12
        return max(viewport, minimum)

    def _history_list_xview(self, *args) -> None:
        for canvas in (
            getattr(self, "history_list_header_canvas", None),
            getattr(self, "history_list_canvas", None),
        ):
            if canvas is None:
                continue
            try:
                canvas.xview(*args)
            except tk.TclError:
                continue

    def _history_list_xscroll_changed(self, first, last) -> None:
        scrollbar = getattr(self, "history_list_horizontal_scrollbar", None)
        if scrollbar is not None:
            scrollbar.set(first, last)
        header = getattr(self, "history_list_header_canvas", None)
        if header is not None:
            try:
                header.xview_moveto(float(first))
            except (TypeError, ValueError, tk.TclError):
                pass

