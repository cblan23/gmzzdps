    def _pvp_equipment_context_active(self) -> bool:
        """Return whether equipment queries belong to a live/recent PVP match."""

        recording = getattr(self, "pvp_recording", None)
        if recording is None:
            return False
        reader = getattr(recording, "equipment_query_active", None)
        if callable(reader):
            try:
                return bool(reader())
            except (TypeError, ValueError, OverflowError):
                return False
        return bool(
            getattr(recording, "active", False)
            or getattr(recording, "duel_recording", None) is not None
            or (
                getattr(recording, "map_id", None) in RECORDABLE_MAPS
                and getattr(recording, "presented_match_id", None)
            )
        )

    def _pvp_verified_team_members(
        self, *, include_self: bool = False, side: str = "ally"
    ) -> list[dict[str, object]]:
        """Read the isolated TeamPVPInfo roster, never the PVE encounter."""

        recording = getattr(self, "pvp_recording", None)
        # A confirmed leave is a live-roster boundary.  The completed PVP
        # tracker is intentionally retained for history/details, but must not
        # leak its old team into the current HUD or equipment query.
        if (
            recording is not None
            and bool(getattr(recording, "party_seen", False))
            and not bool(getattr(recording, "party_active", False))
            and not (
                getattr(recording, "active", False)
                or getattr(recording, "duel_recording", None) is not None
            )
        ):
            return []
        tracker = (
            recording.display_tracker
            if recording is not None
            else getattr(self, "pvp_tracker", None)
        )
        if tracker is not None and side == "ally":
            league = getattr(tracker, "pvp_league_roster", {})
            if isinstance(league, dict) and league.get("raids"):
                members = [
                    dict(
                        member,
                        actor_id=int(getattr(tracker, "tokens", {}).get(member["user_token"], 0) or 0),
                        is_self=member.get("user_token") == tracker.self_token,
                        raid_number=int(raid.get("number", 0) or 0),
                    )
                    for raid in sorted(league["raids"].values(), key=lambda item: item["number"])
                    for group_number in sorted(raid["groups"])
                    for member in raid["groups"][group_number]
                ]
                if not include_self:
                    members = [row for row in members if not row["is_self"]]
                return members
        match = getattr(recording, "recording", None)
        map_id = (
            match.get("map_id") if isinstance(match, dict)
            else getattr(recording, "map_id", None)
        )
        if tracker is None or (
            not getattr(tracker, "pvp_allies", None)
            and (not include_self or self._pvp_live_party_fallback_allowed())
            and not (include_self and map_id in HUNTER_CITY_MAPS)
        ):
            return []
        reader = getattr(tracker, "pvp_team_members", None)
        if not callable(reader):
            return []
        try:
            raw_rows = reader(include_self=include_self, side=side)
        except TypeError:
            raw_rows = reader(include_self=include_self)
        rows = [dict(row) for row in raw_rows if isinstance(row, dict)]
        if (
            map_id in HUNTER_CITY_MAPS
            and side == "ally"
            and bool(getattr(recording, "party_seen", False))
            and (
                isinstance(match, dict)
                and match.get("party_observed_in_match") is True
                or not bool(getattr(recording, "party_active", False))
            )
        ):
            live_tokens = set(getattr(recording, "party_tokens", ()))
            self_token = str(getattr(tracker, "self_token", "") or "")
            if self_token:
                live_tokens.add(self_token)
            rows = [
                row for row in rows
                if str(row.get("user_token") or "") in live_tokens
            ]
        return rows

    def _pvp_live_party_fallback_allowed(self) -> bool:
        """Use ordinary party rows in an arena only after a fresh map join."""

        recording = getattr(self, "pvp_recording", None)
        team_size = int(
            RECORDABLE_MAPS.get(getattr(recording, "map_id", None), {}).get(
                "team_size", 0
            ) or 0
        )
        if team_size not in (3, 6, 12):
            return True
        match = getattr(recording, "recording", None)
        return bool(
            getattr(recording, "active", False)
            and getattr(recording, "party_active", False)
            and isinstance(match, dict)
            and match.get("party_observed_in_match") is True
        )

    def _pvp_current_team_members(self) -> list[dict[str, object]]:
        """Share one current ally roster between the live and team views."""

        rows = self._pvp_verified_team_members(include_self=True)
        model = getattr(self, "model", None)
        recording = getattr(self, "pvp_recording", None)
        tracker = getattr(recording, "display_tracker", None)
        if getattr(tracker, "pvp_league_roster", {}).get("raids"):
            return rows[:PVP_MAX_TEAM_MEMBERS]
        match = getattr(recording, "recording", None)
        fresh_party = bool(
            model is not None
            and getattr(model, "party_active", False)
            and self._pvp_live_party_fallback_allowed()
            and (
                recording is None
                or (
                    getattr(recording, "active", False)
                    and isinstance(match, dict)
                    and match.get("party_observed_in_match") is True
                )
            )
        )
        if not fresh_party:
            return rows
        map_id = match.get("map_id") if isinstance(match, dict) else getattr(recording, "map_id", None)
        team_size = int(RECORDABLE_MAPS.get(map_id, {}).get("team_size", 0) or 0)
        if team_size and len(rows) >= team_size:
            return rows
        if hasattr(model, "party_ids"):
            members = set(getattr(model, "party_ids", ())) | set(
                getattr(model, "provisional_party_ids", ())
            )
        else:
            members = set(self._main_visible_roster_members())
        members.difference_update(getattr(model, "non_player_actor_ids", ()))
        self_id = int(getattr(model, "self_id", 0) or 0)
        if self_id:
            members.add(self_id)
        actor_tokens = getattr(model, "actor_character_ids", {})
        actor_tokens = actor_tokens if isinstance(actor_tokens, dict) else {}
        seen_tokens = {str(row.get("user_token") or "") for row in rows}
        seen_actors = {int(row.get("actor_id", 0) or 0) for row in rows}
        party_tokens = set(getattr(recording, "party_tokens", ()))
        ordered = [actor for actor in getattr(model, "friend_order", ()) if actor in members]
        ordered.extend(sorted(members - set(ordered)))
        for actor in ordered:
            if team_size and len(rows) >= team_size:
                break
            token = str(actor_tokens.get(actor) or "").strip()
            if actor in seen_actors or (token and token in seen_tokens):
                continue
            if party_tokens and token not in party_tokens and (
                token or not hasattr(model, "party_ids")
            ):
                continue
            if actor == self_id and any(row.get("is_self") for row in rows):
                continue
            display_name = getattr(model, "display_name", None)
            name = str(display_name(actor) or "").strip() if callable(display_name) else str(
                getattr(model, "entity_names", {}).get(actor) or ""
            ).strip()
            profession_reader = getattr(model, "actor_profession_id", None)
            profession = (
                profession_reader(actor) if callable(profession_reader)
                else getattr(model, "entity_professions", {}).get(actor, 0)
            )
            profession_id = int(profession or 0)
            rows.append({
                "actor_id": actor,
                "user_token": token,
                "name": name,
                "profession_id": profession_id,
                "is_self": actor == self_id,
            })
            seen_actors.add(actor)
            if token:
                seen_tokens.add(token)
        return rows

    def _pvp_team_composition_rows(self) -> list[dict[str, object]]:
        """Return every resolved friendly actor; the renderer handles paging."""

        model = getattr(self, "model", None)
        if model is None:
            return []
        recording = getattr(self, "pvp_recording", None)
        if (
            recording is not None
            and bool(getattr(recording, "party_seen", False))
            and not bool(getattr(recording, "party_active", False))
            and not (
                getattr(recording, "active", False)
                or getattr(recording, "duel_recording", None) is not None
            )
        ):
            return []
        verified_members = self._pvp_current_team_members()
        if verified_members:
            actor_tokens = getattr(model, "actor_character_ids", {})
            token_actors = {
                str(token or "").strip(): int(actor_id or 0)
                for actor_id, token in (
                    actor_tokens.items() if isinstance(actor_tokens, dict) else ()
                )
                if str(token or "").strip()
            }
            self_id = int(getattr(model, "self_id", 0) or 0)
            rows: list[dict[str, object]] = []
            for index, member in enumerate(verified_members):
                token = str(member.get("user_token") or "").strip()
                actor_id = int(member.get("actor_id", 0) or token_actors.get(token, 0) or 0)
                is_self = bool(member.get("is_self")) or actor_id == self_id
                name = str(member.get("name") or "").strip()
                # Some formal 6v6/12v12 arenas use the same synthetic-looking
                # token prefix for real players. The tracker's is_ai value is
                # already based on explicit projection evidence.
                is_ai = bool(member.get("is_ai")) or pvp_bot_evidence(member)
                rating = normalize_extraordinary_rating(
                    member.get("extraordinary_rating")
                )
                if not is_ai and rating is None and actor_id > 0:
                    rating = self._main_extraordinary_rating(actor_id)
                equipment = (
                    self._equipment_summary_for_actor(actor_id, token)
                    if not is_ai and (actor_id > 0 or token)
                    else {}
                )
                if bool(getattr(self, "hide_names", False)):
                    name = "本人" if is_self else f"玩家{index + 1}"
                profession_id = int(member.get("profession_id", 0) or 0)
                if profession_id <= 0 and actor_id > 0:
                    profession_reader = getattr(model, "actor_profession_id", None)
                    profession_id = int(
                        profession_reader(actor_id) if callable(profession_reader)
                        else getattr(model, "entity_professions", {}).get(actor_id, 0)
                        or 0
                    )
                rows.append({
                    "actor_id": actor_id,
                    "user_token": token,
                    "profession_id": profession_id,
                    "name": name or "玩家识别中",
                    "rating": (
                        "人机" if is_ai else "--" if rating is None else str(rating)
                    ),
                    "rating_value": rating,
                    "rating_text": (
                        "人机" if is_ai else "--" if rating is None else str(rating)
                    ),
                    "inline_rating_text": (
                        "人机" if is_ai else "" if rating is None else str(rating)
                    ),
                    "is_ai": is_ai,
                    "is_self": is_self,
                    "raid_number": int(member.get("raid_number", 0) or 0),
                    "subgroup": int(member.get("subgroup", 0) or 0),
                    "equipment_profile_ready": bool(equipment),
                    "equipment_count": int(equipment.get("equipment_count", 0) or 0),
                    "pvp_equipment_count": int(equipment.get("pvp_equipment_count", 0) or 0),
                    "active_word_count": int(equipment.get("active_word_count", 0) or 0),
                    "total_word_count": int(equipment.get("total_word_count", 0) or 0),
                })
            return rows[:PVP_MAX_TEAM_MEMBERS]
        return []

    def _pvp_layered_main_snapshot(self) -> dict[str, object]:
        """Build a PVP-only view model without borrowing PVE encounter rows."""

        pvp_recording = getattr(self, "pvp_recording", None)
        tracker = (
            pvp_recording.display_tracker
            if pvp_recording is not None
            else getattr(self, "pvp_tracker", None)
        )
        if tracker is not None:
            self.pvp_hud_state = (
                pvp_recording.snapshot()
                if pvp_recording is not None
                else tracker.snapshot()
            )
        state = dict(getattr(self, "pvp_hud_state", {}) or {})
        recording_active = bool(
            pvp_recording is not None and pvp_recording.active
        )
        active_map_id = (
            pvp_recording.recording.get("map_id")
            if recording_active
            else getattr(tracker, "map_id", None)
        )
        map_metadata = RECORDABLE_MAPS.get(active_map_id, {})
        hunter_self_only = active_map_id in HUNTER_CITY_MAPS
        live_map_metadata = RECORDABLE_MAPS.get(
            getattr(pvp_recording, "map_id", None) if pvp_recording is not None else active_map_id,
            {},
        )
        if map_metadata:
            mode_name = str(map_metadata.get("mode_name") or "").strip()
            state["map_name"] = mode_name
            state["team_size"] = int(map_metadata.get("team_size", 0) or 0)
            if recording_active and not state.get("active"):
                state["status"] = "已进入 PVP 地图，正在自动统计"
        session_id = state.get("session_id")
        if session_id != getattr(self, "pvp_visible_session_id", None):
            self.pvp_visible_session_id = session_id
            self.pvp_outgoing_offset = 0
            self.pvp_incoming_offset = 0
            self.pvp_allies_offset = 0
            self.pvp_enemies_offset = 0
            self.pvp_teammate_offset = 0
            self.pvp_team_offset = 0
            self.pvp_league_selected_raid = 0
        # Local identity must stay live even when the last PVE result belongs
        # to a different account/character. Never borrow historical PVE rows.
        model = getattr(self, "model", None)
        self_id = int(getattr(model, "self_id", 0) or 0)
        player_name = str(
            getattr(self, "current_character_name", "")
            or getattr(model, "local_player_name", "")
            or getattr(model, "entity_names", {}).get(self_id, "")
            or ""
        ).strip()
        rating = normalize_extraordinary_rating(
            getattr(model, "entity_extraordinary_ratings", {}).get(self_id)
        )
        try:
            profession_id = int(
                getattr(self, "current_character_profession_id", 0)
                or getattr(model, "entity_professions", {}).get(self_id, 0)
                or 0
            )
        except (TypeError, ValueError, OverflowError):
            profession_id = 0
        if profession_id <= 0 and callable(getattr(model, "actor_profession_id", None)):
            profession_id = model.actor_profession_id(self_id)

        try:
            topmost = self._preferred_main_topmost()
        except (AttributeError, tk.TclError):
            topmost = bool(getattr(self, "config", {}).get("topmost", True))
        try:
            interaction_blocked = self._startup_interaction_blocked()
        except (AttributeError, TypeError):
            interaction_blocked = False

        # Show every player the local character damaged, including opponents
        # who survived. The separate death list remains killer-only.
        def live_rating_row(raw: dict, *, team_row: bool = False) -> dict:
            row = dict(raw)
            token = str(
                row.get("character_id") or row.get("user_token")
                or row.get("opponent_id") or ""
            ).strip()
            is_ai = pvp_bot_evidence(row) or (team_row and bool(row.get("is_ai")))
            score = row.get("extraordinary_rating")
            if score is None:
                score = row.get("rating")
            if score is None and row.get("is_self"):
                score = rating
            if isinstance(score, str):
                score = score.replace(",", "").replace("，", "").strip("（） ")
            normalized = normalize_extraordinary_rating(score)
            if not is_ai and not normalized:
                actor_id = int(row.get("actor_id", 0) or 0)
                candidates = (
                    getattr(tracker, "token_profiles", {}).get(token, {}).get("extraordinary_rating"),
                    getattr(tracker, "pvp_allies", {}).get(token, {}).get("extraordinary_rating"),
                    getattr(tracker, "pvp_enemies", {}).get(token, {}).get("extraordinary_rating"),
                    getattr(tracker, "profiles", {}).get(actor_id, {}).get("extraordinary_rating"),
                    getattr(self, "team_equipment_profiles", {}).get(token, {}).get("extraordinary_rating"),
                    getattr(model, "entity_extraordinary_ratings", {}).get(actor_id),
                    rating if row.get("is_self") else None,
                )
                for candidate in candidates:
                    if isinstance(candidate, str):
                        candidate = candidate.replace(",", "").replace("，", "").strip("（） ")
                    value = normalize_extraordinary_rating(candidate)
                    if value is not None and value > 0:
                        normalized = value
                        break
            if normalized == 0:
                normalized = None
            row["is_ai"] = is_ai
            row["rating"] = "人机" if is_ai else "--" if normalized is None else str(normalized)
            if not is_ai:
                row.update(self._equipment_refresh_fields(
                    int(row.get("actor_id", 0) or 0), token, normalized,
                ))
            return row

        outgoing = [
            live_rating_row(row)
            for row in state.get("outgoing", ())
            if isinstance(row, dict)
            and (int(row.get("damage", 0) or 0) > 0
                 or int(row.get("kills", 0) or 0) > 0)
        ]
        incoming = [
            live_rating_row(row)
            for row in state.get("incoming", ())
            if isinstance(row, dict)
            and int(row.get("defeats", 0) or 0) > 0
        ]
        if hunter_self_only:
            try:
                observed_deaths = max(0, int(state.get("deaths", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                observed_deaths = 0
            assigned_deaths = sum(int(row.get("defeats", 0) or 0) for row in incoming)
            if observed_deaths > assigned_deaths:
                incoming.append({
                    "name": "击败者未识别",
                    "defeats": observed_deaths - assigned_deaths,
                    "damage_text": "未记录",
                    "share_text": "--",
                    "rating": "--",
                })
        pvp_allies = [
            live_rating_row(row, team_row=True)
            for row in state.get("allies", ())
            if isinstance(row, dict)
        ]
        pvp_enemies = [
            live_rating_row(row, team_row=True)
            for row in state.get("enemies", ())
            if isinstance(row, dict)
        ]
        team_size = int(state.get("team_size", 0) or 0)
        team_battle = bool(
            state.get("team_battle")
            or team_size in (3, 6, 12) and (pvp_allies or pvp_enemies)
        )
        self_team_row = next(
            (row for row in pvp_allies if bool(row.get("is_self"))), None
        )
        if self_team_row is not None:
            for source, target in (
                ("kills", "kills"),
                ("assists", "assists"),
                ("deaths", "deaths"),
            ):
                if self_team_row.get(source) is not None:
                    state[target] = self_team_row[source]
            if self_team_row.get("damage") is not None:
                state["total_damage"] = format_number(self_team_row["damage"])
            if self_team_row.get("taken") is not None:
                state["total_taken"] = format_number(self_team_row["taken"])
            if state.get("healing") is None and self_team_row.get("healing") is not None:
                state["healing"] = self_team_row["healing"]

        def pvp_rating_value(value: object) -> int | None:
            if isinstance(value, str):
                value = value.replace(",", "").replace("，", "").strip()
            return normalize_extraordinary_rating(value)

        average_kill_rating = pvp_rating_value(
            state.get("average_kill_rating")
        )
        if average_kill_rating is None:
            weighted_rating = 0
            rated_kills = 0
            missing_kill_rating = False
            for row in outgoing:
                try:
                    kills = max(0, int(row.get("kills", 0) or 0))
                except (TypeError, ValueError, OverflowError):
                    kills = 0
                target_rating = pvp_rating_value(row.get("rating"))
                if kills > 0 and target_rating is not None:
                    weighted_rating += target_rating * kills
                    rated_kills += kills
                elif kills > 0:
                    missing_kill_rating = True
            if rated_kills and not missing_kill_rating:
                average_kill_rating = int(
                    weighted_rating / rated_kills + 0.5
                )

        pvp_hud_view = "team" if getattr(self, "pvp_hud_view", "team") == "team" else "live"
        # The footer shows the same team-rating summary in both PVP views, so
        # calculate the live composition independently of which table is open.
        if hunter_self_only and pvp_hud_view == "live":
            # Hunter City is self-only in the live results view. Do not build
            # the full 30-person equipment/rating roster just to populate a
            # footer that already shows the local rating.
            composition_rows = []
        else:
            recording = getattr(pvp_recording, "recording", None)
            profiles = getattr(self, "team_equipment_profiles", {})
            profile_signature = tuple(
                sorted(
                    (
                        str(token),
                        profile.get("captured_at_ns"),
                        profile.get("extraordinary_rating"),
                        profile.get("equipment_count"),
                        profile.get("pvp_equipment_count"),
                        profile.get("active_word_count"),
                        profile.get("total_word_count"),
                        profile.get("batch_id"),
                    )
                    for token, profile in profiles.items()
                    if isinstance(profile, dict)
                )
            )
            composition_key = (
                id(tracker),
                int(getattr(tracker, "generation", 0) or 0),
                active_map_id,
                pvp_hud_view,
                bool(getattr(self, "hide_names", False)),
                int((recording or {}).get("party_session_id", 0) or 0),
                tuple(sorted(getattr(pvp_recording, "party_tokens", ()) or ())),
                tuple(sorted(
                    set(getattr(self.model, "party_ids", ()) or ())
                    | set(getattr(self.model, "provisional_party_ids", ()) or ())
                )),
                tuple(getattr(self.model, "friend_order", ()) or ()),
                profile_signature,
            )
            if composition_key == getattr(self, "pvp_team_composition_cache_key", None):
                composition_rows = list(
                    getattr(self, "pvp_team_composition_cache_rows", ())
                )
            else:
                composition_rows = self._pvp_team_composition_rows()
                self.pvp_team_composition_cache_key = composition_key
                self.pvp_team_composition_cache_rows = list(composition_rows)
        self.pvp_team_row_count = len(composition_rows)
        team_rows = []
        if pvp_hud_view == "team":
            team_rows = [
                dict(row) if row.get("is_ai") else {
                    **row, **self._equipment_refresh_fields(
                        int(row.get("actor_id", 0) or 0),
                        row.get("user_token", ""), row.get("rating_value"),
                    ),
                }
                for row in composition_rows
            ]
        league_roster = getattr(tracker, "pvp_league_roster", {}) or {}
        rated_team = [
            int(row.get("rating_value"))
            for row in composition_rows
            if not bool(row.get("is_ai"))
            and row.get("rating_value") is not None
        ]
        team_average_rating = (
            int(sum(rated_team) / len(rated_team) + 0.5)
            if rated_team
            else None
        )

        return {
            "combat_mode": "pvp",
            "pvp_hud_view": pvp_hud_view,
            "pvp_self_only": hunter_self_only,
            "pvp_healer": hunter_self_only and profession_id == 1_200_002,
            "pvp_effective_healing": (
                format_number(state["healing"])
                if state.get("healing") is not None
                else "未记录"
            ),
            "time": str(state.get("time") or "00:00"),
            "pvp_player_name": player_name or "等待识别",
            "pvp_rating": "" if rating is None else str(rating),
            "pvp_self_equipment": self._equipment_refresh_fields(
                self_id, self._team_equipment_local_token(), rating,
            ),
            "pvp_profession_id": profession_id,
            "pvp_map_name": str(
                state.get("map_name") or state.get("module_name") or ""
            ).strip(),
            "pvp_kills": state.get("kills", "--"),
            "pvp_assists": state.get("assists", "--"),
            "pvp_deaths": state.get("deaths", "--"),
            "pvp_outgoing": outgoing,
            "pvp_incoming": incoming,
            "pvp_monsters": list(state.get("monsters") or ()),
            "pvp_monster_damage": format_number(state.get("monster_damage") or 0),
            "pvp_monster_taken": format_number(state.get("monster_taken") or 0),
            "pvp_team_battle": team_battle and not hunter_self_only,
            "pvp_team_size": team_size,
            "pvp_allies": [] if hunter_self_only else pvp_allies,
            "pvp_enemies": [] if hunter_self_only else pvp_enemies,
            "pvp_outgoing_offset": int(getattr(self, "pvp_outgoing_offset", 0)),
            "pvp_incoming_offset": int(getattr(self, "pvp_incoming_offset", 0)),
            "pvp_allies_offset": int(getattr(self, "pvp_allies_offset", 0)),
            "pvp_enemies_offset": int(getattr(self, "pvp_enemies_offset", 0)),
            "pvp_average_kill_rating": (
                "" if average_kill_rating is None else str(average_kill_rating)
            ),
            "pvp_total_damage": str(state.get("total_damage", "--")),
            "pvp_total_taken": str(state.get("total_taken", "--")),
            "pvp_status": str(
                state.get("status") or "等待 PVP 战斗数据"
            ),
            "pvp_result": str(state.get("result") or "等待中"),
            "pvp_active": bool(state.get("active", False) or recording_active),
            "pvp_in_map": bool(live_map_metadata),
            "pvp_teammates": (
                self._pvp_current_teammates()
                if live_map_metadata and not hunter_self_only else []
            ),
            "pvp_teammate_offset": int(getattr(self, "pvp_teammate_offset", 0)),
            "pvp_team_rows": team_rows,
            "pvp_team_offset": int(getattr(self, "pvp_team_offset", 0)),
            "pvp_league_roster": dict(getattr(tracker, "pvp_league_roster", {}) or {}),
            "pvp_league_selected_raid": int(getattr(self, "pvp_league_selected_raid", 0) or 0),
            "visible_rows": clamp_visible_rows(
                getattr(self, "pvp_visible_rows", HUD_DEFAULT_VISIBLE_ROWS)
            ),
            "pvp_team_average_rating": (
                "" if team_average_rating is None else str(team_average_rating)
            ),
            "topmost": bool(topmost),
            "locked": bool(getattr(self, "window_locked", False)),
            "hover_action": str(
                getattr(self, "layered_main_hover_action", "") or ""
            ),
            "settings_disabled": SETTINGS_TEMPORARILY_DISABLED,
            "admin_elevated": bool(
                getattr(self, "process_is_elevated", False)
            ),
            "interaction_blocked": interaction_blocked,
        }

    def _pvp_current_teammates(self) -> list[dict[str, object]]:
        """Show the same current allies as team composition, excluding self."""

        model = getattr(self, "model", None)
        self_id = int(getattr(model, "self_id", 0) or 0)
        rows = []
        for member in self._pvp_current_team_members():
            if member.get("is_self") or int(member.get("actor_id", 0) or 0) == self_id:
                continue
            row = dict(member)
            if getattr(self, "hide_names", False):
                row["name"] = f"队友{len(rows) + 1}"
            elif not str(row.get("name") or "").strip():
                row["name"] = "队友识别中"
            rows.append(row)
        return rows

    def _layered_main_snapshot(self) -> dict[str, object]:
        if getattr(self, "main_combat_mode", "pve") == "pvp":
            if self._pvp_hud_map_active():
                return self._pvp_layered_main_snapshot()
            return {
                "combat_mode": "pvp",
                "pvp_hud_view": (
                    "team" if getattr(self, "pvp_hud_view", "live") == "team"
                    else "live"
                ),
                "pvp_map_name": "PVP 对战",
                "pvp_status": "进入 PVP 地图后加载数据",
                "pvp_in_map": False,
                "pvp_active": False,
                "time": "00:00",
                "visible_rows": clamp_visible_rows(
                    getattr(self, "pvp_visible_rows", HUD_DEFAULT_VISIBLE_ROWS)
                ),
                "topmost": bool(self._preferred_main_topmost()),
                "locked": bool(getattr(self, "window_locked", False)),
                "hover_action": str(getattr(self, "layered_main_hover_action", "") or ""),
                "settings_disabled": SETTINGS_TEMPORARILY_DISABLED,
                "interaction_blocked": self._startup_interaction_blocked(),
            }
        targetless_team_data = self._main_targetless_team_data()
        live_hud_projection_active = self._main_live_hud_projection_active()
        raw_live_hud_boss_state = getattr(self, "live_hud_boss_state", None)
        terminal_boss_state = (
            raw_live_hud_boss_state
            if isinstance(raw_live_hud_boss_state, dict)
            and raw_live_hud_boss_state.get("terminal_zero")
            else None
        )
        live_hud_boss_state = (
            self._main_live_hud_boss_state()
            if live_hud_projection_active
            else None
        )
        rows, rating_preview = self._main_display_rows()
        # FightMode can arrive before the next team snapshot.  Only rows from
        # that snapshot may replace the delayed result from the previous pull.
        targetless_team_active = bool(
            live_hud_projection_active
            and any(
                isinstance(row, dict) and row.get("targetless_team_live")
                for row in rows
            )
        )
        application_rows = self._team_application_section_rows()
        display_rows: list[dict[str, object]] = []
        for raw in rows:
            row = dict(raw)
            if row.get("row_kind"):
                display_rows.append(row)
                continue
            if rating_preview or row.get("metric") == "rating":
                rating = normalize_extraordinary_rating(row.get("rating"))
                rating_text = (
                    "人机"
                    if row.get("is_ai")
                    else "--"
                    if rating is None
                    else str(rating)
                )
                # Keep both public presentation keys available regardless of
                # whether the row came from the live roster, a settlement, or
                # a test/provider projection.  The canvas and detail views
                # consume these independently.
                row["rating_text"] = rating_text
                row.setdefault("inline_rating_text", "" if rating is None else rating_text)
                if rating is None and row.get('metric') == 'rating':
                    row['rating_pending'] = True
            else:
                row["stat_text"] = format_main_rate(row.get("stat_value"))
                row["total_text"] = (
                    ""
                    if row.get("hide_total")
                    else row.get('total_text_override')
                    or format_main_total(row.get("total_value"))
                )
            display_rows.append(row)

        startup_blocked = self._startup_interaction_blocked()
        startup_message = self._startup_wait_message()
        if startup_blocked:
            try:
                self_id = int(getattr(self.model, "self_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                self_id = 0
            self_rows = [
                row
                for row in display_rows
                if row.get("is_live_self")
                or row.get("is_self")
                or (
                    self_id > 0
                    and int(row.get("actor_id", 0) or 0) == self_id
                )
            ]
            if self_rows:
                self_row = dict(self_rows[0])
            else:
                self_row = {
                    "actor_id": self_id,
                    "profession_id": 0,
                    "name": "识别中",
                    "metric": "dps",
                    "stat_text": "",
                    "total_text": "",
                    "deaths": 0,
                    "hide_deaths": True,
                    "is_self": True,
                    "is_live_self": True,
                    "interactive": False,
                }
            rating = normalize_extraordinary_rating(self_row.get("rating"))
            if rating is None and self_id > 0:
                rating = self._main_extraordinary_rating(self_id, self_row)
            if rating is not None:
                self_row["rating"] = rating
                # Keep the public row contract identical to normal roster
                # rows while the startup gate is active.  The layered HUD
                # reads ``rating_text`` even for the pinned self row.
                self_row["rating_text"] = str(rating)
                self_row["inline_rating_text"] = str(rating)
            else:
                self_row.setdefault(
                    "rating_text",
                    "浜烘満" if self_row.get("is_ai") else "--",
                )
            self_row["interactive"] = False
            display_rows = [
                self_row,
                {
                    "row_kind": "message",
                    "message_text": startup_message,
                },
            ]
            rating_preview = False
            application_rows = []

        # The PVE team tab is an explicit presentation choice.  Keep the
        # pinned local row, then show the complete current roster below it;
        # selecting this tab must never fabricate a battle result or clear a
        # live encounter.
        pve_team_view = (
            getattr(self, "pve_hud_view", "team") == "team"
        )
        if pve_team_view and not startup_blocked:
            team_rows = [
                dict(row)
                for row in self._main_team_rating_section_rows()
                if isinstance(row, dict)
            ]
            for row in team_rows:
                row["metric"] = "rating"
                row["hide_total"] = True
                row["hide_deaths"] = True
                row["interactive"] = False
                rating_value = normalize_extraordinary_rating(
                    row.get("rating")
                )
                row["rating_text"] = (
                    "人机"
                    if row.get("is_ai")
                    else "--"
                    if rating_value is None
                    else str(rating_value)
                )
                row["inline_rating_text"] = (
                    "人机"
                    if row.get("is_ai")
                    else ""
                    if rating_value is None
                    else str(rating_value)
                )
            self_row = next(
                (
                    row
                    for row in team_rows
                    if bool(row.get("is_self"))
                ),
                None,
            )
            if self_row is None:
                self_row = next(
                    (
                        row
                        for row in display_rows
                        if bool(row.get("is_self"))
                        or bool(row.get("is_live_self"))
                    ),
                    None,
                )
            if self_row is not None:
                self_row = dict(self_row)
                self_row["is_self"] = True
                self_row["is_live_self"] = True
                self_row["highlight_self_row"] = True
                team_rows = [
                    row for row in team_rows
                    if row.get("actor_id") != self_row.get("actor_id")
                ]
                display_rows = [
                    self_row,
                    {
                        "row_kind": "section",
                        "section_text": "团队构成",
                        "expanded": True,
                    },
                    *team_rows,
                ]
            else:
                display_rows = [
                    {
                        "row_kind": "section",
                        "section_text": "团队构成",
                        "expanded": True,
                    },
                    *team_rows,
                ]
            rating_preview = True

        current_monster = getattr(self.model, "current_monster", None)
        monster = current_monster() if callable(current_monster) else None
        if monster is None:
            current_bosses = getattr(self.model, "current_bosses", None)
            bosses = list(current_bosses()) if callable(current_bosses) else []
            monster = bosses[0] if bosses else None
        retained_record = self.main_last_battle_result if self._main_retained_battle_active() else None
        recent_settlement = self._main_recent_settlement_record()
        if targetless_team_active:
            retained_record = None
            recent_settlement = None
        if live_hud_boss_state is not None:
            from types import SimpleNamespace

            alias = LIVE_HUD_BOSS_ALIASES.get(
                int(live_hud_boss_state["template_id"]),
                LIVE_HUD_UNKNOWN_BOSS_ALIAS,
            )
            live_boss_name = str(live_hud_boss_state.get("name") or "").strip()
            if not live_boss_name or boss_name_is_placeholder(live_boss_name):
                live_boss_name = str(alias["name"])
            monster = SimpleNamespace(
                entity_id=int(live_hud_boss_state["entity_id"]),
                template_id=int(live_hud_boss_state["template_id"]),
                name=live_boss_name,
                icon=str(live_hud_boss_state.get("icon") or alias["icon"]),
                level=int(live_hud_boss_state.get("level", 0) or 0),
                current_hp=max(
                    0.0,
                    float(live_hud_boss_state.get("current_hp", 0.0) or 0.0),
                ),
                max_hp=max(
                    0.0,
                    float(live_hud_boss_state.get("max_hp", 0.0) or 0.0),
                ),
            )
        settlement_tracker = getattr(
            getattr(self, "settlement_ui", None), "tracker", None
        )
        current_settlement_id = getattr(settlement_tracker, "current_id", None)
        dummy_reader = getattr(self.model, "_is_dummy_encounter", None)
        is_dummy = bool(dummy_reader()) if callable(dummy_reader) else False
        try:
            current_boss_hp = float(getattr(monster, "current_hp", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            current_boss_hp = 0.0
        combat_reader = getattr(self.model, "combat_in_progress", None)
        model_combat_active = (
            bool(combat_reader()) if callable(combat_reader) else False
        )
        live_no_boss = bool(
            targetless_team_active
            and live_hud_boss_state is None
            and monster is None
        )
        if live_no_boss:
            # This is a live-only presentation state.  Repeated team counters
            # from small monsters must not resurrect an older Boss result.
            retained_record = None
            recent_settlement = None
        try:
            current_boss_id = int(getattr(monster, "entity_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            current_boss_id = 0
        combat_states = getattr(self.model, "entity_combat_states", {})
        current_boss_in_fight_mode = bool(
            current_boss_id
            and isinstance(combat_states, dict)
            and combat_states.get(current_boss_id) is True
        )
        # A confirmed replacement Boss can legitimately arrive before its
        # first CurrentHP packet (the delayed TeamStats path is independent
        # from target promotion).  ``current_monster()`` already exposes the
        # pending target in that window; keep the recent-settlement fallback
        # from putting the previous Boss back over the new target.
        pending_boss_id = int(
            getattr(self.model, "pending_active_boss_id", 0) or 0
        )
        model_has_current_boss = bool(
            monster is not None
            and (
                current_boss_hp > 0
                or model_combat_active
                or current_boss_in_fight_mode
                or (pending_boss_id and current_boss_id == pending_boss_id)
            )
        )
        model_terminal_victory = bool(
            str(getattr(self.model, "combat_end_reason", "") or "").casefold()
            == "target_defeated"
            and not model_combat_active
            and not current_boss_in_fight_mode
            and not pending_boss_id
        )
        terminal_zero_matches_live = bool(
            terminal_boss_state is not None
            and current_boss_id > 0
            and int(terminal_boss_state.get("entity_id", 0) or 0)
            == current_boss_id
            and float(terminal_boss_state.get("current_hp", 0.0) or 0.0)
            == 0.0
        )
        if terminal_zero_matches_live:
            model_terminal_victory = True
            model_has_current_boss = False
        recent_victory_matches_live = bool(
            recent_settlement is not None
            and not current_settlement_id
            and not pending_boss_id
            and self._main_recent_victory_matches_live_boss(
                recent_settlement, monster
            )
            and float(getattr(self.model, "first_damage_time", 0) or 0)
            <= int(recent_settlement.ended_at_ns or 0) / 1_000_000_000
        )
        if recent_victory_matches_live:
            # A settlement can be marked victorious after the live model has
            # stopped, but before its trailing HP packet arrives.  Treat that
            # exact Boss match as terminal; a newer Boss sample is excluded by
            # the identity/timestamp check above.
            model_terminal_victory = True
            model_has_current_boss = False
        current_boss_health_is_newer = False
        if retained_record is not None and current_boss_hp > 0:
            try:
                hp_updated_100ns = int(
                    getattr(monster, "last_hp_update_100ns", 0) or 0
                )
                retained_ended_at = float(
                    retained_record.get("ended_at_epoch", 0.0) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                hp_updated_100ns = 0
                retained_ended_at = 0.0
            if hp_updated_100ns > 116_444_736_000_000_000 and retained_ended_at > 0:
                hp_updated_at = (
                    hp_updated_100ns - 116_444_736_000_000_000
                ) / 10_000_000
                current_boss_health_is_newer = hp_updated_at > retained_ended_at
        if (
            pending_boss_id
            or model_combat_active
            or current_boss_in_fight_mode
            or current_boss_health_is_newer
        ):
            # A retained display copy cannot replace a newly promoted target.
            retained_record = None
        show_recent_settlement_header = bool(
            recent_settlement is not None
            and recent_settlement.settlement_status == "SETTLED"
            and not current_settlement_id
            and not is_dummy
            and not model_has_current_boss
            and not self._main_display_is_cleared()
        )
        if show_recent_settlement_header:
            monster = self._main_recent_settlement_monster(recent_settlement)
        elif retained_record is not None:
            from types import SimpleNamespace
            monster = SimpleNamespace(**retained_record['monster'])
        boss_values = self._main_boss_display_values(
            monster, force_defeated=model_terminal_victory
        )
        if live_hud_boss_state is not None:
            boss_values["live_hud_boss"] = True
            boss_values["boss_icon"] = str(live_hud_boss_state.get("icon") or "")
        if live_no_boss:
            boss_values = {
                "boss_name": "当前没有Boss · 小怪战斗",
                "boss_available": True,
                "boss_template_id": 0,
                "boss_icon": "live-small-monsters-v2.png",
                "live_no_boss": True,
                "boss_level": None,
                "boss_hp": "",
                "boss_percent": "",
                "boss_ratio": None,
            }
        boss_reader = getattr(self.model, 'current_bosses', None)
        if live_no_boss:
            display_bosses = [boss_values]
        elif show_recent_settlement_header:
            display_bosses = [boss_values]
        elif retained_record:
            retained_bosses = retained_record.get('bosses') or [boss_values]
            if model_terminal_victory:
                # Older retained rows can contain one last positive frame.
                # Preserve the dual-Boss layout while replacing only the
                # terminal health fields.
                display_bosses = []
                for raw_boss in retained_bosses:
                    row = dict(raw_boss) if isinstance(raw_boss, dict) else {}
                    row["boss_ratio"] = 0.0
                    row["boss_percent"] = "0%"
                    raw_hp = str(row.get("boss_hp") or "")
                    if "/" in raw_hp:
                        row["boss_hp"] = "0 / " + raw_hp.split("/", 1)[1].strip()
                    else:
                        row["boss_hp"] = raw_hp
                    display_bosses.append(row)
                if not display_bosses:
                    display_bosses = [boss_values]
            else:
                display_bosses = retained_bosses
        else:
            monsters = (list(boss_reader()) if callable(boss_reader) else [])[:MAX_SIMULTANEOUS_BOSSES]
            if len(monsters) > 1 and any(
                int(getattr(value, 'template_id', 0) or 0) in
                (FIRST_BELIEVER_BARNEY_TEMPLATE_IDS | FIRST_BELIEVER_ANXIA_TEMPLATE_IDS)
                for value in monsters
            ):
                owner = enrage_marker_row_index(monsters)
                if owner > 0:
                    # Keep the forecast over its existing phase owner: Barney
                    # first, then Anxia when the existing phase rule advances.
                    monsters = [monsters[owner], *monsters[:owner], *monsters[owner + 1:]]
            display_bosses = [
                self._main_boss_display_values(
                    value, force_defeated=model_terminal_victory
                )
                for value in monsters
            ]
            if not display_bosses:
                display_bosses = [boss_values]

        prediction_value: dict[str, object] | None = None
        prediction = getattr(self, "enrage_prediction", None)
        if (
            not live_no_boss
            and bool(getattr(self, "boss_enrage_prediction_enabled", True))
            and bool(getattr(self, "enrage_prediction_visible", False))
            and prediction is not None
            and not bool(getattr(prediction, "calculating", False))
        ):
            prediction_value = {
                "state": str(getattr(prediction, "state", "") or ""),
                "message": str(getattr(prediction, "message", "") or ""),
                "marker": enrage_marker_ratio(prediction),
            }

        physical_row_height = max(
            1,
            logical_pixels_to_physical(
                HUD_ROW_HEIGHT * float(getattr(self, "main_ui_scale", 1.0) or 1.0),
                getattr(self, "window_dpi", DEFAULT_DPI),
            ),
        )
        visible_rows = clamp_visible_rows(
            getattr(self, "main_visible_rows", HUD_DEFAULT_VISIBLE_ROWS)
        )
        recent_section = next(
            (
                row
                for row in display_rows
                if row.get("row_kind") == "section"
            ),
            None,
        )
        if (
            not pve_team_view
            and not startup_blocked
            and bool(getattr(self, "show_team_dps", True))
        ):
            if recent_section is None:
                recent_section = {
                    "row_kind": "section",
                    "section_text": "实时战斗/战斗记录",
                }
                display_rows.insert(0, recent_section)
            recent_section["live_team_dps"] = (
                self._main_live_team_dps_text(display_rows) or "--"
            )
            recent_section["live_dps_caption"] = (
                "实时玩家秒伤" if is_dummy else "实时团队秒伤"
            )
        if recent_section is not None:
            # Retain the user's chosen list capacity, with room for the pinned
            # self row, heading, optional Boss card and one result/message row.
            expanded_minimum = 4 if any(
                row.get("row_kind") == "recent_boss" for row in display_rows
            ) else 3
            visible_rows = max(expanded_minimum, visible_rows)
        maximum_start = max(0, len(display_rows) - visible_rows)
        start_index = min(
            maximum_start,
            max(0, int(getattr(self, "main_scroll_offset", 0)) // physical_row_height),
        )
        try:
            topmost = self._preferred_main_topmost()
        except (AttributeError, tk.TclError):
            topmost = bool(self.config.get("topmost", True))
        team_rating_footer_enabled = bool(
            TEAM_RATING_PREVIEW_AVAILABLE
            and getattr(self, "team_rating_preview_enabled", False)
        )
        if pve_team_view:
            team_dps_summary_text = (
                self._main_team_rating_summary_text()
                if team_rating_footer_enabled
                else "0"
            )
        else:
            team_dps_summary_text = (
                self._main_recent_battle_team_dps_text() or "--"
            )
        display_rows = [
            row if row.get("row_kind") or row.get("is_ai") else {
                **row, **self._equipment_refresh_fields(
                    int(row.get("actor_id", 0) or 0), row.get("user_token", ""),
                ),
            }
            for row in display_rows
        ]
        return {
            "time": self._main_display_time_text(
                recent_settlement if show_recent_settlement_header else None,
                retained_record,
            ),
            **boss_values,
            'bosses': display_bosses,
            "prediction": None if retained_record or show_recent_settlement_header or self._main_display_is_cleared() else prediction_value,
            "rows": display_rows,
            "application_rows": application_rows,
            "rating_preview": rating_preview,
            "pve_hud_view": (
                "team" if pve_team_view else "recent_battle"
            ),
            "start_index": start_index,
            "visible_rows": visible_rows,
            "show_time": bool(getattr(self, "show_combat_time", True)),
            "show_boss": bool(getattr(self, "show_boss_hp_bar", True)),
            "show_totals": bool(getattr(self, "show_main_totals", True)),
            "show_deaths": bool(getattr(self, "show_deaths", True)),
            "show_team_dps": bool(getattr(self, "show_team_dps", True)),
            # The page switch remains usable outside a PvP map. Live PvP
            # data is loaded only after entering a recordable PvP map.
            "show_pvp": bool(getattr(self, "show_pvp_button", True)),
            "pvp_available": PVP_FEATURE_ENABLED,
            "highlight_self": bool(getattr(self, "highlight_self", True)),
            "dps_summary_caption": (
                "团队总秒伤"
                if not pve_team_view
                else "团队超凡评分"
            ),
            "team_dps": team_dps_summary_text,
            "row_mask_opacity": int(getattr(self, "main_row_mask_opacity", 0) or 0),
            "topmost": bool(topmost),
            "locked": bool(getattr(self, "window_locked", False)),
            "hover_action": str(getattr(self, "layered_main_hover_action", "") or ""),
            "clear_disabled": self._main_clear_blocked(),
            "settings_disabled": SETTINGS_TEMPORARILY_DISABLED,
            "admin_elevated": bool(getattr(self, "process_is_elevated", False)),
            "interaction_blocked": startup_blocked,
            "startup_message": startup_message,
        }

    def _main_display_time_text(self, header_record=None, retained_record=None):
        """Resolve the displayed pull's clock, independently of remaining HP."""
        live_hud_active = self._main_live_hud_projection_active()
        model = self.model
        current_monster = getattr(model, "current_monster", None)
        model_monster = current_monster() if callable(current_monster) else None
        if model_monster is None:
            current_bosses = getattr(model, "current_bosses", None)
            model_bosses = (
                list(current_bosses()) if callable(current_bosses) else []
            )
            model_monster = model_bosses[0] if model_bosses else None
        live_hud_boss = (
            self._main_live_hud_boss_state() if live_hud_active else None
        )
        if live_hud_active and (
            live_hud_boss is not None or model_monster is None
        ):
            live_hud_duration = self._main_live_hud_dps_duration()
            if live_hud_duration is not None:
                return format_duration(live_hud_duration)
            targetless_team_data = self._main_targetless_team_data()
            if targetless_team_data is not None:
                if live_hud_boss is not None:
                    started_at = float(live_hud_boss["started_at_epoch"])
                    return format_duration(max(0.0, time.time() - started_at))
                return format_duration(targetless_team_data[1])
        if self._main_display_is_cleared() or self._main_context_display_is_stale():
            if header_record is None and retained_record is None:
                live_hud_duration = self._main_live_hud_dps_duration()
                if live_hud_duration is not None:
                    return format_duration(live_hud_duration)
                targetless_team_data = self._main_targetless_team_data()
                if targetless_team_data is not None:
                    return format_duration(targetless_team_data[1])
            return "00:00"
        live_text = str(getattr(self, "main_time_text", "00:00") or "00:00")
        if getattr(model, "pending_active_boss_id", None):
            reader = getattr(model, "display_duration", None)
            return format_duration(reader()) if callable(reader) else live_text
        controller = getattr(self, "settlement_ui", None)
        tracker = getattr(controller, "tracker", None)
        active_reader = getattr(model, "combat_in_progress", None)
        if (getattr(tracker, "current_id", None)
                or (callable(active_reader) and active_reader())):
            return live_text
        record = header_record or self._main_recent_settlement_record(keep_last_settled=False)
        if record is not None:
            # The header is the displayed Boss pull clock. A final victory can
            # also carry an ALL table whose member lengths cover the entire
            # dungeon; using that cumulative clock made the last Boss show the
            # full run time (for example 13:43 instead of 05:39).
            view = encounter_view(record, statistics_scope="STAGE")
            seconds = view.get("duration_seconds")
            if seconds is None or seconds <= 0:
                seconds = max(0, (record.ended_at_ns - record.started_at_ns) / 1e9)
            return format_duration(seconds)
        if retained_record:
            return format_duration(retained_record.get("duration_seconds") or 0)
        live_hud_duration = self._main_live_hud_dps_duration()
        if live_hud_duration is not None:
            return format_duration(live_hud_duration)
        targetless_team_data = self._main_targetless_team_data()
        if targetless_team_data is not None:
            return format_duration(targetless_team_data[1])
        reader = getattr(model, "display_duration", None)
        return format_duration(reader()) if callable(reader) else live_text

    def _render_layered_main_hud(self) -> None:
        if (
            not self._layered_main_active()
            or self.closing
            or bool(getattr(self, "layered_main_rendering", False))
        ):
            return
        self.layered_main_rendering = True
        paint_started = time.perf_counter()
        try:
            if self.root.state() != "normal":
                return
            renderer = self.layered_main_renderer
            presenter = self.layered_main_presenter
            if renderer is None or presenter is None:
                return
            pixel_scale = (
                float(getattr(self, "window_dpi", DEFAULT_DPI)) / DEFAULT_DPI
            ) * float(getattr(self, "main_ui_scale", 1.0) or 1.0)
            snapshot = self._layered_main_snapshot()
            if (
                snapshot.get("combat_mode", "pve") == "pve"
                and not self._main_retained_battle_active()
                and self._main_has_battle_values()
            ):
                self.main_last_live_display_snapshot = dict(
                    encounter_id=getattr(self.model, 'encounter_id', ''),
                    bosses=snapshot.get('bosses', []),
                )
            cache = getattr(self, "layered_main_frame_cache", None)
            if cache is None:
                cache = self.layered_main_frame_cache = HudRenderCache()
            result = cache.render(
                renderer, snapshot,
                pixel_scale=pixel_scale,
                font_size=int(getattr(self, "ui_font_size", 14) or 14),
                assume_snapshot_immutable=(
                    str(snapshot.get("combat_mode", "")).casefold() == "pvp"
                ),
            )
            width, height = result.image.size
            try:
                # Retired Tk layout helpers may reapply their old minimum
                # after a settings change. The new HUD's actual art bounds
                # (including removal of the death column) are authoritative.
                self.root.minsize(1, 1)
                x, y = self.root.winfo_x(), self.root.winfo_y()
                if (self.root.winfo_width(), self.root.winfo_height()) != (width, height):
                    self.root.geometry(
                        format_absolute_tk_geometry(width, height, x, y)
                    )
                    self.root.update_idletasks()
            except (AttributeError, TypeError, ValueError, tk.TclError):
                pass
            self.layered_main_hit_regions = dict(result.hit_regions)
            self.layered_main_actor_regions = result.actor_regions
            self.layered_main_visible_rows = result.visible_rows
            row_total = len(snapshot.get("rows", ()))
            viewport_rows = max(1, result.visible_rows)
            self.main_scroll_content_height = max(
                result.row_height * viewport_rows,
                result.row_height * row_total,
            )
            maximum_offset = max(
                0,
                self.main_scroll_content_height - result.row_height * viewport_rows,
            )
            self.main_scroll_offset = min(
                maximum_offset,
                max(0, int(getattr(self, "main_scroll_offset", 0))),
            )
            try:
                visible = self.root.state() == "normal"
            except (AttributeError, tk.TclError):
                visible = True
            if visible:
                presenter.present(
                    result.image,
                    opacity=1.0,
                )
            self.layered_main_last_image = result.image
            self.layered_main_last_error = ""
            if visible and self.window_locked:
                self._sync_unlock_window_position()
        except (AttributeError, OSError, RuntimeError, TypeError, ValueError, tk.TclError) as exc:
            # A single paint failure must never interrupt combat collection.
            error = f"{type(exc).__name__}: {exc}"
            if error != getattr(self, "layered_main_last_error", ""):
                print(f"[main-hud] {error}", file=sys.stderr)
                self.layered_main_last_error = error
            return
        finally:
            finished = time.perf_counter()
            self.layered_main_paint_finished_at = finished
            self.layered_main_paint_ms = (finished - paint_started) * 1000.0
            self.layered_main_peak_paint_ms = max(
                getattr(self, "layered_main_peak_paint_ms", 0.0), self.layered_main_paint_ms)
            self.layered_main_rendering = False

    def _layered_main_region_at(self, x: int, y: int) -> str:
        regions = getattr(self, "layered_main_hit_regions", {})
        for key, rect in regions.items():
            if not key.startswith(("action:", "equipment_refresh_pending:")):
                continue
            left, top, right, bottom = rect
            if left <= x <= right and top <= y <= bottom:
                return key
        for key, rect in regions.items():
            left, top, right, bottom = rect
            if left <= x <= right and top <= y <= bottom:
                return "prediction" if key == "prediction_marker" else key
        return ""

    def _layered_main_motion(self, event) -> None:
        if (
            not self._layered_main_active()
            or self.window_locked
        ):
            return
        region = self._layered_main_region_at(int(event.x), int(event.y))
        if self._startup_interaction_blocked() and region != "action:settings":
            region = ""
        action = region.removeprefix("action:") if region.startswith("action:") else ""
        cursor = (
            "sb_v_double_arrow"
            if region in {"resize:height", "scrollbar:rows"}
            or region.startswith("scrollbar:pvp_")
            else "fleur"
            if region == "drag:window"
            else "hand2"
            if action
            else "arrow"
        )
        if cursor != getattr(self, "layered_main_cursor", ""):
            try:
                self.root.configure(cursor=cursor)
                self.layered_main_cursor = cursor
                self._schedule_layered_main_render()
            except tk.TclError:
                pass
        if action != getattr(self, "layered_main_hover_action", ""):
            self.layered_main_hover_action = action
            self._schedule_layered_main_render()
        if region == "prediction":
            tooltip = getattr(self, "enrage_tooltip", None)
            if tooltip is None or not tooltip.winfo_exists():
                self._show_enrage_tooltip(event)
        else:
            self._hide_enrage_tooltip()

    def _layered_main_leave(self, _event=None) -> None:
        if getattr(self, "layered_main_hover_action", ""):
            self.layered_main_hover_action = ""
            self._schedule_layered_main_render()
        self._hide_enrage_tooltip()

    def _layered_main_press(self, event) -> None:
        if (
            not self._layered_main_active()
            or self.window_locked
        ):
            return
        region = self._layered_main_region_at(int(event.x), int(event.y))
        startup_blocked = self._startup_interaction_blocked()
        if startup_blocked and region != "action:settings":
            return
        self.layered_main_press_action = (
            region.removeprefix("action:") if region.startswith("action:") else ""
        )
        self.layered_main_press_origin = (int(event.x_root), int(event.y_root))
        self.layered_main_drag_armed = (
            not startup_blocked
            and region not in {"scrollbar:rows", "resize:height"}
            and not region.startswith("scroll:pvp_")
            and not region.startswith("scrollbar:pvp_")
            and not region.startswith("action:refresh_equipment:")
            and not region.startswith("equipment_refresh_pending:")
            and region not in {
                "action:pve",
                "action:pvp",
                "action:pvp_live",
                "action:pvp_team",
                "action:pve_recent_battle",
                "action:pve_team",
                "action:web_database",
            }
        )
        self.layered_main_scroll_drag_origin = None
        self.layered_main_pvp_scroll_drag_origin = None
        self.layered_main_dragged = False
        self.layered_main_resize_origin = None
        if region == "scrollbar:rows":
            snapshot = self._layered_main_snapshot()
            rows = snapshot.get("rows", ())
            visible_rows = max(
                1,
                int(snapshot.get("visible_rows", 1) or 1),
            )
            row_height = max(1, self._main_row_height())
            maximum_offset = max(
                0, row_height * (len(rows) - visible_rows)
            )
            scrollbar = getattr(
                self, "layered_main_hit_regions", {}
            ).get("scrollbar:rows")
            if maximum_offset and scrollbar is not None:
                _left, track_top, _right, track_bottom = scrollbar
                track_height = max(1, int(track_bottom - track_top))
                thumb_height = max(
                    1,
                    round(row_height * 12 / 75.4),
                    round(track_height * visible_rows / max(1, len(rows))),
                )
                travel = max(1, track_height - thumb_height)
                pointed_ratio = min(
                    1.0,
                    max(
                        0.0,
                        (int(event.y) - track_top - thumb_height / 2)
                        / travel,
                    ),
                )
                self.main_scroll_offset = round(
                    maximum_offset * pointed_ratio
                )
                self.main_scroll_content_height = row_height * len(rows)
                self.layered_main_scroll_drag_origin = (
                    int(event.y_root),
                    int(self.main_scroll_offset),
                    travel,
                    maximum_offset,
                )
                self._schedule_layered_main_render()
            return
        if region.startswith("scrollbar:pvp_") and region != "scrollbar:pvp_team":
            direction_name = region.removeprefix("scrollbar:pvp_")
            if direction_name in {"outgoing", "incoming", "allies", "enemies"}:
                snapshot = self._pvp_layered_main_snapshot()
                count = len(snapshot.get("pvp_" + direction_name, ()))
                maximum = max(0, count - 4)
                track = self.layered_main_hit_regions.get(region)
                if track is not None and maximum:
                    track_height = max(1, track[3] - track[1])
                    thumb_height = max(9, round(track_height * 4 / count))
                    travel = max(1, track_height - thumb_height)
                    ratio = max(0.0, min(1.0,
                        (int(event.y) - track[1] - thumb_height / 2) / travel
                    ))
                    offset = round(maximum * ratio)
                    setattr(self, "pvp_" + direction_name + "_offset", offset)
                    self.layered_main_pvp_scroll_drag_origin = (
                        direction_name, int(event.y_root), offset, travel, maximum
                    )
                    self._schedule_layered_main_render()
            return
        if region == "scrollbar:pvp_team":
            snapshot = self._layered_main_snapshot()
            count = max(0, len(snapshot.get("pvp_team_rows", ())))
            track = self.layered_main_hit_regions.get("scrollbar:pvp_team")
            league = snapshot.get("pvp_league_roster") or {}
            if league.get("raids"):
                selected = int(snapshot.get("pvp_league_selected_raid", 0) or 0)
                selected = selected or int(league.get("raid_number", 1) or 1)
                count = sum(
                    int(row.get("raid_number", 0) or 0) == selected
                    for row in snapshot.get("pvp_team_rows", ())
                )
                visible = max(1, max(12, int(snapshot.get("visible_rows", 12))) - 2)
                maximum = max(0, count - visible)
                if track is not None and maximum:
                    ratio = max(0.0, min(1.0, (int(event.y) - track[1]) / max(1, track[3] - track[1])))
                    self.pvp_team_offset = round(maximum * ratio)
                    self._schedule_layered_main_render()
                return
            count = min(PVP_MAX_TEAM_MEMBERS, count)
            pages = max(
                1,
                min(
                    PVP_MAX_TEAM_PAGES,
                    (count + PVP_TEAM_PAGE_SIZE - 1) // PVP_TEAM_PAGE_SIZE,
                ),
            )
            if track is not None:
                ratio = max(0.0, min(1.0, (int(event.y) - track[1]) / max(1, track[3] - track[1])))
                page = min(pages - 1, max(0, int(self.pvp_team_offset) // PVP_TEAM_PAGE_SIZE))
                page_start = page * PVP_TEAM_PAGE_SIZE
                page_count = min(PVP_TEAM_PAGE_SIZE, max(0, count - page_start))
                visible = max(1, max(12, int(snapshot.get("visible_rows", 12))) - 2)
                maximum = max(0, page_count - visible)
                self.pvp_team_offset = page_start + round(maximum * ratio)
                self._schedule_layered_main_render()
            return
        if region == "resize:height":
            self.layered_main_resize_origin = (
                int(event.y_root),
                int(getattr(self, "layered_main_visible_rows", 1)),
                self._main_row_height(),
            )
            self._hide_enrage_tooltip()
            return
        if self.layered_main_drag_armed:
            self._drag_start(event, self.root)

    def _layered_main_drag(self, event) -> None:
        origin = getattr(self, "layered_main_press_origin", None)
        if (
            origin is None
            or self.window_locked
            or self._startup_interaction_blocked()
        ):
            return
        resize = getattr(self, "layered_main_resize_origin", None)
        if resize is not None:
            y, rows, row_height = resize
            capacity = clamp_visible_rows(rows + int(round((int(event.y_root) - y) / max(1, row_height))))
            if getattr(self, "main_combat_mode", "pve") == "pvp":
                capacity = max(12, capacity)
                if capacity != getattr(self, "pvp_visible_rows", HUD_DEFAULT_VISIBLE_ROWS):
                    self.pvp_visible_rows = capacity
                    self._schedule_layered_main_render()
                return
            if capacity != getattr(
                self, "main_visible_rows", HUD_DEFAULT_VISIBLE_ROWS
            ):
                self.main_visible_rows = capacity
                self._schedule_layered_main_render()
            return
        pvp_scroll_drag = getattr(
            self, "layered_main_pvp_scroll_drag_origin", None
        )
        if pvp_scroll_drag is not None:
            direction_name, origin_y, origin_offset, travel, maximum = pvp_scroll_drag
            next_offset = max(0, min(maximum, origin_offset + round(
                (int(event.y_root) - origin_y) * maximum / max(1, travel)
            )))
            offset_name = "pvp_" + direction_name + "_offset"
            if next_offset != getattr(self, offset_name, 0):
                setattr(self, offset_name, next_offset)
                self._schedule_layered_main_render()
            return
        scroll_drag = getattr(
            self, "layered_main_scroll_drag_origin", None
        )
        if scroll_drag is not None:
            origin_y, origin_offset, travel, maximum_offset = scroll_drag
            next_offset = min(
                maximum_offset,
                max(
                    0,
                    origin_offset
                    + round(
                        (int(event.y_root) - origin_y)
                        * maximum_offset
                        / max(1, travel)
                    ),
                ),
            )
            if next_offset != getattr(self, "main_scroll_offset", 0):
                self.main_scroll_offset = next_offset
                self._schedule_layered_main_render()
            return
        if not getattr(self, "layered_main_drag_armed", False):
            return
        delta_x = int(event.x_root) - origin[0]
        delta_y = int(event.y_root) - origin[1]
        if (
            delta_x * delta_x + delta_y * delta_y
            >= LAYERED_MAIN_DRAG_THRESHOLD * LAYERED_MAIN_DRAG_THRESHOLD
        ):
            self.layered_main_dragged = True
        if self.layered_main_dragged:
            self._drag_move(event, self.root)

    def _layered_main_release(self, event) -> None:
        if (
            not self._layered_main_active()
            or self.window_locked
        ):
            return
        pressed = str(getattr(self, "layered_main_press_action", "") or "")
        if self._startup_interaction_blocked() and pressed != "settings":
            return
        dragged = bool(getattr(self, "layered_main_dragged", False))
        drag_armed = bool(getattr(self, "layered_main_drag_armed", False))
        self.layered_main_press_action = ""
        self.layered_main_press_origin = None
        self.layered_main_drag_armed = False
        self.layered_main_dragged = False
        if getattr(self, "layered_main_scroll_drag_origin", None) is not None:
            self.layered_main_scroll_drag_origin = None
            self._schedule_layered_main_render()
            return
        if getattr(self, "layered_main_pvp_scroll_drag_origin", None) is not None:
            self.layered_main_pvp_scroll_drag_origin = None
            self._schedule_layered_main_render()
            return
        if getattr(self, "layered_main_resize_origin", None) is not None:
            self.layered_main_resize_origin = None
            if getattr(self, "main_combat_mode", "pve") != "pvp":
                self.config[MAIN_VISIBLE_ROWS_CONFIG_KEY] = clamp_visible_rows(
                    getattr(self, "main_visible_rows", HUD_DEFAULT_VISIBLE_ROWS)
                )
                save_config(self.config)
            self._schedule_layered_main_render()
            return
        if drag_armed:
            self._drag_end(event, self.root)
        if not pressed:
            if drag_armed:
                self._schedule_layered_main_render()
            return
        released = self._layered_main_region_at(int(event.x), int(event.y))
        footer_action = pressed in {"pve", "settings", "lock", "pin"}
        if dragged or (
            released != f"action:{pressed}" and not footer_action
        ):
            return
        if pressed.startswith("refresh_equipment:"):
            self._schedule_team_equipment_profiles(
                refresh_token=pressed.removeprefix("refresh_equipment:")
            )
            self._schedule_layered_main_render()
        elif pressed == "pvp_live":
            self._set_pvp_hud_view("live")
        elif pressed == "pvp_team":
            self._set_pvp_hud_view("team")
        elif pressed.startswith("pvp_team_page_"):
            try:
                page = int(pressed.removeprefix("pvp_team_page_"))
            except ValueError:
                return
            tracker = getattr(getattr(self, "pvp_recording", None), "display_tracker", None)
            league = getattr(tracker, "pvp_league_roster", {}) or {}
            raids = league.get("raids", {})
            if raids:
                numbers = sorted({int(raid.get("number", 0) or 0) for raid in raids.values()})
                if 0 <= page < len(numbers):
                    self.pvp_league_selected_raid = numbers[page]
                self.pvp_team_offset = 0
            else:
                self.pvp_team_offset = min(
                    PVP_MAX_TEAM_PAGES - 1,
                    max(0, page),
                ) * PVP_TEAM_PAGE_SIZE
            self._schedule_layered_main_render()
        elif pressed == "pve_recent_battle":
            self._set_pve_hud_view("recent_battle")
        elif pressed == "pve_team":
            self._set_pve_hud_view("team")
        elif pressed == "web_database":
            webbrowser.open(WEB_DATABASE_URL, new=2)
        elif pressed == "pvp":
            self._set_main_combat_mode("pvp")
        elif pressed == "pve":
            self._set_main_combat_mode("pve")
        elif pressed == "settings":
            if not SETTINGS_TEMPORARILY_DISABLED:
                self.show_settings()
        elif pressed == "clear":
            if not self._main_clear_blocked():
                self._clear_main_display()
        elif pressed == "pin":
            self.toggle_topmost()
        elif pressed == "lock":
            self.toggle_window_lock()
        elif pressed == "close":
            self._request_close()

    def _sync_main_component_visibility(self) -> None:
        """Apply display toggles without rebuilding or restarting the meter."""

        if self._layered_main_active():
            self._hide_enrage_tooltip()
            self._schedule_layered_main_render()
            return

        if bool(getattr(self, "show_combat_time", True)):
            self.titlebar.configure(height=self._main_px(MAIN_TITLE_HEIGHT))
            if not self.titlebar.winfo_manager():
                before = (
                    self.summary
                    if self.summary.winfo_manager()
                    else self.table_panel
                )
                self.titlebar.pack(fill="x", before=before)
            if not self.time_value.winfo_manager():
                self.time_value.pack(side="left", anchor="w")
        else:
            self.time_value.pack_forget()
            self.titlebar.pack_forget()

        if bool(getattr(self, "show_boss_hp_bar", True)):
            self.summary.configure(height=self._main_px(MAIN_BOSS_HEIGHT))
            if not self.summary.winfo_manager():
                self.summary.pack(fill="x", before=self.table_panel)
        else:
            self.summary.pack_forget()
            self._hide_enrage_tooltip()

        if bool(getattr(self, "show_team_dps", True)):
            if not self.team_dps_group.winfo_manager():
                self.team_dps_group.pack(side="left", fill="y")
        else:
            self.team_dps_group.pack_forget()

        if bool(getattr(self, "show_pvp_button", True)):
            if not self.pvp_button.winfo_manager():
                self.pvp_button.pack(
                    side="left", fill="y", before=self.settings_button
                )
        else:
            self.pvp_button.pack_forget()

    def _refresh_main_scale_layout(self) -> None:
        self.titlebar.configure(height=self._main_px(MAIN_TITLE_HEIGHT))
        if isinstance(self.time_value, tk.Canvas):
            self.time_value.configure(
                width=self._main_px(66),
                height=self._main_px(MAIN_TITLE_HEIGHT),
            )
            self._draw_main_time_value()
        if isinstance(getattr(self, "team_dps_caption", None), tk.Canvas):
            self.team_dps_caption.configure(
                width=self._main_px(145),
                height=self._main_px(MAIN_FOOTER_HEIGHT),
            )
            self._draw_team_dps_value()
        self.summary.configure(height=self._main_px(MAIN_BOSS_HEIGHT))
        self.monster_hp_canvas.configure(height=self._main_px(MAIN_BOSS_HEIGHT))
        self.footer.configure(height=self._main_px(MAIN_FOOTER_HEIGHT))
        for button in (
            self.pvp_button,
            self.settings_button,
            self.pin_button,
            self.lock_button,
            self.close_button,
        ):
            button.configure(
                width=self._main_px(MAIN_ACTION_SIZE),
                height=self._main_px(MAIN_ACTION_SIZE),
            )
            self._sync_main_icon_button_visual(button)
        logo_size = max(20, int(round(27 * self.main_ui_scale)))
        logo_image = self.icons.app_logo(logo_size)
        self.main_logo.configure(image=logo_image)
        self.main_logo.image = logo_image
        self.resize_grip.place_configure(
            width=self._main_px(10), height=self._main_px(10)
        )
        self.root.minsize(self._main_minimum_width(), MAIN_MIN_HEIGHT)
        if self._layered_main_active():
            self.root.minsize(1, 1)
            self._schedule_layered_main_render()

    def _sync_main_content_height(self, row_count: int) -> None:
        """Keep Boss, rows, and footer touching with no opaque dead region."""

        if self._layered_main_active():
            return

        visible_rows = max(1, min(MAIN_MAX_VISIBLE_ROWS, int(row_count or 0)))
        rows_height = visible_rows * self._main_row_height()
        try:
            if int(self.rows_canvas.cget("height")) != rows_height:
                self.rows_canvas.configure(height=rows_height)
        except (AttributeError, TypeError, ValueError, tk.TclError):
            pass

        title_height = (
            self._main_px(MAIN_TITLE_HEIGHT)
            if bool(getattr(self, "show_combat_time", True))
            else 0
        )
        boss_height = (
            self._main_px(MAIN_BOSS_HEIGHT)
            if bool(getattr(self, "show_boss_hp_bar", True))
            else 0
        )
        footer_height = self._main_px(MAIN_FOOTER_HEIGHT)
        target_height = max(
            MAIN_MIN_HEIGHT,
            title_height + boss_height + rows_height + footer_height,
        )
        try:
            if id(self.root) in getattr(self, "resize_state", {}):
                return
            width = max(self._main_minimum_width(), self.root.winfo_width())
            if abs(self.root.winfo_height() - target_height) > 1:
                self.root.geometry(f"{width}x{target_height}")
        except (AttributeError, TypeError, ValueError, tk.TclError):
            return

