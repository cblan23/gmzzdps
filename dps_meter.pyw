        elif healing_mode:
            captions = {
                "effective": "有效" if compact else "有效治疗",
                "hps": "HPS",
                "overheal": "过量" if compact else "过量率",
            }
        elif taken_mode:
            captions = {
                "taken": "承伤" if compact else "总承伤",
                "taken_share": "占比" if compact else "承伤占比",
            }
        else:
            captions = (
                {
                    "damage": "伤害",
                    "dps": "DPS",
                    "share": "占比",
                    "critical": "暴击",
                    "penetration": "穿刺",
                    "deaths": "死亡",
                    "revives": "复活",
                    "death_time": "死时",
                }
                if compact
                else {
                    "damage": "总伤害",
                    "dps": "秒伤",
                    "share": "占比",
                    "critical": "暴击率",
                    "penetration": "穿刺率",
                    "deaths": "死亡",
                    "revives": "复活",
                    "death_time": "死亡时间",
                }
            )
        canvas.create_text(
            34 if compact else 42,
            14,
            text=("技能" if compact else "首领技能") if boss_mode else (
