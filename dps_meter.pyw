    def _fit_login_window(self) -> None:
        """Keep the login action inside the visible, DPI-scaled toplevel."""

        window = self.login_window
        if self.closing or window is None or not window.winfo_exists():
            return
        try:
            window.update_idletasks()
            dpi = get_window_dpi(window)
            base_width, base_height = login_window_dimensions(
                dpi, self.process_is_elevated
            )
            width = max(base_width, int(window.winfo_reqwidth()))
            height = max(base_height, int(window.winfo_reqheight()))
            parsed = parse_absolute_tk_geometry(window.geometry())
            if parsed is None:
                x = max(0, (window.winfo_screenwidth() - width) // 2)
                y = max(0, (window.winfo_screenheight() - height) // 2)
            else:
                _old_width, _old_height, x, y = parsed
            areas = self._monitor_work_areas()
            area = next(
                (
                    candidate
                    for candidate in areas
                    if candidate[0] <= x < candidate[2]
                    and candidate[1] <= y < candidate[3]
                ),
                areas[0]
                if areas
                else (0, 0, window.winfo_screenwidth(), window.winfo_screenheight()),
            )
            left, top, right, bottom = area
            width = min(width, max(1, right - left))
            height = min(height, max(1, bottom - top))
            x = min(max(x, left), right - width)
            y = min(max(y, top), bottom - height)
            geometry = format_absolute_tk_geometry(width, height, x, y)
            if window.geometry() != geometry:
                window.geometry(geometry)
                window.update_idletasks()
        except (AttributeError, RuntimeError, TypeError, ValueError, tk.TclError):
            return

    def _finish_login_window_presentation(
        self, window: tk.Misc, activate: bool
    ) -> None:
        if self.closing or not window.winfo_exists():
            return
        # ``WS_EX_NOACTIVATE`` is used only while an expired session returns to
        # this window.  Clear it after the map so the user can interact with the
        # login page normally when they choose it from the taskbar.
        self._sync_login_window_taskbar(window, no_activate=False)
        self._set_window_topmost_noactivate(window, False)
        if activate:
            window.lift()

    def _minimize_login_window(self) -> None:
        window = self.login_window
        if self.closing or window is None or not window.winfo_exists():
            return
        try:
            window.grab_release()
        except tk.TclError:
            pass
        if sys.platform == "win32":
            try:
                import ctypes
                from ctypes import wintypes

                hwnd = self._win32_root_handle(window)
                if hwnd:
                    user32 = ctypes.WinDLL("user32", use_last_error=True)
                    show_window = user32.ShowWindow
                    show_window.argtypes = (wintypes.HWND, ctypes.c_int)
                    show_window.restype = wintypes.BOOL
                    show_window(hwnd, 6)  # SW_MINIMIZE
                    return
            except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
                pass
        # An override-redirect window cannot be iconified on every Tk build.
        # With no native taskbar support available, hiding it keeps the login
        # page reachable from the tray without leaving it over another game.
        window.withdraw()

