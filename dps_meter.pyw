    def _sync_main_meter_tabs(self) -> None:
        for mode, (tab, label, indicator) in getattr(
            self, "footer_tabs", {}
        ).items():
            selected = mode == getattr(self, "main_meter_mode", "dps")
            background = PANEL_2 if selected else BG
            tab.configure(bg=background)
            label.configure(
                bg=background,
                fg=ACCENT if selected else TEXT,
                font=self._ui_font("strong" if selected else "body"),
            )
            indicator.configure(bg=ACCENT if selected else BG)

    def _set_main_meter_mode(self, mode: str) -> None:
        mode = str(mode or "").casefold()
        if mode not in {"dps", "hps", "dt", "boss"} or mode == self.main_meter_mode:
            return
        self.main_meter_mode = mode
        self.skill_panel_mode = "healing" if mode == "hps" else "damage"
        self.main_scroll_offset = 0
        self.main_scroll_content_height = 0
        self.config["main_meter_mode"] = mode
        self._sync_main_meter_tabs()
        self.root.minsize(
            self._main_minimum_width(),
            MINI_MIN_HEIGHT if self.compact_mode else MAIN_MIN_HEIGHT,
        )
        self._sync_compact_geometry_width()
        self._draw_main_header()
        self._draw_main_rows()
        self._render_skill_details()
        if self._main_content_overlay_requested():
            self._schedule_main_content_overlay_sync()
        else:
            self._hide_main_content_overlay()
        save_config(self.config)

    def _main_icon_button(
        self, parent: tk.Misc, icon_name: str, description: str, command
    ) -> tk.Label:
        tile_size = max(24, int(round(MAIN_ACTION_SIZE * self.main_ui_scale)))
        main_action_icon = getattr(self.icons, "main_action", None)
        image = (
            main_action_icon(icon_name, tile_size, TEXT)
            if callable(main_action_icon)
            else self.icons.toolbar(icon_name, max(14, tile_size - 10), TEXT)
        )
        label = tk.Label(
            parent,
            image=image,
            bg=MAIN_TRANSPARENT_KEY,
            width=self._main_px(MAIN_ACTION_SIZE),
            height=self._main_px(MAIN_ACTION_SIZE),
            bd=0,
            cursor="hand2",
        )
        label.image = image
        label._disabled = False
        label._description = description
        label._icon_name = icon_name
        label._normal_color = TEXT
        label._hovered = False
        label.bind(
            "<Enter>",
            lambda _event: self._main_icon_enter(label),
        )
        label.bind(
            "<Leave>",
            lambda _event: self._main_icon_leave(label),
        )
        label.bind(
            "<ButtonRelease-1>",
            lambda event: self._fallback_main_icon_release(event, label, command),
        )
        return label

    def _fallback_main_press(self, event) -> None:
        startup_blocked = self._startup_interaction_blocked()
        settings_button = getattr(self, 'settings_button', None)
        settings_press = (
            settings_button is not None
            and getattr(event, 'widget', None) is settings_button
        )
        if (self._layered_main_active() or self.window_locked
                or (startup_blocked and not settings_press)
                or id(self.root) in self.resize_state):
            return
        self.main_fallback_press_origin = (int(event.x_root), int(event.y_root))
        self.main_fallback_dragged = False
        if not startup_blocked:
            self._drag_start(event, self.root)

    def _fallback_main_drag(self, event) -> None:
        origin = getattr(self, 'main_fallback_press_origin', None)
        if (self._layered_main_active() or origin is None or self.window_locked
                or self._startup_interaction_blocked()
                or id(self.root) in self.resize_state):
            return
        dx, dy = int(event.x_root) - origin[0], int(event.y_root) - origin[1]
        if dx * dx + dy * dy >= LAYERED_MAIN_DRAG_THRESHOLD ** 2:
            self.main_fallback_dragged = True
        if self.main_fallback_dragged:
            self._drag_move(event, self.root)

    def _fallback_main_release(self, event) -> None:
        if self._layered_main_active():
            return
        self._drag_end(event, self.root)
        self.main_fallback_press_origin = None
        self.main_fallback_dragged = False

    def _fallback_main_icon_release(self, event, label, command) -> None:
        if (self.window_locked
                or (self._startup_interaction_blocked()
                    and label is not getattr(self, 'settings_button', None))
                or getattr(label, '_disabled', False)
                or getattr(self, 'main_fallback_dragged', False)):
            return
        origin = getattr(self, 'main_fallback_press_origin', None)
        if origin is None:
            return
        dx, dy = int(event.x_root) - origin[0], int(event.y_root) - origin[1]
        if dx * dx + dy * dy >= LAYERED_MAIN_DRAG_THRESHOLD ** 2:
            return
        if not (0 <= event.x < label.winfo_width() and 0 <= event.y < label.winfo_height()):
            return
        self._hide_main_tooltip()
        command()

    def _render_main_icon_button(
        self,
        button: tk.Label,
        color: str,
        background: str = MAIN_TRANSPARENT_KEY,
    ) -> None:
        del background
        tile_size = max(
            24,
            int(
                round(
                    MAIN_ACTION_SIZE
                    * float(getattr(self, "main_ui_scale", 1.0) or 1.0)
                )
            ),
        )
        main_action_icon = getattr(self.icons, "main_action", None)
        image = (
            main_action_icon(
                button._icon_name,
                tile_size,
                color,
                hovered=(
                    bool(getattr(button, "_hovered", False))
                    and not bool(getattr(button, "_disabled", False))
                ),
            )
            if callable(main_action_icon)
            else self.icons.toolbar(
                button._icon_name, max(14, tile_size - 10), color
            )
        )
        button.configure(image=image, bg=MAIN_TRANSPARENT_KEY)
        button.image = image

    def _sync_main_icon_button_visual(self, button: tk.Label) -> None:
        hovered = bool(getattr(button, "_hovered", False)) and not bool(
            getattr(button, "_disabled", False)
        )
        self._render_main_icon_button(
            button,
            ACCENT if hovered else button._normal_color,
            "#18232d" if hovered else MAIN_TRANSPARENT_KEY,
        )

    def _main_icon_enter(self, button: tk.Label) -> None:
        button._hovered = True
        self._sync_main_icon_button_visual(button)
        self._hide_main_tooltip()
        if str(getattr(button, "_description", "") or "").strip():
            self.main_tooltip_after_id = self.root.after(
                450,
                lambda target=button: self._show_main_tooltip(target),
            )

    def _main_icon_leave(self, button: tk.Label) -> None:
        button._hovered = False
        self._hide_main_tooltip()
        self._sync_main_icon_button_visual(button)

    def _show_main_tooltip(self, button: tk.Label) -> None:
        self.main_tooltip_after_id = None
        if (
            not bool(getattr(button, "_hovered", False))
            or not button.winfo_exists()
            or self.closing
        ):
            return
        description = str(getattr(button, "_description", "") or "").strip()
        if not description:
            return
        try:
            popup = tk.Toplevel(self.root)
            self.main_tooltip = popup
            popup.withdraw()
            popup.overrideredirect(True)
            popup.configure(bg="#28465d")
            popup.transient(self.root)
            body = tk.Label(
                popup,
                text=description,
                bg="#101923",
                fg="#e8eef5",
                padx=9,
                pady=5,
                bd=0,
                font=self._ui_font("main_micro"),
            )
            body.pack(fill="both", expand=True, padx=1, pady=1)
            popup.update_idletasks()
            popup_width = popup.winfo_reqwidth()
            popup_height = popup.winfo_reqheight()
            x, y = help_popup_position(
                button.winfo_rootx(),
                button.winfo_rooty(),
                button.winfo_width(),
                button.winfo_height(),
                popup_width,
                popup_height,
                monitor_work_area_for_widget(button),
            )
            popup.geometry(
                format_absolute_tk_geometry(
                    popup_width, popup_height, x, y
                )
            )
            popup.deiconify()
            self._set_window_topmost_noactivate(
                popup, self._preferred_main_topmost() or self.window_locked
            )
        except (AttributeError, tk.TclError):
            self._hide_main_tooltip()

    def _hide_main_tooltip(self) -> None:
        if getattr(self, "main_tooltip_after_id", None) is not None:
            try:
                self.root.after_cancel(self.main_tooltip_after_id)
            except tk.TclError:
                pass
            self.main_tooltip_after_id = None
        tooltip = getattr(self, "main_tooltip", None)
        if tooltip is not None and tooltip.winfo_exists():
            tooltip.destroy()
        self.main_tooltip = None

    def _request_close(self) -> None:
        """Ask before entering the existing safe capture shutdown path."""

        if self.closing:
            return
        self._hide_main_tooltip()
        self._show_notice(
            "退出程序",
            "退出前会安全停止采集，并保存当前战斗数据。\n确定退出叨叨诡秘助手吗？",
            parent=self.root,
            confirm_text="退出",
            cancel_text="取消",
            on_confirm=self.close,
        )

    def _destroy_main_content_overlay(self) -> None:
        if self.main_content_overlay_sync_after_id is not None:
            try:
                self.root.after_cancel(self.main_content_overlay_sync_after_id)
            except tk.TclError:
                pass
            self.main_content_overlay_sync_after_id = None
        window = self.main_content_overlay_window
        if window is not None and window.winfo_exists():
            window.destroy()
        self.main_content_overlay_window = None
        self.main_content_overlay_rows = None
        self.main_content_overlay_root_geometry = None
        self.main_content_overlay_click_through_ready = False
        self.main_content_overlay_topmost = None

    def _main_content_overlay_requested(self) -> bool:
        # Schema v1 removed DPS bars, so the legacy opaque-bar HWND must never
        # be created even when an upgraded config still stores the old flag.
        return False

    def _hide_main_content_overlay(self) -> None:
        self.main_content_overlay_root_geometry = None
        window = getattr(self, "main_content_overlay_window", None)
        if window is not None and window.winfo_exists():
            try:
                window.withdraw()
            except tk.TclError:
                pass

    def _ensure_main_content_overlay(self) -> bool:
        if not self.main_content_overlay_supported:
            return False
        window = self.main_content_overlay_window
        if window is not None and window.winfo_exists():
            return True
        try:
            window = tk.Toplevel(self.root)
            window.withdraw()
            self._prepare_toplevel_dpi(window)
            window.title(f"{UI_BRAND} · 前景内容")
            window.configure(bg=MAIN_CONTENT_OVERLAY_KEY)
            window.overrideredirect(True)
            window.transient(self.root)
            window.attributes("-alpha", DPS_BAR_COLOR_STRENGTH)
            window.attributes("-transparentcolor", MAIN_CONTENT_OVERLAY_KEY)
            self.main_content_overlay_window = window
            self.main_content_overlay_rows = tk.Canvas(
                window,
                bg=MAIN_CONTENT_OVERLAY_KEY,
                bd=0,
                highlightthickness=0,
                yscrollincrement=1,
            )
            window.update_idletasks()
            hwnd = self._win32_root_handle(window)
            style = self._win32_extended_style(hwnd)
            if style is None or not self._set_win32_extended_style(
                hwnd,
                style
                | WINDOW_EXSTYLE_TRANSPARENT
                | WINDOW_EXSTYLE_TOOLWINDOW
                | WINDOW_EXSTYLE_LAYERED
                | WINDOW_EXSTYLE_NOACTIVATE,
            ):
                raise tk.TclError("could not configure the content overlay")
            self.main_content_overlay_click_through_ready = True
            return True
        except (AttributeError, OSError, tk.TclError):
            self.main_content_overlay_supported = False
            self._destroy_main_content_overlay()
            return False

    def _schedule_main_content_overlay_sync(self, *, restart: bool = False) -> None:
        if self.closing or not self.main_content_overlay_supported:
            return
        if not self._main_content_overlay_requested():
            self._hide_main_content_overlay()
            return
        if self.main_content_overlay_sync_after_id is not None:
            if not restart:
                return
            try:
                self.root.after_cancel(self.main_content_overlay_sync_after_id)
            except tk.TclError:
                pass
            self.main_content_overlay_sync_after_id = None
        try:
            self.main_content_overlay_sync_after_id = self.root.after(
                16,
                self._sync_main_content_overlay
            )
        except tk.TclError:
            self.main_content_overlay_sync_after_id = None

    @staticmethod
    def _place_overlay_canvas(
        canvas: tk.Canvas,
        source: tk.Misc,
        root_x: int,
        root_y: int,
    ) -> bool:
        if not source.winfo_ismapped():
            canvas.place_forget()
            return False
        width = max(1, source.winfo_width())
        height = max(1, source.winfo_height())
        canvas.place(
            x=source.winfo_rootx() - root_x,
            y=source.winfo_rooty() - root_y,
            width=width,
            height=height,
        )
        return True

    def _main_content_overlay_layout(
        self,
    ) -> tuple[tuple[int, ...], tuple[int, int, int, int]] | None:
        source = self.rows_canvas
        if not source.winfo_ismapped():
            return None
        root_geometry = (
            self.root.winfo_rootx(),
            self.root.winfo_rooty(),
            max(1, self.root.winfo_width()),
            max(1, self.root.winfo_height()),
        )
        content_geometry = (
            source.winfo_rootx(),
            source.winfo_rooty(),
            max(1, source.winfo_width()),
            max(1, source.winfo_height()),
        )
        bounds = clipped_overlay_bounds(*root_geometry, *content_geometry)
        if bounds is None:
            return None
        return (*root_geometry, *content_geometry), bounds

    def _sync_main_content_overlay(self) -> None:
        self.main_content_overlay_sync_after_id = None
        if self.closing or not self.root.winfo_exists():
            self._destroy_main_content_overlay()
            return
        if (
            not self._main_content_overlay_requested()
            or self.root.state() != "normal"
        ):
            self._hide_main_content_overlay()
            return
        if not self._ensure_main_content_overlay():
            # Overlay creation can be unavailable on a particular Windows
            # build.  Restore the ordinary translucent rows immediately.
            self._draw_main_rows_on_canvas(
                self.rows_canvas, update_scroll_state=True
            )
            return
        window = self.main_content_overlay_window
        rows_canvas = self.main_content_overlay_rows
        if window is None or rows_canvas is None:
            return
        try:
            self.root.update_idletasks()
            layout = self._main_content_overlay_layout()
            if layout is None:
                self._hide_main_content_overlay()
                self._draw_main_rows_on_canvas(
                    self.rows_canvas, update_scroll_state=True
                )
                return
            geometry_signature, overlay_bounds = layout
            overlay_x, overlay_y, overlay_width, overlay_height = overlay_bounds
            if geometry_signature != self.main_content_overlay_root_geometry:
                # Never leave the old top-level visible while its owner is
                # moving or changing layout. A stale independent HWND is the
                # source of duplicate bars seen outside the meter.
                if window.state() == "normal":
                    window.withdraw()
                self._set_main_content_overlay_bounds(
                    window,
                    overlay_width,
                    overlay_height,
                    overlay_x,
                    overlay_y,
                )
                self.main_content_overlay_root_geometry = geometry_signature
            overlay_topmost = bool(self.root.attributes("-topmost"))
            if overlay_topmost != self.main_content_overlay_topmost:
                if self._set_window_topmost_noactivate(window, overlay_topmost):
                    self.main_content_overlay_topmost = overlay_topmost
            rows_visible = self._place_overlay_canvas(
                rows_canvas, self.rows_canvas, overlay_x, overlay_y
            )
            window.update_idletasks()
            if rows_visible:
                self._draw_main_rows_on_canvas(
                    self.rows_canvas,
                    update_scroll_state=True,
                    draw_bars=False,
                )
                self._draw_main_rows_on_canvas(
                    rows_canvas,
                    update_scroll_state=False,
                    draw_content=False,
                    opaque_bar_layer=True,
                )
            else:
                self._hide_main_content_overlay()
                self._draw_main_rows_on_canvas(
                    self.rows_canvas, update_scroll_state=True
                )
                return
            if window.state() != "normal":
                window.deiconify()
        except tk.TclError:
            if window.winfo_exists():
                window.withdraw()
            self._draw_main_rows_on_canvas(
                self.rows_canvas, update_scroll_state=True
            )

    def _main_window_configure(self, event) -> None:
        if event.widget is not self.root:
            return
        # A Configure event is delivered immediately during a cross-monitor
        # move.  The periodic check remains as a fallback for borderless
        # windows that do not emit a second event after Windows repositions
        # them for the new DPI.
        try:
            dpi = get_window_dpi(self.root)
            if dpi != getattr(self, "window_dpi", 0):
                self._apply_window_dpi_if_changed()
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            pass
        self._sync_titlebar_density(int(event.width))
        geometry_signature = (
            self.root.winfo_rootx(),
            self.root.winfo_rooty(),
            int(event.width),
            int(event.height),
        )
        cached_geometry = self.main_content_overlay_root_geometry
        cached_root_geometry = (
            cached_geometry[:4] if cached_geometry is not None else None
        )
        if geometry_signature != cached_root_geometry:
            overlay = self.main_content_overlay_window
            if (
                self._main_content_overlay_requested()
                and overlay is not None
                and overlay.winfo_exists()
            ):
                try:
                    overlay.withdraw()
                except tk.TclError:
                    pass
            self.main_content_overlay_root_geometry = None
            self._schedule_main_content_overlay_sync(restart=True)
        if self.window_locked:
            self._sync_unlock_window_position()

    def _main_rows_canvas_configure(self, _event=None) -> None:
        # The canvas can move within an unchanged top-level when compact mode,
        # title density, or DPI changes. Invalidate the independent overlay
        # immediately so it cannot remain at the previous screen position.
        overlay = getattr(self, "main_content_overlay_window", None)
        if (
            self._main_content_overlay_requested()
            and overlay is not None
            and overlay.winfo_exists()
        ):
            try:
                overlay.withdraw()
            except tk.TclError:
                pass
        self.main_content_overlay_root_geometry = None
        self._draw_main_rows()
        self._schedule_main_content_overlay_sync(restart=True)

    def _main_window_map_state(self, event) -> None:
        if event.widget is not self.root:
            return
        event_type = getattr(event, "type", "")
        event_name = str(getattr(event_type, "name", event_type)).casefold()
        if event_name in {"unmap", "18"}:
            overlay = self.main_content_overlay_window
            if overlay is not None and overlay.winfo_exists():
                try:
                    overlay.withdraw()
                except tk.TclError:
                    pass
            self.main_content_overlay_root_geometry = None
            if not self.main_window_intentionally_hidden:
                self.root.after(80, self._recover_accidentally_iconified_main_window)
            return
        try:
            # A withdrawn root can only provide a provisional monitor DPI.
            # Rebuild the named fonts immediately once the real HWND is mapped,
            # before the alpha foreground helper paints its first frame.
            self._apply_window_dpi_if_changed(force=True)
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            pass
        self.main_content_overlay_root_geometry = None
        self._schedule_main_content_overlay_sync()

    def _recover_accidentally_iconified_main_window(self) -> None:
        if (
            self.closing
            or self.main_window_intentionally_hidden
            or not self.root.winfo_exists()
        ):
            return
        try:
            if self.root.state() != "iconic":
                return
            self.root.overrideredirect(True)
            self.root.deiconify()
            self.root.update_idletasks()
            self._apply_window_dpi_if_changed(force=True)
            self._apply_windows_style(self.root)
            self._apply_main_transparency()
            self.root.lift()
            self.root.after(20, self._apply_window_lock_state)
        except (AttributeError, tk.TclError):
            pass

    def _sync_titlebar_density(self, width: int | None = None) -> None:
        # Schema v1 has no responsive title copy or mode tabs to reveal.
        return

    def _apply_layout_mode(self) -> None:
        self._hide_main_tooltip()
        self.compact_mode = False
        self.config["compact_mode"] = False
        self.root.minsize(self._main_minimum_width(), MAIN_MIN_HEIGHT)
        if self._layered_main_active():
            self.root.minsize(1, 1)
        self._sync_main_component_visibility()
        self.resize_grip.lift()
        self._draw_main_header()
        self._draw_main_rows()
        self._sync_action_buttons()
        self.root.after(10, self._apply_main_transparency)

    def _dismiss_compact_auxiliary_windows(self) -> None:
        self._close_notice_window()
        for attribute in (
            "skill_window",
            "history_window",
            "feedback_window",
        ):
            window = getattr(self, attribute, None)
            if window is not None and window.winfo_exists():
                window.withdraw()

    def _remember_root_geometry(self) -> None:
        geometry = self.restore_geometry.get(id(self.root), self.root.geometry())
        self.config["geometry"] = geometry
        self.config["compact_mode"] = False
        self.config["window_locked"] = self.window_locked

    def _sync_compact_geometry_width(self) -> None:
        return

    def toggle_compact_mode(self) -> None:
        # Kept for old call sites and downgrade compatibility. There is no
        # mini-mode transition in the current product.
        self.compact_mode = False
        self.config["compact_mode"] = False

    def _metric(self, parent: tk.Misc, caption: str, value: str, column: int) -> tk.Label:
        frame = tk.Frame(parent, bg=BG)
        frame.grid(row=0, column=column, sticky="nsew", padx=(0 if column == 0 else 4, 0))
        parent.grid_columnconfigure(column, weight=1)
        tk.Label(
            frame,
            text=caption,
            bg=BG,
            fg=MUTED,
            anchor="w",
            font=tk_font_spec("Microsoft YaHei UI", 7, "bold"),
        ).pack(side="left", fill="y", padx=(5, 5))
        label = tk.Label(
            frame,
            text=value,
            bg=BG,
            fg=TEXT,
            anchor="w",
            font=tk_font_spec(self.ui_font_family, 9, "bold"),
        )
        label.pack(side="left", fill="both", expand=True)
        return label

    @staticmethod
    def _action_button(parent: tk.Misc, text: str, command) -> tk.Label:
        label = tk.Label(
            parent,
            text=text,
            bg=PANEL_2,
            fg=MUTED,
            padx=4,
            pady=2,
            cursor="hand2",
            font=tk_font_spec("Microsoft YaHei UI", 7, "bold"),
        )
        label._disabled = False
        label._normal_bg = PANEL_2
        label._normal_fg = MUTED
        label._hover_bg = blend_color(PANEL_2, ACCENT, 0.13)
        label._hover_fg = TEXT
        label.bind(
            "<Enter>",
            lambda _event: (
                None
                if getattr(label, "_disabled", False)
                else label.configure(
                    bg=getattr(label, "_hover_bg", PANEL_2),
                    fg=getattr(label, "_hover_fg", TEXT),
                )
            ),
        )
        label.bind(
            "<Leave>",
            lambda _event: label.configure(
                bg=getattr(label, "_normal_bg", PANEL_2),
                fg=(
                    "#4e5862"
                    if getattr(label, "_disabled", False)
                    else getattr(label, "_normal_fg", MUTED)
                ),
            ),
        )
        label.bind(
            "<Button-1>",
            lambda _event: (
                None if getattr(label, "_disabled", False) else command()
            ),
        )
        return label

    @staticmethod
    def _normalize_feedback_record_ids(record_ids: object) -> tuple[str, ...]:
        if isinstance(record_ids, str):
            values = (record_ids,)
        elif isinstance(record_ids, (list, tuple, set, frozenset)):
            values = record_ids
        else:
            values = ()
        normalized: list[str] = []
        seen: set[str] = set()
        for value in values:
            record_id = str(value or "").strip()
            if not record_id or record_id == "__current__" or record_id in seen:
                continue
            seen.add(record_id)
            normalized.append(record_id)
        return tuple(normalized)

    def show_feedback(
        self,
        selected_record_id: str | None = None,
        *,
        selected_record_ids: object = None,
    ) -> None:
        if self.compact_mode:
            return
        selected_record_id = str(selected_record_id or "").strip()
        requested_record_ids = self._normalize_feedback_record_ids(
            selected_record_ids
        )
        if not requested_record_ids and selected_record_id:
            requested_record_ids = self._normalize_feedback_record_ids(
                (selected_record_id,)
            )
        if (
            self.feedback_window is not None
            and self.feedback_window.winfo_exists()
            and requested_record_ids != self.feedback_selected_record_ids
        ):
            self._close_feedback_window()
        if self.feedback_window is None or not self.feedback_window.winfo_exists():
            self._build_feedback_window(requested_record_ids)
        self.tray_feedback_hidden = False
        self.feedback_window.deiconify()
        feedback_parent = (
            self.history_window
            if (
                requested_record_ids
                and self.history_window is not None
                and self.history_window.winfo_exists()
                and self.history_window.state() == "normal"
            )
            else self.root
        )
        self.feedback_window.lift(feedback_parent)
        self.feedback_window.after_idle(
            lambda window=self.feedback_window, parent=feedback_parent: (
                window.lift(parent) if window.winfo_exists() else None
            )
        )
        self.feedback_window.focus_force()
        if self.feedback_content is not None:
            self.feedback_content.focus_set()

    def _feedback_window_dimensions(self) -> tuple[int, int]:
        font_growth = max(
            0, min(5, int(getattr(self, "ui_font_size", 13)) - 13)
        )
        return 520, 520 + font_growth * 16

    def _build_feedback_window(
        self, selected_record_ids: object = None
    ) -> None:
        selected_record_ids = self._normalize_feedback_record_ids(
            selected_record_ids
        )
        self.feedback_selected_record_ids = selected_record_ids
        width, height = self._feedback_window_dimensions()
        feedback_parent = (
            self.history_window
            if (
                selected_record_ids
                and self.history_window is not None
                and self.history_window.winfo_exists()
                and self.history_window.state() == "normal"
            )
            else self.root
        )
        x = max(0, feedback_parent.winfo_rootx() + 20)
        y = max(0, feedback_parent.winfo_rooty() + 20)
        window = tk.Toplevel(feedback_parent)
        self.feedback_window = window
        window.transient(feedback_parent)
        window.title(f"{APP_TITLE} · 问题反馈")
        window.configure(bg=BORDER)
        window.geometry(self._visible_geometry(f"{width}x{height}+{x}+{y}", width, height))
        self._prepare_toplevel_dpi(window)
        window.resizable(False, False)
        window.attributes("-topmost", bool(self.root.attributes("-topmost")))
        window.attributes("-alpha", 1.0)
        window.overrideredirect(True)
        window.protocol("WM_DELETE_WINDOW", self._close_feedback_window)
        window.bind("<Escape>", lambda _event: self._close_feedback_window())

        shell = tk.Frame(window, bg=BORDER)
        shell.pack(fill="both", expand=True)
        body = tk.Frame(shell, bg=BG)
        body.pack(fill="both", expand=True, padx=1, pady=1)

        titlebar = tk.Frame(body, bg=SURFACE, height=40)
        titlebar.pack(fill="x")
        titlebar.pack_propagate(False)
        self._bind_drag(titlebar, window)
        logo_image = self.icons.app_logo(20)
        logo = tk.Label(titlebar, image=logo_image, bg=SURFACE, bd=0)
        logo.image = logo_image
        logo.pack(side="left", padx=(11, 6), pady=9)
        self._bind_drag(logo, window)
        title = tk.Label(
            titlebar,
            text="问题反馈",
            bg=SURFACE,
            fg=TEXT,
            font=self._ui_font("table_header"),
        )
        title.pack(side="left")
        self._bind_drag(title, window)
        self._titlebar_icon_button(
            titlebar,
            "close",
            self._close_feedback_window,
            width=40,
            height=40,
            hover="#7f2d35",
        ).pack(side="right", fill="y")

        content = tk.Frame(body, bg=BG)
        content.pack(fill="both", expand=True, padx=22, pady=(14, 16))
        content.grid_columnconfigure(0, weight=1)
        content.grid_rowconfigure(4, weight=1)
        tk.Label(
            content,
            text="请描述出现问题前后的操作和实际表现，信息越具体越容易定位。",
            bg=BG,
            fg=MUTED,
            anchor="w",
            font=self._ui_font("table_compact"),
        ).grid(row=0, column=0, sticky="ew", pady=(0, 12))

        category_row = tk.Frame(content, bg=BG)
        category_row.grid(row=1, column=0, sticky="ew", pady=(0, 9))
        tk.Label(
            category_row,
            text="问题类型",
            bg=BG,
            fg=TEXT,
            anchor="w",
            font=self._ui_font("table"),
        ).pack(side="left")
        self.feedback_category_var = tk.StringVar(
            master=window, value=FEEDBACK_CATEGORIES[0][0]
