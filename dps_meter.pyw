    def _feedback_character_name(self) -> str:
        if self.model.self_id is None:
            return ""
        return self.model.display_name(int(self.model.self_id or 0)).strip()[:48]

    @staticmethod
    def _feedback_record_choices(
        records: list[dict],
        current_active: bool,
        selected_record_id: str | None = None,
    ) -> list[tuple[str, str]]:
        current_label = "当前战斗（进行中）" if current_active else "当前状态（暂无战斗）"
        choices: list[tuple[str, str]] = [(current_label, "__current__")]
        used_labels = {current_label}
        selected_record_id = str(selected_record_id or "").strip()
        eligible_records = [
            record
            for record in records
            if isinstance(record, dict)
            and str(record.get("encounter_id", "")).strip()
        ]
        shown_records = eligible_records[:20]
        if selected_record_id and not any(
            str(record.get("encounter_id", "")).strip() == selected_record_id
            for record in shown_records
        ):
            selected_record = next(
                (
                    record
                    for record in eligible_records
                    if str(record.get("encounter_id", "")).strip()
                    == selected_record_id
                ),
                None,
            )
            if selected_record is not None:
                shown_records = [selected_record, *shown_records[:19]]
        for record in shown_records:
            if not isinstance(record, dict):
                continue
            encounter_id = str(record.get("encounter_id", "")).strip()
            if not encounter_id:
                continue
            monster = record.get("monster")
            monster_name = (
                str(monster.get("name", "")).strip()
                if isinstance(monster, dict)
                else ""
            ) or "未知目标"
            try:
                ended = dt.datetime.fromtimestamp(
                    float(record.get("ended_at_epoch", 0.0) or 0.0)
                ).strftime("%m-%d %H:%M")
            except (OSError, OverflowError, TypeError, ValueError):
                ended = "时间未知"
            label = (
                f"{ended}  {monster_name[:12]}  "
                f"{format_number(record.get('total_damage', 0))}"
            )
            if label in used_labels:
                label = f"{label} · {encounter_id[-6:]}"
            used_labels.add(label)
            choices.append((label, encounter_id))
        return choices

    @staticmethod
    def _feedback_history_summary(record: dict) -> dict[str, object]:
        monster_record = record.get("monster")
        participants = []
        for item in record.get("participants", [])[:MAX_PARTY_MEMBERS]:
            if not isinstance(item, dict):
                continue
            participants.append(
                {
                    "actor_id": str(item.get("actor_id", "")),
                    "name": str(item.get("name", "")),
                    "is_self": bool(item.get("is_self", False)),
                    "is_ai": bool(item.get("is_ai", False)),
                    "profession_id": item.get("profession_id"),
                    "extraordinary_rating": item.get("extraordinary_rating"),
                    "damage": int(item.get("damage", 0) or 0),
                    "dps": float(item.get("dps", 0.0) or 0.0),
                    "share": float(item.get("share", 0.0) or 0.0),
                    "hits": int(item.get("hits", 0) or 0),
                    "max_hit": int(item.get("max_hit", 0) or 0),
                    "damage_hits": item.get("damage_hits"),
                    "critical_hits": item.get("critical_hits"),
                    "critical_rate": item.get("critical_rate"),
                    "penetration_hits": item.get("penetration_hits"),
                    "penetration_rate": item.get("penetration_rate"),
                    "deaths": int(item.get("deaths", 0) or 0),
                    "revives": int(item.get("revives", 0) or 0),
                    "death_duration_seconds": float(
                        item.get("death_duration_seconds", 0.0) or 0.0
                    ),
                    "skills": [
                        dict(skill)
                        for skill in item.get("skills", [])
                        if isinstance(skill, dict)
                    ],
                    "targets": [
                        dict(target)
                        for target in item.get("targets", [])
                        if isinstance(target, dict)
                    ],
                }
            )
        raw_boss_damage = record.get("boss_damage")
        raw_death_log = (
            raw_boss_damage.get("death_event_log")
            if isinstance(raw_boss_damage, dict)
            else None
        )
        death_event_log: dict[str, object] = {}
        if isinstance(raw_death_log, dict):
            raw_rows = raw_death_log.get("rows")
            rows = []
            if isinstance(raw_rows, list):
                for raw_row in raw_rows[:512]:
                    if not isinstance(raw_row, (list, tuple)) or len(raw_row) < 2:
                        continue
                    rows.append(list(raw_row[:3]))
            if rows:
                death_event_log = {
                    "version": int(raw_death_log.get("version", 1) or 1),
                    "columns": list(
                        raw_death_log.get(
                            "columns", ["time_ms", "actor_id", "name"]
                        )
                    )[:3],
                    "origin_started_at_epoch": float(
                        raw_death_log.get("origin_started_at_epoch", 0.0) or 0.0
                    ),
                    "rows": rows,
                    "truncated": len(raw_rows) > len(rows),
                }
        return {
            "schema_version": record.get("schema_version"),
            "encounter_id": str(record.get("encounter_id", "")),
            "source": str(record.get("source", "")),
            "started_at": str(record.get("started_at", "")),
            "started_at_epoch": float(
                record.get("started_at_epoch", 0.0) or 0.0
            ),
            "ended_at": str(record.get("ended_at", "")),
            "ended_at_epoch": float(record.get("ended_at_epoch", 0.0) or 0.0),
            "saved_at": str(record.get("saved_at", "")),
            "saved_at_epoch": float(record.get("saved_at_epoch", 0.0) or 0.0),
            "archive_reason": str(record.get("archive_reason", "")),
            "duration_seconds": float(record.get("duration_seconds", 0.0) or 0.0),
            "hps_duration_seconds": float(
                record.get("hps_duration_seconds", 0.0) or 0.0
            ),
            "dps_duration_seconds": float(
                record.get("dps_duration_seconds", 0.0) or 0.0
            ),
            "total_damage": int(record.get("total_damage", 0) or 0),
            "team_dps": float(record.get("team_dps", 0.0) or 0.0),
            "team_size": int(record.get("team_size", 0) or 0),
            "target_filter": str(record.get("target_filter", "")),
            "favorite": bool(record.get("favorite", False)),
            "monster": (
                dict(monster_record) if isinstance(monster_record, dict) else None
            ),
            "targets": [
                dict(target)
                for target in record.get("targets", [])
                if isinstance(target, dict)
            ],
            "participants": participants,
            # Feedback previously carried only the final death count. Keeping
            # this small event list makes Boss-mechanic false positives
            # diagnosable without uploading the user's full capture log.
            "death_event_log": death_event_log,
            "damage_accounting": (
                dict(record.get("damage_accounting", {}))
                if isinstance(record.get("damage_accounting"), dict)
                else {}
            ),
            "capture_pipeline_at_archive": (
                dict(record.get("capture_pipeline_at_archive", {}))
                if isinstance(record.get("capture_pipeline_at_archive"), dict)
                else {}
            ),
        }

    @staticmethod
    def _recent_error_excerpt() -> dict[str, object]:
        path = APP_DIR / "dps_error.log"
        try:
            size = path.stat().st_size
            with path.open("rb") as handle:
                handle.seek(max(0, size - 8192))
                text = handle.read(8192).decode("utf-8", errors="replace")
            home = str(Path.home())
            if home:
                text = text.replace(home, "%USERPROFILE%")
            return {
                "updated_at": path.stat().st_mtime,
                "tail": text[-6000:],
            }
        except OSError:
            return {}

    def _collect_feedback_diagnostics(
        self,
        selected_record_id: str = "__current__",
        *,
        selected_record_ids: object = None,
    ) -> dict[str, object]:
        now = time.time()
        selected_record_id = str(selected_record_id or "__current__").strip()
        batch_record_ids = self._normalize_feedback_record_ids(
            selected_record_ids
        )
        if batch_record_ids:
            effective_record_ids = batch_record_ids
        elif selected_record_id and selected_record_id != "__current__":
            effective_record_ids = self._normalize_feedback_record_ids(
                (selected_record_id,)
            )
        else:
            effective_record_ids = ()
        include_current_combat = not effective_record_ids
        participants = []
        for actor in self.model.current_stats()[:12]:
            skills = sorted(
                actor.skills.values(), key=lambda value: value.damage, reverse=True
            )[:8]
            participants.append(
                {
                    "actor_id": str(actor.actor_id),
                    "name": self.model.display_name(actor.actor_id),
                    "profession_id": self.model.actor_profession_id(actor.actor_id),
                    "damage": int(actor.damage),
                    "hits": int(actor.hits),
                    "damage_hits": actor.damage_hits,
                    "critical_hits": actor.critical_hits,
                    "penetration_hits": actor.penetration_hits,
                    "critical_rate": (
                        actor.critical_hits / actor.damage_hits
                        if actor.damage_hits
                        and actor.critical_hits is not None
                        else None
                    ),
                    "penetration_rate": (
                        actor.penetration_hits / actor.damage_hits
                        if actor.damage_hits
                        and actor.penetration_hits is not None
                        else None
                    ),
                    "deaths": int(
                        self.model.member_death_counts.get(actor.actor_id, 0)
                    ),
                    "skills": [
                        {
                            "skill_id": int(skill.skill_id),
                            "name": self.model.display_skill_name(
                                actor.actor_id, skill.skill_id
                            ),
                            "damage": int(skill.damage),
                            "hits": int(skill.hits),
                        }
                        for skill in skills
                    ],
                }
            )
        monster_summaries = []
        for monster in self.model.current_bosses():
            monster_summaries.append({
                "entity_id": str(monster.entity_id),
                "name": monster.name,
                "entity_type": monster.entity_type,
                "template_id": monster.template_id,
                "level": monster.level,
                "boss_type": monster.boss_type,
                "boss_rank": monster.boss_rank,
                "current_hp": monster.current_hp,
                "max_hp": monster.max_hp,
                "observed_max_hp": monster.observed_max_hp,
            })
        monster_summary = monster_summaries[0] if monster_summaries else None
        capture_files = []
        try:
            recent_logs = sorted(
                LOG_DIR.glob("network_*.jsonl"),
                key=lambda path: path.stat().st_mtime,
                reverse=True,
            )[:3]
            for path in recent_logs:
                stat = path.stat()
                capture_files.append(
                    {
                        "name": path.name,
                        "size": stat.st_size,
                        "updated_at": stat.st_mtime,
                    }
                )
        except OSError:
            capture_files = []
        selected_records: list[dict] = []
        loader = getattr(getattr(self, "history_store", None), "load", None)
        if callable(loader):
            for record_id in effective_record_ids:
                try:
                    record = loader(record_id)
                except (OSError, TypeError, ValueError):
                    record = None
                if isinstance(record, dict):
                    selected_records.append(record)
        elif effective_record_ids:
            wanted_ids = set(effective_record_ids)
            selected_records = [
                record
                for record in self._load_recent_history(500)
                if str(record.get("encounter_id", "")) in wanted_ids
            ]
        record_order = {
            record_id: index for index, record_id in enumerate(effective_record_ids)
        }
        selected_records.sort(
            key=lambda record: record_order.get(
                str(record.get("encounter_id", "")), len(record_order)
            )
        )
        if len(effective_record_ids) <= 1:
            recent_combats = [
                self._feedback_history_summary(record)
                for record in selected_records
            ]
            feedback_history_detail = "full"
        else:
            recent_combats = [
                self._feedback_history_batch_summary(record)
                for record in selected_records
            ]
            feedback_history_detail = "compact"
            try:
                encoded_size = len(
                    json.dumps(
                        recent_combats,
                        ensure_ascii=False,
                        separators=(",", ":"),
                    ).encode("utf-8")
                )
            except (TypeError, ValueError, OverflowError):
                encoded_size = 0
            if encoded_size > 300 * 1024:
                for record in recent_combats:
                    record["details_limited"] = True
                    for participant in record.get("participants", []):
                        if isinstance(participant, dict):
                            participant["skills"] = []
                            participant["targets"] = []
                feedback_history_detail = "summary"
        current_combat = {
            "active": bool(self.model.active(now)),
            "duration_seconds": round(self.model.duration(now), 3),
            "end_reason": self.model.combat_end_reason,
            "participant_count": len(participants),
            "party_known": bool(self.model.party_known),
            "party_member_count": int(self.model.party_member_count),
            "encounter_target_ids": [
                str(entity_id)
                for entity_id in sorted(self.model.encounter_target_ids)
            ],
            "self_id": (
                str(self.model.self_id) if self.model.self_id is not None else ""
            ),
            "monster": monster_summary,
            "monsters": monster_summaries,
            "simultaneous_boss_target_ids": [
                str(entity_id)
                for entity_id in self.model._ordered_current_boss_target_ids()
            ],
            "participants": participants,
            "team_damage_states": [
                {
                    "actor_id": str(actor_id),
                    "last_absolute": int(state.last_absolute),
                    "baseline_absolute": int(state.baseline_absolute),
                    "accepted_damage": int(state.accepted_damage),
                    "carried_damage": int(state.carried_damage),
                    "has_snapshot": bool(state.has_snapshot),
                    "server_time": int(state.server_time),
                }
                for actor_id, state in list(
                    self.model.team_damage_states.items()
                )[:MAX_PARTY_MEMBERS]
            ],
            "record_snapshot": (
                self._feedback_history_summary(current_record)
                if (
                    include_current_combat
                    and (current_record := self.model.build_combat_record("feedback"))
                    is not None
                )
                else None
            ),
        }
        return {
            "app_version": CLIENT_BUILD,
            "display_version": APP_VERSION,
            "build_id": RELEASE_IDENTITY.build_id,
            "official_release": RELEASE_IDENTITY.official,
            "protected_release": RELEASE_IDENTITY.protected,
            "runtime": "packaged" if IS_FROZEN else "source",
            "platform": sys.platform,
            "connected": bool(self.connected),
            "game_pid": int(self.game_pid or 0),
            "capture_started": bool(self.capture_started),
            "capture_pipeline": self.worker.diagnostic_snapshot(),
            "compact_mode": bool(self.compact_mode),
            "boss_only": bool(self.model.boss_only),
            "selected_record_id": (
                effective_record_ids[0]
                if len(effective_record_ids) == 1
                else "__current__" if include_current_combat else ""
            ),
            "selected_record_ids": list(effective_record_ids),
            "selected_record_count": len(effective_record_ids),
            "loaded_record_count": len(recent_combats),
            "history_detail_level": feedback_history_detail,
            "combat": current_combat if include_current_combat else None,
            "recent_combats": recent_combats,
            "capture_files": capture_files,
            "last_error": self._recent_error_excerpt(),
        }

    def _submit_feedback(self) -> None:
        if self.feedback_submitting or self.feedback_content is None:
            return
        content = self.feedback_content.get("1.0", "end-1c").strip()
        if not content:
            if self.feedback_status_label is not None:
                self.feedback_status_label.configure(
                    text="请先填写问题描述。", fg=ERROR
                )
            return
        if len(content) > 2000:
            if self.feedback_status_label is not None:
                self.feedback_status_label.configure(
                    text="问题描述最多 2000 个字。", fg=ERROR
                )
            return
        selected_label = (
            self.feedback_category_var.get()
            if self.feedback_category_var is not None
            else FEEDBACK_CATEGORIES[0][0]
        )
        category = next(
            (
                value
                for label, value in FEEDBACK_CATEGORIES
                if label == selected_label
            ),
            "other",
        )
        selected_record_ids = self.feedback_selected_record_ids
        selected_record_id = (
            self.feedback_record_ids.get(self.feedback_record_var.get(), "__current__")
            if not selected_record_ids and self.feedback_record_var is not None
            else "__current__"
        )
        diagnostics = (
            self._collect_feedback_diagnostics(
                selected_record_id,
                selected_record_ids=selected_record_ids,
            )
            if self.feedback_diagnostics_var is not None
            and self.feedback_diagnostics_var.get()
            else {}
        )
        character_name = self._feedback_character_name()
        self.feedback_submitting = True
        if self.feedback_status_label is not None:
            self.feedback_status_label.configure(text="正在提交…", fg=MUTED)
        if self.feedback_submit_button is not None:
            self.feedback_submit_button.configure(
                text="正在提交", bg=PANEL_2, fg=MUTED
            )

        def submit() -> None:
            try:
                result = self.licensing.submit_feedback(
                    category=category,
                    content=content,
                    character_name=character_name,
                    diagnostics=diagnostics,
                )
                payload = {
                    "accepted": result.accepted,
                    "feedback_id": result.feedback_id,
                    "message": result.message,
                }
            except LicensingConnectionError as exc:
                payload = {"accepted": False, "message": str(exc)}
            except Exception:
                payload = {
                    "accepted": False,
                    "message": "反馈提交失败，请稍后重试。",
                }
            self.control_messages.put(("feedback_result", payload))

        threading.Thread(target=submit, name="feedback-submit", daemon=True).start()

    def _handle_feedback_result(self, payload: object) -> None:
        self.feedback_submitting = False
        if self.feedback_submit_button is not None:
            self.feedback_submit_button.configure(
                text="提交反馈", bg=ACCENT, fg="#07110e"
            )
        if not isinstance(payload, dict):
            payload = {}
        accepted = bool(payload.get("accepted"))
        feedback_id = str(payload.get("feedback_id", "")).strip()
        message = str(payload.get("message", "")).strip()
        if self.feedback_status_label is not None:
            if accepted:
                shown = message or "反馈已提交。"
                if feedback_id:
                    shown = f"{shown} 编号：{feedback_id}"
                self.feedback_status_label.configure(text=shown, fg=ACCENT)
            else:
                self.feedback_status_label.configure(
                    text=message or "反馈提交失败，请稍后重试。", fg=ERROR
                )
        if accepted and self.feedback_content is not None:
            self.feedback_content.delete("1.0", "end")

    def _close_feedback_window(self) -> None:
        if self.feedback_window is not None and self.feedback_window.winfo_exists():
            self.feedback_window.destroy()
        self.feedback_window = None
        self.feedback_category_var = None
        self.feedback_record_var = None
        self.feedback_record_ids = {}
        self.feedback_selected_record_ids = ()
        self.feedback_content = None
        self.feedback_diagnostics_var = None
        self.feedback_status_label = None
        self.feedback_submit_button = None
        self.tray_feedback_hidden = False

    @staticmethod
    def _missing_upload_equipment_tokens(record: object) -> set[str]:
        if not isinstance(record, dict):
            return set()
        identities = record.get("participant_identities")
        if not isinstance(identities, list):
            identities = record.get("participants_snapshot")
        actor_tokens: dict[int, str] = {}
        if isinstance(identities, list):
            for identity in identities:
                if not isinstance(identity, dict):
                    continue
                try:
                    actor_id = int(
                        identity.get("actor_id") or identity.get("iid") or 0
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
                token = str(
                    identity.get("character_id")
                    or identity.get("user_token")
                    or identity.get("id")
                    or ""
                ).strip()
                if actor_id and token:
                    actor_tokens[actor_id] = token

        missing: set[str] = set()
        participants = record.get("participants")
        if not isinstance(participants, list):
            return missing
        self_character_id = str(record.get("self_character_id") or "").strip()
        for participant in participants:
            if not isinstance(participant, dict):
                continue
            name = str(participant.get("name", "") or "").strip()
            if (
                history_participant_is_ai(participant)
                or name.endswith(PROJECTION_NAME_SUFFIX)
            ):
                continue
            snapshot = participant.get("equipment_snapshot")
            if (
                isinstance(snapshot, dict)
                and isinstance(snapshot.get("equipment"), list)
                and bool(snapshot["equipment"])
            ):
                continue
            token = str(
                participant.get("user_token")
                or participant.get("character_id")
                or actor_tokens.get(participant.get("actor_id"))
                or (
                    self_character_id
                    if participant.get("is_self") is True
                    else ""
                )
                or ""
            ).strip()
            if token:
                missing.add(token)
        return missing

    def _continue_automatic_victory_upload(
        self,
        battle_id: str,
        fallback_record: dict,
        equipment_deadline: float,
        equipment_capture_deadline_ns: int,
    ) -> None:
        if (
            bool(getattr(self, "closing", False))
            or not bool(
                getattr(self, "auto_upload_combat_records_enabled", True)
            )
        ):
            return
        record = self._history_record_for_upload(battle_id)
        if not isinstance(record, dict):
            record = fallback_record
        if not self._automatic_upload_needs_update(battle_id, record):
            return
        enriched = self._attach_pve_equipment_snapshots(
            record,
            capture_deadline_ns=equipment_capture_deadline_ns,
        )
        if enriched is not record:
            record = enriched
            store = getattr(self, "history_store", None)
            save = getattr(store, "save", None)
            if callable(save):
                try:
                    save(record)
                except (OSError, TypeError, ValueError):
                    pass

        missing_tokens = self._missing_upload_equipment_tokens(record)
        schedule = getattr(self, "_schedule_team_equipment_profiles", None)
        if missing_tokens and callable(schedule):
            schedule(extra_attempt_tokens=missing_tokens)
        requested_at = getattr(self, "team_equipment_requested_at", {})
        pending_tokens = (
            missing_tokens.intersection(requested_at)
            if isinstance(requested_at, dict)
            else set()
        )
        if pending_tokens and time.monotonic() < equipment_deadline:
            after = getattr(getattr(self, "root", None), "after", None)
            if callable(after):
                try:
                    after(
                        AUTOMATIC_UPLOAD_EQUIPMENT_POLL_MS,
                        lambda: self._continue_automatic_victory_upload(
                            battle_id,
                            record,
                            equipment_deadline,
                            equipment_capture_deadline_ns,
                        ),
                    )
                    return
                except tk.TclError:
                    pass
        self._start_history_upload(battle_id, "character", silent=True)

    @staticmethod
    def _history_detail_signature(record: dict) -> str:
        details = {
            key: record[key] for key in (
                'event_log', 'skill_cast_log', 'boss_hp_damage_samples',
                'team_damage_samples', 'display_team_dps_samples',
                'participant_damage_samples', 'team_dps_timeline',
            ) if record.get(key)
        }
        participant_details = ('skills', 'extraordinary_rating', 'equipment_snapshot')
        for field in ('participants', 'healers', 'damage_taken'):
            rows = [
                {'actor_id': row.get('actor_id'), **{
                    key: row[key] for key in participant_details if row.get(key)
                }}
                for row in record.get(field, ())
                if isinstance(row, dict) and any(row.get(key) for key in participant_details)
            ]
            if rows:
                details[field] = rows
        if not details:
            return ''
        return hashlib.sha256(json.dumps(
            details, sort_keys=True, separators=(',', ':'),
        ).encode('utf-8')).hexdigest()

    def _automatic_upload_needs_update(self, battle_id: str, record: dict) -> bool:
        state = self._history_upload_state(battle_id)
        status = str(state.get('state', 'pending') or 'pending').casefold()
        if status == 'pending':
            return True
        signature = self._history_detail_signature(record)
        return bool(
            status in {'uploaded', 'included', 'ranked'}
            and signature
            and signature != state.get('detail_signature', '')
        )

    def _queue_automatic_victory_upload(self, record: object) -> bool:
        """Upload a saved, decided PvE battle once outside combat handling."""

        if (
            not isinstance(record, dict)
            or not bool(
                getattr(self, "auto_upload_combat_records_enabled", True)
            )
            or encounter_upload_rejection_code(record)
            or str(record.get("settlement_status", "")).upper() == "PENDING"
            or bool(getattr(self, "closing", False))
        ):
            return False
        battle_id = str(record.get("encounter_id", "") or "").strip()
        if not battle_id:
            return False
        if not self._automatic_upload_needs_update(battle_id, record):
            return False
        queued = getattr(self, "automatic_upload_queued", None)
        if not isinstance(queued, set):
            queued = set()
            self.automatic_upload_queued = queued
        if (
            battle_id in queued
            or battle_id in getattr(self, "history_upload_in_progress", set())
        ):
            return False
        after = getattr(getattr(self, "root", None), "after", None)
        if not callable(after):
            return False
        queued.add(battle_id)
        try:
            equipment_deadline = (
                time.monotonic() + AUTOMATIC_UPLOAD_EQUIPMENT_WAIT_SECONDS
            )
            equipment_capture_deadline_ns = time.time_ns() + int(
                AUTOMATIC_UPLOAD_EQUIPMENT_WAIT_SECONDS * 1_000_000_000
            )
            after(
                0,
                lambda selected_id=battle_id, saved_record=record: (
                    self._continue_automatic_victory_upload(
                        selected_id,
                        saved_record,
                        equipment_deadline,
                        equipment_capture_deadline_ns,
                    )
                ),
            )
        except tk.TclError:
            queued.discard(battle_id)
            return False
        return True

    def _sync_settlement_history_for_upload(self, adapter, tracker) -> set[str]:
        """Observe saved history without changing matching or settlement logic."""

        self._enrich_settlement_ratings_from_live_profiles(tracker)
        model = getattr(self, 'model', None)
        local_id = str(getattr(model, 'encounter_id', '') or '')
        tracked_id = getattr(adapter, 'local_bindings', {}).get(local_id)
        encounter = tracker.encounters.get(tracked_id) if hasattr(tracker, 'encounters') else None
        build_record = getattr(model, 'build_combat_record', None)
        if encounter is not None and encounter.ended_at_ns is not None and callable(build_record):
            local_record = build_record('target_defeated' if encounter.result == 'VICTORY' else 'party_wipe')
            if isinstance(local_record, dict):
                projected = adapter.project_local_record(tracker, local_record)
                if projected is not None:
                    self.history_store.save(projected)
                    self._queue_automatic_victory_upload(projected)
        saved_ids = adapter.sync(tracker)
        store = getattr(self, "history_store", None)
        load = getattr(store, "load", None)
        for saved_id in saved_ids:
            if callable(load):
                record = load(saved_id)
                if isinstance(record, dict):
                    enriched = self._attach_pve_equipment_snapshots(record)
                    if enriched is not record:
                        store.save(enriched)
            self._queue_automatic_victory_upload(
                self._history_record_for_upload(saved_id)
            )
        return saved_ids

    def _enrich_settlement_ratings_from_live_profiles(self, tracker) -> bool:
        """Persist verified live scores before projecting a settlement.

        Older encounters can have a complete damage table while their start
        roster was captured before a teammate's score packet. Keep the score
        attached to the exact actor/token pair so later history renders do not
        depend on the live party still being present.
        """

        model = getattr(self, "model", None)
        ratings = getattr(model, "entity_extraordinary_ratings", {})
        if not isinstance(ratings, dict):
            return False
        controller = getattr(self, "settlement_ui", None)
        session_ids = set(getattr(controller, "session_encounter_ids", ()))
        if not session_ids:
            return False
        changed_any = False
        for encounter in tracker.encounters.values():
            if encounter.local_encounter_id not in session_ids:
                continue
            changed = False
            for identity in encounter.participants_snapshot:
                try:
                    actor_id = int(identity.get("iid") or 0)
                except (TypeError, ValueError, OverflowError):
                    actor_id = 0
                rating = normalize_extraordinary_rating(ratings.get(actor_id))
                if rating is None:
                    continue
                if normalize_extraordinary_rating(
                    identity.get("extraordinary_rating")
                ) is None:
                    identity["extraordinary_rating"] = rating
                    changed = True
                token = str(identity.get("id") or "")
                for participant in encounter.participants:
                    if str(participant.get("id") or "") == token:
                        persisted_rating = normalize_extraordinary_rating(
                            identity.get("extraordinary_rating")
                        )
                        if normalize_extraordinary_rating(
                            participant.get("extraordinary_rating")
                        ) is None:
                            participant["extraordinary_rating"] = persisted_rating
                            changed = True
                        break
            if changed:
                encounter.revision += 1
                changed_any = True
        if changed_any and controller is not None:
            controller.repository.save(tracker)
        return changed_any

    def _attach_pve_equipment_snapshots(
        self,
        record: dict,
        *,
        capture_deadline_ns: int = 0,
    ) -> dict:
        """Attach same-character gear captured by the official settlement edge."""

        try:
            ended_ns = int(float(record.get("ended_at_epoch") or 0) * 1e9)
        except (TypeError, ValueError, OverflowError):
            return record
        if ended_ns <= 0:
            return record
        try:
            settlement_ns = int(
                float(record.get("settlement_received_at") or 0) * 1e9
            )
        except (TypeError, ValueError, OverflowError):
            settlement_ns = 0
        # Delayed PVE statistics are often received only after the next Boss
        # starts. A correlated equipment response can therefore be newer than
        # the damage end while still predating the authoritative settlement.
        # UID and exact rating remain mandatory below, so this does not attach
        # arbitrary current gear to an older fight.
        snapshot_cutoff_ns = max(ended_ns, settlement_ns)
        try:
            automatic_upload_cutoff_ns = max(0, int(capture_deadline_ns or 0))
        except (TypeError, ValueError, OverflowError):
            automatic_upload_cutoff_ns = 0

        def valid_snapshot(value: object, expected_rating: object, token: str) -> dict | None:
            if not isinstance(value, dict):
                return None
            snapshot_token = str(
                value.get("user_token") or value.get("character_id") or ""
            ).strip()
            if snapshot_token and snapshot_token != token:
                return None
            try:
                captured_ns = int(value.get("captured_at_ns") or 0)
            except (TypeError, ValueError, OverflowError):
                return None
            expected = normalize_extraordinary_rating(expected_rating)
            captured = normalize_extraordinary_rating(
                value.get("extraordinary_rating")
            )
            allowed_cutoff_ns = max(
                snapshot_cutoff_ns,
                automatic_upload_cutoff_ns if expected is not None else 0,
            )
            if captured_ns <= 0 or captured_ns > allowed_cutoff_ns:
                return None
            if expected is not None and captured != expected:
                return None
            if captured_ns > ended_ns and expected is None:
                return None
            equipment = value.get("equipment")
            if not isinstance(equipment, list) or not equipment:
                return None
            return value

        profiles = getattr(self, "team_equipment_profiles", None)
        profiles = profiles if isinstance(profiles, dict) else {}
        model_actor_tokens = getattr(
            getattr(self, "model", None), "actor_character_ids", {}
        )
        actor_tokens = (
            dict(model_actor_tokens)
            if isinstance(model_actor_tokens, dict)
            else {}
        )
        identities = record.get("participant_identities")
        if not isinstance(identities, list):
            identities = record.get("participants_snapshot")
        if isinstance(identities, list):
            for identity in identities:
                if not isinstance(identity, dict):
                    continue
                try:
                    actor_id = int(
                        identity.get("actor_id") or identity.get("iid") or 0
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
                token = str(
                    identity.get("character_id")
                    or identity.get("user_token")
                    or identity.get("id")
                    or ""
                ).strip()
                if actor_id and token:
                    actor_tokens[actor_id] = token
        repository = getattr(self, "pvp_history_repository", None)
        archive_lookup = getattr(
            repository, "equipment_snapshot_at_or_before", None
        )
        recording = getattr(self, "pvp_recording", None)
        account_key = str(getattr(recording, "account_key", "") or "").strip()
        self_character_id = str(record.get("self_character_id") or "").strip()
        resolved_snapshots: dict[tuple[str, int | None], dict | None] = {}
        changed = False
        result = dict(record)
        for collection in ("participants", "healers", "damage_taken"):
            rows = record.get(collection)
            if not isinstance(rows, list):
                continue
            updated = []
            for row in rows:
                if not isinstance(row, dict):
                    updated.append(row)
                    continue
                token = str(
                    row.get("user_token")
                    or row.get("character_id")
                    or actor_tokens.get(row.get("actor_id"))
                    or (self_character_id if row.get("is_self") is True else "")
                    or ""
                ).strip()
                if not token:
                    updated.append(row)
                    continue
                expected_rating = row.get("extraordinary_rating")
                if row.get("equipment_snapshot"):
                    snapshot = valid_snapshot(row["equipment_snapshot"], expected_rating, token)
                    rating = normalize_extraordinary_rating(
                        snapshot.get("extraordinary_rating") if snapshot else None
                    )
                    if normalize_extraordinary_rating(expected_rating) is None and rating is not None:
                        updated.append({**row, "user_token": token, "extraordinary_rating": rating})
                        changed = True
                    else:
                        updated.append(row)
                    continue
                snapshot_key = (token, normalize_extraordinary_rating(expected_rating))
                if snapshot_key not in resolved_snapshots:
                    profile = profiles.get(token)
                    snapshot = valid_snapshot(
                        (
                            profile.get("equipment_snapshot")
                            if isinstance(profile, dict)
                            else None
                        ),
                        expected_rating,
                        token,
                    )
                    if (
                        not isinstance(snapshot, dict)
                        and callable(archive_lookup)
                        and account_key
                    ):
                        try:
                            snapshot = archive_lookup(
                                account_key,
                                token,
                                (
                                    max(
                                        snapshot_cutoff_ns,
                                        automatic_upload_cutoff_ns,
                                    )
                                    if normalize_extraordinary_rating(
                                        expected_rating
                                    ) is not None
                                    else ended_ns
                                ),
                                extraordinary_rating=expected_rating,
                            )
                        except (OSError, TypeError, ValueError):
                            snapshot = None
                        snapshot = valid_snapshot(snapshot, expected_rating, token)
                    resolved_snapshots[snapshot_key] = (
                        snapshot if isinstance(snapshot, dict) else None
                    )
                snapshot = resolved_snapshots.get(snapshot_key)
                if not isinstance(snapshot, dict):
                    updated.append(row)
                    continue
                enriched_row = {
                    **row,
                    "equipment_snapshot": deepcopy(snapshot),
                }
                if not str(row.get("user_token") or "").strip():
                    enriched_row["user_token"] = token
                rating = normalize_extraordinary_rating(snapshot.get("extraordinary_rating"))
                if normalize_extraordinary_rating(expected_rating) is None and rating is not None:
                    enriched_row["extraordinary_rating"] = rating
                updated.append(enriched_row)
                changed = True
            result[collection] = updated
        return result if changed else record

    def _save_combat_history_record(self, record: dict) -> bool:
        try:
            enriched_record = dict(record)
            enriched_record.pop("_shared_clock_request", None)
            capture_snapshot = self.worker.diagnostic_snapshot()
            enriched_record["capture_pipeline_at_archive"] = capture_snapshot
            for record_key, capture_key in (
                ("dungeon_id", "dungeon_id"),
                ("map_id", "map_id"),
                ("dungeon_stage_id", "dungeon_stage_id"),
                ("dungeon_stage_phase", "dungeon_stage_phase"),
                ("dungeon_context_filetime", "dungeon_context_filetime"),
            ):
                try:
                    existing_value = int(enriched_record.get(record_key, 0) or 0)
                    capture_value = int(capture_snapshot.get(capture_key, 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    continue
                if not existing_value and capture_value:
                    enriched_record[record_key] = capture_value
                    enriched_record["dungeon_context_source"] = (
                        "explicit_protocol_fields_at_archive"
                    )
            current_brass_status = str(
                enriched_record.get("brass_tome_status", "unknown") or "unknown"
            ).casefold()
            capture_brass_status = str(
                capture_snapshot.get("brass_tome_status", "unknown") or "unknown"
            ).casefold()
            if (
                current_brass_status not in {"enabled", "disabled"}
                and capture_brass_status in {"enabled", "disabled"}
            ):
                def context_id(value: object) -> int:
                    try:
                        return max(0, int(value or 0))
                    except (TypeError, ValueError, OverflowError):
                        return 0

                record_dungeon_id = context_id(
                    enriched_record.get("dungeon_id")
                )
                record_map_id = context_id(enriched_record.get("map_id"))
                capture_dungeon_id = context_id(
                    capture_snapshot.get("dungeon_id")
                )
                capture_map_id = context_id(capture_snapshot.get("map_id"))
                same_dungeon_context = bool(
                    capture_snapshot.get("in_dungeon") is True
                    and (record_dungeon_id > 0 or record_map_id > 0)
                    and (
                        record_dungeon_id <= 0
                        or record_dungeon_id == capture_dungeon_id
                    )
                    and (record_map_id <= 0 or record_map_id == capture_map_id)
                )
                if capture_brass_status == "enabled" or same_dungeon_context:
                    enriched_record["brass_tome_status"] = capture_brass_status
                    enriched_record["brass_tome_enabled"] = (
                        capture_brass_status == "enabled"
                    )
                    raw_ids = capture_snapshot.get("brass_tome_challenge_ids")
                    if isinstance(raw_ids, list):
                        enriched_record["brass_tome_challenge_ids"] = list(raw_ids)
                    enriched_record["brass_tome_source"] = str(
                        capture_snapshot.get("dungeon_context_source", "") or ""
                    )
            adapter = getattr(self, "settlement_history_adapter", None)
            controller = getattr(self, "settlement_ui", None)
            if (
                IS_PASSIVE_PROTOCOL_ADAPTER
                and adapter is not None
                and controller is not None
            ):
                projected = adapter.project_local_record(
                    controller.tracker, enriched_record
                )
                if projected is not None:
                    enriched_record = projected
            enriched_record = self._attach_pve_equipment_snapshots(enriched_record)
            self.history_store.save(enriched_record)
            self._queue_automatic_victory_upload(enriched_record)
            return True
        except (OSError, ValueError, TypeError):
            return False

    def _handle_combat_clock_result(self, result: CombatClockResult) -> None:
        self.model.apply_combat_clock(result)
        if not result.final:
            return
        pending = self.pending_clock_records.get(result.encounter_id)
        if pending is None:
            return
        record, _deadline, _fallback_saved = pending
        updated = apply_combat_clock_to_record(record, result)
        shared_clock = updated.get("shared_clock")
        if not (
            str(updated.get("duration_source", "")) == "server_shared_clock"
            and isinstance(shared_clock, dict)
            and bool(shared_clock.get("accepted"))
        ):
            return
        self.pending_clock_records.pop(result.encounter_id, None)
        if not self._save_combat_history_record(updated):
            self.model.completed_combats.append(updated)
            return
        if (
            self.history_window is not None
            and self.history_window.winfo_exists()
            and self.history_window.state() == "normal"
        ):
            self._refresh_history_records()

    def _flush_combat_history(self, *, force: bool = False) -> int:
        records = self.model.pop_completed_combats()
        saved = 0
        failed: list[dict] = []
        now = time.monotonic()
        worker = self.combat_clock_worker
        for record in records:
            self._remember_main_battle_result(record)
            encounter_id = str(record.get("encounter_id", "")).strip()
            clock_request = record.get("_shared_clock_request")
            game_clock_final = bool(
                str(record.get("duration_source", ""))
                == "game_server_team_clock"
            )
            if (
                game_clock_final
                and isinstance(clock_request, dict)
                and worker is not None
                and worker.is_alive()
            ):
                # The game settlement remains authoritative locally, but its
                # final report lets teammates close the same shared clock.
                worker.submit(clock_request)
                self.pending_clock_records.pop(encounter_id, None)
            if encounter_id and not isinstance(clock_request, dict):
                superseded = self.pending_clock_records.pop(
                    encounter_id, None
                )
                if superseded is not None and worker is not None:
                    worker.cancel(encounter_id)
            can_wait_for_clock = bool(
                not force
                and encounter_id
                and isinstance(clock_request, dict)
                and not game_clock_final
                and worker is not None
                and worker.is_alive()
            )
            if can_wait_for_clock:
                previous = self.pending_clock_records.get(encounter_id)
                if previous is None:
                    deadline = now + COMBAT_CLOCK_HISTORY_WAIT_SECONDS
                elif previous[2]:
                    # Late metadata replaced the already-saved fallback copy;
                    # persist the replacement in this same flush pass.
                    deadline = now
                else:
                    deadline = previous[1]
                self.pending_clock_records[encounter_id] = (
                    record,
                    deadline,
                    False,
                )
                worker.submit(clock_request)
                continue
            if self._save_combat_history_record(record):
                saved += 1
            else:
                failed.append(record)

        for encounter_id, (record, deadline, fallback_saved) in list(
            self.pending_clock_records.items()
        ):
            if not force and now < deadline:
                continue
            if fallback_saved or force:
                self.pending_clock_records.pop(encounter_id, None)
                if worker is not None:
                    worker.cancel(encounter_id)
                if force and not fallback_saved:
                    if self._save_combat_history_record(record):
                        saved += 1
                    else:
                        failed.append(record)
                continue
            if self._save_combat_history_record(record):
                saved += 1
                # Keep synchronization alive after the local fallback becomes
                # visible. A late party final can still overwrite this exact
                # encounter instead of leaving different clients forever.
                self.pending_clock_records[encounter_id] = (
                    record,
                    now + COMBAT_CLOCK_HISTORY_LATE_FINAL_SECONDS,
                    True,
                )
            else:
                self.pending_clock_records.pop(encounter_id, None)
                if worker is not None:
                    worker.cancel(encounter_id)
                failed.append(record)
        if failed:
            self.model.completed_combats.extend(failed)
        adapter = getattr(self, "settlement_history_adapter", None)
        controller = getattr(self, "settlement_ui", None)
        if adapter is not None and controller is not None and adapter.details_dirty:
            try:
                saved += len(self._sync_settlement_history_for_upload(adapter, controller.tracker))
            except (ValueError, OSError, TypeError) as error:
                controller.last_error = "战斗明细写入历史失败：" + type(error).__name__
        if (
            saved
            and self.history_window is not None
            and self.history_window.winfo_exists()
            and self.history_window.state() == "normal"
        ):
            self._refresh_history_records()
        return saved

    def _load_recent_history(self, limit: int) -> list[dict]:
        model_catalog = getattr(
            getattr(self, "model", None), "target_catalog", {}
        )
        catalog = (
            {
                str(template_id): dict(metadata)
                for template_id, metadata in model_catalog.items()
                if isinstance(metadata, dict)
            }
            if isinstance(model_catalog, dict)
            else {}
        )
        worker = getattr(self, "worker", None)
        worker_catalog = getattr(worker, "monster_catalog", {})
        if isinstance(worker_catalog, dict):
            for template_id, metadata in worker_catalog.items():
                if isinstance(metadata, dict):
                    catalog.setdefault(str(template_id), {}).update(metadata)
        if not catalog:
            catalog = load_target_identity_catalog()
        skill_catalog = load_skill_catalog()
        runtime_skill_names = getattr(
            getattr(self, "model", None), "runtime_skill_names", {}
        )
        if isinstance(runtime_skill_names, dict):
            skill_catalog = dict(skill_catalog)
            for skill_id, name in runtime_skill_names.items():
                skill_catalog.setdefault(str(skill_id), name)
        records: list[dict] = []
        for record in self.history_store.load_recent(limit):
            restored = self._restore_history_record(
                record, catalog=catalog, skill_catalog=skill_catalog
            )
            if isinstance(restored, dict):
                records.append(restored)
        return records

    def _restore_history_record(
        self,
        record: object,
        *,
        catalog: dict | None = None,
        skill_catalog: dict | None = None,
    ) -> dict | None:
        if not isinstance(record, dict):
            return None
        if catalog is None:
            catalog = load_target_identity_catalog()
        if skill_catalog is None:
            skill_catalog = load_skill_catalog()
            runtime_skill_names = getattr(
                getattr(self, "model", None), "runtime_skill_names", {}
            )
            if isinstance(runtime_skill_names, dict):
                skill_catalog = dict(skill_catalog)
                for skill_id, name in runtime_skill_names.items():
                    skill_catalog.setdefault(str(skill_id), name)
        restored = CombatHistoryStore.restore_exact_stage_skills_for_display(record)
        restored = CombatHistoryStore.restore_game_server_team_clock_for_display(
            restored
        )
        restored = CombatHistoryStore.normalize_healing_for_display(restored)
        restored = restore_history_boss_names(restored, catalog)
        restored = restore_history_skill_names(restored, skill_catalog)
        return restored if isinstance(restored, dict) else None

    def _ingest_stage_summary(self, payload: object) -> bool:
        if not isinstance(payload, dict):
            return False
        model_ingested = self.model.ingest_stage_summary(payload)
        wipe_attached = self.history_store.attach_exact_wipe_details(payload)
        attached = wipe_attached
        if not model_ingested and attached is None:
            attached = self.history_store.attach_stage_summary_validation(payload)
        if not model_ingested and attached is None:
            return False
        if (
            attached is not None
            and self.history_window is not None
            and self.history_window.winfo_exists()
            and self.history_window.state() == "normal"
        ):
            self._refresh_history_records()
        return True

    def _selected_history_record(self) -> dict | None:
        cached = getattr(self, "history_loaded_record", None)
        if (
            isinstance(cached, dict)
            and str(cached.get("encounter_id", cached.get("battle_id", "")))
            == self.history_selected_id
        ):
            return cached
        for record in getattr(self, "history_records", []):
            record_id = str(record.get("encounter_id", record.get("battle_id", "")))
            if record_id != self.history_selected_id:
                continue
            if getattr(self, "backend_current_page", "history") == "kings":
                payload = record.get("_pvp_record")
                if isinstance(payload, dict):
                    restored = self._pvp_history_detail_record(record, payload)
                    self.history_loaded_record = restored
                    return restored
            # Compatibility for tests and legacy callers that still provide a
            # complete record rather than an indexed summary.
            if isinstance(record.get("participants"), list):
                self.history_loaded_record = record
                return record
            break
        store = getattr(self, "history_store", None)
        loader = getattr(store, "load", None)
        if not callable(loader) or not self.history_selected_id:
            return None
        raw_record = loader(self.history_selected_id)
        enriched_record = (
            self._attach_pve_equipment_snapshots(raw_record)
            if isinstance(raw_record, dict)
            else raw_record
        )
        if enriched_record is not raw_record:
            try:
                store.save(enriched_record)
            except (OSError, TypeError, ValueError):
                pass
        restored = self._restore_history_record(enriched_record)
        self.history_loaded_record = restored
        return restored

    def _pvp_history_detail_record(
        self, summary: dict, payload: dict
    ) -> dict:
        """Project one PvP payload onto the native detail component shape."""

        player = payload.get("player")
        player = player if isinstance(player, dict) else {}
        try:
            duration = max(
                0.0, float(payload.get("duration_seconds", 0.0) or 0.0)
            )
        except (TypeError, ValueError, OverflowError):
            duration = 0.0

        def integer(value: object, *, default: int = 0) -> int:
            try:
                return max(0, int(value or 0))
            except (TypeError, ValueError, OverflowError):
                return max(0, int(default))

        def optional_integer(*values: object) -> int | None:
            for value in values:
                if value is None:
                    continue
                try:
                    return max(0, int(value))
                except (TypeError, ValueError, OverflowError):
                    continue
            return None

        def row_uid(value: dict) -> str:
            return str(
                value.get("character_id")
                or value.get("user_token")
                or value.get("opponent_id")
                or ""
            ).strip()

        def merge_roster(rows: object) -> list[dict]:
            result: list[dict] = []
            indexes: dict[str, int] = {}
            for raw in rows if isinstance(rows, list) else []:
                if not isinstance(raw, dict):
                    continue
                value = deepcopy(raw)
                uid = row_uid(value)
                if uid and uid in indexes:
                    current = result[indexes[uid]]
                    for key, item in value.items():
                        if item not in (None, "", [], {}):
                            current[key] = item
                    continue
                if uid:
                    indexes[uid] = len(result)
                result.append(value)
            return result

        allies = merge_roster(payload.get("allies"))
        enemies = merge_roster(payload.get("enemies"))
        # A late team settlement can repeat a character in both arrays (for
        # example, an old party snapshot followed by the verified arena
        # roster).  A confirmed friendly row is authoritative for the local
        # side; never render one UID twice or turn a teammate into an enemy.
        ally_uids = {row_uid(row) for row in allies if row_uid(row)}
        if ally_uids:
            enemies = [
                row for row in enemies
                if not row_uid(row) or row_uid(row) not in ally_uids
            ]
        self_uid = row_uid(player)
        team_mode_size = integer(
            payload.get("team_size", summary.get("team_size"))
        )
        data_scope = payload.get("data_scope")
        data_scope = data_scope if isinstance(data_scope, dict) else {}
        self_metrics_trusted = bool(
            team_mode_size <= 1
            or str(data_scope.get("self_metrics") or "").casefold()
            == "self_exact"
        )
        pair_interactions_trusted = bool(
            team_mode_size <= 1
            or str(data_scope.get("opponent_interactions") or "").casefold()
            == "pair_exact"
        )
        local = next(
            (
                row
                for row in allies
                if row.get("is_self") is True
                or bool(self_uid and row_uid(row) == self_uid)
            ),
            None,
        )
        local_metrics = {
            "kills": payload.get("kills") if self_metrics_trusted else None,
            "assists": payload.get("assists") if self_metrics_trusted else None,
            "deaths": payload.get("deaths") if self_metrics_trusted else None,
            "damage": (
                payload.get("damage", payload.get("damage_done"))
                if self_metrics_trusted
                else None
            ),
            "healing": (
                payload.get("healing", payload.get("effective_healing"))
                if self_metrics_trusted
                else None
            ),
            "healing_source": payload.get("healing_source") if self_metrics_trusted else None,
            "taken": (
                payload.get("taken", payload.get("damage_taken"))
                if self_metrics_trusted
                else None
            ),
            "skills": (
                payload.get("skills_outgoing")
                if self_metrics_trusted
                else None
            ),
        }
        if local is None:
            local = {
                **player,
                **{
                    key: value
                    for key, value in local_metrics.items()
                    if value is not None
                },
                "is_self": True,
            }
            allies.insert(0, local)
        else:
            for key, value in player.items():
                if local.get(key) in (None, "", [], {}) and value not in (
                    None,
                    "",
                    [],
                    {},
                ):
                    local[key] = value
            for key, value in local_metrics.items():
                if local.get(key) is None and value is not None:
                    local[key] = value
            local["is_self"] = True

        opponents = payload.get("opponents")
        opponents = opponents if isinstance(opponents, list) else []
        enemy_by_uid = {
            row_uid(row): row for row in enemies if row_uid(row)
        }
        for opponent in opponents:
            if not isinstance(opponent, dict):
                continue
            uid = row_uid(opponent)
            if uid and uid in ally_uids:
                continue
            enemy = enemy_by_uid.get(uid) if uid else None
            if enemy is None:
                enemy = {
                    "character_id": uid,
                    "name": opponent.get("name") or "未知玩家",
                    "profession_id": opponent.get("profession_id"),
                    "level": opponent.get("level"),
                    "extraordinary_rating": opponent.get(
                        "extraordinary_rating"
                    ),
                    "avatar_id": opponent.get("avatar_id"),
                    "avatar_frame_id": opponent.get("avatar_frame_id"),
                    "is_ai": bool(opponent.get("is_ai")),
                    "equipment_snapshot": deepcopy(
                        opponent.get("equipment_snapshot")
                    ),
                }
                enemies.append(enemy)
                if uid:
                    enemy_by_uid[uid] = enemy
            else:
                for key in (
                    "name",
                    "profession_id",
                    "level",
                    "extraordinary_rating",
                    "avatar_id",
                    "avatar_frame_id",
                    "is_ai",
                    "equipment_snapshot",
                ):
                    if enemy.get(key) in (None, "", [], {}):
                        value = opponent.get(key)
                        if value not in (None, "", [], {}):
                            enemy[key] = deepcopy(value)

            # ``opponents`` is the exact local-player interaction view.  It
            # supplements, rather than replaces, the full team roster so a
            # 3V3/6V6/12V12 settlement keeps its authoritative team totals.
            to_skills = (
                opponent.get("skills_outgoing")
                if pair_interactions_trusted
                else None
            )
            from_skills = (
                opponent.get("skills_incoming")
                if pair_interactions_trusted
                else None
            )
            enemy["pvp_skills_to"] = (
                deepcopy(to_skills) if isinstance(to_skills, list) else []
            )
            enemy["pvp_skills_from"] = (
                deepcopy(from_skills) if isinstance(from_skills, list) else []
            )
            if team_mode_size == 1:
                pair_values = {
                    "kills": opponent.get(
                        "defeats", opponent.get("deaths_to")
                    ),
                    "deaths": opponent.get(
                        "kills", opponent.get("kills_on")
                    ),
                    "damage": opponent.get(
                        "taken", opponent.get("damage_from")
                    ),
                    "taken": opponent.get(
                        "damage", opponent.get("damage_to")
                    ),
                }
                for key, value in pair_values.items():
                    if enemy.get(key) is None and value is not None:
                        enemy[key] = value

        if not isinstance(local.get("pvp_skills_to"), list):
            local_outgoing = payload.get("skills_outgoing")
            if not isinstance(local_outgoing, list):
                local_outgoing = local.get("skills_outgoing")
            if not isinstance(local_outgoing, list):
                local_outgoing = local.get("skills")
            local["pvp_skills_to"] = (
                deepcopy(local_outgoing)
                if isinstance(local_outgoing, list)
                else []
            )
        if not isinstance(local.get("pvp_skills_from"), list):
            local_incoming = payload.get("skills_incoming")
            if not isinstance(local_incoming, list):
                local_incoming = []
                for opponent in opponents if pair_interactions_trusted else []:
                    rows = (
                        opponent.get("skills_incoming")
                        if isinstance(opponent, dict)
                        else None
                    )
                    if isinstance(rows, list):
                        local_incoming.extend(deepcopy(rows))
            local["pvp_skills_from"] = deepcopy(local_incoming)

        def normalize_skills(raw_skills: object) -> list[dict]:
            grouped: dict[int, dict] = {}
            for raw in raw_skills if isinstance(raw_skills, list) else []:
                if not isinstance(raw, dict):
                    continue
                skill_id = integer(raw.get("skill_id"))
                if skill_id <= 0:
                    continue
                damage = optional_integer(raw.get("damage"))
                hits = optional_integer(raw.get("hits"))
                casts = optional_integer(raw.get("casts"))
                hit_stamps = sorted(
                    {
                        parsed
                        for value in raw.get("hit_timestamps_ns", ())
                        if (parsed := integer(value)) > 0
                    }
                ) if isinstance(raw.get("hit_timestamps_ns"), (list, tuple)) else []
                cast_stamps = sorted(
                    {
                        parsed
                        for value in raw.get("cast_timestamps_ns", ())
                        if (parsed := integer(value)) > 0
                    }
                ) if isinstance(raw.get("cast_timestamps_ns"), (list, tuple)) else []
                row = {
                    **deepcopy(raw),
                    "skill_id": skill_id,
                    "name": str(raw.get("name") or "").strip(),
                    "damage": damage,
                    "hits": hits,
                    "casts": casts,
                    "max_hit": optional_integer(raw.get("max_hit")),
                    "critical_hits": optional_integer(
                        raw.get("critical_hits")
                    ),
                    "hit_timestamps_ns": hit_stamps,
                    "cast_timestamps_ns": cast_stamps,
                    "share": None,
                }
                current = grouped.get(skill_id)
                if current is None:
                    grouped[skill_id] = row
                    continue
                if not current.get("name") and row.get("name"):
                    current["name"] = row["name"]
                for key in ("damage", "hits", "casts", "critical_hits"):
                    value = row.get(key)
                    if value is not None:
                        current[key] = int(current.get(key) or 0) + int(value)
                maximum = row.get("max_hit")
                if maximum is not None:
                    current["max_hit"] = max(
                        int(current.get("max_hit") or 0), int(maximum)
                    )
                for key in ("hit_timestamps_ns", "cast_timestamps_ns"):
                    current[key] = sorted(
                        {*current.get(key, ()), *row.get(key, ())}
                    )
            rows = list(grouped.values())
            known_total = sum(
                int(row.get("damage") or 0)
                for row in rows
                if row.get("damage") is not None
            )
            for row in rows:
                if row.get("share") is None:
                    row["share"] = (
                        int(row.get("damage") or 0) / known_total
                        if row.get("damage") is not None and known_total > 0
                        else None
                    )
            rows.sort(
                key=lambda row: (
                    row.get("damage") is None,
                    -int(row.get("damage") or 0),
                    int(row.get("skill_id") or 0),
                )
            )
            return rows

        participants: list[dict] = []
        seen_keys: set[tuple[str, str]] = set()
        for side, roster in (("ally", allies), ("enemy", enemies)):
            for raw in roster:
                uid = row_uid(raw)
                fallback_key = str(raw.get("name") or "").strip().casefold()
                identity_key = (side, uid or fallback_key)
                if identity_key[1] and identity_key in seen_keys:
                    continue
                if identity_key[1]:
                    seen_keys.add(identity_key)
                row_is_self = bool(raw.get("is_self")) or bool(
                    side == "ally" and self_uid and uid == self_uid
                )
                metrics_scope = str(
                    raw.get("metrics_scope") or ""
                ).strip().casefold()
                skills_scope = str(
                    raw.get("skills_scope") or ""
                ).strip().casefold()
                statistics_authoritative = bool(
                    raw.get("statistics_authoritative") is True
                )
                has_recorded_skills = any(
                    isinstance(raw.get(key), list) and bool(raw.get(key))
                    for key in ("skills", "skills_outgoing", "skills_incoming")
                )
                metrics_trusted = bool(
                    team_mode_size <= 1
                    or metrics_scope in {"self_exact", "pair_exact", "authoritative"}
                    or statistics_authoritative
                )
                full_skills_trusted = bool(
                    team_mode_size <= 1
                    or skills_scope
                    in {"self_exact", "authoritative", "observed_partial"}
                    # Older saved team settlements did not persist
                    # ``skills_scope``. Their authoritative player row can
                    # still contain real locally observed skill events; keep
                    # those events as partial evidence instead of erasing the
                    # entire 3V3 skill tab.
                    or (statistics_authoritative and has_recorded_skills)
                )
                if (
                    not skills_scope
                    and statistics_authoritative
                    and has_recorded_skills
                ):
                    skills_scope = "observed_partial"
                damage = optional_integer(
                    raw.get("damage"), raw.get("damage_done"), raw.get("damage_to")
                ) if metrics_trusted else None
                healing = optional_integer(
                    raw.get("healing"),
                    raw.get("healing_done"),
                    raw.get("effective_healing"),
                ) if metrics_trusted else None
                taken = optional_integer(
                    raw.get("taken"),
                    raw.get("damage_taken"),
                    raw.get("damage_from"),
                ) if metrics_trusted else None
                kills_value = (
                    optional_integer(raw.get("kills"), raw.get("kills_on"))
                    if metrics_trusted
                    else None
                )
                assists_value = (
                    optional_integer(raw.get("assists"))
                    if metrics_trusted
                    else None
                )
                deaths_value = (
                    optional_integer(
                        raw.get("deaths"),
                        raw.get("defeats"),
                        raw.get("deaths_to"),
                    )
                    if metrics_trusted
                    else None
                )
                raw_skills_outgoing = raw.get("skills_outgoing")
                raw_skills_incoming = raw.get("skills_incoming")
                raw_skills = raw.get("skills")
                if not isinstance(raw_skills, list):
                    # For an enemy row the primary list is the enemy's
                    # outgoing damage to us; for an ally it is our team's
                    # outgoing damage.  Keep both directions below so the
                    # detail view can show the exact available source data.
                    raw_skills = (
                        raw_skills_outgoing
                        if side == "enemy"
                        else raw_skills_outgoing
                    )
                if not isinstance(raw_skills_outgoing, list):
                    raw_skills_outgoing = raw_skills if side == "ally" else []
                if not isinstance(raw_skills_incoming, list):
                    raw_skills_incoming = raw.get("skills") if side == "enemy" else []
                raw_pvp_skills_to = raw.get("pvp_skills_to")
                raw_pvp_skills_from = raw.get("pvp_skills_from")
                if not isinstance(raw_pvp_skills_to, list):
                    raw_pvp_skills_to = (
                        raw_skills
                        if side == "ally" and isinstance(raw_skills, list)
                        else []
                    )
                if not isinstance(raw_pvp_skills_from, list):
                    raw_pvp_skills_from = []
                if not full_skills_trusted:
                    raw_skills = []
                    raw_skills_outgoing = []
                    raw_skills_incoming = []
                if not pair_interactions_trusted:
                    raw_pvp_skills_to = []
                    raw_pvp_skills_from = []
                snapshot = raw.get("equipment_snapshot")
                snapshot = deepcopy(snapshot) if isinstance(snapshot, dict) else None
                rating = raw.get("extraordinary_rating", raw.get("rating"))
                if rating is None and snapshot is not None:
                    rating = snapshot.get("extraordinary_rating")
                participants.append(
                    {
                        "actor_id": len(participants) + 1,
                        "network_actor_id": integer(
                            raw.get("actor_id", raw.get("entity_id"))
                        ),
                        "character_id": uid,
                        "name": str(raw.get("name") or "未知玩家").strip(),
                        "profession_id": integer(raw.get("profession_id")),
                        "level": integer(raw.get("level")),
                        "extraordinary_rating": rating,
                        "avatar_id": integer(raw.get("avatar_id")),
                        "avatar_frame_id": integer(
                            raw.get("avatar_frame_id")
                        ),
                        "equipment_snapshot": snapshot,
                        "is_ai": bool(raw.get("is_ai")),
                        "is_self": row_is_self,
                        "side": side,
                        "combat_mode": "pvp",
                        "damage": damage,
                        "dps": damage / duration if damage is not None and duration > 0 else None,
                        "effective_healing": healing,
                        "healing": healing,
                        "healing_source": str(raw.get("healing_source") or ""),
                        "hps": healing / duration if healing is not None and duration > 0 else None,
                        "taken": taken,
                        "kills": kills_value,
                        "assists": assists_value,
                        "deaths": deaths_value,
                        "current_dead": bool(raw.get("current_dead")),
                        "skills": normalize_skills(raw_skills),
                        "skills_outgoing": normalize_skills(raw_skills_outgoing),
                        "skills_incoming": normalize_skills(raw_skills_incoming),
                        "pvp_skills_to": normalize_skills(raw_pvp_skills_to),
                        "pvp_skills_from": normalize_skills(
                            raw_pvp_skills_from
                        ),
                        "skill_detail_status": (
                            skills_scope
                            if full_skills_trusted and raw_skills
                            else "pair_exact"
                            if raw_pvp_skills_to or raw_pvp_skills_from
                            else "unavailable"
                        ),
                        "metrics_scope": metrics_scope or "legacy_unverified",
                        "skills_scope": skills_scope or "legacy_unverified",
                        "local_detail_available": bool(
                            raw_skills or raw_pvp_skills_to or raw_pvp_skills_from
                        ),
                    }
                )

        if not any(row.get("is_self") for row in participants) and participants:
            participants[0]["is_self"] = True
        total_damage = sum(
            int(row.get("damage") or 0)
            for row in participants
            if row.get("damage") is not None
        )
        total_healing = sum(
            int(row.get("effective_healing") or 0)
            for row in participants
            if row.get("effective_healing") is not None
        )
        total_taken = sum(
            int(row.get("taken") or 0)
            for row in participants
            if row.get("taken") is not None
        )
        for row in participants:
            row["share"] = (
                int(row.get("damage") or 0) / total_damage
                if row.get("damage") is not None and total_damage > 0
                else None
            )
            row["taken_share"] = (
                int(row.get("taken") or 0) / total_taken
                if row.get("taken") is not None and total_taken > 0
                else None
            )

        healers = [
            deepcopy(row)
            for row in participants
            if row.get("effective_healing") is not None
        ]
        damage_taken = [
            {**deepcopy(row), "share": row.get("taken_share")}
            for row in participants
            if row.get("taken") is not None
        ]
        local_participant = next(
            (row for row in participants if row.get("is_self") is True), {}
        )
        ally_participants = [row for row in participants if row.get("side") == "ally"]
        enemy_participants = [row for row in participants if row.get("side") == "enemy"]

        def side_total(rows: list[dict], key: str) -> int | None:
            known = [row.get(key) for row in rows if row.get(key) is not None]
            return sum(int(value or 0) for value in known) if known else None

        def side_average_rating(rows: list[dict]) -> int | None:
            ratings = [
                normalize_extraordinary_rating(row.get("extraordinary_rating"))
                for row in rows
                if not row.get("is_ai")
            ]
            known = [rating for rating in ratings if rating is not None]
            return int(sum(known) / len(known) + 0.5) if known else None

        projected = deepcopy(payload)
        projected.update(
            {
                "participants": participants,
                "healers": healers,
                "damage_taken": damage_taken,
                "combat_mode": "pvp",
                "pvp_team_size": integer(
                    payload.get("team_size", summary.get("team_size"))
                ),
                # Native PVE code uses team_size as a participant count.  PvP
                # uses it as the per-side mode size (3/6/12); keep the total
                # roster separately so both consumers remain unambiguous.
                "team_size": integer(
                    payload.get("team_size", summary.get("team_size"))
                ) or len(ally_participants),
                "pvp_total_players": len(participants),
                "monster": {
                    "name": summary.get("stage_name") or "PvP",
                    "level": 0,
                },
                "total_damage": total_damage if any(
                    row.get("damage") is not None for row in participants
                ) else None,
                "team_dps": total_damage / duration if total_damage and duration > 0 else None,
                "team_effective_healing": total_healing if healers else None,
                "team_hps": total_healing / duration if total_healing and duration > 0 else None,
                "team_taken": total_taken if damage_taken else None,
                "my_damage": local_participant.get("damage"),
                "my_taken": local_participant.get("taken"),
                "pvp_ally_damage": side_total(ally_participants, "damage"),
                "pvp_enemy_damage": side_total(enemy_participants, "damage"),
                "pvp_ally_healing": side_total(
                    ally_participants, "effective_healing"
                ),
                "pvp_enemy_healing": side_total(
                    enemy_participants, "effective_healing"
                ),
                "pvp_ally_taken": side_total(ally_participants, "taken"),
                "pvp_enemy_taken": side_total(enemy_participants, "taken"),
                "pvp_ally_average_rating": side_average_rating(ally_participants),
                "pvp_enemy_average_rating": side_average_rating(enemy_participants),
                "duration_seconds": duration,
                "dps_duration_seconds": duration,
                "hps_duration_seconds": duration,
                "settlement_status": "COMPLETE",
                "completeness": COMPLETENESS_COMPLETE,
                "result": summary.get("result", "pvp_unknown"),
                "pvp_result": summary.get(
                    "pvp_result", payload.get("result", "未知")
                ),
                "battle_id": summary.get("battle_id", payload.get("match_id", "")),
                "encounter_id": summary.get("battle_id", payload.get("match_id", "")),
                "stage_name": summary.get("stage_name", "PvP"),
                "dungeon_name": summary.get("dungeon_name", "未知地图"),
                "boss_name": summary.get("stage_name", "PvP"),
                "started_at_epoch": summary.get("started_at_epoch", 0.0),
                "ended_at_epoch": summary.get("ended_at_epoch", 0.0),
            }
        )
        skill_catalog = load_skill_catalog()
        runtime_skill_names = getattr(
            getattr(self, "model", None), "runtime_skill_names", {}
        )
        if isinstance(runtime_skill_names, dict):
            skill_catalog = dict(skill_catalog)
            for skill_id, name in runtime_skill_names.items():
                skill_catalog.setdefault(str(skill_id), name)
        restored = restore_history_skill_names(projected, skill_catalog)
        return restored if isinstance(restored, dict) else projected

    def _selected_history_summary(self) -> dict | None:
        for summary in getattr(self, "history_records", []):
            summary_id = str(
                summary.get("battle_id", summary.get("encounter_id", ""))
            )
            if summary_id == self.history_selected_id:
                return summary
        return None

    @staticmethod
    def _history_actor_name(participant: dict, index: int, hide_names: bool) -> str:
        if hide_names:
            return f"玩家{index + 1}"
        return str(participant.get("name", "")).strip() or f"玩家{index + 1}"

    def _history_names_hidden(self) -> bool:
        return bool(
            getattr(
                self,
                "history_hide_names",
                getattr(self, "hide_names", False),
            )
        )

    def _sync_history_privacy_buttons(self) -> None:
        hidden = self._history_names_hidden()
        variable = getattr(self, "history_privacy_var", None)
        if variable is not None:
            try:
                if bool(variable.get()) != hidden:
                    variable.set(hidden)
            except tk.TclError:
                pass
        for button in getattr(self, "history_privacy_buttons", []):
            background = blend_color(PANEL, ACCENT, 0.12) if hidden else PANEL
            foreground = ACCENT if hidden else TEXT
            button.configure(
                text="显示名称" if hidden else "隐藏名称",
                bg=background,
                fg=foreground,
                highlightbackground=ACCENT if hidden else BORDER,
            )
            button._normal_bg = background
            button._normal_fg = foreground
            button._hover_bg = blend_color(background, ACCENT, 0.18)
            button._hover_fg = ACCENT if hidden else TEXT

    def _set_history_names_hidden(self, hidden: object) -> None:
        self.history_hide_names = bool(hidden)
        self._sync_history_privacy_buttons()
        if getattr(self, "history_page_mode", "browser") == "detail":
            self._render_history_selection()
        else:
            self._draw_history_list()
            self._render_history_snapshot()
            self._draw_history_snapshot_trend()

    def _toggle_history_names(self) -> None:
        self._set_history_names_hidden(not self._history_names_hidden())

    def _history_privacy_field_changed(self) -> None:
        variable = getattr(self, "history_privacy_var", None)
        if variable is None:
            return
        try:
            hidden = bool(variable.get())
        except tk.TclError:
            return
        self._set_history_names_hidden(hidden)

    def _sync_history_detail_privacy_control(self) -> None:
        control = getattr(self, "history_detail_privacy_control", None)
        if control is None:
            return
        try:
            visible = self.history_meter_mode != "boss_damage"
            managed = bool(control.winfo_manager())
            if visible and not managed:
                control.pack(side="left", padx=(0, 8), pady=17)
            elif not visible and managed:
                control.pack_forget()
        except (AttributeError, tk.TclError):
            pass

    @staticmethod
    def _history_display_duration(record: dict, healing_mode: bool = False) -> float:
        """Return the archived divisor for the selected history mode."""
        key = "hps_duration_seconds" if healing_mode else "duration_seconds"
        fallback = "duration_seconds"
        try:
            value = float(record.get(key, record.get(fallback, 0.0)) or 0.0)
        except (AttributeError, TypeError, ValueError, OverflowError):
            value = 0.0
        if healing_mode and value <= 0:
            try:
                value = float(record.get(fallback, 0.0) or 0.0)
            except (AttributeError, TypeError, ValueError, OverflowError):
                value = 0.0
        return max(0.0, value)

    @staticmethod
    def _history_share_text(
        record: dict, hide_names: bool = False, max_length: int = 110
    ) -> str:
        participants = record.get("participants", [])
        if not isinstance(participants, list) or max_length <= 0:
            return ""
        try:
            duration = max(1.0, float(record.get("duration_seconds", 0.0) or 0.0))
        except (TypeError, ValueError, OverflowError):
            duration = 1.0
        dps_duration = dps_duration_seconds(
            record.get("dps_duration_seconds", duration)
        ) or 1.0
        share_rows: list[tuple[str, int]] = []
        for index, participant in enumerate(participants):
            if not isinstance(participant, dict):
                continue
            name = DpsWindow._history_actor_name(participant, index, hide_names)
            name = re.sub(r"[\s:：;；]+", "", name).strip()
            if not name:
                name = f"玩家{index + 1}"
            if not hide_names:
                name = name[:4]
            try:
                damage = max(0.0, float(participant.get("damage", 0.0) or 0.0))
                dps = float(
                    participant.get("dps", damage / dps_duration) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                dps = 0.0
            share_rows.append((name, int(round(max(0.0, dps)))))

        precisions = [2] * len(share_rows)
        while True:
            groups: dict[str, list[int]] = {}
            for index, (_name, dps) in enumerate(share_rows):
                precision = precisions[index]
                shown = f"{dps / 10_000:.{precision}f}"
                groups.setdefault(shown, []).append(index)
            changed = False
            for indexes in groups.values():
                if (
                    len(indexes) < 2
                    or len({share_rows[index][1] for index in indexes}) < 2
                ):
                    continue
                for index in indexes:
                    if precisions[index] < 4:
                        precisions[index] += 1
                        changed = True
            if not changed:
                break

        parts: list[str] = []
        for index, (name, dps) in enumerate(share_rows):
            precision = precisions[index]
            part = f"{name}:{dps / 10_000:.{precision}f}w"
            candidate = " ".join([*parts, part])
            if len(candidate) > max_length:
                break
            parts.append(part)
        return " ".join(parts)

    @staticmethod
    def _history_timestamp(record: dict) -> str:
        try:
            value = float(
                record.get(
                    "started_at_epoch", record.get("ended_at_epoch", 0.0)
                )
                or 0.0
            )
            return dt.datetime.fromtimestamp(value).strftime("%Y-%m-%d  %H:%M:%S")
        except (OSError, OverflowError, TypeError, ValueError):
            return "时间未知"

    @staticmethod
    def _history_report_compact_number(value: object) -> str:
        if isinstance(value, str):
            value = value.replace(",", "").replace("，", "").strip()
        try:
            number = max(0.0, float(value or 0.0))
        except (TypeError, ValueError, OverflowError):
            number = 0.0
        if not math.isfinite(number):
            number = 0.0
        if number >= 100_000_000:
            return f"{number / 100_000_000:.2f} 亿"
        if number >= 10_000:
            return f"{number / 10_000:.1f} 万"
        return format_number(number)

    def _history_team_report_rows(
        self, record: dict, mode: str
    ) -> list[dict[str, object]]:
        mode = str(mode or "dps").casefold()
        if mode not in {"dps", "hps", "dt", "boss_damage"}:
            mode = "dps"
        if mode == "boss_damage":
            def integer(value: object) -> int:
                try:
                    return int(value or 0)
                except (TypeError, ValueError, OverflowError):
                    return 0

            def number(value: object) -> float:
                try:
                    parsed = float(value or 0.0)
                except (TypeError, ValueError, OverflowError):
                    return 0.0
                return parsed if math.isfinite(parsed) else 0.0

            boss_damage = self._history_boss_damage(record)
            total = max(0, integer(boss_damage.get("observed_damage")))
            rows: list[dict[str, object]] = []
            for source_index, source in enumerate(
                self._history_boss_sources(record)
            ):
                amount = max(0, integer(source.get("damage")))
                share = number(source.get("share"))
                if share <= 0.0 and total > 0:
                    share = amount / total
                rows.append(
                    {
                        "actor_id": max(
                            0, integer(source.get("entity_id"))
                        ),
                        "name": str(source.get("name", "")).strip()
                        or "首领来源",
                        "profession_id": 0,
                        "is_self": False,
                        "amount": amount,
                        "rate": max(0, integer(source.get("hits"))),
                        "share": min(1.0, max(0.0, share)),
                        "source_index": source_index,
                        "template_id": max(
                            0, integer(source.get("template_id"))
                        ),
                        "kind": str(source.get("kind", "boss") or "boss"),
                    }
                )
            rows.sort(
                key=lambda row: (
                    int(row.get("amount", 0) or 0),
                    -int(row.get("source_index", 0) or 0),
                ),
                reverse=True,
            )
            return rows
        base_rows = record.get("participants", [])
        base_rows = (
            [row for row in base_rows if isinstance(row, dict)]
            if isinstance(base_rows, list)
            else []
        )
        collection_name = "healers" if mode == "hps" else "damage_taken" if mode == "dt" else "participants"
        metric_rows = record.get(collection_name, [])
        metric_rows = (
            [row for row in metric_rows if isinstance(row, dict)]
            if isinstance(metric_rows, list)
            else []
        )
        metric_by_actor = {
            int(row.get("actor_id", 0) or 0): row
            for row in metric_rows
            if int(row.get("actor_id", 0) or 0) > 0
        }
        used_actor_ids: set[int] = set()
        merged: list[dict] = []
        for base in base_rows:
            actor_id = int(base.get("actor_id", 0) or 0)
            metric = metric_by_actor.get(actor_id)
            if metric is None:
                base_name = str(base.get("name", "")).strip().casefold()
                metric = next(
                    (
                        row
                        for row in metric_rows
                        if base_name
                        and str(row.get("name", "")).strip().casefold() == base_name
                    ),
                    None,
                )
            combined = dict(base)
            if isinstance(metric, dict):
                combined.update(metric)
                if actor_id > 0:
                    used_actor_ids.add(actor_id)
            merged.append(combined)
        for metric in metric_rows:
            actor_id = int(metric.get("actor_id", 0) or 0)
            if actor_id > 0 and actor_id in used_actor_ids:
                continue
            if any(
                str(existing.get("name", "")).strip().casefold()
                == str(metric.get("name", "")).strip().casefold()
                for existing in merged
                if str(metric.get("name", "")).strip()
            ):
                continue
            merged.append(dict(metric))

        duration = dps_duration_seconds(
            record.get(
                "hps_duration_seconds" if mode == "hps" else "dps_duration_seconds",
                record.get("duration_seconds", 0.0),
            )
        )
        if mode == "hps":
            total = max(0, int(record.get("team_effective_healing", 0) or 0))
            amount_key = "effective_healing"
        elif mode == "dt":
            total = max(0, int(record.get("team_taken", 0) or 0))
            amount_key = "taken"
        else:
            total = max(0, int(record.get("total_damage", 0) or 0))
            amount_key = "damage"

        normalized: list[dict[str, object]] = []
        for source_index, row in enumerate(merged):
            try:
                amount = max(0, int(row.get(amount_key, 0) or 0))
            except (TypeError, ValueError, OverflowError):
                amount = 0
            try:
                share = float(row.get("share", 0.0) or 0.0)
            except (TypeError, ValueError, OverflowError):
                share = 0.0
            if mode == "dt":
                try:
                    share = float(row.get("taken_share", share) or share)
                except (TypeError, ValueError, OverflowError):
                    pass
            if mode == "hps":
                share = amount / total if total > 0 else 0.0
            elif share <= 0 and total > 0:
                share = amount / total
            share = min(1.0, max(0.0, share))
            raw_rate = row.get("hps" if mode == "hps" else "dps")
            try:
                rate = max(0.0, float(raw_rate)) if raw_rate is not None else 0.0
            except (TypeError, ValueError, OverflowError):
                rate = 0.0
            if rate <= 0 and duration > 0 and mode != "dt":
                rate = amount / duration
            normalized.append(
                {
                    "actor_id": int(row.get("actor_id", 0) or 0),
                    "name": str(row.get("name", "")).strip(),
                    "profession_id": int(row.get("profession_id", 0) or 0),
                    "is_self": row.get("is_self") is True,
                    "amount": amount,
                    "rate": share if mode == "dt" else rate,
                    "share": share,
                    "source_index": source_index,
                }
            )
        normalized.sort(
            key=lambda row: (
                int(row.get("amount", 0) or 0),
                -int(row.get("source_index", 0) or 0),
            ),
            reverse=True,
        )
        return normalized[:MAX_PARTY_MEMBERS]

    @staticmethod
    def _history_report_asset(
        path: Path,
        size: int,
        *,
        fallback_text: str,
        fallback_color: str,
    ) -> Image.Image:
        try:
            image = Image.open(path).convert("RGBA")
            image.thumbnail((size, size), Image.Resampling.LANCZOS)
            target = Image.new("RGBA", (size, size), (0, 0, 0, 0))
            target.alpha_composite(
                image, ((size - image.width) // 2, (size - image.height) // 2)
            )
            return IconFactory._rounded(target, max(4, size // 7))
        except (OSError, ValueError):
            image = Image.new("RGBA", (size, size), fallback_color)
            draw = ImageDraw.Draw(image, "RGBA")
            draw.rectangle((0, 0, size - 1, size - 1), outline=(255, 255, 255, 60), width=1)
            text = (str(fallback_text or "?").strip() or "?")[:1]
            font = IconFactory._font(max(13, int(size * 0.42)), bold=True)
            box = draw.textbbox((0, 0), text, font=font)
            draw.text(
                (
                    (size - (box[2] - box[0])) / 2 - box[0],
                    (size - (box[3] - box[1])) / 2 - box[1],
                ),
                text,
                font=font,
                fill=(245, 248, 250, 235),
            )
            return IconFactory._rounded(image, max(4, size // 7))

    def _render_history_team_report_image(
        self, record: dict, mode: str, *, hide_names: bool | None = None
    ) -> Image.Image:
        """Render a compact, shareable team battle card."""

        mode = str(mode or "dps").casefold()
        if mode not in {"dps", "hps", "dt", "boss_damage"}:
            mode = "dps"
        hidden = self._history_names_hidden() if hide_names is None else bool(hide_names)
        rows = self._history_team_report_rows(record, mode)
        participants = record.get("participants", [])
        participants = [row for row in participants if isinstance(row, dict)] if isinstance(participants, list) else []
        by_actor = {
            int(row.get("actor_id", 0) or 0): row
            for row in participants
            if int(row.get("actor_id", 0) or 0) > 0
        }
        width = 1080
        row_height = 44
        columns = 2
        visible_rows = rows[:30]
        table_rows = max(1, (len(visible_rows) + columns - 1) // columns)
        height = 222 + table_rows * row_height + 48
        image = Image.new("RGB", (width, height), "#080c10")
        draw = ImageDraw.Draw(image)
        font_title = IconFactory._font(24, bold=True)
        font_heading = IconFactory._font(15, bold=True)
        font_body_bold = IconFactory._font(13, bold=True)
        font_small = IconFactory._font(10)
        font_number = IconFactory._font(16, bold=True)

        def fit_text(value: object, limit: int, font: ImageFont.FreeTypeFont) -> str:
            shown = str(value or "")
            if draw.textlength(shown, font=font) <= limit:
                return shown
            while shown and draw.textlength(shown + "…", font=font) > limit:
                shown = shown[:-1]
            return shown + "…"

        boss_name = self._history_encounter_title(record)
        dungeon_name = str(record.get("dungeon_name", "")).strip()
        difficulty = str(record.get("difficulty", "")).strip()
        result_text, result_color = self._history_result_presentation(record.get("result"))
        completeness = str(record.get("completeness", ""))
        boss_damage = self._history_boss_damage(record) if mode == "boss_damage" else {}
        boss_coverage = str(boss_damage.get("coverage", ""))
        boss_data_available = boss_coverage in {"complete", "observed_partial", "conflict"}
        if mode == "boss_damage":
            completeness_text = (
                "训练目标" if boss_damage.get("unavailable_reason") == "training_dummy"
                else {
                    "complete": "数据完整",
                    "observed_partial": "已观测部分",
                    "conflict": "数据冲突",
                }.get(boss_coverage, "未记录首领伤害")
            )
        else:
            completeness_text = {
                COMPLETENESS_COMPLETE: "数据完整",
                COMPLETENESS_LIMITED: "基础数据",
            }.get(completeness, "部分数据")
        duration = self._history_display_duration(record, mode == "hps")
        player_name = str(record.get("my_name", "")).strip()
        if not player_name:
            player = next((row for row in participants if row.get("is_self") is True), {})
            player_name = str(player.get("name", "未知玩家")).strip() or "未知玩家"
        if hidden:
            player_name = "已隐藏"
        mode_title = {
            "dps": "伤害 DPS",
            "hps": "治疗 HPS",
            "dt": "承伤 DT",
            "boss_damage": "Boss 伤害",
        }[mode]
        context = " · ".join(part for part in (dungeon_name, difficulty, mode_title) if part)
        if mode == "boss_damage":
            total_amount = boss_damage.get("observed_damage")
            rate_text = (
                self._history_rate_text(boss_damage.get("classification_ratio"))
                if boss_data_available else "--"
            )
            amount_text = (
                self._history_report_compact_number(total_amount)
                if boss_data_available and total_amount is not None else "--"
            )
            summary_labels = ("归类比例", "已归类首领伤害", "确认来源")
            population_text = f"{len(rows)} 个"
            table_title = "首领 / 机制来源"
            table_caption = "命中次数 · 来源伤害 · 占比"
        else:
            amount_key, rate_key, summary_labels, table_caption = {
                "dps": ("total_damage", "team_dps", ("团队 DPS", "团队总伤害", "已记录队员"), "DPS · 总伤害 · 占比"),
                "hps": ("team_effective_healing", "team_hps", ("团队 HPS", "团队有效治疗", "已记录队员"), "HPS · 有效治疗 · 占比"),
                "dt": ("team_taken", "", ("最高承伤占比", "团队总承伤", "已记录队员"), "承伤占比 · 总承伤"),
            }[mode]
            total_amount = record.get(amount_key)
            amount_text = (
                self._history_report_compact_number(total_amount)
                if total_amount is not None else "--"
            )
            if mode == "dt":
                rate_text = (
                    f"{max(float(row.get('share', 0.0) or 0.0) for row in rows) * 100:.1f}%"
                    if rows else "--"
                )
            else:
                rate = record.get(rate_key)
                if rate is None and total_amount is not None and duration > 0:
                    rate = self._history_numeric_float(total_amount) / duration
                rate_text = self._history_report_compact_number(rate) if rate is not None else "--"
            population_text = f"{len(rows)} 人"
            table_title = "全员战斗表现"

        draw.rounded_rectangle((12, 12, width - 12, 112), radius=7,
                               fill="#121a20", outline="#34464d", width=1)
        draw.rectangle((12, 12, 16, 112), fill=ACCENT)
        monster = record.get("monster")
        monster = monster if isinstance(monster, dict) else {}
        template_id = str(monster.get("template_id", 0) or 0)
        try:
            portrait_manifest = json.loads(
                (ASSET_DIR / "bosses" / "hud" / "manifest.json").read_text(encoding="utf-8-sig")
            )
            portrait_name = str(portrait_manifest.get("templates", {}).get(template_id, "") or "")
        except (OSError, TypeError, ValueError, AttributeError):
            portrait_name = ""
        portrait_path = ASSET_DIR / "bosses" / "hud" / Path(portrait_name).name
        icon_name = Path(str(record.get("boss_icon", "") or "")).name
        if not icon_name:
            icon_name = Path(self._history_boss_icon_name({
                "template_id": monster.get("template_id", 0), "name": boss_name,
            })).name
        icon_path = (
            portrait_path if portrait_name and portrait_path.is_file()
            else ASSET_DIR / "bosses" / icon_name if icon_name else Path()
        )
        boss_icon = self._history_report_asset(
            icon_path, 62, fallback_text=boss_name, fallback_color="#63502b"
        )
        image.paste(boss_icon, (30, 31), boss_icon)
        draw.text((108, 25), fit_text(context, 820, font_body_bold),
                  font=font_body_bold, fill=WARN)
        draw.text((108, 47), fit_text(boss_name, 820, font_title), font=font_title, fill=TEXT)
        draw.text(
            (108, 82),
            fit_text(
                f"{self._history_timestamp(record)}  ·  战斗时长 {format_duration(duration)}  ·  截图玩家：{player_name}",
                820, font_small,
            ),
            font=font_small, fill=MUTED,
        )
        badge_right = width - 28
        draw.rounded_rectangle((badge_right - 100, 30, badge_right, 58),
                               radius=4,
                               fill=blend_color("#121a20", result_color, 0.2),
                               outline=result_color, width=1)
        result_box = draw.textbbox((0, 0), result_text, font=font_body_bold)
        draw.text((badge_right - 12 - (result_box[2] - result_box[0]), 36),
                  result_text, font=font_body_bold, fill=result_color)
        draw.text((badge_right - 10, 72), completeness_text,
                  font=font_small, fill=MUTED, anchor="ra")

        summary = (
            (summary_labels[0], rate_text, ACCENT),
            (summary_labels[1], amount_text, "#70b9e6"),
            ("战斗时长", format_duration(duration), "#8ed17c"),
            (summary_labels[2], population_text, "#c49bea"),
        )
        summary_top, summary_bottom = 122, 190
        cell_width = (width - 24) / len(summary)
        for index, (caption, value, color) in enumerate(summary):
            left = int(12 + cell_width * index)
            right = int(12 + cell_width * (index + 1))
            draw.rectangle((left, summary_top, right, summary_bottom),
                           fill="#151d23", outline="#2f3b42")
            draw.rectangle((left, summary_top, left + 3, summary_bottom), fill=color)
            draw.text((left + 14, summary_top + 11), caption, font=font_small, fill=MUTED)
            draw.text((left + 14, summary_top + 31), value, font=font_number, fill=color)

        table_top = 202
        draw.rectangle((12, table_top, width - 12, table_top + 28),
                       fill="#0f151a", outline="#2f3b42")
        draw.text((26, table_top + 8), table_title, font=font_heading, fill=TEXT)
        draw.text((width - 26, table_top + 9),
                  table_caption,
                  font=font_small, fill=MUTED, anchor="ra")

        highest = max((int(row.get("amount", 0) or 0) for row in visible_rows), default=0)
        col_width = (width - 36) // columns
        roster_top = table_top + 28
        if not visible_rows:
            empty_text = (
                self._history_boss_coverage_text(boss_damage)[0]
                if mode == "boss_damage" else "暂无可用队伍数据"
            )
            draw.text((26, roster_top + 13), empty_text, font=font_body_bold, fill=MUTED)
        for index, row in enumerate(visible_rows):
            col = index // table_rows
            row_index = index % table_rows
            left = 12 + col * col_width
            right = left + col_width - 4
            top = roster_top + row_index * row_height
            bottom = top + row_height - 1
            base = "#12191f" if row_index % 2 == 0 else "#0e1419"
            draw.rectangle((left, top, right, bottom), fill=base, outline="#26333a")
            if mode != "boss_damage" and row.get("is_self") is True:
                draw.rectangle((left, top, left + 3, bottom), fill=ACCENT)
            amount = int(row.get("amount", 0) or 0)
            ratio = amount / highest if highest else 0.0
            if ratio:
                draw.rectangle((left + 92, bottom - 4,
                                left + 92 + int((right - left - 190) * ratio), bottom - 2),
                               fill=blend_color(base, ACCENT, 0.55))
            actor = by_actor.get(int(row.get("actor_id", 0) or 0), {})
            class_id = int(row.get("profession_id", 0) or actor.get("profession_id", 0) or 0)
            _profession, profession_color = self._profession_info(class_id)
            if mode == "boss_damage":
                icon_name = self._history_boss_icon_name(row)
                icon_path = ASSET_DIR / "bosses" / Path(icon_name).name if icon_name else Path()
                icon_text = str(row.get("name") or "首领")
                profession_color = "#e67d72"
            else:
                icon_path = ASSET_DIR / "professions" / f"{class_id}.png"
                icon_text = IconFactory.PROFESSION_GLYPHS.get(class_id, "?")
            icon = self._history_report_asset(
                icon_path, 24, fallback_text=icon_text,
                fallback_color=profession_color,
            )
            image.paste(icon, (left + 8, top + 9), icon)
            name = str(row.get("name") or actor.get("name") or "未知玩家").strip()
            if hidden and mode != "boss_damage":
                name = "本人" if row.get("is_self") else f"玩家 {index + 1:02d}"
            draw.text((left + 40, top + 6), fit_text(name, 134, font_body_bold),
                      font=font_body_bold, fill=TEXT)
            amount_text = self._history_report_compact_number(amount)
            share = float(row.get("share", 0.0) or 0.0)
            share_text = "<0.1%" if 0 < share < 0.001 else f"{share * 100:.1f}%"
            if mode == "boss_damage":
                primary_text = f"{int(row.get('rate', 0) or 0)} 次命中"
                template_id = int(row.get("template_id", 0) or 0)
                secondary_text = f"模板 {template_id}" if template_id else str(row.get("kind") or "")
                share_label = share_text
            elif mode == "dt":
                primary_text = f"{share_text} 承伤占比"
                secondary_text = ""
                share_label = ""
            else:
                rate_value = float(row.get("rate", 0.0) or 0.0)
                rate_shown = "<1" if 0 < rate_value < 1 else self._history_report_compact_number(rate_value)
                primary_text = f"{rate_shown} {mode.upper()}"
                secondary_text = ""
                share_label = share_text
            if mode != "boss_damage":
                rating = actor.get("extraordinary_rating")
                if rating is None:
                    rating = actor.get("rating")
                if rating is not None:
                    secondary_text = f"评分 {self._history_optional_number(rating)}"
            if secondary_text:
                draw.text((left + 40, top + 25), fit_text(secondary_text, 134, font_small),
                          font=font_small, fill=WARN)
            draw.text((left + 182, top + 6), fit_text(primary_text, 145, font_body_bold),
                      font=font_body_bold, fill=ACCENT)
            draw.text((right - 14, top + 6), amount_text, font=font_body_bold,
                      fill="#70b9e6", anchor="ra")
            if share_label:
                draw.text((right - 14, top + 25), share_label,
                          font=font_small, fill=MUTED, anchor="ra")

        footer_top = roster_top + table_rows * row_height + 8
        draw.text((18, footer_top),
                  f"{UI_BRAND} · 数据范围 {completeness_text}",
                  font=font_small, fill=MUTED)
        return image

    def _history_team_report_output_path(self, record: dict, mode: str) -> Path:
        directory = APP_DIR
        boss_name = re.sub(
            r'[<>:"/\\|?*]+', "-", self._history_encounter_title(record)
        ).strip(" .-") or "Boss"
        try:
            stamp = dt.datetime.fromtimestamp(
                float(record.get("started_at_epoch", 0.0) or 0.0)
            ).strftime("%Y%m%d-%H%M%S")
        except (OSError, OverflowError, TypeError, ValueError):
            stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        mode_label = {
            "dps": "DPS",
            "hps": "HPS",
            "dt": "DT",
            "boss_damage": "BOSS",
        }.get(mode, "DPS")
        filename = f"叨叨诡秘助手-全员战报-{boss_name}-{mode_label}-{stamp}.png"
        path = directory / filename
        suffix = 2
        while path.exists():
            path = directory / f"{Path(filename).stem}-{suffix}.png"
            suffix += 1
        return path

    def _capture_history_team_report_by_id(self, battle_id: str) -> str:
        battle_id = str(battle_id or "")
        summary = next(
            (
                row
                for row in getattr(self, "history_records", [])
                if str(row.get("battle_id", row.get("encounter_id", "")))
                == battle_id
            ),
            None,
        )
        raw_record = self.history_store.load(battle_id) if battle_id else None
        record = self._restore_history_record(raw_record)
        if not isinstance(record, dict) and isinstance(summary, dict) and isinstance(summary.get("participants"), list):
            record = dict(summary)
        if not isinstance(record, dict):
            self._show_notice(
                "全员截图", "这场战斗记录已不存在，请刷新战斗列表。", parent=self.history_window
            )
            return "break"
        if isinstance(summary, dict):
            record = {**record, **summary, "participants": record.get("participants", [])}
        try:
            mode = getattr(self, "history_meter_mode", "dps")
            image = self._render_history_team_report_image(record, mode)
            path = self._history_team_report_output_path(record, mode)
            image.save(path, format="PNG", optimize=True)
        except (OSError, TypeError, ValueError) as exc:
            self._show_notice(
                "全员截图", f"战报图片保存失败：{exc}", parent=self.history_window
            )
            return "break"
        try:
            os.startfile(str(path))
        except (AttributeError, OSError) as exc:
            self._show_notice(
                "全员截图", f"图片已保存，但无法自动打开：{exc}\n{path}",
                parent=self.history_window,
            )
        return "break"

    @staticmethod
    def _history_is_boss(record: dict) -> bool:
        if str(record.get("target_filter", "")).casefold() == "healing_dummy":
            # Pure HPS records are deliberately not Boss records, but they
            # still belong in the history view when the normal filter is on.
            return True
        monster = record.get("monster")
        if not isinstance(monster, dict):
            return False
        try:
            boss_rank = int(monster.get("boss_rank", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            boss_rank = 0
        try:
            boss_type = int(monster.get("boss_type", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            boss_type = 0
        entity_type = str(monster.get("entity_type", "")).casefold()
        return (
            boss_rank >= 3
            or boss_type == 3
            or "boss" in entity_type
            or "首领" in entity_type
        )

    def _initial_history_geometry(self, x: int, y: int) -> str:
        saved = str(self.config.get("history_geometry", ""))
        parsed = parse_absolute_tk_geometry(saved)
        if parsed is not None:
            saved_width, saved_height, saved_x, saved_y = parsed
            width = max(900, saved_width)
            height = max(600, saved_height)
            x, y = saved_x, saved_y
        else:
            width = BACKEND_WIDTH
            height = BACKEND_HEIGHT
        return self._visible_geometry(
            format_absolute_tk_geometry(width, height, x, y),
            BACKEND_WIDTH,
            BACKEND_HEIGHT,
        )

    def show_history(self) -> None:
        self.show_backend("history")

    def show_main_menu(self) -> None:
        self.show_backend("history")

    def show_settings(self) -> None:
        if SETTINGS_TEMPORARILY_DISABLED:
            return
        if getattr(self, 'closing', False) or getattr(self, 'settings_open_after_id', None) is not None:
            return

        def open_settings() -> None:
            self.settings_open_after_id = None
            if getattr(self, 'closing', False):
                return
            previous_window = getattr(self, 'history_window', None)
            try:
                self.show_backend('settings')
            except Exception:
                details = traceback.format_exc()
                try:
                    with (APP_DIR / 'dps_error.log').open('a', encoding='utf-8') as output:
                        output.write(f'\n[{time.strftime("%Y-%m-%d %H:%M:%S")}] open_settings\n{details}\n')
                except OSError:
                    pass
                partial_window = getattr(self, 'history_window', None)
                if partial_window is not previous_window:
                    try:
                        if partial_window is not None and partial_window.winfo_exists():
                            partial_window.destroy()
                    except tk.TclError:
                        pass
                    self.history_window = previous_window
                self.main_window_intentionally_hidden = False
                try:
                    self.root.deiconify()
                    self._schedule_layered_main_render()
                    self._show_notice('设置未能打开', '主窗口已恢复，请重试；若再次出现，请提交反馈以便检查错误日志。', parent=self.root)
                except tk.TclError:
                    pass

        # Finish the mouse-release callback before mapping another toplevel
        # or withdrawing the per-pixel-alpha HWND which owns that callback.
        self.settings_open_after_id = self.root.after(0, open_settings)

    def show_backend(self, page: str = "history") -> None:
        if self.compact_mode:
            return
        page = str(page or "history")
        if page == "settings" and SETTINGS_TEMPORARILY_DISABLED:
            page = "history"
        if page not in {"history", "kings", "alliance", "updates", "settings"}:
            page = "history"
        # Preserve the requested page while the shared backend window is
        # being built; otherwise opening Settings briefly creates a topmost
        # History page before the second page switch runs.
        self.backend_current_page = page
        if page in {"history", "kings"}:
            self._sync_history_meter_tabs()
        window_created = (
            self.history_window is None or not self.history_window.winfo_exists()
        )
        window_was_viewable = (
            not window_created and self.history_window.winfo_viewable()
        )
        if window_created:
            self._build_history_window()
        else:
            self._select_backend_page(page)
        self.tray_history_hidden = False
        self._hide_main_tooltip()
        self._close_notice_window()
        self._remember_root_geometry()
        self._destroy_unlock_window()
        if getattr(self, "membership_label", None) is not None:
            self._sync_expiry_label()
        if getattr(self, "backend_connection_label", None) is not None:
            self._sync_backend_sidebar_status()
        self.history_window.deiconify()
        if window_created or not window_was_viewable:
            self._sync_backend_window_topmost()
        self.history_window.lift()
        self.main_window_intentionally_hidden = True
        self.root.withdraw()
        self.history_window.lift()
        # An explicit click asks to activate this window, not to make it
        # permanently topmost. focus_set alone can leave it behind the game.
        self.history_window.focus_force()
        if not self.history_window.winfo_viewable():
            after_idle = getattr(self.history_window, "after_idle", None)
            if callable(after_idle):
                after_idle(
                    lambda window=self.history_window: self._finish_backend_window_map(window)
                )
            else:
                self.history_window.update_idletasks()

    def _finish_backend_window_map(self, window) -> None:
        """Complete native mapping after the click handler has returned."""

        try:
            if window is not self.history_window or not window.winfo_exists():
                return
            window.update_idletasks()
            if not window.winfo_viewable():
                window.deiconify()
            window.lift()
            window.focus_force()
        except (AttributeError, tk.TclError):
            pass

