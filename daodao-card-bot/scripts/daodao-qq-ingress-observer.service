[Unit]
Description=Passive QQ message ingress diagnostics
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=daodao-card-bot
WorkingDirectory=/opt/daodao-card-bot
ExecStart=/opt/daodao-card-bot/.venv/bin/python -m app.ingress_observer
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/daodao-card-bot/logs
MemoryMax=96M
CPUQuota=10%
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
