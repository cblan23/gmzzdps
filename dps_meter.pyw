        footer = tk.Frame(content, bg=BG)
        footer.pack(fill="x", pady=(px(18), 0))
        tk.Label(
            footer,
            text="继续使用前，请确认你已知晓并接受上述风险",
            bg=BG,
            fg=SUBTLE,
            anchor="w",
            font=self._ui_font("body"),
        ).pack(side="left", fill="x", expand=True)
        understood = self._label_button(
            footer,
            "我已了解",
            self._close_user_notice,
            width=px(112),
            bg=ACCENT,
            hover="#86edca",
            fg="#07110e",
            font=self._ui_font("strong"),
        )
        understood.pack(side="right", ipady=px(8))
        window.update_idletasks()
        fitted_width = max(width, window.winfo_reqwidth())
        fitted_height = max(height, window.winfo_reqheight())
        if (fitted_width, fitted_height) != (width, height):
            x = parent.winfo_rootx() + (parent.winfo_width() - fitted_width) // 2
            y = parent.winfo_rooty() + (parent.winfo_height() - fitted_height) // 2
            window.geometry(
                self._visible_geometry(
                    format_absolute_tk_geometry(
                        fitted_width, fitted_height, x, y
                    ),
                    fitted_width,
                    fitted_height,
                )
            )
            window.update_idletasks()
        window.deiconify()
        window.lift(parent)
        window.after(20, lambda: self._apply_windows_style(window))
        window.grab_set()
        window.focus_force()

    def _close_user_notice(self) -> None:
        window = self.user_notice_window
        if window is not None and window.winfo_exists():
            try:
                window.grab_release()
            except tk.TclError:
                pass
            window.destroy()
        self.user_notice_window = None
        parent = self.login_window
        if (
            not self.closing
            and parent is not None
            and parent.winfo_exists()
        ):
            parent.lift()
            parent.focus_force()

    def _show_login_placeholder(self) -> None:
        entry = self.login_card_entry
        if entry is None or not entry.winfo_exists() or entry.get():
            return
        self.login_placeholder_active = True
        entry.configure(fg=MUTED)
        entry.insert(0, "请输入卡号")

    def _login_entry_focus_in(self, _event=None) -> None:
        entry = self.login_card_entry
        if entry is None:
            return
        if self.login_placeholder_active:
            entry.icursor(0)

    def _login_entry_prepare_input(self, _event=None) -> None:
        entry = self.login_card_entry
        if entry is None or not self.login_placeholder_active:
            return
        entry.delete(0, "end")
        entry.configure(fg=TEXT)
        self.login_placeholder_active = False

    def _login_entry_key_press(self, event=None) -> None:
        if event is not None and event.keysym in {
            "Control_L",
            "Control_R",
            "Shift_L",
            "Shift_R",
            "Alt_L",
            "Alt_R",
            "Tab",
        }:
            return
        self._login_entry_prepare_input()

    def _login_entry_focus_out(self, _event=None) -> None:
        entry = self.login_card_entry
        if entry is None or entry.get().strip():
            return
        self._show_login_placeholder()

    def _set_login_status(self, message: str, *, error: bool = True) -> None:
        self.login_status_message = str(message).strip()
        if self.login_status_label is not None and self.login_status_label.winfo_exists():
            display_message = self.login_status_message or LOGIN_ADMIN_REMINDER
            foreground = (
                ERROR
                if self.login_status_message and error
                else MUTED
                if self.login_status_message
                else WARN
            )
            self.login_status_label.configure(
                text=display_message,
                fg=foreground,
            )

    def _login_disclaimer_accepted(self) -> bool:
        return bool(
            self.login_disclaimer_var is not None
            and self.login_disclaimer_var.get()
        )

    def _sync_login_disclaimer_state(self, *, hover: bool = False) -> None:
        button = self.login_button
        if button is None or not button.winfo_exists():
            return
        accepted = self._login_disclaimer_accepted()
        button.configure(
            bg="#86edca" if accepted and hover else ACCENT if accepted else PANEL_2,
            fg="#07110e" if accepted else SUBTLE,
            cursor="hand2" if accepted else "arrow",
        )

    def _sync_login_trial_button_state(self, *, hover: bool = False) -> None:
        button = self.login_trial_button
        if button is None or not button.winfo_exists():
            return
        pending = bool(self.trial_claim_in_progress)
        button.configure(
            text="获取中" if pending else "获取试用",
            bg=PANEL_2 if hover and not pending else PANEL,
            fg=MUTED if pending else "#86edca" if hover else ACCENT,
            cursor="arrow" if pending else "hand2",
        )

    def _request_trial_card(self) -> None:
        if (
            self.closing
            or self.authorization_resetting
            or self.trial_claim_in_progress
        ):
            return
        self.trial_claim_in_progress = True
        self._sync_login_trial_button_state()
        self._set_login_status("正在获取试用卡…", error=False)

        def claim() -> None:
            try:
                result = self.licensing.claim_trial_card()
            except LicensingConnectionError:
                result = TrialClaim(False, TRIAL_CLAIM_FAILURE_MESSAGE)
            except Exception:
                result = TrialClaim(False, TRIAL_CLAIM_FAILURE_MESSAGE)
            self.control_messages.put(("trial_claim_result", result))

        threading.Thread(
            target=claim, name="trial-card-claim", daemon=True
        ).start()

    def _handle_trial_claim_result(self, payload: object) -> None:
        self.trial_claim_in_progress = False
        self._sync_login_trial_button_state()
        if not isinstance(payload, TrialClaim):
            self._set_login_status(TRIAL_CLAIM_FAILURE_MESSAGE)
            return
        if not payload.accepted or not payload.card_key:
            self._set_login_status(payload.message or TRIAL_CLAIM_FAILURE_MESSAGE)
            return
        entry = self.login_card_entry
        if entry is None or not entry.winfo_exists():
            return
        entry.delete(0, "end")
        entry.configure(fg=TEXT)
        entry.insert(0, payload.card_key)
        entry.selection_range(0, "end")
        entry.icursor("end")
        self.login_placeholder_active = False
        self._set_login_status(
            payload.message or "2 小时试用卡领取成功，请点击“登录”。",
            error=False,
        )
        entry.focus_set()

    def _complete_card_login(self) -> None:
        if self.closing or self.authorization_resetting:
            return
        if bool(getattr(self, "trial_claim_in_progress", False)):
            self._set_login_status("正在获取试用卡，请稍候。", error=False)
            return
        if not self._login_disclaimer_accepted():
            self._set_login_status("请先阅读并同意用户须知。")
            self._sync_login_disclaimer_state()
            return
        card_key = (
            self.login_card_entry.get().strip()
            if self.login_card_entry is not None
            and not self.login_placeholder_active
            else ""
        )
        if not card_key:
            self._set_login_status("请输入卡号后再登录。")
            return
        if self.login_button is not None:
            self.login_button.configure(text="正在验证", bg=PANEL_2, fg=MUTED)
        if self.login_window is not None:
            self.login_window.update_idletasks()
        try:
            session = self.licensing.sign_in_card(card_key)
        except LicensingConnectionError as exc:
            self._set_login_status(str(exc))
            if self.login_button is not None:
                self.login_button.configure(text="登录", bg=ACCENT, fg="#07110e")
            return
        if not session.active:
            self._set_login_status(
                session.display_name
                or "登录失败，请稍后重试；若持续出现，请联系管理员。"
            )
            if self.login_button is not None:
                self.login_button.configure(text="登录", bg=ACCENT, fg="#07110e")
            return
        try:
            capability = session.runtime_capability
            if capability is None:
                if RELEASE_IDENTITY.protected:
                    raise RuntimeCapabilityError(
                        "受保护客户端未取得服务器下发的采集授权"
                    )
                capability = create_development_capability(
                    DEVELOPMENT_RUNTIME_PROFILE_PATH,
                    session_id=session.session_id,
                    client_id=self.client_id,
                    build_id=RELEASE_IDENTITY.build_id,
                    client_build=CLIENT_BUILD,
                )
                session = self.licensing.set_runtime_capability(capability)
            else:
                capability = RuntimeCapability.from_value(
                    capability,
                    expected_session_id=session.session_id,
                    expected_client_id=self.client_id,
                    expected_build_id=RELEASE_IDENTITY.build_id,
                    expected_client_build=CLIENT_BUILD,
                    trusted_public_keys=(
                        RELEASE_IDENTITY.capability_public_keys
                    ),
                    allow_development=not RELEASE_IDENTITY.protected,
                )
        except RuntimeCapabilityError as exc:
            try:
                self.licensing.sign_out()
            except LicensingConnectionError:
                pass
            self._set_login_status(
                SYSTEM_TIME_SYNC_MESSAGE
                if isinstance(exc, RuntimeCapabilityTimeError)
                else CARD_LOGIN_FAILURE_MESSAGE
            )
            if self.login_button is not None:
                self.login_button.configure(text="登录", bg=ACCENT, fg="#07110e")
            return
        if remember_card(self.config, card_key):
            save_config(self.config)
        if self._login_disclaimer_accepted() and not bool(
            self.config.get("user_notice_accepted", False)
        ):
            self.config["user_notice_accepted"] = True
            save_config(self.config)
        self.login_status_message = ""
        self._close_user_notice()
        if self.login_window is not None and self.login_window.winfo_exists():
            try:
                self.login_window.grab_release()
            except tk.TclError:
                pass
            self.login_window.destroy()
        self.login_window = None
        self.login_card_entry = None
        self.login_status_label = None
        self.login_consent_row = None
        self.login_button = None
        self.login_trial_button = None
        self.login_disclaimer_var = None
        self.main_window_intentionally_hidden = False
        self.root.deiconify()
        self.root.update_idletasks()
        self._apply_window_dpi_if_changed(force=True)
        self.root.lift()
        if not self.window_locked:
            self.root.focus_force()
        self._sync_expiry_label()
        self.root.after(20, lambda: self._apply_windows_style(self.root))
        self.root.after(30, self._apply_window_lock_state)
        self.root.after(45, self._apply_main_transparency)
        self.heartbeat_stop_event = threading.Event()
        self.heartbeat_worker = LicenseHeartbeatWorker(
            self.licensing, self.control_messages, self.heartbeat_stop_event
        )
        self.heartbeat_worker.start()
        self.combat_clock_stop_event = threading.Event()
        self.combat_clock_worker = CombatClockWorker(
            self.licensing,
            self.control_messages,
            self.combat_clock_stop_event,
        )
        self.combat_clock_worker.start()
        self._start_capture()
        self._start_update_check()

    def _start_capture(self) -> None:
        if self.capture_started or self.closing:
            return
        capability = self.licensing.session.runtime_capability
        if capability is None:
            self._return_to_login("采集授权缺失，请重新登录。")
            return
        self.stop_event = threading.Event()
        self.worker = HookWorker(
            self.messages,
            self.stop_event,
            runtime_capability=capability,
            allow_development_capability=not RELEASE_IDENTITY.protected,
            trusted_capability_public_keys=(
                RELEASE_IDENTITY.capability_public_keys
            ),
            target_boss_lookup_enabled=self.target_boss_lookup_enabled,
        )
        self.capture_started = True
        self.worker.start()

    def _start_update_check(self, *, manual: bool = False) -> None:
        if (
            getattr(self, "update_check_in_progress", False)
            or getattr(self, "rollback_check_in_progress", False)
            or getattr(self, "update_downloading", False)
            or getattr(self, "closing", False)
        ):
            return
        if getattr(self, "update_check_started", False) and not manual:
            return
        self.update_check_started = True
        self.update_check_in_progress = True
        self._refresh_update_page()

        def check() -> None:
            try:
                update = self.licensing.check_update()
                payload = {"manual": manual, "update": update, "error": ""}
            except LicensingConnectionError as exc:
                payload = {"manual": manual, "update": None, "error": str(exc)}
            except Exception:
                payload = {
                    "manual": manual,
                    "update": None,
                    "error": "检查更新失败，请稍后重试。",
                }
            self.control_messages.put(("update_check_result", payload))

        threading.Thread(target=check, name="update-check", daemon=True).start()

    def _handle_update_check_result(self, payload: object) -> None:
        self.update_check_in_progress = False
        if not isinstance(payload, dict):
            self._refresh_update_page("更新检查返回了无效结果。")
            return
        manual = bool(payload.get("manual"))
        update = payload.get("update")
        error = str(payload.get("error", "")).strip()
        if isinstance(update, UpdateInfo) and update.available:
            self._cache_available_update(update)
            return
        if not manual:
            self._refresh_update_page()
            return
        self.pending_update = None
        if error:
            self._refresh_update_page(error)
            return
        self._refresh_update_page(
            f"当前已是最新版本，更新文件保存位置：{UPDATE_DIR}"
        )

    def _cache_available_update(self, update: UpdateInfo) -> None:
        if self.closing:
            return
        self.pending_update = update
        self._refresh_update_page()

    def _update_page_action(self) -> None:
        if self.pending_update is not None and self.pending_update.available:
            self._download_pending_update()
        else:
            self._start_update_check(manual=True)

    def _start_version_rollback(self, version: object) -> None:
        target_version = normalize_rollback_version(version)
        if not rollback_version_is_supported(target_version):
            self._show_notice(
                "无法回滚",
                "版本回滚仅支持 v0.1.0 及以上版本。",
                parent=self.history_window,
            )
            return
        if target_version == normalize_rollback_version(APP_VERSION):
            return
        if (
            self.update_check_in_progress
            or self.rollback_check_in_progress
            or self.update_downloading
        ):
            self._refresh_update_page("已有更新或回滚任务正在进行，请稍候。")
            return

        self._show_notice(
            "确认版本回滚",
            f"确定回滚到 v{target_version} 吗？",
            parent=self.history_window,
            confirm_text="确认回滚",
            cancel_text="取消",
            on_confirm=lambda: self._request_version_rollback(target_version),
        )

    def _request_version_rollback(self, version: str) -> None:
        target_version = normalize_rollback_version(version)
        if (
            not rollback_version_is_supported(target_version)
            or target_version == normalize_rollback_version(APP_VERSION)
            or self.update_check_in_progress
            or self.rollback_check_in_progress
            or self.update_downloading
            or self.closing
        ):
            return
        self.pending_update = None
        self.rollback_requested_version = target_version
        self.rollback_check_in_progress = True
        self._refresh_update_page(f"正在获取 v{target_version} 的回滚信息…")

        def check() -> None:
            try:
                update = self.licensing.check_rollback(target_version)
                payload = {
                    "version": target_version,
                    "update": update,
                    "error": "",
                }
            except LicensingConnectionError as exc:
                payload = {
                    "version": target_version,
                    "update": None,
                    "error": str(exc),
                }
            except Exception:
                payload = {
                    "version": target_version,
                    "update": None,
                    "error": "获取回滚版本失败，请稍后重试。",
                }
            self.control_messages.put(("rollback_check_result", payload))

        threading.Thread(
            target=check,
            name="rollback-check",
            daemon=True,
        ).start()

    def _handle_rollback_check_result(self, payload: object) -> None:
        self.rollback_check_in_progress = False
        if not isinstance(payload, dict):
            self.rollback_requested_version = ""
            self._refresh_update_page("回滚信息返回了无效结果。")
            return
        target_version = normalize_rollback_version(payload.get("version"))
        update = payload.get("update")
        error = str(payload.get("error", "")).strip()
        if (
            not target_version
            or target_version != self.rollback_requested_version
            or not isinstance(update, UpdateInfo)
            or not update.available
            or not update.rollback
            or normalize_rollback_version(update.latest_version) != target_version
        ):
            self.rollback_requested_version = ""
            self.pending_update = None
            self._refresh_update_page(
                error or f"服务器暂未提供 v{target_version or '?'} 的回滚包。"
            )
            return
        self.pending_update = update
        self._refresh_update_page(f"已找到 v{target_version}，准备下载并校验…")
        self._download_pending_update()

    def _refresh_update_page(self, status_text: str = "") -> None:
        update = getattr(self, "pending_update", None)
        is_rollback = bool(isinstance(update, UpdateInfo) and update.rollback)
        update_summary_label = getattr(self, "update_summary_label", None)
        update_status_label = getattr(self, "update_status_label", None)
        update_action_button = getattr(self, "update_action_button", None)
        if update_summary_label is not None:
            if update is not None and update.available:
                size_text = (
                    f" · {update.size / 1024 / 1024:.1f} MB"
                    if update.size > 0
                    else ""
                )
                update_summary_label.configure(
                    text=(
                        f"准备回滚到 v{update.latest_version}{size_text}"
                        if is_rollback
                        else f"发现新版本 v{update.latest_version}{size_text}"
                    ),
                    fg=ACCENT,
                )
            elif self.rollback_check_in_progress and self.rollback_requested_version:
                update_summary_label.configure(
                    text=f"准备回滚到 v{self.rollback_requested_version}",
                    fg=WARN,
                )
            else:
                update_summary_label.configure(
                    text=f"当前版本 v{APP_VERSION}", fg=TEXT
                )
        if update_status_label is not None:
            if status_text:
                update_status_label.configure(text=status_text, fg=MUTED)
            elif update is not None and update.available:
                update_status_label.configure(
                    text=(
                        "回滚包下载完成后将自动安全停止采集并重启程序。"
                        if is_rollback
                        else (update.notes or "新版本可下载。")
                    ),
                    fg=MUTED,
                )
            else:
                update_status_label.configure(
                    text=(
                        "可在下方回滚到 v0.1.0 及以上版本；"
                        "更新、回滚和文件校验均在本页完成。"
                    ),
                    fg=MUTED,
                )
        if update_action_button is not None:
            if bool(getattr(self, "update_downloading", False)):
                text, disabled = ("回滚中…" if is_rollback else "下载中…"), True
            elif bool(getattr(self, "rollback_check_in_progress", False)):
                text, disabled = "获取中…", True
            elif bool(getattr(self, "update_check_in_progress", False)):
                text, disabled = "检查中…", True
            elif update is not None and update.available:
                text, disabled = ("重试回滚" if is_rollback else "立即更新"), False
            else:
                text, disabled = "检查更新", False
            update_action_button._disabled = disabled
            update_action_button.configure(
                text=text,
                cursor="arrow" if disabled else "hand2",
                bg=PANEL_2 if disabled else ACCENT,
                fg=MUTED if disabled else "#07110e",
            )
        self._refresh_rollback_buttons()

    def _refresh_rollback_buttons(self) -> None:
        buttons = getattr(self, "update_rollback_buttons", {})
        current_version = normalize_rollback_version(APP_VERSION)
        requested_version = normalize_rollback_version(
            getattr(self, "rollback_requested_version", "")
        )
        pending_update = getattr(self, "pending_update", None)
        pending_version = (
            normalize_rollback_version(pending_update.latest_version)
            if isinstance(pending_update, UpdateInfo) and pending_update.rollback
            else ""
        )
        checking = bool(
            getattr(self, "update_check_in_progress", False)
            or getattr(self, "rollback_check_in_progress", False)
        )
        downloading = bool(getattr(self, "update_downloading", False))
        for version, button in buttons.items():
            supported = rollback_version_is_supported(version)
            is_current = supported and version == current_version
            disabled = not supported or is_current or checking or downloading
            if not supported:
                text = "不支持回滚"
            elif is_current:
                text = "当前版本"
            elif self.rollback_check_in_progress and version == requested_version:
                text = "获取中…"
            elif downloading and version == pending_version:
                text = "回滚中…"
            elif pending_version == version:
                text = "重试回滚"
            else:
                text = "回滚"
            button._disabled = disabled
            button.configure(
                text=text,
                cursor="arrow" if disabled else "hand2",
                bg=PANEL_2,
                fg=SUBTLE if disabled else MUTED,
            )

    def _download_pending_update(self) -> None:
        update = self.pending_update
        if update is None or self.update_downloading or self.closing:
            return
        is_rollback = bool(update.rollback)
        self.update_downloading = True
        if self.update_status_label is not None:
            self.update_status_label.configure(
                text=(
                    f"正在下载并校验 v{update.latest_version} 回滚包…"
                    if is_rollback
                    else "正在下载并校验…"
                ),
                fg=MUTED,
            )
        if self.update_action_button is not None:
            self.update_action_button.configure(
                text="回滚中" if is_rollback else "下载中",
                bg=PANEL_2,
                fg=MUTED,
            )
        self._refresh_rollback_buttons()

        def download() -> None:
            last_progress_at = 0.0
            last_percentage = -1

            def report_progress(written: int, total: int) -> None:
                nonlocal last_progress_at, last_percentage
                percentage = min(100, int(written * 100 / total)) if total > 0 else 0
                now = time.monotonic()
                if (
                    percentage == last_percentage
                    or (percentage < 100 and now - last_progress_at < 0.1)
                ):
                    return
                last_progress_at = now
                last_percentage = percentage
                self.control_messages.put(
                    ("update_download_progress", (written, total))
                )

            try:
                staging_path, target_path = update_install_paths(
                    UPDATE_DIR, APP_EXECUTABLE_PATH, update.filename
                )
                destination = staging_path if IS_FROZEN else target_path
                path = self.licensing.download_update(
                    update, destination, report_progress
                )
                result = ("update_downloaded", path)
            except (LicensingConnectionError, OSError) as exc:
                result = ("update_download_failed", str(exc))
            except Exception:
                result = (
                    "update_download_failed",
                    "更新下载失败，请稍后重试。",
                )
            self.control_messages.put(result)

        threading.Thread(target=download, name="update-download", daemon=True).start()

    def _handle_update_download_progress(self, payload: object) -> None:
        if not self.update_downloading or self.update_status_label is None:
            return
        try:
            written, total = payload
            written = max(0, int(written))
            total = max(0, int(total))
        except (TypeError, ValueError, OverflowError):
            return
        if total <= 0:
            action = "回滚包" if bool(self.pending_update and self.pending_update.rollback) else "更新"
            text = f"正在下载{action} {written / 1024 / 1024:.1f} MB…"
        else:
            percentage = min(100, int(written * 100 / total))
            text = (
                "下载完成，正在校验文件…"
                if percentage >= 100
                else f"正在下载 {percentage}%…"
            )
        self.update_status_label.configure(text=text, fg=MUTED)

    def _handle_update_downloaded(self, payload: object) -> None:
        self.update_downloading = False
        update_path = Path(str(payload))
        update = self.pending_update
        if not isinstance(update, UpdateInfo) or not update.filename:
            self._handle_update_download_failed("更新信息已失效，请重新检查更新。")
            return
        if not IS_FROZEN or sys.platform != "win32":
            if self.update_status_label is not None:
                self.update_status_label.configure(
                    text=(
                        f"回滚安装包已保存：{update_path}"
                        if update.rollback
                        else f"安装包已保存：{update_path}"
                    ),
                    fg=ACCENT,
                )
            if self.update_action_button is not None:
                self.update_action_button.configure(text="已下载", bg=PANEL_2, fg=ACCENT)
            return
        try:
            _staging_path, target_path = update_install_paths(
                UPDATE_DIR, APP_EXECUTABLE_PATH, update.filename
            )
            self.pending_update_install = (
                update_path,
                target_path,
                APP_EXECUTABLE_PATH,
            )
        except OSError as exc:
            self._handle_update_download_failed(str(exc))
            return
        if self.update_status_label is not None:
            self.update_status_label.configure(
                text=(
                    "回滚包校验完成，正在安全停止采集…"
                    if update.rollback
                    else "校验完成，正在安全停止采集…"
                ),
                fg=ACCENT,
            )
        if self.update_action_button is not None:
            self.update_action_button.configure(
                text="准备安装", bg=PANEL_2, fg=ACCENT
            )
        self.close_status_text = "正在安全停止采集并准备更新…"
        if update.rollback:
            self.close_status_text = "正在安全停止采集并准备回滚…"
        self.root.after(120, self.close)

    def _handle_update_download_failed(self, payload: object) -> None:
        self.update_downloading = False
        self.pending_update_install = None
        message = str(payload).strip() or "更新下载失败，请稍后重试。"
        if self.update_status_label is not None:
            self.update_status_label.configure(text=message, fg=ERROR)
        if self.update_action_button is not None:
            self.update_action_button.configure(
                text=(
                    "重试回滚"
                    if bool(self.pending_update and self.pending_update.rollback)
                    else "重试"
                ),
                bg=ACCENT,
                fg="#07110e",
            )
        self._refresh_rollback_buttons()

    def _launch_update_replacer(
        self,
        update_path: Path,
        *,
        target_path: Path | None = None,
        legacy_target_path: Path | None = None,
    ) -> None:
        target_path = Path(target_path or APP_EXECUTABLE_PATH).resolve()
        legacy_target_path = Path(
            legacy_target_path or APP_EXECUTABLE_PATH
        ).resolve()
        UPDATE_DIR.mkdir(parents=True, exist_ok=True)
        script_path = UPDATE_DIR / "apply-update.ps1"
        script_path.write_text(
            "param([int]$TargetPid,[string]$Source,[string]$Target,[string]$PreviousTarget)\n"
            "$ErrorActionPreference = 'Stop'\n"
            "$deadline = [DateTime]::UtcNow.AddSeconds(60)\n"
            "while (Get-Process -Id $TargetPid -ErrorAction SilentlyContinue) {\n"
            "  if ([DateTime]::UtcNow -ge $deadline) { exit 20 }\n"
            "  Start-Sleep -Milliseconds 200\n"
            "}\n"
            "$installed = $false\n"
            "for ($attempt = 0; $attempt -lt 20; $attempt++) {\n"
            "  try { Copy-Item -LiteralPath $Source -Destination $Target -Force; $installed = $true; break }\n"
            "  catch { Start-Sleep -Milliseconds 500 }\n"
            "}\n"
            "if ($installed) {\n"
            "  if ($PreviousTarget -and (-not [StringComparer]::OrdinalIgnoreCase.Equals([System.IO.Path]::GetFullPath($PreviousTarget), [System.IO.Path]::GetFullPath($Target)))) {\n"
            "    Remove-Item -LiteralPath $PreviousTarget -Force -ErrorAction SilentlyContinue\n"
            "  }\n"
            "  Start-Process -FilePath $Target -WorkingDirectory (Split-Path -Parent $Target)\n"
            "  Remove-Item -LiteralPath $Source -Force -ErrorAction SilentlyContinue\n"
            "}\n"
            "Remove-Item -LiteralPath $PSCommandPath -Force -ErrorAction SilentlyContinue\n",
            encoding="utf-8-sig",
        )
        creation_flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        subprocess.Popen(
            [
                "powershell.exe",
                "-NoProfile",
                "-NonInteractive",
                "-ExecutionPolicy",
                "Bypass",
                "-WindowStyle",
                "Hidden",
                "-File",
                str(script_path),
                "-TargetPid",
                str(os.getpid()),
                "-Source",
                str(update_path.resolve()),
                "-Target",
                str(target_path),
                "-PreviousTarget",
                str(legacy_target_path),
            ],
            close_fds=True,
            creationflags=creation_flags,
        )

    def _return_to_login(self, message: str) -> None:
        if self.closing or self.authorization_resetting:
            return
        self.authorization_resetting = True
        self._set_window_click_through(self.root, False)
        self._destroy_unlock_window()
        self.connected = False
        self.game_pid = 0
        self._close_notice_window()
        self._close_user_notice()
        self._close_skill_window()
        self._close_history_window()
        self._close_feedback_window()
        self.dot.configure(fg=WARN)
        self.status_label.configure(text="正在安全停止", fg=WARN)
        self.heartbeat_stop_event.set()
        self.combat_clock_stop_event.set()
        self.stop_event.set()
        self.login_status_message = str(message).strip() or "请重新输入卡号。"
        self.root.after(50, self._finish_return_to_login)

    def _finish_return_to_login(self) -> None:
        if self.closing:
            return
        if self.worker.is_alive() or (
            self.heartbeat_worker is not None and self.heartbeat_worker.is_alive()
        ):
            self.root.after(50, self._finish_return_to_login)
            return
        if not self._ingest_pending_capture_messages():
            self.root.after(1, self._finish_return_to_login)
            return
        self.model.reset(keep_identity=False, archive_reason="authorization")
        self.model.entity_names.clear()
        self.model.entity_professions.clear()
        self.model.entity_extraordinary_ratings.clear()
        self.model.local_player_name = ""
        self._flush_combat_history(force=True)
        self.capture_started = False
        self.heartbeat_worker = None
        self.combat_clock_worker = None
        self.update_check_started = False
        self.pending_update = None
        self.rollback_check_in_progress = False
        self.rollback_requested_version = ""
        self.connected = False
        self.game_pid = 0
        self.dot.configure(fg=WARN)
        self.status_label.configure(text="待机", fg=MUTED)
        self.main_window_intentionally_hidden = True
        self.root.withdraw()
        self.authorization_resetting = False
        self._show_login(activate=False)

