    @staticmethod
    def _draw_equipment_badge(kind: str, size: int) -> Image.Image:
        """Draw the compact PVP/word markers used in rating rows."""

        render_scale = 4
        extent = max(1, int(size)) * render_scale
        unit = extent / 30.0
        point = lambda value: round(float(value) * unit)
        image = Image.new("RGBA", (extent, extent), (0, 0, 0, 0))
        draw = ImageDraw.Draw(image, "RGBA")
        if str(kind) == "pvp":
            edge = (112, 24, 48, 255)
            ink = (255, 100, 125, 255)
            for points, guard in (
                (((7, 4), (11, 4), (24, 23), (21, 26)), (17, 20, 26, 17)),
                (((23, 4), (19, 4), (6, 23), (9, 26)), (4, 17, 13, 20)),
            ):
                path = [(point(x), point(y)) for x, y in points]
                draw.line(
                    path,
                    fill=edge,
                    width=max(render_scale, point(5)),
                    joint="curve",
                )
                draw.line(
                    path,
                    fill=ink,
                    width=max(render_scale, point(2)),
                    joint="curve",
                )
                draw.line(
                    tuple(point(value) for value in guard),
                    fill=(255, 210, 219, 255),
                    width=max(render_scale, point(2)),
                )
        else:
            drop = (
                (15, 2), (18, 7), (22, 12), (25, 17), (25, 21),
                (23, 25), (20, 28), (15, 29), (10, 28), (7, 25),
                (5, 21), (5, 17), (8, 12), (12, 7),
            )
            draw.polygon(
                [(point(x), point(y)) for x, y in drop],
                fill=(255, 203, 42, 255),
                outline=(126, 78, 5, 255),
                width=max(render_scale, point(2)),
            )
            draw.ellipse(
                (point(9), point(9), point(14), point(16)),
                fill=(255, 250, 193, 225),
            )
            draw.arc(
                (point(7), point(7), point(23), point(27)),
                28,
                154,
                fill=(255, 231, 91, 255),
                width=max(render_scale, point(2)),
            )
        return image.resize((size, size), Image.Resampling.LANCZOS)

    def equipment_badge(
        self, kind: str, size: int = 18
    ) -> ImageTk.PhotoImage:
        physical_size = self._physical_size(size)
        normalized_kind = "pvp" if str(kind) == "pvp" else "word"
        key = ("equipment-badge", normalized_kind, physical_size)
        if key not in self.cache:
            self.cache[key] = ImageTk.PhotoImage(
                self._draw_equipment_badge(normalized_kind, physical_size),
                master=self.root,
            )
        return self.cache[key]

    def equipment_item(
        self,
        item_id: object,
        icon_key: object = "",
        size: int = 64,
    ) -> ImageTk.PhotoImage:
        """Load one original client item icon extracted through IconSetData."""

        try:
            normalized_item_id = max(0, int(item_id or 0))
        except (TypeError, ValueError, OverflowError):
            normalized_item_id = 0
        normalized_icon = str(icon_key or "").strip()
        physical_size = self._physical_size(size)
        key = (
            "equipment-item",
            normalized_item_id,
            normalized_icon,
            physical_size,
        )
        if key in self.cache:
            return self.cache[key]

        candidates = []
        if normalized_icon:
            candidates.append(ASSET_DIR / "equipment" / f"{normalized_icon}.png")
        if normalized_item_id:
            candidates.append(
                ASSET_DIR / "equipment" / f"{normalized_item_id}.png"
            )
        image = next(
            (
                loaded
                for path in candidates
                if (loaded := self._from_file(path, physical_size)) is not None
            ),
            None,
        )
        if image is None:
            image = self._draw_badge(
                "装", "#384550", physical_size, normalized_item_id
            )
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def equipment_quality_surface(
        self,
        quality: object,
        width: int,
        height: int,
        *,
        selected: bool = False,
    ) -> ImageTk.PhotoImage:
        """Render a restrained quality surface with local glow and fine edges."""

        try:
            normalized_quality = max(0, int(quality or 0))
        except (TypeError, ValueError, OverflowError):
            normalized_quality = 0
        physical_width = max(8, self._physical_size(width))
        physical_height = max(8, self._physical_size(height))
        key = (
            "equipment-quality-surface-v2",
            normalized_quality,
            physical_width,
            physical_height,
            bool(selected),
        )
        if key in self.cache:
            return self.cache[key]

        if normalized_quality == 7:
            top_color = (24, 17, 20)
            bottom_color = (11, 14, 18)
            accent = (200, 58, 76)
            bright = (248, 117, 132)
        elif normalized_quality == 6:
            top_color = (24, 22, 17)
            bottom_color = (12, 15, 18)
            accent = (218, 171, 59)
            bright = (249, 220, 126)
        else:
            top_color = (21, 27, 32)
            bottom_color = (12, 16, 20)
            accent = (75, 94, 108)
            bright = (139, 161, 176)

        image = Image.new(
            "RGBA", (physical_width, physical_height), (*bottom_color, 255)
        )
        large_surface = physical_height > self._physical_size(180)
        draw = ImageDraw.Draw(image, "RGBA")
        for y in range(physical_height):
            position = y / max(1, physical_height - 1)
            eased = position * position * (3.0 - 2.0 * position)
            color = tuple(
                round(start + (end - start) * eased)
                for start, end in zip(top_color, bottom_color)
            )
            draw.line(
                (0, y, physical_width, y),
                fill=(*color, 255),
            )

        # Two blurred glows keep the quality colour local instead of staining
        # the whole tile.  Gold/red remain readable even beside the mode tag.
        glow = Image.new("RGBA", image.size, (0, 0, 0, 0))
        glow_draw = ImageDraw.Draw(glow, "RGBA")
        glow_draw.ellipse(
            (
                -round(physical_width * 0.30),
                -round(physical_height * 0.95),
                round(physical_width * 0.92),
                round(physical_height * 0.88),
            ),
            fill=(*accent, 24 if large_surface else 46),
        )
        glow_draw.ellipse(
            (
                round(physical_width * 0.58),
                round(physical_height * 0.48),
                round(physical_width * 1.20),
                round(physical_height * 1.22),
            ),
            fill=(*accent, 7 if large_surface else 15),
        )
        glow = glow.filter(
            ImageFilter.GaussianBlur(max(2.0, physical_height * 0.16))
        )
        image = Image.alpha_composite(image, glow)

        sheen = Image.new("RGBA", image.size, (0, 0, 0, 0))
        sheen_draw = ImageDraw.Draw(sheen, "RGBA")
        sheen_draw.polygon(
            (
                (-round(physical_width * 0.08), physical_height),
                (round(physical_width * 0.34), 0),
                (round(physical_width * 0.43), 0),
                (round(physical_width * 0.04), physical_height),
            ),
            fill=(*bright, 7 if large_surface else 10),
        )
        sheen_draw.polygon(
            (
                (round(physical_width * 0.72), physical_height),
                (round(physical_width * 0.94), 0),
                (physical_width, 0),
                (round(physical_width * 0.84), physical_height),
            ),
            fill=(*bright, 3 if large_surface else 5),
        )
        sheen = sheen.filter(
            ImageFilter.GaussianBlur(max(1.0, physical_width * 0.007))
        )
        image = Image.alpha_composite(image, sheen)

        draw = ImageDraw.Draw(image, "RGBA")
        outer = (*accent, 188 if normalized_quality in {6, 7} else 105)
        inner = (*bright, 72 if normalized_quality in {6, 7} else 34)
        draw.rectangle(
            (0, 0, physical_width - 1, physical_height - 1),
            outline=outer,
            width=max(1, self._physical_size(1)),
        )
        inset = max(2, self._physical_size(2))
        draw.line(
            (inset, inset, physical_width - inset - 1, inset),
            fill=inner,
            width=max(1, self._physical_size(1)),
        )
        draw.line(
            (inset, inset, inset, physical_height - inset - 1),
            fill=(*bright, 38),
            width=max(1, self._physical_size(1)),
        )
        corner = max(9, min(physical_width, physical_height) // 7)
        line_width = max(1, self._physical_size(1))
        draw.line(
            (inset, corner, inset, inset, corner, inset),
            fill=(*bright, 170),
            width=line_width,
        )
        draw.line(
            (
                physical_width - corner - 1,
                physical_height - inset - 1,
                physical_width - inset - 1,
                physical_height - inset - 1,
                physical_width - inset - 1,
                physical_height - corner - 1,
            ),
            fill=(*accent, 142),
            width=line_width,
        )
        if selected:
            selection = (92, 227, 190)
            selection_inset = max(3, self._physical_size(3))
            draw.line(
                (
                    selection_inset,
                    physical_height - selection_inset - 1,
                    physical_width - selection_inset - 1,
                    physical_height - selection_inset - 1,
                ),
                fill=(*selection, 235),
                width=max(2, self._physical_size(2)),
            )
            draw.line(
                (
                    selection_inset,
                    selection_inset,
                    selection_inset,
                    physical_height - selection_inset - 1,
                ),
                fill=(*selection, 210),
                width=max(1, self._physical_size(1)),
            )

        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def main_action(
        self,
        name: str,
        size: int,
        color: str,
        *,
        hovered: bool = False,
    ) -> ImageTk.PhotoImage:
        """Render one crisp HUD action tile without exposing a window frame."""

        physical_size = self._physical_size(size)
        key = (
            "main-action",
            str(name),
            physical_size,
            str(color),
            bool(hovered),
        )
        if key in self.cache:
            return self.cache[key]

        render_size = max(4, physical_size * 4)
        image = Image.new("RGBA", (render_size, render_size), (0, 0, 0, 0))
        draw = ImageDraw.Draw(image, "RGBA")
        inset = max(2, round(render_size * 0.045))
        radius = max(4, round(render_size * 0.20))
        pvp = str(name) == "pvp"
        if pvp:
            fill = (48, 8, 21, 238) if not hovered else (76, 10, 29, 248)
            outline = (177, 20, 59, 235) if not hovered else (255, 47, 91, 255)
        else:
            fill = (12, 23, 34, 232) if not hovered else (22, 42, 57, 246)
            outline = (48, 77, 101, 225) if not hovered else (99, 151, 188, 250)
        draw.rounded_rectangle(
            (inset, inset, render_size - inset - 1, render_size - inset - 1),
            radius=radius,
            fill=fill,
            outline=outline,
            width=max(2, round(render_size * 0.022)),
        )
        inner = inset + max(2, round(render_size * 0.025))
        draw.rounded_rectangle(
            (inner, inner, render_size - inner - 1, render_size - inner - 1),
            radius=max(2, radius - (inner - inset)),
            outline=(142, 187, 218, 58) if not pvp else (255, 101, 132, 66),
            width=max(1, round(render_size * 0.010)),
        )
        image = image.resize(
            (physical_size, physical_size), Image.Resampling.LANCZOS
        )
        icon_size = max(14, round(physical_size * 0.62))
        icon = self._draw_toolbar_icon(str(name), icon_size, str(color))
        image.alpha_composite(
            icon,
            (
                (physical_size - icon.width) // 2,
                (physical_size - icon.height) // 2,
            ),
        )
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def profession(self, class_id: int | None, size: int = 34) -> ImageTk.PhotoImage:
        class_id = int(class_id or 0)
        color = PROFESSION_COLORS.get(class_id, SUBTLE)
        physical_size = self._physical_size(size)
        key = ("profession", class_id, physical_size, color)
        if key not in self.cache:
            path = ASSET_DIR / "professions" / f"{class_id}.png"
            if not path.is_file():
                # Older one-file builds flattened nested assets into the
                # assets root. New builds preserve the source directories.
                path = ASSET_DIR / f"{class_id}.png"
            image = self._from_file(path, physical_size) or self._draw_badge(
                self.PROFESSION_GLYPHS.get(class_id, "?"),
                color,
                physical_size,
                class_id,
            )
            self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def main_profession(
        self, class_id: int | None, size: int = 34
    ) -> ImageTk.PhotoImage:
        """Render the extracted game crest on its established profession color."""

        class_id = int(class_id or 0)
        color = PROFESSION_COLORS.get(class_id, SUBTLE)
        physical_size = self._physical_size(size)
        key = ("main-profession", class_id, physical_size, color)
        if key in self.cache:
            return self.cache[key]

        render_size = max(4, physical_size * 4)
        rgb = tuple(int(color[index : index + 2], 16) for index in (1, 3, 5))
        bright = tuple(round(channel + (255 - channel) * 0.42) for channel in rgb)
        dark = tuple(max(4, round(channel * 0.26)) for channel in rgb)
        middle = tuple(max(8, round(channel * 0.72)) for channel in rgb)
        image = Image.new("RGBA", (render_size, render_size), (0, 0, 0, 0))

        glow = Image.new("RGBA", image.size, (0, 0, 0, 0))
        glow_draw = ImageDraw.Draw(glow, "RGBA")
        glow_margin = round(render_size * 0.14)
        glow_draw.ellipse(
            (
                glow_margin,
                glow_margin,
                render_size - glow_margin - 1,
                render_size - glow_margin - 1,
            ),
            fill=rgb + (150,),
        )
        glow = glow.filter(
            ImageFilter.GaussianBlur(max(1.0, render_size * 0.095))
        )
        image.alpha_composite(glow)

        draw = ImageDraw.Draw(image, "RGBA")
        outer = round(render_size * 0.09)
        inner = round(render_size * 0.14)
        highlight_width = max(1, round(render_size * 0.012))
        draw.ellipse(
            (outer, outer, render_size - outer - 1, render_size - outer - 1),
            fill=middle + (232,),
        )
        draw.ellipse(
            (inner, inner, render_size - inner - 1, render_size - inner - 1),
            fill=dark + (226,),
        )
        draw.arc(
            (outer, outer, render_size - outer - 1, render_size - outer - 1),
            start=202,
            end=340,
            fill=bright + (165,),
            width=highlight_width,
        )

        path = ASSET_DIR / "professions" / f"{class_id}.png"
        if not path.is_file():
            path = ASSET_DIR / f"{class_id}.png"
        source: Image.Image | None = None
        if path.is_file():
            try:
                source = Image.open(path).convert("RGBA")
            except (OSError, ValueError):
                source = None
        if source is not None and source.getchannel("A").getbbox() is not None:
            source = source.crop(source.getchannel("A").getbbox())
            glyph_extent = max(1, round(render_size * 0.64))
            source.thumbnail((glyph_extent, glyph_extent), Image.Resampling.LANCZOS)
            alpha = source.getchannel("A")
            glyph = Image.new("RGBA", source.size, (248, 252, 255, 0))
            glyph.putalpha(alpha)
            glyph_glow = Image.new("RGBA", image.size, (0, 0, 0, 0))
            glyph_x = (render_size - source.width) // 2
            glyph_y = (render_size - source.height) // 2
            glow_mask = Image.new("L", image.size, 0)
            glow_mask.paste(alpha, (glyph_x, glyph_y))
            glow_mask = glow_mask.filter(
                ImageFilter.GaussianBlur(max(1.0, render_size * 0.025))
            )
            glyph_glow.paste(rgb + (0,), (0, 0, render_size, render_size))
            glyph_glow.putalpha(glow_mask)
            image.alpha_composite(glyph_glow)
            image.alpha_composite(glyph, (glyph_x, glyph_y))

            white_core = Image.new("RGBA", source.size, (255, 255, 255, 0))
            white_core.putalpha(alpha.point(lambda value: round(value * 0.30)))
            image.alpha_composite(white_core, (glyph_x, glyph_y))
        else:
            fallback = (self.PROFESSION_GLYPHS.get(class_id, "?") or "?")[:1]
            font = self._font(max(12, round(render_size * 0.42)), bold=True)
            box = draw.textbbox((0, 0), fallback, font=font)
            text_x = (render_size - (box[2] - box[0])) / 2 - box[0]
            text_y = (render_size - (box[3] - box[1])) / 2 - box[1]
            draw.text((text_x, text_y), fallback, font=font, fill=bright + (255,))

        image = image.resize(
            (physical_size, physical_size), Image.Resampling.LANCZOS
        )
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def skill(
        self,
        skill_id: int,
        name: str,
        class_id: int | None,
        size: int = 36,
    ) -> ImageTk.PhotoImage:
        color = PROFESSION_COLORS.get(int(class_id or 0), "#526273")
        physical_size = self._physical_size(size)
        key = ("skill", int(skill_id), physical_size, color)
        if key not in self.cache:
            path = ASSET_DIR / "skills" / f"{int(skill_id)}.png"
            if not path.is_file():
                path = ASSET_DIR / f"{int(skill_id)}.png"
            image = self._from_file(path, physical_size)
            if image is None:
                # Do not invent an icon when no extracted game asset exists.
                size = physical_size
                image = Image.new("RGBA", (size, size), (0, 0, 0, 0))
            self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def sidebar_art(self, width: int, height: int) -> ImageTk.PhotoImage:
        """Crop and tone the anime artwork for the live sidebar dimensions."""

        logical_width = max(1, int(width))
        logical_height = max(1, int(height))
        physical_width = self._physical_size(logical_width)
        physical_height = self._physical_size(logical_height)
        key = ("sidebar-art", physical_width, physical_height)
        if key in self.cache:
            return self.cache[key]

        image: Image.Image | None = None
        if SIDEBAR_ART_PATH.is_file():
            try:
                source = Image.open(SIDEBAR_ART_PATH).convert("RGBA")
                scale = max(
                    physical_width / max(1, source.width),
                    physical_height / max(1, source.height),
                )
                resized = source.resize(
                    (
                        max(1, round(source.width * scale)),
                        max(1, round(source.height * scale)),
                    ),
                    Image.Resampling.LANCZOS,
                )
                left = max(0, (resized.width - physical_width) // 2)
                overflow = max(0, resized.height - physical_height)
                top = min(overflow, max(0, round(overflow * 0.22)))
                image = resized.crop(
                    (
                        left,
                        top,
                        left + physical_width,
                        top + physical_height,
                    )
                )
            except (OSError, ValueError):
                image = None
        if image is None:
            image = Image.new(
                "RGBA", (physical_width, physical_height), (5, 13, 20, 255)
            )

        veil = Image.new(
            "RGBA", (physical_width, physical_height), (3, 9, 15, 0)
        )
        veil_draw = ImageDraw.Draw(veil, "RGBA")
        for y in range(physical_height):
            ratio = y / max(1, physical_height - 1)
            if ratio < 0.28:
                alpha = round(158 - ratio / 0.28 * 22)
            elif ratio < 0.70:
                alpha = round(136 - (ratio - 0.28) / 0.42 * 28)
            else:
                alpha = round(108 - (ratio - 0.70) / 0.30 * 22)
            veil_draw.line(
                (0, y, physical_width, y), fill=(3, 9, 15, alpha)
            )
        vignette = Image.new(
            "RGBA", (physical_width, physical_height), (0, 0, 0, 0)
        )
        vignette_draw = ImageDraw.Draw(vignette, "RGBA")
        for x in range(physical_width):
            edge = abs(x / max(1, physical_width - 1) - 0.5) * 2
            alpha = round(76 * edge * edge)
            vignette_draw.line(
                (x, 0, x, physical_height), fill=(2, 7, 12, alpha)
            )
        image = Image.alpha_composite(image, veil)
        image = Image.alpha_composite(image, vignette)
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def sidebar_avatar(self, size: int = 44) -> ImageTk.PhotoImage:
        """Render the fixed sidebar portrait as a crisp circular avatar."""

        physical_size = self._physical_size(size)
        key = ("sidebar-avatar", physical_size)
        if key in self.cache:
            return self.cache[key]

        image: Image.Image | None = None
        if SIDEBAR_AVATAR_PATH.is_file():
            try:
                source = Image.open(SIDEBAR_AVATAR_PATH).convert("RGBA")
                side = min(source.width, source.height)
                left = (source.width - side) // 2
                top = (source.height - side) // 2
                source = source.crop((left, top, left + side, top + side))
                image = source.resize(
                    (physical_size, physical_size), Image.Resampling.LANCZOS
                )
            except (OSError, ValueError):
                image = None
        if image is None:
            image = self._draw_badge("D", ACCENT, physical_size, 0)

        mask = Image.new("L", (physical_size, physical_size), 0)
        ImageDraw.Draw(mask).ellipse(
            (0, 0, physical_size - 1, physical_size - 1), fill=255
        )
        image.putalpha(ImageChops.multiply(image.getchannel("A"), mask))
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def membership_badge(
        self, text: object, height: int = 22
    ) -> ImageTk.PhotoImage:
        """Draw the compact gold card-tier badge used by the sidebar account card."""

        value = str(text or "普通").strip() or "普通"
        physical_height = self._physical_size(height)
        key = ("membership-badge", value, physical_height)
        if key in self.cache:
            return self.cache[key]

        font = self._font(max(10, round(physical_height * 0.47)), bold=True)
        probe = Image.new("RGBA", (1, 1), (0, 0, 0, 0))
        text_box = ImageDraw.Draw(probe).textbbox((0, 0), value, font=font)
        text_width = max(1, text_box[2] - text_box[0])
        icon_width = max(8, round(physical_height * 0.42))
        horizontal_padding = max(6, round(physical_height * 0.30))
        gap = max(3, round(physical_height * 0.16))
        width = horizontal_padding * 2 + icon_width + gap + text_width
        image = Image.new("RGBA", (width, physical_height), (0, 0, 0, 0))
        draw = ImageDraw.Draw(image, "RGBA")
        stroke_width = max(1, round(physical_height / 20))
        draw.rounded_rectangle(
            (0, 0, width - 1, physical_height - 1),
            radius=max(3, round(physical_height * 0.22)),
            fill=(31, 27, 14, 224),
            outline=(239, 194, 54, 248),
            width=stroke_width,
        )
        crown_left = horizontal_padding
        crown_top = round(physical_height * 0.31)
        crown_bottom = round(physical_height * 0.69)
        crown_right = crown_left + icon_width
        draw.polygon(
            (
                (crown_left, crown_top),
                (crown_left + icon_width * 0.28, crown_top + icon_width * 0.18),
                (crown_left + icon_width * 0.50, crown_top - icon_width * 0.10),
                (crown_left + icon_width * 0.72, crown_top + icon_width * 0.18),
                (crown_right, crown_top),
                (crown_right - icon_width * 0.14, crown_bottom),
                (crown_left + icon_width * 0.14, crown_bottom),
            ),
            fill=(255, 211, 78, 255),
        )
        text_x = crown_right + gap
        text_y = (physical_height - (text_box[3] - text_box[1])) / 2 - text_box[1]
        draw.text(
            (text_x, text_y),
            value,
            font=font,
            fill=(255, 214, 91, 255),
        )
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def boss(
        self,
        icon_name: object,
        name: object,
        size: int = 48,
    ) -> ImageTk.PhotoImage:
        """Load a catalogued Boss portrait, with a stable local fallback."""

        physical_size = self._physical_size(size)
        safe_icon = Path(str(icon_name or "")).name
        display_name = str(name or "").strip() or "Boss"
        key = ("boss", safe_icon, display_name, physical_size)
        if key not in self.cache:
            path = ASSET_DIR / "bosses" / safe_icon if safe_icon else Path()
            image = self._from_file(path, physical_size) if safe_icon else None
            if image is None:
                seed = int.from_bytes(
                    hashlib.sha1(display_name.encode("utf-8")).digest()[:4],
                    "big",
                )
                image = self._draw_badge(
                    display_name[:1], WARN, physical_size, seed
                )
            self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    @staticmethod
    def _draw_pvp_mode_badge(team_size: int, color: str, size: int) -> Image.Image:
        """Draw a small team-versus-team pictogram without external assets."""

        scale = 4
        extent = max(1, int(size)) * scale
        unit = extent / 52.0
        point = lambda value: round(float(value) * unit)
        rgb = tuple(int(color[index : index + 2], 16) for index in (1, 3, 5))
        image = Image.new("RGBA", (extent, extent), (0, 0, 0, 0))
        draw = ImageDraw.Draw(image, "RGBA")
        draw.rounded_rectangle(
            (point(1), point(1), point(51), point(51)),
            radius=point(11),
            fill=(7, 15, 23, 248),
            outline=rgb + (220,),
            width=max(scale, point(1.4)),
        )
        draw.rounded_rectangle(
            (point(4), point(4), point(48), point(48)),
            radius=point(8),
            fill=rgb + (24,),
            outline=rgb + (54,),
            width=max(scale, point(0.7)),
        )
        draw.line(
            (point(26), point(9), point(26), point(43)),
            fill=rgb + (78,),
            width=max(scale, point(0.8)),
        )

        def person(x: float, y: float, radius: float) -> None:
            r = point(radius)
            cx, cy = point(x), point(y)
            draw.ellipse(
                (cx - r, cy - r, cx + r, cy + r),
                fill=(237, 247, 253, 245),
                outline=rgb + (255,),
                width=max(scale, point(0.55)),
            )
            shoulder = max(point(1.2), round(r * 0.75))
            draw.line(
                (cx, cy + r, cx, cy + r + point(3.2)),
                fill=(237, 247, 253, 238),
                width=shoulder,
            )
            draw.arc(
                (
                    cx - r - point(1.4),
                    cy + r,
                    cx + r + point(1.4),
                    cy + r + point(5.5),
                ),
                190,
                350,
                fill=rgb + (245,),
                width=max(scale, point(0.75)),
            )

        layouts = {
            1: ((14, 23),),
            3: ((12, 17), (18, 26), (12, 35)),
            6: ((10, 14), (18, 14), (10, 26), (18, 26), (10, 38), (18, 38)),
            12: tuple(
                (9 + column * 5, 12 + row * 9)
                for row in range(4)
                for column in range(3)
            ),
        }
        points = layouts.get(team_size, layouts[1])
        radius = {1: 4.0, 3: 2.4, 6: 1.65, 12: 1.12}.get(team_size, 2.0)
        for x, y in points:
            person(x, y, radius)
            person(52 - x, y, radius)

        if team_size == 1:
            sword = (245, 209, 112, 255)
            width = max(scale, point(1.2))
            draw.line(
                (point(21), point(17), point(31), point(35)),
                fill=sword,
                width=width,
            )
            draw.line(
                (point(31), point(17), point(21), point(35)),
                fill=sword,
                width=width,
            )
            draw.line(
                (point(19), point(19), point(23), point(17)),
                fill=sword,
                width=width,
            )
            draw.line(
                (point(33), point(19), point(29), point(17)),
                fill=sword,
                width=width,
            )
        else:
            draw.polygon(
                (
                    (point(23), point(20)),
                    (point(29), point(26)),
                    (point(23), point(32)),
                    (point(26), point(26)),
                ),
                fill=rgb + (245,),
            )
        return image.resize((size, size), Image.Resampling.LANCZOS)

    def pvp_mode(
        self,
        mode_name: object,
        map_name: object = "",
        team_size: object = 0,
        size: int = 50,
    ) -> ImageTk.PhotoImage:
        """Draw a compact, mode-specific badge for the PvP history list."""

        try:
            size_value = int(team_size or 0)
        except (TypeError, ValueError, OverflowError):
            size_value = 0
        size_value = 1 if size_value == 1 else 3 if size_value == 3 else 6 if size_value == 6 else 12 if size_value == 12 else 0
        palette = {1: "#e6bd62", 3: "#55c7a8", 6: "#6f9cff", 12: "#b58ae8"}
        color = palette.get(size_value, PVP_MODE_FOREGROUND)
        label = str(mode_name or "PvP").strip() or "PvP"
        map_label = str(map_name or "").strip()
        physical_size = self._physical_size(size)
        key = ("pvp-mode", label, map_label, size_value, physical_size, color)
        if key not in self.cache:
            if label == "终末猎杀":
                dragon_path = ASSET_DIR / "hunter_dragon_icon.png"
                dragon = self._from_file(dragon_path, physical_size)
                if dragon is not None:
                    self.cache[key] = ImageTk.PhotoImage(dragon, master=self.root)
                    return self.cache[key]
            self.cache[key] = ImageTk.PhotoImage(
                self._draw_pvp_mode_badge(size_value or 1, color, physical_size),
                master=self.root,
            )
        return self.cache[key]

    def pvp_appearance(
        self,
        avatar_id: object,
        avatar_frame_id: object,
        profession_id: object,
        size: int = 74,
    ) -> ImageTk.PhotoImage:
        """Render the selected in-game portrait/frame, with profession fallback."""

        try:
            portrait_id = max(0, int(avatar_id or 0))
        except (TypeError, ValueError, OverflowError):
            portrait_id = 0
        try:
            frame_id = max(0, int(avatar_frame_id or 0))
        except (TypeError, ValueError, OverflowError):
            frame_id = 0
        physical_size = self._physical_size(size)
        key = (
            "pvp-appearance",
            portrait_id,
            frame_id,
            int(profession_id or 0),
            physical_size,
        )
        if key in self.cache:
            return self.cache[key]

        portrait_path = PVP_APPEARANCE_DIR / "avatars" / f"{portrait_id}.png"
        if portrait_id <= 0 or not portrait_path.is_file():
            return self.main_profession(profession_id, size=size)
        try:
            portrait = Image.open(portrait_path).convert("RGBA")
            portrait = ImageOps.contain(
                portrait,
                (physical_size, physical_size),
                Image.Resampling.LANCZOS,
            )
            image = Image.new(
                "RGBA", (physical_size, physical_size), (0, 0, 0, 0)
            )
            image.alpha_composite(
                portrait,
                (
                    (physical_size - portrait.width) // 2,
                    (physical_size - portrait.height) // 2,
                ),
            )
            frame_path = PVP_APPEARANCE_DIR / "frames" / f"{frame_id}.png"
            if frame_id > 0 and frame_path.is_file():
                frame = Image.open(frame_path).convert("RGBA").resize(
                    (physical_size, physical_size), Image.Resampling.LANCZOS
                )
                image.alpha_composite(frame)
        except (OSError, ValueError):
            return self.main_profession(profession_id, size=size)
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def profession_watermark(
        self, class_id: object, size: int = 82
    ) -> ImageTk.PhotoImage:
        """Render one subdued profession crest for the PvP duel cards."""

        try:
