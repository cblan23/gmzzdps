        self.healing_responses.clear()
        self.actor_health_states.clear()
        self.actor_health_lows.clear()
        self.pending_health_drops.clear()
        self.healing_response_keys.clear()
        self.healing_revision += 1
        self.healing_summary_cache_key = None
        self.healing_summary_cache = None
        self.last_archive_signature = None
        if preserved_target_id is not None:
            # A manual clear starts a new local record while the same live Boss
            # is still being fought. Keeping that target lets the very next
            # cumulative team update reappear immediately, without waiting for
            # another local/direct hit to rediscover the encounter.
            self._register_encounter_target(preserved_target_id)
            self._resolve_combat_sides()

    def _event_seconds(self, event: dict) -> float:
        return (event["filetime_100ns"] - 116_444_736_000_000_000) / 10_000_000

    @staticmethod
    def _skill_cast_event_key(event: dict) -> tuple[int, int, int, int]:
        return (
            int(event.get("filetime_100ns", 0) or 0),
            int(event.get("sequence", 0) or 0),
            int(event.get("actor_id", 0) or 0),
            int(event.get("skill_id", 0) or 0),
        )

    def _rebuild_skill_cast_event_keys(self) -> None:
        unique_events: list[dict] = []
        keys: set[tuple[int, int, int, int]] = set()
        for event in self.skill_cast_events:
            if not isinstance(event, dict):
                continue
            key = self._skill_cast_event_key(event)
            if key in keys:
                continue
            keys.add(key)
            unique_events.append(event)
        self.skill_cast_events = unique_events
        self.skill_cast_event_keys = keys

    def ingest_skill_cast(self, update: dict) -> bool:
        """Retain local success replies and verified teammate cast broadcasts."""

        if not isinstance(update, dict):
            return False
        try:
            timestamp = int(update.get("filetime_100ns", 0) or 0)
            sequence = int(update.get("sequence", 0) or 0)
            actor_id = int(update.get("actor_id", 0) or self.self_id or 0)
            skill_id = self.normalize_damage_skill_id(update.get("skill_id", 0))
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            timestamp <= 0
            or skill_id <= 0
            or (update.get("cast_source"), update.get("source_method")) not in {
                ('local_success_response', 'RetCastSkillSuccessNew'),
                ('network_cast_broadcast', 'OnMsgCastSkillNew'),
            }
            or self.long_gap_phase_suspended
        ):
            return False
        event = {
            "filetime_100ns": timestamp,
            "sequence": sequence,
            "actor_id": actor_id,
            "skill_id": skill_id,
            "cast_source": update.get("cast_source"),
        }
        key = self._skill_cast_event_key(event)
        if key in self.skill_cast_event_keys:
            return False
        self.skill_cast_events.append(event)
        self.skill_cast_event_keys.add(key)
        if len(self.skill_cast_events) > 20_000:
            self.skill_cast_events = self.skill_cast_events[-10_000:]
            self._rebuild_skill_cast_event_keys()
        return True

    @staticmethod
    def _healing_event_key(
        event: dict,
    ) -> tuple[int, int, int, int, int, int, int]:
        return (
            int(event.get("filetime_100ns", 0) or 0),
            int(event.get("sequence", 0) or 0),
            int(event.get("healer_id", 0) or 0),
            int(event.get("target_id", 0) or 0),
            int(event.get("skill_id", 0) or 0),
            int(event.get("total_healing", 0) or 0),
            int(event.get("effective_healing", 0) or 0),
        )

    @staticmethod
    def _health_low_is_lower(
        candidate: dict[str, object], current: dict[str, object]
    ) -> bool:
        """Compare two HP low-point samples without trusting malformed data."""
        try:
            candidate_ratio = float(candidate.get("ratio"))
            current_ratio = float(current.get("ratio"))
        except (AttributeError, TypeError, ValueError, OverflowError):
            return False
        if not math.isfinite(candidate_ratio):
            return False
        if not math.isfinite(current_ratio):
            return True
        if candidate_ratio != current_ratio:
            return candidate_ratio < current_ratio
        try:
            return int(candidate.get("filetime_100ns", 0) or 0) < int(
                current.get("filetime_100ns", 0) or 0
            )
        except (AttributeError, TypeError, ValueError, OverflowError):
            return False

    def _health_sample_in_active_encounter(
        self, event_time: float, healing_context: bool
    ) -> bool:
        """Accept low points only inside the current DPS/HPS encounter."""
        if not math.isfinite(event_time):
            return False
        if self.first_damage_time:
            return bool(
                not self.combat_end_time
                and event_time >= self.first_damage_time - 0.25
            )
        # A treatment dummy has no damage edge.  Its exact target identity is
        # enough to open the local HPS window before the first heal callback.
        return bool(healing_context and not self.healing_end_time)

    def _healing_role_status(
        self, actor_id: int, profession_id: object = 0
    ) -> bool | None:
        """Return True for a known healer, False for a known non-healer."""
        explicit = _parsed_profession_id(profession_id)
        if not explicit:
            explicit = _parsed_profession_id(
                self.entity_professions.get(int(actor_id or 0), 0)
            )
        if explicit:
            return explicit in HEALER_PROFESSION_IDS
        inferred = _parsed_profession_id(self.actor_profession_id(actor_id))
        if inferred:
            return inferred in HEALER_PROFESSION_IDS
        return None

    def _healing_actor_allowed(
        self, actor_id: int, profession_id: object = 0
    ) -> bool:
        # Unknown role data is retained exactly; only an explicit non-healer is
        # excluded.  This is the conservative choice for older clients whose
        # roster packets did not carry a profession field.
        return self._healing_role_status(actor_id, profession_id) is not False

    def ingest_actor_health(self, update: dict) -> bool:
        """Track only guarded, real-time party HP samples for response timing."""
        try:
            actor_id = int(update.get("entity_id", 0) or 0)
            timestamp = int(update.get("filetime_100ns", 0) or 0)
            max_hp = float(update.get("max_hp", 0.0) or 0.0)
        except (TypeError, ValueError, OverflowError):
            return False
        if self.long_gap_phase_suspended:
            return False
        healing_context = self._pure_healing_context()
        if (
            actor_id not in self._current_member_ids()
            or timestamp <= 0
            or max_hp <= 0
            or update.get("health_source") != "bound_realtime_hp"
        ):
            return False
        state = self.actor_health_states.get(actor_id, {})
        if timestamp < int(state.get("filetime_100ns", 0) or 0):
            return False
        next_state: dict[str, float | int] = dict(state)
        next_state["max_hp"] = max_hp
        next_state["filetime_100ns"] = timestamp
        changed = next_state != state
        event_time = self._event_seconds(update)
        if "current_hp" in update:
            try:
                current_hp = float(update["current_hp"])
            except (TypeError, ValueError, OverflowError):
                return False
            if not math.isfinite(current_hp) or not 0 <= current_hp <= max_hp * 1.02:
                return False
            previous_hp = state.get("current_hp")
            next_state["current_hp"] = current_hp
            next_state["sample_count"] = int(state.get("sample_count", 0) or 0) + 1
            changed |= previous_hp != current_hp
            if self._health_sample_in_active_encounter(
                event_time, healing_context
            ):
                ratio = min(1.0, max(0.0, current_hp / max_hp))
                candidate_low: dict[str, float | int] = {
                    "actor_id": actor_id,
                    "current_hp": current_hp,
                    "max_hp": max_hp,
                    "ratio": ratio,
                    "filetime_100ns": timestamp,
                }
                previous_low = self.actor_health_lows.get(actor_id)
                if previous_low is None or self._health_low_is_lower(
                    candidate_low, previous_low
                ):
                    self.actor_health_lows[actor_id] = candidate_low
                    changed = True
            if current_hp >= max_hp * 0.999:
                answered_drop = self.pending_health_drops.pop(actor_id, None)
                if answered_drop is not None:
                    self.healing_response_keys = {
                        key
                        for key in self.healing_response_keys
                        if not (key[0] == actor_id and key[1] == answered_drop)
                    }
                    changed = True
            if (
                previous_hp is not None
                and current_hp < float(previous_hp)
                and (self.first_damage_time or healing_context)
                and self._event_seconds(update) >= self.first_damage_time
                and not self.combat_end_time
                and not self.healing_end_time
            ):
                # One response sample starts at the first confirmed HP loss
                # and ends at the first subsequent effective heal. Additional
                # damage before that heal belongs to the same unanswered drop.
                self.pending_health_drops.setdefault(actor_id, timestamp)
                changed = True
            changed |= self._resolve_sun_survival(
                actor_id,
                timestamp,
                current_hp,
            )
        self.actor_health_states[actor_id] = next_state
        return changed

    def team_health_summary(self) -> dict:
        """Return an exact aggregate of the currently bound party HP samples.

        Health is intentionally reported only when every currently known party
        member has a valid current/max sample.  A partial sum would look like a
        team total while silently omitting a member, which is more misleading
        than a short-lived placeholder in the HPS banner.
        """
        member_ids = set(self._current_member_ids())
        if not member_ids:
            # Accepted actor-health samples are already guarded by
            # ``_current_member_ids`` at ingestion time.  Keeping this fallback
            # makes the method useful during the brief roster hand-off window.
            member_ids = set(self.actor_health_states)

        expected_count = len(member_ids)
        try:
            roster_count = int(self.party_member_count or 0)
        except (TypeError, ValueError, OverflowError):
            roster_count = 0
        if roster_count > expected_count:
            expected_count = roster_count

        ordered_ids = list(self.friend_order)
        ordered_ids.extend(
            actor_id for actor_id in sorted(member_ids) if actor_id not in ordered_ids
        )
        members: list[dict] = []
        for actor_id in ordered_ids:
            if actor_id not in member_ids:
                continue
            state = self.actor_health_states.get(actor_id)
            if not isinstance(state, dict):
                continue
            try:
                current_hp = float(state.get("current_hp"))
                max_hp = float(state.get("max_hp"))
            except (TypeError, ValueError, OverflowError):
                continue
            if (
                not math.isfinite(current_hp)
                or not math.isfinite(max_hp)
                or max_hp <= 0
                or current_hp < 0
                or current_hp > max_hp * 1.02
            ):
                continue
            current_hp = min(current_hp, max_hp)
            ratio = min(1.0, max(0.0, current_hp / max_hp))
            member = {
                "actor_id": actor_id,
                "current_hp": current_hp,
                "max_hp": max_hp,
                "ratio": ratio,
                "filetime_100ns": int(state.get("filetime_100ns", 0) or 0),
            }
            low = self.actor_health_lows.get(actor_id)
            if isinstance(low, dict):
                try:
                    low_ratio = float(low.get("ratio"))
                    low_hp = float(low.get("current_hp"))
                    low_max = float(low.get("max_hp"))
                    low_time = int(low.get("filetime_100ns", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    low_ratio = float("nan")
                    low_hp = low_max = 0.0
                    low_time = 0
                if (
                    math.isfinite(low_ratio)
                    and math.isfinite(low_hp)
                    and math.isfinite(low_max)
                    and low_max > 0
                    and 0 <= low_hp <= low_max * 1.02
                    and low_time > 0
                ):
                    member["encounter_low"] = {
                        "actor_id": actor_id,
                        "current_hp": min(low_hp, low_max),
                        "max_hp": low_max,
                        "ratio": min(1.0, max(0.0, low_ratio)),
                        "filetime_100ns": low_time,
                    }
            members.append(member)

        complete = bool(members) and len(members) == expected_count
        if not complete:
            return {
                "available": False,
                "complete": False,
                "expected_member_count": expected_count,
                "observed_member_count": len(members),
                "current_hp": None,
                "max_hp": None,
                "ratio": None,
                "lowest": None,
                "lowest_encounter": None,
                "members": members,
            }

        current_total = sum(item["current_hp"] for item in members)
        max_total = sum(item["max_hp"] for item in members)
        current_lowest = min(
            members,
            key=lambda item: (float(item["ratio"]), int(item["actor_id"])),
        )
        encounter_lows = [
            item["encounter_low"]
            for item in members
            if isinstance(item.get("encounter_low"), dict)
        ]
        lowest_encounter = (
            min(
                encounter_lows,
                key=lambda item: (
                    float(item.get("ratio", 1.0)),
                    int(item.get("actor_id", 0) or 0),
                ),
            )
            if encounter_lows
            else None
        )
        return {
            "available": True,
            "complete": True,
            "expected_member_count": expected_count,
            "observed_member_count": len(members),
            "current_hp": current_total,
            "max_hp": max_total,
            "ratio": current_total / max_total if max_total > 0 else None,
            # ``lowest`` is strictly the encounter low.  A full-health frame
            # observed before/after a pull must not masquerade as a fight-wide
            # minimum when no in-encounter sample was captured.
            "lowest": (
                dict(lowest_encounter) if lowest_encounter is not None else None
            ),
            "current_lowest": dict(current_lowest),
            "lowest_encounter": (
                dict(lowest_encounter) if lowest_encounter is not None else None
            ),
            "members": members,
        }

    def ingest_heal(self, event: dict) -> bool:
        """Ingest one exact HealSyncV2 callback without changing DPS clocks."""
        if self.awaiting_post_exit_context:
            return False
        try:
            healer_id = int(event.get("healer_id", 0) or 0)
            target_id = int(event.get("target_id", 0) or 0)
            skill_id = int(event.get("skill_id", 0) or 0)
            total_healing = int(event.get("total_healing", 0) or 0)
            effective_healing = int(event.get("effective_healing", 0) or 0)
            timestamp = int(event.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            healer_id <= 0
            or target_id <= 0
            or skill_id <= 0
            or total_healing < 0
            or not 0 <= effective_healing <= total_healing
            or timestamp <= 0
        ):
            return False
        if self.long_gap_phase_suspended:
            return False

        # A HealSync may be the first packet after the native template poll.
        # Accept the target only when the exact allowlisted template/profile is
        # already known; the display name is never used as a fallback.
        try:
            target_template_id = int(event.get("target_template_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            target_template_id = 0
        if target_template_id in HEALING_TARGET_TEMPLATE_IDS:
            self._register_healing_target(
                target_id,
                template_id=target_template_id,
                level=event.get("target_level"),
            )
        target_is_healing = self._is_healing_target(target_id)
        members = self._current_member_ids()
        if healer_id not in members:
            return False
        event_profession = _parsed_profession_id(event.get("profession_id", 0))
        if (
            event_profession
            and self.entity_professions.get(healer_id) != event_profession
        ):
            self.entity_professions[healer_id] = event_profession
            self.healing_revision += 1
            self.healing_summary_cache_key = None
            self.healing_summary_cache = None
        if not self._healing_actor_allowed(healer_id, event_profession):
            return False
        damage_context = bool(
            self.first_damage_time and self._encounter_damage_target_ids()
        )
        pure_healing_context = bool(
            target_is_healing
            and not self.first_damage_time
            and not self.combat_end_time
        )
        if target_is_healing:
            # Treatment dummies are a standalone HPS source.  They must not be
            # mixed into a real Boss pull or become a hidden DPS target.
            if not pure_healing_context:
                return False
        elif target_id not in members or not damage_context:
            # Ordinary party healing has no encounter boundary until a real
            # Boss damage edge exists.
            return False

        event_time = self._event_seconds(event)
        if not math.isfinite(event_time):
            return False
        if damage_context:
            encounter_end = self.combat_end_time or 0.0
            if event_time < self.first_damage_time - 0.25:
                return False
            if encounter_end and event_time > encounter_end + 1.0:
                return False
        else:
            # A delayed callback after an idle-closed dummy encounter belongs
            # to that record only inside the small packet-lateness window.  A
            # larger gap starts a new dummy encounter before this event.
            if (
                self.last_healing_time
                and event_time - self.last_healing_time > self.idle_gap
            ):
                self.reset(
                    keep_identity=True,
                    keep_monsters=True,
                    archive_reason="new_encounter",
                )
                target_is_healing = self._is_healing_target(target_id)
                if not target_is_healing:
                    return False
            if self.first_healing_time and event_time < self.first_healing_time - 0.25:
                return False
            if self.healing_end_time and event_time > self.healing_end_time + 1.0:
                return False
        key = self._healing_event_key(event)
        if key in self.healing_event_keys:
            return False
        exact_event = dict(event)
        exact_event["overhealing"] = total_healing - effective_healing
        exact_event["healing_source"] = "network_exact"
        exact_event["healing_target"] = target_is_healing
        if event_profession:
            exact_event["profession_id"] = event_profession
        if target_is_healing:
            exact_event["target_template_id"] = int(
                self.monsters[target_id].template_id or target_template_id or 0
            )
        self.healing_events.append(exact_event)
        self.healing_event_keys.add(key)
        if not self.first_healing_time:
            self.first_healing_time = event_time
        else:
            self.first_healing_time = min(self.first_healing_time, event_time)
        self.last_healing_time = max(self.last_healing_time, event_time)
        if pure_healing_context:
            self.healing_end_time = 0.0
            self.healing_end_reason = ""
            self.encounter_team_size = min(
                MAX_PARTY_MEMBERS,
                max(self.encounter_team_size, len(self._current_member_ids())),
            )
        self.healing_revision += 1
        self.healing_summary_cache_key = None
        self.healing_summary_cache = None

        drop_time = self.pending_health_drops.get(target_id)
        if effective_healing > 0 and drop_time is not None and timestamp >= drop_time:
            response_key = (target_id, drop_time, healer_id)
            if response_key not in self.healing_response_keys:
                response_ms = (timestamp - drop_time) / 10_000.0
                self.healing_responses.append(
                    {
                        "healer_id": healer_id,
                        "target_id": target_id,
                        "drop_filetime_100ns": drop_time,
                        "heal_filetime_100ns": timestamp,
                        "response_ms": response_ms,
                    }
                )
                self.healing_response_keys.add(response_key)
        if self.combat_end_time:
            self._queue_current_record_refresh()
        elif self.healing_end_time:
            self._queue_current_record_refresh()
        return True

    @staticmethod
    def _rolling_peak_hps(events: list[tuple[float, int]]) -> float:
        if not events:
            return 0.0
        window_seconds = 5.0
        ordered = sorted(events)
        left = 0
        current = 0
        maximum = 0
        for right, (event_time, amount) in enumerate(ordered):
            current += max(0, int(amount))
            while left <= right and event_time - ordered[left][0] > window_seconds:
                current -= max(0, int(ordered[left][1]))
                left += 1
            maximum = max(maximum, current)
        return maximum / window_seconds

    def active_stage_healing_snapshot(
        self, actor_id: int
    ) -> StageHealingSnapshot | None:
        if not self._healing_actor_allowed(int(actor_id)):
            return None
        snapshot = self.stage_healing_snapshots.get(int(actor_id))
        if snapshot is None:
            return None
        actor = self.stats.get(int(actor_id))
        current_damage = int(actor.damage if actor is not None else 0)
        if current_damage != snapshot.actor_damage:
            return None
        return snapshot

    def _raw_healing_by_actor(self) -> dict[int, dict]:
        result: dict[int, dict] = {}
        for event in self.healing_events:
            try:
                actor_id = int(event.get("healer_id", 0) or 0)
                target_id = int(event.get("target_id", 0) or 0)
                skill_id = int(event.get("skill_id", 0) or 0)
                total = max(0, int(event.get("total_healing", 0) or 0))
                effective = max(0, int(event.get("effective_healing", 0) or 0))
                timestamp = int(event.get("filetime_100ns", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                continue
            if actor_id <= 0 or target_id <= 0 or skill_id <= 0 or effective > total:
                continue
            if not self._healing_actor_allowed(
                actor_id, event.get("profession_id", 0)
            ):
                continue
            row = result.setdefault(
                actor_id,
                {
                    "total": 0,
                    "effective": 0,
                    "events": 0,
                    "skills": {},
                    "targets": {},
                    "effective_events": [],
                },
            )
            row["total"] += total
            row["effective"] += effective
            row["events"] += 1
            event_time = self._event_seconds({"filetime_100ns": timestamp})
            if effective > 0:
                row["effective_events"].append((event_time, effective))
            for mapping_name, key in (("skills", skill_id), ("targets", target_id)):
                detail = row[mapping_name].setdefault(
                    key, {"total": 0, "effective": 0, "events": 0}
                )
                detail["total"] += total
                detail["effective"] += effective
                detail["events"] += 1
        return result

    def healing_summary(self, duration: float | None = None) -> dict:
        divisor = dps_duration_seconds(
            self.healing_duration() if duration is None else duration
        )
        snapshot_signature = tuple(
            sorted(
                (
                    actor_id,
                    snapshot.summary_id,
                    snapshot.actor_damage,
                    int(self.stats.get(actor_id).damage)
                    if self.stats.get(actor_id) is not None
                    else 0,
                    snapshot.effective_healing,
                )
                for actor_id, snapshot in self.stage_healing_snapshots.items()
            )
        )
        counter_signature = tuple(
            sorted(
                (
                    actor_id,
                    state.accepted_effective_healing,
                    state.exact_for_encounter,
                    state.snapshot_time_100ns,
                )
                for actor_id, state in self.team_healing_states.items()
            )
        )
        member_ids = self._current_member_ids()
        cache_key = (
            self.healing_revision,
            len(self.healing_events),
            len(self.healing_responses),
            divisor,
            snapshot_signature,
            counter_signature,
            tuple(self.friend_order),
            tuple(
                sorted(
                    (actor_id, self.entity_names.get(actor_id, ""))
                    for actor_id in member_ids
                )
            ),
            tuple(
                sorted(
                    (actor_id, self.entity_professions.get(actor_id, 0))
                    for actor_id in member_ids
                )
            ),
            tuple(
                sorted(
                    (
                        actor_id,
                        self.entity_extraordinary_ratings.get(actor_id),
                    )
                    for actor_id in member_ids
                )
            ),
            tuple(
                sorted(
                    (actor_id, self.entity_ai_states.get(actor_id))
                    for actor_id in member_ids
                )
            ),
            tuple(
                sorted(
                    (
                        actor_id,
                        int(state.get("sample_count", 0) or 0),
                    )
                    for actor_id, state in self.actor_health_states.items()
                )
            ),
            tuple(
                sorted(
                    (
                        actor_id,
                        int(low.get("filetime_100ns", 0) or 0),
                        round(float(low.get("ratio", 1.0) or 1.0), 6),
                    )
                    for actor_id, low in self.actor_health_lows.items()
                    if isinstance(low, dict)
                )
            ),
            len(self.runtime_skill_names),
        )
        if (
            cache_key == self.healing_summary_cache_key
            and self.healing_summary_cache is not None
        ):
            return self.healing_summary_cache

        raw_by_actor = self._raw_healing_by_actor()
        actor_ids = set(raw_by_actor)
        actor_ids.update(
            actor_id
            for actor_id in self.stage_healing_snapshots
            if self.active_stage_healing_snapshot(actor_id) is not None
        )
        actor_ids.update(
            actor_id
            for actor_id, state in self.team_healing_states.items()
            if state.exact_for_encounter
        )
        actor_ids = {
            actor_id
            for actor_id in actor_ids
            if self._healing_actor_allowed(actor_id)
        }
        response_by_actor: dict[int, list[dict]] = {}
        for response in self.healing_responses:
            try:
                healer_id = int(response.get("healer_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                continue
            if not self._healing_actor_allowed(healer_id):
                continue
            response_by_actor.setdefault(healer_id, []).append(response)

        ordered_ids = list(self.friend_order)
        ordered_ids.extend(actor_id for actor_id in actor_ids if actor_id not in ordered_ids)
        healers: list[dict] = []
        for actor_id in actor_ids:
            if not self._healing_actor_allowed(actor_id):
                continue
            raw = raw_by_actor.get(
                actor_id,
                {
                    "total": 0,
                    "effective": 0,
                    "events": 0,
                    "skills": {},
                    "targets": {},
                    "effective_events": [],
                },
            )
            snapshot = self.active_stage_healing_snapshot(actor_id)
            counter_state = self.team_healing_states.get(actor_id)
            exact_counter = (
                counter_state
                if counter_state is not None and counter_state.exact_for_encounter
                else None
            )
            raw_skill_effective = {
                int(skill_id): int(values.get("effective", 0) or 0)
                for skill_id, values in raw["skills"].items()
                if int(values.get("effective", 0) or 0) > 0
            }
            detail_verified = bool(
                snapshot is not None
                and int(raw["effective"]) == snapshot.effective_healing
                and raw_skill_effective == snapshot.skills
            )
            if snapshot is None:
                if exact_counter is not None:
                    counter_effective = int(
                        exact_counter.accepted_effective_healing
                    )
                    observed_effective = int(raw["effective"])
                    effective = max(counter_effective, observed_effective)
                    coverage = (
                        "live_exact_callbacks_ahead_of_server_counter"
                        if observed_effective > counter_effective
                        else "server_team_counter_with_observed_callbacks"
                    )
                else:
                    coverage = "live_exact_callbacks_unverified"
                    effective = int(raw["effective"])
            elif detail_verified:
                coverage = "server_verified_callbacks"
                effective = snapshot.effective_healing
            else:
                coverage = "server_effective_with_partial_callbacks"
                effective = snapshot.effective_healing
            if int(raw["total"]) <= 0 and effective <= 0:
                continue

            total = (
                int(raw["total"])
                if (snapshot is None and exact_counter is None) or detail_verified
                else None
            )
            overhealing = total - effective if total is not None else None
            observed_total = int(raw["total"])
            observed_effective = int(raw["effective"])
            observed_overhealing = max(0, observed_total - observed_effective)
            observed_overheal_rate = (
                observed_overhealing / observed_total
                if observed_total > 0
                else None
            )
            shown_overheal_rate = (
                overhealing / total
                if total is not None and total > 0
                else observed_overheal_rate
            )
            overheal_rate_partial = bool(
                total is None and observed_overheal_rate is not None
            )
            skill_rows: list[dict] = []
            if snapshot is not None:
                for skill_id, skill_effective in sorted(
                    snapshot.skills.items(), key=lambda item: item[1], reverse=True
                ):
                    raw_skill = raw["skills"].get(skill_id, {})
                    skill_total = (
                        int(raw_skill.get("total", 0) or 0)
                        if detail_verified
                        else None
                    )
                    skill_rows.append(
                        {
                            "skill_id": skill_id,
                            "name": self.display_skill_name(actor_id, skill_id),
                            "total_healing": skill_total,
                            "effective_healing": skill_effective,
                            "overhealing": (
                                skill_total - skill_effective
                                if skill_total is not None
                                else None
                            ),
                            "share": skill_effective / effective if effective else 0.0,
                            "events": (
                                int(raw_skill.get("events", 0) or 0)
                                if detail_verified
                                else None
                            ),
                            "source": "server_stage_summary",
                        }
                    )
                if detail_verified:
                    for skill_id, values in sorted(
                        raw["skills"].items(),
                        key=lambda item: int(item[1].get("total", 0) or 0),
                        reverse=True,
                    ):
                        skill_total = int(values.get("total", 0) or 0)
                        skill_effective = int(values.get("effective", 0) or 0)
                        if (
                            skill_id in snapshot.skills
                            or skill_total <= 0
                            or skill_effective != 0
                        ):
                            continue
                        skill_rows.append(
                            {
                                "skill_id": skill_id,
                                "name": self.display_skill_name(actor_id, skill_id),
                                "total_healing": skill_total,
                                "effective_healing": 0,
                                "overhealing": skill_total,
                                "share": 0.0,
                                "events": int(values.get("events", 0) or 0),
                                "source": "network_exact_zero_effective",
                            }
                        )
                if snapshot.unclassified_healing > 0:
                    skill_rows.append(
                        {
                            "skill_id": 0,
                            "name": "未归类治疗",
                            "total_healing": None,
                            "effective_healing": snapshot.unclassified_healing,
                            "overhealing": None,
                            "share": snapshot.unclassified_healing / effective,
                            "events": None,
                            "source": "server_total_minus_server_skills",
                        }
                    )
            else:
                for skill_id, values in sorted(
                    raw["skills"].items(),
                    key=lambda item: int(item[1].get("effective", 0) or 0),
                    reverse=True,
                ):
                    skill_total = int(values.get("total", 0) or 0)
                    skill_effective = int(values.get("effective", 0) or 0)
                    skill_rows.append(
                        {
                            "skill_id": skill_id,
                            "name": self.display_skill_name(actor_id, skill_id),
                            "total_healing": skill_total,
                            "effective_healing": skill_effective,
                            "overhealing": skill_total - skill_effective,
                            "share": skill_effective / effective if effective else 0.0,
                            "events": int(values.get("events", 0) or 0),
                            "source": "network_exact_unverified_coverage",
                        }
                    )
                unclassified_effective = max(0, effective - observed_effective)
                if exact_counter is not None and unclassified_effective:
                    skill_rows.append(
                        {
                            "skill_id": 0,
                            "name": "未归类治疗",
                            "total_healing": None,
                            "effective_healing": unclassified_effective,
                            "overhealing": None,
                            "share": (
                                unclassified_effective / effective
                                if effective
                                else 0.0
                            ),
                            "events": None,
                            "source": "server_total_minus_observed_callbacks",
                        }
                    )

            target_rows = []
            for target_id, values in sorted(
                raw["targets"].items(),
                key=lambda item: int(item[1].get("effective", 0) or 0),
                reverse=True,
            ):
                target_total = int(values.get("total", 0) or 0)
                target_effective = int(values.get("effective", 0) or 0)
                target_rows.append(
                    {
                        "target_id": target_id,
                        "name": self.display_name(target_id) or f"玩家 {target_id}",
                        "total_healing": target_total,
                        "effective_healing": target_effective,
                        "overhealing": target_total - target_effective,
                        "share": (
                            target_effective / observed_effective
                            if observed_effective
                            else 0.0
                        ),
                        "events": int(values.get("events", 0) or 0),
                        "coverage": (
                            "verified_complete"
                            if detail_verified
                            else "exact_observed_partial"
                        ),
                    }
                )

            responses = response_by_actor.get(actor_id, [])
            response_values = [
                float(item.get("response_ms", 0.0) or 0.0)
                for item in responses
                if float(item.get("response_ms", 0.0) or 0.0) >= 0
            ]
            observed_peak_hps = self._rolling_peak_hps(raw["effective_events"])
            try:
                fallback_index = ordered_ids.index(actor_id) + 1
            except ValueError:
                fallback_index = len(healers) + 1
            healers.append(
                {
                    "actor_id": actor_id,
                    "name": self.display_name(actor_id) or f"玩家{fallback_index}",
                    "is_self": actor_id == self.self_id,
                    "profession_id": self.actor_profession_id(actor_id),
                    "extraordinary_rating": self.entity_extraordinary_ratings.get(
                        actor_id
                    ),
                    "is_ai": self.actor_is_ai(actor_id),
                    "hps": effective / divisor if divisor else 0.0,
                    "total_healing": total,
                    "effective_healing": effective,
                    "overhealing": overhealing,
                    "overheal_rate": shown_overheal_rate,
                    "overheal_rate_partial": overheal_rate_partial,
                    "overheal_rate_source": (
                        "observed_partial"
                        if overheal_rate_partial
                        else "complete"
                        if shown_overheal_rate is not None
                        else "unavailable"
                    ),
                    "peak_hps": (
                        observed_peak_hps
                        if (
                            detail_verified
                            or (
                                snapshot is None
                                and (
                                    exact_counter is None
                                    or observed_effective == effective
                                )
                            )
                        )
                        else None
                    ),
                    "observed_peak_hps": observed_peak_hps,
                    "observed_total_healing": observed_total,
                    "observed_effective_healing": observed_effective,
                    "observed_overhealing": observed_overhealing,
                    "observed_overheal_rate": observed_overheal_rate,
                    "events": int(raw["events"]),
                    "coverage": coverage,
                    "skills": skill_rows,
                    "targets": target_rows,
                    "response": {
                        "fastest_ms": min(response_values) if response_values else None,
                        "slowest_ms": max(response_values) if response_values else None,
                        "samples": len(response_values),
                        "covered_target_count": len(
                            {
                                int(item.get("target_id", 0) or 0)
                                for item in responses
                                if int(item.get("target_id", 0) or 0) > 0
                            }
                        ),
                        "coverage": (
                            "bound_realtime_hp"
                            if self.actor_health_states
                            else "unavailable"
                        ),
                    },
                    "healing_summary_id": snapshot.summary_id if snapshot else "",
                }
            )

        healers.sort(
            key=lambda row: (
                int(row.get("effective_healing", 0) or 0),
                int(row.get("observed_total_healing", 0) or 0),
            ),
            reverse=True,
        )
        team_effective = sum(
            int(row.get("effective_healing", 0) or 0) for row in healers
        )
        complete_totals = [row.get("total_healing") for row in healers]
        team_total = (
            sum(int(value or 0) for value in complete_totals)
            if all(value is not None for value in complete_totals)
            else None
        )
        summary = {
            "peak_window_seconds": 5,
            "hps_duration_seconds": divisor,
            "team_hps": team_effective / divisor if divisor else 0.0,
            "team_total_healing": team_total,
            "team_effective_healing": team_effective,
            "team_overhealing": (
                team_total - team_effective if team_total is not None else None
            ),
            "healers": healers,
            "source_policy": (
                "live Common counters supply exact effective totals; server "
                "settlement supplies final effective totals and skill amounts; "
                "HealSyncV2 supplies exact observed gross, overheal, targets, "
                "peak and response samples without proportional completion"
            ),
        }
        self.healing_summary_cache_key = cache_key
        self.healing_summary_cache = summary
        return summary

    def _current_member_ids(self) -> set[int]:
        members = set(self.party_ids) | self.provisional_party_ids
        if self.self_id is not None:
            members.add(self.self_id)
        return members - self.non_player_actor_ids

    def _combat_clock_target_scope_values(self) -> tuple[object, ...]:
        """Return one stable Boss-family identity without exposing raw IDs."""

        target_ids = self._encounter_damage_target_ids() | {
            int(self.combat_target_id or 0)
        }
        target_ids.discard(0)
        templates = {
            int(monster.template_id or 0)
            for entity_id in target_ids
            if (monster := self.monsters.get(entity_id)) is not None
            and int(monster.template_id or 0) > 0
        }
        for family in COMBAT_CLOCK_BOSS_TEMPLATE_FAMILIES:
            if templates.intersection(family):
                return ("boss-template-family", *sorted(family))
        if templates:
            primary = self.monsters.get(int(self.combat_target_id or 0))
            primary_template = int(primary.template_id or 0) if primary else 0
            if primary_template:
                return ("boss-template", primary_template)
            return ("boss-templates", *sorted(templates))
        # Entity IDs are identical inside a game instance but are hashed before
        # leaving the client.  This is the fallback only while template
        # metadata is unavailable.
        if self.combat_target_id is not None:
            return ("boss-entity", int(self.combat_target_id))
        return ()

    def _freeze_combat_clock_scope(self) -> bool:
        if self.combat_clock_party_key and self.combat_clock_target_key:
            return True
        members = self._current_member_ids()
        expected_members = max(0, int(self.party_member_count or 0))
        if (
            not self.party_known
            or expected_members < 2
            or len(members) < expected_members
            or len(self.party_user_tokens) != expected_members
        ):
            return False
        target_values = self._combat_clock_target_scope_values()
        if not target_values:
            return False
        self.combat_clock_party_key = combat_clock_digest(
            "party-token", sorted(self.party_user_tokens)
        )
        self.combat_clock_target_key = combat_clock_digest(
            "target-family", target_values
        )
        return True

    def _combat_clock_report_state(
        self,
        now: float,
        *,
        requested_state: str = "",
        ended: bool | None = None,
        end_reason: str = "",
    ) -> tuple[str, str]:
        reason = str(end_reason or self.combat_end_reason or "").strip().casefold()
        state = str(requested_state or "").strip().casefold()
        if state not in {"active", "settling", "final"}:
            state = ""
        if self.game_server_duration_seconds:
            return "final", reason or "game_server_settlement"
        if reason in COMBAT_CLOCK_FINAL_ARCHIVE_REASONS:
            return "final", reason
        if state:
            return state, reason
        if ended is True:
            return "settling", reason or "local_archive_pending_confirmation"
        if (
            self.combat_end_time
            or self._result_frozen_by_target_death()
            or not self.active(now)
        ):
            if not reason:
                reason = (
                    "target_hp_zero"
                    if self._result_frozen_by_target_death()
                    else "quiet_interval"
                )
            return "settling", reason
        return "active", reason

    def combat_clock_snapshot(
        self,
        now: float | None = None,
        *,
        ended: bool | None = None,
        state: str = "",
        end_reason: str = "",
    ) -> dict[str, object] | None:
        if (
            not self.first_damage_time
            or not self.last_damage_time
            or self.combat_target_id is None
        ):
            return None
        if not self._freeze_combat_clock_scope():
            return None
        total_damage = sum(
            max(0, int(actor.damage or 0)) for actor in self.stats.values()
        )
        if total_damage <= 0:
            return None
        now = time.time() if now is None else float(now)
        report_state, report_reason = self._combat_clock_report_state(
            now,
            requested_state=state,
            ended=ended,
            end_reason=end_reason,
        )
        if report_state == "active":
            elapsed = max(0.001, now - self.first_damage_time)
            end_age = 0.0
        else:
            end_time = self.combat_end_time or self.last_damage_time
            elapsed = (
                self.game_server_duration_seconds
                if report_state == "final" and self.game_server_duration_seconds
                else max(0.001, end_time - self.first_damage_time)
            )
            end_age = max(0.0, now - end_time)
        activity_age = max(0.0, now - self.last_damage_time)
        elapsed = min(
            float(COMBAT_CLOCK_MAX_SECONDS), max(0.001, float(elapsed))
        )
        end_age = min(float(COMBAT_CLOCK_MAX_SECONDS), float(end_age))
        activity_age = min(
            float(COMBAT_CLOCK_MAX_SECONDS), float(activity_age)
        )
        signature = (
            self.combat_clock_party_key,
            self.combat_clock_target_key,
            report_state,
            round(elapsed, 3),
            total_damage,
            report_reason,
        )
        if signature != self.combat_clock_last_snapshot_signature:
            self.combat_clock_client_revision += 1
            self.combat_clock_last_snapshot_signature = signature
        return {
            "party_key": self.combat_clock_party_key,
            "target_key": self.combat_clock_target_key,
            "encounter_id": self.encounter_id,
            "state": report_state,
            "client_revision": self.combat_clock_client_revision,
            "elapsed_seconds": elapsed,
            "end_age_seconds": end_age,
            "activity_age_seconds": activity_age,
            "total_damage": total_damage,
            "end_reason": report_reason,
        }

    def apply_combat_clock(
        self, result: CombatClockResult, *, received_at: float | None = None
    ) -> bool:
        if (
            not result.synchronized
            or result.encounter_id != self.encounter_id
            or not result.clock_id
        ):
            return False
        state = str(result.state or ("final" if result.final else "active"))
        state = state.strip().casefold()
        if state not in {"active", "settling", "final"}:
            return False
        if (
            (
                self.combat_clock_party_key
                and result.party_key != self.combat_clock_party_key
            )
            or (
                self.combat_clock_target_key
                and result.target_key != self.combat_clock_target_key
            )
            or (
                self.shared_clock_revision
                and result.revision < self.shared_clock_revision
            )
        ):
            return False
        try:
            duration = float(result.duration_seconds)
        except (TypeError, ValueError, OverflowError):
            return False
        local_total_damage = sum(
            max(0, int(actor.damage or 0)) for actor in self.stats.values()
        )
        observed_span = max(
            0.0, self.last_damage_time - self.first_damage_time
        )
        shared_started_at = max(0.0, float(result.started_at or 0.0))
        shared_ended_at = (
            max(0.0, float(result.ended_at or 0.0))
            if state == "final"
            else shared_started_at + duration
        )
        if (
            not math.isfinite(duration)
            or duration < 1.0
            or duration > COMBAT_CLOCK_MAX_SECONDS
            or (
                state == "final"
                and shared_started_at
                and shared_ended_at
                and abs(
                    (shared_ended_at - shared_started_at) - duration
                ) > COMBAT_CLOCK_DURATION_EPSILON_SECONDS
            )
            or not combat_clock_covers_local_span(duration, observed_span)
            or (
                result.total_damage
                and result.total_damage < local_total_damage
            )
            or (
                state == "final"
                and result.total_damage
                and result.total_damage != local_total_damage
            )
        ):
            return False
        changed = bool(
            self.shared_clock_id != result.clock_id
            or abs(self.shared_clock_duration_seconds - duration) >= 0.001
            or self.shared_clock_state != state
            or self.shared_clock_revision != int(result.revision or 0)
        )
        self.shared_clock_id = result.clock_id
        self.shared_clock_duration_seconds = duration
        self.shared_clock_started_at = max(0.0, float(result.started_at or 0.0))
        self.shared_clock_ended_at = max(0.0, float(result.ended_at or 0.0))
        self.shared_clock_server_time = max(0.0, float(result.server_time or 0.0))
        self.shared_clock_received_at = (
            time.time() if received_at is None else float(received_at)
        )
        self.shared_clock_state = state
        self.shared_clock_final = state == "final"
        self.shared_clock_revision = max(
            self.shared_clock_revision, int(result.revision or 0)
        )
        self.shared_clock_client_revision = max(
            0, int(result.client_revision or 0)
        )
        self.shared_clock_party_key = str(result.party_key or "")
        self.shared_clock_target_key = str(result.target_key or "")
        self.shared_clock_total_damage = max(
            0, int(result.total_damage or 0)
        )
        if self.shared_clock_final:
            self._queue_current_record_refresh()
        return changed

    def _mark_non_player_actor(self, entity_id: int) -> bool:
        """Remove a late-confirmed monster from every player-only data source."""
        if not entity_id:
            return False
        was_encounter_member = entity_id in self.encounter_member_ids
        changed = entity_id not in self.non_player_actor_ids
        self.non_player_actor_ids.add(entity_id)

        if self.self_id == entity_id:
            self.self_id = None
            changed = True
        for values in (
            self.party_ids,
            self.provisional_party_ids,
            self.friendly_ids,
            self.encounter_member_ids,
        ):
            if entity_id in values:
                values.discard(entity_id)
                changed = True
        filtered_order = [
            actor_id for actor_id in self.friend_order if actor_id != entity_id
        ]
        if filtered_order != self.friend_order:
            self.friend_order = filtered_order
            changed = True

        for mapping in (
            self.entity_professions,
            self.entity_extraordinary_ratings,
            self.entity_ai_states,
            self.entity_fight_attributes,
            self.entity_fight_attribute_times,
            self.team_damage_states,
            self.team_taken_states,
            self.team_healing_states,
            self.stage_actor_metrics,
            self.stage_actor_penetration_metrics,
            self.stage_actor_taken,
            self.pending_stage_actor_taken,
            self.stage_healing_snapshots,
            self.member_death_states,
            self.member_life_times,
            self.member_life_transitions,
            self.pending_sun_deaths,
            self.member_death_counts,
            self.member_revive_counts,
            self.member_dead_since,
            self.member_dead_durations,
            self.actor_health_states,
            self.pending_health_drops,
        ):
            if mapping.pop(entity_id, None) is not None:
                changed = True
        filtered_events = [
            event
            for event in self.events
            if int(event.get("attacker_id", 0) or 0) != entity_id
        ]
        if len(filtered_events) != len(self.events):
            self.events = filtered_events
            changed = True
        filtered_pending = [
            event
            for event in self.pending_member_events
            if int(event.get("attacker_id", 0) or 0) != entity_id
        ]
        if len(filtered_pending) != len(self.pending_member_events):
            self.pending_member_events = filtered_pending
            changed = True
        filtered_healing = [
            event
            for event in self.healing_events
            if int(event.get("healer_id", 0) or 0) != entity_id
            and int(event.get("target_id", 0) or 0) != entity_id
        ]
        if len(filtered_healing) != len(self.healing_events):
            self.healing_events = filtered_healing
            self.healing_event_keys = {
                self._healing_event_key(event) for event in filtered_healing
            }
            changed = True
        filtered_responses = [
            response
            for response in self.healing_responses
            if int(response.get("healer_id", 0) or 0) != entity_id
            and int(response.get("target_id", 0) or 0) != entity_id
        ]
        if len(filtered_responses) != len(self.healing_responses):
            self.healing_responses = filtered_responses
            changed = True
        filtered_response_keys = {
            key
            for key in self.healing_response_keys
            if key[0] != entity_id and key[2] != entity_id
        }
        if filtered_response_keys != self.healing_response_keys:
            self.healing_response_keys = filtered_response_keys
            changed = True

        for summary_id, summary in list(self.stage_summaries.items()):
            actors = summary.get("actors", [])
            if not isinstance(actors, list):
                continue
            filtered_actors = [
                row
                for row in actors
                if not isinstance(row, dict)
                or int(row.get("actor_id", 0) or 0) != entity_id
            ]
            if len(filtered_actors) != len(actors):
                cleaned_summary = dict(summary)
                cleaned_summary["actors"] = filtered_actors
                self.stage_summaries[summary_id] = cleaned_summary
                changed = True

        if was_encounter_member and self.encounter_team_size > 0:
            self.encounter_team_size = min(
                MAX_PARTY_MEMBERS,
                max(
                    len(self.encounter_member_ids),
                    self.encounter_team_size - 1,
                ),
            )
        return changed

    def _party_roster_is_resolved(self) -> bool:
        if not self.party_known:
            return False
        resolved_members = {
            actor_id for actor_id in self._current_member_ids() if actor_id > 0
        }
        expected = max(1, self.party_member_count)
        return len(resolved_members) >= expected

    def _admit_provisional_party_actor(self, event: dict) -> bool:
        if (
            not self.party_known
            or self.party_member_count <= 1
            or event.get("player_attacker") is not True
            or event.get("party_attacker") is False
        ):
            return False
        try:
            attacker = int(event.get("attacker_id", 0) or 0)
            target = int(event.get("target_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if attacker <= 0 or attacker in self._current_member_ids():
            return attacker in self.provisional_party_ids
        if not (
            self._is_priority_target(target)
            or self._is_encounter_damage_target(target)
        ):
            return False
        if attacker in self.encounter_member_ids:
            return True

        # Role/token packets and DamageSync can use different actor IDs for the
        # same person.  Count verified damage participants, not every positive
        # roster placeholder, otherwise a seemingly complete 12-player roster
        # rejects all live teammate damage except the local player.
        verified_members = set(self.encounter_member_ids)
        if self.self_id is not None:
            verified_members.add(self.self_id)
        if len(verified_members) >= self.party_member_count:
            return False

        resolved_members = {
            actor_id for actor_id in self._current_member_ids() if actor_id > 0
        }
        if len(resolved_members) < self.party_member_count:
            self.provisional_party_ids.add(attacker)
        self.encounter_member_ids.add(attacker)
        self.friendly_ids.add(attacker)
        if attacker not in self.friend_order:
            self.friend_order.append(attacker)
        self._replay_pending_member_events()
        return True

    def _register_encounter_target(self, entity_id: int, *, add: bool = False) -> None:
        if not entity_id:
            return
        self.encounter_target_ids.add(entity_id)
        if entity_id not in self.encounter_target_order:
            self.encounter_target_order.append(entity_id)
        if add:
            self.encounter_add_target_ids.add(entity_id)

    def _current_boss_target_ids(self) -> set[int]:
        target_ids = set(self.simultaneous_boss_target_ids)
        if self.combat_target_id is not None:
            target_ids.add(int(self.combat_target_id))
        return {entity_id for entity_id in target_ids if entity_id > 0}

    def _ordered_current_boss_target_ids(self) -> list[int]:
        target_ids = self._current_boss_target_ids()
        if not target_ids:
            return []
        ordered = [
            entity_id
            for entity_id in self.simultaneous_boss_target_order
            if entity_id in target_ids
        ]
        primary_id = int(self.combat_target_id or 0)
        if primary_id in target_ids and primary_id not in ordered:
            ordered.insert(0, primary_id)
        for entity_id in self.encounter_target_order:
            if entity_id in target_ids and entity_id not in ordered:
                ordered.append(entity_id)
        ordered.extend(sorted(target_ids - set(ordered)))
        return ordered

    def _confirmed_boss_fight_mode_active(self) -> bool:
        """Return whether an identified real Boss is explicitly fighting."""

        if self.long_gap_phase_suspended or self._is_dummy_encounter():
            return False
        return any(
            self._is_priority_target(entity_id)
            and self.entity_combat_states.get(entity_id) is True
            for entity_id in self._current_boss_target_ids()
        )

    def _confirmed_boss_fight_mode_end(self) -> float:
        """Return the common Boss fight-mode [0] boundary, if complete."""

        if self.long_gap_phase_suspended or self._is_dummy_encounter():
            return 0.0
        target_ids = {
            entity_id
            for entity_id in self._current_boss_target_ids()
            if self._is_priority_target(entity_id)
        }
        if not target_ids or any(
            self.entity_combat_states.get(entity_id) is not False
            for entity_id in target_ids
        ):
            return 0.0
        timestamps = [
            int(self.entity_combat_state_times.get(entity_id, 0) or 0)
            for entity_id in target_ids
        ]
        if not timestamps or any(timestamp <= 0 for timestamp in timestamps):
            return 0.0
        return max(
            self._event_seconds({"filetime_100ns": timestamp})
            for timestamp in timestamps
        )

    def _has_simultaneous_bosses(self) -> bool:
        return len(self._current_boss_target_ids()) > 1

    def _register_simultaneous_boss_target(self, entity_id: int) -> bool:
        entity_id = int(entity_id or 0)
        current_id = int(self.combat_target_id or 0)
        if not entity_id or not current_id:
            return False
        current_ids = self._current_boss_target_ids()
        if entity_id in current_ids:
            return False
        if len(current_ids) >= MAX_SIMULTANEOUS_BOSSES:
            return False
        if not self.simultaneous_boss_target_ids:
            self.simultaneous_boss_target_ids.add(current_id)
            if current_id not in self.simultaneous_boss_target_order:
                self.simultaneous_boss_target_order.append(current_id)
        self.simultaneous_boss_target_ids.add(entity_id)
        if entity_id not in self.simultaneous_boss_target_order:
            self.simultaneous_boss_target_order.append(entity_id)
        self._register_encounter_target(entity_id)
        self.pending_active_boss_id = None
        self.pending_active_boss_time_100ns = 0
        self._resolve_combat_sides()
        return True

    def _replace_simultaneous_boss_target(
        self, previous_id: int, incoming_id: int
    ) -> bool:
        previous_id = int(previous_id or 0)
        incoming_id = int(incoming_id or 0)
        if (
            not previous_id
            or not incoming_id
            or previous_id not in self.simultaneous_boss_target_ids
        ):
            return False
        self.simultaneous_boss_target_ids.discard(previous_id)
        self.simultaneous_boss_target_ids.add(incoming_id)
        replaced_order: list[int] = []
        for entity_id in self.simultaneous_boss_target_order:
            replacement = incoming_id if entity_id == previous_id else entity_id
            if replacement not in replaced_order:
                replaced_order.append(replacement)
        if incoming_id not in replaced_order:
            replaced_order.append(incoming_id)
        self.simultaneous_boss_target_order = replaced_order
        return True

    @staticmethod
    def _boss_is_confirmed_dead(monster: MonsterStats | None) -> bool:
        return bool(
            monster is not None
            and monster.current_hp is not None
            and monster.current_hp <= 0
            and monster.death_confirmed
        )

    def _verified_simultaneous_boss_group(
        self, entity_ids: set[int]
    ) -> frozenset[int] | None:
        templates: set[int] = set()
        for entity_id in entity_ids:
            monster = self.monsters.get(int(entity_id or 0))
            template_id = int(monster.template_id or 0) if monster else 0
            if not template_id:
                return None
            templates.add(template_id)
        if len(templates) != len(entity_ids):
            return None
        template_group = frozenset(templates)
        return next(
            (
                group
                for group in VERIFIED_SIMULTANEOUS_BOSS_TEMPLATE_GROUPS
                if group == template_group
            ),
            None,
        )

    def _verified_simultaneous_boss_pair(
        self, first_entity_id: int, second_entity_id: int
    ) -> bool:
        if not first_entity_id or not second_entity_id:
            return False
        return self._verified_simultaneous_boss_group(
            {int(first_entity_id), int(second_entity_id)}
        ) is not None

    def _verified_simultaneous_boss_encounter_group(
        self,
    ) -> frozenset[int] | None:
        """Return the verified dual-Boss group already bound to this encounter."""

        entity_ids = {
            *self.encounter_target_ids,
            *self.linked_boss_target_ids,
            *self.simultaneous_boss_target_ids,
        }
        if self.combat_target_id is not None:
            entity_ids.add(int(self.combat_target_id))
        templates = {
            int(monster.template_id or 0)
            for entity_id in entity_ids
            if (monster := self.monsters.get(int(entity_id or 0))) is not None
            and int(monster.template_id or 0)
        }
        return next(
            (
                group
                for group in VERIFIED_SIMULTANEOUS_BOSS_TEMPLATE_GROUPS
                if group.issubset(templates)
            ),
            None,
        )

    def _verified_simultaneous_boss_phase_group(
        self,
    ) -> frozenset[int] | None:
        group = self._verified_simultaneous_boss_encounter_group()
        if group is None or not VERIFIED_SIMULTANEOUS_BOSS_SUCCESSORS.get(group):
            return None
        return group

    def _awaiting_verified_simultaneous_boss_successor(self) -> bool:
        group = self._verified_simultaneous_boss_phase_group()
        if group is None or self.combat_end_reason in {
            "party_wipe",
            "target_reset",
        }:
            return False
        current_templates = {
            int(monster.template_id or 0)
            for entity_id in self._current_boss_target_ids()
            if (monster := self.monsters.get(entity_id)) is not None
        }
        successors = VERIFIED_SIMULTANEOUS_BOSS_SUCCESSORS.get(group, ())
        return bool(
            current_templates.intersection(group)
            and not current_templates.intersection(successors)
        )

    def _target_has_player_damage(self, entity_id: int) -> bool:
        entity_id = int(entity_id or 0)
        return bool(
            entity_id
            and any(
                int(event.get("target_id", 0) or 0) == entity_id
                and int(event.get("damage", 0) or 0) > 0
                and self._actor_counts_for_encounter(
                    int(event.get("attacker_id", 0) or 0)
                )
                for event in self.events
            )
        )

    def _promote_verified_simultaneous_boss_partner(
        self,
        current_entity_id: int,
        candidate_entity_id: int,
        *,
        player_damage_observed: bool = False,
    ) -> bool:
        """Recover this one captured Boss identity when its profile is missing.

        The full-HP value is deliberately insufficient by itself. Promotion is
        allowed only beside the other known Boss and after a player damages the
        candidate in the same encounter.
        """

        current_entity_id = int(current_entity_id or 0)
        candidate_entity_id = int(candidate_entity_id or 0)
        current = self.monsters.get(current_entity_id)
        candidate = self.monsters.get(candidate_entity_id)
        if (
            not current_entity_id
            or not candidate_entity_id
            or current_entity_id == candidate_entity_id
            or current is None
            or candidate is None
            or candidate_entity_id in self._current_member_ids()
            or candidate_entity_id in self.friendly_ids
            or candidate.entity_type.casefold() in {"player", "role"}
            or candidate.healing_target
            or candidate.encounter_auxiliary
            or int(candidate.template_id or 0)
        ):
            return False
        current_template = int(current.template_id or 0)
        group = next(
            (
                verified_group
                for verified_group in VERIFIED_SIMULTANEOUS_BOSS_TEMPLATE_GROUPS
                if current_template in verified_group
            ),
            None,
        )
        if group is None:
            return False
        partner_templates = set(group) - {current_template}
        if len(partner_templates) != 1:
            return False
        partner_template = next(iter(partner_templates))
        maximum = self._monster_max_hp(candidate)
        if (
            not math.isfinite(maximum)
            or maximum <= 0
            or maximum != int(maximum)
            or int(maximum)
            not in VERIFIED_SIMULTANEOUS_BOSS_MAX_HP_BY_TEMPLATE.get(
                partner_template, ()
            )
            or not (
                player_damage_observed
                or self._target_has_player_damage(candidate_entity_id)
            )
        ):
            return False

        candidate.template_id = partner_template
        candidate.entity_type = "Boss"
        candidate.boss_type = 3
        candidate.boss_rank = 3
        self._apply_catalog_target_identity(candidate)
        self._mark_non_player_actor(candidate_entity_id)
        self.encounter_add_target_ids.discard(candidate_entity_id)
        return self._register_simultaneous_boss_target(candidate_entity_id)

    def _completed_simultaneous_boss_successor(self, entity_id: int) -> bool:
        current_ids = self._current_boss_target_ids()
        group = self._verified_simultaneous_boss_group(current_ids)
        monster = self.monsters.get(int(entity_id or 0))
        incoming_template = int(monster.template_id or 0) if monster else 0
        incoming_is_successor = bool(
            group is not None
            and incoming_template
            in VERIFIED_SIMULTANEOUS_BOSS_SUCCESSORS.get(group, ())
        )
        completed = bool(
            (
                self.combat_end_time
                and self.combat_end_reason == "target_defeated"
            )
            or (
                current_ids
                and all(
                    self._boss_is_confirmed_dead(self.monsters.get(target_id))
                    for target_id in current_ids
                )
            )
            or (
                incoming_is_successor
                and any(
                    self._boss_is_confirmed_dead(self.monsters.get(target_id))
                    for target_id in current_ids
                )
            )
        )
        return incoming_is_successor and completed

    def _verified_simultaneous_boss_successor(self, entity_id: int) -> bool:
        group = self._verified_simultaneous_boss_encounter_group()
        monster = self.monsters.get(int(entity_id or 0))
        incoming_template = int(monster.template_id or 0) if monster else 0
        return bool(
            group is not None
            and incoming_template
            in VERIFIED_SIMULTANEOUS_BOSS_SUCCESSORS.get(group, ())
        )

    def _continue_completed_simultaneous_boss_successor(
        self, entity_id: int, *, active_boss_confirmed: bool = False
    ) -> bool:
        entity_id = int(entity_id or 0)
        if not (
            self._completed_simultaneous_boss_successor(entity_id)
            or (
                active_boss_confirmed
                and self._verified_simultaneous_boss_successor(entity_id)
            )
        ):
            return False
        previous_ids = self._current_boss_target_ids()
        self.linked_boss_target_ids.update(previous_ids)
        self.linked_boss_target_ids.add(entity_id)
        self.simultaneous_boss_target_ids.clear()
        self.simultaneous_boss_target_order.clear()
        self.combat_target_id = entity_id
        self.active_target_id = entity_id
        self._register_encounter_target(entity_id)
        self.pending_active_boss_id = None
        self.pending_active_boss_time_100ns = 0
        self.combat_end_time = 0.0
        self.combat_end_reason = ""
        self._rebuild_member_life_metrics()
        self.healing_end_time = 0.0
        self.healing_end_reason = ""
        self.boss_reset_pending_100ns = 0
        self.completed_combats[:] = [
            record
            for record in self.completed_combats
            if record.get("encounter_id") != self.encounter_id
        ]
        self.last_archive_signature = None
        self.game_server_duration_seconds = 0.0
        self.game_server_duration_summary_id = ""
        self.game_server_duration_policy = ""
        self.game_server_duration_member_seconds = []
        self.game_server_duration_local_seconds = 0.0
        self.game_server_duration_difference_seconds = 0.0
        self.game_server_duration_rejection = {}
        self._resolve_combat_sides()
        return True

    def _stale_completed_simultaneous_boss_hp(
        self, monster: MonsterStats, update: dict
    ) -> bool:
        if (
            self.combat_end_reason != "target_defeated"
            or not self.combat_end_time
            or not self._boss_is_confirmed_dead(monster)
            or monster.entity_id not in self._current_boss_target_ids()
            or self._verified_simultaneous_boss_group(
                self._current_boss_target_ids()
            )
            is None
        ):
            return False
        try:
            current_hp = float(update.get("current_hp", 0) or 0)
            timestamp = int(update.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        elapsed = timestamp - int(monster.death_time_100ns or 0)
        return bool(
            current_hp > 0
            and monster.death_time_100ns
            and 0 <= elapsed
            <= int(SIMULTANEOUS_BOSS_LATE_HP_WINDOW_SECONDS * 10_000_000)
        )

    def _simultaneous_boss_evidence(
        self,
        entity_id: int,
        timestamp: int,
        *,
        explicit: bool = False,
        allow_hp_overlap: bool = False,
    ) -> bool:
        """Return whether a second Boss is demonstrably alive in this pull.

        Merely hitting another Boss-ranked entity is not enough: encounters can
        spawn Boss-like mechanics, and a new pull can appear before the stale
        entity from the previous pull disappears. Concurrent fight-mode is the
        strongest signal; overlapping fresh HP streams are the fallback used by
        clients that do not expose every fight-mode transition.
        """
        entity_id = int(entity_id or 0)
        current_ids = self._current_boss_target_ids()
        if entity_id in current_ids:
            return True
        if (
            not self.boss_only
            or not current_ids
            or len(current_ids) >= MAX_SIMULTANEOUS_BOSSES
            or not self._is_priority_target(entity_id)
        ):
            return False
        incoming = self.monsters.get(entity_id)
        if incoming is None or self._boss_is_confirmed_dead(incoming):
            return False
        existing = [
            self.monsters.get(target_id)
            for target_id in current_ids
            if target_id != entity_id
        ]
        existing = [
            monster
            for monster in existing
            if monster is not None and not self._boss_is_confirmed_dead(monster)
        ]
        if not existing:
            return False
        existing = [
            monster
            for monster in existing
            if self._verified_simultaneous_boss_pair(
                monster.entity_id, entity_id
            )
        ]
        if not existing:
            return False
        if self._is_dummy_target(entity_id) or any(
            self._is_dummy_target(monster.entity_id) for monster in existing
        ):
            return False
        for monster in existing:
            if self._bosses_share_phase(monster, incoming):
                return False
            templates = (
                int(monster.template_id or 0),
                int(incoming.template_id or 0),
            )
            if (
                templates in SEPARATE_BOSS_ENCOUNTER_TRANSITIONS
                or tuple(reversed(templates))
                in SEPARATE_BOSS_ENCOUNTER_TRANSITIONS
            ):
                return False

        if explicit:
            return True
        incoming_in_combat = self.entity_combat_states.get(entity_id) is True
        existing_in_combat = any(
            self.entity_combat_states.get(monster.entity_id) is True
            for monster in existing
        )
        if incoming_in_combat and existing_in_combat:
            return True
        if self.entity_combat_states.get(entity_id) is False or all(
            self.entity_combat_states.get(monster.entity_id) is False
            for monster in existing
        ):
            return False
        if (
            not allow_hp_overlap
            or not timestamp
            or incoming.current_hp is None
            or incoming.current_hp <= 0
        ):
            return False
        freshness = int(SIMULTANEOUS_BOSS_HP_WINDOW_SECONDS * 10_000_000)

        def hp_is_fresh(monster: MonsterStats) -> bool:
            return bool(
                monster.current_hp is not None
                and monster.current_hp > 0
                and monster.last_hp_update_100ns
                and abs(timestamp - monster.last_hp_update_100ns) <= freshness
            )

        fresh_existing = [monster for monster in existing if hp_is_fresh(monster)]
        if not hp_is_fresh(incoming) or not fresh_existing:
            return False
        # A same-template entity is commonly a respawn after a wipe. Require
        # concurrent fight-mode (handled above) unless the parser explicitly
        # identifies it as a simultaneous Boss.
        incoming_template = int(incoming.template_id or 0)
        return not incoming_template or any(
            int(monster.template_id or 0) != incoming_template
            for monster in fresh_existing
        )

    def _try_register_simultaneous_boss(
        self,
        entity_id: int,
        timestamp: int,
        *,
        explicit: bool = False,
        allow_hp_overlap: bool = False,
    ) -> bool:
        if not self._simultaneous_boss_evidence(
            entity_id,
            timestamp,
            explicit=explicit,
            allow_hp_overlap=allow_hp_overlap,
        ):
            return False
        if entity_id in self._current_boss_target_ids():
            return True
        return self._register_simultaneous_boss_target(entity_id)

    def _try_register_verified_simultaneous_boss_partner(
        self, timestamp: int
    ) -> bool:
        current_ids = self._current_boss_target_ids()
        if len(current_ids) != 1:
            return False
        current_id = next(iter(current_ids))
        for monster in self.monsters.values():
            if self._promote_verified_simultaneous_boss_partner(
                current_id, monster.entity_id
            ):
                return True
        candidates = sorted(
            (
                monster
                for monster in self.monsters.values()
                if monster.entity_id != current_id
                and self._verified_simultaneous_boss_pair(
                    current_id, monster.entity_id
                )
            ),
            key=self._monster_activity,
            reverse=True,
        )
        return any(
            self._try_register_simultaneous_boss(
                monster.entity_id,
                timestamp,
                allow_hp_overlap=True,
            )
            for monster in candidates
        )

    def _multiphase_encounter(self) -> bool:
        monster = self.monsters.get(int(self.combat_target_id or 0))
        return bool(
            monster is not None
            and int(monster.template_id or 0) in MULTIPHASE_BOSS_TEMPLATE_IDS
        )

    @staticmethod
    def _long_gap_phase_continues(
        previous: MonsterStats | None, incoming: MonsterStats | None
    ) -> bool:
        if previous is None or incoming is None:
            return False
        return (
            int(previous.template_id or 0),
            int(incoming.template_id or 0),
        ) in LONG_GAP_BOSS_PHASE_TRANSITIONS

    def _awaiting_long_gap_phase_successor(self) -> bool:
        monster = self.monsters.get(int(self.combat_target_id or 0))
        template_id = int(monster.template_id or 0) if monster is not None else 0
        return bool(
            template_id
            and any(
                template_id == predecessor
                for predecessor, _successor in LONG_GAP_BOSS_PHASE_TRANSITIONS
            )
        )

    def _clear_long_gap_phase_suspension(self) -> None:
        self.long_gap_phase_suspended = False
        self.long_gap_phase_predecessor_entity_id = 0
        self.long_gap_phase_predecessor_template_id = 0
        self.long_gap_phase_suspended_at_100ns = 0

    def _suspend_long_gap_phase_for_scene(self, timestamp: int) -> bool:
        """Freeze a verified long-gap opening while its scripted scenes load."""

        if self.long_gap_phase_suspended:
            return bool(
                not self.combat_end_time
                and self.combat_end_reason
                not in {"boss_replaced", "party_wipe", "target_reset"}
            )
        target_id = int(self.combat_target_id or 0)
        monster = self.monsters.get(target_id)
        template_id = int(monster.template_id or 0) if monster is not None else 0
        if (
            not target_id
            or not template_id
            or not self._encounter_started()
            or self.combat_end_time
            or not any(
                template_id == predecessor
                for predecessor, _successor in LONG_GAP_BOSS_PHASE_TRANSITIONS
            )
        ):
            return False

        self.long_gap_phase_suspended = True
        self.long_gap_phase_predecessor_entity_id = target_id
        self.long_gap_phase_predecessor_template_id = template_id
        self.long_gap_phase_suspended_at_100ns = max(0, int(timestamp or 0))
        for state in self.team_damage_states.values():
            state.carried_damage = state.accepted_damage
            state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = max(
                state.snapshot_time_100ns,
                self.long_gap_phase_suspended_at_100ns,
            )
        for state in self.team_taken_states.values():
            state.carried_taken = state.accepted_taken
            state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = max(
                state.snapshot_time_100ns,
                self.long_gap_phase_suspended_at_100ns,
            )
        for state in self.team_healing_states.values():
            state.carried_effective_healing = state.accepted_effective_healing
            state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = max(
                state.snapshot_time_100ns,
                self.long_gap_phase_suspended_at_100ns,
            )
        # A pending response or stale current-HP sample must not span the
        # cinematic/intermission and turn into a fabricated final-phase sample.
        self.actor_health_states.clear()
        self.pending_health_drops.clear()
        for actor_id, dead in list(self.member_death_states.items()):
            if not dead or not self.long_gap_phase_suspended_at_100ns:
                continue
            transitions = self.member_life_transitions.setdefault(actor_id, [])
            transitions.append((self.long_gap_phase_suspended_at_100ns, False))
            self.member_life_transitions[actor_id] = (
                self._normalize_member_life_transitions(transitions)
            )
        # Scene loading emits synthetic life-state edges. Close any real P1
        # death at the boundary, then let P2 establish a fresh current state.
        self.pending_sun_deaths.clear()
        self.member_death_states.clear()
        self.member_life_times.clear()
        self._rebuild_member_life_metrics()
        self.boss_reset_pending_100ns = 0
        self.team_reset_pending = False
        self.healing_revision += 1
        self.healing_summary_cache_key = None
        self.healing_summary_cache = None
        return True

    def _resume_long_gap_phase_from_scene(
        self, incoming: MonsterStats | None, timestamp: int
    ) -> bool:
        """Resume only the exact successor and rebase past intermission totals."""

        if not self.long_gap_phase_suspended or incoming is None:
            return False
        transition = (
            int(self.long_gap_phase_predecessor_template_id or 0),
            int(incoming.template_id or 0),
        )
        if transition not in LONG_GAP_BOSS_PHASE_TRANSITIONS:
            return False
        baseline_time = max(0, int(timestamp or 0))
        for state in self.team_damage_states.values():
            state.carried_damage = state.accepted_damage
            state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = max(
                state.snapshot_time_100ns, baseline_time
            )
        for state in self.team_taken_states.values():
            state.carried_taken = state.accepted_taken
            state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = max(
                state.snapshot_time_100ns, baseline_time
            )
        for state in self.team_healing_states.values():
            state.carried_effective_healing = state.accepted_effective_healing
            state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = max(
                state.snapshot_time_100ns, baseline_time
            )
        self.boss_reset_pending_100ns = 0
        self.team_reset_pending = False
        self._clear_long_gap_phase_suspension()
        return True

    def _ingest_suspended_long_gap_team_stat(self, update: dict) -> bool:
        """Track absolute baselines during an intermission without accepting them."""

        try:
            actor_id = int(update.get("actor_id", 0) or 0)
            timestamp = int(update.get("filetime_100ns", 0) or 0)
            server_time = max(0, int(update.get("server_time", 0) or 0))
            full_snapshot = bool(update.get("full_snapshot"))
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            not actor_id
            or not timestamp
            or actor_id in self.non_player_actor_ids
        ):
            return False

        changed = False

        def track(
            state: object,
            absolute: int,
            *,
            omitted_zero: bool,
            accepted_name: str,
            carried_name: str,
            authoritative_damage: bool = False,
        ) -> bool:
            if omitted_zero and state.has_snapshot and state.last_absolute > 0:
                starts_new_epoch = bool(
                    full_snapshot
                    and server_time
                    and server_time != state.server_time
                )
                if not starts_new_epoch:
                    return False
            if state.server_time and server_time and server_time < state.server_time:
                return False
            if (
                state.snapshot_time_100ns
                and timestamp < state.snapshot_time_100ns
                and (not server_time or server_time == state.server_time)
            ):
                return False
            previous = (
                state.last_absolute,
                state.baseline_absolute,
                state.has_snapshot,
                state.snapshot_time_100ns,
                state.baseline_snapshot_time_100ns,
                state.server_time,
            )
            state.last_absolute = absolute
            state.baseline_absolute = absolute
            state.has_snapshot = True
            state.snapshot_time_100ns = max(state.snapshot_time_100ns, timestamp)
            state.baseline_snapshot_time_100ns = timestamp
            state.server_time = server_time or state.server_time
            setattr(state, carried_name, int(getattr(state, accepted_name)))
            if authoritative_damage:
                state.authoritative_snapshot = True
            current = (
                state.last_absolute,
                state.baseline_absolute,
                state.has_snapshot,
                state.snapshot_time_100ns,
                state.baseline_snapshot_time_100ns,
                state.server_time,
            )
            return current != previous

        if "absolute_damage" in update:
            try:
                absolute_damage = max(0, int(update.get("absolute_damage", 0)))
            except (TypeError, ValueError, OverflowError):
                absolute_damage = 0
            damage_state = self.team_damage_states.setdefault(
                actor_id, TeamDamageState(actor_id)
            )
            changed |= track(
                damage_state,
                absolute_damage,
                omitted_zero=bool(update.get("omitted_zero")),
                accepted_name="accepted_damage",
                carried_name="carried_damage",
                authoritative_damage=True,
            )
            self.team_server_time = max(self.team_server_time, server_time)
            self.team_server_update_100ns = max(
                self.team_server_update_100ns, timestamp
            )
        if "absolute_taken" in update:
            try:
                absolute_taken = max(0, int(update.get("absolute_taken", 0)))
            except (TypeError, ValueError, OverflowError):
                absolute_taken = 0
            changed |= track(
                self.team_taken_states.setdefault(
                    actor_id, TeamTakenState(actor_id)
                ),
                absolute_taken,
                omitted_zero=bool(update.get("taken_omitted_zero")),
                accepted_name="accepted_taken",
                carried_name="carried_taken",
            )
        if "absolute_effective_healing" in update:
            try:
                absolute_healing = max(
                    0, int(update.get("absolute_effective_healing", 0))
                )
            except (TypeError, ValueError, OverflowError):
                absolute_healing = 0
            changed |= track(
                self.team_healing_states.setdefault(
                    actor_id, TeamHealingState(actor_id)
                ),
                absolute_healing,
                omitted_zero=bool(update.get("healing_omitted_zero")),
                accepted_name="accepted_effective_healing",
                carried_name="carried_effective_healing",
            )
        self.latest_network_time_100ns = max(
            self.latest_network_time_100ns, timestamp
        )
        return changed

    def _active_long_gap_phase_transition(self) -> bool:
        current_id = int(self.combat_target_id or 0)
        current = self.monsters.get(current_id)
        current_template = int(current.template_id or 0) if current is not None else 0
        if not current_template:
            return False
        previous_ids = (
            set(self.linked_boss_target_ids)
            | set(self.encounter_target_ids)
        ) - {current_id}
        return any(
            (
                int(previous.template_id or 0),
                current_template,
            )
            in LONG_GAP_BOSS_PHASE_TRANSITIONS
            for entity_id in previous_ids
            if (previous := self.monsters.get(entity_id)) is not None
        )

    def _preserve_long_gap_phase_counters(self) -> bool:
        if self.combat_end_reason in {
            "boss_replaced",
            "party_wipe",
            "target_reset",
        }:
            return False
        return bool(
            self._awaiting_long_gap_phase_successor()
            or self._active_long_gap_phase_transition()
        )

    def _preserve_continuous_phase_counters(self) -> bool:
        """Keep cumulative team totals across a verified scripted phase."""

        if self.combat_end_reason in {"party_wipe", "target_reset"}:
            return False
        return bool(
            self._verified_simultaneous_boss_encounter_group() is not None
            or self._preserve_long_gap_phase_counters()
            or (
                int(getattr(self.monsters.get(int(self.combat_target_id or 0)), 'template_id', 0) or 0) == 7_102_991
                and any(int(getattr(self.monsters.get(entity_id), 'template_id', 0) or 0) == 7_102_990
                        for entity_id in self.linked_boss_target_ids)
            )
        )

    @staticmethod
    def _bosses_share_phase(
        previous: MonsterStats | None, incoming: MonsterStats | None
    ) -> bool:
        if previous is None or incoming is None:
            return False
        templates = (
            int(previous.template_id or 0),
            int(incoming.template_id or 0),
        )
        return bool(
            boss_names_share_phase(previous.name, incoming.name)
            or templates in BOSS_PHASE_TEMPLATE_TRANSITIONS
            or tuple(reversed(templates)) in BOSS_PHASE_TEMPLATE_TRANSITIONS
        )

    @staticmethod
    def _boss_phase_continues(
        previous: MonsterStats | None, incoming: MonsterStats | None
    ) -> bool:
        if previous is None or incoming is None:
            return False
        return bool(
            boss_phase_continues(previous.name, incoming.name)
            or (
                int(previous.template_id or 0),
                int(incoming.template_id or 0),
            )
            in BOSS_PHASE_TEMPLATE_TRANSITIONS
        )

    def _restore_unknown_phase_predecessor(
        self, previous: MonsterStats | None, incoming: MonsterStats | None
    ) -> bool:
        """Recover a uniquely determined first phase after a mid-fight start."""
        if previous is None or incoming is None or previous.template_id:
            return False
        if previous.name and not boss_name_is_placeholder(previous.name):
            return False
        if previous.entity_id != int(self.combat_target_id or 0):
            return False
        if previous.entity_id not in self.encounter_target_ids:
            return False
        if (
            self.encounter_dungeon_stage_id
            and self.current_dungeon_stage_id
            and self.encounter_dungeon_stage_id != self.current_dungeon_stage_id
        ):
            return False
        incoming_template_id = int(incoming.template_id or 0)
        predecessors = {
            int(predecessor_template_id)
            for predecessor_template_id, successor_template_id in (
                BOSS_PHASE_TEMPLATE_TRANSITIONS
            )
            if int(successor_template_id) == incoming_template_id
        }
        if len(predecessors) != 1:
            return False
        predecessor_template_id = predecessors.pop()
        previous.template_id = predecessor_template_id
        self._apply_catalog_target_identity(previous)
        return True

    def _damage_gap_starts_new_encounter(self) -> bool:
        monster = self.monsters.get(int(self.combat_target_id or 0))
        if self.combat_end_reason in {
            "boss_replaced",
            "party_wipe",
            "target_reset",
        }:
            return True
        if (
            self._verified_simultaneous_boss_phase_group() is not None
            or self._awaiting_long_gap_phase_successor()
            or self._active_long_gap_phase_transition()
        ):
            return False
        if monster is not None and self.entity_combat_states.get(
            monster.entity_id
        ) is True:
            return False
        if not self._multiphase_encounter():
            if monster is None or monster.current_hp is None:
                return True
            hp_ceiling = self._monster_max_hp(monster)
            if (
                hp_ceiling > 0
                and 0 < monster.current_hp < hp_ceiling * 0.995
            ):
                # A long mechanic with a demonstrably wounded, living Boss is
                # still the same pull. Only an explicit reset/full refill may
                # create a new encounter after the quiet period.
                return False
            return True
        if monster is None or monster.current_hp is None:
            return False
        hp_ceiling = self._monster_max_hp(monster)
        return bool(
            self.boss_reset_pending_100ns
            and hp_ceiling > 0
            and monster.current_hp >= hp_ceiling * 0.995
        )

    def _encounter_idle_timeout(self) -> float:
        if self._awaiting_verified_simultaneous_boss_successor():
            return max(
                self.encounter_gap,
                SIMULTANEOUS_BOSS_SUCCESSOR_WAIT_SECONDS,
            )
        if (
            self._multiphase_encounter()
            or self._has_simultaneous_bosses()
            or self._awaiting_long_gap_phase_successor()
        ):
            return self.encounter_gap
        return self.idle_gap

    def _target_hp_depleted(self) -> bool:
        if self._awaiting_long_gap_phase_successor():
            return False
        monsters = [
            self.monsters.get(entity_id)
            for entity_id in self._ordered_current_boss_target_ids()
        ]
        if not monsters or any(monster is None for monster in monsters):
            return False
        if not all(
            self._is_priority_target(monster.entity_id)
            and monster.current_hp is not None
            and monster.current_hp <= 0
            for monster in monsters
            if monster is not None
        ):
            return False
        # 星象仪者的守卫阶段发生时主 Boss 仍有血。只有主 Boss 自身的
        # 明确死亡包到达后才结束，避免结算清场时残留守卫的血量包让
        # 已经归零的 Boss 重新显示为战斗中。
        return not self._multiphase_encounter() or all(
            bool(monster and monster.death_confirmed) for monster in monsters
        )

    def _result_frozen_by_target_death(self) -> bool:
        return self._target_hp_depleted()

    def _buffer_pending_member_event(self, event: dict) -> None:
        event_time = self._event_seconds(event)
        cutoff = event_time - UNVERIFIED_MEMBER_EVENT_WINDOW_SECONDS
        self.pending_member_events = [
            pending
            for pending in self.pending_member_events
            if self._event_seconds(pending) >= cutoff
        ]
        self.pending_member_events.append(dict(event))
        if len(self.pending_member_events) > 8192:
            self.pending_member_events = self.pending_member_events[-4096:]

    def _target_event_disposition(self, target_id: int) -> str:
        """Return accept, pending, or reject for an incoming damage target."""
        if self._is_healing_target(target_id):
            # HealSyncV2 targets are never damage targets, even when a stale
            # Boss binding is still present from the previous pull.
            return "reject"
        if not self.boss_only:
            return "accept"
        if self._is_priority_target(target_id):
            return "accept"
        if self.combat_target_id is not None:
            # Preserve the existing in-encounter auxiliary inference. The
            # capture parser normally resolves these targets first, while the
            # model remains a fallback for late or missing metadata.
            return "accept"

        monster = self.monsters.get(target_id)
        if monster is None:
            return "pending"
        if monster.encounter_auxiliary:
            parent_ids = set(monster.encounter_parent_template_ids)
            if any(
                int(candidate.template_id or 0) in parent_ids
                and self._monster_rank(candidate) > 0
                for candidate in self.monsters.values()
            ):
                return "accept"
            return "pending"
        if monster.entity_type.casefold() in {"player", "role"}:
            return "reject"
        identity_known = bool(
            monster.entity_type
            or monster.template_id not in (None, 0)
            or monster.boss_type is not None
        )
        return "reject" if identity_known else "pending"

    def _remove_pending_target_event(self, token: int) -> tuple[int, dict] | None:
        item = self.pending_target_events.pop(token, None)
        if item is None:
            return None
        target_id, _event = item
        target_tokens = self.pending_target_event_ids.get(target_id)
        if target_tokens is not None:
            while target_tokens and target_tokens[0] not in self.pending_target_events:
                target_tokens.popleft()
            if not target_tokens:
                self.pending_target_event_ids.pop(target_id, None)
        return item

    def _prune_pending_target_events(self, timestamp: int) -> None:
        cutoff = timestamp - int(UNKNOWN_TARGET_EVENT_WINDOW_SECONDS * 10_000_000)
        while self.pending_target_events:
            token, (_target_id, event) = next(iter(self.pending_target_events.items()))
            event_timestamp = int(event.get("filetime_100ns", 0) or 0)
            if event_timestamp >= cutoff:
                break
            self._remove_pending_target_event(token)
            self.discarded_non_encounter_events += 1

    def _buffer_pending_target_event(self, event: dict) -> None:
        target_id = int(event.get("target_id", 0) or 0)
        timestamp = int(event.get("filetime_100ns", 0) or 0)
        if not target_id or not timestamp:
            self.discarded_non_encounter_events += 1
            return
        self._prune_pending_target_events(
            max(timestamp, self.latest_network_time_100ns)
        )
        self.pending_target_event_sequence += 1
        token = self.pending_target_event_sequence
        self.pending_target_events[token] = (target_id, dict(event))
        target_tokens = self.pending_target_event_ids.setdefault(target_id, deque())
        while target_tokens and target_tokens[0] not in self.pending_target_events:
            target_tokens.popleft()
        target_tokens.append(token)

        while len(target_tokens) > UNKNOWN_TARGET_EVENT_LIMIT_PER_TARGET:
            oldest = target_tokens.popleft()
            if self.pending_target_events.pop(oldest, None) is not None:
                self.discarded_non_encounter_events += 1
        while len(self.pending_target_events) > UNKNOWN_TARGET_EVENT_LIMIT_GLOBAL:
            _oldest, (oldest_target, _event) = self.pending_target_events.popitem(
                last=False
            )
            self.discarded_non_encounter_events += 1
            tokens = self.pending_target_event_ids.get(oldest_target)
            if tokens is not None:
                while tokens and tokens[0] not in self.pending_target_events:
                    tokens.popleft()
                if not tokens:
                    self.pending_target_event_ids.pop(oldest_target, None)

    def _resolve_pending_target_events(self, target_id: int) -> bool:
        if self.latest_network_time_100ns:
            self._prune_pending_target_events(self.latest_network_time_100ns)
        target_tokens = self.pending_target_event_ids.get(int(target_id), deque())
        if not target_tokens:
            return False
        disposition = self._target_event_disposition(int(target_id))
        if disposition == "pending":
            return False
        events: list[dict] = []
        for token in list(target_tokens):
            item = self.pending_target_events.pop(token, None)
            if item is not None:
                events.append(item[1])
        self.pending_target_event_ids.pop(int(target_id), None)
        if disposition == "reject":
            self.discarded_non_encounter_events += len(events)
            return False
        events.sort(key=lambda event: int(event.get("filetime_100ns", 0) or 0))
        for event in events:
            self.ingest(event)
        return bool(events)

    def _resolve_known_pending_target_events(self) -> bool:
        replayed = False
        for target_id in list(self.pending_target_event_ids):
            monster = self.monsters.get(target_id)
            if monster is None or not monster.encounter_auxiliary:
                continue
            replayed |= self._resolve_pending_target_events(target_id)
        return replayed

    def _replay_pending_member_events(self) -> bool:
        if not self.pending_member_events:
            return False
        members = self._current_member_ids() | self.encounter_member_ids
        newest_time = max(
            self._event_seconds(event) for event in self.pending_member_events
        )
        cutoff = newest_time - UNVERIFIED_MEMBER_EVENT_WINDOW_SECONDS
        roster_resolved = self._party_roster_is_resolved()
        accepted: list[dict] = []
        remaining: list[dict] = []
        for event in self.pending_member_events:
            attacker = int(event.get("attacker_id", 0) or 0)
            if attacker in members:
                accepted.append(event)
            elif not roster_resolved and self._event_seconds(event) >= cutoff:
                remaining.append(event)
        self.pending_member_events = remaining
        for event in accepted:
            self.ingest(event)
        return bool(accepted)

    def current_stats(self) -> list[ActorStats]:
        return [
            stats
            for stats in self.stats.values()
            if stats.damage > 0
            and self._actor_counts_for_encounter(stats.actor_id)
        ]

    def _sample_boss_hp_damage(self, second: int) -> bool:
        observed = max(0, int(self.observed_boss_damage_taken()))
        if observed <= 0:
            return False
        sample = (second, observed)
        if self.boss_hp_damage_samples:
            previous_second, previous_total = self.boss_hp_damage_samples[-1]
            if second < previous_second:
                return False
            if second == previous_second:
                if observed == previous_total:
                    return False
                self.boss_hp_damage_samples[-1] = sample
                return True
        self.boss_hp_damage_samples.append(sample)
        return True

    def sample_team_damage(self, now: float | None = None) -> bool:
        """Capture cumulative team and per-player totals for history."""

        if not self.first_damage_time or self.combat_target_id is None:
            return False
        sample_time = time.time() if now is None else float(now)
        if self.combat_end_time:
            sample_time = min(sample_time, self.combat_end_time)
        elif self._result_frozen_by_target_death() and self.last_damage_time:
            sample_time = min(sample_time, self.last_damage_time)
        second = max(0, int(sample_time - self.first_damage_time))
        boss_hp_changed = self._sample_boss_hp_damage(second)
        actor_totals = {
            int(actor.actor_id): max(0, int(actor.damage))
            for actor in self.current_stats()
            if int(actor.actor_id) > 0 and int(actor.damage) > 0
        }
        total_damage = sum(actor_totals.values())
        if total_damage <= 0:
            return boss_hp_changed
        participant_changed = False
        participant_bucket = self.participant_damage_samples.setdefault(
            second, {}
        )
        for actor_id, damage in actor_totals.items():
            if participant_bucket.get(actor_id) == damage:
                continue
            participant_bucket[actor_id] = damage
            participant_changed = True
        expected_members = max(
            1,
            self.encounter_team_size,
            self.encounter_authoritative_team_size,
            len(self.encounter_member_ids - self.non_player_actor_ids),
            len(self._current_member_ids()),
        )
        if len(actor_totals) < expected_members:
            return participant_changed or boss_hp_changed
        sample = (second, total_damage)
        if self.team_damage_samples:
            previous_second, previous_total = self.team_damage_samples[-1]
            if second < previous_second:
                return boss_hp_changed
            if second == previous_second:
                if total_damage == previous_total:
                    return participant_changed or boss_hp_changed
                self.team_damage_samples[-1] = sample
                return True
        self.team_damage_samples.append(sample)
        return True

    def sample_display_team_dps(
        self, now: float | None, team_dps: object
    ) -> bool:
        """Persist the exact team DPS value shown by the live HUD."""

        if not self.first_damage_time:
            return False
        try:
            value = float(team_dps)
        except (TypeError, ValueError, OverflowError):
            return False
        if not math.isfinite(value) or value < 0:
            return False
        sample_time = time.time() if now is None else float(now)
        if self.combat_end_time:
            sample_time = min(sample_time, self.combat_end_time)
        second = max(0, int(sample_time - self.first_damage_time))
        sample = (second, value)
        if self.display_team_dps_samples:
            previous_second, _previous_value = self.display_team_dps_samples[-1]
            if second < previous_second:
                return False
            if second == previous_second:
                self.display_team_dps_samples[-1] = sample
                return True
        self.display_team_dps_samples.append(sample)
        return True

    def member_death_duration(
        self, actor_id: int, end_time: float | None = None
    ) -> float:
        total = max(0.0, float(self.member_dead_durations.get(actor_id, 0.0)))
        started = float(self.member_dead_since.get(actor_id, 0.0) or 0.0)
        if started:
            if end_time is None:
                end_time = self.combat_end_time or time.time()
            total += max(0.0, float(end_time) - started)
        return total

    def current_taken_rows(self) -> list[dict[str, object]]:
        actor_ids = (
            self._current_member_ids()
            | self.encounter_member_ids
            | set(self.stats)
            | set(self.stage_actor_taken)
        ) - self.non_player_actor_ids
        rows: list[dict[str, object]] = []
        for actor_id in actor_ids:
            stage_taken = self.stage_actor_taken.get(actor_id)
            state = self.team_taken_states.get(actor_id)
            if stage_taken is not None:
                taken: int | None = max(0, int(stage_taken))
                source = "server_stage_summary"
            elif state is not None and state.exact_for_encounter:
                taken = max(0, int(state.accepted_taken))
                source = "server_team_counter"
            else:
                taken = None
                source = "unavailable"
            rows.append(
                {
                    "actor_id": actor_id,
                    "is_ai": self.actor_is_ai(actor_id),
                    "taken": taken,
                    "source": source,
                }
            )
        complete = bool(rows) and all(row["taken"] is not None for row in rows)
        team_taken = (
            sum(int(row["taken"] or 0) for row in rows) if complete else None
        )
        for row in rows:
            row["share"] = (
                int(row["taken"] or 0) / team_taken
                if complete and team_taken
                else 0.0 if complete else None
            )
            row["team_taken_complete"] = complete
        rows.sort(
            key=lambda row: (
                row["taken"] is not None,
                int(row["taken"] or 0),
            ),
            reverse=True,
        )
        return rows

    def ingest_boss_damage(self, event: object) -> bool:
        """Accept a parser-confirmed Boss hit without touching combat totals.

        This method intentionally does not call ``ingest``, arm an encounter,
        update life state, or adjust any TeamStats baseline.  If identity is
        incomplete, the event is discarded instead of being guessed later.
        """

        if not isinstance(event, dict) or (
            event.get("boss_source_confirmed") is not True
            or event.get("party_target_confirmed") is not True
        ):
            return False
        try:
            source_id = int(
                event.get("source_id", event.get("attacker_id", 0)) or 0
            )
            target_id = int(event.get("target_id", 0) or 0)
            source_template_id = max(
                0, int(event.get("source_template_id", 0) or 0)
            )
            timestamp = int(event.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            not source_id
            or not target_id
            or not timestamp
            or source_id == target_id
            or self.long_gap_phase_suspended
        ):
            return False

        members = (
            self._current_member_ids() | self.encounter_member_ids
        ) - self.non_player_actor_ids
        if target_id not in members:
            return False
        source = self.monsters.get(source_id)
        if source is None:
            return False
        if (
            source_template_id
            and source.template_id
            and source_template_id != int(source.template_id)
        ):
            return False

        source_kind = str(event.get("source_kind", "boss")).casefold()
        current_boss_ids = self._current_boss_target_ids()
        if source_kind == "mechanism":
            if not source.encounter_auxiliary:
                return False
            current_templates = {
                int(monster.template_id or 0)
                for entity_id in current_boss_ids
                if (monster := self.monsters.get(entity_id)) is not None
                and int(monster.template_id or 0) > 0
            }
            if (
                current_templates
                and source.encounter_parent_template_ids
                and not current_templates.intersection(
                    source.encounter_parent_template_ids
                )
            ):
                return False
        else:
            source_kind = "boss"
            if not self._is_priority_target(source_id):
                return False
            if current_boss_ids:
                if source_id not in current_boss_ids:
                    return False
            elif event.get("active_boss_source") is not True:
                return False

        event_time = self._event_seconds(event)
        if self.combat_end_time and event_time > self.combat_end_time + 0.5:
            return False
        accepted = dict(event)
        accepted.update(
            {
                "source_id": source_id,
                "source_template_id": int(source.template_id or 0)
                or source_template_id,
                "source_name": self.display_target_name(source_id),
                "source_kind": source_kind,
                "target_name": self.display_name(target_id),
                "skill_name": self.display_skill_name(
                    source_id, int(event.get("skill_id", 0) or 0)
                ),
            }
        )
        changed = self.boss_damage.ingest(
            accepted, event_time_epoch=event_time
        )
        if changed and self.combat_end_time:
            self._queue_current_record_refresh()
        return changed

    def _boss_damage_summary(
        self,
        *,
        team_taken: int | None,
        started_at_epoch: float = 0.0,
        duration_seconds: float = 0.0,
        include_event_log: bool = False,
    ) -> dict[str, object]:
        source_profiles: dict[int, dict[str, object]] = {}
        target_names: dict[int, str] = {}
        observed_skill_ids: set[int] = set()
        for event in self.boss_damage.events:
            source = self.monsters.get(event.source_id)
            source_profiles[event.source_id] = {
                "template_id": (
                    int(source.template_id or 0)
                    if source is not None
                    else event.source_template_id
                ),
                "name": (
                    self.display_target_name(event.source_id)
                    if source is not None
                    else event.source_name
                ),
                "kind": (
                    "mechanism"
                    if source is not None and source.encounter_auxiliary
                    else event.source_kind
                ),
            }
            target_names[event.target_id] = (
                self.display_name(event.target_id) or event.target_name
            )
            observed_skill_ids.add(event.skill_id)
        skill_names = {
            skill_id: (
                self.skill_names.get(skill_id, "")
                or self.runtime_skill_names.get(skill_id, "")
            )
            for skill_id in observed_skill_ids
        }
        unavailable_reason = ""
        if self._is_dummy_encounter():
            unavailable_reason = "training_dummy"
        return self.boss_damage.summary(
            team_taken=team_taken,
            source_profiles=source_profiles,
            target_names=target_names,
            skill_names=skill_names,
            started_at_epoch=started_at_epoch,
            duration_seconds=duration_seconds,
            include_event_log=include_event_log,
            unavailable_reason=unavailable_reason,
        )

    def current_boss_damage_summary(self) -> dict[str, object]:
        taken_rows = self.current_taken_rows()
        team_taken = (
            sum(int(row.get("taken", 0) or 0) for row in taken_rows)
            if taken_rows
            and all(row.get("taken") is not None for row in taken_rows)
            else None
        )
        return self._boss_damage_summary(team_taken=team_taken)

    def _encounter_started(self) -> bool:
        return bool(
            self.first_damage_time
            or self.last_damage_time
            or self.first_healing_time
            or self.last_healing_time
            or any(
                state.accepted_damage > 0
                for state in self.team_damage_states.values()
            )
            or any(
                state.accepted_taken > 0
                for state in self.team_taken_states.values()
            )
            or any(
                state.accepted_effective_healing > 0
                for state in self.team_healing_states.values()
            )
        )

    def _update_encounter_roster(self, *extra_actor_ids: int) -> None:
        # A participant exists only after an observed hit on the current Boss.
        # Party packets remain useful for names, but never create zero-DPS rows.
        members = {
            actor_id
            for actor_id in extra_actor_ids
            if actor_id and actor_id not in self.non_player_actor_ids
        }
        if self._is_dummy_encounter():
            members = {
                actor_id
                for actor_id in members
                if self.self_id is not None and actor_id == self.self_id
            }
        if not members and not self._encounter_started():
            return
        self.encounter_member_ids.update(members)
        self.encounter_team_size = min(
            MAX_PARTY_MEMBERS,
            max(
                self.encounter_team_size,
                len(self.encounter_member_ids),
            ),
        )
        for actor_id in members:
            if actor_id not in self.friend_order:
                self.friend_order.append(actor_id)

    def _all_encounter_combatants_out(self) -> bool:
        participants = {
            actor_id
            for actor_id in self.encounter_member_ids
            if actor_id not in self.non_player_actor_ids
        }
        if not participants:
            return False
        known_states = {
            actor_id: self.entity_combat_states[actor_id]
            for actor_id in participants
            if actor_id in self.entity_combat_states
        }
        if len(known_states) == len(participants):
            return not any(known_states.values())
        boss_ids = self._current_boss_target_ids()
        if len(boss_ids) > 1:
            boss_out = bool(boss_ids) and all(
                self.entity_combat_states.get(entity_id) is False
                for entity_id in boss_ids
            )
        else:
            boss_out = self.entity_combat_states.get(
                int(self.combat_target_id or 0)
            ) is False
        return bool(boss_out and known_states and not any(known_states.values()))

    def _mark_pending_reset_complete(self) -> bool:
        if (
            self.long_gap_phase_suspended
            or not self.boss_reset_pending_100ns
            or not self.first_damage_time
            or self.combat_end_time
            or not self._all_encounter_combatants_out()
        ):
            return False
        self.combat_end_time = self.last_damage_time
        self.combat_end_reason = "target_reset"
        self._rebuild_member_life_metrics()
        return True

    def _mark_target_defeated(self, monster: MonsterStats) -> bool:
        # One defeated unit does not end an all-monsters encounter while
        # the party may still be fighting the rest of the same pack.
        if not self.boss_only:
            return False
        if (
            not self.first_damage_time
            or monster.entity_id not in self._current_boss_target_ids()
            or not self._is_priority_target(monster.entity_id)
            or not self._target_hp_depleted()
            or self.combat_end_time
        ):
            return False
        if self._multiphase_encounter():
            return False
        boss_monsters = [
            self.monsters.get(entity_id)
            for entity_id in self._ordered_current_boss_target_ids()
        ]
        if not boss_monsters or not all(
            boss is not None
            and boss.death_time_100ns
            and boss.death_confirmed
            for boss in boss_monsters
        ):
            return False
        end_time = max(
            self._event_seconds({"filetime_100ns": boss.death_time_100ns})
            for boss in boss_monsters
            if boss is not None
        )
        if end_time < self.first_damage_time:
            return False
        self.combat_end_time = end_time
        self.combat_end_reason = "target_defeated"
        self._rebuild_member_life_metrics()
        return True

    def _mark_party_wipe_if_complete(self, event_time: float) -> bool:
        if (
            not self.first_damage_time
            or self.combat_end_time
            or event_time < self.first_damage_time
        ):
            return False
        members = self._current_member_ids()
        if not members:
            return False
        if self.party_known and self.party_member_count > len(members):
            # Some roster entries have not been resolved yet. Never declare a
            # wipe from only the visible subset of the party.
            return False
        if not all(
            actor_id in self.member_death_states
            and self.member_death_states[actor_id]
            for actor_id in members
        ):
            return False
        self.combat_end_time = max(self.last_damage_time, event_time)
        self.combat_end_reason = "party_wipe"
        self._rebuild_member_life_metrics()
        return True

    def _combat_state_confirms_pull_reset(self) -> bool:
        if (
            not self.first_damage_time
            or self.combat_end_time
            or self._multiphase_encounter()
            or self._awaiting_long_gap_phase_successor()
        ):
            return False
        boss_id = int(self.combat_target_id or 0)
        monster = self.monsters.get(boss_id)
        if (
            monster is None
            or monster.current_hp is None
            or monster.current_hp <= 0
            or self.entity_combat_states.get(boss_id) is not False
        ):
            return False
        participants = {
            actor_id
            for actor_id in self.encounter_member_ids
            if actor_id not in self.non_player_actor_ids
        }
        expected = max(
            self.encounter_team_size,
            self.encounter_authoritative_team_size,
        )
        if not participants or expected > len(participants):
            return False
        non_local = participants - {int(self.self_id or 0)}
        if non_local:
            # The local player's ScriptEntity can keep a stale fight-mode flag
            # after death. The Boss leaving combat plus every teammate leaving
            # is still a complete reset boundary for this pull.
            confirmed = all(
                self.entity_combat_states.get(actor_id) is False
                for actor_id in non_local
            )
        else:
            confirmed = all(
                self.entity_combat_states.get(actor_id) is False
                for actor_id in participants
            )
        return confirmed

    def _mark_party_wipe_from_replacement(
        self, incoming: MonsterStats, event_time: float
    ) -> bool:
        current_id = int(self.combat_target_id or 0)
        current = self.monsters.get(current_id)
        if (
            not current_id
            or incoming.entity_id == current_id
            or incoming.entity_id in self.simultaneous_boss_target_ids
            or event_time < self.first_damage_time
            or current is None
            or not int(current.template_id or 0)
            or int(current.template_id or 0) != int(incoming.template_id or 0)
            or not self._combat_state_confirms_pull_reset()
        ):
            return False
        self.combat_end_time = max(self.last_damage_time, event_time)
        self.combat_end_reason = "party_wipe"
        self._rebuild_member_life_metrics()
        return True

    @staticmethod
    def _monster_max_hp(monster: MonsterStats) -> float:
        return max(monster.max_hp or 0.0, monster.observed_max_hp or 0.0)

    def observed_boss_damage_taken(self) -> float:
        """Return validated cumulative HP loss for the current Boss pull."""
        target_ids = self._ordered_current_boss_target_ids()
        target_ids.extend(
            entity_id
            for entity_id in self.encounter_target_order
            if entity_id in self.linked_boss_target_ids
            and entity_id not in target_ids
        )
        if not target_ids:
            target_ids = [monster.entity_id for monster in self.current_bosses()]
        return sum(
            max(0.0, float(self.monsters[target_id].observed_damage_taken))
            for target_id in dict.fromkeys(target_ids)
            if target_id in self.monsters
        )

    def _is_healing_target(self, entity_id: int) -> bool:
        """Return true only for an explicitly identified treatment dummy.

        The name alone is deliberately insufficient here.  A real encounter
        can contain an object whose localized name happens to include ``木桩``;
        only the native template/profile marker is allowed to open a pure-HPS
        encounter.
        """
        try:
            parsed_id = int(entity_id or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if not parsed_id:
            return False
        monster = self.monsters.get(parsed_id)
        if monster is not None and bool(monster.healing_target):
            return True
        if monster is not None and int(monster.template_id or 0) in HEALING_TARGET_TEMPLATE_IDS:
            return True
        return parsed_id in self.healing_target_ids

    def _register_healing_target(
        self,
        entity_id: int,
        *,
        template_id: int = 0,
        level: int | None = None,
    ) -> bool:
        """Bind one exact treatment-dummy identity without making it a Boss."""
        try:
            parsed_id = int(entity_id or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if not parsed_id:
            return False
        try:
            parsed_template = int(template_id or 0)
        except (TypeError, ValueError, OverflowError):
            parsed_template = 0
        if parsed_template and parsed_template not in HEALING_TARGET_TEMPLATE_IDS:
            return False
        monster = self.monsters.setdefault(parsed_id, MonsterStats(parsed_id))
        changed = not monster.healing_target
        monster.healing_target = True
        if parsed_template and monster.template_id != parsed_template:
            monster.template_id = parsed_template
            changed = True
        if not monster.name or monster.name == "Monster":
            monster.name = HEALING_TARGET_NAME
            changed = True
        if not monster.entity_type or monster.entity_type.casefold() in {
            "monster",
            "boss",
        }:
            monster.entity_type = "TrainingDummy"
            changed = True
        if level is not None:
            try:
                parsed_level = int(level)
            except (TypeError, ValueError, OverflowError):
                parsed_level = HEALING_TARGET_LEVEL
            if not 1 <= parsed_level <= 999:
                parsed_level = HEALING_TARGET_LEVEL
            if monster.level != parsed_level:
                monster.level = parsed_level
                changed = True
        self.entity_names[parsed_id] = HEALING_TARGET_NAME
        if parsed_id not in self.healing_target_ids:
            self.healing_target_ids.add(parsed_id)
            self.healing_target_order.append(parsed_id)
            changed = True
        return changed

    def _pure_healing_context(self) -> bool:
        """Whether the current encounter is the exact treatment-dummy case."""
        return bool(
            not self.first_damage_time
            and not self.combat_end_time
            and self.healing_target_ids
        )

    def _is_dummy_target(self, entity_id: int) -> bool:
        if self._is_healing_target(entity_id):
            return False
        monster = self.monsters.get(int(entity_id or 0))
        if monster is not None:
            try:
                if int(monster.template_id or 0) in DAMAGE_TARGET_TEMPLATE_IDS:
                    return True
            except (TypeError, ValueError, OverflowError):
                pass
        name = (
            (monster.name if monster is not None else "")
            or self.entity_names.get(int(entity_id or 0), "")
        ).strip()
        return DUMMY_NAME_MARKER in name

    def _is_dummy_encounter(self) -> bool:
        return bool(
            self.combat_target_id is not None
            and self._is_dummy_target(self.combat_target_id)
        )

    def ingest_server_clock(
        self, server_time: object, received_at: object | None = None
    ) -> bool:
        """Remember the authorization server clock used by dummy epochs."""

        try:
            server_epoch = float(server_time)
            local_epoch = time.time() if received_at is None else float(received_at)
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            not math.isfinite(server_epoch)
            or not math.isfinite(local_epoch)
            or server_epoch <= 0.0
            or local_epoch <= 0.0
        ):
            return False
        next_offset = server_epoch - local_epoch
        changed = (
            self.server_clock_offset_seconds is None
            or abs(self.server_clock_offset_seconds - next_offset) >= 0.05
        )
        self.server_clock_offset_seconds = next_offset
        self.server_clock_sample_received_at = local_epoch
        return changed

    def _live_dps_duration_for_snapshot(
        self,
        *,
        event_time: float,
        server_time: int,
        combat_seconds_total: int,
        fallback_duration: float,
    ) -> float:
        accumulated_duration = max(0, int(combat_seconds_total))
        offset = self.server_clock_offset_seconds
        if server_time and offset is not None:
            active_duration = event_time - (float(server_time) - float(offset))
            # Common field 9 contains completed combat segments. Field 10 is
            # the current segment's start, so a resumed fight needs both.
            server_duration = accumulated_duration + max(0.0, active_duration)
            if (
                -1.0 <= active_duration <= COMBAT_CLOCK_MAX_SECONDS
                and server_duration <= COMBAT_CLOCK_MAX_SECONDS
            ):
                return dps_duration_seconds(max(0.001, server_duration))

        if 0 < accumulated_duration <= COMBAT_CLOCK_MAX_SECONDS:
            return float(accumulated_duration)

        duration = dps_duration_seconds(fallback_duration)
        if duration <= COMBAT_CLOCK_MAX_SECONDS:
            return duration
        return 0.0

    def _update_live_dps_from_snapshot(
        self,
        state: TeamDamageState | TargetlessTeamDamageState,
        *,
        damage: int,
        event_time: float,
        server_time: int,
        combat_seconds_total: int,
        fallback_duration: float,
    ) -> bool:
        damage = max(0, int(damage))
        final_snapshot = combat_seconds_total > 0 and not server_time
        if not final_snapshot and damage <= state.live_dps_damage:
            return False
        duration = self._live_dps_duration_for_snapshot(
            event_time=event_time,
            server_time=server_time,
            combat_seconds_total=combat_seconds_total,
            fallback_duration=fallback_duration,
        )
        if duration <= 0:
            return False
        next_dps = float(damage) / duration
        changed = bool(
            state.live_dps != next_dps
            or state.live_dps_damage != damage
        )
        state.live_dps = next_dps
        state.live_dps_damage = damage
        return changed

    def _remember_self_common_damage(
        self, absolute_damage: int, server_time: int
    ) -> bool:
        if not server_time:
            return False
        current_epoch = int(self.dummy_common_server_time or 0)
        current_absolute = int(self.dummy_common_absolute or 0)
        if server_time < current_epoch:
            return False
        if server_time == current_epoch and absolute_damage < current_absolute:
            return False
        changed = bool(
            server_time != current_epoch or absolute_damage != current_absolute
        )
        self.dummy_common_server_time = int(server_time)
        self.dummy_common_absolute = int(absolute_damage)
        return changed

    def _dummy_local_baseline_for_epoch(self, server_time: int) -> int:
        actor = self.stats.get(int(self.self_id or 0))
        actor_total = max(0, int(actor.damage if actor is not None else 0))
        offset = self.server_clock_offset_seconds
        if offset is None or not server_time:
            return actor_total
        local_start = float(server_time) - float(offset)
        recent_damage = 0
        for event in self.events:
            try:
                if (
                    int(event.get("attacker_id", 0) or 0)
                    != int(self.self_id or 0)
                    or not self._is_dummy_target(
                        int(event.get("target_id", 0) or 0)
                    )
                    or self._event_seconds(event) < local_start - 0.5
                ):
                    continue
                recent_damage += max(0, int(event.get("damage", 0) or 0))
            except (TypeError, ValueError, OverflowError, KeyError):
                continue
        return max(0, actor_total - min(actor_total, recent_damage))

    def _observe_dummy_common_damage(
        self,
        absolute_damage: int,
        server_time: int,
        timestamp: int,
        *,
        previous_common_server_time: int,
        previous_common_absolute: int,
        combat_seconds_total: int = 0,
        final_common: bool = False,
    ) -> bool:
        """Project one exact Common counter onto the current dummy round."""

        final_common = bool(final_common and combat_seconds_total > 0)
        if not server_time and not final_common:
            return False
        if self.dummy_round_official_final and not final_common:
            return False
        if server_time and (
            server_time < previous_common_server_time
            or (
                server_time == previous_common_server_time
                and absolute_damage < previous_common_absolute
            )
        ):
            return False
        before = (
            self.dummy_round_server_time,
            self.dummy_round_baseline_absolute,
            self.dummy_round_official_total,
            self.dummy_round_official_update_100ns,
            self.dummy_round_official_duration_seconds,
            self.dummy_round_official_final,
            self.dummy_round_local_damage_baseline,
            self.dummy_round_waiting_for_new_epoch,
        )
        round_epoch = int(self.dummy_round_server_time or 0)
        if final_common:
            if not round_epoch or not self.combat_end_time:
                # Without the live epoch there is no safe way to separate a
                # cumulative terminal counter from an earlier dummy round.
                # Likewise, a delayed terminal row must not attach after a new
                # round has already started.
                return False
            # The terminal Common row carries exact duration in field 19 but
            # omits the field-20 epoch used by in-combat snapshots. Keep the
            # established baseline and make this row authoritative for the
            # same round.
            baseline = int(self.dummy_round_baseline_absolute or 0)
            self.dummy_round_official_total = max(
                0, absolute_damage - baseline
            )
            self.dummy_round_official_update_100ns = timestamp
            self.dummy_round_official_duration_seconds = max(
                0, int(combat_seconds_total or 0)
            )
            self.dummy_round_official_final = True
            self.dummy_round_waiting_for_new_epoch = False
        elif not round_epoch:
            if (
                self.dummy_round_waiting_for_new_epoch
                and previous_common_server_time
                and server_time <= previous_common_server_time
            ):
                # The first packet after clearing can still be the previous
                # round's unchanged value. Keep local hits until the epoch rolls.
                return False
            new_epoch = bool(
                previous_common_server_time
                and server_time > previous_common_server_time
            )
            baseline = (
                previous_common_absolute
                if new_epoch and absolute_damage >= previous_common_absolute
                else 0
            )
            self.dummy_round_server_time = server_time
            self.dummy_round_baseline_absolute = baseline
            self.dummy_round_official_total = max(0, absolute_damage - baseline)
            self.dummy_round_official_update_100ns = timestamp
            self.dummy_round_official_duration_seconds = 0
            self.dummy_round_official_final = False
            self.dummy_round_local_damage_baseline = (
                self._dummy_local_baseline_for_epoch(server_time)
                if new_epoch
                else 0
            )
            self.dummy_round_waiting_for_new_epoch = False
        elif server_time > round_epoch:
            baseline = (
                previous_common_absolute
                if previous_common_server_time
                and absolute_damage >= previous_common_absolute
                else 0
            )
            self.dummy_round_server_time = server_time
            self.dummy_round_baseline_absolute = baseline
            self.dummy_round_official_total = max(0, absolute_damage - baseline)
            self.dummy_round_official_update_100ns = timestamp
            self.dummy_round_official_duration_seconds = 0
            self.dummy_round_official_final = False
            self.dummy_round_local_damage_baseline = (
                self._dummy_local_baseline_for_epoch(server_time)
            )
            self.dummy_round_last_local_hit_100ns = max(
                (
                    int(event.get("filetime_100ns", 0) or 0)
                    for event in self.events
                    if int(event.get("attacker_id", 0) or 0)
                    == int(self.self_id or 0)
                    and self._is_dummy_target(
                        int(event.get("target_id", 0) or 0)
                    )
                ),
                default=0,
            )
            self.dummy_round_waiting_for_new_epoch = False
        elif server_time == round_epoch:
            candidate = max(
                0,
                absolute_damage - int(self.dummy_round_baseline_absolute or 0),
            )
            if candidate >= self.dummy_round_official_total:
                self.dummy_round_official_total = candidate
                self.dummy_round_official_update_100ns = max(
                    self.dummy_round_official_update_100ns, timestamp
                )
        after = (
            self.dummy_round_server_time,
            self.dummy_round_baseline_absolute,
            self.dummy_round_official_total,
            self.dummy_round_official_update_100ns,
            self.dummy_round_official_duration_seconds,
            self.dummy_round_official_final,
            self.dummy_round_local_damage_baseline,
            self.dummy_round_waiting_for_new_epoch,
        )
        return before != after

    def dummy_display_damage(self) -> int | None:
        """Return the furthest-progressed total for the current dummy round."""

        if not self._is_dummy_encounter() or self.self_id is None:
            return None
        actor = self.stats.get(int(self.self_id))
        actor_total = max(0, int(actor.damage if actor is not None else 0))
        local_total = max(
            0, actor_total - int(self.dummy_round_local_damage_baseline or 0)
        )
        if not self.dummy_round_official_update_100ns:
            return local_total
        official_total = max(0, int(self.dummy_round_official_total or 0))
        if self.dummy_round_official_final:
            return official_total
        # Common snapshots can arrive after the exact local hit stream while
        # still describing an older total.  Their receive timestamp therefore
        # cannot be used to replace a further-progressed local counter.
        return max(local_total, official_total)

    def _actor_counts_for_encounter(self, actor_id: int) -> bool:
        if not actor_id or actor_id in self.non_player_actor_ids:
            return False
        if not self._is_dummy_encounter():
            return True
        return self.self_id is not None and actor_id == self.self_id

    def _monster_rank(self, monster: MonsterStats) -> int:
        if self._is_healing_target(monster.entity_id):
            return 0
        if self._catalog_marks_known_non_boss(monster.template_id):
            return 0
        if self._is_dummy_target(monster.entity_id):
            return 3
        if monster.boss_rank >= 3 or monster.boss_type == 3:
            return 3
        entity_type = monster.entity_type.casefold()
        if "boss" in entity_type or "首领" in entity_type:
            return 3
        return 0

    def _monster_activity(self, monster: MonsterStats) -> int:
        return max(
            monster.last_update_100ns,
            self.target_activity_100ns.get(monster.entity_id, 0),
        )

    def _monster_priority(self, monster: MonsterStats) -> tuple:
        current_hp = monster.current_hp
        alive = 1 if current_hp is None or current_hp > 0 else 0
        return (
            self._monster_rank(monster),
            int(monster.level or 0),
            alive,
            self._monster_max_hp(monster),
            self._monster_activity(monster),
        )

    def _select_priority_monster(
        self, *, active_at_100ns: int | None = None
    ) -> MonsterStats | None:
        candidates: list[MonsterStats] = []
        reference_time = active_at_100ns or self.latest_network_time_100ns
        active_seconds = (
            TEAM_TARGET_ACTIVE_SECONDS
            if active_at_100ns is not None
            else MONSTER_DISPLAY_ACTIVE_SECONDS
        )
        active_window = int(active_seconds * 10_000_000)
        for entity_id, monster in self.monsters.items():
            if entity_id in self.friendly_ids:
                continue
            if monster.entity_type.casefold() in {"player", "role"}:
                continue
            if self.boss_only and self._monster_rank(monster) <= 0:
                continue
            if reference_time:
                activity = self._monster_activity(monster)
                elapsed = reference_time - activity
                if not activity or elapsed < 0 or elapsed > active_window:
                    continue
            candidates.append(monster)
        return max(candidates, key=self._monster_priority) if candidates else None

    def _is_priority_target(self, entity_id: int) -> bool:
        monster = self.monsters.get(entity_id)
        if monster is None or entity_id in self.friendly_ids:
            return False
        if self._is_healing_target(entity_id):
            return False
        if monster.entity_type.casefold() in {"player", "role"}:
            return False
        return not self.boss_only or self._monster_rank(monster) > 0

    def _encounter_damage_target_ids(self) -> set[int]:
        if self.boss_only:
            if self.combat_target_id is None:
                return set()
            target_ids = {
                self.combat_target_id,
                *self.linked_boss_target_ids,
                *self.simultaneous_boss_target_ids,
                *self.encounter_add_target_ids,
            }
            return target_ids
        target_ids = set(self.encounter_target_ids)
        if self.combat_target_id is not None:
            target_ids.add(self.combat_target_id)
        return {
            entity_id
            for entity_id in target_ids
            if self._is_priority_target(entity_id)
        }

    def _is_encounter_damage_target(self, entity_id: int) -> bool:
        if not entity_id:
            return False
        if self._is_healing_target(entity_id):
            return False
        if self.boss_only:
            return bool(
                self.combat_target_id is not None
                and (
                    entity_id == self.combat_target_id
                    or entity_id in self.linked_boss_target_ids
                    or entity_id in self.simultaneous_boss_target_ids
                    or entity_id in self.encounter_add_target_ids
                )
            )
        return bool(
            (
                entity_id == self.combat_target_id
                or entity_id in self.encounter_target_ids
            )
            and self._is_priority_target(entity_id)
        )

    def _link_boss_scene_target(
        self, target: int, event_time: float, timestamp: int
    ) -> bool:
        if (
            not self.boss_only
            or not self.first_damage_time
            or self.combat_target_id is None
            or target == self.combat_target_id
            or target in self._current_member_ids()
            or target in self.friendly_ids
            or self._is_priority_target(target)
        ):
            return False
        primary = self.monsters.get(self.combat_target_id)
        if primary is None or self._monster_rank(primary) <= 0:
            return False
        monster = self.monsters.get(target)
        if monster is not None and monster.entity_type.casefold() in {
            "player",
            "role",
        }:
            return False
        if (
            self.last_damage_time
            and event_time - self.last_damage_time > self.encounter_gap
        ):
            return False
        if monster is None:
            monster = MonsterStats(target, entity_type="Monster")
            self.monsters[target] = monster
        promoted_partner = self._promote_verified_simultaneous_boss_partner(
            primary.entity_id,
            target,
            player_damage_observed=True,
        )
        if not promoted_partner:
            self._infer_missing_encounter_auxiliary(primary, monster)
            self._register_encounter_target(target, add=True)
        if timestamp:
            self.target_activity_100ns[target] = max(
                self.target_activity_100ns.get(target, 0), timestamp
            )
        if (
            self.combat_end_time
            and self.combat_end_reason == "target_defeated"
            and 0 <= event_time - self.combat_end_time <= self.encounter_gap
        ):
            self.combat_end_time = 0.0
            self.combat_end_reason = ""
            self._rebuild_member_life_metrics()
        return True

    def _infer_missing_encounter_auxiliary(
        self, primary: MonsterStats, monster: MonsterStats
    ) -> bool:
        inferred = unique_inferred_auxiliary_for_parent(
            int(primary.template_id or 0)
        )
        if inferred is None:
            return False
        template_id, metadata = inferred
        if monster.template_id not in (None, 0, template_id):
            return False
        canonical_name = str(metadata.get("name", "")).strip()
        existing_name = (
            monster.name or self.entity_names.get(monster.entity_id, "")
        ).strip()
        if existing_name and existing_name.casefold() not in {
            canonical_name.casefold(),
            "monster",
            "小怪",
        }:
            return False
        parent_template_ids = tuple(
            sorted(
                {
                    int(value)
                    for value in metadata.get("parent_template_ids", ())
                    if int(value)
                }
            )
        )
        monster.name = canonical_name
        monster.entity_type = "Monster"
        monster.template_id = template_id
        monster.encounter_auxiliary = True
        monster.encounter_parent_template_ids = parent_template_ids
        self.entity_names[monster.entity_id] = canonical_name
        self._mark_non_player_actor(monster.entity_id)
        return True

    @staticmethod
    def _iso_timestamp(value: float) -> str:
        try:
            timestamp = dt.datetime.fromtimestamp(
                value, tz=dt.timezone.utc
            ).astimezone()
        except (OSError, OverflowError, ValueError):
            return ""
        return timestamp.isoformat(timespec="seconds")

    def _archive_signature(self) -> tuple | None:
        total = sum(actor.damage for actor in self.stats.values())
        observed_healing = 0
        for event in self.healing_events:
            try:
                observed_healing += max(
                    0, int(event.get("total_healing", 0) or 0)
                )
            except (TypeError, ValueError, OverflowError):
                continue
        snapshot_healing = sum(
            max(0, int(snapshot.effective_healing or 0))
            for actor_id, snapshot in self.stage_healing_snapshots.items()
            if self.active_stage_healing_snapshot(actor_id) is not None
        )
        counter_healing = sum(
            max(0, int(state.accepted_effective_healing or 0))
            for state in self.team_healing_states.values()
            if state.exact_for_encounter
        )
        damage_context = bool(
            total > 0 and self.first_damage_time and self.last_damage_time
        )
        pure_healing_context = bool(
            not damage_context
            and self.first_healing_time
            and self.healing_target_ids
            and observed_healing + snapshot_healing + counter_healing > 0
        )
        if not damage_context and not pure_healing_context:
            return None
        actors = tuple(
            sorted(
                (
                    actor_id,
                    actor.damage,
                    actor.hits,
                    actor.max_hit,
                    actor.damage_hits,
                    actor.critical_hits,
                    actor.penetration_hits,
                    self.member_death_counts.get(actor_id, 0),
                    self.member_revive_counts.get(actor_id, 0),
                    round(self.member_dead_durations.get(actor_id, 0.0), 3),
                    round(self.member_dead_since.get(actor_id, 0.0), 3),
                    self.stage_actor_taken.get(actor_id),
                    (
                        self.team_taken_states[actor_id].accepted_taken,
                        self.team_taken_states[actor_id].exact_for_encounter,
                    )
                    if actor_id in self.team_taken_states
                    else None,
                    self.display_name(actor_id),
                    self.entity_extraordinary_ratings.get(actor_id),
                    self.entity_ai_states.get(actor_id),
                    tuple(
                        sorted(
                            (
                                skill.skill_id,
                                skill.damage,
                                skill.hits,
                                skill.max_hit,
                                self.display_skill_name(actor_id, skill.skill_id),
                            )
                            for skill in actor.skills.values()
                        )
                    ),
                    tuple(sorted(actor.target_damage.items())),
                )
                for actor_id, actor in self.stats.items()
            )
        )
        target_ids_for_signature = (
            self._encounter_damage_target_ids()
            if damage_context
            else set(self.healing_target_ids)
        )
        targets = tuple(
            sorted(
                (
                    entity_id,
                    monster.name,
                    monster.level,
                    monster.boss_rank,
                    monster.current_hp,
                    monster.max_hp,
                    monster.observed_max_hp,
                )
                for entity_id in target_ids_for_signature
                if (monster := self.monsters.get(entity_id)) is not None
            )
        )
        healing = (
            tuple(sorted(self.healing_event_keys)),
            tuple(
                sorted(
                    (
                        int(response.get("healer_id", 0) or 0),
                        int(response.get("target_id", 0) or 0),
                        int(response.get("drop_filetime_100ns", 0) or 0),
                        int(response.get("heal_filetime_100ns", 0) or 0),
                        round(float(response.get("response_ms", 0.0) or 0.0), 3),
                    )
                    for response in self.healing_responses
                )
            ),
            tuple(
                sorted(
                    (
                        actor_id,
                        snapshot.summary_id,
                        snapshot.actor_damage,
                        snapshot.effective_healing,
                        tuple(sorted(snapshot.skills.items())),
                    )
                    for actor_id, snapshot in self.stage_healing_snapshots.items()
                    if self.active_stage_healing_snapshot(actor_id) is not None
                )
            ),
            tuple(
                sorted(
                    (
                        actor_id,
                        state.accepted_effective_healing,
                        state.exact_for_encounter,
                        state.snapshot_time_100ns,
                    )
                    for actor_id, state in self.team_healing_states.items()
                )
            ),
            round(self.first_healing_time, 3),
            round(self.last_healing_time, 3),
            round(self.healing_end_time, 3),
            tuple(sorted(self.healing_target_ids)),
        )
        if damage_context:
            interval = self.resolve_combat_interval(
                self.combat_end_time or self.last_damage_time, for_archive=True
            )
            cast_start = interval.started_at_epoch
            cast_end = interval.ended_at_epoch
        else:
            cast_start = self.first_healing_time
            cast_end = self.healing_end_time or self.last_healing_time
        cast_keys = [
            self._skill_cast_event_key(event)
            for event in self.skill_cast_events
            if cast_start <= self._event_seconds(event) <= cast_end
            and self._actor_counts_for_encounter(event["actor_id"])
        ]
        return (
            self.encounter_id,
            "damage" if damage_context else "healing",
            round(self.first_damage_time, 3),
            round(self.last_damage_time, 3),
            round(self.combat_end_time, 3),
            self.game_server_duration_summary_id,
            round(self.game_server_duration_seconds, 3),
            tuple(self.game_server_duration_member_seconds),
            tuple(sorted(self.game_server_duration_rejection.items())),
            self.shared_clock_id,
            round(self.shared_clock_duration_seconds, 3),
            self.shared_clock_final,
            self.encounter_team_size,
            tuple(sorted(self.encounter_member_ids)),
            actors,
            targets,
            healing,
            len(self.events),
            (len(cast_keys), cast_keys[-1:]),
            (len(self.boss_hp_damage_samples), self.boss_hp_damage_samples[-1:]),
            (len(self.team_damage_samples), self.team_damage_samples[-1:]),
            (len(self.display_team_dps_samples), self.display_team_dps_samples[-1:]),
        )

    def _history_team_damage_sample_log(
        self,
        duration: float,
        total_damage: int,
        *,
        started_at_epoch: float,
    ) -> dict[str, object]:
        if not self.team_damage_samples or duration <= 0 or total_damage <= 0:
            return {}
        last_live_total = int(self.team_damage_samples[-1][1])
        if abs(last_live_total - total_damage) > max(1, int(total_damage * 0.001)):
            return {}
        final_second = max(0, int(duration))
        opening_offset = max(
            0, int(self.first_damage_time - float(started_at_epoch or 0.0))
        )
        samples: dict[int, int] = {}
        for raw_second, raw_total in self.team_damage_samples:
            second = max(
                0,
                min(final_second, opening_offset + int(raw_second)),
            )
            samples[second] = max(0, int(raw_total))

        previous_total = 0
        rows: list[list[int]] = []
        for second in sorted(samples):
            sample_total = samples[second]
            if sample_total < previous_total:
                return {}
            rows.append([second, sample_total])
            previous_total = sample_total
        if len(rows) < 2:
            return {}
        return {
            "version": 2,
            "columns": ["time_seconds", "total_damage"],
            "coverage": "live_team_cumulative",
            "verified_live_final": True,
            "interval_seconds": 1,
            "origin_started_at_epoch": float(started_at_epoch),
            "rows": rows,
        }

    def _history_boss_hp_damage_sample_log(
        self, duration: float, *, started_at_epoch: float
    ) -> dict[str, object]:
        if len(self.boss_hp_damage_samples) < 3 or duration <= 0:
            return {}
        final_second = max(0, int(duration))
        opening_offset = max(
            0, int(self.first_damage_time - float(started_at_epoch or 0.0))
        )
        samples: dict[int, int] = {}
        for raw_second, raw_total in self.boss_hp_damage_samples:
            second = max(0, min(final_second, opening_offset + int(raw_second)))
            samples[second] = max(0, int(raw_total))
        rows = [[second, samples[second]] for second in sorted(samples)]
        if len(rows) < 3 or any(
            current[1] < previous[1] for previous, current in zip(rows, rows[1:])
        ):
            return {}
        return {
            "version": 1,
            "columns": ["time_seconds", "observed_boss_hp_loss"],
            "coverage": "observed_boss_hp_loss",
            "interval_seconds": 1,
            "origin_started_at_epoch": float(started_at_epoch),
            "rows": rows,
        }

    def _history_display_team_dps_sample_log(
        self, duration: float, *, started_at_epoch: float
    ) -> dict[str, object]:
        if len(self.display_team_dps_samples) < 2 or duration <= 0:
            return {}
        final_second = max(0, int(duration))
        opening_offset = max(
            0, int(self.first_damage_time - float(started_at_epoch or 0.0))
        )
        rows = []
        for raw_second, raw_value in self.display_team_dps_samples:
            try:
                value = float(raw_value)
            except (TypeError, ValueError, OverflowError):
                continue
            if not math.isfinite(value) or value < 0:
                continue
            rows.append([
                max(0, min(final_second, opening_offset + int(raw_second))),
                value,
            ])
        rows.sort(key=lambda row: row[0])
        compact = {}
        for second, value in rows:
            compact[second] = value
        rows = [[second, compact[second]] for second in sorted(compact)]
        if len(rows) < 2:
            return {}
        return {
            "version": 1,
            "columns": ["time_seconds", "team_dps"],
            "coverage": "live_display_team_dps",
            "interval_seconds": 1,
            "origin_started_at_epoch": float(started_at_epoch),
            "rows": rows,
        }

    def _history_participant_damage_sample_log(
        self,
        duration: float,
        participants: list[dict],
        *,
        started_at_epoch: float,
    ) -> dict[str, object]:
        """Serialize validated per-player cumulative totals for trend charts."""

        if (
            not self.participant_damage_samples
            or duration <= 0
            or not participants
        ):
            return {}
        final_totals: dict[int, int] = {}
        for participant in participants:
            if not isinstance(participant, dict):
                continue
            try:
                actor_id = int(participant.get("actor_id", 0) or 0)
                damage = max(0, int(participant.get("damage", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                continue
            if actor_id > 0 and damage > 0:
                final_totals[actor_id] = damage
        if not final_totals:
            return {}

        final_second = max(0, int(duration))
        opening_offset = max(
            0, int(self.first_damage_time - float(started_at_epoch or 0.0))
        )
        samples: dict[tuple[int, int], int] = {}
        for raw_second, raw_actor_totals in self.participant_damage_samples.items():
            try:
                second = max(
                    0,
                    min(final_second, opening_offset + int(raw_second)),
                )
            except (TypeError, ValueError, OverflowError):
                continue
            if not isinstance(raw_actor_totals, dict):
                continue
            for raw_actor_id, raw_total in raw_actor_totals.items():
                try:
                    actor_id = int(raw_actor_id)
                    total = max(0, int(raw_total))
                except (TypeError, ValueError, OverflowError):
                    continue
                if actor_id not in final_totals:
                    continue
                key = (second, actor_id)
                samples[key] = max(samples.get(key, 0), total)

        for actor_id, total in final_totals.items():
            samples[(final_second, actor_id)] = total
        previous_by_actor: dict[int, int] = {}
        rows: list[list[int]] = []
        for (second, actor_id), total in sorted(samples.items()):
            previous = previous_by_actor.get(actor_id, 0)
            if total < previous or total > final_totals[actor_id]:
                return {}
            rows.append([second, actor_id, total])
            previous_by_actor[actor_id] = total
        if any(
            previous_by_actor.get(actor_id) != total
            for actor_id, total in final_totals.items()
        ):
            return {}
        return {
            "version": 1,
            "columns": ["time_seconds", "actor_id", "total_damage"],
            "coverage": "live_participant_cumulative",
            "interval_seconds": 1,
            "origin_started_at_epoch": float(started_at_epoch),
            "rows": rows,
        }

    def _history_event_log(
        self, started_at: float, duration_seconds: float
    ) -> dict[str, object]:
        """Serialize compact observed damage events for future history tools."""
        if not self.events or started_at <= 0:
            return {}
        maximum_relative_ms = max(
            0, int(math.ceil(max(0.0, duration_seconds) * 1000.0))
        )
        target_ids = self._encounter_damage_target_ids()
        rows: list[list[object]] = []
        for event in self.events:
            try:
                actor_id = int(event.get("attacker_id", 0) or 0)
                target_id = int(event.get("target_id", 0) or 0)
                damage = max(0, int(event.get("damage", 0) or 0))
            except (AttributeError, TypeError, ValueError, OverflowError):
                continue
            if (
                damage <= 0
                or target_id not in target_ids
                or not self._actor_counts_for_encounter(actor_id)
            ):
                continue
            event_time = self._event_seconds(event)
            relative_ms = min(
                maximum_relative_ms,
                max(0, int(round((event_time - started_at) * 1000))),
            )
            skill_id = int(event.get("skill_id", 0) or 0)
            if not skill_id:
                skill_id = self.normalize_damage_skill_id(
                    event.get("arg4_u64", 0)
                )
            critical = event.get("critical")
            penetrating = event.get("penetrating")
            rows.append(
                [
                    relative_ms,
                    actor_id,
                    target_id,
                    skill_id,
                    damage,
                    critical if isinstance(critical, bool) else None,
                    penetrating if isinstance(penetrating, bool) else None,
                ]
            )
        if not rows:
            return {}
        rows.sort(key=lambda row: int(row[0]))
        return {
            "version": 1,
            "columns": [
                "time_ms",
                "actor_id",
                "target_id",
                "skill_id",
                "damage",
                "critical",
                "penetrating",
            ],
            "coverage": "observed_damage_events",
            "origin_started_at_epoch": float(started_at),
            "rows": rows,
        }

    def _history_skill_cast_log(
        self, started_at: float, duration_seconds: float
    ) -> dict[str, object]:
        """Serialize observed team casts independently from damage hits."""

        if not self.skill_cast_events or started_at <= 0:
            return {}
        maximum_relative_ms = max(
            0, int(math.ceil(max(0.0, duration_seconds) * 1000.0))
        )
        ended_at = started_at + max(0.0, duration_seconds)
        rows: list[list[int]] = []
        actor_sources = {}
        for event in self.skill_cast_events:
            try:
                actor_id = int(event.get("actor_id", 0) or self.self_id or 0)
                skill_id = self.normalize_damage_skill_id(event.get("skill_id", 0))
                sequence = int(event.get("sequence", 0) or 0)
                event_time = self._event_seconds(event)
            except (AttributeError, KeyError, TypeError, ValueError, OverflowError):
                continue
            if (
                not self._actor_counts_for_encounter(actor_id)
                or skill_id <= 0
                or event_time < started_at
                or event_time > ended_at
            ):
                continue
            relative_ms = min(
                maximum_relative_ms,
                max(0, int(round((event_time - started_at) * 1000.0))),
            )
            rows.append([relative_ms, actor_id, skill_id, sequence])
            actor_sources[str(actor_id)] = (
                "cast_broadcast"
                if event.get("cast_source") == "network_cast_broadcast"
                else "successful_cast"
            )
        if not rows:
            return {}
        rows.sort(key=lambda row: (row[0], row[3]))
        return {
            "version": 1,
            "columns": ["time_ms", "actor_id", "skill_id", "sequence"],
            "coverage": "observed_team_casts",
            "actor_sources": actor_sources,
            "origin_started_at_epoch": float(started_at),
            "rows": rows,
        }

    def build_combat_record(self, reason: str = "completed") -> dict | None:
        if self.combat_end_time and self.combat_end_reason == "target_defeated":
            # Leaving the party/map or closing the app may flush the archive
            # before the idle timer does. The flush trigger cannot overwrite
            # an already confirmed victory and hide its upload action.
            reason = "target_defeated"
        signature = self._archive_signature()
        if signature is None:
            return None
        dummy_final_damage = None
        if self._is_dummy_encounter() and self.dummy_round_official_final:
            dummy_final_damage = self.dummy_display_damage()

        def archived_actor_damage(actor) -> int:
            if (
                dummy_final_damage is not None
                and self.self_id is not None
                and actor.actor_id == self.self_id
            ):
                return max(0, int(dummy_final_damage))
            return max(0, int(actor.damage or 0))

        total_observed_damage = sum(
            archived_actor_damage(actor) for actor in self.stats.values()
        )
        damage_context = bool(
            total_observed_damage > 0
            and self.first_damage_time
            and self.last_damage_time
        )
        pure_healing_context = not damage_context
        if damage_context:
            interval = self.resolve_combat_interval(for_archive=True)
            if not interval.valid:
                interval = ResolvedCombatInterval.from_endpoints(
                    self.first_damage_time,
                    self.combat_end_time or self.last_damage_time,
                    source="local_network_events",
                    final=True,
                )
            if not interval.valid:
                return None
            started_at = interval.started_at_epoch
            ended_at = interval.ended_at_epoch
            duration = ended_at - started_at
            local_event_duration = max(
                0.0, self.last_damage_time - self.first_damage_time
            )
            game_server_clock_accepted = bool(
                interval.source == "game_server_team_clock"
            )
            shared_clock_accepted = bool(
                interval.source == "server_shared_clock"
                and self.shared_clock_final
            )
            dps_duration = interval.divisor_seconds
            hps_duration = dps_duration
        else:
            interval = ResolvedCombatInterval.from_endpoints(
                self.first_healing_time,
                self.healing_end_time or self.last_healing_time,
                source="local_healing_events",
                final=bool(self.healing_end_time),
            )
            if not interval.valid:
                return None
            started_at = interval.started_at_epoch
            ended_at = interval.ended_at_epoch
            duration = ended_at - started_at
            local_event_duration = max(
                0.0, self.last_healing_time - self.first_healing_time
            )
            game_server_clock_accepted = False
            shared_clock_accepted = False
            # A treatment-dummy record has no DPS denominator.  HPS still uses
            # the same whole-second divisor shown in the HPS UI.
            dps_duration = 0.0
            hps_duration = interval.divisor_seconds
        healing = self.healing_summary(duration)
        rows = sorted(
            (
                actor
                for actor in self.stats.values()
                if archived_actor_damage(actor) > 0
            ),
            key=archived_actor_damage,
            reverse=True,
        )
        total_damage = sum(archived_actor_damage(actor) for actor in rows)
        taken_rows = self.current_taken_rows()
        taken_by_actor = {
            int(row["actor_id"]): row for row in taken_rows
        }
        taken_participants = [
            {
                **row,
                "name": self.display_name(int(row["actor_id"]))
                or f"玩家{index + 1}",
                "profession_id": self.actor_profession_id(int(row["actor_id"])),
                "extraordinary_rating": self.entity_extraordinary_ratings.get(
                    int(row["actor_id"])
                ),
                "is_ai": self.actor_is_ai(int(row["actor_id"])),
            }
            for index, row in enumerate(taken_rows)
        ]
        team_taken = (
            sum(int(row["taken"] or 0) for row in taken_rows)
            if taken_rows
            and all(row["taken"] is not None for row in taken_rows)
            else None
        )
        ordered_ids = list(self.friend_order)
        ordered_ids.extend(
            actor.actor_id for actor in rows if actor.actor_id not in ordered_ids
        )
        participants: list[dict] = []
        for actor in rows:
            actor_id = actor.actor_id
            actor_damage = archived_actor_damage(actor)
            stage_skill_snapshot = self.active_stage_skill_snapshot(
                actor_id, actor
            )
            try:
                fallback_index = ordered_ids.index(actor_id) + 1
            except ValueError:
                fallback_index = len(participants) + 1
            name = self.display_name(actor_id) or f"玩家{fallback_index}"
            skills = []
            for skill in sorted(
                actor.skills.values(), key=lambda item: item.damage, reverse=True
            ):
                skills.append(
                    {
                        "skill_id": skill.skill_id,
                        "name": self.display_skill_name(actor_id, skill.skill_id),
                        "damage": skill.damage,
                        "share": skill.damage / actor_damage if actor_damage else 0.0,
                        "hits": (
                            None
                            if stage_skill_snapshot is not None
                            and skill.skill_id == 0
                            else skill.hits
                        ),
                        "max_hit": (
                            None
                            if stage_skill_snapshot is not None
                            else skill.max_hit
                        ),
                        "source": (
                            "server_stage_summary"
                            if stage_skill_snapshot is not None
                            else "exact_callback"
                        ),
                    }
                )
            if not skills and actor_damage > 0:
                skills.append(
                    {
                        "skill_id": 0,
                        "name": "未归类伤害",
                        "damage": actor_damage,
                        "share": 1.0,
                        "hits": None,
                        "max_hit": None,
                        "aggregate": True,
                    }
                )
            classified_skill_damage = sum(
                skill.damage
                for skill in actor.skills.values()
                if skill.skill_id != 0
            )
            unclassified_damage = sum(
                skill.damage
                for skill in actor.skills.values()
                if skill.skill_id == 0
            )
            accounted_skill_damage = (
                classified_skill_damage + unclassified_damage
            )
            taken_row = taken_by_actor.get(actor_id, {})
            participants.append(
                {
                    "actor_id": actor_id,
                    "name": name,
                    "is_self": actor_id == self.self_id,
                    "profession_id": self.actor_profession_id(actor_id),
                    "extraordinary_rating": self.entity_extraordinary_ratings.get(
                        actor_id
                    ),
                    "is_ai": self.actor_is_ai(actor_id),
                    "damage": actor_damage,
                    "dps": actor_damage / dps_duration,
                    "share": actor_damage / total_damage if total_damage else 0.0,
                    "hits": actor.hits,
                    "max_hit": actor.max_hit,
                    "damage_hits": actor.damage_hits,
                    "critical_hits": actor.critical_hits,
                    "penetration_hits": actor.penetration_hits,
                    "critical_rate": (
                        actor.critical_hits / actor.damage_hits
                        if actor.damage_hits
                        and actor.critical_hits is not None
                        else None
                    ),
                    "penetration_rate": (
                        actor.penetration_hits / actor.damage_hits
                        if actor.damage_hits
                        and actor.penetration_hits is not None
                        else None
                    ),
                    "deaths": self.member_death_counts.get(actor_id, 0),
                    "revives": self.member_revive_counts.get(actor_id, 0),
                    "death_duration_seconds": self.member_death_duration(
                        actor_id, ended_at
                    ),
                    "taken": taken_row.get("taken"),
                    "taken_share": taken_row.get("share"),
                    "taken_source": taken_row.get("source", "unavailable"),
                    "classified_skill_damage": classified_skill_damage,
                    "unclassified_damage": unclassified_damage,
                    "accounted_skill_damage": accounted_skill_damage,
                    "skill_damage_difference": (
                        actor_damage - accounted_skill_damage
                    ),
                    "skill_source": (
                        "server_stage_summary"
                        if stage_skill_snapshot is not None
                        else "exact_callbacks_with_explicit_unclassified"
                    ),
                    "skill_summary_id": (
                        stage_skill_snapshot.summary_id
                        if stage_skill_snapshot is not None
                        else ""
                    ),
                    "skill_detail_status": (
                        "complete"
                        if actor_id == self.self_id
                        or stage_skill_snapshot is not None
                        else "pending_server_detail"
                    ),
                    "skill_reconciliation_mode": (
                        "classified_skills_match_common_total"
                        if stage_skill_snapshot is not None
                        and stage_skill_snapshot.actor_damage > actor_damage
                        and classified_skill_damage == actor_damage
                        else "exact_actor_total"
                        if stage_skill_snapshot is not None
                        else "local_callbacks"
                        if actor_id == self.self_id
                        else "pending"
                    ),
                    "server_reported_damage": (
                        stage_skill_snapshot.actor_damage
                        if stage_skill_snapshot is not None
                        else actor_damage
                        if dummy_final_damage is not None
                        and actor_id == self.self_id
                        else None
                    ),
                    "server_reported_unclassified_damage": (
                        stage_skill_snapshot.unclassified_damage
                        if stage_skill_snapshot is not None
                        else None
                    ),
                    "server_damage_difference": (
                        stage_skill_snapshot.actor_damage - actor_damage
                        if stage_skill_snapshot is not None
                        else actor_damage - accounted_skill_damage
                        if dummy_final_damage is not None
                        and actor_id == self.self_id
                        else None
                    ),
                    "skills": skills,
                    "targets": self.actor_target_rows(actor_id),
                }
            )

        target_ids = (
            self._encounter_damage_target_ids()
            if damage_context
            else set(self.healing_target_ids)
        )
        target_models = [
            self.monsters[entity_id]
            for entity_id in target_ids
            if entity_id in self.monsters
        ]
        target_models.sort(
            key=lambda monster: (
                monster.entity_id == self.combat_target_id,
                self._monster_priority(monster),
            ),
            reverse=True,
        )
        targets: list[dict] = []
        for monster in target_models:
            hp_ceiling = self._monster_max_hp(monster)
            targets.append(
                {
                    "entity_id": monster.entity_id,
                    "name": self.display_target_name(monster.entity_id),
                    "level": monster.level,
                    "entity_type": monster.entity_type,
                    "template_id": monster.template_id,
                    "boss_type": monster.boss_type,
                    "boss_rank": self._monster_rank(monster),
                    "current_hp": monster.current_hp,
                    "max_hp": hp_ceiling or None,
                }
            )
        primary_target = targets[0] if targets else None
        event_damage_by_actor: dict[int, int] = {}
        event_damage_by_target: dict[int, int] = {}
        event_count = 0
        for event in self.events:
            try:
                attacker_id = int(event.get("attacker_id", 0) or 0)
                target_id = int(event.get("target_id", 0) or 0)
                event_damage = max(0, int(event.get("damage", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                continue
            if (
                event_damage <= 0
                or target_id not in target_ids
                or not self._actor_counts_for_encounter(attacker_id)
            ):
                continue
            event_count += 1
            event_damage_by_actor[attacker_id] = (
                event_damage_by_actor.get(attacker_id, 0) + event_damage
            )
            event_damage_by_target[target_id] = (
                event_damage_by_target.get(target_id, 0) + event_damage
            )
        damage_accounting = {
            "final_total": total_damage,
            "skill_amount_policy": "absolute_only",
            "skill_amounts_rescaled": False,
            "stage_skill_policy": (
                "server_skill_amounts_are_used_when_the_actor_total_matches_"
                "or_classified_skills_exactly_match_the_common_total"
            ),
            "stage_skill_snapshots": [
                {
                    "summary_id": snapshot.summary_id,
                    "actor_id": actor_id,
                    "actor_damage": snapshot.actor_damage,
                    "filetime_100ns": snapshot.filetime_100ns,
                    "classified_damage": sum(
                        damage for damage, _hits in snapshot.skills.values()
                    ),
                    "unclassified_damage": snapshot.unclassified_damage,
                    "skill_count": len(snapshot.skills),
                }
                for actor_id, snapshot in sorted(
                    self.stage_skill_snapshots.items()
                )
                if self.active_stage_skill_snapshot(actor_id) is not None
            ],
            "pending_stage_skill_snapshots": [
                {
                    "summary_id": snapshot.summary_id,
                    "actor_id": actor_id,
                    "summary_actor_damage": snapshot.actor_damage,
                    "current_common_damage": int(
                        self.stats.get(actor_id).damage
                        if self.stats.get(actor_id) is not None
                        else 0
                    ),
                    "filetime_100ns": snapshot.filetime_100ns,
                    "classified_damage": sum(
                        damage for damage, _hits in snapshot.skills.values()
                    ),
                    "unclassified_damage": snapshot.unclassified_damage,
                    "common_actor_damage": int(
                        self.stats.get(actor_id).damage
                        if self.stats.get(actor_id) is not None
                        else 0
                    ),
                    "reconciliation_mode": (
                        "classified_skills_match_common_total"
                        if self.stats.get(actor_id) is not None
                        and snapshot.actor_damage
                        > self.stats[actor_id].damage
                        else "exact_actor_total"
                    ),
                    "skill_count": len(snapshot.skills),
                    "status": "waiting_for_actor_reconciliation",
                }
                for actor_id, snapshot in sorted(
                    self.pending_stage_skill_snapshots.items()
                )
            ],
            "skill_reconciliation": [
                {
                    "actor_id": int(participant.get("actor_id", 0) or 0),
                    "name": str(participant.get("name", "")),
                    "damage": int(participant.get("damage", 0) or 0),
                    "classified_skill_damage": int(
                        participant.get("classified_skill_damage", 0) or 0
                    ),
                    "unclassified_damage": int(
                        participant.get("unclassified_damage", 0) or 0
                    ),
                    "accounted_skill_damage": int(
                        participant.get("accounted_skill_damage", 0) or 0
                    ),
                    "difference": int(
                        participant.get("skill_damage_difference", 0) or 0
                    ),
                }
                for participant in participants
            ],
            "packet_event_count": event_count,
            "packet_event_total": sum(event_damage_by_actor.values()),
            "packet_event_by_actor": [
                {
                    "actor_id": actor_id,
                    "name": self.display_name(actor_id),
                    "damage": damage,
                }
                for actor_id, damage in sorted(
                    event_damage_by_actor.items(),
                    key=lambda item: item[1],
                    reverse=True,
                )
            ],
            "packet_event_by_target": [
                {
                    "entity_id": target_id,
                    "name": self.display_target_name(target_id),
                    "damage": damage,
                }
                for target_id, damage in sorted(
                    event_damage_by_target.items(),
                    key=lambda item: item[1],
                    reverse=True,
                )
            ],
            "unconfirmed_team_counter_regressions": list(self.team_counter_regressions),
            "team_cumulative_states": [
                {
                    "actor_id": actor_id,
                    "name": self.display_name(actor_id),
                    "last_absolute": state.last_absolute,
                    "baseline_absolute": state.baseline_absolute,
                    "accepted_damage": state.accepted_damage,
                    "has_snapshot": state.has_snapshot,
                    "authoritative_snapshot": state.authoritative_snapshot,
                    "snapshot_time_100ns": state.snapshot_time_100ns,
                    "server_time": state.server_time,
                    "first_time": state.first_time,
                    "last_time": state.last_time,
                }
                for actor_id, state in self.team_damage_states.items()
                if state.has_snapshot or state.accepted_damage > 0
            ],
            "stage_summary_validations": [
                {
                    "summary_id": summary_id,
                    "filetime_100ns": int(
                        summary.get("filetime_100ns", 0) or 0
                    ),
                    "authoritative": bool(summary.get("authoritative")),
                    "completion_confirmed": bool(
                        summary.get("completion_confirmed")
                    ),
                    "validation_only": bool(summary.get("validation_only")),
                    "validation": dict(summary.get("validation", {})),
                    "member_count": int(summary.get("member_count", 0) or 0),
                    "actors": [
                        dict(actor)
                        for actor in summary.get("actors", [])
                        if isinstance(actor, dict)
                    ],
                }
                for summary_id, summary in self.stage_summaries.items()
            ],
            "seen_stage_summary_ids": sorted(self.seen_stage_summary_ids),
            "rejected_stage_summary_ids": sorted(
                self.rejected_stage_summary_ids
            ),
            "encounter_member_ids": sorted(self.encounter_member_ids),
            "encounter_target_ids": sorted(target_ids),
        }
        identity_actor_ids = set(self.encounter_member_ids)
        identity_actor_ids.update(
            int(participant.get("actor_id", 0) or 0)
            for participant in participants
            if isinstance(participant, dict)
        )
        if self.self_id is not None:
            identity_actor_ids.add(int(self.self_id))
        participant_identities = [
            {
                "actor_id": actor_id,
                "character_id": self.actor_character_ids[actor_id],
            }
            for actor_id in sorted(identity_actor_ids)
            if actor_id in self.actor_character_ids
        ]
        archived_self_character_id = (
            self.actor_character_ids.get(int(self.self_id or 0), "")
        )
        now = time.time()
        record = {
            "schema_version": HISTORY_SCHEMA_VERSION,
            "encounter_id": self.encounter_id,
            "source": "network_rpc",
            "archive_reason": str(reason),
            "started_at_epoch": started_at,
            "ended_at_epoch": ended_at,
            "started_at": self._iso_timestamp(started_at),
            "ended_at": self._iso_timestamp(ended_at),
            "saved_at_epoch": now,
            "saved_at": self._iso_timestamp(now),
            "dungeon_id": int(self.encounter_dungeon_id or 0),
            "map_id": int(self.encounter_map_id or 0),
            "dungeon_stage_id": int(self.encounter_dungeon_stage_id or 0),
            "dungeon_stage_phase": int(
                self.encounter_dungeon_stage_phase or 0
            ),
            "dungeon_context_filetime": int(
                self.encounter_dungeon_context_filetime or 0
            ),
            "dungeon_context_source": (
                self.encounter_dungeon_context_source
                or "explicit_protocol_fields"
            ),
            "brass_tome_status": self.encounter_brass_tome_status,
            "brass_tome_enabled": (
                True if self.encounter_brass_tome_status == "enabled"
                else False if self.encounter_brass_tome_status == "disabled"
                else None
            ),
            "brass_tome_challenge_ids": list(
                self.encounter_brass_tome_challenge_ids
            ),
            "brass_tome_source": self.encounter_brass_tome_source,
            "duration_seconds": duration,
            "dps_duration_seconds": dps_duration,
            "hps_duration_seconds": hps_duration,
            "healing_started_at_epoch": started_at,
            "healing_ended_at_epoch": ended_at,
            "local_event_interval": {
                "started_at_epoch": (
                    self.first_damage_time
                    if damage_context
                    else self.first_healing_time
                ),
                "ended_at_epoch": (
                    self.last_damage_time
                    if damage_context
                    else self.last_healing_time
                ),
                "duration_seconds": local_event_duration,
            },
            "combat_clock_party_key": self.combat_clock_party_key,
            "combat_clock_target_key": self.combat_clock_target_key,
            "duration_source": (
                "game_server_team_clock"
                if game_server_clock_accepted and damage_context
                else (
                    "server_shared_clock"
                    if shared_clock_accepted and damage_context
                    else (
                        "game_server_dummy_clock"
                        if damage_context
                        and interval.source == "game_server_dummy_clock"
                        else (
                            "local_healing_events"
                            if pure_healing_context
                            else "local_network_events"
                        )
                    )
                )
            ),
            "total_damage": total_damage,
            "team_dps": total_damage / dps_duration if dps_duration else 0.0,
            "team_hps": float(healing.get("team_hps", 0.0) or 0.0),
            "team_total_healing": healing.get("team_total_healing"),
            "team_effective_healing": int(
                healing.get("team_effective_healing", 0) or 0
            ),
            "team_overhealing": healing.get("team_overhealing"),
            "team_taken": team_taken,
            "damage_taken": taken_participants,
            "healers": list(healing.get("healers", [])),
            "healing_accounting": {
                "peak_window_seconds": int(
                    healing.get("peak_window_seconds", 5) or 5
                ),
                "source_policy": str(healing.get("source_policy", "")),
                "stage_healing_snapshots": [
                    {
                        "summary_id": snapshot.summary_id,
                        "actor_id": actor_id,
                        "actor_damage": snapshot.actor_damage,
                        "effective_healing": snapshot.effective_healing,
                        "classified_healing": sum(snapshot.skills.values()),
                        "unclassified_healing": snapshot.unclassified_healing,
                    }
                    for actor_id, snapshot in sorted(
                        self.stage_healing_snapshots.items()
                    )
                    if self.active_stage_healing_snapshot(actor_id) is not None
                ],
            },
            "team_size": (
                min(
                    MAX_PARTY_MEMBERS,
                    max(
                        len(healing.get("healers", [])),
                        self.encounter_team_size,
                        len(self._current_member_ids()),
                    ),
                )
                if pure_healing_context
                else (
                    len(participants)
                    if self._is_dummy_encounter()
                    else min(
                        MAX_PARTY_MEMBERS,
                        max(len(participants), self.encounter_team_size),
                    )
                )
            ),
            "target_filter": (
                "healing_dummy"
                if pure_healing_context
                else ("boss" if self.boss_only else "all_monsters")
            ),
            "monster": primary_target,
            "targets": targets,
            "participants": participants,
            "damage_accounting": damage_accounting,
        }
        if participant_identities:
            record["participant_identities"] = participant_identities
        if archived_self_character_id:
            record["self_character_id"] = archived_self_character_id
        boss_damage_summary = self._boss_damage_summary(
            team_taken=team_taken,
            started_at_epoch=started_at,
            duration_seconds=duration,
            include_event_log=True,
        )
        maximum_ms = max(0, int(round(duration * 1000.0)))
        death_rows: list[list[object]] = []
        for actor_id, transitions in self.member_life_transitions.items():
            for timestamp_100ns, dead in transitions:
                if not dead:
                    continue
                event_epoch = self._event_seconds(
                    {"filetime_100ns": timestamp_100ns}
                )
                if event_epoch < started_at - 0.5 or event_epoch > ended_at + 0.5:
                    continue
                relative_ms = min(
                    maximum_ms,
                    max(0, int(round((event_epoch - started_at) * 1000.0))),
                )
                death_rows.append(
                    [relative_ms, int(actor_id), self.display_name(actor_id)]
                )
        if death_rows:
            death_rows.sort(key=lambda row: (int(row[0]), int(row[1])))
            boss_damage_summary["death_event_log"] = {
                "version": 1,
                "columns": ["time_ms", "actor_id", "name"],
                "origin_started_at_epoch": float(started_at),
                "rows": death_rows,
            }
        record["boss_damage"] = boss_damage_summary
        team_damage_samples = self._history_team_damage_sample_log(
            dps_duration,
            total_damage,
            started_at_epoch=started_at,
        )
        if team_damage_samples:
            record["team_damage_samples"] = team_damage_samples
        boss_hp_damage_samples = self._history_boss_hp_damage_sample_log(
            dps_duration, started_at_epoch=started_at
        )
        if boss_hp_damage_samples:
            record["boss_hp_damage_samples"] = boss_hp_damage_samples
        display_team_dps_samples = self._history_display_team_dps_sample_log(
            dps_duration, started_at_epoch=started_at
        )
        if display_team_dps_samples:
            record["display_team_dps_samples"] = display_team_dps_samples
        participant_damage_samples = self._history_participant_damage_sample_log(
            dps_duration,
            participants,
            started_at_epoch=started_at,
        )
        if participant_damage_samples:
            record["participant_damage_samples"] = participant_damage_samples
        event_log = self._history_event_log(started_at, duration)
        if event_log:
            record["event_log"] = event_log
            timeline = rebuild_dps_timeline(record)
            if timeline:
                record["dps_timeline"] = timeline
        skill_cast_log = self._history_skill_cast_log(started_at, duration)
        if skill_cast_log:
            record["skill_cast_log"] = skill_cast_log
        team_timeline = rebuild_team_dps_timeline(record)
        if team_timeline:
            record["team_dps_timeline"] = team_timeline
        if game_server_clock_accepted:
            record["game_server_team_clock"] = {
                "summary_id": self.game_server_duration_summary_id,
                "duration_seconds": self.game_server_duration_seconds,
                "policy": self.game_server_duration_policy,
                "member_seconds": list(
                    self.game_server_duration_member_seconds
                ),
                "local_event_duration_seconds": (
                    self.game_server_duration_local_seconds
                ),
                "difference_seconds": (
                    self.game_server_duration_difference_seconds
                ),
                "local_comparison_used_for_acceptance": False,
                "accepted": True,
            }
        elif self.game_server_duration_rejection:
            record["game_server_team_clock_rejected"] = dict(
                self.game_server_duration_rejection
            )
        clock_request = self.combat_clock_snapshot(
            now,
            ended=True,
            state=(
                "final"
                if game_server_clock_accepted
                or str(reason).casefold() in COMBAT_CLOCK_FINAL_ARCHIVE_REASONS
                else "settling"
            ),
            end_reason=str(reason),
        )
        if clock_request is not None:
            record["combat_clock_party_key"] = str(
                clock_request.get("party_key", "")
            )
            record["combat_clock_target_key"] = str(
                clock_request.get("target_key", "")
            )
        if clock_request is not None and not shared_clock_accepted:
            record["_shared_clock_request"] = clock_request
        if self.shared_clock_final:
            record["shared_clock"] = {
                "clock_id": self.shared_clock_id,
                "started_at_epoch": self.shared_clock_started_at,
                "ended_at_epoch": self.shared_clock_ended_at,
                "server_time": self.shared_clock_server_time,
                "state": self.shared_clock_state or "final",
                "final": True,
                "revision": self.shared_clock_revision,
                "client_revision": self.shared_clock_client_revision,
                "party_key": self.shared_clock_party_key,
                "target_key": self.shared_clock_target_key,
                "total_damage": self.shared_clock_total_damage,
                "accepted": shared_clock_accepted,
                "local_observed_damage_span_seconds": local_event_duration,
                "difference_seconds": abs(
                    self.shared_clock_duration_seconds - local_event_duration
                ),
                "coverage_rule": "not_shorter_than_local_observed_damage_span",
            }
        return record

    def _queue_current_record_refresh(self) -> bool:
        target_depleted = self._target_hp_depleted()
        pure_healing_finished = bool(
            not self.first_damage_time and self.healing_end_time
        )
        if (
            not self.combat_end_time
            and not pure_healing_finished
            and (not target_depleted or self._multiphase_encounter())
        ):
            return False
        reason = self.combat_end_reason or (
            self.healing_end_reason
            if pure_healing_finished
            else ("target_defeated" if target_depleted else "completed")
        )
        record = self.build_combat_record(reason)
        signature = self._archive_signature()
        if record is None or signature is None:
            return False
        for index in range(len(self.completed_combats) - 1, -1, -1):
            if self.completed_combats[index].get("encounter_id") == self.encounter_id:
                self.completed_combats[index] = record
                self.last_archive_signature = signature
                return True
        # The first copy may already be on disk. Saving the same encounter ID
        # again attaches late validation or crit metadata without changing DPS.
        self.completed_combats.append(record)
        self.last_archive_signature = signature
        return True

    def archive_current(self, reason: str = "completed") -> bool:
        signature = self._archive_signature()
        if signature is None or signature == self.last_archive_signature:
            return False
        record = self.build_combat_record(reason)
        if record is None:
            return False
        for index in range(len(self.completed_combats) - 1, -1, -1):
            if self.completed_combats[index].get("encounter_id") == self.encounter_id:
                self.completed_combats[index] = record
                self.last_archive_signature = signature
                return True
        self.completed_combats.append(record)
        self.last_archive_signature = signature
        return True

    def finalize_if_idle(self, now: float | None = None) -> bool:
        now = time.time() if now is None else now
        if (
            self._confirmed_boss_fight_mode_active()
            and self.combat_end_reason != "target_defeated"
            and not self._result_frozen_by_target_death()
        ):
            # A Boss->player-only capture can have no friendly damage update
            # for minutes. The explicit fight-mode state is stronger than the
            # ordinary ten-second damage idle timeout and keeps that pull live.
            return False
        if self.combat_end_time:
            if (
                self.combat_end_reason == "target_defeated"
                and self._awaiting_verified_simultaneous_boss_successor()
                and now - self.combat_end_time
                < SIMULTANEOUS_BOSS_SUCCESSOR_WAIT_SECONDS
            ):
                return False
            return self.archive_current(
                self.combat_end_reason or "completed"
            )
        if not self.last_damage_time:
            if not self.last_healing_time:
                return False
            if self.healing_end_time:
                return self.archive_current(
                    self.healing_end_reason or "completed"
                )
            if now - self.last_healing_time < self.idle_gap:
                return False
            self.healing_end_time = self.last_healing_time
            self.healing_end_reason = "idle"
            self.healing_revision += 1
            self.healing_summary_cache_key = None
            self.healing_summary_cache = None
            return self.archive_current("idle")
        if (
            self.boss_reset_pending_100ns
            and now - self.last_damage_time >= self.idle_gap
            and not self._multiphase_encounter()
            and not self._awaiting_verified_simultaneous_boss_successor()
            and not self._awaiting_long_gap_phase_successor()
        ):
            # Some clients do not expose every entity's fight-mode transition.
            # A confirmed full refill followed by a quiet interval is the
            # fallback for the same all-out-of-combat reset condition.
            self.combat_end_time = self.last_damage_time
            self.combat_end_reason = "target_reset"
            return self.archive_current("target_reset")
        if now - self.last_damage_time < self._encounter_idle_timeout():
            return False
        if self._awaiting_long_gap_phase_successor():
            # Karl Edgar's scripted opening is followed by a long transition
            # before the final form.  The exact predecessor template is kept
            # pending instead of becoming a standalone one-second history row.
            return False
        monster = self.current_monster()
        if (
            self._multiphase_encounter()
            and not (
                monster is not None
                and monster.current_hp is not None
                and monster.current_hp <= 0
                and monster.death_time_100ns
            )
        ):
            # 星象仪者的守卫阶段可能超过普通脱战间隔，Boss 还存活时
            # 不能仅凭静默或一次回满候选把同一场战斗拆开。
            return False
        reason = "target_defeated" if self._target_hp_depleted() else "idle"
        return self.archive_current(reason)

    def pop_completed_combats(self) -> list[dict]:
        records = self.completed_combats
        self.completed_combats = []
        return records

    def _apply_event_incrementally(self, event: dict) -> bool:
        attacker = int(event.get("attacker_id", 0) or 0)
        target = int(event.get("target_id", 0) or 0)
        damage = int(event.get("damage", 0) or 0)
        timestamp = int(event.get("filetime_100ns", 0) or 0)
        if (
            damage <= 0
            or not self._is_encounter_damage_target(target)
            or not self._actor_counts_for_encounter(attacker)
        ):
            return True

        actor = self.stats.get(attacker)
        team_state = self.team_damage_states.get(attacker)
        if (
            attacker in self.stage_actor_metrics
            or attacker in self.stage_actor_penetration_metrics
            or self.active_stage_skill_snapshot(attacker, actor) is not None
            or (
                team_state is not None
                and team_state.authoritative_snapshot
                and team_state.snapshot_time_100ns > 0
                and timestamp <= team_state.snapshot_time_100ns
            )
        ):
            return False

        event_time = self._event_seconds(event)
        actor = self.stats.setdefault(attacker, ActorStats(attacker))
        skill_id = self.normalize_damage_skill_id(event.get("skill_id", 0))
        if not skill_id:
            skill_id = self.normalize_damage_skill_id(event.get("arg4_u64", 0))
        raw_critical = event.get("critical")
        raw_penetrating = event.get("penetrating")
        actor.add(
            damage,
            event_time,
            skill_id,
            target,
            bool(raw_critical) if isinstance(raw_critical, bool) else None,
            (
                bool(raw_penetrating)
                if isinstance(raw_penetrating, bool)
                else None
            ),
        )
        if not self.first_damage_time or event_time < self.first_damage_time:
            self.first_damage_time = event_time
        self.last_damage_time = max(self.last_damage_time, event_time)
        if self._is_dummy_encounter() and attacker == self.self_id:
            self.dummy_round_last_local_hit_100ns = max(
                self.dummy_round_last_local_hit_100ns, timestamp
            )
        return True

    def ingest(self, event: dict) -> None:
        if event.get("damage_source") == "hp_correlated":
            return
        try:
            damage = int(event.get("damage", 0))
            attacker = int(event["attacker_id"])
            target = int(event["target_id"])
            timestamp = int(event.get("filetime_100ns", 0) or 0)
        except (KeyError, TypeError, ValueError, OverflowError):
            return
        if (
            damage <= 0
            or parse_combat_amount(damage) is None
            or event.get("player_attacker") is False
            or attacker in self.non_player_actor_ids
        ):
            return
        if target in self.closed_encounter_target_ids:
            return
        event = dict(event)
        event["skill_id"] = self.normalize_damage_skill_id(
            event.get("skill_id", 0)
        ) or self.normalize_damage_skill_id(event.get("arg4_u64", 0))
        if event.get("active_boss") is True:
            active_update = dict(event)
            active_update["entity_id"] = target
            self.ingest_active_boss(active_update)
        self.latest_network_time_100ns = max(self.latest_network_time_100ns, timestamp)
        if self.long_gap_phase_suspended:
            return
        target_disposition = self._target_event_disposition(target)
        if target_disposition == "pending":
            self._buffer_pending_target_event(event)
            return
        if target_disposition == "reject":
            self.discarded_non_encounter_events += 1
            return
        # Participation is established by a confirmed player damaging one of
        # this encounter's targets. Party snapshots are still used for names
        # and life state, but a stale join/leave list must never hide a real
        # contributor or keep a departed zero-damage row on screen.
        if (
            attacker not in self._current_member_ids()
            and event.get("player_attacker") is not True
        ):
            if self.party_known and not self._party_roster_is_resolved():
                self._buffer_pending_member_event(event)
            return
        previous_session_number = self.session_number
        encounter_was_empty = not self.first_damage_time
        event_time = self._event_seconds(event)
        if (
            self._is_dummy_target(target)
            and self.self_id is not None
            and attacker != self.self_id
        ):
            return
        if (
            not self.boss_only
            and target not in self.monsters
            and target not in self.friendly_ids
            and attacker in self.friendly_ids
        ):
            # Ordinary monster profile/HP packets may arrive after the first
            # hit.  In all-monsters mode, a confirmed friendly hit is enough
            # to create a provisional target; later profile packets refine it.
            self.monsters[target] = MonsterStats(
                target, entity_type="Monster"
            )
        priority_target = self._is_priority_target(target)
        if not priority_target and self.combat_target_id is None:
            auxiliary = self.monsters.get(target)
            if auxiliary is not None and auxiliary.encounter_auxiliary:
                parents = set(auxiliary.encounter_parent_template_ids)
                candidates = [
                    monster
                    for monster in self.monsters.values()
                    if int(monster.template_id or 0) in parents
                    and self._monster_rank(monster) > 0
                ]
                if candidates:
                    self.combat_target_id = max(
                        candidates, key=self._monster_priority
                    ).entity_id
                    self._register_encounter_target(self.combat_target_id)
        if (
            not priority_target
            and self.combat_target_id is not None
            and not self._is_encounter_damage_target(target)
        ):
            self._link_boss_scene_target(target, event_time, timestamp)
        linked_target = self._is_encounter_damage_target(target)
        if (
            (priority_target or linked_target)
            and attacker not in self.encounter_member_ids
            and len(self.encounter_member_ids) >= MAX_PARTY_MEMBERS
        ):
            return
        if priority_target:
            target_before_gap = self.monsters.get(
                int(self.combat_target_id or 0)
            )
            incoming_before_gap = self.monsters.get(target)
            phase_target_continuation = bool(
                self.combat_target_id is not None
                and target != self.combat_target_id
                and self._boss_phase_continues(
                    target_before_gap, incoming_before_gap
                )
            )
            if (
                phase_target_continuation
                and self.combat_end_reason in {"party_wipe", "target_reset"}
            ):
                phase_target_continuation = False
            if (
                self.last_damage_time
                and event_time - self.last_damage_time
                > (self.encounter_gap if self.boss_only else self.idle_gap)
                and self._damage_gap_starts_new_encounter()
                and not phase_target_continuation
            ):
                self.reset(
                    keep_identity=True,
                    keep_monsters=True,
                    archive_reason=self.combat_end_reason or "new_encounter",
                )
            if (
                self.combat_target_id is not None
                and target != self.combat_target_id
            ):
                self._try_register_simultaneous_boss(
                    target,
                    timestamp,
                    explicit=event.get("simultaneous_boss") is True,
                    allow_hp_overlap=event.get("active_boss") is True,
                )
            current_target = self.monsters.get(int(self.combat_target_id or 0))
            current_defeated = bool(
                current_target is not None
                and current_target.current_hp is not None
                and current_target.current_hp <= 0
                and current_target.death_confirmed
            )
            terminal_inflight_damage = bool(
                self.combat_end_time
                and self.combat_end_reason == "target_defeated"
                and target in self._current_boss_target_ids()
                and current_defeated
                and abs(event_time - self.combat_end_time) <= 0.5
            )
            if self.combat_end_time:
                if phase_target_continuation:
                    self.combat_end_time = 0.0
                    self.combat_end_reason = ""
                    self.healing_end_time = 0.0
                    self.healing_end_reason = ""
                    self.completed_combats[:] = [
                        record for record in self.completed_combats
                        if record.get("encounter_id") != self.encounter_id
                    ]
                    self.last_archive_signature = None
                    self.linked_boss_target_ids.update({self.combat_target_id, target})
                    self._replace_simultaneous_boss_target(self.combat_target_id, target)
                    self.combat_target_id = target
                    self.active_target_id = target
                    self._register_encounter_target(target)
                elif not terminal_inflight_damage:
                    self.reset(
                        keep_identity=True,
                        keep_monsters=True,
                        archive_reason=self.combat_end_reason or "new_encounter",
                    )
            elif (
                self.combat_target_id is not None
                and target != self.combat_target_id
                and target not in self._current_boss_target_ids()
            ):
                previous = self.monsters.get(self.combat_target_id)
                incoming = self.monsters.get(target)
                dummy_switch = bool(
                    self.boss_only
                    and self._is_dummy_target(self.combat_target_id)
                    and self._is_dummy_target(target)
                )
                same_phase_group = bool(
                    self.boss_only
                    and self._bosses_share_phase(previous, incoming)
                )
                phase_continuation = bool(
                    same_phase_group
                    and self._boss_phase_continues(previous, incoming)
                )
                separate_encounter = bool(
                    previous is not None
                    and incoming is not None
                    and (
                        int(previous.template_id or 0),
                        int(incoming.template_id or 0),
                    )
                    in SEPARATE_BOSS_ENCOUNTER_TRANSITIONS
                )
                idle_switch = bool(
                    self.last_damage_time
                    and event_time - self.last_damage_time
                    > self.idle_gap
                )
                if dummy_switch:
                    # All damage dummies share one personal Common epoch. A
                    # target swap changes the displayed target, not the round.
                    self.linked_boss_target_ids.update(
                        {int(self.combat_target_id), target}
                    )
                    self.combat_target_id = target
                    self.active_target_id = target
                    self._register_encounter_target(target)
                elif separate_encounter:
                    # 洛克·金·失控 is a new Boss battle, not a second phase of
                    # the preceding 洛克·金 record. Archive the completed first
                    # fight and let this very hit start a clean encounter.
                    self.reset(
                        keep_identity=True,
                        keep_monsters=True,
                        archive_reason="new_encounter",
                    )
                elif phase_continuation:
                    self.linked_boss_target_ids.update(
                        {self.combat_target_id, target}
                    )
                    self._replace_simultaneous_boss_target(
                        self.combat_target_id, target
                    )
                    self.combat_target_id = target
                    self._register_encounter_target(target)
                elif same_phase_group:
                    # The only linked direction is Ancestor Armor -> Baldwin.
                    # Baldwin -> a new Ancestor Armor entity is a repull after
                    # a wipe, even if the old Boss never emitted a death packet.
                    self.reset(
                        keep_identity=True,
                        keep_monsters=True,
                        archive_reason="new_encounter",
                    )
                elif idle_switch:
                    self.reset(
                        keep_identity=True,
                        keep_monsters=True,
                        archive_reason="new_encounter",
                    )
                elif self.boss_only and current_defeated:
                    self.reset(
                        keep_identity=True,
                        keep_monsters=True,
                        archive_reason="new_encounter",
                    )
                elif self.boss_only:
                    # A secondary/lower Boss must not contaminate the locked
                    # encounter while the primary target is still active.
                    return
            if self.combat_target_id is None:
                self.combat_target_id = target
            elif not self.boss_only and target != self.combat_target_id:
                current_target = self.monsters.get(self.combat_target_id)
                incoming_target = self.monsters.get(target)
                current_priority = (
                    (
                        self._monster_rank(current_target),
                        int(current_target.level or 0),
                    )
                    if current_target is not None
                    else (-1, -1)
                )
                incoming_priority = (
                    (
                        self._monster_rank(incoming_target),
                        int(incoming_target.level or 0),
                    )
                    if incoming_target is not None
                    else (-1, -1)
                )
                if current_defeated or incoming_priority > current_priority:
                    self.combat_target_id = target
            current_target = self.monsters.get(target)
            if (
                self._has_simultaneous_bosses()
                and self._boss_is_confirmed_dead(current_target)
                and not terminal_inflight_damage
            ):
                # Death can be observed before already-in-flight damage. A hit
                # for one dead member of a dual-Boss encounter must not clear
                # its zero HP while the other Boss is still alive.
                return
            if (
                current_target is not None
                and current_target.current_hp is not None
                and current_target.current_hp <= 0
                and not terminal_inflight_damage
            ):
                current_target.current_hp = None
                current_target.death_time_100ns = 0
            self._register_encounter_target(target)
            self._arm_team_encounter(target, timestamp)
            self._try_register_verified_simultaneous_boss_partner(timestamp)
            self._update_encounter_roster(attacker)
        elif linked_target:
            if self.combat_end_time or self._target_hp_depleted():
                # Adds belong to this encounter only while the Boss is alive.
                # Daily dungeons can leave ordinary monsters on screen after
                # the Boss reaches zero HP; those late hits must not extend or
                # change the finished DPS result. Multi-phase encounters still
                # return False from _target_hp_depleted() by design.
                return
            self._register_encounter_target(
                target, add=target in self.encounter_add_target_ids
            )
            self._update_encounter_roster(attacker)
        if not priority_target and not linked_target:
            self.discarded_non_encounter_events += 1
            return
        if (priority_target or linked_target) and timestamp:
            self.target_activity_100ns[target] = timestamp
            if (
                self.boss_reset_pending_100ns
                and timestamp > self.boss_reset_pending_100ns
            ):
                # Damage continuing before the party leaves fight mode means
                # this was an ordinary Boss heal, not a completed wipe/reset.
                self.boss_reset_pending_100ns = 0
        self.events.append(event)
        # Retain ample history for a long boss fight without unbounded growth.
        history_trimmed = False
        if len(self.events) > 200_000:
            self.events = self.events[-150_000:]
            history_trimmed = True
        self.enemy_ids.add(target)
        self.friendly_ids.add(attacker)
        if attacker not in self.friend_order:
            self.friend_order.append(attacker)
        self.active_target_id = self.combat_target_id
        if history_trimmed or not self._apply_event_incrementally(event):
            self._recompute()
        if priority_target and terminal_inflight_damage:
            # HP/death and damage messages can be delivered in opposite order.
            # Refresh an already archived record without reopening the fight.
            self._queue_current_record_refresh()
        if self.first_damage_time and (
            self.session_number != previous_session_number
            or (encounter_was_empty and self.session_number > 0)
        ):
            # A completed stage summary can arrive beside the first hit on the
            # next Boss. Keep a short plausibility gate so those old totals do
            # not flash as the new pull's DPS.
            self.stage_summary_guard_until = max(
                self.stage_summary_guard_until,
                event_time + 3.0,
            )

    def _resolve_combat_sides(self) -> None:
        current_friendly = set(self.party_ids) | self.provisional_party_ids
        if self.self_id is not None:
            current_friendly.add(self.self_id)

        if self.combat_target_id is None:
            target_candidates = {
                int(event["target_id"])
                for event in self.events
                if int(event.get("damage", 0)) > 0
                and self._is_priority_target(int(event["target_id"]))
            }
            if target_candidates:
                self.combat_target_id = max(
                    target_candidates,
                    key=lambda entity_id: self._monster_priority(
                        self.monsters[entity_id]
                    ),
                )

        damage_target_ids = self._encounter_damage_target_ids()
        observed_attackers = {
            int(event["attacker_id"])
            for event in self.events
            if int(event.get("damage", 0)) > 0
            and int(event["target_id"]) in damage_target_ids
            and self._actor_counts_for_encounter(int(event["attacker_id"]))
        }
        friendly = current_friendly | observed_attackers
        enemies = damage_target_ids
        for actor_id in [*current_friendly, *observed_attackers]:
            if actor_id not in self.friend_order:
                self.friend_order.append(actor_id)
        self.friendly_ids = friendly
        self.enemy_ids = enemies
        self.active_target_id = self.combat_target_id

    def _recompute(self) -> None:
        stats: dict[int, ActorStats] = {}
        first = 0.0
        last = 0.0
        damage_target_ids = self._encounter_damage_target_ids()
        team_snapshot_events: dict[int, ActorStats] = {}

        for event in self.events:
            attacker = int(event["attacker_id"])
            target = int(event["target_id"])
            damage = int(event["damage"])
            timestamp = int(event.get("filetime_100ns", 0) or 0)
            if (
                damage <= 0
                or target not in damage_target_ids
                or not self._actor_counts_for_encounter(attacker)
            ):
                continue
            event_time = self._event_seconds(event)
            if not first or event_time < first:
                first = event_time
            last = max(last, event_time)
            skill_id = self.normalize_damage_skill_id(event.get("skill_id", 0))
            if not skill_id:
                skill_id = self.normalize_damage_skill_id(
                    event.get("arg4_u64", 0)
                )
            team_state = self.team_damage_states.get(attacker)
            if (
                team_state is not None
                and team_state.authoritative_snapshot
                and team_state.snapshot_time_100ns > 0
                and timestamp <= team_state.snapshot_time_100ns
            ):
                actor = team_snapshot_events.setdefault(
                    attacker, ActorStats(attacker)
                )
                raw_critical = event.get("critical")
                raw_penetrating = event.get("penetrating")
                actor.add(
                    damage,
                    event_time,
                    skill_id,
                    target,
                    (
                        bool(raw_critical)
                        if isinstance(raw_critical, bool)
                        else None
                    ),
                    (
                        bool(raw_penetrating)
                        if isinstance(raw_penetrating, bool)
                        else None
                    ),
                )
                continue
            actor = stats.setdefault(attacker, ActorStats(attacker))
            raw_critical = event.get("critical")
            raw_penetrating = event.get("penetrating")
            actor.add(
                damage,
                event_time,
                skill_id,
                target,
                (
                    bool(raw_critical)
                    if isinstance(raw_critical, bool)
                    else None
                ),
                (
                    bool(raw_penetrating)
                    if isinstance(raw_penetrating, bool)
                    else None
                ),
            )
        for actor_id, state in self.team_damage_states.items():
            if (
                state.accepted_damage <= 0
                or not self._actor_counts_for_encounter(actor_id)
            ):
                continue
            actor = stats.setdefault(actor_id, ActorStats(actor_id))
            observed = team_snapshot_events.get(actor_id)
            actor.damage += state.accepted_damage
            if observed is not None and observed.damage > 0:
                # Every amount in ``observed`` came from an exact damage
                # callback. Preserve those absolute amounts byte-for-byte.
                # The Common total does not contain enough information to
                # distribute its remainder among skills or targets, so it is
                # never used as a scaling factor.
                for skill_id, source in observed.skills.items():
                    skill = actor.skills.setdefault(skill_id, SkillStats(skill_id))
                    skill.damage += source.damage
                    skill.hits += source.hits
                    skill.max_hit = max(skill.max_hit, source.max_hit)
                    skill.first_time = (
                        min(skill.first_time, source.first_time)
                        if skill.first_time and source.first_time
                        else skill.first_time or source.first_time
                    )
                    skill.last_time = max(skill.last_time, source.last_time)
                for target_id, exact_damage in observed.target_damage.items():
                    actor.target_damage[target_id] = (
                        actor.target_damage.get(target_id, 0) + exact_damage
                    )
                actor.hits += observed.hits
                actor.max_hit = max(actor.max_hit, observed.max_hit)
                if observed.damage_hits is not None:
                    actor.damage_hits = (
                        (actor.damage_hits or 0) + observed.damage_hits
                    )
                    actor.critical_hits = (
                        (actor.critical_hits or 0)
                        + int(observed.critical_hits or 0)
                    )
                    if observed.penetration_hits is not None:
                        actor.penetration_hits = (
                            (actor.penetration_hits or 0)
                            + observed.penetration_hits
                        )
                if observed.first_time and (
                    not actor.first_time or observed.first_time < actor.first_time
                ):
                    actor.first_time = observed.first_time
                actor.last_time = max(actor.last_time, observed.last_time)

            # The positive difference is known only as an aggregate. Keeping
            # it under an explicit zero-ID row makes the skill sum reconcile
            # without changing a single known skill amount. If exact callbacks
            # exceed the Common total, retain the conflict for diagnostics;
            # silently shrinking exact skills would manufacture data.
            unclassified_damage = max(
                0,
                state.accepted_damage
                - (observed.damage if observed is not None else 0),
            )
            if unclassified_damage:
                aggregate = actor.skills.setdefault(0, SkillStats(0))
                aggregate.damage += unclassified_damage
                aggregate.first_time = (
                    min(aggregate.first_time, state.first_time)
                    if aggregate.first_time and state.first_time
                    else aggregate.first_time or state.first_time
                )
                aggregate.last_time = max(aggregate.last_time, state.last_time)
            if state.first_time and (
                not actor.first_time or state.first_time < actor.first_time
            ):
                actor.first_time = state.first_time
            actor.last_time = max(actor.last_time, state.last_time)
            if state.first_time and (not first or state.first_time < first):
                first = state.first_time
            last = max(last, state.last_time)
        for actor_id, (damage_hits, critical_hits) in self.stage_actor_metrics.items():
            actor = stats.get(actor_id)
            if actor is None or damage_hits <= 0 or critical_hits > damage_hits:
                continue
            actor.damage_hits = damage_hits
            actor.critical_hits = critical_hits
        for actor_id, (
            damage_hits,
            penetration_hits,
        ) in self.stage_actor_penetration_metrics.items():
            actor = stats.get(actor_id)
            if (
                actor is None
                or damage_hits <= 0
                or penetration_hits > damage_hits
            ):
                continue
            actor.damage_hits = damage_hits
            actor.penetration_hits = penetration_hits
        self._apply_stage_skill_snapshots(stats)
        for actor_id, pending in list(self.pending_stage_actor_taken.items()):
            actor_damage, taken, _summary_id, _timestamp = pending
            actor = stats.get(actor_id)
            if actor is None or actor.damage != actor_damage:
                continue
            self.stage_actor_taken[actor_id] = taken
            self.pending_stage_actor_taken.pop(actor_id, None)

        # Formal settlement rows are an immutable overlay for encounters where
        # passive capture did not expose the complete team.  Reapply them
        # after rebuilding local events/counters so a later harmless refresh
        # cannot drop the server participants from the final record.
        for actor_id, authoritative_actor in self.stage_authoritative_stats.items():
            if not self._actor_counts_for_encounter(actor_id):
                continue
            stats[actor_id] = deepcopy(authoritative_actor)
        self.stats = stats
        self._sync_stage_skill_snapshot_validation()
        if self.encounter_start_signal_100ns:
            # Reconciliation can run before the first positive team snapshot.
            # The shared Boss edge still owns the clock in that empty interval.
            shared_start = self._event_seconds(
                {"filetime_100ns": self.encounter_start_signal_100ns}
            )
            first = shared_start
            last = max(last, shared_start)
        self.first_damage_time = first
        self.last_damage_time = last
        self._rebuild_member_life_metrics()
        if self._is_dummy_encounter():
            visible_members = {
                actor_id
                for actor_id, actor in stats.items()
                if actor.damage > 0 and self._actor_counts_for_encounter(actor_id)
            }
            self.encounter_member_ids = visible_members
            self.encounter_team_size = len(visible_members)

    @staticmethod
    def _stage_skill_snapshot(
        summary_id: str,
        timestamp: int,
        raw_actor: dict,
    ) -> StageSkillSnapshot | None:
        try:
            actor_id = int(raw_actor.get("actor_id", 0) or 0)
            actor_damage = max(
                0,
                int(
                    raw_actor.get(
                        "detail_reported_damage",
                        raw_actor.get("damage", 0),
                    )
                    or 0
                ),
            )
        except (TypeError, ValueError, OverflowError):
            return None
        if actor_id <= 0 or actor_damage <= 0:
            return None
        parsed_skills: dict[int, tuple[int, int]] = {}
        for raw_skill in raw_actor.get("skills", []):
            if not isinstance(raw_skill, dict):
                continue
            try:
                skill_id = int(raw_skill.get("skill_id", 0) or 0)
                damage = max(0, int(raw_skill.get("damage", 0) or 0))
                hits = max(0, int(raw_skill.get("hits", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                continue
            if skill_id <= 0 or damage <= 0:
                continue
            previous_damage, previous_hits = parsed_skills.get(skill_id, (0, 0))
            parsed_skills[skill_id] = (
                previous_damage + damage,
                previous_hits + hits,
            )
        classified_damage = sum(
            damage for damage, _hits in parsed_skills.values()
        )
        if not parsed_skills or classified_damage > actor_damage:
            return None
        return StageSkillSnapshot(
            summary_id=summary_id,
            actor_id=actor_id,
            actor_damage=actor_damage,
            filetime_100ns=timestamp,
            skills=parsed_skills,
            unclassified_damage=actor_damage - classified_damage,
        )

    @staticmethod
    def _stage_healing_snapshot(
        summary_id: str,
        timestamp: int,
        raw_actor: dict,
    ) -> StageHealingSnapshot | None:
        try:
            actor_id = int(raw_actor.get("actor_id", 0) or 0)
            actor_damage = max(0, int(raw_actor.get("damage", 0) or 0))
            effective_healing = max(
                0, int(raw_actor.get("effective_healing", 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            return None
        if actor_id <= 0:
            return None
        parsed_skills: dict[int, int] = {}
        for raw_skill in raw_actor.get("healing_skills", []):
            if not isinstance(raw_skill, dict):
                continue
            try:
                skill_id = int(raw_skill.get("skill_id", 0) or 0)
                healing = max(
                    0, int(raw_skill.get("effective_healing", 0) or 0)
                )
            except (TypeError, ValueError, OverflowError):
                continue
            if skill_id <= 0 or healing <= 0:
                continue
            parsed_skills[skill_id] = parsed_skills.get(skill_id, 0) + healing
        classified_healing = sum(parsed_skills.values())
        if classified_healing > effective_healing:
            return None
        return StageHealingSnapshot(
            summary_id=summary_id,
            actor_id=actor_id,
            actor_damage=actor_damage,
            filetime_100ns=timestamp,
            effective_healing=effective_healing,
            skills=parsed_skills,
            unclassified_healing=effective_healing - classified_healing,
        )

    def active_stage_skill_snapshot(
        self,
        actor_id: int,
        actor: ActorStats | None = None,
    ) -> StageSkillSnapshot | None:
        snapshot = self.stage_skill_snapshots.get(int(actor_id))
        if snapshot is None:
            return None
        current = actor if actor is not None else self.stats.get(int(actor_id))
        if current is None or not self._stage_skill_snapshot_matches_damage(
            snapshot, current.damage
        ):
            return None
        return snapshot

    @staticmethod
    def _stage_skill_snapshot_matches_damage(
        snapshot: StageSkillSnapshot,
        common_damage: int,
    ) -> bool:
        """Match either the actor total or a complete classified breakdown."""
        common_damage = max(0, int(common_damage or 0))
        classified_damage = sum(
            damage for damage, _hits in snapshot.skills.values()
        )
        return bool(
            snapshot.actor_damage == common_damage
            or (
                snapshot.actor_damage > common_damage
                and classified_damage == common_damage
            )
        )

    def _apply_stage_skill_snapshots(
        self, stats: dict[int, ActorStats]
    ) -> None:
        for actor_id, snapshot in list(
            self.pending_stage_skill_snapshots.items()
        ):
            actor = stats.get(actor_id)
            if actor is None or not self._stage_skill_snapshot_matches_damage(
                snapshot, actor.damage
            ):
                continue
            self.stage_skill_snapshots[actor_id] = snapshot
            self.pending_stage_skill_snapshots.pop(actor_id, None)
        for actor_id, snapshot in self.stage_skill_snapshots.items():
            actor = stats.get(actor_id)
            if actor is None or not self._stage_skill_snapshot_matches_damage(
                snapshot, actor.damage
            ):
                continue
            exact_skills: dict[int, SkillStats] = {}
            for skill_id, (damage, hits) in snapshot.skills.items():
                exact_skills[skill_id] = SkillStats(
                    skill_id=skill_id,
                    damage=damage,
                    hits=hits,
                    max_hit=0,
                    first_time=actor.first_time,
                    last_time=actor.last_time,
                )
            classified_damage = sum(
                damage for damage, _hits in snapshot.skills.values()
            )
            common_unclassified_damage = max(
                0, actor.damage - classified_damage
            )
            if common_unclassified_damage > 0:
                exact_skills[0] = SkillStats(
                    skill_id=0,
                    damage=common_unclassified_damage,
                    hits=0,
                    max_hit=0,
                    first_time=actor.first_time,
                    last_time=actor.last_time,
                )
            actor.skills = exact_skills

    def _sync_stage_skill_snapshot_validation(self) -> None:
        """Record which cached settlement rows are active or still waiting.

        A settlement can reach the client just before the last Common team
        snapshot. Keep that row pending until either its actor total matches,
        or its classified skills exactly explain the immutable Common total.
        """
        active_by_summary: dict[str, list[int]] = {}
        pending_by_summary: dict[str, list[int]] = {}
        for actor_id, snapshot in self.stage_skill_snapshots.items():
            actor = self.stats.get(actor_id)
            if actor is not None and self._stage_skill_snapshot_matches_damage(
                snapshot, actor.damage
            ):
                active_by_summary.setdefault(snapshot.summary_id, []).append(
                    actor_id
                )
        for actor_id, snapshot in self.pending_stage_skill_snapshots.items():
            pending_by_summary.setdefault(snapshot.summary_id, []).append(actor_id)
        for summary_id, summary in self.stage_summaries.items():
            validation = summary.get("validation")
            if not isinstance(validation, dict):
                continue
            validation["server_skill_actor_ids"] = sorted(
                active_by_summary.get(summary_id, [])
            )
            validation["pending_server_skill_actor_ids"] = sorted(
                pending_by_summary.get(summary_id, [])
            )

    def _apply_authoritative_stage_summary_fallback(
        self,
        *,
        summary_id: str,
        timestamp: int,
        raw_summary_actors: list[dict],
        summary_damage_by_actor: dict[int, int],
        summary_total: int,
        member_count: int,
        authoritative: bool,
        completion_confirmed: bool,
        damage_context: bool,
        end_snapshot: bool,
        encounter_concluded: bool,
        summary_delay: float,
        self_plausible: bool,
        confirmed_multiphase_completion: bool,
    ) -> tuple[bool, str, dict[str, object]]:
        """Use a final server table only when live team data is incomplete.

        Passive capture may provide exact local callbacks while the game's
        completion table is the only source containing the other players.
        This path deliberately does not run for mid-fight/partial tables and
        never replaces a complete live roster.  The resulting ActorStats are
        kept in a separate overlay and reapplied by ``_recompute``.
        """

        observed_positive_ids = {
            actor_id
            for actor_id, actor in self.stats.items()
            if actor.damage > 0 and self._actor_counts_for_encounter(actor_id)
        }
        summary_positive_ids = {
            actor_id for actor_id, damage in summary_damage_by_actor.items()
            if damage > 0
        }
        missing_ids = sorted(summary_positive_ids - observed_positive_ids)
        completeness = {
            "summary_positive_actor_count": len(summary_positive_ids),
            "realtime_positive_actor_count": len(observed_positive_ids),
            "missing_actor_ids": missing_ids,
            "summary_member_count": max(0, int(member_count or 0)),
            "realtime_member_count": len(observed_positive_ids),
        }
        reason = ""
        if not authoritative or not completion_confirmed:
            reason = "not_formal_completion"
        elif not damage_context:
            reason = "no_damage_context"
        elif not end_snapshot or not encounter_concluded:
            reason = "encounter_not_concluded"
        elif not math.isfinite(summary_delay) or summary_delay < -1.0:
            reason = "summary_before_encounter"
        elif (
            self.first_damage_time
            and self._event_seconds({"filetime_100ns": timestamp})
            < self.first_damage_time - 2.0
        ):
            reason = "summary_belongs_to_older_encounter"
        elif self._multiphase_encounter() and not confirmed_multiphase_completion:
            reason = "unconfirmed_multiphase_completion"
        elif not summary_positive_ids or summary_total <= 0:
            reason = "empty_summary"
        elif not self_plausible:
            reason = "self_damage_mismatch"
        elif not missing_ids and len(observed_positive_ids) >= len(summary_positive_ids):
            reason = "realtime_roster_complete"

        if reason:
            return False, reason, completeness

        # A newer final table wins, while an older duplicate cannot roll back
        # the already applied authoritative rows.
        if timestamp < int(self.stage_authoritative_summary_time_100ns or 0):
            return False, "older_than_applied_summary", completeness

        summary_time = self._event_seconds({"filetime_100ns": timestamp})
        target_id = int(self.combat_target_id or 0)
        next_stats: dict[int, ActorStats] = {}
        accepted_ids: set[int] = set()
        for raw_actor in raw_summary_actors:
            try:
                actor_id = int(raw_actor.get("actor_id", 0) or 0)
                damage = max(0, int(raw_actor.get("damage", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                continue
            if actor_id <= 0 or damage <= 0 or actor_id not in summary_damage_by_actor:
                continue
            if not self._actor_counts_for_encounter(actor_id):
                continue
            accepted_ids.add(actor_id)
            existing = self.stats.get(actor_id)
            actor = ActorStats(actor_id)
            actor.damage = damage
            actor.first_time = (
                existing.first_time if existing is not None and existing.first_time
                else self.first_damage_time or summary_time
            )
            actor.last_time = max(
                summary_time,
                existing.last_time if existing is not None else 0.0,
            )
            raw_skills = raw_actor.get("skills", [])
            classified = 0
            if isinstance(raw_skills, list):
                for raw_skill in raw_skills:
                    if not isinstance(raw_skill, dict):
                        continue
                    try:
                        skill_id = self.normalize_damage_skill_id(
                            raw_skill.get("skill_id", 0)
                        )
                        skill_damage = max(
                            0, int(raw_skill.get("damage", 0) or 0)
                        )
                        hits = max(0, int(raw_skill.get("hits", 0) or 0))
                    except (TypeError, ValueError, OverflowError):
                        continue
                    if skill_id <= 0 or skill_damage <= 0:
                        continue
                    skill = actor.skills.setdefault(skill_id, SkillStats(skill_id))
                    skill.damage += skill_damage
                    skill.hits += hits
                    skill.max_hit = max(skill.max_hit, skill_damage)
                    skill.first_time = actor.first_time
                    skill.last_time = actor.last_time
                    classified += skill_damage
            # Keep exact local skill detail for a self row when the settlement
            # omits its skill map; the server total still remains authoritative.
            if not actor.skills and existing is not None and actor_id == self.self_id:
                actor.skills = deepcopy(existing.skills)
                classified = sum(
                    max(0, int(skill.damage or 0))
                    for skill_id, skill in actor.skills.items()
                    if int(skill_id or 0) != 0
                )
                actor.hits = existing.hits
                actor.max_hit = existing.max_hit
            unclassified = max(0, damage - classified)
            if unclassified:
                aggregate = actor.skills.setdefault(0, SkillStats(0))
                aggregate.damage += unclassified
                aggregate.first_time = actor.first_time
                aggregate.last_time = actor.last_time
            actor.hits = max(actor.hits, sum(skill.hits for skill in actor.skills.values()))
            actor.max_hit = max(
                actor.max_hit,
                max((skill.max_hit for skill in actor.skills.values()), default=0),
            )
            try:
                damage_hits = max(0, int(raw_actor.get("damage_hits", 0) or 0))
                critical_hits = max(0, int(raw_actor.get("critical_hits", 0) or 0))
                penetration_hits = max(0, int(raw_actor.get("penetration_hits", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                damage_hits = critical_hits = penetration_hits = 0
            if damage_hits > 0 and critical_hits <= damage_hits:
                actor.damage_hits = damage_hits
                actor.critical_hits = critical_hits
            if damage_hits > 0 and penetration_hits <= damage_hits:
                actor.penetration_hits = penetration_hits
            if target_id:
                actor.target_damage[target_id] = damage
            next_stats[actor_id] = actor

            # Settlement rows are also a reliable identity refresh.  Do this
            # only for fields explicitly present so a sparse row cannot erase
            # a previously resolved profile.
            name = str(raw_actor.get("name", "") or "").strip()
            if name:
                self.entity_names[actor_id] = name[:64]
            try:
                profession_id = int(raw_actor.get("profession_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                profession_id = 0
            if profession_id > 0:
                self.entity_professions[actor_id] = profession_id
            if "is_ai" in raw_actor:
                self.entity_ai_states[actor_id] = bool(raw_actor.get("is_ai"))

        if not next_stats or not accepted_ids:
            return False, "no_encounter_actors", completeness

        self.stage_authoritative_stats = next_stats
        self.stage_authoritative_summary_id = summary_id
        self.stage_authoritative_summary_time_100ns = timestamp
        self.encounter_member_ids.update(accepted_ids)
        self.encounter_team_size = min(
            MAX_PARTY_MEMBERS,
            max(
                self.encounter_team_size,
                len(accepted_ids),
                int(member_count or 0),
            ),
        )
        for actor_id in sorted(accepted_ids):
            if actor_id not in self.friend_order:
                self.friend_order.append(actor_id)
        self._recompute()
        completeness["accepted_actor_count"] = len(next_stats)
        completeness["server_total_damage"] = int(summary_total)
        return True, "realtime_roster_incomplete", completeness

    def ingest_stage_summary(self, update: dict) -> bool:
        summary_id = str(update.get("summary_id", "")).strip()
        authoritative = bool(update.get("authoritative"))
        completion_confirmed = bool(update.get("completion_confirmed"))
        realtime_detail = bool(update.get("realtime_detail"))
        player_detail_query = bool(update.get("player_detail_query"))
        try:
            timestamp = int(update.get("filetime_100ns", 0) or 0)
            member_count = max(0, int(update.get("member_count", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            return False
        if not summary_id or timestamp <= 0:
            return False
        if self.long_gap_phase_suspended:
            return False
        previous_summary = self.stage_summaries.get(summary_id)
        if realtime_detail:
            try:
                previous_timestamp = int(
                    (previous_summary or {}).get("filetime_100ns", 0) or 0
                )
            except (TypeError, ValueError, OverflowError):
                previous_timestamp = 0
            if previous_timestamp >= timestamp:
                return False
            self.seen_stage_summary_ids.discard(summary_id)
            self.rejected_stage_summary_ids.discard(summary_id)
        elif (
            summary_id in self.seen_stage_summary_ids
            or summary_id in self.rejected_stage_summary_ids
        ):
            return False

        raw_summary_actors = [
            raw_actor
            for raw_actor in update.get("actors", [])
            if isinstance(raw_actor, dict)
        ]
        profile_metadata_changed = False
        for raw_actor in raw_summary_actors:
            try:
                actor_id = int(raw_actor.get("actor_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                continue
            if actor_id <= 0:
                continue
            if "is_ai" in raw_actor:
                is_ai = bool(raw_actor.get("is_ai"))
                if (
                    actor_id not in self.entity_ai_states
                    or self.entity_ai_states[actor_id] != is_ai
                ):
                    self.entity_ai_states[actor_id] = is_ai
                    profile_metadata_changed = True
            profession_id = _parsed_profession_id(
                raw_actor.get("profession_id", 0)
            )
            if not profession_id:
                continue
            if self.entity_professions.get(actor_id) != profession_id:
                self.entity_professions[actor_id] = profession_id
                profile_metadata_changed = True
            if profession_id not in HEALER_PROFESSION_IDS:
                if self.stage_healing_snapshots.pop(actor_id, None) is not None:
                    profile_metadata_changed = True
        if profile_metadata_changed:
            self.healing_revision += 1
            self.healing_summary_cache_key = None
            self.healing_summary_cache = None

        summary_has_healing = False
        for raw_actor in raw_summary_actors:
            try:
                actor_id = int(raw_actor.get("actor_id", 0) or 0)
                has_effective_healing = (
                    int(raw_actor.get("effective_healing", 0) or 0) > 0
                )
                if (
                    actor_id > 0
                    and has_effective_healing
                    and self._healing_actor_allowed(
                        actor_id, raw_actor.get("profession_id", 0)
                    )
                ):
                    summary_has_healing = True
                    break
            except (TypeError, ValueError, OverflowError):
                continue
        damage_context = bool(
            self.first_damage_time and self._encounter_damage_target_ids()
        )
        pure_healing_context = bool(
            not damage_context
            and self.healing_target_ids
            and (self.first_healing_time or summary_has_healing)
        )
        if not damage_context and not pure_healing_context:
            self.rejected_stage_summary_ids.add(summary_id)
            return False

        summary_total = 0
        summary_actor_ids: set[int] = set()
        summary_healing_actor_ids: set[int] = set()
        summary_damage_by_actor: dict[int, int] = {}
        current_members = self._current_member_ids()
        for raw_actor in raw_summary_actors:
            try:
                actor_id = int(raw_actor.get("actor_id", 0) or 0)
                damage = max(0, int(raw_actor.get("damage", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                continue
            if actor_id <= 0:
                continue
            if pure_healing_context:
                if actor_id not in current_members:
                    continue
                try:
                    if (
                        int(raw_actor.get("effective_healing", 0) or 0) > 0
                        and self._healing_actor_allowed(
                            actor_id, raw_actor.get("profession_id", 0)
                        )
                    ):
                        summary_healing_actor_ids.add(actor_id)
                except (TypeError, ValueError, OverflowError):
                    pass
            elif not self._actor_counts_for_encounter(actor_id):
                continue
            summary_damage_by_actor[actor_id] = damage
            summary_total += damage
            if damage > 0:
                summary_actor_ids.add(actor_id)
        if pure_healing_context and not summary_healing_actor_ids:
            self.rejected_stage_summary_ids.add(summary_id)
            return False
        summary_time = self._event_seconds({"filetime_100ns": timestamp})
        if not math.isfinite(summary_time):
            self.rejected_stage_summary_ids.add(summary_id)
            return False
        if pure_healing_context and summary_healing_actor_ids:
            if not self.first_healing_time:
                self.first_healing_time = summary_time
            else:
                self.first_healing_time = min(self.first_healing_time, summary_time)
            self.last_healing_time = max(self.last_healing_time, summary_time)
            self.healing_revision += 1
            self.healing_summary_cache_key = None
            self.healing_summary_cache = None
        observed_total = sum(actor.damage for actor in self.stats.values())
        encounter_edge = (
            (self.combat_end_time or self.last_damage_time)
            if damage_context
            else (self.healing_end_time or self.last_healing_time)
        )
        summary_delay = (
            summary_time - encounter_edge if encounter_edge else float("inf")
        )
        observed_actor_ids = {
            actor_id for actor_id, actor in self.stats.items() if actor.damage > 0
        }
        observed_damage_by_actor = {
            actor_id: int(actor.damage)
            for actor_id, actor in self.stats.items()
        }
        actor_overlap = summary_actor_ids.intersection(observed_actor_ids)
        total_tolerance = max(
            STAGE_SUMMARY_TOTAL_TOLERANCE_ABSOLUTE,
            round(
                max(summary_total, observed_total)
                * STAGE_SUMMARY_TOTAL_TOLERANCE_RATIO
            ),
        )
        total_plausible = (
            bool(
                summary_total > 0
                and observed_total > 0
                and abs(summary_total - observed_total) <= total_tolerance
                and min(summary_total, observed_total)
                >= max(summary_total, observed_total) * 0.5
            )
            if damage_context
            else bool(summary_healing_actor_ids)
        )
        self_plausible = True
        if (
            damage_context
            and self.self_id is not None
            and self.self_id in summary_damage_by_actor
        ):
            observed_self = self.stats.get(self.self_id)
            observed_self_damage = observed_self.damage if observed_self else 0
            summary_self_damage = summary_damage_by_actor[self.self_id]
            self_tolerance = max(
                STAGE_SUMMARY_SELF_DAMAGE_TOLERANCE,
                round(max(observed_self_damage, summary_self_damage) * 0.10),
            )
            self_plausible = (
                abs(summary_self_damage - observed_self_damage) <= self_tolerance
            )
        final_window = (
            STAGE_SUMMARY_CONFIRMED_FINAL_WINDOW_SECONDS
            if completion_confirmed
            else STAGE_SUMMARY_FINAL_WINDOW_SECONDS
        )
        end_snapshot = bool(
            0 <= summary_delay <= final_window
            and (
                (
                    authoritative
                    or self.combat_end_time
                    or self._target_hp_depleted()
                    or summary_delay >= self._encounter_idle_timeout()
                )
                if damage_context
                else (
                    authoritative
                    or completion_confirmed
                    or summary_delay >= self.idle_gap
                )
            )
        )
        exact_snapshot = bool(
            damage_context
            and summary_total > 0
            and actor_overlap
            and self_plausible
            and end_snapshot
            and (authoritative or total_plausible)
        )

        summary_covers_observed = observed_actor_ids.issubset(
            summary_damage_by_actor
        )
        comparison_actor_ids = sorted(
            set(summary_damage_by_actor) | observed_actor_ids
        )
        actor_differences = [
            {
                "actor_id": actor_id,
                "name": self.display_name(actor_id),
                "realtime_damage": observed_damage_by_actor.get(actor_id, 0),
                "summary_damage": int(summary_damage_by_actor.get(actor_id, 0)),
                "difference": int(summary_damage_by_actor.get(actor_id, 0))
                - observed_damage_by_actor.get(actor_id, 0),
            }
            for actor_id in comparison_actor_ids
        ]
        per_actor_exact_match = bool(
            actor_differences
            and summary_covers_observed
            and all(not row["difference"] for row in actor_differences)
        )
        wipe_detail_snapshot = bool(
            not authoritative
            and not completion_confirmed
            and not realtime_detail
            and self.combat_end_reason == "party_wipe"
            and member_count >= 2
            and len(actor_overlap) >= 2
            and summary_total > 0
            and summary_total == observed_total
            and end_snapshot
            and per_actor_exact_match
        )
        authoritative_total_plausible = bool(
            damage_context
            and summary_total > 0
            and observed_total > 0
            and min(summary_total, observed_total)
            >= max(summary_total, observed_total) * 0.5
        )
        encounter_concluded = bool(
            (self.combat_end_time or self._target_hp_depleted())
            if damage_context
            else (self.healing_end_time or completion_confirmed)
        )
        confirmed_multiphase_completion = bool(
            self._multiphase_encounter()
            and completion_confirmed
            and self._target_hp_depleted()
        )
        would_allow_legacy_correction = bool(
            damage_context
            and authoritative
            and end_snapshot
            and encounter_concluded
            and (
                not self._multiphase_encounter()
                or confirmed_multiphase_completion
            )
            and summary_covers_observed
            and self_plausible
            and authoritative_total_plausible
        )

        server_data_used, server_data_reason, realtime_completeness = (
            self._apply_authoritative_stage_summary_fallback(
                summary_id=summary_id,
                timestamp=timestamp,
                raw_summary_actors=raw_summary_actors,
                summary_damage_by_actor=summary_damage_by_actor,
                summary_total=summary_total,
                member_count=member_count,
                authoritative=authoritative,
                completion_confirmed=completion_confirmed,
                damage_context=damage_context,
                end_snapshot=end_snapshot,
                encounter_concluded=encounter_concluded,
                summary_delay=summary_delay,
                self_plausible=self_plausible,
                confirmed_multiphase_completion=confirmed_multiphase_completion,
            )
        )

        # Keep the full comparison in the record even when the formal table
        # becomes the final source.  This makes every correction auditable.
        validation_update = dict(update)
        validation_update["validation_only"] = not server_data_used
        validation_update["exact_for_encounter"] = bool(server_data_used)
        validation_update["validation"] = {
            "summary_total": summary_total,
            "observed_total": observed_total,
            "difference": summary_total - observed_total,
            "absolute_difference": abs(summary_total - observed_total),
            "total_tolerance": total_tolerance,
            "total_plausible": total_plausible,
            "damage_context": damage_context,
            "pure_healing_context": pure_healing_context,
            "summary_healing_actor_count": len(summary_healing_actor_ids),
            "self_plausible": self_plausible,
            "actor_overlap_count": len(actor_overlap),
            "summary_delay_seconds": (
                None
                if summary_delay == float("inf")
                else round(summary_delay, 6)
            ),
            "end_snapshot": end_snapshot,
            "would_have_matched": exact_snapshot,
            "summary_covers_observed": summary_covers_observed,
            "authoritative_total_plausible": authoritative_total_plausible,
            "encounter_concluded": encounter_concluded,
            "confirmed_multiphase_completion": confirmed_multiphase_completion,
            "would_allow_legacy_correction": would_allow_legacy_correction,
            "damage_correction_applied": bool(server_data_used),
            "server_data_used": bool(server_data_used),
            "server_data_reason": server_data_reason,
            "realtime_data_completeness": realtime_completeness,
            "per_actor_exact_match": per_actor_exact_match,
            "actor_differences": actor_differences,
            "wipe_detail_confirmed": wipe_detail_snapshot,
        }
        self.stage_summaries[summary_id] = validation_update

        if summary_time <= self.stage_summary_guard_until or (
            not pure_healing_context
            and not authoritative
            and end_snapshot
            and not total_plausible
        ):
            self.rejected_stage_summary_ids.add(summary_id)
            self._queue_current_record_refresh()
            return False

        team_duration, team_duration_policy, member_seconds = (
            authoritative_team_combat_seconds(raw_summary_actors)
        )
        local_event_duration = (
            max(1.0, self.last_damage_time - self.first_damage_time)
            if damage_context
            else 0.0
        )
        clock_damage_tolerance = max(
            STAGE_SUMMARY_TOTAL_TOLERANCE_ABSOLUTE,
            round(max(summary_total, observed_total) * 0.01),
        )
        clock_matches_encounter = bool(
            authoritative
            and completion_confirmed
            and damage_context
            and end_snapshot
            and summary_covers_observed
            and self_plausible
            and actor_overlap
            and (
                abs(summary_total - observed_total) <= clock_damage_tolerance
                or server_data_used
            )
        )
        # The game's final settlement is the primary clock.  The local event
        # span is retained for audit only: different party members can enter,
        # die, or emit their first captured damage at different moments, so a
        # local edge comparison must never veto a correctly matched settlement
        # table.
        local_interval_covers_observed_span = bool(
            team_duration
            and combat_clock_covers_local_span(
                team_duration, local_event_duration
            )
        )
        phase_clock_covers_encounter = settlement_clock_covers_boss_phases(
            (getattr(self.monsters.get(target_id), 'template_id', 0)
             for target_id in self._encounter_damage_target_ids()),
            team_duration, local_event_duration,
        )
        clock_accepted = bool(
            clock_matches_encounter
            and team_duration
            and (
                phase_clock_covers_encounter
                or (server_data_used and local_interval_covers_observed_span)
            )
        )
        clock_audit = {
            "duration_seconds": team_duration,
            "policy": team_duration_policy,
            "member_seconds": sorted(member_seconds, reverse=True),
            "local_event_duration_seconds": local_event_duration,
            "difference_seconds": (
                abs(team_duration - local_event_duration)
                if team_duration and local_event_duration
                else None
            ),
            "damage_tolerance": clock_damage_tolerance,
            "matches_encounter": clock_matches_encounter,
            "local_interval_covers_observed_span": (
                local_interval_covers_observed_span
            ),
            "local_comparison_used_for_acceptance": not phase_clock_covers_encounter,
            "phase_clock_covers_encounter": phase_clock_covers_encounter,
            "accepted": clock_accepted,
        }
        validation_update["validation"]["game_server_team_clock"] = clock_audit
        if clock_accepted:
            self.game_server_duration_seconds = team_duration
            self.game_server_duration_summary_id = summary_id
            self.game_server_duration_policy = team_duration_policy
            self.game_server_duration_member_seconds = sorted(
                member_seconds, reverse=True
            )
            self.game_server_duration_local_seconds = local_event_duration
            self.game_server_duration_difference_seconds = abs(
                team_duration - local_event_duration
            )
            self.game_server_duration_rejection = {}
        elif authoritative and completion_confirmed and damage_context:
            self.game_server_duration_rejection = {
                "summary_id": summary_id,
                **clock_audit,
                "reason": (
                    "phase_clock_shorter_than_observed_encounter"
                    if not phase_clock_covers_encounter
                    else "missing_team_combat_seconds"
                    if clock_matches_encounter and not team_duration
                    else "settlement_not_matched_to_current_encounter"
                ),
                "fallback_coverage_rule": (
                    "not_shorter_than_local_observed_damage_span"
                ),
            }

        skill_snapshots_changed = False
        applied_skill_actor_ids: list[int] = []
        midfight_summary = bool(
            not authoritative
            and damage_context
            and self.first_damage_time
            and summary_time >= self.first_damage_time
            and -0.5 <= summary_delay <= 8.0
        )
        snapshot_eligible = bool(
            (
                end_snapshot
                and (authoritative or completion_confirmed)
            )
            or midfight_summary
            or (pure_healing_context and summary_has_healing)
        )
        skill_snapshot_eligible = bool(
            snapshot_eligible or wipe_detail_snapshot
        )
        if skill_snapshot_eligible:
            for raw_actor in update.get("actors", []):
                if not isinstance(raw_actor, dict):
                    continue
                snapshot = self._stage_skill_snapshot(
                    summary_id, timestamp, raw_actor
                )
                if snapshot is None or snapshot.actor_id == self.self_id:
                    continue
                if pure_healing_context and snapshot.actor_id not in current_members:
                    continue
                observed_actor = self.stats.get(snapshot.actor_id)
                if observed_actor is None or not self._actor_counts_for_encounter(
                    snapshot.actor_id
                ):
                    continue
                if self._stage_skill_snapshot_matches_damage(
                    snapshot, observed_actor.damage
                ):
                    if self.stage_skill_snapshots.get(snapshot.actor_id) != snapshot:
                        self.stage_skill_snapshots[snapshot.actor_id] = snapshot
                        skill_snapshots_changed = True
                    if self.pending_stage_skill_snapshots.pop(
                        snapshot.actor_id, None
                    ) is not None:
                        skill_snapshots_changed = True
                    applied_skill_actor_ids.append(snapshot.actor_id)
                else:
                    # Do not discard a valid settlement row merely because
                    # the final Common snapshot is still in flight.  Keep the
                    # last reconciled snapshot active until this newer row
                    # passes an actor-local reconciliation check.
                    if (
                        self.pending_stage_skill_snapshots.get(snapshot.actor_id)
                        != snapshot
                    ):
                        self.pending_stage_skill_snapshots[
                            snapshot.actor_id
                        ] = snapshot
                        skill_snapshots_changed = True
        validation_update["validation"]["server_skill_actor_ids"] = sorted(
            set(applied_skill_actor_ids)
        )
        validation_update["validation"]["pending_server_skill_actor_ids"] = sorted(
            actor_id
            for actor_id, snapshot in self.pending_stage_skill_snapshots.items()
            if snapshot.summary_id == summary_id
            and actor_id not in applied_skill_actor_ids
        )

        taken_changed = False
        applied_taken_actor_ids: list[int] = []
        if snapshot_eligible and damage_context:
            for raw_actor in update.get("actors", []):
                if not isinstance(raw_actor, dict) or not raw_actor.get(
                    "taken_present", False
                ):
                    continue
                try:
                    actor_id = int(raw_actor.get("actor_id", 0) or 0)
                    actor_damage = max(
                        0, int(raw_actor.get("damage", 0) or 0)
                    )
                    taken = max(0, int(raw_actor.get("taken", 0) or 0))
                except (TypeError, ValueError, OverflowError):
                    continue
                observed_actor = self.stats.get(actor_id)
                verified_zero_damage_member = bool(
                    observed_actor is None
                    and actor_damage == 0
                    and actor_id in current_members
                )
                if (
                    actor_id <= 0
                    or (observed_actor is None and not verified_zero_damage_member)
                    or not self._actor_counts_for_encounter(actor_id)
                ):
                    continue
                observed_damage = observed_actor.damage if observed_actor else 0
                if observed_damage == actor_damage:
                    if self.stage_actor_taken.get(actor_id) != taken:
                        self.stage_actor_taken[actor_id] = taken
                        taken_changed = True
                    if self.pending_stage_actor_taken.pop(actor_id, None) is not None:
                        taken_changed = True
                    applied_taken_actor_ids.append(actor_id)
                else:
                    pending = (actor_damage, taken, summary_id, timestamp)
                    if self.pending_stage_actor_taken.get(actor_id) != pending:
                        self.pending_stage_actor_taken[actor_id] = pending
                        taken_changed = True
        validation_update["validation"]["server_taken_actor_ids"] = sorted(
            set(applied_taken_actor_ids)
        )
        validation_update["validation"]["pending_server_taken_actor_ids"] = sorted(
            actor_id
            for actor_id, pending in self.pending_stage_actor_taken.items()
            if pending[2] == summary_id and actor_id not in applied_taken_actor_ids
        )

        healing_snapshots_changed = False
        applied_healing_actor_ids: list[int] = []
        if snapshot_eligible:
            for raw_actor in update.get("actors", []):
                if not isinstance(raw_actor, dict):
                    continue
                healing_snapshot = self._stage_healing_snapshot(
                    summary_id, timestamp, raw_actor
                )
                if healing_snapshot is None or not self._actor_counts_for_encounter(
                    healing_snapshot.actor_id
                ):
                    continue
                if not self._healing_actor_allowed(
                    healing_snapshot.actor_id,
                    raw_actor.get("profession_id", 0),
                ):
                    self.stage_healing_snapshots.pop(
                        healing_snapshot.actor_id, None
                    )
                    continue
                if pure_healing_context and healing_snapshot.actor_id not in current_members:
                    continue
                observed_actor = self.stats.get(healing_snapshot.actor_id)
                observed_damage = int(
                    observed_actor.damage if observed_actor is not None else 0
                )
                if observed_damage != healing_snapshot.actor_damage:
                    continue
                if (
                    self.stage_healing_snapshots.get(healing_snapshot.actor_id)
                    != healing_snapshot
                ):
                    self.stage_healing_snapshots[
                        healing_snapshot.actor_id
                    ] = healing_snapshot
                    healing_snapshots_changed = True
                if healing_snapshot.effective_healing > 0:
                    applied_healing_actor_ids.append(healing_snapshot.actor_id)
        validation_update["validation"]["server_healing_actor_ids"] = sorted(
            set(applied_healing_actor_ids)
        )

        metrics_changed = False
        final_metrics_snapshot = bool(
            damage_context
            and end_snapshot
            and (
                (
                    snapshot_eligible
                    and (authoritative or completion_confirmed)
                )
                or wipe_detail_snapshot
            )
        )
        if midfight_summary or final_metrics_snapshot:
            active_actor_ids = set(self.stats)
            for raw_actor in update.get("actors", []):
                if not isinstance(raw_actor, dict):
                    continue
                try:
                    actor_id = int(raw_actor.get("actor_id", 0) or 0)
                    damage = max(0, int(raw_actor.get("damage", 0) or 0))
                except (TypeError, ValueError, OverflowError):
                    continue
                if (
                    not actor_id
                    or (player_detail_query and actor_id == self.self_id)
                    or damage <= 0
                    or actor_id not in active_actor_ids
                    or not self._actor_counts_for_encounter(actor_id)
                ):
                    continue
                observed_damage = self.stats[actor_id].damage
                metric_detail_matches = damage == observed_damage
                if not metric_detail_matches:
                    metric_snapshot = self._stage_skill_snapshot(
                        summary_id, timestamp, raw_actor
                    )
                    metric_detail_matches = bool(
                        metric_snapshot is not None
                        and self._stage_skill_snapshot_matches_damage(
                            metric_snapshot, observed_damage
                        )
                    )
                if (
                    realtime_detail
                    and not metric_detail_matches
                ):
                    continue
                if final_metrics_snapshot and not metric_detail_matches:
                    continue
                raw_hits = raw_actor.get("damage_hits")
                raw_critical = raw_actor.get("critical_hits")
                if raw_hits is not None and raw_critical is not None:
                    try:
                        damage_hits = max(0, int(raw_hits))
                        critical_hits = max(0, int(raw_critical))
                    except (TypeError, ValueError, OverflowError):
                        damage_hits = 0
                        critical_hits = 0
                    if damage_hits > 0 and critical_hits <= damage_hits:
                        metrics = (damage_hits, critical_hits)
                        if self.stage_actor_metrics.get(actor_id) != metrics:
                            self.stage_actor_metrics[actor_id] = metrics
                            metrics_changed = True
                raw_penetration = raw_actor.get("penetration_hits")
                if raw_hits is not None and raw_penetration is not None:
                    try:
                        damage_hits = max(0, int(raw_hits))
                        penetration_hits = max(0, int(raw_penetration))
                    except (TypeError, ValueError, OverflowError):
                        damage_hits = 0
                        penetration_hits = 0
                    if (
                        damage_hits > 0
                        and penetration_hits <= damage_hits
                    ):
                        penetration_metrics = (
                            damage_hits,
                            penetration_hits,
                        )
                        if (
                            self.stage_actor_penetration_metrics.get(actor_id)
                            != penetration_metrics
                        ):
                            self.stage_actor_penetration_metrics[actor_id] = (
                                penetration_metrics
                            )
                            metrics_changed = True
                # Stage rows can retain deaths from earlier pulls. Deaths are
                # therefore always counted from live life-state transitions.
        if (
            skill_snapshots_changed
            or taken_changed
            or healing_snapshots_changed
            or metrics_changed
        ):
            self.healing_revision += 1 if healing_snapshots_changed else 0
            self.healing_summary_cache_key = None
            self.healing_summary_cache = None
            self._recompute()
            self._queue_current_record_refresh()

        if (
            pure_healing_context
            and (completion_confirmed or summary_delay >= self.idle_gap)
            and self.last_healing_time
        ):
            self.healing_end_time = max(self.last_healing_time, summary_time)
            self.healing_end_reason = "target_defeated" if completion_confirmed else "idle"

        # Mid-fight stage rows may supply crit counters. A validated final
        # settlement may also have reconciled the damage totals above.
        self.seen_stage_summary_ids.add(summary_id)
        self.latest_network_time_100ns = max(self.latest_network_time_100ns, timestamp)
        self._queue_current_record_refresh()
        return True

    @staticmethod
    def _normalize_member_life_transitions(
        transitions: list[tuple[int, bool]],
    ) -> list[tuple[int, bool]]:
        ordered: list[tuple[int, bool]] = []
        for raw_timestamp, raw_dead in sorted(
            transitions, key=lambda item: int(item[0] or 0)
        ):
            timestamp = int(raw_timestamp or 0)
            if not timestamp:
                continue
            dead = bool(raw_dead)
            if ordered and ordered[-1][1] == dead:
                continue
            ordered.append((timestamp, dead))
        return ordered[-MEMBER_LIFE_TRANSITION_LIMIT:]

    def _merge_member_life_transitions(
        self, old_actor: int, new_actor: int
    ) -> bool:
        previous = self.member_life_transitions.pop(old_actor, [])
        if not previous:
            return False
        current = self.member_life_transitions.get(new_actor, [])
        self.member_life_transitions[new_actor] = (
            self._normalize_member_life_transitions([*previous, *current])
        )
        return True

    def _merge_pending_sun_death(self, old_actor: int, new_actor: int) -> bool:
        pending = self.pending_sun_deaths.pop(old_actor, None)
        if pending is None:
            return False
        current = self.pending_sun_deaths.get(new_actor)
        if current is None:
            self.pending_sun_deaths[new_actor] = pending
        else:
            self.pending_sun_deaths[new_actor] = PendingMemberDeath(
                timestamp_100ns=min(
                    pending.timestamp_100ns,
                    current.timestamp_100ns,
                ),
                deadline_monotonic=min(
                    pending.deadline_monotonic,
                    current.deadline_monotonic,
                ),
            )
        return True

    def _apply_member_life_transition(
        self,
        actor_id: int,
        timestamp: int,
        dead: bool,
    ) -> bool:
        if (
            actor_id not in self._current_member_ids()
            or timestamp < self.member_life_times.get(actor_id, 0)
        ):
            return False
        previous_dead = self.member_death_states.get(actor_id)
        changed = previous_dead != dead
        self.member_death_states[actor_id] = dead
        self.member_life_times[actor_id] = timestamp
        if changed:
            self.pending_health_drops.pop(actor_id, None)
            self.healing_response_keys = {
                key for key in self.healing_response_keys if key[0] != actor_id
            }
            transitions = self.member_life_transitions.setdefault(actor_id, [])
            transitions.append((timestamp, dead))
            self.member_life_transitions[actor_id] = (
                self._normalize_member_life_transitions(transitions)
            )
            self._rebuild_member_life_metrics()
        event_time = self._event_seconds({"filetime_100ns": timestamp})
        wiped = self._mark_party_wipe_if_complete(event_time)
        if changed and self.combat_end_time and not wiped:
            self._queue_current_record_refresh()
        return changed or wiped

    @staticmethod
    def _sun_survival_hp(value: object) -> bool:
        try:
            current_hp = float(value)
        except (TypeError, ValueError, OverflowError):
            return False
        return bool(
            math.isfinite(current_hp)
            and abs(current_hp - SUN_SURVIVAL_HP) <= 0.01
        )

    def _resolve_sun_survival(
        self,
        actor_id: int,
        timestamp: int,
        current_hp: object,
    ) -> bool:
        pending = self.pending_sun_deaths.get(actor_id)
        if (
            pending is None
            or timestamp < pending.timestamp_100ns
            or timestamp - pending.timestamp_100ns
            > int(SUN_DEATH_CONFIRM_SECONDS * 10_000_000)
            or not self._sun_survival_hp(current_hp)
        ):
            return False
        self.pending_sun_deaths.pop(actor_id, None)
        # Establish the latest live state, but never add the discarded 0-HP
        # edge. A lone Singer therefore cannot end the pull as a false wipe.
        self._apply_member_life_transition(actor_id, timestamp, False)
        return True

    def flush_pending_member_deaths(
        self,
        monotonic_now: float | None = None,
        *,
        force: bool = False,
    ) -> bool:
        """Confirm delayed Sun-path deaths once the 1-HP window has elapsed."""

        now = time.monotonic() if monotonic_now is None else float(monotonic_now)
        due = sorted(
            (
                (actor_id, pending)
                for actor_id, pending in self.pending_sun_deaths.items()
                if force or pending.deadline_monotonic <= now
            ),
            key=lambda item: item[1].timestamp_100ns,
        )
        changed = False
        for actor_id, pending in due:
            if self.pending_sun_deaths.get(actor_id) != pending:
                continue
            self.pending_sun_deaths.pop(actor_id, None)
            if actor_id not in self._current_member_ids():
                changed = True
                continue
            changed |= self._apply_member_life_transition(
                actor_id,
                pending.timestamp_100ns,
                True,
            )
        return changed

    def _rebuild_member_life_metrics(self) -> None:
        """Derive life metrics from game timestamps inside the Boss interval."""
        self.member_death_counts.clear()
        self.member_revive_counts.clear()
        self.member_dead_since.clear()
        self.member_dead_durations.clear()
        if not self.first_damage_time:
            return

        encounter_start = float(self.first_damage_time)
        encounter_end = (
            float(self.combat_end_time) if self.combat_end_time else None
        )
        if encounter_end is not None and encounter_end < encounter_start:
            return

        for actor_id, transitions in self.member_life_transitions.items():
            deaths = 0
            revives = 0
            dead_duration = 0.0
            dead_since = 0.0
            for timestamp, dead in transitions:
                event_time = self._event_seconds(
                    {"filetime_100ns": timestamp}
                )
                if event_time < encounter_start:
                    continue
                if dead:
                    if encounter_end is not None and event_time > encounter_end:
                        continue
                    if not dead_since:
                        deaths += 1
                        dead_since = event_time
                    continue
                if not dead_since:
                    continue
                if encounter_end is not None and event_time > encounter_end:
                    dead_duration += max(0.0, encounter_end - dead_since)
                else:
                    dead_duration += max(0.0, event_time - dead_since)
                    revives += 1
                dead_since = 0.0

            if deaths:
                self.member_death_counts[actor_id] = deaths
            if revives:
                self.member_revive_counts[actor_id] = revives
            if dead_duration:
                self.member_dead_durations[actor_id] = dead_duration
            if dead_since:
                self.member_dead_since[actor_id] = dead_since

    def ingest_identity(self, update: dict) -> bool:
        try:
            entity_id = int(update.get("entity_id", 0))
        except (TypeError, ValueError):
            return False
        if not entity_id or entity_id in self.non_player_actor_ids:
            return False
        previous_self_id = self.self_id
        changed = previous_self_id != entity_id
        self.self_id = entity_id
        character_id = self.actor_character_ids.get(entity_id, "")
        if character_id:
            try:
                identity = canonical_character_identity(character_id)
            except ProfileUploadError:
                identity = None
            if identity is not None and self.self_character_id != identity.canonical:
                self.self_character_id = identity.canonical
                changed = True
        if previous_self_id and previous_self_id != entity_id:
            self._merge_member_life_transitions(previous_self_id, entity_id)
            self._merge_pending_sun_death(previous_self_id, entity_id)
            previous_time = self.member_life_times.pop(previous_self_id, 0)
            previous_state = self.member_death_states.pop(
                previous_self_id, None
            )
            if previous_time >= self.member_life_times.get(entity_id, 0):
                if previous_state is not None:
                    self.member_death_states[entity_id] = previous_state
                    self.member_life_times[entity_id] = previous_time
            previous_deaths = self.member_death_counts.pop(previous_self_id, 0)
            if previous_deaths:
                self.member_death_counts[entity_id] = (
                    self.member_death_counts.get(entity_id, 0) + previous_deaths
                )
            for mapping in (
                self.member_revive_counts,
                self.member_dead_durations,
            ):
                previous_value = mapping.pop(previous_self_id, 0)
                if previous_value:
                    mapping[entity_id] = mapping.get(entity_id, 0) + previous_value
            previous_dead_since = self.member_dead_since.pop(previous_self_id, 0.0)
            if previous_dead_since:
                current_dead_since = self.member_dead_since.get(entity_id, 0.0)
                self.member_dead_since[entity_id] = (
                    min(previous_dead_since, current_dead_since)
                    if current_dead_since
                    else previous_dead_since
                )
            previous_taken_state = self.team_taken_states.pop(
                previous_self_id, None
            )
            if previous_taken_state is not None:
                current_taken_state = self.team_taken_states.get(entity_id)
                if (
                    current_taken_state is None
                    or previous_taken_state.snapshot_time_100ns
                    >= current_taken_state.snapshot_time_100ns
                ):
                    previous_taken_state.actor_id = entity_id
                    self.team_taken_states[entity_id] = previous_taken_state
            previous_healing_state = self.team_healing_states.pop(
                previous_self_id, None
            )
            if previous_healing_state is not None:
                current_healing_state = self.team_healing_states.get(entity_id)
                if (
                    current_healing_state is None
                    or previous_healing_state.snapshot_time_100ns
                    >= current_healing_state.snapshot_time_100ns
                ):
                    previous_healing_state.actor_id = entity_id
                    self.team_healing_states[entity_id] = previous_healing_state
            previous_stage_taken = self.stage_actor_taken.pop(
                previous_self_id, None
            )
            if previous_stage_taken is not None:
                self.stage_actor_taken[entity_id] = previous_stage_taken
            previous_pending_taken = self.pending_stage_actor_taken.pop(
                previous_self_id, None
            )
            if previous_pending_taken is not None:
                self.pending_stage_actor_taken[entity_id] = previous_pending_taken
        cast_actor_ids = {0}
        if previous_self_id:
            cast_actor_ids.add(previous_self_id)
        cast_rebound = False
        for event in self.skill_cast_events:
            if int(event.get("actor_id", 0) or 0) in cast_actor_ids:
                event["actor_id"] = entity_id
                cast_rebound = True
        if cast_rebound:
            self._rebuild_skill_cast_event_keys()
            changed = True
        self.party_ids.discard(entity_id)
        self.provisional_party_ids.discard(entity_id)
        self.party_member_count = max(1, self.party_member_count)
        if entity_id in self.friend_order:
            self.friend_order.remove(entity_id)
        self.friend_order.insert(0, entity_id)
        automatic_name = self.entity_names.get(entity_id, "").strip()
        if automatic_name:
            self.local_player_name = automatic_name
        self._resolve_combat_sides()
        self._recompute()
        replayed = self._replay_pending_member_events()
        if changed or replayed:
            self.healing_revision += 1
        return changed or replayed

    def ingest_party(self, update: dict) -> bool:
        left_team = bool(update.get("left_team"))
        previous_party_active = self.party_active
        previous_party_session_id = int(self.party_session_id or 0)
        # Keep the previous live roster before assigning the incoming snapshot.
        # A roster replacement is a complete view; using ``self.party_ids``
        # after assignment would make every departed actor look current and
        # leave stale names, ratings, professions, and token bindings behind.
        previous_party_ids = set(self.party_ids)
        previous_provisional_ids = set(self.provisional_party_ids)
        previous_friend_order = set(self.friend_order)
        previous_party_tokens = set(self.party_user_tokens)
        previous_live_ids = (
            previous_party_ids
            | previous_provisional_ids
            | previous_friend_order
        )
        previous_live_ids.update(
            actor_id
            for actor_id, token in self.actor_character_ids.items()
            if str(token or "") in previous_party_tokens
        )
        if self.self_id is not None:
            previous_live_ids.add(self.self_id)
        if left_team and self._encounter_started():
            self.reset(
                keep_identity=True,
                keep_monsters=False,
                archive_reason="party_exit",
            )

        parsed: set[int] = set()
        values = update.get("entity_ids", [])
        if isinstance(values, (list, tuple, set)):
            for value in values:
                try:
                    entity_id = int(value)
                except (TypeError, ValueError):
                    continue
                if entity_id:
                    parsed.add(entity_id)
        parsed.difference_update(self.non_player_actor_ids)
        if self.self_id is not None:
            parsed.discard(self.self_id)
        parsed_user_tokens: set[str] | None = None
        raw_user_tokens = update.get("user_tokens")
        if isinstance(raw_user_tokens, (list, tuple, set)):
            parsed_user_tokens = {
                token
                for value in raw_user_tokens
                if (token := str(value or "").strip()[:128])
            }
        roster_replace = bool(update.get("roster_replace"))
        inferred_count = len(parsed) + (1 if self.self_id is not None else 0)
        try:
            member_count = max(0, int(update.get("member_count", inferred_count)))
        except (TypeError, ValueError, OverflowError):
            member_count = inferred_count
        member_count = min(
            MAX_PARTY_MEMBERS, max(member_count, inferred_count)
        )
        roster_identity_changed = bool(
            roster_replace
            and (
                parsed != previous_party_ids
                or member_count != self.party_member_count
                or (
                    parsed_user_tokens is not None
                    and parsed_user_tokens != previous_party_tokens
                )
            )
        )
        if left_team:
            party_active = False
        elif "in_team" in update:
            party_active = bool(update.get("in_team"))
        elif member_count > 1 or parsed:
            party_active = True
        else:
            party_active = previous_party_active
        try:
            incoming_session_id = int(update.get("party_session_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            incoming_session_id = 0
        if left_team or not party_active:
            party_session_id = 0
        elif incoming_session_id > 0:
            party_session_id = incoming_session_id
        else:
            # Compatibility for detached tests/legacy producers. Production
            # parser updates always carry the explicit session generation.
            party_session_id = previous_party_session_id or 1
        try:
            incoming_session_started = int(
                update.get("party_session_started_100ns", 0) or 0
            )
        except (TypeError, ValueError, OverflowError):
            incoming_session_started = 0
        party_session_started_100ns = (
            max(0, incoming_session_started)
            if party_session_id != previous_party_session_id
            else int(self.party_session_started_100ns or 0)
        )
        previous_provisional_ids = set(self.provisional_party_ids)
        official_positive_ids = {entity_id for entity_id in parsed if entity_id > 0}
        self.provisional_party_ids.difference_update(official_positive_ids)
        resolved_count = len(official_positive_ids) + (
            1 if self.self_id is not None else 0
        )
        provisional_slots = max(0, member_count - resolved_count)
        if len(self.provisional_party_ids) > provisional_slots:
            ordered_provisional = [
                actor_id
                for actor_id in self.friend_order
                if actor_id in self.provisional_party_ids
            ]
            ordered_provisional.extend(
                sorted(self.provisional_party_ids - set(ordered_provisional))
            )
            self.provisional_party_ids = set(
                ordered_provisional[:provisional_slots]
            )
        changed = (
            not self.party_known
            or parsed != self.party_ids
            or member_count != self.party_member_count
            or party_active != previous_party_active
            or party_session_id != previous_party_session_id
            or self.provisional_party_ids != previous_provisional_ids
            or (
                parsed_user_tokens is not None
                and parsed_user_tokens != self.party_user_tokens
            )
        )
        authoritative = bool(update.get("authoritative"))
        reset_team_counters = bool(
            party_session_id > 0
            and (
                party_session_id != previous_party_session_id
                or (
                    roster_identity_changed
                    and (
                        not self._encounter_started()
                        or bool(self.combat_end_time)
                    )
                )
            )
        )
        if reset_team_counters:
            # Team counter snapshots are cumulative within their originating
            # team. Reusing them in a later team corrupts both totals and DPS,
            # even when one character happens to be present in both rosters.
            self.team_damage_states.clear()
            self.team_taken_states.clear()
            self.team_healing_states.clear()
            self.team_server_time = 0
            self.team_server_update_100ns = 0
        self.party_known = True
        if authoritative:
            self.party_roster_authoritative = True
        self.party_ids = parsed
        if parsed_user_tokens is not None:
            self.party_user_tokens = parsed_user_tokens
        if roster_replace:
            # Unbound historical slots must not survive an exact membership
            # replacement merely because the incoming team has spare slots.
            self.provisional_party_ids.intersection_update(parsed)
            # A periodic authoritative heartbeat is a complete snapshot, not
            # an additive join event. Remove live identity/cache rows for
            # actors that disappeared while retaining encounter damage/history
            # dictionaries for the pull that is already in progress.
            allowed_ids = set(parsed)
            if self.self_id is not None:
                allowed_ids.add(self.self_id)
            allowed_tokens = set(parsed_user_tokens or ())
            if self.self_character_id:
                allowed_tokens.add(str(self.self_character_id))
            stale_ids = {
                actor_id
                for actor_id in (
                    set(self.entity_names)
                    | set(self.entity_professions)
                    | set(self.entity_extraordinary_ratings)
                    | set(self.entity_ai_states)
                    | set(self.actor_character_ids)
                )
                if actor_id not in allowed_ids and actor_id in previous_live_ids
            }
            if allowed_tokens:
                stale_ids.update(
                    actor_id
                    for actor_id, token in self.actor_character_ids.items()
                    if actor_id != self.self_id
                    and actor_id in previous_live_ids
                    and str(token or "") not in allowed_tokens
                )
            for actor_id in stale_ids:
                self.entity_names.pop(actor_id, None)
                self.entity_professions.pop(actor_id, None)
                self.entity_extraordinary_ratings.pop(actor_id, None)
                self.entity_ai_states.pop(actor_id, None)
                self.entity_fight_attributes.pop(actor_id, None)
                self.entity_fight_attribute_times.pop(actor_id, None)
                self.actor_character_ids.pop(actor_id, None)
            if stale_ids:
                self.friend_order = [
                    actor_id
                    for actor_id in self.friend_order
                    if actor_id not in stale_ids
                ]
        self.party_member_count = member_count
        self.party_active = party_active
        self.party_session_id = party_session_id
        self.party_session_started_100ns = party_session_started_100ns
        if left_team:
            self.party_user_tokens.clear()
            self.provisional_party_ids.clear()
            self.party_member_count = 1 if self.self_id is not None else 0
            self.team_damage_states.clear()
            self.team_taken_states.clear()
            self.team_healing_states.clear()
            self._clear_targetless_team_statistics()
        current_members = self._current_member_ids()
        self.member_death_states = {
            actor_id: dead
            for actor_id, dead in self.member_death_states.items()
            if actor_id in current_members
        }
        self.member_life_times = {
            actor_id: timestamp
            for actor_id, timestamp in self.member_life_times.items()
            if actor_id in current_members
        }
        self.pending_sun_deaths = {
            actor_id: pending
            for actor_id, pending in self.pending_sun_deaths.items()
            if actor_id in current_members
        }
        update_is_during_encounter = True
        try:
            update_timestamp = int(update.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            update_timestamp = 0
        if update_timestamp and self.last_damage_time:
            update_time = self._event_seconds({"filetime_100ns": update_timestamp})
            elapsed = update_time - self.last_damage_time
            update_is_during_encounter = (
                -1.0 <= elapsed <= self._encounter_idle_timeout()
            )
        if (
            self._encounter_started()
            and not self.combat_end_time
            and update_is_during_encounter
        ):
            # Party membership is volatile and is not the participant count.
            # Only actors with accepted encounter damage appear in the record.
            self.encounter_team_size = min(
                MAX_PARTY_MEMBERS, len(self.encounter_member_ids)
            )
        reordered = [
            actor_id
            for actor_id in self.friend_order
            if actor_id in current_members and actor_id != self.self_id
        ]
        for actor_id in sorted(parsed):
            if actor_id not in reordered:
                reordered.append(actor_id)
        for actor_id in self.provisional_party_ids:
            if actor_id not in reordered:
                reordered.append(actor_id)
        self.friend_order = (
            [self.self_id, *reordered]
            if self.self_id is not None
            else reordered
        )
        self._resolve_combat_sides()
        self._recompute()
        replayed = self._replay_pending_member_events()
        return left_team or changed or replayed

    def ingest_scene(self, update: dict) -> bool:
        if update.get("transition"):
            had_scene_state = bool(
                self.scene_id is not None
                or self.monsters
                or self.combat_target_id is not None
                or self._encounter_started()
            )
            try:
                transition_timestamp = int(update.get("filetime_100ns", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                transition_timestamp = 0
            if transition_timestamp > 0 and self._encounter_started():
                transition_time = self._event_seconds(
                    {"filetime_100ns": transition_timestamp}
                )
                # Scene-exit packets are an exact upper bound for the live
                # clock.  Freeze every still-active Boss before archiving so a
                # missing fight-mode [0] cannot make replayed or delayed UI
                # renders extend the encounter past the moment we left.
                for entity_id in self._current_boss_target_ids():
                    if self.entity_combat_states.get(entity_id) is True:
                        self.entity_combat_states[entity_id] = False
                        self.entity_combat_state_times[entity_id] = max(
                            transition_timestamp,
                            int(self.entity_combat_state_times.get(entity_id, 0) or 0),
                        )
                if self.first_damage_time and not self.combat_end_time:
                    self.combat_end_time = max(
                        self.first_damage_time, transition_time
                    )
                    self.combat_end_reason = "space_transition"
                if self.first_healing_time and not self.healing_end_time:
                    self.healing_end_time = max(
                        self.first_healing_time, transition_time
                    )
                    self.healing_end_reason = "space_transition"
            self.provisional_party_ids.clear()
            self.entity_fight_attributes.clear()
            self.entity_fight_attribute_times.clear()
            self.reset(
                keep_identity=True,
                keep_monsters=False,
                archive_reason="space_transition",
            )
            self.member_death_states.clear()
            self.member_life_times.clear()
            self.scene_id = None
            return had_scene_state
        try:
            scene_id = int(update.get("scene_id", 0))
            timestamp = int(update.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if scene_id <= 0:
            return False
        previous_scene_id = self.scene_id
        force_reset = bool(update.get("force_reset"))
        visible_entity_ids: set[int] = set()
        raw_entity_ids = update.get("entity_ids", ())
        if isinstance(raw_entity_ids, (list, tuple, set)):
            for raw_entity_id in raw_entity_ids:
                try:
                    entity_id = int(raw_entity_id or 0)
                except (TypeError, ValueError, OverflowError):
                    continue
                if entity_id:
                    visible_entity_ids.add(entity_id)
        refreshed_targets = self._encounter_damage_target_ids() | set(
            self.encounter_target_ids
        )
        preserves_active_encounter = bool(
            previous_scene_id == scene_id
            and force_reset
            and self._encounter_started()
            and refreshed_targets.intersection(visible_entity_ids)
        )
        first_refresh_ends_encounter = bool(
            previous_scene_id is None
            and self._encounter_started()
            and refreshed_targets
            and not refreshed_targets.intersection(visible_entity_ids)
        )
        changed = first_refresh_ends_encounter or (
            previous_scene_id is not None
            and (
                scene_id != previous_scene_id
                or (force_reset and not preserves_active_encounter)
            )
        )
        if changed:
            if self._suspend_long_gap_phase_for_scene(timestamp):
                self.scene_id = scene_id
                return True
            self.provisional_party_ids.clear()
            self.entity_fight_attributes.clear()
            self.entity_fight_attribute_times.clear()
            self.reset(
                keep_identity=True,
                keep_monsters=False,
                archive_reason=(
                    "scene_refresh"
                    if scene_id == previous_scene_id
                    else "scene_change"
                ),
            )
            self.member_death_states.clear()
            self.member_life_times.clear()
        self.scene_id = scene_id
        self.awaiting_post_exit_context = False
        self.closed_encounter_target_ids.difference_update(visible_entity_ids)
        return changed

    def rebind_team_actors(self, update: dict) -> bool:
        """Atomically move token-derived state between positive actor IDs.

        Stage completion rows carry an exact token-to-actor mapping.  Earlier
        HP/profession heuristics can rotate two real actors, but their raw
        damage/heal events still contain the correct physical IDs.  Therefore
        this operation moves only state keyed by a team token and deliberately
        leaves events, death transitions, HP samples, names and professions in
        their physical actor namespaces.
        """
        raw_bindings = update.get("bindings", []) if isinstance(update, dict) else []
        if not isinstance(raw_bindings, list) or not raw_bindings:
            return False

        bindings: list[tuple[int, int, str]] = []
        sources: set[int] = set()
        targets: set[int] = set()
        tokens: set[str] = set()
        for raw_binding in raw_bindings:
            if not isinstance(raw_binding, dict):
                return False
            try:
                source = int(raw_binding.get("from_actor_id", 0) or 0)
                target = int(raw_binding.get("to_actor_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                return False
            token = str(raw_binding.get("user_token", "")).strip()
            if (
                source <= 0
                or target <= 0
                or source == target
                or not token
                or source in sources
                or target in targets
                or token in tokens
            ):
                return False
            bindings.append((source, target, token))
            sources.add(source)
            targets.add(target)
            tokens.add(token)

        def move_values(mapping: dict, *, actor_objects: bool = False) -> bool:
            captured = {
                source: mapping[source]
                for source, _target, _token in bindings
                if source in mapping
            }
            if not captured:
                return False
            for source in captured:
                mapping.pop(source, None)
            for source, target, _token in bindings:
                if source in captured:
                    mapping.pop(target, None)
            for source, target, _token in bindings:
                if source not in captured:
                    continue
                value = captured[source]
                mapping[target] = (
                    replace(value, actor_id=target) if actor_objects else value
                )
            return True

        changed = False
        for mapping in (
            self.team_damage_states,
            self.team_taken_states,
            self.team_healing_states,
            self.stage_skill_snapshots,
            self.pending_stage_skill_snapshots,
            self.stage_healing_snapshots,
        ):
            changed |= move_values(mapping, actor_objects=True)
        for mapping in (
            self.stage_actor_taken,
            self.pending_stage_actor_taken,
            self.stage_actor_metrics,
            self.stage_actor_penetration_metrics,
        ):
            changed |= move_values(mapping)

        def move_token_profile_values(mapping: dict) -> bool:
            sentinel = object()
            relevant_ids = sources | targets
            before = {
                actor_id: mapping.get(actor_id, sentinel)
                for actor_id in relevant_ids
            }
            captured = {
                source: mapping[source]
                for source, _target, _token in bindings
                if source in mapping
            }
            for actor_id in relevant_ids:
                mapping.pop(actor_id, None)
            for source, target, _token in bindings:
                if source in captured:
                    mapping[target] = captured[source]
            after = {
                actor_id: mapping.get(actor_id, sentinel)
                for actor_id in relevant_ids
            }
            return before != after

        # Ratings and synthetic-member identity belong to the team token, not
        # to the physical actor slot corrected by the stage snapshot.
        changed |= move_token_profile_values(
            self.entity_extraordinary_ratings
        )
        changed |= move_token_profile_values(self.entity_ai_states)

        # The supplied token is the authoritative identity for every target
        # actor. Apply all bindings as one permutation so rotated actor slots
        # cannot inherit another participant's identity.
        relevant_ids = sources | targets
        previous_identities = {
            actor_id: self.actor_character_ids.get(actor_id, "")
            for actor_id in relevant_ids
        }
        for actor_id in relevant_ids:
            self.actor_character_ids.pop(actor_id, None)
        for _source, target, token in bindings:
            try:
                identity = canonical_character_identity(token, allow_ai=True)
            except ProfileUploadError:
                continue
            self.actor_character_ids[target] = identity.canonical
            if target == self.self_id and identity.kind == "human":
                self.self_character_id = identity.canonical
        current_identities = {
            actor_id: self.actor_character_ids.get(actor_id, "")
            for actor_id in relevant_ids
        }
        changed |= previous_identities != current_identities

        if changed:
            self.healing_revision += 1
            self.healing_summary_cache_key = None
            self.healing_summary_cache = None
            self._recompute()
            self._queue_current_record_refresh()
        return changed

    def merge_actor(self, update: dict) -> bool:
        try:
            old_actor = int(update.get("from_actor_id", 0))
            new_actor = int(update.get("to_actor_id", 0))
        except (TypeError, ValueError, OverflowError):
            return False
        if not old_actor or not new_actor or old_actor == new_actor:
            return False

        replace_profile = bool(
            update.get("replace_profile")
            and str(update.get("user_token", "")).strip()
        )

        changed = False
        raw_character_id = str(update.get("user_token", "") or "").strip()
        identity = None
        if raw_character_id:
            try:
                identity = canonical_character_identity(
                    raw_character_id, allow_ai=True
                )
            except ProfileUploadError:
                identity = None
        old_character_id = self.actor_character_ids.pop(old_actor, "")
        if old_character_id:
            changed = True
        if identity is not None:
            if self.actor_character_ids.get(new_actor) != identity.canonical:
                self.actor_character_ids[new_actor] = identity.canonical
                changed = True
        elif old_character_id and new_actor not in self.actor_character_ids:
            self.actor_character_ids[new_actor] = old_character_id
            changed = True
        if (
            new_actor == self.self_id
            and self.actor_character_ids.get(new_actor)
            and self.self_character_id != self.actor_character_ids[new_actor]
        ):
            try:
                self.self_character_id = canonical_character_identity(
                    self.actor_character_ids[new_actor]
                ).canonical
                changed = True
            except ProfileUploadError:
                pass
        if old_actor in self.provisional_party_ids:
            self.provisional_party_ids.discard(old_actor)
            if new_actor != self.self_id:
                self.provisional_party_ids.add(new_actor)
            changed = True
        elif new_actor in self.provisional_party_ids:
            self.provisional_party_ids.discard(new_actor)
            changed = True
        if old_actor in self.party_ids:
            self.party_ids.discard(old_actor)
            if new_actor != self.self_id:
                self.party_ids.add(new_actor)
            changed = True
        duplicate_encounter_member = (
            old_actor in self.encounter_member_ids
            and new_actor in self.encounter_member_ids
        )
        if old_actor in self.encounter_member_ids:
            self.encounter_member_ids.discard(old_actor)
            self.encounter_member_ids.add(new_actor)
            if duplicate_encounter_member and self.encounter_team_size > 0:
                self.encounter_team_size = max(
                    len(self.encounter_member_ids),
                    self.encounter_team_size - 1,
                )
                self.encounter_team_size = min(
                    MAX_PARTY_MEMBERS, self.encounter_team_size
                )
            changed = True

        reordered: list[int] = []
        for actor_id in self.friend_order:
            candidate = new_actor if actor_id == old_actor else actor_id
            if candidate not in reordered:
                reordered.append(candidate)
        self.friend_order = reordered

        old_name = self.entity_names.pop(old_actor, "")
        if replace_profile:
            if old_name:
                if self.entity_names.get(new_actor) != old_name:
                    self.entity_names[new_actor] = old_name
                    changed = True
            elif new_actor in self.entity_names:
                self.entity_names.pop(new_actor, None)
                changed = True
        elif old_name and not self.entity_names.get(new_actor):
            self.entity_names[new_actor] = old_name
            changed = True
        old_profession = self.entity_professions.pop(old_actor, None)
        if replace_profile:
            if old_profession:
                if self.entity_professions.get(new_actor) != old_profession:
                    self.entity_professions[new_actor] = old_profession
                    changed = True
            elif new_actor in self.entity_professions:
                self.entity_professions.pop(new_actor, None)
                changed = True
        elif old_profession and not self.entity_professions.get(new_actor):
            self.entity_professions[new_actor] = old_profession
            changed = True
        old_extraordinary_rating = self.entity_extraordinary_ratings.pop(
            old_actor, None
        )
        if replace_profile:
            if old_extraordinary_rating is not None:
                if (
                    self.entity_extraordinary_ratings.get(new_actor)
                    != old_extraordinary_rating
                ):
                    self.entity_extraordinary_ratings[new_actor] = (
                        old_extraordinary_rating
                    )
                    changed = True
            elif new_actor in self.entity_extraordinary_ratings:
                self.entity_extraordinary_ratings.pop(new_actor, None)
                changed = True
        elif (
            old_extraordinary_rating is not None
            and new_actor not in self.entity_extraordinary_ratings
        ):
            self.entity_extraordinary_ratings[new_actor] = old_extraordinary_rating
            changed = True
        old_ai_state = self.entity_ai_states.pop(old_actor, None)
        if replace_profile:
            if old_ai_state is not None:
                if self.entity_ai_states.get(new_actor) != old_ai_state:
                    self.entity_ai_states[new_actor] = old_ai_state
                    changed = True
            elif new_actor in self.entity_ai_states:
                self.entity_ai_states.pop(new_actor, None)
                changed = True
        elif old_ai_state is not None and new_actor not in self.entity_ai_states:
            self.entity_ai_states[new_actor] = old_ai_state
            changed = True

        old_fight_attributes = self.entity_fight_attributes.pop(
            old_actor, None
        )
        old_fight_attribute_time = self.entity_fight_attribute_times.pop(
            old_actor, 0
        )
        if old_fight_attributes is not None:
            current_time = self.entity_fight_attribute_times.get(new_actor, 0)
            if old_fight_attribute_time >= current_time:
                if self.entity_fight_attributes.get(new_actor) != old_fight_attributes:
                    self.entity_fight_attributes[new_actor] = dict(
                        old_fight_attributes
                    )
                    changed = True
                self.entity_fight_attribute_times[new_actor] = (
                    old_fight_attribute_time
                )

        old_life_time = self.member_life_times.pop(old_actor, 0)
        old_dead = self.member_death_states.pop(old_actor, None)
        if self._merge_member_life_transitions(old_actor, new_actor):
            changed = True
        if self._merge_pending_sun_death(old_actor, new_actor):
            changed = True
        if old_life_time >= self.member_life_times.get(new_actor, 0):
            if old_dead is not None:
                self.member_death_states[new_actor] = old_dead
                self.member_life_times[new_actor] = old_life_time
                changed = True

        old_deaths = self.member_death_counts.pop(old_actor, 0)
        if old_deaths:
            self.member_death_counts[new_actor] = (
                self.member_death_counts.get(new_actor, 0) + old_deaths
            )
            changed = True
        old_revives = self.member_revive_counts.pop(old_actor, 0)
        if old_revives:
            self.member_revive_counts[new_actor] = (
                self.member_revive_counts.get(new_actor, 0) + old_revives
            )
            changed = True
        old_dead_duration = self.member_dead_durations.pop(old_actor, 0.0)
        if old_dead_duration:
            self.member_dead_durations[new_actor] = (
                self.member_dead_durations.get(new_actor, 0.0) + old_dead_duration
            )
            changed = True
        old_dead_since = self.member_dead_since.pop(old_actor, 0.0)
        if old_dead_since:
            current_dead_since = self.member_dead_since.get(new_actor, 0.0)
            self.member_dead_since[new_actor] = (
                min(old_dead_since, current_dead_since)
                if current_dead_since
                else old_dead_since
            )
            changed = True

        old_combat_time = self.entity_combat_state_times.pop(old_actor, 0)
        old_in_combat = self.entity_combat_states.pop(old_actor, None)
        if old_combat_time >= self.entity_combat_state_times.get(new_actor, 0):
            if old_in_combat is not None:
                self.entity_combat_states[new_actor] = old_in_combat
                self.entity_combat_state_times[new_actor] = old_combat_time
                changed = True

        old_state = self.team_damage_states.pop(old_actor, None)
        if old_state is not None:
            new_state = self.team_damage_states.get(new_actor)
            if new_state is None:
                old_state.actor_id = new_actor
                self.team_damage_states[new_actor] = old_state
            else:
                old_authoritative_is_newer = bool(
                    old_state.authoritative_snapshot
                    and (
                        not new_state.authoritative_snapshot
                        or old_state.snapshot_time_100ns
                        >= new_state.snapshot_time_100ns
                    )
                )
                if old_authoritative_is_newer:
                    new_state.last_absolute = old_state.last_absolute
                    new_state.baseline_absolute = old_state.baseline_absolute
                    new_state.accepted_damage = old_state.accepted_damage
                    new_state.carried_damage = old_state.carried_damage
                    new_state.server_time = old_state.server_time
                    new_state.live_dps = old_state.live_dps
                    new_state.live_dps_damage = old_state.live_dps_damage
                elif (
                    not new_state.authoritative_snapshot
                    and old_state.snapshot_time_100ns
                    >= new_state.snapshot_time_100ns
                ):
                    new_state.last_absolute = old_state.last_absolute
                    new_state.baseline_absolute = old_state.baseline_absolute
                    new_state.accepted_damage = old_state.accepted_damage
                    new_state.carried_damage = old_state.carried_damage
                    new_state.server_time = old_state.server_time
                    new_state.live_dps = old_state.live_dps
                    new_state.live_dps_damage = old_state.live_dps_damage
                new_state.has_snapshot |= old_state.has_snapshot
                new_state.authoritative_snapshot |= (
                    old_state.authoritative_snapshot
                )
                new_state.snapshot_time_100ns = max(
                    new_state.snapshot_time_100ns,
                    old_state.snapshot_time_100ns,
                )
                times = [
                    value
                    for value in (new_state.first_time, old_state.first_time)
                    if value
                ]
                new_state.first_time = min(times) if times else 0.0
                new_state.last_time = max(new_state.last_time, old_state.last_time)
            changed = True

        old_taken_state = self.team_taken_states.pop(old_actor, None)
        if old_taken_state is not None:
            current_taken_state = self.team_taken_states.get(new_actor)
            if (
                current_taken_state is None
                or old_taken_state.snapshot_time_100ns
                >= current_taken_state.snapshot_time_100ns
            ):
                old_taken_state.actor_id = new_actor
                self.team_taken_states[new_actor] = old_taken_state
            changed = True
        old_healing_state = self.team_healing_states.pop(old_actor, None)
        if old_healing_state is not None:
            current_healing_state = self.team_healing_states.get(new_actor)
            if (
                current_healing_state is None
                or old_healing_state.snapshot_time_100ns
                >= current_healing_state.snapshot_time_100ns
            ):
                old_healing_state.actor_id = new_actor
                self.team_healing_states[new_actor] = old_healing_state
            changed = True
        old_stage_taken = self.stage_actor_taken.pop(old_actor, None)
        if old_stage_taken is not None:
            self.stage_actor_taken[new_actor] = old_stage_taken
            changed = True
        old_pending_taken = self.pending_stage_actor_taken.pop(old_actor, None)
        if old_pending_taken is not None:
            current_pending_taken = self.pending_stage_actor_taken.get(new_actor)
            if (
                current_pending_taken is None
                or old_pending_taken[3] >= current_pending_taken[3]
            ):
                self.pending_stage_actor_taken[new_actor] = old_pending_taken
            changed = True
        old_metrics = self.stage_actor_metrics.pop(old_actor, None)
        if old_metrics is not None:
            current_metrics = self.stage_actor_metrics.get(new_actor)
            if current_metrics is None or old_metrics[0] > current_metrics[0]:
                self.stage_actor_metrics[new_actor] = old_metrics
            changed = True

        old_penetration_metrics = self.stage_actor_penetration_metrics.pop(
            old_actor, None
        )
        if old_penetration_metrics is not None:
            current_penetration_metrics = (
                self.stage_actor_penetration_metrics.get(new_actor)
            )
            if (
                current_penetration_metrics is None
                or old_penetration_metrics[0] > current_penetration_metrics[0]
            ):
                self.stage_actor_penetration_metrics[new_actor] = (
                    old_penetration_metrics
                )
            changed = True

        old_healing_snapshot = self.stage_healing_snapshots.pop(old_actor, None)
        if old_healing_snapshot is not None:
            rebound_snapshot = StageHealingSnapshot(
                summary_id=old_healing_snapshot.summary_id,
                actor_id=new_actor,
                actor_damage=old_healing_snapshot.actor_damage,
                filetime_100ns=old_healing_snapshot.filetime_100ns,
                effective_healing=old_healing_snapshot.effective_healing,
                skills=dict(old_healing_snapshot.skills),
                unclassified_healing=old_healing_snapshot.unclassified_healing,
            )
            current_snapshot = self.stage_healing_snapshots.get(new_actor)
            if (
                current_snapshot is None
                or rebound_snapshot.filetime_100ns
                >= current_snapshot.filetime_100ns
            ):
                self.stage_healing_snapshots[new_actor] = rebound_snapshot
            changed = True

        old_health = self.actor_health_states.pop(old_actor, None)
        if old_health is not None:
            current_health = self.actor_health_states.get(new_actor)
            if current_health is None or int(
                old_health.get("filetime_100ns", 0) or 0
            ) >= int(current_health.get("filetime_100ns", 0) or 0):
                self.actor_health_states[new_actor] = old_health
            changed = True
        old_health_low = self.actor_health_lows.pop(old_actor, None)
        if old_health_low is not None:
            current_health_low = self.actor_health_lows.get(new_actor)
            if current_health_low is None or self._health_low_is_lower(
                old_health_low, current_health_low
            ):
                self.actor_health_lows[new_actor] = old_health_low
            changed = True
        old_drop = self.pending_health_drops.pop(old_actor, 0)
        if old_drop:
            current_drop = self.pending_health_drops.get(new_actor, 0)
            self.pending_health_drops[new_actor] = (
                min(old_drop, current_drop) if current_drop else old_drop
            )
            changed = True

        healing_rebound = False
        for event in self.healing_events:
            if int(event.get("healer_id", 0) or 0) == old_actor:
                event["healer_id"] = new_actor
                healing_rebound = True
            if int(event.get("target_id", 0) or 0) == old_actor:
                event["target_id"] = new_actor
                healing_rebound = True
        for response in self.healing_responses:
            if int(response.get("healer_id", 0) or 0) == old_actor:
                response["healer_id"] = new_actor
                healing_rebound = True
            if int(response.get("target_id", 0) or 0) == old_actor:
                response["target_id"] = new_actor
                healing_rebound = True
        rebound_response_keys = {
            (
                new_actor if target_id == old_actor else target_id,
                drop_time,
                new_actor if healer_id == old_actor else healer_id,
            )
            for target_id, drop_time, healer_id in self.healing_response_keys
        }
        if rebound_response_keys != self.healing_response_keys:
            self.healing_response_keys = rebound_response_keys
            healing_rebound = True
        if healing_rebound:
            self.healing_event_keys = {
                self._healing_event_key(event) for event in self.healing_events
            }
            changed = True

        for event in self.events:
            if int(event.get("attacker_id", 0)) == old_actor:
                event["attacker_id"] = new_actor
                changed = True
            if int(event.get("target_id", 0)) == old_actor:
                event["target_id"] = new_actor
                changed = True
        cast_rebound = False
        for event in self.skill_cast_events:
            if int(event.get("actor_id", 0) or 0) == old_actor:
                event["actor_id"] = new_actor
                cast_rebound = True
        if cast_rebound:
            self._rebuild_skill_cast_event_keys()
            changed = True
        for event in self.pending_member_events:
            if int(event.get("attacker_id", 0)) == old_actor:
                event["attacker_id"] = new_actor
                changed = True
            if int(event.get("target_id", 0)) == old_actor:
                event["target_id"] = new_actor
                changed = True
        changed |= self.boss_damage.rebind_target(old_actor, new_actor)
        self.monsters.pop(old_actor, None)
        if self.self_id == new_actor and self.entity_names.get(new_actor):
            self.local_player_name = self.entity_names[new_actor]
        self._resolve_combat_sides()
        self._recompute()
        replayed = self._replay_pending_member_events()
        if changed or replayed:
            self.healing_revision += 1
        return changed or replayed

    def ingest_life(self, update: dict) -> bool:
        try:
            actor_id = int(update.get("actor_id", 0) or 0)
            timestamp = int(update.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if self.long_gap_phase_suspended:
            return False
        if (
            not actor_id
            or not timestamp
            or "dead" not in update
            or actor_id not in self._current_member_ids()
            or timestamp < self.member_life_times.get(actor_id, 0)
        ):
            return False
        dead = bool(update.get("dead"))
        if dead and update.get("death_confirmed") is not True:
            return False
        pending = self.pending_sun_deaths.get(actor_id)
        if pending is not None and timestamp < pending.timestamp_100ns:
            return False

        if dead:
            if pending is not None:
                # Duplicate zero-HP notifications must not extend the grace
                # period indefinitely or create more than one death.
                return False
            if (
                self.actor_profession_id(actor_id) == SUN_PROFESSION_ID
                and self.member_death_states.get(actor_id) is not True
            ):
                self.pending_sun_deaths[actor_id] = PendingMemberDeath(
                    timestamp_100ns=timestamp,
                    deadline_monotonic=(
                        time.monotonic() + SUN_DEATH_CONFIRM_SECONDS
                    ),
                )
                # Capture sources are merged in bounded batches. If the newer
                # 1-HP sample was already consumed before this delayed death
                # edge, resolve the passive from that timestamp immediately.
                health_state = self.actor_health_states.get(actor_id, {})
                self._resolve_sun_survival(
                    actor_id,
                    int(health_state.get("filetime_100ns", 0) or 0),
                    health_state.get("current_hp"),
                )
                return True
            return self._apply_member_life_transition(actor_id, timestamp, True)

        if pending is not None:
            if (
                not bool(update.get("explicit_transition"))
                and self._resolve_sun_survival(
                    actor_id,
                    timestamp,
                    update.get("current_hp"),
                )
            ):
                return True
            self.pending_sun_deaths.pop(actor_id, None)
            death_changed = self._apply_member_life_transition(
                actor_id,
                pending.timestamp_100ns,
                True,
            )
            return (
                self._apply_member_life_transition(actor_id, timestamp, False)
                or death_changed
            )
        return self._apply_member_life_transition(actor_id, timestamp, False)

    def _begin_boss_after_completed_victory(
        self,
        entity_id: int,
        timestamp: int,
        *,
        in_combat: bool | None = None,
        active_boss_confirmed: bool = False,
    ) -> bool:
        """Rebase a genuinely new Boss after the previous Boss has died.

        Boss fight-mode for the next room can arrive before its active-Boss
        promotion.  The old implementation left ``combat_target_id`` attached
        to the dead target, so both the shared clock and cumulative TeamStats
        remained frozen.  A zero-HP target plus a different parser-confirmed
        active Boss also proves the room transition when the explicit entity
        death packet was missed.  Mapped phases and verified simultaneous-Boss
        successors continue to use their existing single-encounter rules.
        """

        entity_id = int(entity_id or 0)
        timestamp = int(timestamp or 0)
        previous_id = int(self.combat_target_id or 0)
        previous = self.monsters.get(previous_id)
        previous_hp_depleted = bool(
            previous is not None
            and previous.current_hp is not None
            and previous.current_hp <= 0
        )
        # A completed official settlement is authoritative even when the
        # client omitted the matching EntityDead/zero-HP packet.  This is
        # common for a victory response that arrives immediately before the
        # next Boss Challenge.  The active-boss confirmation below is still
        # required for this relaxed path, so a stale target-defeated flag
        # cannot rotate an encounter on an unrelated profile update.
        explicitly_completed = bool(
            self.combat_end_time
            and self.combat_end_reason == "target_defeated"
            and (
                self._boss_is_confirmed_dead(previous)
                or active_boss_confirmed
            )
        )
        previous_state = self.entity_combat_states.get(previous_id)
        previous_idle = bool(
            active_boss_confirmed
            and (
                previous_state is False
                or (
                    self.last_damage_time
                    and self._event_seconds({"filetime_100ns": timestamp})
                    - self.last_damage_time
                    >= self.idle_gap
                )
            )
        )
        if (
            not entity_id
            or entity_id == previous_id
            or entity_id in self._current_boss_target_ids()
            or not previous_id
            or not self._encounter_started()
            or not self._is_priority_target(entity_id)
            or not (
                explicitly_completed
                or (active_boss_confirmed and (previous_hp_depleted or previous_idle))
            )
        ):
            return False
        incoming = self.monsters.get(entity_id)
        if (
            incoming is None
            or self._boss_phase_continues(previous, incoming)
            or self._verified_simultaneous_boss_pair(previous_id, entity_id)
            or self._completed_simultaneous_boss_successor(entity_id)
        ):
            return False

        if in_combat is None:
            next_combat_state = self.entity_combat_states.get(entity_id)
        else:
            next_combat_state = bool(in_combat)
        next_state_time = max(
            timestamp,
            int(self.entity_combat_state_times.get(entity_id, 0) or 0),
        )

        if previous_hp_depleted and not self.combat_end_time:
            completed_at = self.last_damage_time
            if previous is not None and previous.death_time_100ns:
                completed_at = max(
                    completed_at,
                    self._event_seconds(
                        {"filetime_100ns": previous.death_time_100ns}
                    ),
                )
            self.combat_end_time = max(self.first_damage_time, completed_at)
            self.combat_end_reason = "target_defeated"
            self._rebuild_member_life_metrics()
        elif not self.combat_end_reason:
            same_boss_retry = bool(
                previous is not None
                and incoming is not None
                and int(previous.template_id or 0) > 0
                and int(previous.template_id or 0)
                == int(incoming.template_id or 0)
            )
            self.combat_end_time = max(
                self.first_damage_time, self.last_damage_time
            )
            self.combat_end_reason = (
                "party_wipe" if same_boss_retry else "boss_replaced"
            )
            self._rebuild_member_life_metrics()

        # HP packets for the next Boss can arrive before its active-Boss
        # promotion.  The encounter reset below clears transient monster HP;
        # retain the newer Boss's ordered samples so its first HUD ratio uses
        # the real pre-pull maximum instead of the first damaged sample after
        # promotion.
        incoming_hp_snapshot = None
        if incoming is not None:
            incoming_hp_snapshot = {
                "current_hp": incoming.current_hp,
                "observed_max_hp": incoming.observed_max_hp,
                "last_hp_update_100ns": incoming.last_hp_update_100ns,
                "last_hp_drop_100ns": incoming.last_hp_drop_100ns,
                "death_confirmed": incoming.death_confirmed,
                "death_time_100ns": incoming.death_time_100ns,
            }

        self.reset(
            keep_identity=True,
            keep_monsters=True,
            archive_reason=self.combat_end_reason or "boss_replaced",
        )
        if incoming_hp_snapshot is not None:
            restored = self.monsters.get(entity_id)
            if restored is not None:
                for field_name, value in incoming_hp_snapshot.items():
                    setattr(restored, field_name, value)
        self.combat_target_id = entity_id
        self.active_target_id = entity_id
        self._register_encounter_target(entity_id)
        self.pending_active_boss_id = None
        self.pending_active_boss_time_100ns = 0
        if next_combat_state is not None:
            self.entity_combat_states[entity_id] = bool(next_combat_state)
            if next_state_time:
                self.entity_combat_state_times[entity_id] = next_state_time
        if next_state_time:
            self.latest_network_time_100ns = max(
                self.latest_network_time_100ns, next_state_time
            )
        self._resolve_combat_sides()
        if next_combat_state is True and next_state_time:
            self._arm_team_encounter(entity_id, next_state_time)
        return True

    def ingest_active_boss(self, update: dict) -> bool:
        """Freeze the old pull when the parser confirms a new active Boss entity."""
        try:
            entity_id = int(update.get("entity_id", 0) or 0)
            timestamp = int(update.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if not entity_id:
            return False

        if entity_id in self.closed_encounter_target_ids:
            return False
        profile = dict(update)
        profile.update(
            {
                "entity_id": entity_id,
                "entity_type": "Boss",
                "boss_type": 3,
                "boss_rank": 3,
            }
        )
        changed = self.ingest_profile(profile)
        try:
            max_hp = float(update.get("max_hp", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            max_hp = 0.0
        if max_hp > 0:
            changed |= self.ingest_monster(
                {
                    "entity_id": entity_id,
                    "max_hp": max_hp,
                    "filetime_100ns": timestamp,
                }
            )
        if not self._is_priority_target(entity_id):
            return changed

        changed |= self._clear_targetless_team_statistics()
        self.awaiting_post_exit_context = False
        current_id = int(self.combat_target_id or 0)
        if entity_id in self._current_boss_target_ids():
            self.pending_active_boss_id = None
            self.pending_active_boss_time_100ns = 0
            return changed

        incoming = self.monsters.get(entity_id)
        previous = self.monsters.get(current_id)
        if self._continue_completed_simultaneous_boss_successor(
            entity_id, active_boss_confirmed=True
        ):
            return True
        phase_continuation = bool(
            current_id
            and (
                self._boss_phase_continues(previous, incoming)
                or self._restore_unknown_phase_predecessor(previous, incoming)
            )
        )
        if (
            phase_continuation
            and self.combat_end_reason in {"party_wipe", "target_reset"}
        ):
            # An explicitly failed opening belongs to the failed attempt.  A
            # later final-form entity can only continue an encounter that has
            # not already ended by wipe/reset evidence.
            phase_continuation = False
        if phase_continuation:
            long_gap_phase = self._long_gap_phase_continues(previous, incoming)
            if long_gap_phase:
                self._resume_long_gap_phase_from_scene(incoming, timestamp)
            self.linked_boss_target_ids.update({current_id, entity_id})
            self._replace_simultaneous_boss_target(current_id, entity_id)
            self.combat_target_id = entity_id
            self.active_target_id = entity_id
            self._register_encounter_target(entity_id)
            self.pending_active_boss_id = None
            self.pending_active_boss_time_100ns = 0
            if long_gap_phase or self.combat_end_time:
                self.combat_end_time = 0.0
                self.combat_end_reason = ""
                self.healing_end_time = 0.0
                self.healing_end_reason = ""
                self.completed_combats[:] = [
                    record
                    for record in self.completed_combats
                    if record.get("encounter_id") != self.encounter_id
                ]
                self.last_archive_signature = None
            self._resolve_combat_sides()
            return True

        if self.long_gap_phase_suspended:
            # Only the exact mapped final form may resume the frozen encounter.
            # Any other active Boss follows the ordinary replacement/new-pull
            # path below and must not inherit Karl Edgar's opening totals.
            self._clear_long_gap_phase_suspension()
        verified_active_pair = self._verified_simultaneous_boss_pair(
            current_id, entity_id
        )
        if self._try_register_simultaneous_boss(
            entity_id,
            timestamp,
            explicit=(
                update.get("simultaneous_boss") is True
                or verified_active_pair
            ),
            allow_hp_overlap=True,
        ):
            return True

        if self._begin_boss_after_completed_victory(
            entity_id,
            timestamp,
            active_boss_confirmed=True,
        ):
            return True

        if not current_id or not self._encounter_started():
            self.combat_target_id = entity_id
            self.active_target_id = entity_id
            self._register_encounter_target(entity_id)
            self.pending_active_boss_id = None
            self.pending_active_boss_time_100ns = 0
            self._resolve_combat_sides()
            return True

        self.pending_active_boss_id = entity_id
        self.pending_active_boss_time_100ns = max(
            self.pending_active_boss_time_100ns, timestamp
        )
        if not self.combat_end_time:
            self.combat_end_time = self.last_damage_time
            self.combat_end_reason = "boss_replaced"
            self._rebuild_member_life_metrics()
        self.archive_current(self.combat_end_reason or "boss_replaced")
        return True

    def ingest_combat_state(self, update: dict) -> bool:
        try:
            entity_id = int(update.get("entity_id", 0) or 0)
            timestamp = int(update.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            not entity_id
            or not timestamp
            or "in_combat" not in update
            or timestamp < self.entity_combat_state_times.get(entity_id, 0)
        ):
            return False
        in_combat = bool(update.get("in_combat"))
        previous = self.entity_combat_states.get(entity_id)
        same_boss_repull = bool(
            in_combat
            and previous is False
            and self._encounter_started()
            and entity_id == self.combat_target_id
            and self._is_priority_target(entity_id)
            and not self._multiphase_encounter()
            and not self._awaiting_long_gap_phase_successor()
            and (
                self.boss_reset_pending_100ns
                or (
                    self.combat_end_time
                    and self.combat_end_reason
                    in {"party_wipe", "target_reset"}
                )
            )
        )
        if same_boss_repull:
            if not self.combat_end_time:
                out_timestamp = int(
                    self.entity_combat_state_times.get(entity_id, 0) or 0
                )
                out_time = (
                    self._event_seconds({"filetime_100ns": out_timestamp})
                    if out_timestamp
                    else 0.0
                )
                self.combat_end_time = max(self.last_damage_time, out_time)
                self.combat_end_reason = "target_reset"
                self._rebuild_member_life_metrics()
            # Some Bosses reuse the exact same entity after a wipe. Their
            # false -> true fight-mode edge is the next pull boundary even if
            # one player's out-of-combat/death edge was absent. Archive and
            # rebase counters before arming the new clock below.
            self.reset(
                keep_identity=True,
                keep_monsters=True,
                archive_reason=self.combat_end_reason or "target_reset",
            )
        if (
            in_combat
            and previous is False
            and self.combat_end_reason in {"party_wipe", "target_reset"}
            and self.combat_end_time
            and entity_id == self.combat_target_id
            and self._is_priority_target(entity_id)
            and self._event_seconds(update) > self.combat_end_time
        ):
            # The confirmed Boss has left combat and entered again after a
            # failed pull. Archive that attempt and clear its metrics now,
            # before the first damage/snapshot arrives in the new attempt.
            # Ordinary phase transitions and unrelated entities cannot reset it.
            self.reset(
                keep_identity=True,
                keep_monsters=True,
                archive_reason=self.combat_end_reason,
            )
        if in_combat and self._begin_boss_after_completed_victory(
            entity_id, timestamp, in_combat=True
        ):
            return True
        self.entity_combat_states[entity_id] = in_combat
        self.entity_combat_state_times[entity_id] = timestamp
        self.latest_network_time_100ns = max(
            self.latest_network_time_100ns, timestamp
        )
        changed = previous is None or previous != in_combat
        if self.long_gap_phase_suspended:
            return changed
        if in_combat:
            linked = self._try_register_simultaneous_boss(entity_id, timestamp)
            boss_clock_armed = self._arm_confirmed_boss_combat_state(entity_id)
            return changed or linked or boss_clock_armed
        if not self.first_damage_time or self.combat_end_time:
            return changed

        monster = self.monsters.get(entity_id)
        if (
            previous is True
            and entity_id == int(self.combat_target_id or 0)
            and monster is not None
            and low_hp_fight_exit_confirms_victory(
                monster.template_id,
                monster.current_hp,
                self._monster_max_hp(monster),
            )
        ):
            # This encounter has no literal HP=0 packet.  Preserve the real
            # non-zero HP timeline, but project the explicit low-HP fight exit
            # as the completed HUD/archive state.
            ended_at = self._event_seconds(update)
            monster.current_hp = 0.0
            monster.death_confirmed = True
            monster.death_time_100ns = max(monster.death_time_100ns, timestamp)
            monster.last_hp_update_100ns = max(
                monster.last_hp_update_100ns, timestamp
            )
            monster.last_update_100ns = max(monster.last_update_100ns, timestamp)
            self.combat_end_time = max(self.first_damage_time, ended_at)
            self.combat_end_reason = "target_defeated"
            self._rebuild_member_life_metrics()
            self.archive_current("target_defeated")
            return True

        if (
            entity_id == int(self.combat_target_id or 0)
            and self._is_dummy_encounter()
        ):
            # A training dummy has no server settlement, but its explicit
            # fight-mode [0] is still an exact disengage boundary.  Freeze the
            # clock there; the next hit (or false -> true edge) will enter the
            # existing new-encounter path and restart at 00:00.
            monster = self.monsters.get(entity_id)
            hp_ceiling = self._monster_max_hp(monster) if monster is not None else 0.0
            if (
                previous is True
                and monster is not None
                and monster.current_hp is not None
                and hp_ceiling > 0
                and 0 < monster.current_hp <= hp_ceiling * DUMMY_TERMINAL_EXIT_HP_RATIO
            ):
                # The server's dummy timer stops at a small non-zero sentinel
                # and emits no later HP=0 packet.  FightMode true -> false is
                # the authoritative end edge; this changes display metadata
                # only and never manufactures additional damage.
                monster.current_hp = 0.0
                monster.last_hp_update_100ns = max(
                    monster.last_hp_update_100ns, timestamp
                )
                monster.last_update_100ns = max(monster.last_update_100ns, timestamp)
            ended_at = self._event_seconds(update)
            self.combat_end_time = max(self.first_damage_time, ended_at)
            self.combat_end_reason = "target_reset"
            self._rebuild_member_life_metrics()
            self.archive_current("target_reset")
            return True

        reset_completed = self._mark_pending_reset_complete()
        monsters = [
            self.monsters.get(entity_id)
            for entity_id in self._ordered_current_boss_target_ids()
        ]
        defeated = any(
            self._mark_target_defeated(monster)
            for monster in monsters
            if monster is not None
        )
        return changed or reset_completed or defeated

    def freeze_verified_encounter(
        self, ended_at_ns: object, result: object
    ) -> bool:
        """Freeze the live clock at an independently matched Boss boundary."""

        normalized_result = str(result or "").upper()
        if normalized_result not in {"VICTORY", "WIPE"}:
            return False
        try:
            timestamp_ns = int(ended_at_ns or 0)
            ended_at = timestamp_ns / 1_000_000_000
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            timestamp_ns <= 0
            or not math.isfinite(ended_at)
            or not self.first_damage_time
            or ended_at < self.first_damage_time - 1.0
        ):
            return False
        ended_at = max(self.first_damage_time, ended_at)
        reason = (
            "target_defeated"
            if normalized_result == "VICTORY"
            else "party_wipe"
        )
        changed = bool(
            self.combat_end_time != ended_at
            or self.combat_end_reason != reason
        )
        self.combat_end_time = ended_at
        self.combat_end_reason = reason
        if self.first_healing_time:
            self.healing_end_time = max(self.first_healing_time, ended_at)
            self.healing_end_reason = reason
        boundary_filetime = (
            timestamp_ns // 100 + 116_444_736_000_000_000
        )
        for target_id in self._current_boss_target_ids():
            self.entity_combat_states[target_id] = False
            self.entity_combat_state_times[target_id] = max(
                boundary_filetime,
                int(self.entity_combat_state_times.get(target_id, 0) or 0),
            )
            if normalized_result == "VICTORY":
                monster = self.monsters.get(target_id)
                if monster is not None:
                    changed |= bool(
                        monster.current_hp != 0.0
                        or not monster.death_confirmed
                    )
                    monster.current_hp = 0.0
                    monster.death_confirmed = True
                    monster.death_time_100ns = max(
                        monster.death_time_100ns, boundary_filetime
                    )
                    monster.last_hp_update_100ns = max(
                        monster.last_hp_update_100ns, boundary_filetime
                    )
                    monster.last_update_100ns = max(
                        monster.last_update_100ns, boundary_filetime
                    )
        self._rebuild_member_life_metrics()
        self.archive_current(reason)
        return changed

    def ingest_profile(self, update: dict) -> bool:
        try:
            entity_id = int(update.get("entity_id", 0))
        except (TypeError, ValueError):
            return False
        if not entity_id:
            return False
        was_priority_target = self._is_priority_target(entity_id)
        changed = False
        rating_changed = False
        raw_character_id = str(update.get("user_token", "") or "").strip()
        if raw_character_id:
            try:
                identity = canonical_character_identity(
                    raw_character_id, allow_ai=True
                )
            except ProfileUploadError:
                identity = None
            if (
                identity is not None
                and self.actor_character_ids.get(entity_id) != identity.canonical
            ):
                self.actor_character_ids[entity_id] = identity.canonical
                changed = True
            if (
                identity is not None
                and identity.kind == "human"
                and entity_id == self.self_id
                and self.self_character_id != identity.canonical
            ):
                self.self_character_id = identity.canonical
                changed = True
        monster = self.monsters.setdefault(entity_id, MonsterStats(entity_id))
        # Once a target has been identified by an exact treatment-dummy
        # template, that identity is authoritative for the rest of the
        # encounter.  Generic profile packets can arrive later with stale
        # Boss/type fields; remember the canonical template before applying
        # any such packet so it cannot downgrade or promote the dummy.
        try:
            existing_healing_template = int(monster.template_id or 0)
        except (TypeError, ValueError, OverflowError):
            existing_healing_template = 0
        if existing_healing_template not in HEALING_TARGET_TEMPLATE_IDS:
            existing_healing_template = 0
        try:
            template_hint = int(update.get("template_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            template_hint = 0
        catalog_non_boss_hint = self._catalog_marks_known_non_boss(
            template_hint or monster.template_id
        )
        healing_target_hint = bool(
            update.get("healing_target") is True
            or template_hint in HEALING_TARGET_TEMPLATE_IDS
            or monster.healing_target
        )
        if healing_target_hint:
            changed |= self._register_healing_target(
                entity_id,
                template_id=template_hint,
            )
        try:
            boss_type_hint = int(update.get("boss_type", -1) or 0)
            boss_rank_hint = int(update.get("boss_rank", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            boss_type_hint = boss_rank_hint = 0
        entity_type_hint = str(update.get("entity_type", "")).casefold()
        known_boss = bool(
            not healing_target_hint
            and not catalog_non_boss_hint
            and (
                self._monster_rank(monster) > 0
            or entity_id == self.combat_target_id
            or entity_id in self.simultaneous_boss_target_ids
            or "boss" in entity_type_hint
            or "首领" in entity_type_hint
            or boss_type_hint == 3
            or boss_rank_hint > 0
            )
        )
        if update.get("name") and not (
            known_boss and boss_name_is_placeholder(update.get("name"))
        ):
            changed |= self.ingest_name(update)
        entity_type = str(update.get("entity_type", "")).strip()[:64]
        if healing_target_hint:
            entity_type = "TrainingDummy"
        elif catalog_non_boss_hint:
            entity_type = "Monster"
        if entity_type and monster.entity_type != entity_type:
            monster.entity_type = entity_type
            changed = True
        try:
            level = int(update["level"])
        except (KeyError, TypeError, ValueError):
            level = None
        if (
            level is not None
            and 1 <= level <= 999
            and not healing_target_hint
            and monster.level != level
        ):
            monster.level = level
            changed = True
        try:
            profession_id = int(update["profession_id"])
        except (KeyError, TypeError, ValueError):
            profession_id = 0
        if profession_id and self.entity_professions.get(entity_id) != profession_id:
            self.entity_professions[entity_id] = profession_id
            changed = True
        if "is_ai" in update:
            is_ai = bool(update.get("is_ai"))
            if (
                entity_id not in self.entity_ai_states
                or self.entity_ai_states[entity_id] != is_ai
            ):
                self.entity_ai_states[entity_id] = is_ai
                changed = True
        try:
            extraordinary_rating = int(update["extraordinary_rating"])
        except (KeyError, TypeError, ValueError, OverflowError):
            extraordinary_rating = None
        if (
            extraordinary_rating is not None
            and extraordinary_rating >= 0
            and self.entity_extraordinary_ratings.get(entity_id)
            != extraordinary_rating
        ):
            self.entity_extraordinary_ratings[entity_id] = extraordinary_rating
            changed = True
            rating_changed = True
        try:
            template_id = int(update["template_id"])
        except (KeyError, TypeError, ValueError):
            template_id = template_hint
        if healing_target_hint:
            canonical_template = (
                existing_healing_template
                or (template_hint if template_hint in HEALING_TARGET_TEMPLATE_IDS else 0)
                or (template_id if template_id in HEALING_TARGET_TEMPLATE_IDS else 0)
            )
            if canonical_template and monster.template_id != canonical_template:
                monster.template_id = canonical_template
                changed = True
        elif template_id and monster.template_id != template_id:
            monster.template_id = template_id
            changed = True
        catalog_non_boss = self._catalog_marks_known_non_boss(
            monster.template_id
        )
        if not healing_target_hint:
            changed |= self._apply_catalog_target_identity(monster)
        try:
            boss_type = int(update["boss_type"])
        except (KeyError, TypeError, ValueError):
            boss_type = None
        if healing_target_hint:
            boss_type = 0
        elif catalog_non_boss:
            metadata = self._catalog_target_metadata(monster.template_id)
            try:
                boss_type = int(metadata.get("boss_type", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                boss_type = 0
        if boss_type is not None and monster.boss_type != boss_type:
            monster.boss_type = boss_type
            changed = True
        try:
            boss_rank = max(0, int(update["boss_rank"]))
        except (KeyError, TypeError, ValueError):
            boss_rank = 0
        if catalog_non_boss:
            boss_rank = 0
        if (boss_rank or catalog_non_boss) and monster.boss_rank != boss_rank:
            monster.boss_rank = boss_rank
            changed = True
        if catalog_non_boss and monster.entity_type != "Monster":
            monster.entity_type = "Monster"
            changed = True
        if catalog_non_boss and self.boss_only:
            current_target_ids = self._current_boss_target_ids()
            if entity_id in current_target_ids:
                remaining_boss_ids = {
                    target_id
                    for target_id in current_target_ids
                    if target_id != entity_id
                    and self._is_priority_target(target_id)
                }
                if remaining_boss_ids:
                    # If a real Boss is already part of the encounter, retain
                    # damage dealt to this ordinary add but never keep it as a
                    # Boss target in its own right.
                    self.combat_target_id = max(
                        remaining_boss_ids,
                        key=lambda target_id: self._monster_priority(
                            self.monsters[target_id]
                        ),
                    )
                    self.active_target_id = self.combat_target_id
                    self.simultaneous_boss_target_ids.discard(entity_id)
                    self.simultaneous_boss_target_order = [
                        target_id
                        for target_id in self.simultaneous_boss_target_order
                        if target_id != entity_id
                    ]
                    self.linked_boss_target_ids.discard(entity_id)
                    self.encounter_add_target_ids.add(entity_id)
                    changed = True
                else:
                    # Exact template metadata arrived after a provisional
                    # promotion. Cancel the false standalone encounter without
                    # archiving it, and baseline any Common counters already
                    # observed so its damage cannot leak into the next Boss.
                    revoked_encounter_id = self.encounter_id
                    self.completed_combats[:] = [
                        record
                        for record in self.completed_combats
                        if record.get("encounter_id") != revoked_encounter_id
                    ]
                    self.reset(
                        keep_identity=True,
                        keep_monsters=True,
                        archive_reason="known_non_boss_identity",
                        archive_current_record=False,
                    )
                    changed = True
        if healing_target_hint:
            # A later generic profile must not promote the treatment dummy to
            # a Boss.  Keep the marker and canonical identity authoritative.
            try:
                current_template = int(monster.template_id or 0)
            except (TypeError, ValueError, OverflowError):
                current_template = 0
            changed |= self._register_healing_target(
                entity_id,
                template_id=(
                    current_template
                    if current_template in HEALING_TARGET_TEMPLATE_IDS
                    else 0
                ),
                level=monster.level or HEALING_TARGET_LEVEL,
            )
            if monster.entity_type != "TrainingDummy":
                monster.entity_type = "TrainingDummy"
                changed = True
            if monster.boss_type != 0:
                monster.boss_type = 0
                changed = True
            if monster.boss_rank:
                monster.boss_rank = 0
                changed = True
            if monster.name != HEALING_TARGET_NAME:
                monster.name = HEALING_TARGET_NAME
                changed = True
            if self.entity_names.get(entity_id) != HEALING_TARGET_NAME:
                self.entity_names[entity_id] = HEALING_TARGET_NAME
                changed = True
        if "encounter_auxiliary" in update:
            encounter_auxiliary = bool(update.get("encounter_auxiliary"))
            if monster.encounter_auxiliary != encounter_auxiliary:
                monster.encounter_auxiliary = encounter_auxiliary
                changed = True
        if "encounter_parent_template_ids" in update:
            raw_parent_ids = update.get("encounter_parent_template_ids", ())
            if not isinstance(raw_parent_ids, (list, tuple, set)):
                raw_parent_ids = (raw_parent_ids,)
            parent_ids: list[int] = []
            for raw_parent_id in raw_parent_ids:
                try:
                    parent_id = int(raw_parent_id or 0)
                except (TypeError, ValueError, OverflowError):
                    continue
                if parent_id:
                    parent_ids.append(parent_id)
            normalized_parent_ids = tuple(sorted(set(parent_ids)))
            if monster.encounter_parent_template_ids != normalized_parent_ids:
                monster.encounter_parent_template_ids = normalized_parent_ids
                changed = True
        auxiliary_metadata = ENCOUNTER_AUXILIARY_TEMPLATES.get(
            int(monster.template_id or 0)
        )
        if auxiliary_metadata is not None:
            canonical_parent_ids = tuple(
                sorted(
                    {
                        int(parent_id)
                        for parent_id in auxiliary_metadata.get(
                            "parent_template_ids", ()
                        )
                        if int(parent_id)
                    }
                )
            )
            canonical_name = str(auxiliary_metadata.get("name", "")).strip()
            if not monster.encounter_auxiliary:
                monster.encounter_auxiliary = True
                changed = True
            if monster.encounter_parent_template_ids != canonical_parent_ids:
                monster.encounter_parent_template_ids = canonical_parent_ids
                changed = True
            if monster.entity_type != "Monster":
                monster.entity_type = "Monster"
                changed = True
            if canonical_name:
                if self.entity_names.get(entity_id) != canonical_name:
                    self.entity_names[entity_id] = canonical_name
                    changed = True
                if monster.name != canonical_name:
                    monster.name = canonical_name
                    changed = True
        name = self.entity_names.get(entity_id, "")
        if name and monster.name != name:
            monster.name = name
            changed = True
        confirmed_non_player = bool(
            monster.encounter_auxiliary
            or catalog_non_boss
            or monster.boss_rank > 0
            or (
                monster.boss_type == 3
                and monster.entity_type.casefold() not in {"player", "role"}
            )
        )
        try:
            timestamp = int(update.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            timestamp = 0
        if timestamp and (confirmed_non_player or monster.healing_target):
            monster.last_update_100ns = max(monster.last_update_100ns, timestamp)
            self.target_activity_100ns[entity_id] = max(
                self.target_activity_100ns.get(entity_id, 0), timestamp
            )
            self.latest_network_time_100ns = max(
                self.latest_network_time_100ns, timestamp
            )
        non_player_changed = False
        if confirmed_non_player:
            non_player_changed = self._mark_non_player_actor(entity_id)
            changed |= non_player_changed
        if entity_id in self.closed_encounter_target_ids:
            return changed
        if self._is_priority_target(entity_id):
            self.awaiting_post_exit_context = False
        requires_recompute = bool(
            non_player_changed
            or was_priority_target != self._is_priority_target(entity_id)
        )
        if changed and requires_recompute:
            self._resolve_combat_sides()
            if entity_id in self._current_boss_target_ids() and any(
                int(event.get("target_id", 0)) == entity_id
                and int(event.get("damage", 0)) > 0
                for event in self.events
            ):
                self.encounter_target_ids.add(entity_id)
            self._recompute()
        if self.long_gap_phase_suspended:
            return changed
        replacement_wipe = bool(
            timestamp
            and self._is_priority_target(entity_id)
            and self._mark_party_wipe_from_replacement(
                monster,
                self._event_seconds({"filetime_100ns": timestamp}),
            )
        )
        self._mark_target_defeated(monster)
        if (
            changed
            and self.combat_end_time
            and entity_id in self._current_boss_target_ids()
            and update.get("death_confirmed") is True
            and monster.current_hp is not None
            and monster.current_hp <= 0
            and timestamp
        ):
            event_time = self._event_seconds({"filetime_100ns": timestamp})
            if 0 <= event_time - self.combat_end_time <= 2.0:
                # Settlement/FightMode can archive a result before the trailing
                # confirmed HP=0 packet.  Refresh the same encounter so its
                # history and retained HUD both receive the terminal sample.
                self._queue_current_record_refresh()
        replayed = False
        if self._is_priority_target(entity_id):
            replayed |= self._resolve_known_pending_target_events()
        replayed |= self._resolve_pending_target_events(entity_id)
        simultaneous_linked = bool(
            timestamp
            and self.entity_combat_states.get(entity_id) is True
            and self._try_register_simultaneous_boss(entity_id, timestamp)
        )
        boss_clock_armed = self._arm_confirmed_boss_combat_state(entity_id)
        if rating_changed:
            self._queue_current_record_refresh()
        return (
            changed
            or replayed
            or replacement_wipe
            or simultaneous_linked
            or boss_clock_armed
        )

    def ingest_fight_attributes(self, update: dict) -> bool:
        """Store exact current-session player attributes without estimating rates."""

        try:
            entity_id = int(update.get("entity_id", 0) or 0)
            observed_at = int(update.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return False
        if not entity_id or entity_id in self.non_player_actor_ids:
            return False
        allowed = (
            "physical_critical",
            "magical_critical",
            "physical_penetration",
            "magical_penetration",
        )
        parsed: dict[str, float] = {}
        for key in allowed:
            try:
                value = float(update[key])
            except (KeyError, TypeError, ValueError, OverflowError):
                continue
            if math.isfinite(value) and 0.0 <= value <= 1_000_000_000.0:
                parsed[key] = value
        if not parsed:
            return False
        previous_time = self.entity_fight_attribute_times.get(entity_id, 0)
        current = self.entity_fight_attributes.setdefault(entity_id, {})
        changed = any(current.get(key) != value for key, value in parsed.items())
        current.update(parsed)
        if observed_at:
            self.entity_fight_attribute_times[entity_id] = max(
                previous_time, observed_at
            )
        return changed

    def ingest_monster(self, update: dict) -> bool:
        try:
            entity_id = int(update.get("entity_id", 0))
        except (TypeError, ValueError):
            return False
        if not entity_id:
            return False
        previous_monster = self.monsters.get(entity_id)
        if previous_monster is not None and update.get('hp_source_reset'):
            previous_monster.current_hp = None
            previous_monster.max_hp = None
            previous_monster.observed_max_hp = None
            previous_monster.observed_damage_taken = 0.0
            previous_monster.last_hp_update_100ns = 0
            previous_monster.death_confirmed = False
            previous_monster.death_time_100ns = 0
        timestamp = int(update.get('filetime_100ns', 0) or 0)
        if previous_monster is not None and timestamp and timestamp < previous_monster.last_hp_update_100ns:
            # Native metadata and network batches can arrive interleaved.
            # An older HP field must not resurrect a defeated target, move
            # the bar backwards or arm a false wipe/reset.
            update = dict(update)
            for field in ('current_hp', 'reset_candidate_hp', 'death_confirmed'):
                update.pop(field, None)
        elif (
            previous_monster is not None
            and previous_monster.last_hp_update_100ns
            and not timestamp
            and not update.get('hp_source_reset')
        ):
            # Some delayed metadata batches contain no capture timestamp.  If
            # the entity already has a timestamped HP sample, accepting an
            # un-timestamped HP value would let an old cache resurrect or
            # refill the live Boss bar.  Keep identity/metadata from the
            # batch, but never let it replace the ordered HP stream.
            update = dict(update)
            for field in (
                'current_hp',
                'max_hp',
                'reset_candidate_hp',
                'death_confirmed',
            ):
                update.pop(field, None)
        if (
            previous_monster is not None
            and previous_monster.current_hp == 0
            and previous_monster.death_confirmed
            and self.combat_end_reason == "target_defeated"
            and entity_id in self._current_boss_target_ids()
            and not update.get("hp_source_reset")
            and "current_hp" in update
        ):
            try:
                reviving_completed_boss = float(update["current_hp"]) > 0
            except (TypeError, ValueError, OverflowError):
                reviving_completed_boss = False
            if reviving_completed_boss:
                update = dict(update)
                update.pop("current_hp", None)
                update.pop("reset_candidate_hp", None)
                update.pop("death_confirmed", None)
        if (
            previous_monster is not None
            and previous_monster.current_hp is not None
            and previous_monster.current_hp > 0
            and "current_hp" in update
            and not update.get("death_confirmed")
        ):
            try:
                unconfirmed_zero = float(update["current_hp"]) == 0
            except (TypeError, ValueError, OverflowError):
                unconfirmed_zero = False
            active_boss_zero = bool(
                unconfirmed_zero
                and entity_id in self._current_boss_target_ids()
                and self._encounter_started()
                and self.combat_end_reason
                not in {
                    "party_wipe",
                    "target_reset",
                    "space_transition",
                    "scene_change",
                    "scene_refresh",
                }
            )
            if unconfirmed_zero and not active_boss_zero:
                # A scene cleanup HP=0 must not erase the last live Boss value.
                update = dict(update)
                update.pop("current_hp", None)
        previous_update_100ns = (
            previous_monster.last_update_100ns
            if previous_monster is not None
            else 0
        )
        if (
            previous_monster is not None
            and self._stale_completed_simultaneous_boss_hp(
                previous_monster, update
            )
        ):
            update = dict(update)
            update.pop("current_hp", None)
            update.pop("reset_candidate_hp", None)
        profile_changed = self.ingest_profile(update)
        monster = self.monsters.setdefault(entity_id, MonsterStats(entity_id))
        previous_current_hp = monster.current_hp
        changed = False
        for field_name in ("current_hp", "max_hp"):
            if field_name not in update:
                continue
            try:
                value = max(0.0, float(update[field_name]))
            except (TypeError, ValueError):
                continue
            if (
                field_name == "max_hp"
                and entity_id in self._current_boss_target_ids()
                and self.first_damage_time
                and monster.max_hp is not None
                and monster.max_hp > 0
            ):
                value = max(value, monster.max_hp)
            if getattr(monster, field_name) != value:
                setattr(monster, field_name, value)
                changed = True
            if field_name == "current_hp" and value > 0:
                monster.death_time_100ns = 0
                monster.death_confirmed = False
                observed = monster.observed_max_hp or 0.0
                if value > observed:
                    monster.observed_max_hp = value
                    changed = True
        timestamp = int(update.get("filetime_100ns", 0) or 0)
        if timestamp:
            monster.last_update_100ns = max(monster.last_update_100ns, timestamp)
            if "current_hp" in update:
                monster.last_hp_update_100ns = max(
                    monster.last_hp_update_100ns, timestamp
                )
            self.target_activity_100ns[entity_id] = max(
                self.target_activity_100ns.get(entity_id, 0), timestamp
            )
            self.latest_network_time_100ns = max(
                self.latest_network_time_100ns, timestamp
            )
            if (
                "current_hp" in update
                and previous_current_hp is not None
                and monster.current_hp is not None
                and monster.current_hp < previous_current_hp
                and (
                    not previous_update_100ns
                    or timestamp >= previous_update_100ns
                )
            ):
                if self._is_priority_target(entity_id):
                    monster.observed_damage_taken += (
                        previous_current_hp - monster.current_hp
                    )
                    changed = True
                monster.last_hp_drop_100ns = max(
                    monster.last_hp_drop_100ns, timestamp
                )
                self._arm_team_encounter(entity_id, timestamp)
            try:
                reset_candidate_hp = float(update["reset_candidate_hp"])
            except (KeyError, TypeError, ValueError, OverflowError):
                reset_candidate_hp = -1.0
            if (
                reset_candidate_hp >= 0
                and entity_id in self._current_boss_target_ids()
                and self.first_damage_time
                and not self.combat_end_time
                and previous_current_hp is not None
            ):
                hp_ceiling = self._monster_max_hp(monster)
                event_time = self._event_seconds(
                    {"filetime_100ns": timestamp}
                )
                missing_hp = max(0.0, hp_ceiling - previous_current_hp)
                if (
                    hp_ceiling > 0
                    and reset_candidate_hp >= hp_ceiling * 0.995
                    and missing_hp >= hp_ceiling * 0.2
                ):
                    self.boss_reset_pending_100ns = max(
                        self.boss_reset_pending_100ns, timestamp
                    )
                    self._mark_pending_reset_complete()
            if "current_hp" in update and monster.current_hp is not None:
                if monster.current_hp <= 0:
                    monster.death_time_100ns = max(
                        monster.death_time_100ns, timestamp
                    )
                    if update.get("death_confirmed"):
                        monster.death_confirmed = True
                elif (
                    entity_id in self._current_boss_target_ids()
                    and self.first_damage_time
                    and not self.combat_end_time
                    and previous_current_hp is not None
                    and monster.current_hp > previous_current_hp
                ):
                    hp_ceiling = self._monster_max_hp(monster)
                    event_time = self._event_seconds(
                        {"filetime_100ns": timestamp}
                    )
                    missing_hp_before_reset = max(
                        0.0, hp_ceiling - previous_current_hp
                    )
                    recovered_hp = monster.current_hp - previous_current_hp
                    meaningful_reset = max(1.0, hp_ceiling * 0.005)
                    hard_reset = missing_hp_before_reset >= hp_ceiling * 0.2
                    if (
                        hp_ceiling > 0
                        and missing_hp_before_reset >= meaningful_reset
                        and recovered_hp >= meaningful_reset
                        and monster.current_hp >= hp_ceiling * 0.995
                        and (
                            hard_reset
                            or event_time - self.last_damage_time
                            >= self.idle_gap
                        )
                    ):
                        # Full HP is only the first half of a reset signal. Keep
                        # the live encounter intact until fight-mode confirms
                        # that its combatants have left combat; ordinary Boss
                        # healing must not interrupt real-time DPS.
                        self.boss_reset_pending_100ns = max(
                            self.boss_reset_pending_100ns, timestamp
                        )
                        self._mark_pending_reset_complete()
        name = self.entity_names.get(entity_id, "")
        if name:
            monster.name = name
        if self.long_gap_phase_suspended:
            return changed or profile_changed
        verified_partner_linked = bool(
            timestamp
            and self._try_register_verified_simultaneous_boss_partner(timestamp)
        )
        if self._is_priority_target(entity_id) and any(
            int(event.get("target_id", 0)) == entity_id
            and int(event.get("attacker_id", 0)) in self.friendly_ids
            for event in self.events
        ):
            self.encounter_target_ids.add(entity_id)
        self._mark_target_defeated(monster)
        simultaneous_linked = bool(
            timestamp
            and self.entity_combat_states.get(entity_id) is True
            and self._try_register_simultaneous_boss(entity_id, timestamp)
        )
        return (
            changed
            or profile_changed
            or verified_partner_linked
            or simultaneous_linked
        )

    def _opening_team_counter_rebase(
        self, server_time: int, timestamp: int
    ) -> bool:
        """Recognize a verified Boss whose server counters start a few seconds late."""

        monster = self.monsters.get(int(self.combat_target_id or 0))
        template_id = int(monster.template_id or 0) if monster is not None else 0
        if (
            template_id not in OPENING_TEAM_COUNTER_REBASE_BOSS_TEMPLATE_IDS
            or not self.first_damage_time
            or self.combat_end_time
            or self.pending_active_boss_id
            or not server_time
            or not timestamp
        ):
            return False
        if not any(
            state.server_time and server_time > state.server_time
            for state in self.team_damage_states.values()
        ):
            return False
        event_time = self._event_seconds({"filetime_100ns": timestamp})
        encounter_age = event_time - self.first_damage_time
        return 0.0 <= encounter_age <= OPENING_TEAM_COUNTER_REBASE_SECONDS

    def _live_boss_counter_regression(self) -> bool:
        """An individual regressed counter cannot reset a demonstrably live pull."""
        if (not self.first_damage_time or self.combat_end_time
                or self.pending_active_boss_id or self.boss_reset_pending_100ns):
            return False
        monster = self.monsters.get(int(self.combat_target_id or 0))
        if monster is None or monster.death_confirmed or self._is_dummy_target(monster.entity_id):
            return False
        if monster.current_hp is not None and monster.current_hp <= 0:
            return False
        ceiling = self._monster_max_hp(monster)
        wounded = bool(monster.current_hp is not None and ceiling > 0
                       and 0 < monster.current_hp < ceiling * .995)
        return wounded or self.entity_combat_states.get(monster.entity_id) is True

    def _begin_team_counter_reset(
        self, server_time: int, timestamp: int
    ) -> None:
        pending_target_id = int(self.pending_active_boss_id or 0)
        previous_update = self.team_server_update_100ns
        first_damage_100ns = (
            int(
                self.first_damage_time * 10_000_000
                + 116_444_736_000_000_000
            )
            if self.first_damage_time
            else 0
        )
        current_started_after_previous_snapshot = bool(
            first_damage_100ns
            and previous_update
            and first_damage_100ns > previous_update
        )
        has_current_encounter = bool(
            self.first_damage_time
            and (
                self.events
                or any(
                    state.accepted_damage > 0
                    for state in self.team_damage_states.values()
                )
            )
        )
        rebase_opening_counters = self._opening_team_counter_rebase(
            server_time, timestamp
        )
        if (
            has_current_encounter
            and not current_started_after_previous_snapshot
            and not rebase_opening_counters
        ):
            self.reset(
                keep_identity=True,
                keep_monsters=True,
                preserve_active_target=not pending_target_id,
                archive_reason=self.combat_end_reason or "team_counter_reset",
            )
        if pending_target_id and self._is_priority_target(pending_target_id):
            self.combat_target_id = pending_target_id
            self.active_target_id = pending_target_id
            self._register_encounter_target(pending_target_id)
            self.pending_active_boss_id = None
            self.pending_active_boss_time_100ns = 0
            self._resolve_combat_sides()
        for state in self.team_damage_states.values():
            state.last_absolute = 0
            state.baseline_absolute = 0
            state.has_snapshot = False
            state.authoritative_snapshot = False
            state.accepted_damage = 0
            state.carried_damage = 0
            state.snapshot_time_100ns = 0
            state.baseline_snapshot_time_100ns = (
                self.encounter_start_signal_100ns
            )
            state.server_time = 0
            state.first_time = 0.0
            state.last_time = 0.0
            state.live_dps = None
            state.live_dps_damage = 0
        for state in self.team_taken_states.values():
            state.last_absolute = 0
            state.baseline_absolute = 0
            state.has_snapshot = False
            state.accepted_taken = 0
            state.carried_taken = 0
            state.snapshot_time_100ns = 0
            state.baseline_snapshot_time_100ns = self.encounter_start_signal_100ns
            state.server_time = 0
            state.exact_for_encounter = False
        for state in self.team_healing_states.values():
            state.last_absolute = 0
            state.baseline_absolute = 0
            state.has_snapshot = False
            state.accepted_effective_healing = 0
            state.carried_effective_healing = 0
            state.snapshot_time_100ns = 0
            state.baseline_snapshot_time_100ns = self.encounter_start_signal_100ns
            state.server_time = 0
            state.exact_for_encounter = False
        self.team_server_time = max(0, int(server_time))
        self.team_server_update_100ns = max(0, int(timestamp))
        self.team_reset_pending = True
        self.team_zero_baseline_signal_100ns = (
            self.encounter_start_signal_100ns
        )

    def _arm_team_encounter(self, target_id: int, timestamp: int) -> bool:
        """Freeze pre-pull team counters on a confirmed encounter edge."""
        if (
            not target_id
            or not timestamp
            or self.combat_end_time
            or not self._is_priority_target(target_id)
        ):
            return False
        self._clear_targetless_team_statistics()
        if self.first_damage_time or self.encounter_start_signal_100ns:
            existing_signal = self.encounter_start_signal_100ns
            if not existing_signal and self.first_damage_time:
                existing_signal = int(
                    self.first_damage_time * 10_000_000
                    + 116_444_736_000_000_000
                )
            if (
                target_id != self.combat_target_id
                or not existing_signal
                or timestamp >= existing_signal
            ):
                return False
            # Buffered Boss identity/HP packets can be resolved after the
            # first positive TeamStats row even though their game timestamp is
            # earlier. Backdate only the clock; the already-frozen absolute
            # counter baselines remain valid and must not be applied twice.
            self.encounter_start_signal_100ns = timestamp
            if self.team_zero_baseline_signal_100ns == existing_signal:
                self.team_zero_baseline_signal_100ns = timestamp
            start_time = self._event_seconds({"filetime_100ns": timestamp})
            self.first_damage_time = (
                min(self.first_damage_time, start_time)
                if self.first_damage_time
                else start_time
            )
            self.last_damage_time = max(self.last_damage_time, start_time)
            self._rebuild_member_life_metrics()
            return True
        if self.combat_target_id is None:
            self.combat_target_id = target_id
        elif self.combat_target_id != target_id:
            return False
        had_pre_pull_snapshot = any(
            state.has_snapshot for state in self.team_damage_states.values()
        ) or any(
            state.has_snapshot for state in self.team_taken_states.values()
        ) or any(state.has_snapshot for state in self.team_healing_states.values())
        self.encounter_start_signal_100ns = timestamp
        self.team_zero_baseline_signal_100ns = (
            0 if had_pre_pull_snapshot else timestamp
        )
        self._register_encounter_target(target_id)
        for state in self.team_damage_states.values():
            if not state.has_snapshot:
                continue
            preserve_zero_baseline = bool(
                state.last_absolute > 0
                and state.baseline_absolute == 0
                and state.baseline_snapshot_time_100ns > 0
            )
            # A complete Common snapshot can be processed while the Boss
            # identity is still pending.  Its exact zero baseline must survive
            # when earlier, timestamped opening hits are replayed afterwards;
            # rebasing to that already-positive snapshot would drop all damage
            # dealt before identity confirmation.
            if not preserve_zero_baseline:
                state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = timestamp
            state.accepted_damage = 0
            state.carried_damage = 0
            state.first_time = 0.0
            state.last_time = 0.0
            state.live_dps = None
            state.live_dps_damage = 0
        for state in self.team_taken_states.values():
            if not state.has_snapshot:
                continue
            state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = timestamp
            state.accepted_taken = 0
            state.carried_taken = 0
            state.exact_for_encounter = True
        for state in self.team_healing_states.values():
            if not state.has_snapshot:
                continue
            state.baseline_absolute = state.last_absolute
            state.baseline_snapshot_time_100ns = timestamp
            state.accepted_effective_healing = 0
            state.carried_effective_healing = 0
            state.exact_for_encounter = True
        # A confirmed Boss encounter edge can precede this character's first
        # hit or the next positive Common snapshot. Promote it to the live
        # clock immediately so every role observes the same available edge.
        start_time = self._event_seconds({"filetime_100ns": timestamp})
        self.first_damage_time = start_time
        self.last_damage_time = max(self.last_damage_time, start_time)
        self._rebuild_member_life_metrics()
        self._resolve_combat_sides()
        return True

    def _arm_confirmed_boss_combat_state(self, entity_id: int) -> bool:
        """Start from a captured Boss fight-mode edge once identity is known."""
        monster = self.monsters.get(int(entity_id or 0))
        if (
            monster is None
            or self.entity_combat_states.get(monster.entity_id) is not True
            or self._monster_rank(monster) <= 0
            or self._is_dummy_target(monster.entity_id)
        ):
            return False
        timestamp = int(
            self.entity_combat_state_times.get(monster.entity_id, 0) or 0
        )
        return self._arm_team_encounter(monster.entity_id, timestamp)

    def _apply_team_zero_baseline(self, state: TeamDamageState) -> None:
        signal = self.team_zero_baseline_signal_100ns
        if (
            signal
            and signal == self.encounter_start_signal_100ns
            and not state.baseline_snapshot_time_100ns
        ):
            state.baseline_absolute = 0
            state.baseline_snapshot_time_100ns = signal

    def ingest_team_stat(self, update: dict) -> bool:
        if self.awaiting_post_exit_context:
            return False
        invalid = [key for key in ('absolute_damage', 'absolute_taken', 'absolute_effective_healing')
                   if key in update and parse_combat_amount(update[key]) is None]
        if invalid:
            update = dict(update)
            for key in invalid:
                update.pop(key, None)
        raw_team_tokens = update.get("team_tokens")
        if isinstance(raw_team_tokens, (list, tuple, set)):
            parsed_team_tokens = {
                token
                for value in raw_team_tokens
                if (token := str(value or "").strip()[:128])
            }
            if parsed_team_tokens:
                self.party_user_tokens = parsed_team_tokens
        if self.long_gap_phase_suspended:
            return self._ingest_suspended_long_gap_team_stat(update)
        changed = False
        if "absolute_damage" in update:
            changed |= self._ingest_team_damage_stat(update)
        if "absolute_taken" in update:
            changed |= self._ingest_team_taken_stat(update)
        if "absolute_effective_healing" in update:
            changed |= self._ingest_team_healing_stat(update)
        return changed

    def _ingest_team_healing_stat(self, update: dict) -> bool:
        try:
            actor_id = int(update.get("actor_id", 0) or 0)
            absolute_healing = max(
                0, int(update.get("absolute_effective_healing", 0) or 0)
            )
            timestamp = int(update.get("filetime_100ns", 0) or 0)
            server_time = max(0, int(update.get("server_time", 0) or 0))
            omitted_zero = bool(update.get("healing_omitted_zero"))
            full_snapshot = bool(update.get("full_snapshot"))
        except (TypeError, ValueError, OverflowError):
            return False
        if self.long_gap_phase_suspended:
            return False
        if (
            not actor_id
            or not timestamp
            or actor_id in self.non_player_actor_ids
        ):
            return False

        state = self.team_healing_states.setdefault(
            actor_id, TeamHealingState(actor_id)
        )
        if omitted_zero and state.has_snapshot and state.last_absolute > 0:
            starts_new_epoch = bool(
                full_snapshot and server_time and server_time != state.server_time
            )
            if not starts_new_epoch:
                return False
        if state.server_time and server_time and server_time < state.server_time:
            return False
        if (
            state.snapshot_time_100ns
            and timestamp < state.snapshot_time_100ns
            and (not server_time or server_time == state.server_time)
        ):
            return False

        previous_healing = state.accepted_effective_healing
        previous_exact = state.exact_for_encounter
        had_snapshot = state.has_snapshot
        first_full_snapshot = bool(full_snapshot and not had_snapshot)
        if had_snapshot and absolute_healing < state.last_absolute:
            if self._preserve_continuous_phase_counters():
                state.carried_effective_healing = (
                    state.accepted_effective_healing
                )
                state.baseline_absolute = absolute_healing
                state.baseline_snapshot_time_100ns = timestamp
            else:
                state.carried_effective_healing = 0
                state.baseline_absolute = 0
                state.baseline_snapshot_time_100ns = (
                    self.encounter_start_signal_100ns
                )
                state.exact_for_encounter = bool(
                    self.encounter_start_signal_100ns
                )
                had_snapshot = False

        state.last_absolute = absolute_healing
        state.has_snapshot = True
        state.snapshot_time_100ns = max(state.snapshot_time_100ns, timestamp)
        state.server_time = server_time or state.server_time

        encounter_signal = self.encounter_start_signal_100ns
        encounter_active = bool(
            encounter_signal or self.first_damage_time or self.first_healing_time
        )
        if not encounter_active:
            state.baseline_absolute = absolute_healing
            state.baseline_snapshot_time_100ns = timestamp
            state.accepted_effective_healing = 0
            state.carried_effective_healing = 0
            state.exact_for_encounter = False
        else:
            if not had_snapshot and not state.baseline_snapshot_time_100ns:
                if encounter_signal and (
                    self.team_zero_baseline_signal_100ns == encounter_signal
                    or (first_full_snapshot and absolute_healing == 0)
                ):
                    state.baseline_absolute = 0
                    state.baseline_snapshot_time_100ns = encounter_signal
                    state.exact_for_encounter = True
                else:
                    state.baseline_absolute = absolute_healing
                    state.baseline_snapshot_time_100ns = timestamp
                    state.exact_for_encounter = False
            elif (
                encounter_signal
                and state.baseline_snapshot_time_100ns <= encounter_signal
            ):
                state.exact_for_encounter = True
            state.accepted_effective_healing = (
                state.carried_effective_healing
                + max(0, absolute_healing - state.baseline_absolute)
            )

        changed = bool(
            previous_healing != state.accepted_effective_healing
            or previous_exact != state.exact_for_encounter
        )
        if changed:
            event_time = self._event_seconds(update)
            if state.accepted_effective_healing > 0:
                if not self.first_healing_time:
                    self.first_healing_time = event_time
                if state.accepted_effective_healing != previous_healing:
                    self.last_healing_time = max(self.last_healing_time, event_time)
                self._update_encounter_roster(actor_id)
            self.healing_revision += 1
            self.healing_summary_cache_key = None
            self.healing_summary_cache = None
            if self.combat_end_time or self.healing_end_time:
                self._queue_current_record_refresh()
        self.latest_network_time_100ns = max(
            self.latest_network_time_100ns, timestamp
        )
        return changed

    def _ingest_team_taken_stat(self, update: dict) -> bool:
        try:
            actor_id = int(update.get("actor_id", 0) or 0)
            absolute_taken = max(0, int(update.get("absolute_taken", 0) or 0))
            timestamp = int(update.get("filetime_100ns", 0) or 0)
            server_time = max(0, int(update.get("server_time", 0) or 0))
            omitted_zero = bool(update.get("taken_omitted_zero"))
            full_snapshot = bool(update.get("full_snapshot"))
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            not actor_id
            or not timestamp
            or actor_id in self.non_player_actor_ids
        ):
            return False
        state = self.team_taken_states.setdefault(actor_id, TeamTakenState(actor_id))
        if omitted_zero and state.has_snapshot and state.last_absolute > 0:
            starts_new_epoch = bool(
                full_snapshot and server_time and server_time != state.server_time
            )
            if not starts_new_epoch:
                return False
        if state.server_time and server_time and server_time < state.server_time:
            return False
        if (
            state.snapshot_time_100ns
            and timestamp < state.snapshot_time_100ns
            and (not server_time or server_time == state.server_time)
        ):
            return False

        previous_taken = state.accepted_taken
        previous_exact = state.exact_for_encounter
        had_snapshot = state.has_snapshot
        first_full_snapshot = bool(full_snapshot and not had_snapshot)
        if had_snapshot and absolute_taken < state.last_absolute:
            if self._preserve_continuous_phase_counters():
                state.carried_taken = state.accepted_taken
                state.baseline_absolute = absolute_taken
                state.baseline_snapshot_time_100ns = timestamp
            else:
                state.carried_taken = 0
                state.baseline_absolute = 0
                state.baseline_snapshot_time_100ns = (
                    self.encounter_start_signal_100ns
                )
                state.exact_for_encounter = bool(
                    self.encounter_start_signal_100ns
                )
                had_snapshot = False

        state.last_absolute = absolute_taken
        state.has_snapshot = True
        state.snapshot_time_100ns = max(state.snapshot_time_100ns, timestamp)
        state.server_time = server_time or state.server_time

        encounter_signal = self.encounter_start_signal_100ns
        encounter_active = bool(encounter_signal or self.first_damage_time)
        if not encounter_active:
            state.baseline_absolute = absolute_taken
            state.baseline_snapshot_time_100ns = timestamp
            state.accepted_taken = 0
            state.carried_taken = 0
            state.exact_for_encounter = False
        else:
            if not had_snapshot and not state.baseline_snapshot_time_100ns:
                if encounter_signal and (
                    self.team_zero_baseline_signal_100ns == encounter_signal
                    or (first_full_snapshot and absolute_taken == 0)
                ):
                    state.baseline_absolute = 0
                    state.baseline_snapshot_time_100ns = encounter_signal
                    state.exact_for_encounter = True
                else:
                    state.baseline_absolute = absolute_taken
                    state.baseline_snapshot_time_100ns = timestamp
                    state.exact_for_encounter = False
            elif (
                encounter_signal
                and state.baseline_snapshot_time_100ns <= encounter_signal
            ):
                state.exact_for_encounter = True
            state.accepted_taken = state.carried_taken + max(
                0, absolute_taken - state.baseline_absolute
            )
        self.latest_network_time_100ns = max(
            self.latest_network_time_100ns, timestamp
        )
        return bool(
            previous_taken != state.accepted_taken
            or previous_exact != state.exact_for_encounter
        )

    def _clear_targetless_team_statistics(self) -> bool:
        changed = bool(
            self.targetless_team_states
            or self.targetless_team_started_at
            or self.targetless_team_full_snapshot_seen
            or self.targetless_team_pending_rows
        )
        self.targetless_team_states.clear()
        self.targetless_team_server_time = 0
        self.targetless_team_started_at = 0.0
        self.targetless_team_zero_snapshot_at = 0.0
        self.targetless_team_last_progress_at = 0.0
        self.targetless_team_last_snapshot_at = 0.0
        self.targetless_team_duration_seconds = 0.0
        self.targetless_team_server_duration_seconds = 0.0
        self.targetless_team_full_snapshot_seen = False
        self.targetless_team_pending_time_100ns = 0
        self.targetless_team_pending_tokens.clear()
        self.targetless_team_pending_rows.clear()
        self.targetless_team_last_committed_time_100ns = 0
        return changed

    def _targetless_team_mode_available(self) -> bool:
        if self._encounter_started():
            return False
        for target_id in (
            int(self.combat_target_id or 0),
            int(self.pending_active_boss_id or 0),
        ):
            if target_id and self._is_priority_target(target_id):
                return False
        return True

    def _commit_targetless_team_snapshot(self, timestamp: int) -> bool:
        expected_tokens = set(self.targetless_team_pending_tokens)
        pending_rows = dict(self.targetless_team_pending_rows)
        if (
            len(expected_tokens) < 2
            or not expected_tokens.issubset(pending_rows)
            or timestamp <= self.targetless_team_last_committed_time_100ns
        ):
            return False

        entries = [pending_rows[token] for token in sorted(expected_tokens)]
        previous_states = list(self.targetless_team_states.values())
        previous_by_token = {
            state.user_token: state
            for state in previous_states
            if state.user_token
        }
        previous_total = sum(state.total_damage for state in previous_states)
        previous_absolute_total = sum(
            state.last_absolute for state in previous_states
        )
        previous_snapshot_at = self.targetless_team_last_snapshot_at

        epochs = {row[2] for row in entries if row[2] > 0}
        common_epoch = next(iter(epochs)) if len(epochs) == 1 else 0
        positive_comparisons = [
            (previous_by_token[token], absolute_damage)
            for token, (_actor_id, absolute_damage, _server_time, _seconds)
            in zip(sorted(expected_tokens), entries)
            if token in previous_by_token
            and previous_by_token[token].last_absolute > 0
        ]
        all_positive_counters_reset = bool(
            len(positive_comparisons) >= 2
            and all(
                absolute_damage < state.last_absolute
                for state, absolute_damage in positive_comparisons
            )
        )
        new_server_epoch = bool(
            common_epoch
            and self.targetless_team_server_time
            and common_epoch != self.targetless_team_server_time
        )
        incoming_absolute_total = sum(row[1] for row in entries)
        round_reset = bool(
            all_positive_counters_reset
            or (
                new_server_epoch
                and previous_absolute_total > 0
                and incoming_absolute_total < previous_absolute_total
            )
        )
        if round_reset:
            self._clear_targetless_team_statistics()
            previous_by_token = {}
            previous_total = 0
            previous_snapshot_at = 0.0

        event_time = self._event_seconds({"filetime_100ns": timestamp})
        next_states: dict[int, TargetlessTeamDamageState] = {}
        max_server_duration = 0
        for token in sorted(expected_tokens):
            actor_id, absolute_damage, server_time, combat_seconds_total = (
                pending_rows[token]
            )
            previous = previous_by_token.get(token)
            carried_damage = previous.carried_damage if previous else 0
            if previous is not None and absolute_damage < previous.last_absolute:
                carried_damage += previous.last_absolute
            state = TargetlessTeamDamageState(
                actor_id=actor_id,
                user_token=token,
                last_absolute=absolute_damage,
                carried_damage=carried_damage,
                total_damage=carried_damage + absolute_damage,
                snapshot_time_100ns=timestamp,
                server_time=server_time,
                combat_seconds_total=combat_seconds_total,
                live_dps=previous.live_dps if previous else None,
                live_dps_damage=(
                    previous.live_dps_damage if previous else 0
                ),
            )
            next_states[actor_id] = state
            max_server_duration = max(
                max_server_duration, combat_seconds_total
            )

        self.targetless_team_states = next_states
        self.targetless_team_server_time = common_epoch
        self.targetless_team_last_snapshot_at = event_time
        self.targetless_team_last_committed_time_100ns = timestamp
        self.targetless_team_full_snapshot_seen = True
        self.targetless_team_server_duration_seconds = max(
            self.targetless_team_server_duration_seconds,
            float(max_server_duration),
        )
        next_total = sum(state.total_damage for state in next_states.values())
        if not self.targetless_team_started_at and next_total > 0:
            official_duration = max(
                (
                    self._live_dps_duration_for_snapshot(
                        event_time=event_time,
                        server_time=state.server_time,
                        combat_seconds_total=state.combat_seconds_total,
                        fallback_duration=0.0,
                    )
                    for state in next_states.values()
                ),
                default=0.0,
            )
            if official_duration > 0:
                self.targetless_team_started_at = event_time - official_duration
        if (
            not self.targetless_team_started_at
            and next_total == 0
            and common_epoch
            and (
                not self.targetless_team_zero_snapshot_at
                or (new_server_epoch and previous_total <= 0)
            )
        ):
            self.targetless_team_zero_snapshot_at = event_time
        progressed = bool(
            not round_reset
            and previous_snapshot_at > 0
            and next_total > previous_total
        )
        if progressed:
            if not self.targetless_team_started_at:
                self.targetless_team_started_at = (
                    self.targetless_team_zero_snapshot_at
                    or min(previous_snapshot_at, event_time)
                )
            self.targetless_team_last_progress_at = event_time
        if self.targetless_team_started_at:
            observed_duration = max(
                0.0, event_time - self.targetless_team_started_at
            )
            self.targetless_team_duration_seconds = max(
                self.targetless_team_duration_seconds,
                float(max_server_duration),
                observed_duration,
            )
        live_dps_changed = False
        if self.targetless_team_started_at:
            fallback_duration = max(
                self.targetless_team_duration_seconds,
                event_time - self.targetless_team_started_at,
            )
            for token in sorted(expected_tokens):
                actor_id, _damage, server_time, combat_seconds_total = (
                    pending_rows[token]
                )
                state = next_states.get(actor_id)
                if state is None:
                    continue
                live_dps_changed |= self._update_live_dps_from_snapshot(
                    state,
                    damage=state.total_damage,
                    event_time=event_time,
                    server_time=server_time,
                    combat_seconds_total=combat_seconds_total,
                    fallback_duration=fallback_duration,
                )
        return bool(
            progressed
            or round_reset
            or next_total != previous_total
            or live_dps_changed
            or {
                (state.actor_id, state.user_token)
                for state in next_states.values()
            }
            != {
                (state.actor_id, state.user_token)
                for state in previous_states
            }
        )

    def _observe_targetless_team_stat(
        self,
        update: dict,
        *,
        actor_id: int,
        absolute_damage: int,
        timestamp: int,
        server_time: int,
        combat_seconds_total: int,
        full_snapshot: bool,
    ) -> bool:
        if not self._targetless_team_mode_available():
            return self._clear_targetless_team_statistics()
        if not full_snapshot:
            if (
                not self.targetless_team_full_snapshot_seen
                or not self.targetless_team_started_at
                or actor_id not in self.targetless_team_states
                or combat_seconds_total
                <= self.targetless_team_server_duration_seconds
            ):
                return False
            self.targetless_team_server_duration_seconds = float(
                combat_seconds_total
            )
            return True
        user_token = str(update.get("user_token") or "").strip()[:128]
        raw_snapshot_tokens = update.get("snapshot_tokens")
        if not isinstance(raw_snapshot_tokens, (list, tuple, set)):
            raw_snapshot_tokens = update.get("team_tokens")
        if not user_token or not isinstance(
            raw_snapshot_tokens, (list, tuple, set)
        ):
            return False
        snapshot_tokens = {
            str(token or "").strip()[:128]
            for token in raw_snapshot_tokens
            if str(token or "").strip()
        }
        if len(snapshot_tokens) < 2 or user_token not in snapshot_tokens:
            return False
        if bool(update.get("omitted_zero")):
            previous = next(
                (
                    state
                    for state in self.targetless_team_states.values()
                    if state.user_token == user_token
                ),
                None,
            )
            if (
                previous is not None
                and previous.last_absolute > 0
                and (
                    not server_time
                    or server_time == previous.server_time
                )
            ):
                absolute_damage = previous.last_absolute
        if timestamp != self.targetless_team_pending_time_100ns:
            self.targetless_team_pending_time_100ns = timestamp
            self.targetless_team_pending_tokens = snapshot_tokens
            self.targetless_team_pending_rows = {}
        elif snapshot_tokens != self.targetless_team_pending_tokens:
            self.targetless_team_pending_tokens = snapshot_tokens
            self.targetless_team_pending_rows = {
                token: row
                for token, row in self.targetless_team_pending_rows.items()
                if token in snapshot_tokens
            }
        self.targetless_team_pending_rows[user_token] = (
            actor_id,
            absolute_damage,
            server_time,
            combat_seconds_total,
        )
        return self._commit_targetless_team_snapshot(timestamp)

    def targetless_team_statistics(
        self, now: float | None = None
    ) -> list[ActorStats]:
        if (
            not self._targetless_team_mode_available()
            or not self.targetless_team_full_snapshot_seen
            or not self.targetless_team_started_at
            or len(self.targetless_team_states) < 2
        ):
            return []
        now = time.time() if now is None else float(now)
        if (
            self.targetless_team_last_snapshot_at <= 0
            or now - self.targetless_team_last_snapshot_at
            > TARGETLESS_TEAM_SNAPSHOT_STALE_SECONDS
        ):
            return []
        rows = []
        for state in self.targetless_team_states.values():
            actor = ActorStats(actor_id=state.actor_id)
            actor.damage = max(0, int(state.total_damage))
            actor.first_time = self.targetless_team_started_at
            actor.last_time = self.targetless_team_last_progress_at
            rows.append(actor)
        return rows

    def targetless_team_duration(self, now: float | None = None) -> float:
        now = time.time() if now is None else float(now)
        if not self.targetless_team_statistics(now):
            return 0.0
        official_duration = max(
            (
                self._live_dps_duration_for_snapshot(
                    event_time=now,
                    server_time=state.server_time,
                    combat_seconds_total=state.combat_seconds_total,
                    fallback_duration=0.0,
                )
                for state in self.targetless_team_states.values()
            ),
            default=0.0,
        )
        if official_duration > 0:
            return max(
                official_duration, self.targetless_team_server_duration_seconds
            )
        return max(
            1.0,
            self.targetless_team_duration_seconds,
            now - self.targetless_team_started_at,
        )

    def _ingest_team_damage_stat(self, update: dict) -> bool:
        try:
            actor_id = int(update.get("actor_id", 0))
            absolute_damage = max(0, int(update.get("absolute_damage", 0)))
            timestamp = int(update.get("filetime_100ns", 0) or 0)
            server_time = max(0, int(update.get("server_time", 0) or 0))
            combat_seconds_total = max(
                0, int(update.get("combat_seconds_total", 0) or 0)
            )
            final_common = bool(update.get("dummy_final_common"))
            omitted_zero = bool(update.get("omitted_zero"))
            full_snapshot = bool(update.get("full_snapshot"))
        except (TypeError, ValueError, OverflowError):
            return False
        if (
            not actor_id
            or not timestamp
            or actor_id in self.non_player_actor_ids
        ):
            return False
        self.latest_network_time_100ns = max(self.latest_network_time_100ns, timestamp)

        targetless_changed = self._observe_targetless_team_stat(
            update,
            actor_id=actor_id,
            absolute_damage=absolute_damage,
            timestamp=timestamp,
            server_time=server_time,
            combat_seconds_total=combat_seconds_total,
            full_snapshot=full_snapshot,
        )

        state = self.team_damage_states.setdefault(
            actor_id, TeamDamageState(actor_id)
        )
        if omitted_zero and state.has_snapshot and state.last_absolute > 0:
            # A full Common row can omit an unchanged positive counter during
            # teardown.  Preserve it while the member's server epoch is the
            # same.  At the start of a new pull, however, the game first sends
            # an all-zero table with a new non-zero epoch.  Ignoring that row
            # leaves stale counters in place; the first real positive table
            # then looks like a mid-fight decrease and splits one encounter.
            starts_new_server_epoch = bool(
                full_snapshot
                and server_time
                and server_time != state.server_time
            )
            if not starts_new_server_epoch:
                live_dps_changed = False
                if combat_seconds_total and state.authoritative_snapshot:
                    event_time = self._event_seconds(update)
                    live_dps_changed = self._update_live_dps_from_snapshot(
                        state,
                        damage=state.accepted_damage,
                        event_time=event_time,
                        server_time=server_time,
                        combat_seconds_total=combat_seconds_total,
                        fallback_duration=self.duration(event_time),
                    )
                return targetless_changed or live_dps_changed
        if server_time:
            # Common field 10 changes independently for each member during a
            # single pull. It is useful for rejecting an older snapshot of the
            # same actor, but it is not a team-wide encounter identifier.
            if state.server_time and server_time < state.server_time:
                return targetless_changed
            self.team_server_time = max(self.team_server_time, server_time)
        self._apply_team_zero_baseline(state)
        if (
            state.snapshot_time_100ns
            and timestamp < state.snapshot_time_100ns
            and (not server_time or server_time == state.server_time)
        ):
            return targetless_changed
        previous_common_server_time = int(
            self.dummy_common_server_time or 0
        )
        previous_common_absolute = int(self.dummy_common_absolute or 0)
        dummy_common_changed = False
        if self.self_id is not None and actor_id == self.self_id:
            local_actor = self.stats.get(int(self.self_id))
            has_local_dummy_damage = bool(
                self.first_damage_time
                and local_actor is not None
                and int(local_actor.damage or 0) > 0
            )
            if self._is_dummy_encounter() and has_local_dummy_damage:
                dummy_common_changed = self._observe_dummy_common_damage(
                    absolute_damage,
                    server_time,
                    timestamp,
                    previous_common_server_time=previous_common_server_time,
                    previous_common_absolute=previous_common_absolute,
                    combat_seconds_total=combat_seconds_total,
                    final_common=final_common,
                )
                if dummy_common_changed and final_common:
                    # Field 20 is omitted only on the terminal row. Preserve
                    # the established epoch while advancing its absolute
                    # baseline so the next dummy round starts from this exact
                    # final value instead of the preceding periodic snapshot.
                    self.dummy_common_absolute = absolute_damage
            self._remember_self_common_damage(absolute_damage, server_time)
            if dummy_common_changed and final_common and self.dummy_round_official_final:
                # The terminal Common row is the authoritative end marker for
                # a training-dummy round.  Some clients stop at a small
                # non-zero sentinel and never emit a separate HP=0 packet;
                # keep the Boss bar consistent with the official total.
                for dummy_target_id in self._current_boss_target_ids():
                    dummy_target = self.monsters.get(dummy_target_id)
                    if dummy_target is None or not self._is_dummy_target(dummy_target_id):
                        continue
                    if dummy_target.current_hp != 0.0:
                        dummy_target.current_hp = 0.0
                        dummy_target.last_hp_update_100ns = max(
                            dummy_target.last_hp_update_100ns, timestamp
                        )
                        dummy_target.last_update_100ns = max(
                            dummy_target.last_update_100ns, timestamp
                        )
        if (
            state.has_snapshot and absolute_damage < state.last_absolute
            and not self._is_dummy_encounter()
        ):
            opening_member_epoch = bool(
                (self.encounter_start_signal_100ns or self.first_damage_time)
                and not self.combat_end_time
                and state.accepted_damage <= 0
                and state.carried_damage <= 0
            )
            preserve_continuous_encounter = bool(
                self._encounter_started()
                and self._preserve_continuous_phase_counters()
            )
            if opening_member_epoch:
                # At pull start each member's Common counter can roll from the
                # previous scene to the new encounter in a different packet.
                # Rebase only this untouched member; resetting the whole model
                # here used to clear the shared start clock repeatedly and made
                # opening DPS jump even though the final counters converged.
                state.baseline_absolute = 0
                state.baseline_snapshot_time_100ns = (
                    self.encounter_start_signal_100ns or timestamp
                )
                state.accepted_damage = 0
                state.carried_damage = 0
                state.first_time = 0.0
                state.last_time = 0.0
                state.live_dps = None
                state.live_dps_damage = 0
            elif preserve_continuous_encounter:
                # Death and the phase animation reset individual Common
                # counters in this verified encounter. Continue that member's
                # counter without changing the encounter or any other member.
                state.carried_damage = state.accepted_damage
                state.baseline_absolute = absolute_damage
                state.baseline_snapshot_time_100ns = timestamp
            elif self._live_boss_counter_regression():
                # Common field 10 is per-member, not a team encounter ID.
                # A partial/lower member row while the same Boss is alive is
                # insufficient evidence to discard all events and restart the
                # clock. Retain the last verified total; do not sum the lower
                # value or invent an offset. Real wipe/refill/new-target paths
                # still reset the encounter using their independent evidence.
                self.team_counter_regressions.append({
                    "actor_id": actor_id, "filetime_100ns": timestamp,
                    "previous_absolute": state.last_absolute,
                    "received_absolute": absolute_damage,
                    "previous_server_time": state.server_time,
                    "received_server_time": server_time,
                    "omitted_zero": omitted_zero,
                    "policy": "retain_verified_total_until_counter_recovers_or_encounter_resets",
                })
                del self.team_counter_regressions[:-16]
                return targetless_changed
            else:
                self._begin_team_counter_reset(
                    server_time or self.team_server_time,
                    timestamp,
                )
                state = self.team_damage_states.setdefault(
                    actor_id, TeamDamageState(actor_id)
                )
                self._apply_team_zero_baseline(state)

        if self._is_dummy_encounter():
            # Dummy encounters are deliberately local-only. Native per-hit
            # damage is complete here, while the cumulative team value can
            # arrive late and temporarily omit a hit that was already seen.
            # A pre-pull Common snapshot must not remain authoritative and
            # shadow those exact local hits after the dummy is selected.
            state.authoritative_snapshot = False
            state.last_absolute = absolute_damage
            state.baseline_absolute = absolute_damage
            state.has_snapshot = True
            state.snapshot_time_100ns = timestamp
            state.baseline_snapshot_time_100ns = timestamp
            state.server_time = server_time or state.server_time
            state.accepted_damage = 0
            state.carried_damage = 0
            self.team_server_update_100ns = max(
                self.team_server_update_100ns, timestamp
            )
            self._recompute()
            if dummy_common_changed and final_common:
                self._queue_current_record_refresh()
            return dummy_common_changed

        state.authoritative_snapshot = True
        event_time = self._event_seconds(update)
        if (
            self.last_damage_time
            and event_time - self.last_damage_time
            > (self.encounter_gap if self.boss_only else self.idle_gap)
            and self._damage_gap_starts_new_encounter()
        ):
            self.reset(
                keep_identity=True,
                keep_monsters=True,
                archive_reason="new_encounter",
            )
            state = self.team_damage_states.setdefault(
                actor_id, TeamDamageState(actor_id)
            )

        first_full_snapshot = bool(full_snapshot and not state.has_snapshot)
        previous_absolute = state.last_absolute if state.has_snapshot else 0
        team_damage_advanced = bool(
            state.has_snapshot and absolute_damage > previous_absolute
        )
        finished_time = self.combat_end_time
        if not finished_time and self._target_hp_depleted():
            finished_time = self.last_damage_time
        if self.combat_target_id is None:
            target = self._select_priority_monster(active_at_100ns=timestamp)
            if target is not None:
                self.combat_target_id = target.entity_id
                self._register_encounter_target(target.entity_id)
                self._resolve_combat_sides()

        if (
            team_damage_advanced
            and not finished_time
            and not self.team_start_requires_direct_damage
            and not self.first_damage_time
            and not self.encounter_start_signal_100ns
            and self.combat_target_id is not None
            and self._is_priority_target(self.combat_target_id)
        ):
            # TeamStats is authoritative team-wide evidence: any member's
            # first positive counter change means the confirmed Boss pull has
            # started, even when this client is a healer and never hits it.
            if self._arm_team_encounter(self.combat_target_id, timestamp):
                self._apply_team_zero_baseline(state)

        state.last_absolute = absolute_damage
        state.has_snapshot = True
        state.snapshot_time_100ns = max(state.snapshot_time_100ns, timestamp)
        state.server_time = server_time or state.server_time
        self.team_server_update_100ns = max(
            self.team_server_update_100ns, timestamp
        )

        damage_target_ids = self._encounter_damage_target_ids()
        start_signal = self.encounter_start_signal_100ns
        if first_full_snapshot:
            # A full Common row is the server's complete current counter, not
            # a delta. Its first positive value can arrive milliseconds before
            # this client binds the Boss entity. Starting that member at the
            # positive value drops real opening damage and makes observers
            # disagree according to packet timing.
            state.baseline_absolute = 0
            state.baseline_snapshot_time_100ns = start_signal or timestamp
        if not damage_target_ids or (
            not self.first_damage_time and not start_signal
        ):
            preserve_zero_baseline = bool(
                first_full_snapshot
                or (
                    absolute_damage > 0
                    and state.baseline_absolute == 0
                    and state.baseline_snapshot_time_100ns > 0
                    and state.baseline_snapshot_time_100ns < timestamp
                )
            )
            if not preserve_zero_baseline:
                state.baseline_absolute = absolute_damage
                state.baseline_snapshot_time_100ns = timestamp
            state.accepted_damage = 0
            state.carried_damage = 0
            return targetless_changed
        if (
            start_signal
            and state.baseline_snapshot_time_100ns < start_signal
        ):
            # Capture began after this pull started, or this member was absent
            # from every pre-pull full snapshot. Their first value is a local
            # baseline; claiming older damage would not be exact.
            state.baseline_absolute = absolute_damage
            state.baseline_snapshot_time_100ns = timestamp
            state.accepted_damage = 0
            state.carried_damage = 0
            return False
        if (
            actor_id not in self.encounter_member_ids
            and len(self.encounter_member_ids) >= MAX_PARTY_MEMBERS
        ):
            return False

        previous_accepted = state.accepted_damage
        previous_visible_damage = (
            self.stats[actor_id].damage if actor_id in self.stats else 0
        )
        state.accepted_damage = state.carried_damage + max(
            0, absolute_damage - state.baseline_absolute
        )
        live_dps_changed = self._update_live_dps_from_snapshot(
            state,
            damage=state.accepted_damage,
            event_time=event_time,
            server_time=(
                server_time if full_snapshot or combat_seconds_total
                else state.server_time
            ),
            combat_seconds_total=combat_seconds_total,
            fallback_duration=self.duration(event_time),
        )
        self.team_reset_pending = False
        if state.accepted_damage <= 0:
            self._recompute()
            current_visible_damage = (
                self.stats[actor_id].damage if actor_id in self.stats else 0
            )
            statistics_changed = bool(
                previous_accepted != state.accepted_damage
                or previous_visible_damage != current_visible_damage
            )
            if statistics_changed and finished_time:
                self._queue_current_record_refresh()
            return statistics_changed or live_dps_changed
        if not state.first_time:
            start_time = event_time
            if start_signal:
                start_time = self._event_seconds(
                    {"filetime_100ns": start_signal}
                )
            state.first_time = min(
                start_time,
                finished_time or start_time,
            )
        if state.accepted_damage != previous_accepted:
            # Common snapshots continue at a fixed cadence after combat. Only
            # a changed authoritative counter marks actual new damage; moving
            # this timestamp for an identical row makes elapsed time grow and
            # DPS fall forever after the fight has stopped.
            state.last_time = finished_time or event_time
        self._update_encounter_roster(actor_id)
        if actor_id not in self.friend_order:
            self.friend_order.append(actor_id)
        self._recompute()
        current_visible_damage = (
            self.stats[actor_id].damage if actor_id in self.stats else 0
        )
        statistics_changed = bool(
            state.accepted_damage != previous_accepted
            or current_visible_damage != previous_visible_damage
        )
        if finished_time and statistics_changed:
            # The final Common/Dirty snapshot often arrives just after the
            # death packet. Update the archived values without reopening the
            # encounter or extending its duration.
            self._queue_current_record_refresh()
        return statistics_changed or live_dps_changed

    def current_monster(self) -> MonsterStats | None:
        # A confirmed replacement Boss can remain pending while the previous
        # encounter waits for its delayed TeamStats result. It is authoritative
        # for the live HUD, but is not the statistics target until the counter
        # boundary is consumed by _begin_team_counter_reset().
        pending_id = int(self.pending_active_boss_id or 0)
        if pending_id and self._is_priority_target(pending_id):
            pending = self.monsters.get(pending_id)
            if pending is not None:
                return pending
        if self.combat_target_id is not None:
            monster = self.monsters.get(self.combat_target_id)
            if monster is not None and self._is_priority_target(monster.entity_id):
                return monster
        return self._select_priority_monster()

    def current_bosses(self) -> list[MonsterStats]:
        pending_id = int(self.pending_active_boss_id or 0)
        if pending_id and self._is_priority_target(pending_id):
            pending = self.monsters.get(pending_id)
            if pending is not None:
                return [pending]
        monsters = [
            self.monsters.get(entity_id)
            for entity_id in self._ordered_current_boss_target_ids()
        ]
        visible = [
            monster
            for monster in monsters
            if monster is not None and self._is_priority_target(monster.entity_id)
        ]
        if visible:
            return visible[:MAX_SIMULTANEOUS_BOSSES]
        fallback = self.current_monster()
        return [fallback] if fallback is not None else []

    def display_name(self, actor_id: int) -> str:
        automatic_name = self.entity_names.get(actor_id, "").strip()
        if automatic_name:
            return automatic_name
        if actor_id == self.self_id:
            return self.local_player_name
        return ""

    def actor_is_ai(self, actor_id: int) -> bool:
        if actor_id in self.entity_ai_states:
            return bool(self.entity_ai_states[actor_id])
        return False

    def display_target_name(self, entity_id: int) -> str:
        if not entity_id:
            return "未分配目标"
        monster = self.monsters.get(entity_id)
        name = (
            (monster.name if monster is not None else "")
            or self.entity_names.get(entity_id, "")
        ).strip()
        if name and not boss_name_is_placeholder(name):
            return name
        if monster is not None:
            catalog_name = _catalog_boss_name(
                self.target_catalog, monster.template_id
            )
            if catalog_name:
                return catalog_name
        if (
            entity_id == self.combat_target_id
            or entity_id in self.linked_boss_target_ids
            or entity_id in self.simultaneous_boss_target_ids
        ):
            return "Boss"
        add_order = [
            target_id
            for target_id in self.encounter_target_order
            if target_id in self.encounter_add_target_ids
        ]
        try:
            index = add_order.index(entity_id) + 1
        except ValueError:
            index = len(add_order) + 1
        return f"小怪 {index}"

    def _target_kind(self, entity_id: int) -> str:
        if (
            entity_id == self.combat_target_id
            or entity_id in self.linked_boss_target_ids
            or entity_id in self.simultaneous_boss_target_ids
        ):
            return "Boss"
        monster = self.monsters.get(entity_id)
        if (
            monster is not None
            and self._monster_rank(monster) > 0
            and entity_id not in self.encounter_add_target_ids
        ):
            return "Boss"
        return "小怪"

    def actor_target_rows(self, actor_id: int) -> list[dict]:
        actor = self.stats.get(actor_id)
        if actor is None or actor.damage <= 0:
            return []
        target_damage = {
            int(target_id): int(damage)
            for target_id, damage in actor.target_damage.items()
            if int(target_id) and int(damage) > 0
        }

        grouped: dict[tuple[str, str], dict] = {}
        for target_id, damage in target_damage.items():
            name = self.display_target_name(target_id)
            kind = self._target_kind(target_id)
            key = (kind, name)
            row = grouped.setdefault(
                key,
                {
                    "entity_id": target_id,
                    "entity_ids": [],
                    "name": name,
                    "kind": kind,
                    "damage": 0,
                },
            )
            row["entity_ids"].append(target_id)
            row["damage"] += damage
            if target_id == self.combat_target_id:
                row["entity_id"] = target_id
        rows = list(grouped.values())
        for row in rows:
            row["share"] = int(row["damage"]) / actor.damage
        tracked_damage = sum(int(row["damage"]) for row in rows)
        unassigned_damage = max(0, actor.damage - tracked_damage)
        if unassigned_damage:
            rows.append(
                {
                    "entity_id": 0,
                    "name": "未分配目标",
                    "kind": "汇总",
                    "damage": unassigned_damage,
                    "share": unassigned_damage / actor.damage,
                }
            )
        rows.sort(
            key=lambda row: (
                row["kind"] == "Boss",
                int(row["damage"]),
            ),
            reverse=True,
        )
        return rows

    def display_skill_name(self, actor_id: int, skill_id: int) -> str:
        automatic_name = self.skill_names.get(skill_id, "").strip()
        if automatic_name:
            return automatic_name
        runtime_name = self.runtime_skill_names.get(skill_id, "").strip()
        if runtime_name:
            return runtime_name
        actor = self.stats.get(actor_id)
        if actor is None:
            return "未归类伤害" if not skill_id else "未知技能"
        if not skill_id:
            return "未归类伤害"
        return "未知技能"

    def actor_profession_id(self, actor_id: int) -> int | None:
        explicit = self.entity_professions.get(actor_id)
        if explicit:
            return explicit
        actor = self.stats.get(actor_id)
        if actor is None:
            return None
        scores: dict[int, int] = {}
        for skill in actor.skills.values():
            class_ids = self.skill_professions.get(skill.skill_id, ())
            if not class_ids and 86_010_000 <= skill.skill_id < 86_080_000:
                index = (skill.skill_id - 86_000_000) // 10_000
                if 1 <= index <= 7:
                    class_ids = (1_200_000 + index,)
            for class_id in class_ids:
                scores[class_id] = scores.get(class_id, 0) + max(1, skill.damage)
        return max(scores, key=scores.get) if scores else None

    def normalize_damage_skill_id(self, value) -> int:
        try:
            skill_id = int(value)
        except (TypeError, ValueError, OverflowError):
            return 0
        if skill_id in self.skill_names or skill_id in self.runtime_skill_names:
            return skill_id
        root_skill_id = skill_id // 10
        if (
            100_000_000 <= skill_id <= 9_999_999_999
            and (
                root_skill_id in self.skill_names
                or root_skill_id in self.runtime_skill_names
            )
        ):
            return root_skill_id
        return max(0, skill_id)

    def ingest_skill_name(self, update: dict) -> bool:
        try:
            skill_id = int(update.get("skill_id", 0))
        except (TypeError, ValueError):
            return False
        name = str(update.get("name", "")).strip().replace("\x00", "")
        if not skill_id or not name or len(name) > 64:
            return False
        if any(ord(char) < 0x20 for char in name):
            return False
        # The client catalog is authoritative.  Runtime discovery only fills a
        # missing exact ID: nearby IDs can be different skills (for example
        # 89004600 is 挥砍 while 89004604 is 飞弹).
        if skill_id in self.skill_names:
            return False
        if self.runtime_skill_names.get(skill_id) == name:
            return False
        self.runtime_skill_names[skill_id] = name
        self.healing_revision += 1
        return True

    def ingest_name(self, update: dict) -> bool:
        try:
            entity_id = int(update.get("entity_id", 0))
        except (TypeError, ValueError):
            return False
        name = str(update.get("name", "")).strip().replace("\x00", "")
        if not entity_id or not name or len(name) > 64:
            return False
        if any(ord(char) < 0x20 for char in name):
            return False
        monster = self.monsters.get(entity_id)
        catalog_name = (
            _catalog_boss_name(self.target_catalog, monster.template_id)
            if monster is not None
            else ""
        )
        authoritative_name = bool(
            monster is not None
            and int(monster.template_id or 0)
            in AUTHORITATIVE_BOSS_NAME_TEMPLATE_IDS
            and catalog_name
        )
        if authoritative_name:
            name = catalog_name
        elif boss_name_is_placeholder(name):
            existing_name = self.entity_names.get(entity_id, "").strip()
            if existing_name and not boss_name_is_placeholder(existing_name):
                return False
            if catalog_name:
                name = catalog_name
        if self.entity_names.get(entity_id) == name:
            return False
        self.entity_names[entity_id] = name
        if monster is not None and (
            authoritative_name
            or not monster.name
            or boss_name_is_placeholder(monster.name)
        ):
            monster.name = name
        if entity_id == self.self_id:
            self.local_player_name = name
        return True

    def _local_combat_interval(
        self, now: float | None = None
    ) -> ResolvedCombatInterval:
        if not self.first_damage_time:
            return ResolvedCombatInterval(source="local_network_events")
        now = now if now is not None else time.time()
        fight_mode_active = self._confirmed_boss_fight_mode_active()
        fight_mode_end = self._confirmed_boss_fight_mode_end()
        target_defeated = self._result_frozen_by_target_death()
        if target_defeated:
            # Freeze the visible result as soon as the Boss bar reaches zero.
            # Multi-stage encounters remain live while a known auxiliary phase
            # is active, but their final death must not keep lowering DPS until
            # the longer archive timeout expires.
            end = self.combat_end_time or self.last_damage_time
        elif self.combat_end_time:
            # An independently verified victory/wipe boundary is stronger
            # than a stale fight-mode [2] bit that never received its closing
            # update.  Once frozen, rendering must not keep extending time.
            end = max(self.combat_end_time, fight_mode_end)
        elif fight_mode_active:
            # Fight-mode is a shared encounter edge. It keeps the clock moving
            # even when this client sees only Boss-to-player traffic.
            end = now
        elif fight_mode_end:
            end = fight_mode_end
        elif now - self.last_damage_time < self._encounter_idle_timeout():
            end = now
        else:
            end = self.last_damage_time
        locally_finished = bool(
            not fight_mode_active
            and (
                self.combat_end_time
                or target_defeated
                or fight_mode_end
                or now - self.last_damage_time
                >= self._encounter_idle_timeout()
            )
        )
        return ResolvedCombatInterval.from_endpoints(
            self.first_damage_time,
            end,
            source="local_network_events",
            final=locally_finished,
        )

    def resolve_combat_interval(
        self,
        now: float | None = None,
        *,
        for_archive: bool = False,
    ) -> ResolvedCombatInterval:
        """Resolve one clock for live DPS, HPS and archived endpoints."""

        now = time.time() if now is None else float(now)
        local_interval = self._local_combat_interval(now)
        if self._is_dummy_encounter():
            official_duration = max(
                0,
                int(self.dummy_round_official_duration_seconds or 0),
            )
            if (
                self.dummy_round_official_final
                and official_duration > 0
                and local_interval.valid
            ):
                official_interval = ResolvedCombatInterval.from_duration(
                    official_duration,
                    ended_at_epoch=local_interval.ended_at_epoch,
                    source="game_server_dummy_clock",
                    final=True,
                )
                observed_span = max(
                    0.0, self.last_damage_time - self.first_damage_time
                )
                if (
                    official_interval.valid
                    and official_interval.duration_seconds <= 24 * 60 * 60
                    and official_interval.duration_seconds + 0.5
                    >= observed_span
                ):
                    return official_interval
            offset = self.server_clock_offset_seconds
            round_epoch = int(self.dummy_round_server_time or 0)
            if offset is not None and round_epoch and local_interval.valid:
                candidate = ResolvedCombatInterval.from_endpoints(
                    float(round_epoch) - float(offset),
                    local_interval.ended_at_epoch,
                    source="game_server_dummy_clock",
                    final=local_interval.final,
                )
                observed_span = max(
                    0.0, self.last_damage_time - self.first_damage_time
                )
                if (
                    candidate.valid
                    and candidate.duration_seconds <= 24 * 60 * 60
                    and candidate.duration_seconds + 0.5 >= observed_span
                ):
                    return candidate
            return local_interval
        if not local_interval.valid:
            return local_interval
        observed_span = max(
            0.0, self.last_damage_time - self.first_damage_time
        )
        if self.game_server_duration_seconds and local_interval.final:
            game_interval = ResolvedCombatInterval.from_duration(
                self.game_server_duration_seconds,
                ended_at_epoch=local_interval.ended_at_epoch,
                source="game_server_team_clock",
                final=True,
            )
            if game_interval.valid:
                return game_interval
        if not self.shared_clock_duration_seconds:
            return local_interval

        shared_state = self.shared_clock_state or (
            "final" if self.shared_clock_final else "active"
        )
        if for_archive and shared_state != "final":
            return local_interval
        shared_duration = self.shared_clock_duration_seconds
        if shared_state == "active":
            shared_duration += max(0.0, now - self.shared_clock_received_at)
        if shared_state == "final":
            shared_interval = ResolvedCombatInterval.from_endpoints(
                self.shared_clock_started_at,
                self.shared_clock_ended_at,
                source="server_shared_clock",
                final=True,
            )
        else:
            shared_interval = ResolvedCombatInterval.from_duration(
                shared_duration,
                started_at_epoch=self.shared_clock_started_at,
                source="server_shared_clock",
                final=False,
            )
        if (
            shared_interval.valid
            and shared_interval.duration_seconds <= COMBAT_CLOCK_MAX_SECONDS
            and combat_clock_covers_local_span(
                shared_interval.duration_seconds, observed_span
            )
        ):
            return shared_interval
        return local_interval

    def _local_duration(self, now: float | None = None) -> float:
        return self._local_combat_interval(now).duration_seconds

    def duration(self, now: float | None = None) -> float:
        return self.resolve_combat_interval(now).duration_seconds

    def display_duration(self, now: float | None = None) -> float:
        """Return the HUD clock duration while a new Boss awaits TeamStats."""

        pending_time = int(self.pending_active_boss_time_100ns or 0)
        if (
            pending_time
            and self.pending_active_boss_id
        ):
            started_at = self._event_seconds(
                {"filetime_100ns": pending_time}
            )
            now = time.time() if now is None else float(now)
            if started_at > 0 and now >= started_at:
                # The archived previous Boss can already have combat_end_time.
                # While the new confirmed Boss waits for its first TeamStats,
                # its visible clock belongs to the new Challenge, not the
                # frozen previous encounter.
                return max(0.0, now - started_at)
        return self.duration(now)

    def healing_duration(self, now: float | None = None) -> float:
        """Use DPS timing for real Boss pulls and local timing for dummies."""
        if self.first_damage_time:
            return self.duration(now)
        if not self.first_healing_time:
            return 0.0
        now = time.time() if now is None else float(now)
        if self.healing_end_time:
            end = self.healing_end_time
        elif now - self.last_healing_time < self.idle_gap:
            end = now
        else:
            end = self.last_healing_time
        return max(1.0, end - self.first_healing_time)

    def healing_active(self, now: float | None = None) -> bool:
        """Return the HPS live state without changing the DPS live state."""
        if self.first_damage_time:
            return self.active(now)
        if not self.last_healing_time or self.healing_end_time:
            return False
        now = time.time() if now is None else float(now)
        return now - self.last_healing_time < self.idle_gap

    def combat_in_progress(self, now: float | None = None) -> bool:
        return self.active(now)

    def active(self, now: float | None = None) -> bool:
        if not self.last_damage_time:
            return False
        if (
            self.combat_end_reason == "target_defeated"
            or self._result_frozen_by_target_death()
        ):
            return False
        if self.combat_end_time or self._confirmed_boss_fight_mode_end():
            return False
        if self._confirmed_boss_fight_mode_active():
            return True
        now = now if now is not None else time.time()
        return now - self.last_damage_time < self._encounter_idle_timeout()


def blend_color(left: str, right: str, amount: float) -> str:
    amount = min(1.0, max(0.0, amount))
    lhs = tuple(int(left[index : index + 2], 16) for index in (1, 3, 5))
    rhs = tuple(int(right[index : index + 2], 16) for index in (1, 3, 5))
    mixed = tuple(round(a + (b - a) * amount) for a, b in zip(lhs, rhs))
    return "#" + "".join(f"{value:02x}" for value in mixed)


def canvas_rounded_rectangle(
    canvas: tk.Canvas,
    left: object,
    top: object,
    right: object,
    bottom: object,
    radius: object,
    **options,
) -> int:
    """Draw a DPI-safe rounded rectangle on a Tk canvas."""

    left_value = float(left)
    top_value = float(top)
    right_value = float(right)
    bottom_value = float(bottom)
    corner = min(
        max(0.0, float(radius)),
        max(0.0, (right_value - left_value) / 2.0),
        max(0.0, (bottom_value - top_value) / 2.0),
    )
    points = (
        left_value + corner,
        top_value,
        right_value - corner,
        top_value,
        right_value,
        top_value,
        right_value,
        top_value + corner,
        right_value,
        bottom_value - corner,
        right_value,
        bottom_value,
        right_value - corner,
        bottom_value,
        left_value + corner,
        bottom_value,
        left_value,
        bottom_value,
        left_value,
        bottom_value - corner,
        left_value,
        top_value + corner,
        left_value,
        top_value,
    )
    create_polygon = getattr(canvas, "create_polygon", None)
    if callable(create_polygon):
        options.setdefault("smooth", True)
        options.setdefault("splinesteps", 24)
        return create_polygon(*points, **options)
    # Lightweight canvas doubles used by diagnostics may only implement the
    # rectangle primitive.  Keep those read-only paths compatible.
    return canvas.create_rectangle(
        left_value, top_value, right_value, bottom_value, **options
    )


def canvas_outlined_text(
    canvas: tk.Canvas,
    x: object,
    y: object,
    *,
    outline: str = "#071019",
    outline_width: int = 1,
    **options,
) -> int:
    """Draw compact game-style text with a stable dark readability edge."""

    foreground = str(options.pop("fill", TEXT))
    if not hasattr(canvas, "tk"):
        return canvas.create_text(x, y, fill=foreground, **options)
    edge = max(1, int(outline_width))
    for offset_x, offset_y in (
        (-edge, 0),
        (edge, 0),
        (0, -edge),
        (0, edge),
    ):
        canvas.create_text(
            float(x) + offset_x,
            float(y) + offset_y,
            fill=outline,
            **options,
        )
    return canvas.create_text(x, y, fill=foreground, **options)








class BoundedPhotoCache(OrderedDict):
    """Bound generated Tk images so opening many detail pages cannot leak."""

    def __init__(self, max_entries: int = 512):
        super().__init__()
        self.max_entries = max(32, int(max_entries))

    def __getitem__(self, key):
        value = super().__getitem__(key)
        self.move_to_end(key)
        return value

    def __setitem__(self, key, value):
        super().__setitem__(key, value)
        self.move_to_end(key)
        while len(self) > self.max_entries:
            self.popitem(last=False)

    def popitem(self, last=True):
        # OrderedDict.popitem() calls ``self[key]`` internally on some
        # supported Python builds; bypass our LRU __getitem__ after removal.
        key = next(reversed(self)) if last else next(iter(self))
        value = OrderedDict.__getitem__(self, key)
        OrderedDict.__delitem__(self, key)
        return key, value


class IconFactory:
    """Load extracted PNGs when present, otherwise draw deterministic badges."""

    PROFESSION_GLYPHS = {
        1_200_001: "日",
        1_200_002: "心",
        1_200_003: "愚",
        1_200_004: "审",
        1_200_005: "门",
        1_200_006: "暮",
        1_200_007: "隐",
    }

    def __init__(self, root: tk.Misc):
        self.root = root
        self.window_dpi = get_window_dpi(root)
        self.cache: BoundedPhotoCache = BoundedPhotoCache(512)

    def set_dpi(self, dpi: object) -> bool:
        """Switch subsequent raster assets to the window's physical DPI."""

        try:
            normalized = int(dpi)
        except (TypeError, ValueError, OverflowError):
            normalized = DEFAULT_DPI
        normalized = max(72, min(384, normalized))
        if normalized == self.window_dpi:
            return False
        self.window_dpi = normalized
        return True

    def _physical_size(self, logical_size: object) -> int:
        return logical_pixels_to_physical(logical_size, self.window_dpi)

    @staticmethod
    def _font(size: int, *, bold: bool = False):
        windows = Path(os.environ.get("WINDIR", r"C:\Windows")) / "Fonts"
        candidates = (
            windows / ("msyhbd.ttc" if bold else "msyh.ttc"),
            windows / ("segoeuib.ttf" if bold else "segoeui.ttf"),
        )
        for path in candidates:
            try:
                return ImageFont.truetype(str(path), size)
            except OSError:
                continue
        return ImageFont.load_default()

    @staticmethod
    def _rounded(image: Image.Image, radius: int) -> Image.Image:
        mask = Image.new("L", image.size, 0)
        ImageDraw.Draw(mask).rounded_rectangle(
            (0, 0, image.width - 1, image.height - 1), radius=radius, fill=255
        )
        # Keep the original game's transparent pixels.  Replacing the alpha
        # channel would turn transparent texture padding into a black tile.
        image.putalpha(ImageChops.multiply(image.getchannel("A"), mask))
        return image

    def _from_file(self, path: Path, size: int) -> Image.Image | None:
        if not path.is_file():
            return None
        try:
            image = Image.open(path).convert("RGBA")
            image.thumbnail((size, size), Image.Resampling.LANCZOS)
            canvas = Image.new("RGBA", (size, size), (0, 0, 0, 0))
            canvas.alpha_composite(
                image, ((size - image.width) // 2, (size - image.height) // 2)
            )
            return self._rounded(canvas, max(4, size // 5))
        except (OSError, ValueError):
            return None

    def _draw_badge(self, text: str, color: str, size: int, seed: int) -> Image.Image:
        image = Image.new("RGBA", (size, size), color)
        draw = ImageDraw.Draw(image, "RGBA")
        for y in range(size):
            alpha = int(38 + 70 * y / max(1, size - 1))
            draw.line((0, y, size, y), fill=(3, 8, 14, alpha))
        offset = seed % max(5, size // 3)
        draw.polygon(
            ((-size // 3 + offset, size), (size // 2 + offset, 0), (size, 0), (size // 5, size)),
            fill=(255, 255, 255, 20),
        )
        draw.rounded_rectangle(
            (1, 1, size - 2, size - 2),
            radius=max(4, size // 5),
            outline=(255, 255, 255, 75),
            width=max(1, size // 24),
        )
        # Mode badges need to distinguish 6V6 from 12V12.  Keep the compact
        # single-glyph treatment for ordinary icons, but allow two digits to
        # remain legible instead of silently reducing ``12`` to ``1``.
        text = str(text or "?").strip()[:2]
        font = self._font(
            max(10, int(size * (0.36 if len(text) > 1 else 0.48))),
            bold=True,
        )
        box = draw.textbbox((0, 0), text, font=font)
        x = (size - (box[2] - box[0])) / 2 - box[0]
        y = (size - (box[3] - box[1])) / 2 - box[1] - 1
        draw.text((x + 1, y + 2), text, font=font, fill=(0, 0, 0, 110))
        draw.text((x, y), text, font=font, fill=(248, 250, 252, 245))
        return self._rounded(image, max(4, size // 5))

