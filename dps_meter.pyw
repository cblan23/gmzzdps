            "dps": "我的 DPS",
            "hps": "我的 HPS",
            "dt": "我的承伤",
            "boss_damage": "已归类首领伤害",
        }.get(getattr(self, "history_meter_mode", "dps"), "我的表现")
        captions: list[tuple[str, int, str]] = [
            ("战斗时长", columns["time"], "w"),
            ("Boss / 副本", columns["content"], "w"),
