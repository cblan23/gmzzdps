        note_labels: list[tk.Label] = []
        self.update_rollback_buttons = {}
        for index, (version, notes) in enumerate(releases):
            card = tk.Frame(content, bg=SURFACE)
            card.pack(
                fill="x",
                padx=22,
                pady=(
                    22 if index == 0 else 8,
                    22 if index == len(releases) - 1 else 0,
                ),
            )
            card_header = tk.Frame(card, bg=SURFACE)
            card_header.pack(fill="x", padx=20, pady=(14, 6))
            tk.Label(
                card_header,
                text=version,
                bg=SURFACE,
                fg=ACCENT,
                anchor="w",
                font=self._ui_font("title"),
            ).pack(side="left", fill="y")
            rollback_version = normalize_rollback_version(version)
            rollback_button = self._backend_action_button(
                card_header,
                "回滚",
                lambda target=rollback_version: self._start_version_rollback(target),
            )
            rollback_button.configure(padx=14, pady=5)
            rollback_button.pack(side="right")
            if rollback_version:
                self.update_rollback_buttons[rollback_version] = rollback_button
            note_label = tk.Label(
                card,
                text=notes,
                bg=SURFACE,
                fg=TEXT,
                justify="left",
                anchor="w",
                wraplength=820,
                font=self._ui_font("body"),
            )
            note_label.pack(fill="x", padx=20, pady=(0, 18))
            note_labels.append(note_label)

        def sync_update_log_region(_event=None) -> None:
            try:
                bounds = self.update_log_canvas.bbox("all")
                if bounds is not None:
                    self.update_log_canvas.configure(scrollregion=bounds)
            except (AttributeError, tk.TclError):
                return

        def resize_update_log(event) -> None:
            try:
                width = max(1, int(event.width))
                self.update_log_canvas.itemconfigure(content_window, width=width)
                wraplength = max(240, width - 84)
                for note_label in note_labels:
                    note_label.configure(wraplength=wraplength)
                sync_update_log_region()
            except (AttributeError, TypeError, ValueError, tk.TclError):
                return

        content.bind("<Configure>", sync_update_log_region)
        self.update_log_canvas.bind("<Configure>", resize_update_log)
        self.update_log_canvas.yview_moveto(0.0)
        self._refresh_update_page()
        return page

