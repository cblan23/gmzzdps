        self.root.configure(bg=MAIN_TRANSPARENT_KEY)
        self.root.geometry(self._initial_geometry())
        self.root.minsize(self._main_minimum_width(), MAIN_MIN_HEIGHT)
        self.root.attributes(
            "-topmost",
            self.window_locked or bool(self.config.get("topmost", True)),
        )
        # Keep the first backing surface opaque until the mapped HWND has been
        # calibrated to its real monitor. Creating a layered/alpha surface at
        # 96 DPI and moving it to a 125% monitor makes DWM scale that cached
        # surface, which is especially visible on small Chinese glyphs.
        self.root.attributes("-alpha", 1.0)
        self.root.overrideredirect(True)
        # Query the real HWND after geometry is assigned.  Calling DPI
        # calibration while the root is still at Tk's default (and withdrawn)
        # scale makes a 125% monitor build every font at 96 DPI first.
        self.root.update_idletasks()
        self._apply_windows_style(self.root)
        self._configure_tk_dpi_scaling()
        self._initialize_ui_fonts()
        self.icons = IconFactory(self.root)
        if self.layered_main_enabled:
            try:
                self.layered_main_renderer = MainHudRenderer(
                    ASSET_DIR,
                    PROFESSION_COLORS,
                )
                self.layered_main_presenter = WindowsLayeredPresenter(self.root)
            except (AttributeError, OSError, RuntimeError, tk.TclError):
                # Retain the existing Tk renderer as a safe fallback on an
                # unsupported Windows compositor or remote desktop session.
                presenter = self.layered_main_presenter
                if presenter is not None:
                    presenter.close()
                self.layered_main_enabled = False
                self.layered_main_renderer = None
                self.layered_main_presenter = None
        self.app_window_icon = self.icons.app_logo(64)
        try:
            self.root.iconphoto(True, self.app_window_icon)
            if sys.platform == "win32" and APP_ICON_PATH.is_file():
                self.root.iconbitmap(default=str(APP_ICON_PATH))
        except tk.TclError:
            pass
        self._build_ui()
        self._apply_layout_mode()
        if WindowsTrayIcon is not None:
            try:
                self.tray_icon = WindowsTrayIcon(
                    APP_NAME,
                    APP_ICON_PATH,
                    lambda action: self.control_messages.put((action, None)),
                    class_prefix=(
                        CAPTURE_TRAY_CLASS_PREFIX or "GMZZDpsTray_"
                    ),
                ).start()
            except Exception:
                pass
        self._register_configured_toggle_hotkey()
        self._register_configured_unlock_hotkey()
        self._register_configured_hud_view_hotkey()
        self.root.protocol("WM_DELETE_WINDOW", self.close)
        self.drain_after_id = self.root.after(50, self._drain_messages)
        self.render_after_id = self.root.after(160, self._render)
        self.root.after(20, lambda: self._apply_windows_style(self.root))
        self.root.after(45, self._apply_main_transparency)
        # Run once immediately after the first map, then keep a lightweight
        # monitor-transition fallback.  A 250 ms delay was long enough for a
        # newly-started 125% session to paint one blurry frame.
        self.root.after(0, self._refresh_window_dpi)
        self.root.after(0, self._show_login)
        # Reapply a persisted lock after the root HWND exists.  Without this
        # pass a restart could show a locked window but leave its old native
        # hit-test style interactive until the user toggled the lock again.
        self.root.after(0, self._apply_window_lock_state)

    def _enabled_damage_metrics(self) -> tuple[str, ...]:
        return tuple(
            key
            for key, enabled in (
                ("damage", self.show_total_damage),
                ("dps", self.show_dps),
                ("share", self.show_damage_share),
                ("critical", self.show_critical_rate),
                (
                    "penetration",
                    getattr(self, "show_penetration_rate", False),
                ),
                ("deaths", getattr(self, "show_deaths", False)),
                ("revives", getattr(self, "show_revives", False)),
                ("death_time", getattr(self, "show_death_duration", False)),
            )
            if enabled
        )

    def _enabled_healing_metrics(self) -> tuple[str, ...]:
        return tuple(
            key
            for key, enabled in (
                ("effective", getattr(self, "show_effective_healing", True)),
                ("hps", getattr(self, "show_hps", True)),
                ("overheal", getattr(self, "show_overheal_rate", True)),
            )
            if enabled
        )

    def _enabled_taken_metrics(self) -> tuple[str, ...]:
        return tuple(
            key
            for key, enabled in (
                ("taken", getattr(self, "show_taken", True)),
                ("taken_share", getattr(self, "show_taken_share", True)),
            )
            if enabled
        )

    def _enabled_boss_metrics(self) -> tuple[str, ...]:
        return tuple(
            key
            for key, enabled in (
                ("boss_damage", getattr(self, "show_boss_damage", True)),
                ("boss_share", getattr(self, "show_boss_share", True)),
                ("boss_hits", getattr(self, "show_boss_hits", True)),
                ("boss_max_hit", getattr(self, "show_boss_max_hit", True)),
            )
            if enabled
        )

    def _enabled_main_metrics(self) -> tuple[str, ...]:
        # Compatibility helper for retired layout calculations and older
        # saved integrations. The schema-v1 renderer does not consume this.
        mode = str(getattr(self, "main_meter_mode", "dps") or "dps").casefold()
        if mode == "hps":
            return self._enabled_healing_metrics()
        if mode == "dt":
            return self._enabled_taken_metrics()
        if mode == "boss":
            return self._enabled_boss_metrics()
        return self._enabled_damage_metrics()

    def _main_px(self, value: object) -> int:
        try:
            logical = float(value) * float(
                getattr(self, "main_ui_scale", 1.0) or 1.0
            )
        except (TypeError, ValueError, OverflowError):
            logical = float(value)
        return logical_pixels_to_physical(
            logical, getattr(self, "window_dpi", DEFAULT_DPI)
        )

    def _profession_display_metric(self, profession_id: object) -> str:
        try:
            parsed_profession_id = int(profession_id or 0)
        except (TypeError, ValueError, OverflowError):
            parsed_profession_id = 0
        selected = str(
            getattr(self, "profession_display_metrics", {}).get(
                str(parsed_profession_id), ""
            )
            or ""
        ).casefold()
        allowed = profession_metric_options(parsed_profession_id)
        return selected if selected in allowed else allowed[0]

    def _main_minimum_width(self) -> int:
        return self._main_px(MAIN_MIN_WIDTH)

    def _compact_target_width(self) -> int:
        rating_reserve = (
            MINI_RATING_WIDTH_RESERVE
            if bool(getattr(self, "show_extraordinary_rating", False))
            or bool(getattr(self, "team_rating_preview_enabled", False))
            else 0
        )
        return compact_width_for_visible_metrics(
            len(self._enabled_main_metrics())
        ) + rating_reserve

    def _adaptive_compact_geometry(
        self,
        value: object,
        fallback_x: int = 32,
        fallback_y: int = 120,
    ) -> str:
        parsed = parse_absolute_tk_geometry(value)
        if parsed is not None:
            width, height, x, y = parsed
            parsed_width = max(MINI_MIN_WIDTH, width)
            parsed_height = max(MINI_MIN_HEIGHT, height)
        else:
            parsed_width = self._compact_target_width()
            parsed_height = MINI_DEFAULT_HEIGHT
            x = int(fallback_x)
            y = int(fallback_y)
        return format_absolute_tk_geometry(parsed_width, parsed_height, x, y)

    def _initial_geometry(self) -> str:
        saved = str(self.config.get("geometry", ""))
        if bool(getattr(self, "main_display_config_migrated", False)):
            parsed = parse_absolute_tk_geometry(saved)
            if parsed is not None:
                _width, _height, x, y = parsed
                upgraded = format_absolute_tk_geometry(
                    MAIN_DEFAULT_WIDTH, MAIN_DEFAULT_HEIGHT, x, y
                )
            else:
                upgraded = format_absolute_tk_geometry(
                    MAIN_DEFAULT_WIDTH, MAIN_DEFAULT_HEIGHT, 32, 120
                )
            return self._visible_geometry(
                upgraded, MAIN_DEFAULT_WIDTH, MAIN_DEFAULT_HEIGHT
            )
        return self._visible_geometry(
            saved, MAIN_DEFAULT_WIDTH, MAIN_DEFAULT_HEIGHT
        )

    def _visible_geometry(self, value: str, default_width: int, default_height: int) -> str:
        parsed = parse_absolute_tk_geometry(value)
        if parsed is not None:
            width, height, x, y = parsed
        else:
            width, height, x, y = default_width, default_height, 32, 120
        width, height, x, y = clamp_geometry_to_work_areas(
            width,
            height,
            x,
            y,
            self._monitor_work_areas(),
        )
        return format_absolute_tk_geometry(width, height, x, y)

    def _monitor_work_areas(self) -> list[tuple[int, int, int, int]]:
        if sys.platform == "win32":
            try:
                import ctypes
                from ctypes import wintypes

                class MonitorInfo(ctypes.Structure):
                    _fields_ = [
                        ("cbSize", wintypes.DWORD),
                        ("rcMonitor", wintypes.RECT),
                        ("rcWork", wintypes.RECT),
                        ("dwFlags", wintypes.DWORD),
                    ]

                areas: list[tuple[int, int, int, int]] = []
                callback_type = ctypes.WINFUNCTYPE(
                    wintypes.BOOL,
                    wintypes.HMONITOR,
                    wintypes.HDC,
                    ctypes.POINTER(wintypes.RECT),
                    wintypes.LPARAM,
                )
                # Other DPI helpers use their own MonitorInfo ctypes class.
                # Do not share a globally cached function's pointer signature
                # with those helpers when opening/moving settings windows.
                monitor_api = ctypes.WinDLL("user32", use_last_error=True)
                monitor_api.GetMonitorInfoW.argtypes = (
                    wintypes.HMONITOR, ctypes.POINTER(MonitorInfo)
                )
                monitor_api.GetMonitorInfoW.restype = wintypes.BOOL
                monitor_api.EnumDisplayMonitors.argtypes = (
                    wintypes.HDC, ctypes.POINTER(wintypes.RECT),
                    callback_type, wintypes.LPARAM,
                )
                monitor_api.EnumDisplayMonitors.restype = wintypes.BOOL

                def collect(monitor, _hdc, _rect, _data):
                    info = MonitorInfo()
                    info.cbSize = ctypes.sizeof(info)
                    if monitor_api.GetMonitorInfoW(
                        monitor, ctypes.byref(info)
                    ):
                        work = info.rcWork
                        areas.append((work.left, work.top, work.right, work.bottom))
                    return True

                callback = callback_type(collect)
                monitor_api.EnumDisplayMonitors(None, None, callback, 0)
                if areas:
                    return areas
            except (AttributeError, OSError, TypeError, ValueError):
                pass
            try:
                # Tk's screen dimensions describe only the primary monitor on
                # some builds. Preserve the full virtual desktop as the
                # Windows fallback so a temporary EnumDisplayMonitors failure
                # does not pull a valid secondary-screen position back home.
                user32 = ctypes.windll.user32
                virtual_left = int(user32.GetSystemMetrics(76))
                virtual_top = int(user32.GetSystemMetrics(77))
                virtual_width = int(user32.GetSystemMetrics(78))
                virtual_height = int(user32.GetSystemMetrics(79))
                if virtual_width > 0 and virtual_height > 0:
                    return [
                        (
                            virtual_left,
                            virtual_top,
                            virtual_left + virtual_width,
                            virtual_top + virtual_height,
                        )
                    ]
            except (AttributeError, OSError, TypeError, ValueError):
                pass
        return [(0, 0, self.root.winfo_screenwidth(), self.root.winfo_screenheight())]

    def _initialize_ui_fonts(self) -> None:
        available = tkfont.families(self.root)
        self.ui_font_family = preferred_font_family(
            available,
            ("Microsoft YaHei UI", "Microsoft YaHei", "MiSans"),
        )
        self.number_font_family = self.ui_font_family
        self._configure_tk_named_font_families()
        try:
            configured_size = int(self.config.get("font_size", 14))
        except (TypeError, ValueError, OverflowError):
            configured_size = 14
        self.ui_font_size = min(18, max(12, configured_size))
        self.ui_fonts: dict[str, tkfont.Font] = {}
        self._configure_ui_fonts()

    def _configure_tk_named_font_families(self) -> None:
        """Keep widgets without an explicit role on the application's UI face."""

        for name in (
            "TkDefaultFont",
            "TkTextFont",
            "TkFixedFont",
            "TkMenuFont",
            "TkHeadingFont",
            "TkCaptionFont",
            "TkSmallCaptionFont",
            "TkIconFont",
            "TkTooltipFont",
        ):
            try:
                tkfont.nametofont(name, root=self.root).configure(
                    family=self.ui_font_family
                )
            except tk.TclError:
                continue

    def _configure_tk_dpi_scaling(self) -> None:
        """Match Tk point rendering to the physical DPI of the display."""
        self.window_dpi = configure_tk_dpi_scaling(self.root)
        self.dpi_scale = self.window_dpi / 96.0

    def _prepare_toplevel_dpi(self, window: tk.Misc) -> None:
        """Calibrate a newly-created Toplevel before its fonts are measured.

        Tk shares its scaling database across Toplevels.  Querying the child
        after its geometry is assigned lets Windows choose the monitor that
        will actually display it, instead of inheriting a 96-DPI bootstrap
        value from a withdrawn root.
        """
        try:
            window.update_idletasks()
            target = window
            # Click-through helpers are intentionally withdrawn while their
            # native styles are installed. If the parent is already mapped,
            # it is the authoritative monitor for those child surfaces.
            if (
                not window.winfo_ismapped()
                and self.root.winfo_exists()
                and self.root.winfo_ismapped()
            ):
                target = self.root
            dpi = configure_tk_dpi_scaling(target)
            if dpi != getattr(self, "window_dpi", 0):
                self.window_dpi = dpi
                self.dpi_scale = dpi / 96.0
                if hasattr(self, "icons"):
                    self.icons.set_dpi(dpi)
            if hasattr(self, "ui_fonts"):
                # Reconfigure even when the numeric DPI did not change: a
                # different Toplevel may have changed Tk's display scaling
                # since this font set was last measured.
                self._configure_ui_fonts()
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            return

    def _apply_window_dpi_if_changed(self, *, force: bool = False) -> bool:
        """Apply the mapped root DPI without moving the user's window.

        Updating Tk's global scale can make Windows renegotiate the rectangle
        of a borderless window.  That is useful for native framed windows, but
        here it makes a window placed at a monitor edge visibly jump back.
        Preserve the exact screen position around the DPI/font rebuild.  This
        is deliberately not a work-area clamp: every coordinate chosen by the
        user, including a monitor edge or a cross-monitor position, remains
        valid.
        """
        if self.closing or not self.root.winfo_exists():
            return False
        # Changing Tk's global scaling while a borderless window is crossing
        # a mixed-DPI monitor boundary can make Windows renegotiate its
        # geometry in the middle of our manual drag. That appears to the user
        # as the window snapping back. The periodic refresh waits until the
        # pointer grab ends and then preserves the chosen screen coordinate.
        if not force and id(self.root) in getattr(self, "drag_state", {}):
            return False
        dpi = get_window_dpi(self.root)
        if not force and dpi == getattr(self, "window_dpi", 0):
            return False
        preserved_position: tuple[int, int] | None = None
        try:
            preserved_position = (self.root.winfo_x(), self.root.winfo_y())
        except (AttributeError, TypeError, ValueError, tk.TclError):
            pass
        self.window_dpi = dpi
        self.dpi_scale = dpi / 96.0
        configure_tk_dpi_scaling(self.root)
        if hasattr(self, "icons"):
            self.icons.set_dpi(dpi)
        if hasattr(self, "ui_fonts"):
            # Tk caches the pixel metrics of an existing named font. Changing
            # tk scaling alone does not rebuild those metrics, so reconfigure
            # every shared font even when its point size is unchanged.
            self._configure_ui_fonts()
            if hasattr(self, "titlebar"):
                self._refresh_main_scale_layout()
                self._sync_main_component_visibility()
            self._sync_action_buttons()
            self._draw_main_header()
            self._draw_main_rows()
            self._draw_enrage_prediction()
            self._draw_monster_hp()
            self._draw_history_list()
            self._draw_history_participants()
            self._draw_history_skills()
            self._draw_history_detail_hero()
            self._draw_history_skill_share()
            self._draw_history_skill_quality()
            self._draw_history_critical_luck()
            self._draw_history_skill_timeline()
            self._render_skill_details()
            self._sync_backend_navigation()
            self._sync_expiry_label()
            self._sync_backend_sidebar_status()
            self._schedule_backend_sidebar_art()
            self._schedule_main_content_overlay_sync()
        if preserved_position is not None:
            try:
                # Flush any geometry negotiation caused by changing Tk's
                # scaling before restoring the exact position.  Do not pass
                # this through _visible_geometry: normal dragging must never
                # snap to a work area or monitor boundary.
                self.root.update_idletasks()
                if preserved_position != (
                    self.root.winfo_x(),
                    self.root.winfo_y(),
                ):
                    x, y = preserved_position
                    self.root.geometry(format_absolute_tk_position(x, y))
            except (AttributeError, TypeError, ValueError, tk.TclError):
                pass
        return True

    def _refresh_window_dpi(self) -> None:
        """Refresh fonts after the borderless window crosses a monitor.

        Tk does not expose ``WM_DPICHANGED`` as a normal virtual event.  A
        lightweight poll keeps a window moved between 100% and 125% monitors
        sharp without touching the capture thread or redrawing every frame.
        """
        if self.closing or not self.root.winfo_exists():
            return
        try:
            # The root stays withdrawn throughout sign-in and can retain the
            # DPI of a different monitor.  Letting it drive Tk's process-wide
            # scaling here immediately shrinks or enlarges the visible login
            # window after that window has already laid itself out.
            reference_window = next(
                (
                    candidate
                    for candidate in (
                        getattr(self, "notice_window", None),
                        getattr(self, "user_notice_window", None),
                        getattr(self, "login_window", None),
                    )
                    if candidate is not None and candidate.winfo_exists()
                ),
                self.root,
            )
            if reference_window is self.root:
                self._apply_window_dpi_if_changed()
            elif get_window_dpi(reference_window) != getattr(
                self, "window_dpi", 0
            ):
                self._prepare_toplevel_dpi(reference_window)
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            pass
        try:
            self.root.after(250, self._refresh_window_dpi)
        except tk.TclError:
            return

    def _configure_ui_fonts(self) -> None:
        base = int(self.ui_font_size)
        main_scale = float(getattr(self, "main_ui_scale", 1.0) or 1.0)
        main_base = max(10, int(round(base * main_scale)))
        specs = {
            "micro": (self.ui_font_family, max(9, base - 3), "normal"),
            "sidebar_micro": (
                self.ui_font_family,
                max(8, base - 4),
                "normal",
            ),
            "sidebar_tag": (
                self.ui_font_family,
                max(8, base - 4),
                "bold",
            ),
            "small": (self.ui_font_family, max(10, base - 2), "normal"),
            "body": (self.ui_font_family, base, "normal"),
            "strong": (self.ui_font_family, base, "bold"),
            "settings": (self.ui_font_family, base + 1, "normal"),
            "settings_strong": (self.ui_font_family, base + 1, "bold"),
            "settings_title": (self.ui_font_family, base + 3, "bold"),
            "dialog_body": (self.ui_font_family, base + 2, "normal"),
            "dialog_button": (self.ui_font_family, base + 2, "bold"),
            "dialog_title": (self.ui_font_family, base + 5, "bold"),
            "settings_number": (self.number_font_family, base + 1, "bold"),
            "title": (self.ui_font_family, base + 2, "bold"),
            "heading": (self.ui_font_family, base + 5, "bold"),
            "hero_title": (self.ui_font_family, base + 18, "bold"),
            "number": (self.number_font_family, base, "normal"),
            "number_small": (
                self.number_font_family,
                max(10, base - 2),
                "bold",
            ),
            "number_strong": (self.number_font_family, base, "bold"),
            "number_large": (self.number_font_family, base + 5, "bold"),
            "icon": ("Segoe UI Symbol", base + 3, "normal"),
            "nav": (self.ui_font_family, base + 1, "bold"),
            "table": (self.ui_font_family, base, "bold"),
            "table_compact": (
                self.ui_font_family,
                max(10, base - 2),
                "bold",
            ),
            "table_header": (self.ui_font_family, base + 1, "bold"),
            "table_header_compact": (
                self.ui_font_family,
                max(10, base - 1),
                "bold",
            ),
            "main_micro": (
                self.ui_font_family,
                max(8, main_base - 4),
                "normal",
            ),
            "main_text": (self.ui_font_family, main_base, "bold"),
            "main_strong": (self.ui_font_family, main_base, "bold"),
            "main_number_small": (
                self.number_font_family,
                max(10, main_base - 2),
                "bold",
            ),
            "main_number_strong": (
                self.number_font_family,
                main_base,
                "bold",
            ),
        }
        for role, (family, pixels, weight) in specs.items():
            # Positive Tk sizes are points and remain vector-rendered at the
            # display scale.  Negative sizes are physical pixels and are
            # bitmap-scaled poorly on 125% displays.
            options = {
                "family": family,
                "size": tk_font_size_for_pixels(pixels),
                "weight": weight,
            }
            if role in self.ui_fonts:
                self.ui_fonts[role].configure(**options)
            else:
                self.ui_fonts[role] = tkfont.Font(root=self.root, **options)

    def _ui_font(self, role: str = "body") -> tkfont.Font:
        return self.ui_fonts.get(role, self.ui_fonts["body"])

    def _show_login(self, *, activate: bool = True) -> None:
        if self.closing or (
            self.login_window is not None and self.login_window.winfo_exists()
        ):
            return
        window = tk.Toplevel(self.root)
        window.withdraw()
        self.login_window = window
        window.title(f"{UI_BRAND} · 登录")
        window.configure(bg=BORDER)
        initial_dpi = getattr(self, "window_dpi", DEFAULT_DPI)
        width, height = login_window_dimensions(
            initial_dpi, self.process_is_elevated
        )
        x = max(0, (self.root.winfo_screenwidth() - width) // 2)
        y = max(0, (self.root.winfo_screenheight() - height) // 2)
        window.geometry(format_absolute_tk_geometry(width, height, x, y))
        self._prepare_toplevel_dpi(window)
        dpi = get_window_dpi(window)
        width, height = login_window_dimensions(dpi, self.process_is_elevated)

        def px(value: object) -> int:
            return logical_pixels_to_physical(value, dpi)

        x = max(0, (self.root.winfo_screenwidth() - width) // 2)
        y = max(0, (self.root.winfo_screenheight() - height) // 2)
        window.geometry(format_absolute_tk_geometry(width, height, x, y))
        window.resizable(False, False)
        window.attributes("-topmost", False)
        window.attributes("-alpha", 1.0)
        window.overrideredirect(True)
        window.protocol("WM_DELETE_WINDOW", self.close)

        shell = tk.Frame(window, bg=BORDER, bd=0)
        shell.pack(fill="both", expand=True)
        body = tk.Frame(shell, bg=BG)
        body.pack(fill="both", expand=True, padx=px(1), pady=px(1))

        titlebar = tk.Frame(body, bg=SURFACE, height=px(44))
        titlebar.pack(fill="x")
        titlebar.pack_propagate(False)
        self._bind_drag(titlebar, window)

        logo_image = self.icons.app_logo(24)
        logo = tk.Label(titlebar, image=logo_image, bg=SURFACE, bd=0)
        logo.image = logo_image
        logo.pack(side="left", padx=(px(17), px(8)), pady=px(8))
        self._bind_drag(logo, window)

        title = tk.Label(
            titlebar,
            text=UI_BRAND,
            bg=SURFACE,
            fg=TEXT,
            font=self._ui_font("title"),
        )
        title.pack(side="left", fill="y")
