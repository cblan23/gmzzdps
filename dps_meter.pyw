    def _set_history_meter_mode(self, mode: str) -> None:
        mode = str(mode or "").casefold()
        if mode not in {"dps", "hps", "dt", "boss_damage"}:
            return
        if mode != self.history_meter_mode:
            self.history_meter_mode = mode
            self.history_selected_actor = 0
            self.history_skill_timeline_selected_hit = None
            self.history_skill_timeline_hover_hit = None
            self.history_skill_timeline_focus_time = None
        self._sync_history_meter_tabs()
        self._update_history_overview()
        self._render_history_selection()
        self._draw_history_list_header()
        self._render_history_snapshot()

    def _set_history_detail_mode(self, mode: str) -> None:
        boss_mode = self.history_meter_mode == "boss_damage"
        requested_mode = str(mode or "").casefold()
        previous_mode = getattr(self, "history_detail_mode", "skills")
        if (
            requested_mode == "equipment"
            and not boss_mode
            and previous_mode != "equipment"
            and getattr(self, "backend_current_page", "history") != "kings"
        ):
            # A late official settlement/equipment response may have updated
            # this battle after its detail page was first opened. Reload once
            # when entering the equipment tab instead of rendering a stale
            # in-memory copy that still says no snapshot.
            self.history_loaded_record = None
        self.history_detail_mode = (
            requested_mode
            if requested_mode == "equipment" and not boss_mode
            or boss_mode and requested_mode in {"skills", "targets"}
            else "skills"
        )
        taken_mode = self.history_meter_mode == "dt"
        if getattr(self, "history_layout_version", 1) >= 2:
            equipment_mode = self.history_detail_mode == "equipment"
            for key, button in self.history_detail_buttons.items():
                disabled = (
                    (taken_mode and key != "equipment")
                    or (key == "targets" and not boss_mode)
                    or (key == "equipment" and boss_mode)
                )
                button.configure(
                    text=(
                        "装备快照"
                        if key == "equipment"
                        else
                        "首领技能"
                        if key == "skills" and boss_mode
                        else "受击成员"
                        if key == "targets" and boss_mode
                        else "技能治疗"
                        if key == "skills" and self.history_meter_mode == "hps"
                        else "治疗目标"
                        if key == "targets" and self.history_meter_mode == "hps"
                        else "技能分布"
                        if key == "skills"
                        else "目标分布"
                    ),
                    fg=(
                        SUBTLE
                        if disabled
                        else ACCENT if key == self.history_detail_mode else MUTED
                    ),
                    cursor=(
                        "arrow" if disabled else "hand2"
                    ),
                )
            title = getattr(self, "history_skill_section_title_label", None)
            hint = getattr(self, "history_detail_hint_label", None)
            if equipment_mode:
                record = self._selected_history_record()
                participant = self._selected_history_equipment_participant(record)
                snapshot = (
                    participant.get("equipment_snapshot")
                    if isinstance(participant, dict) else None
                )
                stamp = (
                    self._history_equipment_timestamp(snapshot)
                    if isinstance(snapshot, dict) else "--"
                )
                if title is not None:
                    title.configure(text="装备快照")
                if hint is not None:
                    hint.configure(text=f"采集时间  {stamp}")
            else:
                if title is not None:
                    title.configure(text={
                        "dps": "技能伤害构成",
                        "hps": "技能治疗构成",
                        "dt": "承伤构成",
                        "boss_damage": "首领技能构成",
                    }.get(self.history_meter_mode, "技能分布"))
                if hint is not None:
                    hint.configure(text="按贡献从高到低排列")
            self._draw_history_skills()
            return
        if self.history_detail_header is not None:
            if taken_mode:
                self.history_detail_header.pack_forget()
            elif not self.history_detail_header.winfo_manager():
                self.history_detail_header.pack(fill="x", pady=(6, 0))
        if self.history_skill_panel is not None:
            if taken_mode:
                self.history_skill_panel.pack_forget()
            elif not self.history_skill_panel.winfo_manager():
                self.history_skill_panel.pack(fill="both", expand=True)
        if self.history_participant_panel is not None:
            self.history_participant_panel.pack_configure(
                fill="both" if taken_mode else "x",
                expand=taken_mode,
            )
        for key, button in self.history_detail_buttons.items():
            if taken_mode:
                button.pack_forget()
                continue
            if not button.winfo_manager():
                button.pack(side="left", fill="y")
            button.configure(
                text=(
                    ("首领技能" if key == "skills" else "受击成员")
                    if boss_mode
                    else (
                        "技能治疗"
                        if key == "skills"
                        else "治疗目标"
                    )
                    if self.history_meter_mode == "hps"
                    else ("技能详情" if key == "skills" else "目标伤害")
                ),
                fg=(
                    SUBTLE
                    if key == "targets" and not boss_mode
                    else ACCENT if key == self.history_detail_mode else MUTED
                ),
                cursor=(
                    "arrow" if key == "targets" and not boss_mode else "hand2"
                ),
            )
        self._draw_history_skills()

    def _refresh_history_records(self) -> None:
        if getattr(self, "backend_current_page", "history") == "kings":
            self._query_history_records()
            return
        if getattr(self, "history_layout_version", 1) >= 2:
            self._flush_combat_history(force=True)
            try:
                self.history_store.refresh_index()
                self._update_history_filter_options()
            except (OSError, TypeError, ValueError):
                pass
            self._query_history_records()
            return
        current = self.history_selected_id
        self.history_records = [
            record
            for record in self._load_recent_history(500)
            if not self.model.boss_only or self._history_is_boss(record)
        ]
        self.history_records.sort(
            key=lambda item: (
                bool(item.get("favorite", False)),
                float(item.get("ended_at_epoch", 0.0) or 0.0),
            ),
            reverse=True,
        )
        ids = {str(item.get("encounter_id", "")) for item in self.history_records}
        if current not in ids:
            current = (
                str(self.history_records[0].get("encounter_id", ""))
                if self.history_records
                else ""
            )
            self.history_selected_actor = 0
        self.history_selected_id = current
        if self.history_count_label is not None:
            favorites = sum(bool(item.get("favorite")) for item in self.history_records)
            suffix = f" · ★{favorites}" if favorites else ""
            self.history_count_label.configure(
                text=f"{len(self.history_records)} 场{suffix}"
            )
        self._render_history_selection()

    def _draw_history_list(self) -> None:
        if getattr(self, "history_layout_version", 1) >= 2:
            self._draw_indexed_history_list()
            return
        canvas = self.history_list_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        row_height = 66
        healing_mode = getattr(self, "history_meter_mode", "dps") == "hps"
        taken_mode = getattr(self, "history_meter_mode", "dps") == "dt"
        boss_mode = (
            getattr(self, "history_meter_mode", "dps") == "boss_damage"
        )
        if not self.history_records:
            canvas.create_text(
                width // 2,
                height // 2,
                text="暂无战斗记录",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        for index, record in enumerate(self.history_records):
            top = index * row_height
            bottom = top + row_height
            encounter_id = str(record.get("encounter_id", ""))
            selected = encounter_id == self.history_selected_id
            base = PANEL_2 if selected else (PANEL if index % 2 == 0 else SURFACE)
            accent = ACCENT if selected else BORDER
            monster = record.get("monster")
            monster = monster if isinstance(monster, dict) else {}
            target_name = str(monster.get("name", "")).strip() or (
                "Boss战斗" if self._history_is_boss(record) else "怪物战斗"
            )
            level = int(monster.get("level", 0) or 0)
            if level:
                target_name += f"  Lv.{level}"
            favorite = "★  " if record.get("favorite") else ""
            target_name = self._fit_main_actor_name(
                f"{favorite}{target_name}", max(32, width - 82)
            )
            tag = f"history:{index}"
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline="", tags=(tag,)
            )
            canvas.create_rectangle(
                0, top, 3, bottom - 1, fill=accent, outline="", tags=(tag,)
            )
            canvas.create_text(
                11,
                top + 13,
                text=target_name,
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
                tags=(tag,),
            )
            canvas.create_text(
                11,
                top + 34,
                text=self._history_timestamp(record),
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            canvas.create_text(
                11,
                top + 52,
                text=(
                    f"{format_duration(self._history_display_duration(record, healing_mode))}"
                    f"   {('有效治疗' if healing_mode else '总承伤' if taken_mode else '已归类首领伤害' if boss_mode else '总伤害')} "
                    f"{format_number((record.get('team_effective_healing', 0) if healing_mode else record.get('team_taken', 0) if taken_mode else self._history_boss_damage(record).get('observed_damage', 0) if boss_mode else record.get('total_damage', 0)) or 0)}"
                ),
                fill=ACCENT if selected else MUTED,
                anchor="w",
                font=self._ui_font("small"),
                tags=(tag,),
            )
            canvas.create_line(
                0, bottom - 1, width, bottom - 1, fill=BORDER, tags=(tag,)
            )
            canvas.tag_bind(
                tag,
                "<Button-1>",
                lambda _event, selected_id=encounter_id: self._select_history(
                    selected_id
                ),
            )
            canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
            canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor=""))
        canvas.configure(
            scrollregion=(0, 0, width, max(height, len(self.history_records) * row_height))
        )

    def _history_list_columns(self, width: int) -> dict[str, int]:
        """Lay out the summary row from measured text, not fixed character widths."""

        width = max(1, int(width))
        right = max(220, width - 9)
        micro = self._ui_font("micro")
        number = self._ui_font("number_strong")
        time_x = 36
        time_width = max(
            number.measure("00:00:00"),
            micro.measure("00-00 · 00:00:00"),
        )
        icon_extent = logical_pixels_to_physical(
            50, getattr(self, "window_dpi", DEFAULT_DPI)
        )
        icon_x = time_x + time_width + 12
        content_x = icon_x + icon_extent + 8
        operation_width = max(
            HISTORY_ACTION_PANEL_WIDTH, history_action_panel_width(micro)
        )
        operation_left = right - operation_width
        operation_center = operation_left + operation_width // 2
        cursor = operation_left - 10
        columns = {
            "check": 17,
            "time": time_x,
            "icon": icon_x,
            "icon_extent": icon_extent,
            "content": content_x,
            "operation": operation_center,
            "operation_left": operation_left,
            "right": right,
        }
        if self._history_field_visible("result"):
            result_width = max(74, micro.measure("战斗结果") + 22)
            columns["result"] = cursor
            columns["result_left"] = cursor - result_width
            cursor = columns["result_left"] - 12
        if self._history_field_visible("performance"):
            performance_width = max(
                124, micro.measure("团队 999,999 DPS") + 18
            )
            columns["performance"] = cursor - performance_width
            columns["performance_right"] = cursor
            cursor = columns["performance"] - 12
        if self._history_field_visible("extraordinary_rating"):
            rating_width = max(80, micro.measure("非凡评分") + 18)
            columns["extraordinary_rating"] = cursor - rating_width
            columns["extraordinary_rating_right"] = cursor
            cursor = columns["extraordinary_rating"] - 12
        if self._history_field_visible("character"):
            profession_icon_extent = logical_pixels_to_physical(
                22, getattr(self, "window_dpi", DEFAULT_DPI)
            )
            character_width = max(
                128,
                micro.measure("角色名称") + profession_icon_extent + 34,
            )
            columns["character"] = cursor - character_width
            columns["character_icon"] = columns["character"]
            columns["character_icon_extent"] = profession_icon_extent
            columns["character_name"] = (
                columns["character"] + profession_icon_extent + 6
            )
            columns["character_right"] = cursor
            cursor = columns["character"] - 12
        columns["content_right"] = max(content_x + 36, cursor)
        return columns

    def _draw_history_checkbox(
        self,
        canvas: tk.Canvas,
        center_x: int,
        center_y: int,
        state: str,
        tags: tuple[str, ...],
    ) -> None:
        """Draw the history selector without relying on a system glyph."""

        half = 8
        cut = 3
        left, top = center_x - half, center_y - half
        right, bottom = center_x + half, center_y + half
        points = (
            left + cut,
            top,
            right - cut,
            top,
            right,
            top + cut,
            right,
            bottom - cut,
            right - cut,
            bottom,
            left + cut,
            bottom,
            left,
            bottom - cut,
            left,
            top + cut,
        )
        checked = state == "checked"
        mixed = state == "mixed"
        canvas.create_polygon(
            points,
            fill=ACCENT if checked else "#17342c" if mixed else "#101419",
            outline=ACCENT if checked or mixed else "#465461",
            width=1,
            tags=tags,
        )
        if checked:
            canvas.create_line(
                center_x - 4,
                center_y,
                center_x - 1,
                center_y + 3,
                center_x + 5,
                center_y - 4,
                fill="#07110e",
                width=2,
                capstyle=tk.ROUND,
                joinstyle=tk.ROUND,
                tags=tags,
            )
        elif mixed:
            canvas.create_line(
                center_x - 4,
                center_y,
                center_x + 4,
                center_y,
                fill=ACCENT,
                width=2,
                capstyle=tk.ROUND,
                tags=tags,
            )

    def _draw_history_inline_actions(
        self,
        canvas: tk.Canvas,
        left_x: int,
        center_y: int,
        index: int,
        favorite: bool,
        battle_id: str = "",
        record: object = None,
    ) -> dict[str, str]:
        tags: dict[str, str] = {}
        upload_metadata = self._history_upload_state(battle_id)
        upload_state = str(
            upload_metadata.get("state", "pending") or "pending"
        ).casefold()
        action_font = self._ui_font("micro")
        specs = [
            (
                "report",
                "首领截图"
                if getattr(self, "history_meter_mode", "dps") == "boss_damage"
                else "全员截图",
                False,
            ),
        ]
        specs.extend((
            (
                "favorite",
                "收藏",
                favorite,
            ),
            (
                "delete",
                "删除",
                False,
            ),
        ))
        left = left_x
        for kind, caption, active in specs:
            button_width = history_action_button_width(
                action_font, kind, caption
            )
            action_tag = f"history-action-{kind}:{index}"
            background_tag = f"history-action-{kind}-bg:{index}"
            icon_tag = f"history-action-{kind}-icon:{index}"
            text_tag = f"history-action-{kind}-text:{index}"
            tags[kind] = action_tag
            right = left + button_width
            top, bottom = center_y - 14, center_y + 14
            fill, outline, foreground = self._history_inline_action_palette(
                kind, active=active, upload_state=upload_state
            )
            canvas.create_rectangle(
                left,
                top,
                right,
                bottom,
                fill=fill,
                outline=outline,
                width=1,
                tags=(action_tag, background_tag),
            )
            icon_name = {
                "report": "camera",
                "upload": "upload",
                "favorite": "star",
                "delete": "trash",
            }[kind]
            icon_size = 14 if kind in {"report", "upload"} else 12
            gap = HISTORY_ACTION_CONTENT_GAP
            text_width = action_font.measure(caption)
            group_width = icon_size + gap + text_width
            group_left = (left + right - group_width) / 2
            icon_image = self.icons.toolbar(icon_name, icon_size, foreground)
            canvas.create_image(
                group_left,
                center_y,
                image=icon_image,
                anchor="w",
                tags=(action_tag, icon_tag),
            )
            canvas.create_text(
                group_left + icon_size + gap,
                center_y,
                text=caption,
                fill=foreground,
                anchor="w",
                font=action_font,
                tags=(action_tag, text_tag),
            )
            if kind == "favorite" and active:
                canvas.create_line(
                    left + 1,
                    top + 1,
                    right - 1,
                    top + 1,
                    fill=WARN,
                    width=2,
                    tags=(action_tag,),
                )
            left = right + HISTORY_ACTION_BUTTON_GAP
        return tags

    @staticmethod
    def _history_inline_action_palette(
        kind: str,
        *,
        active: bool = False,
        hovered: bool = False,
        upload_state: str = "pending",
    ) -> tuple[str, str, str]:
        if kind == "upload":
            state = str(upload_state or "pending").casefold()
            if state == "uploading":
                return "#15191c", "#343b41", MUTED
            if state == "failed":
                return (
                    "#32171d" if hovered else "#251419",
                    ERROR,
                    ERROR,
                )
            if state == "ranked":
                return (
                    "#3b3017" if hovered else "#2d2616",
                    WARN,
                    WARN,
                )
            if state in {"included", "uploaded"}:
                return (
                    "#1a493c" if hovered else "#15362e",
                    ACCENT,
                    ACCENT,
                )
            if state == "ineligible":
                return (
                    "#242a2f" if hovered else "#171c20",
                    "#59636d",
                    "#a8b1ba",
                )
            return (
                "#1b2b39" if hovered else "#151e27",
                "#456077" if hovered else MODAL_BORDER,
                "#dce9f4" if hovered else "#a9b9c8",
            )
        if kind == "report":
            return (
                "#1b2b39" if hovered else "#151e27",
                "#456077" if hovered else MODAL_BORDER,
                "#dce9f4" if hovered else "#a9b9c8",
            )
        if kind == "favorite":
            if active or hovered:
                return (
                    "#332714" if hovered else "#282116",
                    WARN,
                    WARN,
                )
            return "#11171b", BORDER, MUTED
        if hovered:
            return "#30171c", ERROR, ERROR
        return "#1b1417", "#563039", "#d77982"

    def _set_history_inline_action_hover(
        self,
        canvas: tk.Canvas,
        index: int,
        kind: str,
        hovered: bool,
        *,
        active: bool = False,
        upload_state: str = "pending",
    ) -> None:
        fill, outline, foreground = self._history_inline_action_palette(
            kind,
            active=active,
            hovered=hovered,
            upload_state=upload_state,
        )
        canvas.itemconfigure(
            f"history-action-{kind}-bg:{index}",
            fill=fill,
            outline=outline,
        )
        canvas.itemconfigure(
            f"history-action-{kind}-text:{index}",
            fill=foreground,
        )
        icon_name = {
            "report": "camera",
            "upload": "upload",
            "favorite": "star",
            "delete": "trash",
        }.get(kind, "")
        if icon_name:
            icon_size = 14 if kind in {"report", "upload"} else 12
            canvas.itemconfigure(
                f"history-action-{kind}-icon:{index}",
                image=self.icons.toolbar(icon_name, icon_size, foreground),
            )
        disabled = kind == "upload" and not history_upload_action_clickable(
            upload_state
        )
        canvas.configure(cursor="arrow" if hovered and disabled else "hand2" if hovered else "")

    def _draw_history_list_header(self) -> None:
        canvas = getattr(self, "history_list_header_canvas", None)
        if canvas is None:
            return
        if getattr(self, "backend_current_page", "history") == "kings":
            self._draw_pvp_history_list_header()
            return
        canvas.delete("all")
        width = self._history_list_content_width(canvas.winfo_width())
        columns = self._history_list_columns(width)
        page_ids = {
            str(row.get("battle_id", row.get("encounter_id", "")))
            for row in self.history_records
            if str(row.get("battle_id", row.get("encounter_id", "")))
        }
        all_selected = bool(
            page_ids and page_ids.issubset(self.history_selected_ids)
        )
        some_selected = bool(page_ids.intersection(self.history_selected_ids))
        self._draw_history_checkbox(
            canvas,
            columns["check"],
            18,
            "checked" if all_selected else "mixed" if some_selected else "empty",
            ("history-select-all",),
        )
        performance_caption = {
            "dps": "团队 / 我的 DPS",
            "hps": "我的 HPS",
            "dt": "我的承伤",
            "boss_damage": "已归类首领伤害",
        }.get(getattr(self, "history_meter_mode", "dps"), "我的表现")
        if getattr(self, "backend_current_page", "history") == "kings":
            performance_caption = "本场战果"
        captions: list[tuple[str, int, str]] = [
            ("战斗时长", columns["time"], "w"),
            (
                "模式 / 地图" if getattr(self, "backend_current_page", "history") == "kings" else "Boss / 副本",
                columns["content"],
                "w",
            ),
        ]
        if self._history_field_visible("character"):
            captions.append(("角色名称", columns["character"], "w"))
        if self._history_field_visible("extraordinary_rating"):
            captions.append(
                ("非凡评分", columns["extraordinary_rating"], "w")
            )
        if self._history_field_visible("performance"):
            captions.append((performance_caption, columns["performance"], "w"))
        if self._history_field_visible("result"):
            captions.append(("战斗结果", columns["result"], "e"))
        captions.append(("操作", columns["operation"], "center"))
        for caption, x, anchor in captions:
            canvas.create_text(
                x,
                18,
                text=caption,
                fill=MUTED,
                anchor=anchor,
                font=self._ui_font("micro"),
            )
        canvas.create_line(0, 35, width, 35, fill=BORDER)
        canvas.configure(scrollregion=(0, 0, width, 36))
        canvas.tag_bind(
            "history-select-all",
            "<Button-1>",
            lambda _event: self._toggle_history_select_all(),
        )
        canvas.tag_bind(
            "history-select-all",
            "<Enter>",
            lambda _event: canvas.configure(cursor="hand2"),
        )
        canvas.tag_bind(
            "history-select-all",
            "<Leave>",
            lambda _event: canvas.configure(cursor=""),
        )

