    def _resize_history_page_content(self, event) -> None:
        self._refresh_history_page_extent(
            viewport_width=getattr(event, "width", 1),
            viewport_height=getattr(event, "height", 1),
        )

    def _refresh_history_page_extent(
        self,
        *,
        viewport_width: object | None = None,
        viewport_height: object | None = None,
    ) -> None:
        canvas = getattr(self, "history_page_canvas", None)
        window_id = getattr(self, "history_page_content_window", None)
        if canvas is None or window_id is None:
            return
        try:
            width = max(
                1,
                int(
                    canvas.winfo_width()
                    if viewport_width is None
                    else viewport_width
                ),
            )
        except (TypeError, ValueError, OverflowError, tk.TclError):
            width = 1
        try:
            viewport = max(
                1,
                int(
                    canvas.winfo_height()
                    if viewport_height is None
                    else viewport_height
                ),
            )
        except (TypeError, ValueError, OverflowError, tk.TclError):
            viewport = 1
        detail_minimum = self._history_detail_minimum_content_height()
        minimum = (
            detail_minimum
            if getattr(self, "history_page_mode", "browser") == "detail"
            else HISTORY_PAGE_MIN_CONTENT_HEIGHT
        )
        height = max(
            minimum,
            viewport,
        )
        try:
            if self.history_browser_frame is not None:
                self.history_browser_frame.configure(
                    width=width,
                    height=max(HISTORY_PAGE_MIN_CONTENT_HEIGHT, viewport),
                )
            if self.history_battle_detail_frame is not None:
                self.history_battle_detail_frame.configure(
                    width=width,
                    height=max(detail_minimum, viewport),
                )
            canvas.itemconfigure(window_id, width=width, height=height)
            canvas.configure(scrollregion=(0, 0, width, height))
        except tk.TclError:
            return

    def _history_detail_minimum_content_height(self) -> int:
        if bool(
            getattr(self, "history_local_detail_modules_visible", True)
        ):
            opener_height = max(
                HISTORY_OPENER_PANEL_MIN_HEIGHT,
                int(
                    getattr(
                        self,
                        "history_opener_panel_height",
                        HISTORY_OPENER_PANEL_MIN_HEIGHT,
                    )
                    or HISTORY_OPENER_PANEL_MIN_HEIGHT
                ),
            )
            return (
                HISTORY_DETAIL_MIN_CONTENT_HEIGHT
                + opener_height
                - HISTORY_OPENER_PANEL_MIN_HEIGHT
            )
        return max(
            HISTORY_PAGE_MIN_CONTENT_HEIGHT,
            HISTORY_DETAIL_MIN_CONTENT_HEIGHT
            - HISTORY_DETAIL_LOCAL_MODULES_HEIGHT,
        )

    def _scroll_history_page(self, event) -> str | None:
        canvas = getattr(self, "history_page_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return None
        widget = getattr(event, "widget", None)
        inner_canvases = {
            getattr(self, "history_list_canvas", None),
            getattr(self, "history_participant_canvas", None),
            getattr(self, "history_skill_canvas", None),
            getattr(self, "history_skill_quality_canvas", None),
            getattr(self, "history_skill_timeline_canvas", None),
        }
        if widget in inner_canvases:
            return None
        amount = self._history_mousewheel_amount(event)
        if not amount:
            return None
        try:
            canvas.yview_scroll(amount, "units")
        except tk.TclError:
            return None
        return "break"

    def _reset_history_page_scroll(self) -> None:
        canvas = getattr(self, "history_page_canvas", None)
        if canvas is None:
            return
        try:
            canvas.yview_moveto(0.0)
        except tk.TclError:
            return

    @staticmethod
    def _history_mousewheel_amount(event) -> int:
        try:
            button = int(getattr(event, "num", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            button = 0
        try:
            delta = int(getattr(event, "delta", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            delta = 0
        if button == 4:
            amount = -1
        elif button == 5:
            amount = 1
        elif delta:
            amount = -max(1, abs(delta) // 120) if delta > 0 else max(
                1, abs(delta) // 120
            )
        else:
            return 0
        return amount

    def _scroll_history_inner_canvas(self, canvas: tk.Canvas, event) -> str:
        amount = self._history_mousewheel_amount(event)
        if not amount:
            return "break"
        page_canvas = getattr(self, "history_page_canvas", None)

        def scroll_page() -> None:
            try:
                if page_canvas is not None and page_canvas.winfo_exists():
                    page_canvas.yview_scroll(amount, "units")
            except tk.TclError:
                pass

        before: tuple[float, float] | None = None
        try:
            first, last = (float(value) for value in canvas.yview())
            before = (first, last)
        except (AttributeError, TypeError, ValueError, tk.TclError):
            pass
        can_scroll_inner = before is None or (
            before[1] - before[0] < 0.999999
            and (
                (amount < 0 and before[0] > 0.000001)
                or (amount > 0 and before[1] < 0.999999)
            )
        )
        if not can_scroll_inner:
            scroll_page()
            return "break"
        try:
            canvas.yview_scroll(amount, "units")
        except tk.TclError:
            scroll_page()
            return "break"
        if before is not None:
            try:
                after = tuple(float(value) for value in canvas.yview())
            except (AttributeError, TypeError, ValueError, tk.TclError):
                after = None
            if after is not None and all(
                abs(current - previous) <= 0.0000001
                for current, previous in zip(after, before)
            ):
                scroll_page()
        return "break"

    def _bind_history_inner_mousewheel(
        self,
        canvas: tk.Canvas,
        *event_widgets: tk.Misc,
    ) -> None:
        for widget in (canvas, *event_widgets):
            for event_name in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
                widget.bind(
                    event_name,
                    lambda event, target=canvas: self._scroll_history_inner_canvas(
                        target, event
                    ),
                )

