        color = PROFESSION_COLORS.get(profession_id, SUBTLE)
        key = ("profession-watermark", profession_id, physical_size, color)
        if key in self.cache:
            return self.cache[key]

        rgb = tuple(int(color[index : index + 2], 16) for index in (1, 3, 5))
        image = Image.new(
            "RGBA", (physical_size, physical_size), (0, 0, 0, 0)
        )
        path = ASSET_DIR / "professions" / f"{profession_id}.png"
        if not path.is_file():
            path = ASSET_DIR / f"{profession_id}.png"
        source: Image.Image | None = None
        if path.is_file():
            try:
                source = Image.open(path).convert("RGBA")
            except (OSError, ValueError):
                source = None
        if source is not None and source.getchannel("A").getbbox() is not None:
            source = source.crop(source.getchannel("A").getbbox())
            source.thumbnail(
                (physical_size, physical_size), Image.Resampling.LANCZOS
            )
            mask = source.getchannel("A").point(lambda value: round(value * 0.16))
            crest = Image.new("RGBA", source.size, rgb + (0,))
            crest.putalpha(mask)
            image.alpha_composite(
                crest,
                (
                    (physical_size - crest.width) // 2,
                    (physical_size - crest.height) // 2,
                ),
            )
        else:
            draw = ImageDraw.Draw(image, "RGBA")
            glyph = self.PROFESSION_GLYPHS.get(profession_id, "?")
            font = self._font(max(12, round(physical_size * 0.62)), bold=True)
            box = draw.textbbox((0, 0), glyph, font=font)
            draw.text(
                (
                    (physical_size - (box[2] - box[0])) / 2 - box[0],
                    (physical_size - (box[3] - box[1])) / 2 - box[1],
                ),
                glyph,
                font=font,
                fill=rgb + (40,),
            )
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def pvp_duel_hero(
        self,
        width: int,
        height: int,
        team_size: int = 1,
    ) -> ImageTk.PhotoImage:
        """Render the supplied PvP artwork for the selected team size."""

        logical_width = max(1, int(width))
        logical_height = max(1, int(height))
        physical_width = self._physical_size(logical_width)
        physical_height = self._physical_size(logical_height)
        normalized_team_size = (
            int(team_size)
            if int(team_size or 0) in {1, 3, 6, 12}
            else 1
        )
        source_path = (
            PVP_DETAIL_BANNER_UNIFIED_PATH
            if PVP_DETAIL_BANNER_UNIFIED_PATH.is_file()
            else PVP_TEAM3V3_DETAIL_BANNER_PATH
            if normalized_team_size == 3 and PVP_TEAM3V3_DETAIL_BANNER_PATH.is_file()
            else PVP_DUEL_DETAIL_SOURCE_PATH
        )
        key = (
            "pvp-duel-hero",
            normalized_team_size,
            physical_width,
            physical_height,
        )
        if key in self.cache:
            return self.cache[key]
        image: Image.Image | None = None
        if source_path.is_file():
            try:
                source = Image.open(source_path).convert("RGB")
                if source_path == PVP_DETAIL_BANNER_UNIFIED_PATH or normalized_team_size == 3:
                    panorama = source
                else:
                    # The source sheet places the finished full-width duel
                    # banner in its first 325 of 725 pixels. Crop exactly that
                    # supplied region; none of the artwork is regenerated.
                    panorama_bottom = max(1, round(source.height * 325 / 725))
                    panorama = source.crop(
                        (0, 0, source.width, panorama_bottom)
                    )
                # Keep the supplied artwork's aspect ratio. Directly
                # resizing the panorama to the native canvas stretched or
                # compressed the two fighters differently at wide windows.
                scale = max(
                    physical_width / max(1, panorama.width),
                    physical_height / max(1, panorama.height),
                )
                resized = panorama.resize(
                    (
                        max(1, round(panorama.width * scale)),
                        max(1, round(panorama.height * scale)),
                    ),
                    Image.Resampling.LANCZOS,
                )
                left = max(0, (resized.width - physical_width) // 2)
                top_overflow = max(0, resized.height - physical_height)
                # The 3V3 artwork places its title near the top; center-cropping
                # a wide, shallow hero removed it and overemphasized the figures.
                focus = (
                    0.0
                    if source_path == PVP_DETAIL_BANNER_UNIFIED_PATH
                    else 0.09
                    if normalized_team_size == 3
                    else 0.44
                )
                top = min(top_overflow, max(0, round(top_overflow * focus)))
                image = resized.crop(
                    (left, top, left + physical_width, top + physical_height)
                ).convert("RGBA")
            except (OSError, ValueError):
                image = None
        if image is None:
            image = Image.new(
                "RGBA", (physical_width, physical_height), (5, 18, 20, 255)
            )
        overlay = Image.new(
            "RGBA", (physical_width, physical_height), (0, 0, 0, 0)
        )
        draw = ImageDraw.Draw(overlay, "RGBA")
        for x in range(physical_width):
            ratio = x / max(1, physical_width - 1)
            alpha = round(150 - 65 * min(1.0, ratio / 0.62))
            draw.line((x, 0, x, physical_height), fill=(2, 8, 10, alpha))
        for y in range(physical_height):
            ratio = y / max(1, physical_height - 1)
            draw.line(
                (0, y, physical_width, y),
                fill=(2, 6, 8, round(max(0.0, ratio - 0.45) * 145)),
            )
        image = Image.alpha_composite(image, overlay)
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]

    def history_hero(
        self,
        dungeon_name: object,
        width: int,
        height: int,
    ) -> ImageTk.PhotoImage:
        """Render the cinematic encounter backdrop used by history details."""

        logical_width = max(1, int(width))
        logical_height = max(1, int(height))
        physical_width = self._physical_size(logical_width)
        physical_height = self._physical_size(logical_height)
        dungeon = str(dungeon_name or "").strip()
        key = (
            "history-hero",
            dungeon,
            physical_width,
            physical_height,
        )
        if key in self.cache:
            return self.cache[key]

        source_path = (
            ASSET_DIR / "bosses" / "may-manor-background.png"
            if "五月庄园" in dungeon
            else Path()
        )
        image: Image.Image | None = None
        if source_path.is_file():
            try:
                source = Image.open(source_path).convert("RGB")
                scale = max(
                    physical_width / max(1, source.width),
                    physical_height / max(1, source.height),
                )
                resized = source.resize(
                    (
                        max(1, round(source.width * scale)),
                        max(1, round(source.height * scale)),
                    ),
                    Image.Resampling.LANCZOS,
                )
                left = max(0, (resized.width - physical_width) // 2)
                top = max(
                    0,
                    min(
                        resized.height - physical_height,
                        round((resized.height - physical_height) * 0.48),
                    ),
                )
                image = resized.crop(
                    (
                        left,
                        top,
                        left + physical_width,
                        top + physical_height,
                    )
                ).convert("RGBA")
            except (OSError, ValueError):
                image = None

        if image is None:
            themes = (
                ("黑荆棘", (20, 49, 43), (8, 14, 18)),
                ("安提哥努斯", (45, 36, 64), (10, 12, 20)),
                ("记忆的传承", (24, 42, 62), (8, 13, 20)),
                ("木桩", (63, 47, 28), (15, 14, 13)),
            )
            bright, dark = next(
                ((bright, dark) for token, bright, dark in themes if token in dungeon),
                ((24, 53, 48), (8, 14, 17)),
            )
            image = Image.new(
                "RGBA", (physical_width, physical_height), dark + (255,)
            )
            draw = ImageDraw.Draw(image, "RGBA")
            for x in range(physical_width):
                ratio = x / max(1, physical_width - 1)
                color = tuple(
                    round(dark[index] + (bright[index] - dark[index]) * ratio)
                    for index in range(3)
                )
                draw.line((x, 0, x, physical_height), fill=color + (255,))
            seed = int.from_bytes(
                hashlib.sha1((dungeon or "history").encode("utf-8")).digest()[:4],
                "big",
            )
            for index in range(9):
                offset = (seed >> (index * 3)) & 0x7F
                x = int(physical_width * (0.34 + index * 0.085))
                peak = int(physical_height * (0.18 + offset / 460))
                draw.polygon(
                    (
                        (x - physical_width // 18, physical_height),
                        (x, peak),
                        (x + physical_width // 16, physical_height),
                    ),
                    fill=(180, 214, 205, 8 + index),
                )

        overlay = Image.new(
            "RGBA", (physical_width, physical_height), (0, 0, 0, 0)
        )
        overlay_draw = ImageDraw.Draw(overlay, "RGBA")
        for x in range(physical_width):
            ratio = x / max(1, physical_width - 1)
            if ratio < 0.55:
                alpha = round(224 - 135 * ratio / 0.55)
            else:
                alpha = round(89 + 48 * (ratio - 0.55) / 0.45)
            overlay_draw.line(
                (x, 0, x, physical_height), fill=(3, 8, 9, alpha)
            )
        for y in range(physical_height):
            ratio = y / max(1, physical_height - 1)
            alpha = round(max(0.0, ratio - 0.48) / 0.52 * 132)
            overlay_draw.line(
                (0, y, physical_width, y), fill=(3, 7, 9, alpha)
            )
        image = Image.alpha_composite(image.convert("RGBA"), overlay)
        self.cache[key] = ImageTk.PhotoImage(image, master=self.root)
        return self.cache[key]


class ModernScrollbar(tk.Canvas):
    """Canvas scrollbar that stays consistent across Windows themes."""

    MIN_THUMB_LENGTH = 28
    TRACK_PADDING = 2

    def __init__(
        self,
        parent: tk.Misc,
        *,
        orient: str = "vertical",
        command=None,
        background: str = PANEL,
        width: int = 10,
    ) -> None:
        self.orient = "horizontal" if orient == "horizontal" else "vertical"
        dimensions = (
            {"height": width}
            if self.orient == "horizontal"
            else {"width": width}
        )
        super().__init__(
            parent,
            **dimensions,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor="arrow",
            takefocus=0,
        )
        self.command = command
        self.first = 0.0
        self.last = 1.0
        self.hovered = False
        self.dragging = False
        self.drag_offset = 0.0
        self.bind("<Configure>", self._redraw)
        self.bind("<Enter>", self._enter)
        self.bind("<Leave>", self._leave)
        self.bind("<ButtonPress-1>", self._pointer_down)
        self.bind("<B1-Motion>", self._pointer_move)
        self.bind("<ButtonRelease-1>", self._pointer_up)
        self.bind("<MouseWheel>", self._mouse_wheel)
        self.bind("<Button-4>", lambda _event: self._scroll_units(-1))
        self.bind("<Button-5>", lambda _event: self._scroll_units(1))
        self.after_idle(self._redraw)

    def set(self, first: object, last: object) -> None:
        try:
            normalized_first = float(first)
            normalized_last = float(last)
        except (TypeError, ValueError, OverflowError):
            normalized_first, normalized_last = 0.0, 1.0
        self.first = min(1.0, max(0.0, normalized_first))
        self.last = min(1.0, max(self.first, normalized_last))
        try:
            self.configure(
                cursor="hand2" if self._scrollable() else "arrow"
            )
            self._redraw()
        except tk.TclError:
            pass

    def get(self) -> tuple[float, float]:
        return self.first, self.last

    def _scrollable(self) -> bool:
        return self.last - self.first < 0.999999

    def _axis_length(self) -> int:
        return max(
            1,
            self.winfo_width()
            if self.orient == "horizontal"
            else self.winfo_height(),
        )

    def _thumb_bounds(self) -> tuple[float, float]:
        padding = self.TRACK_PADDING
        track_length = max(1.0, self._axis_length() - padding * 2)
        view_span = min(1.0, max(0.0, self.last - self.first))
        thumb_length = min(
            track_length,
            max(float(self.MIN_THUMB_LENGTH), track_length * view_span),
        )
        travel = max(0.0, track_length - thumb_length)
        max_first = max(0.0, 1.0 - view_span)
        position = self.first / max_first if max_first > 0.0 else 0.0
        start = padding + travel * min(1.0, max(0.0, position))
        return start, start + thumb_length

    def _event_axis(self, event) -> float:
        return float(event.x if self.orient == "horizontal" else event.y)

    def _redraw(self, _event=None) -> None:
        try:
            self.delete("all")
            length = self._axis_length()
            cross = (
                max(1, self.winfo_height())
                if self.orient == "horizontal"
                else max(1, self.winfo_width())
            )
            center = cross / 2
            track_color = BORDER if self._scrollable() else PANEL_2
            if self.orient == "horizontal":
                self.create_line(
                    2,
                    center,
                    max(2, length - 2),
                    center,
                    fill=track_color,
                    width=2,
                )
            else:
                self.create_line(
                    center,
                    2,
                    center,
                    max(2, length - 2),
                    fill=track_color,
                    width=2,
                )
            if not self._scrollable():
                return
            start, end = self._thumb_bounds()
            thumb_color = ACCENT if self.hovered or self.dragging else "#536170"
            inset = min(4.0, max(1.0, (end - start) / 3))
            if self.orient == "horizontal":
                self.create_line(
                    start + inset,
                    center,
                    end - inset,
                    center,
                    fill=thumb_color,
                    width=6,
                    capstyle="round",
                )
            else:
                self.create_line(
                    center,
                    start + inset,
                    center,
                    end - inset,
                    fill=thumb_color,
                    width=6,
                    capstyle="round",
                )
        except tk.TclError:
            return

    def _enter(self, _event=None) -> None:
        self.hovered = True
        self._redraw()

    def _leave(self, _event=None) -> None:
        self.hovered = False
        self._redraw()

    def _pointer_down(self, event) -> str:
        if not self._scrollable() or self.command is None:
            return "break"
        position = self._event_axis(event)
        start, end = self._thumb_bounds()
        if start <= position <= end:
            self.dragging = True
            self.drag_offset = position - start
        else:
            direction = -1 if position < start else 1
            self.command("scroll", direction, "pages")
        self._redraw()
        return "break"

    def _pointer_move(self, event) -> str:
        if not self.dragging or self.command is None:
            return "break"
        padding = self.TRACK_PADDING
        start, end = self._thumb_bounds()
        thumb_length = end - start
        track_length = max(1.0, self._axis_length() - padding * 2)
        travel = max(0.0, track_length - thumb_length)
        view_span = min(1.0, max(0.0, self.last - self.first))
        max_first = max(0.0, 1.0 - view_span)
        visual_start = min(
            padding + travel,
            max(padding, self._event_axis(event) - self.drag_offset),
        )
        fraction = (
            (visual_start - padding) / travel * max_first
            if travel > 0.0
            else 0.0
        )
        self.command("moveto", f"{fraction:.8f}")
        return "break"

    def _pointer_up(self, _event=None) -> str:
        self.dragging = False
        self._redraw()
        return "break"

    def _scroll_units(self, amount: int) -> str:
        if self._scrollable() and self.command is not None:
            self.command("scroll", int(amount), "units")
        return "break"

    def _mouse_wheel(self, event) -> str:
        delta = int(getattr(event, "delta", 0) or 0)
        if delta:
            steps = max(1, abs(delta) // 120)
            return self._scroll_units(-steps if delta > 0 else steps)
        return "break"


class ModernTextField(tk.Canvas):
    """Canvas-drawn single-line field with an IME-capable text core."""

    def __init__(
        self,
        parent: tk.Misc,
        *,
        placeholder: str,
        width: int,
        font,
        background: str = SURFACE,
        icon: str = "",
        on_change=None,
        height: int = 34,
    ) -> None:
        self.control_width = max(88, int(width))
        self.control_height = max(30, int(height))
        self.control_background = background
        self.placeholder = str(placeholder)
        self.leading_icon = str(icon or "")
        self.on_change = on_change
        self.hovered = False
        self.focused = False
        self._placeholder_visible = False
        super().__init__(
            parent,
            width=self.control_width,
            height=self.control_height,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor="xterm",
            takefocus=0,
        )
        self.entry = tk.Entry(
            self,
            bg=background,
            fg=TEXT,
            insertbackground=ACCENT,
            selectbackground="#315b4c",
            selectforeground=TEXT,
            relief="flat",
            bd=0,
            highlightthickness=0,
            font=font,
        )
        self._entry_window = self.create_window(
            0, 0, window=self.entry, anchor="w"
        )
        self.bind("<Configure>", self._redraw)
        self.bind("<Enter>", self._enter)
        self.bind("<Leave>", self._leave)
        self.bind("<Button-1>", lambda _event: self.entry.focus_set())
        self.entry.bind("<FocusIn>", self._focus_in)
        self.entry.bind("<FocusOut>", self._focus_out)
        self.entry.bind("<KeyRelease>", self._key_released)
        self.reset()
        self.after_idle(self._redraw)

    def _current_width(self) -> int:
        return max(self.control_width, self.winfo_width())

    def _current_height(self) -> int:
        return max(self.control_height, self.winfo_height())

    def _redraw(self, _event=None) -> None:
        try:
            width = self._current_width()
            height = self._current_height()
            self.delete("field-chrome")
            outline = ACCENT if self.focused else (
                blend_color(BORDER, ACCENT, 0.45) if self.hovered else BORDER
            )
            self.create_rectangle(
                0,
                0,
                width - 1,
                height - 1,
                fill=self.control_background,
                outline=outline,
                width=1,
                tags=("field-chrome",),
            )
            left = 11
            if self.leading_icon == "search":
                center_y = height / 2 - 1
                self.create_oval(
                    13,
                    center_y - 6,
                    24,
                    center_y + 5,
                    outline=ACCENT if self.focused or self.hovered else MUTED,
                    width=1,
                    tags=("field-chrome",),
                )
                self.create_line(
                    22,
                    center_y + 4,
                    27,
                    center_y + 9,
                    fill=ACCENT if self.focused or self.hovered else MUTED,
                    width=2,
                    capstyle="round",
                    tags=("field-chrome",),
                )
                left = 38
            self.coords(self._entry_window, left, height / 2)
            self.itemconfigure(
                self._entry_window,
                width=max(20, width - left - 9),
                height=max(20, height - 4),
            )
            self.tag_lower("field-chrome", self._entry_window)
        except tk.TclError:
            return

    def _enter(self, _event=None) -> None:
        self.hovered = True
        self._redraw()

    def _leave(self, _event=None) -> None:
        self.hovered = False
        self._redraw()

    def _focus_in(self, _event=None) -> None:
        self.focused = True
        if self._placeholder_visible:
            self.entry.delete(0, "end")
            self.entry.configure(fg=TEXT)
            self._placeholder_visible = False
        self._redraw()

    def _focus_out(self, _event=None) -> None:
        self.focused = False
        if not self.entry.get().strip():
            self._show_placeholder()
        self._redraw()
        self._notify_change()

    def _key_released(self, _event=None) -> None:
        self._notify_change()

    def _notify_change(self) -> None:
        if self.on_change is not None:
            self.on_change()

    def _show_placeholder(self) -> None:
        self.entry.delete(0, "end")
        self.entry.insert(0, self.placeholder)
        self.entry.configure(fg=MUTED)
        self._placeholder_visible = True

    def value(self) -> str:
        if self._placeholder_visible:
            return ""
        return self.entry.get().strip()

    def reset(self) -> None:
        self._show_placeholder()
        self._redraw()

    def set_value(self, value: object) -> None:
        self.entry.delete(0, "end")
        text = str(value or "")
        if text:
            self.entry.insert(0, text)
            self.entry.configure(fg=TEXT)
            self._placeholder_visible = False
        else:
            self._show_placeholder()
        self._redraw()

    def focus_set(self) -> None:
        self.entry.focus_set()


class ModernTextArea(tk.Canvas):
    """Canvas-framed multiline editor matching the dark application theme."""

    def __init__(
        self,
        parent: tk.Misc,
        *,
        font,
        background: str = SURFACE,
        height: int = 112,
    ) -> None:
        self.control_background = background
        self.focused = False
        self.hovered = False
        super().__init__(
            parent,
            height=max(72, int(height)),
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor="xterm",
            takefocus=0,
        )
        self.editor = tk.Text(
            self,
            bg=background,
            fg=TEXT,
            insertbackground=ACCENT,
            selectbackground="#315b4c",
            selectforeground=TEXT,
            relief="flat",
            bd=0,
            highlightthickness=0,
            padx=9,
            pady=7,
            wrap="word",
            font=font,
        )
        self._editor_window = self.create_window(
            1, 1, window=self.editor, anchor="nw"
        )
        self.bind("<Configure>", self._redraw)
        self.bind("<Enter>", self._enter)
        self.bind("<Leave>", self._leave)
        self.bind("<Button-1>", lambda _event: self.editor.focus_set())
        self.editor.bind("<FocusIn>", self._focus_in)
        self.editor.bind("<FocusOut>", self._focus_out)
        self.after_idle(self._redraw)

    def _redraw(self, _event=None) -> None:
        try:
            width = max(2, self.winfo_width())
            height = max(2, self.winfo_height())
            self.delete("area-chrome")
            outline = ACCENT if self.focused else (
                blend_color(BORDER, ACCENT, 0.45) if self.hovered else BORDER
            )
            self.create_rectangle(
                0,
                0,
                width - 1,
                height - 1,
                fill=self.control_background,
                outline=outline,
                tags=("area-chrome",),
            )
            self.coords(self._editor_window, 1, 1)
            self.itemconfigure(
                self._editor_window,
                width=max(1, width - 2),
                height=max(1, height - 2),
            )
            self.tag_lower("area-chrome", self._editor_window)
        except tk.TclError:
            return

    def _enter(self, _event=None) -> None:
        self.hovered = True
        self._redraw()

    def _leave(self, _event=None) -> None:
        self.hovered = False
        self._redraw()

    def _focus_in(self, _event=None) -> None:
        self.focused = True
        self._redraw()

    def _focus_out(self, _event=None) -> None:
        self.focused = False
        self._redraw()

    def insert(self, index, value: object) -> None:
        self.editor.insert(index, value)

    def get(self, first, last=None) -> str:
        if last is None:
            return self.editor.get(first)
        return self.editor.get(first, last)

    def focus_set(self) -> None:
        self.editor.focus_set()


class ModernSplitPane(tk.Frame):
    """Two-column split pane with a canvas-drawn draggable divider."""

    DIVIDER_WIDTH = 8

    def __init__(
        self,
        parent: tk.Misc,
        *,
        background: str = BG,
        on_resize=None,
    ) -> None:
        super().__init__(parent, bg=background)
        self.background = background
        self.on_resize = on_resize
        self._panes: list[dict[str, object]] = []
        self._manual_first_width: int | None = None
        self._drag_start_x = 0
        self._drag_start_width = 0
        self._divider_hovered = False
        self._divider_dragging = False
        self._divider = tk.Canvas(
            self,
            width=self.DIVIDER_WIDTH,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor="sb_h_double_arrow",
            takefocus=0,
        )
        self._divider.bind("<Enter>", self._divider_enter)
        self._divider.bind("<Leave>", self._divider_leave)
        self._divider.bind("<ButtonPress-1>", self._drag_start)
        self._divider.bind("<B1-Motion>", self._drag_move)
        self._divider.bind("<ButtonRelease-1>", self._drag_end)
        self.bind("<Configure>", self._layout)

    def add(
        self,
        pane: tk.Widget,
        *,
        minsize: int = 0,
        width: int | None = None,
        stretch: str = "always",
    ) -> None:
        if len(self._panes) >= 2:
            raise ValueError("ModernSplitPane supports exactly two panes")
        self._panes.append(
            {
                "widget": pane,
                "minsize": max(0, int(minsize)),
                "width": max(0, int(width)) if width is not None else None,
                "stretch": str(stretch),
            }
        )
        pane.place(x=0, y=0, width=1, height=1)
        if len(self._panes) == 2:
            self._divider.place(x=0, y=0, width=self.DIVIDER_WIDTH, relheight=1)
        self.after_idle(self._layout)

    def _available_width(self) -> int:
        return max(0, self.winfo_width() - self.DIVIDER_WIDTH)

    def _split_width(self) -> int:
        if len(self._panes) < 2:
            return max(0, self.winfo_width())
        available = self._available_width()
        first, second = self._panes
        first_min = int(first["minsize"])
        second_min = int(second["minsize"])
        if self._manual_first_width is not None:
            preferred = self._manual_first_width
        elif first["stretch"] == "never":
            preferred = int(first["width"] or first_min)
        elif second["stretch"] == "never":
            preferred = available - int(second["width"] or second_min)
        else:
            first_pref = int(first["width"] or first_min or 1)
            second_pref = int(second["width"] or second_min or 1)
            preferred = round(available * first_pref / (first_pref + second_pref))
        lower = first_min
        upper = available - second_min
        if upper < lower:
            total_min = max(1, first_min + second_min)
            return max(0, round(available * first_min / total_min))
        return min(upper, max(lower, int(preferred)))

    def _layout(self, _event=None) -> None:
        if not self._panes:
            return
        width = max(1, self.winfo_width())
        height = max(1, self.winfo_height())
        if len(self._panes) == 1:
            self._panes[0]["widget"].place(
                x=0, y=0, width=width, height=height
            )
            return
        stack_below = int(getattr(self, "stack_below", 0) or 0)
        if stack_below and width < stack_below:
            first_height = min(
                max(1, int(getattr(self, "stack_first_height", 250))),
                max(1, height - self.DIVIDER_WIDTH - 1),
            )
            self._panes[0]["widget"].place(
                x=0, y=0, width=width, height=first_height
            )
            self._divider.place_forget()
            self._panes[1]["widget"].place(
                x=0, y=first_height + self.DIVIDER_WIDTH,
                width=width,
                height=max(1, height - first_height - self.DIVIDER_WIDTH),
            )
            return
        first_width = self._split_width()
        second_x = first_width + self.DIVIDER_WIDTH
        second_width = max(0, width - second_x)
        self._panes[0]["widget"].place(
            x=0, y=0, width=first_width, height=height
        )
        self._divider.place(
            x=first_width,
            y=0,
            width=self.DIVIDER_WIDTH,
            height=height,
        )
        self._panes[1]["widget"].place(
            x=second_x, y=0, width=second_width, height=height
        )
        self._draw_divider()

    def _draw_divider(self) -> None:
        self._divider.delete("all")
        width = max(1, self._divider.winfo_width())
        height = max(1, self._divider.winfo_height())
        color = ACCENT if self._divider_hovered or self._divider_dragging else BORDER
        center = width / 2
        self._divider.create_line(center, 0, center, height, fill=color, width=1)
        grip_y = height / 2
        for offset in (-5, 0, 5):
            self._divider.create_oval(
                center - 1,
                grip_y + offset - 1,
                center + 1,
                grip_y + offset + 1,
                fill=color,
                outline="",
            )

    def _divider_enter(self, _event=None) -> None:
        self._divider_hovered = True
        self._draw_divider()

    def _divider_leave(self, _event=None) -> None:
        self._divider_hovered = False
        self._draw_divider()

    def _drag_start(self, event) -> str:
        self._divider_dragging = True
        self._drag_start_x = int(event.x_root)
        self._drag_start_width = self._split_width()
        self._draw_divider()
        return "break"

    def _drag_move(self, event) -> str:
        if not self._divider_dragging:
            return "break"
        self._manual_first_width = (
            self._drag_start_width + int(event.x_root) - self._drag_start_x
        )
        self._layout()
        return "break"

    def _drag_end(self, _event=None) -> str:
        self._divider_dragging = False
        self._draw_divider()
        if self.on_resize is not None:
            self.on_resize()
        return "break"


class ModernDropdown(tk.Frame):
    """Dark selector used instead of the platform-native OptionMenu."""

    _OWNER_ACTIVE_ATTRIBUTE = "_active_modern_dropdown"

    def __init__(
        self,
        parent: tk.Misc,
        variable: tk.StringVar,
        choices: list[str] | tuple[str, ...],
        *,
        width: int,
        font,
        background: str = PANEL,
    ):
        super().__init__(
            parent,
            bg=BORDER,
            width=max(120, int(width)),
            height=34,
            cursor="hand2",
        )
        self.pack_propagate(False)
        self.variable = variable
        self.choices = tuple(str(choice) for choice in choices)
        self.control_width = max(120, int(width))
        self.control_font = font
        self.control_background = background
        self.popup: tk.Toplevel | None = None
        self.hovered = False
        self.value_label = tk.Label(
            self,
            text=str(variable.get()),
            bg=background,
            fg=TEXT,
            anchor="w",
            padx=11,
            cursor="hand2",
            font=font,
        )
        self.value_label.pack(side="left", fill="both", expand=True, padx=(1, 0), pady=1)
        self.arrow = tk.Canvas(
            self,
            width=30,
            height=32,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor="hand2",
        )
        self.arrow.pack(side="right", padx=(0, 1), pady=1)
        for widget in (self, self.value_label, self.arrow):
            widget.bind("<Button-1>", self._toggle)
            widget.bind("<Enter>", self._enter)
            widget.bind("<Leave>", self._leave)
        self.arrow.bind("<Configure>", self._draw_arrow)
        self._trace_id = variable.trace_add("write", self._variable_changed)
        self._draw_arrow()

    def destroy(self) -> None:
        self._close_popup()
        try:
            self.variable.trace_remove("write", self._trace_id)
        except (AttributeError, tk.TclError):
            pass
        super().destroy()

    def _variable_changed(self, *_args) -> None:
        try:
            self.value_label.configure(text=str(self.variable.get()))
        except tk.TclError:
            pass

    def _draw_arrow(self, _event=None) -> None:
        if not self.arrow.winfo_exists():
            return
        self.arrow.delete("all")
        color = ACCENT if self.hovered or self.popup is not None else MUTED
        self.arrow.create_line(
            9, 13, 15, 19, 21, 13,
            fill=color,
            width=2,
            capstyle="round",
            joinstyle="round",
        )

    def _enter(self, _event=None) -> None:
        self.hovered = True
        self.configure(bg=ACCENT)
        self._draw_arrow()

    def _leave(self, _event=None) -> None:
        self.hovered = False
        self.configure(bg=BORDER)
        self._draw_arrow()

    def _toggle(self, _event=None) -> str:
        if self.popup is not None and self.popup.winfo_exists():
            self._close_popup()
        else:
            self._open_popup()
        return "break"

    def _open_popup(self) -> None:
        if not self.choices or not self.winfo_exists():
            return
        owner = self.winfo_toplevel()
        active_dropdown = getattr(owner, self._OWNER_ACTIVE_ATTRIBUTE, None)
        if active_dropdown is not None and active_dropdown is not self:
            try:
                active_dropdown._close_popup()
            except (AttributeError, tk.TclError):
                pass
        self.update_idletasks()
        try:
            measure = self.control_font.measure
        except AttributeError:
            popup_font = tkfont.Font(root=self, font=self.control_font)
            measure = popup_font.measure
        popup_width = min(
            360,
            max(
                self.control_width,
                max(measure(choice) for choice in self.choices) + 28,
            ),
        )
        popup = tk.Toplevel(self)
        self.popup = popup
        setattr(owner, self._OWNER_ACTIVE_ATTRIBUTE, self)
        popup.withdraw()
        popup.overrideredirect(True)
        popup.configure(bg=BORDER)
        try:
            popup.transient(owner)
            popup.attributes(
                "-topmost", bool(owner.attributes("-topmost"))
            )
        except tk.TclError:
            pass
        shell = tk.Frame(popup, bg=BORDER)
        shell.pack(fill="both", expand=True)
        canvas = tk.Canvas(
            shell,
            bg=self.control_background,
            bd=0,
            highlightthickness=0,
        )
        canvas.pack(side="left", fill="both", expand=True, padx=1, pady=1)
        inner = tk.Frame(canvas, bg=self.control_background)
        canvas_window = canvas.create_window((0, 0), window=inner, anchor="nw")
        rows: list[tk.Label] = []
        selected_row: tk.Label | None = None
        for choice in self.choices:
            selected = choice == str(self.variable.get())
            row = tk.Label(
                inner,
                text=choice,
                bg=PANEL_2 if selected else self.control_background,
                fg=ACCENT if selected else TEXT,
                anchor="w",
                padx=10,
                cursor="hand2",
                font=self.control_font,
            )
            row.pack(fill="x", ipady=7)
            rows.append(row)
            if selected:
                selected_row = row
            row.bind(
                "<Enter>",
                lambda _event, widget=row: widget.configure(bg=PANEL_2, fg=ACCENT),
            )
            row.bind(
                "<Leave>",
                lambda _event, widget=row, value=choice: widget.configure(
                    bg=PANEL_2 if value == str(self.variable.get()) else self.control_background,
                    fg=ACCENT if value == str(self.variable.get()) else TEXT,
                ),
            )
            row.bind(
                "<Button-1>",
                lambda _event, value=choice: self._select(value),
            )
        popup.update_idletasks()
        row_bottoms = [
            max(1, row.winfo_y() + row.winfo_height()) for row in rows
        ]
        content_height = max(
            1,
            inner.winfo_reqheight(),
            row_bottoms[-1] if row_bottoms else 1,
        )
        visible_rows = min(8, len(rows))
        visible_content_height = (
            row_bottoms[visible_rows - 1] if visible_rows else content_height
        )
        desired_height = visible_content_height + 2
        work_area = monitor_work_area_for_widget(self)
        x, y, popup_width, popup_height = dropdown_popup_bounds(
            self.winfo_rootx(),
            self.winfo_rooty(),
            self.winfo_width(),
            self.winfo_height(),
            popup_width,
            desired_height,
            work_area,
        )
        viewport_height = max(1, popup_height - 2)
        scrollable = content_height > viewport_height
        row_height = max(
            1,
            round(content_height / max(1, len(rows))),
        )
        canvas.configure(
            yscrollincrement=row_height,
            scrollregion=(0, 0, popup_width, content_height),
        )
        canvas.bind(
            "<Configure>",
            lambda event: canvas.itemconfigure(
                canvas_window, width=max(1, int(event.width))
            ),
        )
        if scrollable:
            scrollbar = ModernScrollbar(
                shell,
                orient="vertical",
                command=canvas.yview,
                background=self.control_background,
                width=8,
            )
            scrollbar.pack(side="right", fill="y", pady=1, padx=(0, 1))
            canvas.configure(yscrollcommand=scrollbar.set)

            def scroll_rows(event=None, amount: int = 0) -> str:
                delta = int(getattr(event, "delta", 0) or 0)
                units = amount or (-1 if delta > 0 else 1 if delta < 0 else 0)
                if units:
                    canvas.yview_scroll(units, "units")
                return "break"

            popup.bind("<MouseWheel>", scroll_rows, add="+")
            popup.bind(
                "<Button-4>",
                lambda event: scroll_rows(event, -1),
                add="+",
            )
            popup.bind(
                "<Button-5>",
                lambda event: scroll_rows(event, 1),
                add="+",
            )
        popup.geometry(
            format_absolute_tk_geometry(
                popup_width, popup_height, x, y
            )
        )
        popup.bind("<Escape>", lambda _event: self._close_popup())
        popup.deiconify()
        popup.update_idletasks()
        canvas.configure(scrollregion=(0, 0, popup_width, content_height))
        if scrollable and selected_row is not None:
            row_top = max(0, selected_row.winfo_y())
            row_bottom = row_top + max(1, selected_row.winfo_height())
            visible_height = max(1, canvas.winfo_height())
            if row_bottom > visible_height:
                target_top = min(
                    row_top,
                    max(0, content_height - visible_height),
                )
                canvas.yview_moveto(target_top / max(1, content_height))
        popup.lift()
        popup.focus_force()
        self._draw_arrow()

    def _select(self, value: str) -> str:
        self.variable.set(value)
        self._close_popup()
        return "break"

    def _close_popup(self) -> None:
        popup = self.popup
        self.popup = None
        try:
            owner = self.winfo_toplevel()
            if getattr(owner, self._OWNER_ACTIVE_ATTRIBUTE, None) is self:
                setattr(owner, self._OWNER_ACTIVE_ATTRIBUTE, None)
        except (AttributeError, tk.TclError):
            pass
        if popup is not None:
            try:
                if popup.winfo_exists():
                    popup.destroy()
            except tk.TclError:
                pass
        if self.winfo_exists():
            self._draw_arrow()

    @classmethod
    def close_active_popup(cls, owner: tk.Misc | None) -> None:
        if owner is None:
            return
        try:
            active_dropdown = getattr(owner, cls._OWNER_ACTIVE_ATTRIBUTE, None)
            if active_dropdown is not None:
                active_dropdown._close_popup()
        except (AttributeError, tk.TclError):
            pass


class ModernPagination(tk.Canvas):
    """Canvas-rendered compact pager matching the history workspace."""

    def __init__(
        self,
        parent: tk.Misc,
        command,
        *,
        font,
        background: str = SURFACE,
    ) -> None:
        super().__init__(
            parent,
            width=210,
            height=38,
            bg=background,
            bd=0,
            highlightthickness=0,
            takefocus=1,
        )
        self.command = command
        self.control_font = font
        self.control_background = background
        self.page = 1
        self.page_count = 1
        self.hover_region: int | None = None
        self.hit_regions: list[
            tuple[int, int, int, int, int, int, bool]
        ] = []
        self.bind("<Motion>", self._on_motion)
        self.bind("<Leave>", self._on_leave)
        self.bind("<Button-1>", self._on_click)
        self.bind("<MouseWheel>", self._on_wheel)
        self.bind("<Left>", lambda _event: self._step(-1))
        self.bind("<Right>", lambda _event: self._step(1))
        self.bind("<Home>", lambda _event: self._activate(1))
        self.bind("<End>", lambda _event: self._activate(self.page_count))
        self._draw()

    @staticmethod
    def _visible_pages(page: int, page_count: int) -> tuple[object, ...]:
        count = max(1, int(page_count))
        current = min(count, max(1, int(page)))
        if count <= 5:
            return tuple(range(1, count + 1))
        if current <= 2:
            return (1, 2, 3, "ellipsis", count)
        if current >= count - 1:
            return (1, "ellipsis", count - 2, count - 1, count)
        return (1, "ellipsis", current, "ellipsis", count)

    def set(self, page: int, page_count: int) -> None:
        self.page_count = max(1, int(page_count))
        self.page = min(self.page_count, max(1, int(page)))
        self.hover_region = None
        self._draw()

    def _items(self) -> list[tuple[str, int, bool, bool, bool]]:
        items: list[tuple[str, int, bool, bool, bool]] = [
            ("previous", self.page - 1, self.page > 1, False, False)
        ]
        for value in self._visible_pages(self.page, self.page_count):
            if value == "ellipsis":
                items.append(("ellipsis", 0, False, False, True))
                continue
            target = int(value)
            items.append((str(target), target, True, target == self.page, False))
        items.append(
            ("next", self.page + 1, self.page < self.page_count, False, False)
        )
        return items

    def _draw_chevron(
        self,
        center_x: float,
        center_y: float,
        *,
        forward: bool,
        color: str,
    ) -> None:
        direction = 1 if forward else -1
        self.create_line(
            center_x - direction * 3,
            center_y - 5,
            center_x + direction * 2,
            center_y,
            center_x - direction * 3,
            center_y + 5,
            fill=color,
            width=2,
            capstyle=tk.ROUND,
            joinstyle=tk.ROUND,
        )

    def _draw(self) -> None:
        if not self.winfo_exists():
            return
        self.delete("all")
        self.hit_regions = []
        items = self._items()
        widths = [22 if item[4] else 32 for item in items]
        gap = 4
        content_width = sum(widths) + gap * max(0, len(widths) - 1)
        requested_width = max(72, content_width)
        if int(float(self.cget("width"))) != requested_width:
            self.configure(width=requested_width)
        height = max(34, int(float(self.cget("height"))))
        top = max(1, (height - 32) // 2)
        left = 0
        for item_index, (item, width) in enumerate(zip(items, widths)):
            caption, target, enabled, selected, ellipsis = item
            right = left + width
            if ellipsis:
                self.create_text(
                    (left + right) / 2,
                    top + 16,
                    text="•••",
                    fill=SUBTLE,
                    font=self.control_font,
                )
                left = right + gap
                continue
            hovered = enabled and self.hover_region == item_index
            fill = (
                blend_color(PANEL, ACCENT, 0.20)
                if selected
                else blend_color(SURFACE, ACCENT, 0.10)
                if hovered
                else SURFACE
            )
            outline = (
                ACCENT
                if selected
                else blend_color(BORDER, ACCENT, 0.55)
                if hovered
                else BORDER
            )
            self.create_rectangle(
                left + 0.5,
                top + 0.5,
                right - 0.5,
                top + 31.5,
                fill=fill,
                outline=outline,
                width=1,
            )
            color = ACCENT if selected or hovered else TEXT if enabled else SUBTLE
            if caption == "previous":
                self._draw_chevron(
                    (left + right) / 2,
                    top + 16,
                    forward=False,
                    color=color,
                )
            elif caption == "next":
                self._draw_chevron(
                    (left + right) / 2,
                    top + 16,
                    forward=True,
                    color=color,
                )
            else:
                self.create_text(
                    (left + right) / 2,
                    top + 16,
                    text=caption,
                    fill=color,
                    font=self.control_font,
                )
            self.hit_regions.append(
                (
                    left,
                    top,
                    right,
                    top + 32,
                    item_index,
                    target,
                    enabled and not selected,
                )
            )
            left = right + gap

    def _target_at(self, x: int, y: int) -> tuple[int, int] | None:
        for left, top, right, bottom, region, target, enabled in self.hit_regions:
            if enabled and left <= x <= right and top <= y <= bottom:
                return region, target
        return None

    def _on_motion(self, event) -> None:
        hit = self._target_at(int(event.x), int(event.y))
        region = hit[0] if hit is not None else None
        if region == self.hover_region:
            return
        self.hover_region = region
        self.configure(cursor="hand2" if hit is not None else "arrow")
        self._draw()

    def _on_leave(self, _event=None) -> None:
        if self.hover_region is None:
            return
        self.hover_region = None
        self.configure(cursor="arrow")
        self._draw()

    def _on_click(self, event) -> str:
        self.focus_set()
        hit = self._target_at(int(event.x), int(event.y))
        if hit is not None:
            self._activate(hit[1])
        return "break"

    def _on_wheel(self, event) -> str:
        try:
            delta = int(getattr(event, "delta", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            delta = 0
        if delta:
            self._step(-1 if delta > 0 else 1)
        return "break"

    def _step(self, amount: int) -> str:
        self._activate(self.page + int(amount))
        return "break"

    def _activate(self, target: int) -> None:
        selected = min(self.page_count, max(1, int(target)))
        if selected != self.page:
            self.command(selected)


def render_switch_control_image(
    background: str,
    track: str,
    thumb: str,
    checked: bool,
) -> Image.Image:
    """Render a small switch at high resolution for smooth rounded edges."""

    width, height, scale = 44, 26, 4
    image = Image.new("RGB", (width * scale, height * scale), background)
    draw = ImageDraw.Draw(image)
    draw.rounded_rectangle(
        (3 * scale, 3 * scale, 41 * scale - 1, 23 * scale - 1),
        radius=10 * scale,
        fill=track,
    )
    thumb_x = 31 if checked else 13
    draw.ellipse(
        (
            (thumb_x - 8) * scale,
            5 * scale,
            (thumb_x + 8) * scale - 1,
            21 * scale - 1,
        ),
        fill=thumb,
    )
    return image.resize((width, height), Image.Resampling.LANCZOS)


class ModernHelpBadge(tk.Canvas):
    """Small custom help badge with a themed hover explanation."""

    def __init__(
        self,
        parent: tk.Misc,
        text: str,
        *,
        font,
        background: str = PANEL,
    ) -> None:
        super().__init__(
            parent,
            width=18,
            height=18,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor="hand2",
            takefocus=1,
        )
        self.help_text = str(text or "").strip()
        self.help_font = font
        self._help_popup: tk.Toplevel | None = None
        self.bind("<Enter>", self._show_tooltip)
        self.bind("<Leave>", self._hide_tooltip)
        self.bind("<FocusIn>", self._show_tooltip)
        self.bind("<FocusOut>", self._hide_tooltip)
        self.bind("<Button-1>", self._show_tooltip)
        self._draw()

    def destroy(self) -> None:
        self._hide_tooltip()
        super().destroy()

    def _draw(self, active: bool = False) -> None:
        if not self.winfo_exists():
            return
        self.delete("all")
        self.create_oval(
            2,
            2,
            16,
            16,
            fill="#17342c" if not active else "#205241",
            outline=ACCENT,
            width=1,
        )
        self.create_text(
            9,
            9,
            text="?",
            fill=ACCENT,
            font=self.help_font,
        )

    def _show_tooltip(self, _event=None) -> None:
        if not self.help_text or not self.winfo_exists():
            return
        self._hide_tooltip()
        self._draw(active=True)
        popup = tk.Toplevel(self)
        self._help_popup = popup
        popup.withdraw()
        popup.overrideredirect(True)
        popup.configure(bg=ACCENT)
        try:
            owner = self.winfo_toplevel()
            popup.transient(owner)
            popup.attributes("-topmost", bool(owner.attributes("-topmost")))
        except tk.TclError:
            pass
        body = tk.Frame(popup, bg="#171c20")
        body.pack(fill="both", expand=True, padx=1, pady=1)
        tk.Label(
            body,
            text=self.help_text,
            bg="#171c20",
            fg=TEXT,
            justify="left",
            anchor="w",
            wraplength=300,
            padx=11,
            pady=8,
            font=self.help_font,
        ).pack(fill="both", expand=True)
        popup.update_idletasks()
        popup_width = popup.winfo_reqwidth()
        popup_height = popup.winfo_reqheight()
        root_x = self.winfo_rootx()
        root_y = self.winfo_rooty()
        x, y = help_popup_position(
            root_x,
            root_y,
            self.winfo_width(),
            self.winfo_height(),
            popup_width,
            popup_height,
            monitor_work_area_for_widget(self),
        )
        popup.geometry(
            format_absolute_tk_geometry(
                popup_width, popup_height, x, y
            )
        )
        popup.deiconify()
        popup.lift()

    def _hide_tooltip(self, _event=None) -> None:
        popup = self._help_popup
        self._help_popup = None
        if popup is not None:
            try:
                if popup.winfo_exists():
                    popup.destroy()
            except tk.TclError:
                pass
        self._draw()


class ModernCheckboxControl(tk.Frame):
    """Compact themed checkbox for dense toolbars and field selectors."""

    def __init__(
        self,
        parent: tk.Misc,
        text: str,
        variable: tk.BooleanVar,
        *,
        font,
        background: str = SURFACE,
        foreground: str = TEXT,
        command=None,
    ) -> None:
        super().__init__(parent, bg=background, cursor="hand2")
        self.variable = variable
        self.background = background
        self.foreground = foreground
        self.command = command
        self.box = tk.Canvas(
            self,
            width=18,
            height=18,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor="hand2",
            takefocus=1,
        )
        self.box.pack(side="left")
        self.label = tk.Label(
            self,
            text=text,
            bg=background,
            fg=foreground,
            cursor="hand2",
            anchor="w",
            font=font,
        )
        self.label.pack(side="left", padx=(5, 0))
        for widget in (self, self.box, self.label):
            widget.bind("<Button-1>", self._toggle)
        self.box.bind("<space>", self._toggle)
        self.box.bind("<Return>", self._toggle)
        self._trace_id = variable.trace_add("write", self._redraw)
        self._redraw()

    def destroy(self) -> None:
        try:
            self.variable.trace_remove("write", self._trace_id)
        except (AttributeError, tk.TclError):
            pass
        super().destroy()

    def _toggle(self, _event=None) -> str:
        self.variable.set(not bool(self.variable.get()))
        if self.command is not None:
            self.command()
        return "break"

    def _redraw(self, *_args) -> None:
        if not self.box.winfo_exists():
            return
        self.box.delete("all")
        checked = bool(self.variable.get())
        outline = ACCENT if checked else "#56616d"
        fill = "#17342c" if checked else "#101419"
        self.box.create_polygon(
            (3, 1, 15, 1, 17, 3, 17, 15, 15, 17, 3, 17, 1, 15, 1, 3),
            fill=fill,
            outline=outline,
            width=1,
        )
        if checked:
            self.box.create_line(
                5,
                9,
                8,
                12,
                14,
                5,
                fill=ACCENT,
                width=2,
                capstyle=tk.ROUND,
                joinstyle=tk.ROUND,
            )


class ModernChoiceCard(tk.Frame):
    """Keyboard-accessible, theme-drawn replacement for native radio buttons."""

    def __init__(
        self,
        parent: tk.Misc,
        title: str,
        variable: tk.Variable,
        value: object,
        *,
        font,
        detail: str = "",
        detail_font=None,
        accent: str = PVE_MODE_FOREGROUND,
        background: str = MODAL_CARD,
        selected_background: str = "#142b3d",
        disabled: bool = False,
        command=None,
        height: int = 58,
    ) -> None:
        cursor = "arrow" if disabled else "hand2"
        try:
            title_line_height = int(font.metrics("linespace"))
        except (AttributeError, tk.TclError, TypeError, ValueError):
            title_line_height = 18
        try:
            detail_line_height = int((detail_font or font).metrics("linespace"))
        except (AttributeError, tk.TclError, TypeError, ValueError):
            detail_line_height = 15
        content_height = title_line_height + 20
        if detail:
            content_height += detail_line_height + 2
        resolved_height = max(48, int(height), content_height)
        super().__init__(
            parent,
            bg=background,
            height=resolved_height,
            cursor=cursor,
            takefocus=0 if disabled else 1,
            highlightthickness=1,
            highlightbackground=MODAL_BORDER,
            highlightcolor=MODAL_BORDER,
        )
        self.pack_propagate(False)
        self.variable = variable
        self.value = value
        self.accent = accent
        self.background = background
        self.selected_background = selected_background
        self.disabled = bool(disabled)
        self.command = command
        self.hovered = False

        self.accent_bar = tk.Frame(self, bg=background, width=3)
        self.accent_bar.pack(side="left", fill="y")
        self.accent_bar.pack_propagate(False)
        self.indicator = tk.Canvas(
            self,
            width=28,
            height=28,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor=cursor,
            takefocus=0,
        )
        self.indicator.pack(side="left", padx=(11, 7))
        copy = tk.Frame(self, bg=background, cursor=cursor)
        copy.pack(side="left", fill="both", expand=True, pady=7)
        self.title_label = tk.Label(
            copy,
            text=str(title),
            bg=background,
            fg=TEXT if not disabled else SUBTLE,
            anchor="w",
            cursor=cursor,
            font=font,
        )
        self.title_label.pack(fill="x", expand=not bool(detail))
        self.detail_label: tk.Label | None = None
        if detail:
            self.detail_label = tk.Label(
                copy,
                text=str(detail),
                bg=background,
                fg=MUTED if not disabled else SUBTLE,
                anchor="w",
                cursor=cursor,
                font=detail_font or font,
            )
            self.detail_label.pack(fill="x", pady=(1, 0))
        self.state_label = tk.Label(
            self,
            text="已选择",
            bg=background,
            fg=accent,
            width=6,
            anchor="e",
            cursor=cursor,
            font=detail_font or font,
        )
        self.state_label.pack(side="right", fill="y", padx=(5, 12))

        widgets = [
            self,
            self.accent_bar,
            self.indicator,
            copy,
            self.title_label,
            self.state_label,
        ]
        if self.detail_label is not None:
            widgets.append(self.detail_label)
        for widget in widgets:
            widget.bind("<Button-1>", self._select)
            widget.bind("<Enter>", self._enter)
            widget.bind("<Leave>", self._leave)
        self.bind("<space>", self._select)
        self.bind("<Return>", self._select)
        self._trace_id = variable.trace_add("write", self._redraw)
        self._redraw()

    def destroy(self) -> None:
        try:
            self.variable.trace_remove("write", self._trace_id)
        except (AttributeError, tk.TclError):
            pass
        super().destroy()

    def _selected(self) -> bool:
        try:
            return self.variable.get() == self.value
        except tk.TclError:
            return False

    def _select(self, _event=None) -> str:
        if self.disabled:
            return "break"
        changed = not self._selected()
        self.variable.set(self.value)
        if self.command is not None and changed:
            self.command()
        self.focus_set()
        return "break"

    def _enter(self, _event=None) -> None:
        if self.disabled:
            return
        self.hovered = True
        self._redraw()

    def _leave(self, _event=None) -> None:
        self.hovered = False
        self._redraw()

    def _redraw(self, *_args) -> None:
        if not self.winfo_exists():
            return
        selected = self._selected()
        if self.disabled:
            background = self.background
            border = BORDER
        elif selected:
            background = self.selected_background
            border = self.accent
        elif self.hovered:
            background = MODAL_CARD_HOVER
            border = blend_color(MODAL_BORDER, self.accent, 0.48)
        else:
            background = self.background
            border = MODAL_BORDER
        self.configure(bg=background, highlightbackground=border)
        self.accent_bar.configure(bg=self.accent if selected else background)
        for widget in (self.indicator, self.title_label, self.state_label):
            widget.configure(bg=background)
        copy = self.title_label.master
        copy.configure(bg=background)
        if self.detail_label is not None:
            self.detail_label.configure(bg=background)
        self.title_label.configure(
            fg=SUBTLE if self.disabled else TEXT if selected else "#d4dee8"
        )
        self.state_label.configure(text="已选择" if selected else "")
        self.indicator.delete("all")
        indicator_outline = SUBTLE if self.disabled else self.accent if selected else MUTED
        self.indicator.create_oval(
            5,
            5,
            23,
            23,
            fill=background,
            outline=indicator_outline,
            width=2,
        )
        if selected:
            self.indicator.create_oval(
                10,
                10,
                18,
                18,
                fill=self.accent,
                outline="",
            )


class ModernCheckControl(tk.Frame):
    """Theme-native switch control used by settings and feedback forms."""

    _switch_photo_cache_attribute = "_dps_switch_photo_cache"

    def __init__(
        self,
        parent: tk.Misc,
        text: str,
        variable: tk.BooleanVar,
        *,
        font,
        background: str = BG,
        foreground: str = TEXT,
        disabled: bool = False,
        help_text: str = "",
        help_font=None,
    ):
        cursor = "arrow" if disabled else "hand2"
        super().__init__(parent, bg=background, cursor=cursor)
        self.variable = variable
        self.background = background
        self.foreground = foreground
        self.disabled = bool(disabled)
        self.help_text = str(help_text or "").strip()
        self.help_font = help_font or font
        self.hovered = False
        self._switch_photo: ImageTk.PhotoImage | None = None
        caption_panel = tk.Frame(self, bg=background, cursor=cursor)
        caption_panel.pack(side="left", fill="both", expand=True)
        self.label = tk.Label(
            caption_panel,
            text=text,
            bg=background,
            fg=MUTED if disabled else foreground,
            cursor=cursor,
            anchor="w",
            font=font,
        )
        self.label.pack(side="left", fill="y")
        self.help_badge: ModernHelpBadge | None = None
        if self.help_text:
            self.help_badge = ModernHelpBadge(
                caption_panel,
                self.help_text,
                font=self.help_font,
                background=background,
            )
            self.help_badge.pack(side="left", padx=(6, 0))
        self.switch = tk.Canvas(
            self,
            width=44,
            height=26,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor=cursor,
            takefocus=0 if disabled else 1,
        )
        self.switch.pack(side="right", padx=(12, 0))
        for widget in (self, caption_panel, self.switch, self.label):
            widget.bind("<Button-1>", self._toggle)
            widget.bind("<Enter>", self._enter)
            widget.bind("<Leave>", self._leave)
        self.switch.bind("<space>", self._toggle)
        self.switch.bind("<Return>", self._toggle)
        self._trace_id = variable.trace_add("write", self._redraw)
        self._redraw()

    def destroy(self) -> None:
        try:
            self.variable.trace_remove("write", self._trace_id)
        except (AttributeError, tk.TclError):
            pass
        super().destroy()

    def _toggle(self, _event=None) -> str:
        if not self.disabled:
            self.variable.set(not bool(self.variable.get()))
        return "break"

    def _enter(self, _event=None) -> None:
        if self.disabled:
            return
        self.hovered = True
        self.label.configure(fg=ACCENT)
        self._redraw()

    def _leave(self, _event=None) -> None:
        self.hovered = False
        self.label.configure(fg=MUTED if self.disabled else self.foreground)
        self._redraw()

    def _redraw(self, *_args) -> None:
        if not self.switch.winfo_exists():
            return
        self.switch.delete("all")
        checked = bool(self.variable.get())
        if self.disabled:
            track = SURFACE
            thumb = SUBTLE
        elif checked:
            track = ACCENT
            thumb = "#f7fffc"
        else:
            track = "#3a424a" if self.hovered else "#30363d"
            thumb = "#c3cbd4"
        root = self.switch._root()
        cache = getattr(root, self._switch_photo_cache_attribute, None)
        if not isinstance(cache, dict):
            cache = {}
            setattr(root, self._switch_photo_cache_attribute, cache)
        cache_key = (self.background, track, thumb, checked)
        photo = cache.get(cache_key)
        if photo is None:
            photo = ImageTk.PhotoImage(
                render_switch_control_image(
                    self.background,
                    track,
                    thumb,
                    checked,
                ),
                master=self.switch,
            )
            cache[cache_key] = photo
        self._switch_photo = photo
        self.switch.create_image(
            22,
            13,
            image=self._switch_photo,
            anchor="center",
        )


class ModernSlider(tk.Canvas):
    """Compact keyboard-accessible slider matching the settings layout."""

    def __init__(
        self,
        parent: tk.Misc,
        *,
        variable: tk.Variable,
        from_: float,
        to: float,
        resolution: float = 1.0,
        command=None,
        background: str = PANEL,
        length: int = 420,
    ) -> None:
        super().__init__(
            parent,
            width=length,
            height=30,
            bg=background,
            bd=0,
            highlightthickness=0,
            cursor="hand2",
            takefocus=1,
        )
        self.variable = variable
        self.control_background = background
        self.minimum = float(from_)
        self.maximum = float(to)
        self.resolution = max(0.000001, float(resolution))
        self.command = command
        self.hovered = False
        self.dragging = False
        self._trace_id = self.variable.trace_add("write", self._variable_changed)
        self.bind("<Configure>", self._redraw)
        self.bind("<Enter>", self._enter)
        self.bind("<Leave>", self._leave)
        self.bind("<ButtonPress-1>", self._pointer_down)
        self.bind("<B1-Motion>", self._pointer_move)
        self.bind("<ButtonRelease-1>", self._pointer_up)
        self.bind("<MouseWheel>", self._mouse_wheel)
        self.bind("<Button-4>", lambda _event: self._step(1))
        self.bind("<Button-5>", lambda _event: self._step(-1))
        self.bind("<Left>", lambda _event: self._step(-1))
        self.bind("<Down>", lambda _event: self._step(-1))
        self.bind("<Right>", lambda _event: self._step(1))
        self.bind("<Up>", lambda _event: self._step(1))
        self.bind("<Home>", lambda _event: self._set_value(self.minimum))
        self.bind("<End>", lambda _event: self._set_value(self.maximum))
        self.after_idle(self._redraw)

    def destroy(self) -> None:
        try:
            self.variable.trace_remove("write", self._trace_id)
        except (tk.TclError, AttributeError):
            pass
        super().destroy()

    def _current_value(self) -> float:
        try:
            value = float(self.variable.get())
        except (TypeError, ValueError, tk.TclError):
            value = self.minimum
        return min(self.maximum, max(self.minimum, value))

    def _normalized_value(self, value: object) -> float:
        try:
            numeric = float(value)
        except (TypeError, ValueError, OverflowError):
            numeric = self.minimum
        numeric = min(self.maximum, max(self.minimum, numeric))
        steps = round((numeric - self.minimum) / self.resolution)
        return min(
            self.maximum,
            max(self.minimum, self.minimum + steps * self.resolution),
        )

    def _set_value(self, value: object) -> str:
        normalized = self._normalized_value(value)
        if abs(normalized - self._current_value()) < self.resolution / 2:
            return "break"
        stored_value: float | int = normalized
        if self.resolution.is_integer() and self.minimum.is_integer():
            stored_value = int(round(normalized))
        self.variable.set(stored_value)
        if self.command is not None:
            self.command(stored_value)
        return "break"

    def _value_from_x(self, x: int) -> float:
        start = 10
        end = max(start + 1, self.winfo_width() - 10)
        ratio = min(1.0, max(0.0, (int(x) - start) / (end - start)))
        return self.minimum + ratio * (self.maximum - self.minimum)

    def _pointer_down(self, event) -> str:
        self.focus_set()
        self.dragging = True
        return self._set_value(self._value_from_x(event.x))

    def _pointer_move(self, event) -> str:
        if self.dragging:
            return self._set_value(self._value_from_x(event.x))
        return "break"

    def _pointer_up(self, event) -> str:
        self.dragging = False
        return self._set_value(self._value_from_x(event.x))

    def _mouse_wheel(self, event) -> str:
        return self._step(1 if event.delta > 0 else -1)

    def _step(self, direction: int) -> str:
        return self._set_value(
            self._current_value() + (1 if direction > 0 else -1) * self.resolution
        )

    def _variable_changed(self, *_args) -> None:
        self.after_idle(self._redraw)

    def _enter(self, _event=None) -> None:
        self.hovered = True
        self._redraw()

    def _leave(self, _event=None) -> None:
        self.hovered = False
        self.dragging = False
        self._redraw()

    def _redraw(self, _event=None) -> None:
        if not self.winfo_exists():
            return
        self.delete("all")
        width = max(28, self.winfo_width())
        height = max(24, self.winfo_height())
        start = 10
        end = max(start + 1, width - 10)
        center_y = height // 2
        span = max(0.000001, self.maximum - self.minimum)
        ratio = (self._current_value() - self.minimum) / span
        thumb_x = start + int((end - start) * ratio)
        self.create_line(
            start,
            center_y,
            end,
            center_y,
            fill="#343a41",
            width=4,
            capstyle=tk.ROUND,
        )
        for index in range(5):
            tick_x = start + round((end - start) * index / 4)
            self.create_oval(
                tick_x - 1,
                center_y - 1,
                tick_x + 1,
                center_y + 1,
                fill="#68727d",
                outline="",
            )
        if thumb_x > start:
            self.create_line(
                start,
                center_y,
                thumb_x,
                center_y,
                fill=ACCENT,
                width=4,
                capstyle=tk.ROUND,
            )
        radius = 8 if self.hovered or self.dragging else 7
        self.create_oval(
            thumb_x - radius - 2,
            center_y - radius - 2,
            thumb_x + radius + 2,
            center_y + radius + 2,
            fill=self.control_background,
            outline="",
        )
        self.create_oval(
            thumb_x - radius,
            center_y - radius,
            thumb_x + radius,
            center_y + radius,
            fill="#f7fffc",
            outline=ACCENT,
            width=2,
        )


class LicenseHeartbeatWorker(threading.Thread):
    def __init__(
        self,
        licensing: LicensingService,
        messages: queue.Queue,
        stop_event: threading.Event,
    ):
        super().__init__(name="DpsLicenseHeartbeat", daemon=True)
        self.recovery = LicenseRecovery(LICENSE_HEARTBEAT_FAILURE_GRACE_SECONDS)
        self.licensing = licensing
        self.messages = messages
        self.stop_event = stop_event
        self.state_lock = threading.Lock()
        self.using = False
        self.character_name = ""
        self.game_pid = 0

    def update_state(
        self, *, using: bool, character_name: str = "", game_pid: int = 0
    ) -> None:
        with self.state_lock:
            self.using = bool(using)
            self.character_name = str(character_name).strip()[:48]
            self.game_pid = max(0, int(game_pid or 0))

    def _state(self) -> tuple[bool, str, int]:
        with self.state_lock:
            return self.using, self.character_name, self.game_pid

    def run(self) -> None:
        interval = 30
        try:
            while not self.stop_event.is_set():
                using, character_name, game_pid = self._state()
                try:
                    request_started_at = time.time()
                    result = self.licensing.heartbeat(
                        using=using,
                        character_name=character_name,
                        game_pid=game_pid,
                    )
                    request_finished_at = time.time()
                except LicensingConnectionError as error:
                    delay = self.recovery.failed()
                    write_capture_lifecycle_event(
                        "license_heartbeat_failed",
                        component="license_heartbeat",
                        error_type=type(error).__name__,
                        details=str(error)[:500],
                        failures=int(self.recovery.failures),
                        retry_delay_seconds=float(delay),
                    )
                    self.messages.put(("license_reconnecting", None))
                    self.stop_event.wait(delay)
                    continue
                if not result.authorized:
                    self.messages.put(
                        (
                            "license_required",
                            result.message or "登录状态已失效，请重新登录。",
                        )
                    )
                    return
                self.recovery.succeeded()
                capability = result.runtime_capability
                write_capture_lifecycle_event(
                    "license_heartbeat_succeeded",
                    component="license_heartbeat",
                    heartbeat_interval=int(result.heartbeat_interval),
                    lease_sequence=int(
                        getattr(capability, "lease_sequence", 0) or 0
                    ),
                    capability_expires_at=float(
                        getattr(capability, "expires_at", 0.0) or 0.0
                    ),
                    successful_renewals=int(
                        self.recovery.successful_renewals
                    ),
                )
                if result.server_time > 0:
                    self.messages.put(
                        (
                            "server_clock",
                            {
                                "server_time": result.server_time,
                                "received_at": (
                                    request_started_at + request_finished_at
                                )
                                / 2.0,
                            },
                        )
                    )
                if result.runtime_capability is not None:
                    self.messages.put(
                        (
                            "runtime_capability",
                            result.runtime_capability,
                        )
                    )
                self.messages.put(("license_reconnected", None))
                interval = result.heartbeat_interval
                self.stop_event.wait(interval)
        finally:
            write_capture_lifecycle_event(
                "license_heartbeat_stopped",
                component="license_heartbeat",
                stop_requested=bool(self.stop_event.is_set()),
            )
            self.licensing.sign_out()


class CombatClockWorker(threading.Thread):
    def __init__(
        self,
        licensing: LicensingService,
        messages: queue.Queue,
        stop_event: threading.Event,
    ):
        super().__init__(name="DpsSharedCombatClock", daemon=True)
        self.licensing = licensing
        self.messages = messages
        self.stop_event = stop_event
        self.state_lock = threading.Lock()
        self.pending: dict[str, dict[str, object]] = {}
        self.confirmed_final_revision: dict[str, int] = {}
        self.last_sent: dict[str, float] = {}
        self.wake_event = threading.Event()

    def submit(self, snapshot: dict[str, object] | None) -> None:
        if not isinstance(snapshot, dict):
            return
        encounter_id = str(snapshot.get("encounter_id", "")).strip()
        if not encounter_id:
            return
        try:
            revision = max(0, int(snapshot.get("client_revision", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            return
        if revision <= 0:
            return
        with self.state_lock:
            confirmed_revision = self.confirmed_final_revision.get(
                encounter_id, 0
            )
            if revision <= confirmed_revision:
                return
            previous = self.pending.get(encounter_id)
            previous_state = (
                str(previous.get("state", ""))
                if isinstance(previous, dict)
                else ""
            )
            next_state = str(snapshot.get("state", ""))
            try:
                previous_revision = max(
                    0, int(previous.get("client_revision", 0) or 0)
                ) if isinstance(previous, dict) else 0
            except (TypeError, ValueError, OverflowError):
                previous_revision = 0
            if revision < previous_revision:
                return
            self.pending[encounter_id] = dict(snapshot)
            if revision > previous_revision and next_state != previous_state:
                # State transitions (especially final -> active recovery) go
                # out immediately. Ordinary active elapsed-time revisions keep
                # the one-second network cadence.
                self.last_sent.pop(encounter_id, None)
            if revision > confirmed_revision:
                self.confirmed_final_revision.pop(encounter_id, None)
        self.wake_event.set()

    def cancel(self, encounter_id: object) -> None:
        key = str(encounter_id or "").strip()
        if not key:
            return
        with self.state_lock:
            self.pending.pop(key, None)
            self.last_sent.pop(key, None)

    def _due_snapshot(self) -> tuple[str, dict[str, object]] | None:
        now = time.monotonic()
        with self.state_lock:
            candidates = sorted(
                self.pending.items(),
                key=lambda item: {
                    "final": 0,
                    "settling": 1,
                    "active": 2,
                }.get(str(item[1].get("state", "active")), 3),
            )
            for encounter_id, snapshot in candidates:
                interval = combat_clock_sync_interval(snapshot)
                if now - self.last_sent.get(encounter_id, 0.0) < interval:
                    continue
                self.last_sent[encounter_id] = now
                return encounter_id, dict(snapshot)
        return None

    def run(self) -> None:
        while not self.stop_event.is_set():
            due = self._due_snapshot()
            if due is None:
                self.wake_event.wait(0.15)
                self.wake_event.clear()
                continue
            encounter_id, snapshot = due
            try:
                result = self.licensing.sync_combat_clock(snapshot)
            except LicensingConnectionError:
                self.stop_event.wait(COMBAT_CLOCK_RETRY_INTERVAL_SECONDS)
                continue
            except Exception:
                self.stop_event.wait(COMBAT_CLOCK_RETRY_INTERVAL_SECONDS)
                continue
            if not result.synchronized:
                self.stop_event.wait(COMBAT_CLOCK_RETRY_INTERVAL_SECONDS)
                continue
            self.messages.put(("combat_clock_result", result))
            if result.final:
                with self.state_lock:
                    accepted_revision = max(
                        0, int(result.client_revision or 0)
                    )
                    self.confirmed_final_revision[encounter_id] = max(
                        self.confirmed_final_revision.get(encounter_id, 0),
                        accepted_revision,
                    )
                    pending = self.pending.get(encounter_id)
                    try:
                        pending_revision = max(
                            0,
                            int(
                                pending.get("client_revision", 0) or 0
                            ),
                        ) if isinstance(pending, dict) else 0
                    except (TypeError, ValueError, OverflowError):
                        pending_revision = 0
                    if (
                        pending_revision <= accepted_revision
                        and isinstance(pending, dict)
                        and str(pending.get("state", "")) == "final"
                    ):
                        self.pending.pop(encounter_id, None)
                        self.last_sent.pop(encounter_id, None)


class BossNameResolver(threading.Thread):
    def __init__(
        self,
        messages: queue.Queue,
        stop_event: threading.Event,
        monster_catalog: dict[str, dict],
    ):
        super().__init__(name="C7BossNames", daemon=True)
        self.messages = messages
        self.stop_event = stop_event
        self.monster_catalog = monster_catalog
        self.requests: queue.Queue = queue.Queue()
        self.requested: set[tuple[int, int, int]] = set()
        self.cached_names = load_json_object(MONSTER_NAME_CACHE_PATH)

    def request(
        self,
        pid: int,
        entity_id: int,
        template_id: int,
        localization_id: int,
        filetime_100ns: int,
    ) -> None:
        if not pid or not entity_id or not template_id or not localization_id:
            return
        key = (pid, entity_id, template_id)
        if key in self.requested:
            return
        self.requested.add(key)
        self.requests.put(
            (pid, entity_id, template_id, localization_id, filetime_100ns)
        )

    def run(self) -> None:
        while not self.stop_event.is_set():
            try:
                first = self.requests.get(timeout=0.2)
            except queue.Empty:
                continue
            batch = [first]
            deadline = time.monotonic() + 0.25
            while time.monotonic() < deadline:
                try:
                    candidate = self.requests.get_nowait()
                except queue.Empty:
                    self.stop_event.wait(0.02)
                    continue
                if candidate[0] == first[0]:
                    batch.append(candidate)
                else:
                    self.requests.put(candidate)
                    break
            localization_ids = {item[3] for item in batch}
            try:
                # v0.3.0 names are offline catalog data, never a runtime
                # localization heap scan. Missing catalog entries stay unknown.
                names = {
                    int(row.get('localization_id', 0) or 0): str(row['name'])
                    for row in self.monster_catalog.values()
                    if isinstance(row, dict) and row.get('name')
                    and int(row.get('localization_id', 0) or 0) in localization_ids
                }
            except Exception as exc:
                self.messages.put(("diagnostic", f"Boss 名称后台解析失败：{exc}"))
                continue
            cache_changed = False
            for _pid, entity_id, template_id, localization_id, timestamp in batch:
                name = str(names.get(localization_id, "")).strip()
                if not name:
                    continue
                self.monster_catalog.setdefault(str(template_id), {})["name"] = name
                if self.cached_names.get(str(template_id)) != name:
                    self.cached_names[str(template_id)] = name
                    cache_changed = True
                self.messages.put(
                    (
                        "profile",
                        {
                            "filetime_100ns": timestamp,
                            "entity_id": entity_id,
                            "template_id": template_id,
                            "name": name,
                            "entity_type": "Boss",
                            "boss_type": 3,
                            "boss_rank": 3,
                        },
                    )
                )
            if cache_changed:
                write_json_object(MONSTER_NAME_CACHE_PATH, self.cached_names)


