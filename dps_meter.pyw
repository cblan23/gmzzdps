    def _render_history_snapshot_identity(
        self,
        available_width: int | None = None,
        *,
        summary: dict | None = None,
    ) -> None:
        if summary is None:
            summary = self._selected_history_summary()
        labels = getattr(self, "history_snapshot_labels", {})
        identity_text = getattr(self, "history_snapshot_identity_text", None)
        if available_width is None and identity_text is not None:
            available_width = identity_text.winfo_width()
        if not available_width or available_width <= 1:
            available_width = 210
        text_width = max(48, int(available_width) - 6)
        icon_label = getattr(self, "history_snapshot_icon_label", None)
        if summary is None:
            if icon_label is not None:
                icon_label.configure(image="", text="♜")
                icon_label.image = None
            for key, value, role in (
                ("boss", "暂无战斗记录", "title"),
                ("dungeon", "完成一场 Boss 战斗后会自动保存", "micro"),
                ("time", "--", "micro"),
            ):
                if key in labels:
                    labels[key].configure(
                        text=self._fit_ui_text(value, text_width, role),
                        fg=MUTED,
                    )
            return

        encounter_title = self._history_encounter_title(summary)
        boss_name = str(summary.get("boss_name", "")).strip() or encounter_title
        dungeon_name = str(summary.get("dungeon_name", "")).strip() or "未知区域"
        difficulty = str(summary.get("difficulty", "")).strip()
        if difficulty:
            dungeon_name = f"{dungeon_name} · {difficulty}"
        time_text = self._history_timestamp(summary)
        for key, value, color, role in (
            ("boss", encounter_title, TEXT, "title"),
            ("dungeon", dungeon_name, MUTED, "micro"),
            ("time", time_text, SUBTLE, "micro"),
        ):
            if key in labels:
                labels[key].configure(
                    text=self._fit_ui_text(value, text_width, role), fg=color
                )
        if icon_label is not None:
            portrait = self.icons.boss(
                summary.get("boss_icon", ""), boss_name, size=82
            )
            icon_label.configure(image=portrait, text="")
            icon_label.image = portrait

    def _render_history_snapshot(self) -> None:
        summary = self._selected_history_summary()
        labels = getattr(self, "history_snapshot_labels", {})
        mode = getattr(self, "history_meter_mode", "dps")
        boss_mode = mode == "boss_damage"
        captions = {
            "dps": ("我的 DPS", "我的伤害", "伤害占比"),
            "hps": ("我的 HPS", "我的治疗", "治疗占比"),
            "dt": ("我的承伤", "团队承伤", "承伤占比"),
        }.get(mode, ("我的 DPS", "我的伤害", "伤害占比"))
        for key, caption in zip(
            ("my_dps", "my_damage", "my_share"), captions
        ):
            label = labels.get(f"{key}_caption")
            if label is not None:
                label.configure(text=caption)
        if boss_mode:
            for key, caption in (
                ("team_dps", "团队总承伤"),
                ("my_dps", "已归类伤害"),
                ("my_damage", "归类比例"),
                ("my_share", "最高一击"),
            ):
                label = labels.get(f"{key}_caption")
                if label is not None:
                    label.configure(text=caption)
        else:
            team_caption = labels.get("team_dps_caption")
            if team_caption is not None:
                team_caption.configure(text="团队 DPS")
        if self.history_snapshot_trend_title_label is not None:
            self.history_snapshot_trend_title_label.configure(
                text={
                    "dps": "团队 DPS 趋势",
                    "hps": "HPS 数据",
                    "dt": "DT 数据",
                    "boss_damage": "首领伤害数据",
                }.get(
                    mode, "团队 DPS 趋势"
                )
            )
        self._render_history_snapshot_identity(summary=summary)
        if summary is None:
            for key, value in (
                ("team_dps", "--"),
                ("my_dps", "--"),
                ("my_damage", "--"),
                ("my_share", "--"),
                ("team_size", "--"),
                ("duration", "--"),
                ("result", "--"),
            ):
                if key in labels:
                    labels[key].configure(text=value, fg=MUTED)
            if self.history_snapshot_status_label is not None:
                self.history_snapshot_status_label.configure(text="--", fg=MUTED)
            self._draw_history_snapshot_result()
            self._draw_history_snapshot_trend()
            return
        values = {
            "team_dps": self._history_optional_number(
                summary.get("boss_team_taken")
                if boss_mode
                else summary.get("team_dps")
            ),
            "team_size": (
                f"{int(summary.get('team_size'))} 人"
                if summary.get("team_size") is not None
                else "--"
            ),
            "duration": (
                format_duration(float(summary.get("duration_seconds")))
                if summary.get("duration_seconds") is not None
                else "--"
            ),
        }
        if boss_mode:
            coverage = str(summary.get("boss_damage_coverage", ""))
            available = coverage in {
                "complete",
                "observed_partial",
                "conflict",
            }
            values["my_dps"] = (
                self._history_optional_number(
                    summary.get("boss_observed_damage")
                )
                if available
                else "--"
            )
            values["my_damage"] = (
                self._history_rate_text(
                    summary.get("boss_classification_ratio")
                )
                if available
                else "--"
            )
            values["my_share"] = (
                self._history_optional_number(summary.get("boss_max_hit"))
                if available
                else "--"
            )
            if not available:
                values["team_dps"] = "--"
        elif mode == "hps":
            values["my_dps"] = self._history_optional_number(
                summary.get("my_hps")
            )
            values["my_damage"] = self._history_optional_number(
                summary.get("my_effective_healing")
            )
            try:
                total_healing = max(0.0, float(summary.get("team_hps"))) * max(
                    0.0, float(summary.get("duration_seconds"))
                )
                my_healing = max(
                    0.0, float(summary.get("my_effective_healing"))
                )
                values["my_share"] = (
                    f"{my_healing / total_healing * 100:.1f}%"
                    if total_healing > 0
                    else "--"
                )
            except (TypeError, ValueError, OverflowError):
                values["my_share"] = "--"
        elif mode == "dt":
            values["my_dps"] = self._history_optional_number(
                summary.get("my_taken")
            )
            values["my_damage"] = self._history_optional_number(
                summary.get("team_taken")
            )
            try:
                team_taken = max(0.0, float(summary.get("team_taken")))
                my_taken = max(0.0, float(summary.get("my_taken")))
                values["my_share"] = (
                    f"{my_taken / team_taken * 100:.1f}%"
                    if team_taken > 0
                    else "--"
                )
            except (TypeError, ValueError, OverflowError):
                values["my_share"] = "--"
        else:
            values["my_dps"] = self._history_optional_number(
                summary.get("my_dps")
            )
            values["my_damage"] = self._history_optional_number(
                summary.get("my_damage")
            )
            values["my_share"] = (
                f"{float(summary.get('my_share')) * 100:.1f}%"
                if summary.get("my_share") is not None
                else "--"
            )
        result_text, result_color = self._history_result_presentation(
            summary.get("result")
        )
        values["result"] = result_text
        for key, value in values.items():
            if key in labels:
                labels[key].configure(
                    text=value,
                    fg=result_color if key == "result" else TEXT,
                )
        if boss_mode:
            completeness_text, completeness_color = (
                self._history_boss_coverage_text(
                    {
                        "coverage": summary.get("boss_damage_coverage"),
                        "unavailable_reason": summary.get(
                            "boss_damage_unavailable_reason"
                        ),
                    }
                )
            )
        else:
            completeness = str(summary.get("completeness", ""))
            completeness_text, completeness_color = {
                COMPLETENESS_COMPLETE: ("数据完整", ACCENT),
                COMPLETENESS_LIMITED: ("基础数据", WARN),
            }.get(completeness, ("部分缺失", WARN))
        if self.history_snapshot_status_label is not None:
            self.history_snapshot_status_label.configure(
                text=completeness_text, fg=completeness_color
            )
        self._draw_history_snapshot_result()
        self._draw_history_snapshot_trend()

    def _history_snapshot_team_dps_points(self) -> list[tuple[float, float]]:
        record = self._selected_history_record() if self.history_selected_id else None
        if not isinstance(record, dict):
            self.history_trend_record_id = ""
            self.history_trend_points = []
            self.history_trend_source = "settlement_average"
            self.history_participant_trend_record_id = ""
            self.history_participant_trend_points = {}
            self.history_participant_trend_scope = "team_only"
            return []
        record_id = str(
            record.get("encounter_id", record.get("battle_id", ""))
        )
        if record_id == self.history_trend_record_id:
            return self.history_trend_points

        # Older cached timelines can contain only this client's observed hits.
        # Always rebuild from a source proven to cover the settlement total.
        points = rebuild_team_dps_timeline(record)
        parsed: list[tuple[float, float]] = []
        if isinstance(points, list):
            for row in points:
                if not isinstance(row, dict):
                    continue
                try:
                    parsed.append(
                        (
                            max(
                                0.0,
                                float(row.get("time_seconds", 0.0) or 0.0),
                            ),
                            max(
                                0.0,
                                float(
                                    row.get("team_dps", row.get("dps", 0.0))
                                    or 0.0
                                ),
                            ),
                        )
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
        parsed.sort(key=lambda value: value[0])
        source = ""
        if points and isinstance(points[0], dict):
            source = str(points[0].get("source", "") or "")
        if source not in {"live_team_cumulative", "complete_damage_events"}:
            source = "settlement_average"
            parsed = []
            try:
                duration = max(
                    0.0,
                    float(
                        record.get(
                            "dps_duration_seconds",
                            record.get("duration_seconds", 0.0),
                        )
                        or 0.0
                    ),
                )
                average = max(0.0, float(record.get("team_dps", 0.0) or 0.0))
                if average <= 0 and duration > 0:
                    average = max(
                        0.0, float(record.get("total_damage", 0.0) or 0.0)
                    ) / duration
            except (TypeError, ValueError, OverflowError):
                duration = 0.0
                average = 0.0
            if duration > 0 and average > 0:
                parsed = [(0.0, average), (duration, average)]
        self.history_trend_record_id = record_id
        self.history_trend_points = parsed
        self.history_trend_source = source
        return parsed

    def _history_snapshot_participant_dps_points(
        self,
    ) -> dict[int, list[tuple[float, float]]]:
        record = self._selected_history_record() if self.history_selected_id else None
        if not isinstance(record, dict):
            self.history_participant_trend_record_id = ""
            self.history_participant_trend_points = {}
            self.history_participant_trend_scope = "team_only"
            return {}
        record_id = str(record.get("encounter_id", record.get("battle_id", "")))
        if record_id == self.history_participant_trend_record_id:
            return self.history_participant_trend_points

        rebuilt = rebuild_participant_dps_timelines(record)
        parsed: dict[int, list[tuple[float, float]]] = {}
        for raw_actor_id, rows in rebuilt.items():
            try:
                actor_id = int(raw_actor_id)
            except (TypeError, ValueError, OverflowError):
                continue
            values: list[tuple[float, float]] = []
            if not isinstance(rows, list):
                continue
            for row in rows:
                if not isinstance(row, dict):
                    continue
                try:
                    values.append(
                        (
                            max(0.0, float(row.get("time_seconds", 0.0) or 0.0)),
                            max(0.0, float(row.get("dps", 0.0) or 0.0)),
                        )
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
            if values:
                values.sort(key=lambda value: value[0])
                parsed[actor_id] = values

        scope = "all_players" if parsed else "team_only"
        if not parsed:
            # Old records can still provide one exact local-player curve from
            # their observed event log.  Keep it visibly distinct from full
            # all-player coverage.
            local = rebuild_dps_timeline(record)
            self_row = next(
                (
                    row for row in record.get("participants", [])
                    if isinstance(row, dict) and row.get("is_self") is True
                ),
                None,
            )
            if isinstance(self_row, dict) and isinstance(local, list):
                actor_id = int(self_row.get("actor_id", 0) or 0)
                values = []
                for row in local:
                    if not isinstance(row, dict):
                        continue
                    try:
                        values.append(
                            (
                                max(0.0, float(row.get("time_seconds", 0.0) or 0.0)),
                                max(0.0, float(row.get("dps", 0.0) or 0.0)),
                            )
                        )
                    except (TypeError, ValueError, OverflowError):
                        continue
                if actor_id > 0 and values:
                    parsed[actor_id] = values
                    scope = "team_and_self"
        self.history_participant_trend_record_id = record_id
        self.history_participant_trend_points = parsed
        self.history_participant_trend_scope = scope
        return parsed

    def _history_snapshot_trend_time(self, x: object) -> float | None:
        if getattr(self, "history_trend_source", "") == "settlement_average":
            return None
        bounds = getattr(self, "history_trend_plot_bounds", None)
        if bounds is None:
            return None
        left, right, max_time = bounds
        try:
            pointer_x = float(x)
        except (TypeError, ValueError, OverflowError):
            return None
        if pointer_x < left or pointer_x > right or right <= left:
            return None
        return round(
            max(0.0, min(max_time, (pointer_x - left) * max_time / (right - left)))
        )

    def _history_snapshot_trend_motion(self, event) -> None:
        if getattr(self, "history_meter_mode", "dps") != "dps":
            return
        selected_time = self._history_snapshot_trend_time(getattr(event, "x", 0))
        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if selected_time is None:
            if canvas is not None:
                canvas.configure(cursor="")
            return
        if canvas is not None:
            canvas.configure(cursor="crosshair")
        if selected_time == self.history_trend_hover_time:
            return
        self.history_trend_hover_time = selected_time
        self._draw_history_snapshot_trend()

    def _history_snapshot_trend_leave(self, _event=None) -> None:
        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if canvas is not None:
            canvas.configure(cursor="")
        if self.history_trend_hover_time is None:
            return
        self.history_trend_hover_time = None
        self._draw_history_snapshot_trend()

    def _history_snapshot_trend_select(self, event) -> str:
        selected_time = self._history_snapshot_trend_time(getattr(event, "x", 0))
        if selected_time is None:
            return "break"
        if self.history_trend_selected_time == selected_time:
            self.history_trend_selected_time = None
        else:
            self.history_trend_selected_time = selected_time
        self.history_trend_hover_time = selected_time
        self._draw_history_snapshot_trend()
        return "break"

    def _history_detail_trend_time(self, x: object) -> float | None:
        if getattr(self, "history_trend_source", "") == "settlement_average":
            return None
        bounds = getattr(self, "history_detail_trend_plot_bounds", None)
        if bounds is None:
            return None
        left, right, max_time = bounds
        try:
            pointer_x = float(x)
        except (TypeError, ValueError, OverflowError):
            return None
        if pointer_x < left or pointer_x > right or right <= left:
            return None
        return round(
            max(0.0, min(max_time, (pointer_x - left) * max_time / (right - left)))
        )

    def _history_detail_trend_motion(self, event) -> None:
        if getattr(self, "history_meter_mode", "dps") != "dps":
            return
        selected_time = self._history_detail_trend_time(getattr(event, "x", 0))
        canvas = getattr(self, "history_detail_trend_canvas", None)
        if selected_time is None:
            if canvas is not None:
                canvas.configure(cursor="")
            return
        if canvas is not None:
            canvas.configure(cursor="crosshair")
        if selected_time == self.history_detail_trend_hover_time:
            return
        self.history_detail_trend_hover_time = selected_time
        self._draw_history_detail_trend()

    def _history_detail_trend_leave(self, _event=None) -> None:
        canvas = getattr(self, "history_detail_trend_canvas", None)
        if canvas is not None:
            canvas.configure(cursor="")
        if self.history_detail_trend_hover_time is None:
            return
        self.history_detail_trend_hover_time = None
        self._draw_history_detail_trend()

    def _history_detail_trend_select(self, event) -> str:
        selected_time = self._history_detail_trend_time(getattr(event, "x", 0))
        if selected_time is None:
            return "break"
        if self.history_detail_trend_selected_time == selected_time:
            self.history_detail_trend_selected_time = None
        else:
            self.history_detail_trend_selected_time = selected_time
        self.history_detail_trend_hover_time = selected_time
        self._draw_history_detail_trend()
        return "break"

    def _draw_history_detail_trend(self) -> None:
        canvas = getattr(self, "history_detail_trend_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        mode = getattr(self, "history_meter_mode", "dps")
        title_label = getattr(self, "history_detail_trend_title_label", None)
        peak_label = getattr(self, "history_detail_trend_peak_label", None)
        hint_label = getattr(self, "history_detail_trend_hint_label", None)
        if mode != "dps":
            self.history_detail_trend_plot_bounds = None
            if mode == "boss_damage":
                label = "首领伤害"
                empty_title = "首领伤害使用独立的精确事件时间轴"
                empty_detail = "继续向下查看技能命中与队员死亡时间对照"
                hint = "下方查看真实事件"
                peak = "精确事件"
            else:
                label = "治疗 HPS" if mode == "hps" else "承伤 DT"
                empty_title = f"{label} 当前仅提供结算汇总"
                empty_detail = "切换至伤害 DPS 可查看团队战斗时间轴"
                hint = "当前模式暂无逐秒数据"
                peak = "结算数据"
            if title_label is not None:
                title_label.configure(text=f"团队{label}汇总")
            if peak_label is not None:
                peak_label.configure(text=peak, fg=MUTED)
            if hint_label is not None:
                hint_label.configure(text=hint)
            canvas.create_text(
                width // 2,
                height // 2 - 7,
                text=empty_title,
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text=empty_detail,
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            return

        parsed = self._history_snapshot_team_dps_points()
        if title_label is not None:
            title_label.configure(text="团队 DPS 时间轴")
        if not parsed:
            self.history_detail_trend_plot_bounds = None
            if peak_label is not None:
                peak_label.configure(text="暂无数据", fg=MUTED)
            if hint_label is not None:
                hint_label.configure(text="")
            canvas.create_text(
                width // 2,
                height // 2 - 7,
                text="暂无团队趋势数据",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text="这场记录仅保存了结算汇总",
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            return

        trend_source = getattr(self, "history_trend_source", "settlement_average")
        settlement_average = trend_source == "settlement_average"
        if title_label is not None:
            title_label.configure(
                text="团队 DPS 结算平均" if settlement_average else "团队 DPS 时间轴"
            )
        if hint_label is not None:
            hint_label.configure(
                text="结算汇总" if settlement_average else "移动查看 · 点击锁定"
            )

        left, top, right, bottom = 45, 10, width - 12, height - 24
        if right <= left or bottom <= top:
            self.history_detail_trend_plot_bounds = None
            return
        max_time = max(1.0, max(point[0] for point in parsed))
        peak = max(1.0, max(point[1] for point in parsed))
        chart_max = peak * 1.16 if not settlement_average else peak * 1.22
        self.history_detail_trend_plot_bounds = (
            None if settlement_average else (left, right, max_time)
        )

        for fraction in (0.0, 0.5, 1.0):
            y = bottom - int((bottom - top) * fraction)
            canvas.create_line(left, y, right, y, fill=BORDER, dash=(2, 4))
            canvas.create_text(
                left - 7,
                y,
                text=format_number(chart_max * fraction),
                fill=SUBTLE,
                anchor="e",
                font=self._ui_font("micro"),
            )

        coordinates: list[float] = []
        for second, dps in parsed:
            coordinates.extend(
                (
                    left + (right - left) * second / max_time,
                    bottom - (bottom - top) * dps / chart_max,
                )
            )
        if len(coordinates) >= 4:
            if not settlement_average:
                canvas.create_polygon(
                    left,
                    bottom,
                    *coordinates,
                    right,
                    bottom,
                    fill=blend_color(SURFACE, ACCENT, 0.10),
                    outline="",
                )
            canvas.create_line(
                *coordinates,
                fill=MUTED if settlement_average else ACCENT,
                width=2,
                smooth=False,
                dash=(5, 4) if settlement_average else (),
                tags=("history-team-line",),
            )

        for index, fraction in enumerate((0.0, 0.25, 0.5, 0.75, 1.0)):
            x = left + (right - left) * fraction
            canvas.create_line(x, bottom, x, bottom + 3, fill="#46525b")
            canvas.create_text(
                x,
                height - 8,
                text=format_duration(max_time * fraction),
                fill=SUBTLE,
                anchor="w" if index == 0 else "e" if index == 4 else "center",
                font=self._ui_font("micro"),
            )

        active_time = None if settlement_average else (
            self.history_detail_trend_hover_time
            if self.history_detail_trend_hover_time is not None
            else self.history_detail_trend_selected_time
        )
        active_point = (
            min(parsed, key=lambda point: abs(point[0] - active_time))
            if active_time is not None
            else None
        )
        if active_point is not None:
            second, dps = active_point
            marker_x = left + (right - left) * second / max_time
            marker_y = bottom - (bottom - top) * dps / chart_max
            locked = self.history_detail_trend_hover_time is None
            marker_color = "#e7f7f1" if locked else ACCENT
            canvas.create_line(
                marker_x,
                top,
                marker_x,
                bottom,
                fill=blend_color(SURFACE, marker_color, 0.72),
                dash=() if locked else (3, 3),
            )
            canvas.create_oval(
                marker_x - 4,
                marker_y - 4,
                marker_x + 4,
                marker_y + 4,
                fill=marker_color,
                outline=SURFACE,
            )
            tooltip_width, tooltip_height = 144, 43
            tooltip_left = int(marker_x + 8)
            if tooltip_left + tooltip_width > right:
                tooltip_left = int(marker_x - tooltip_width - 8)
            tooltip_left = max(left, min(right - tooltip_width, tooltip_left))
            tooltip_top = int(marker_y - tooltip_height - 8)
            if tooltip_top < top:
                tooltip_top = int(marker_y + 8)
            tooltip_top = min(bottom - tooltip_height, max(top, tooltip_top))
            tooltip_right = tooltip_left + tooltip_width
            tooltip_bottom = tooltip_top + tooltip_height
            cut = 5
            canvas.create_polygon(
                tooltip_left + cut,
                tooltip_top,
                tooltip_right,
                tooltip_top,
                tooltip_right,
                tooltip_bottom - cut,
                tooltip_right - cut,
                tooltip_bottom,
                tooltip_left,
                tooltip_bottom,
                tooltip_left,
                tooltip_top + cut,
                fill="#11191b",
                outline=blend_color(BORDER, ACCENT, 0.62),
            )
            canvas.create_text(
                tooltip_left + 9,
                tooltip_top + 12,
                text=f"战斗时间  {format_duration(second)}",
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
            )
            canvas.create_text(
                tooltip_left + 9,
                tooltip_top + 30,
                text=f"团队 DPS  {format_number(dps)}",
                fill=ACCENT,
                anchor="w",
                font=self._ui_font("micro"),
            )

        if peak_label is not None:
            peak_label.configure(fg=ACCENT)
            if settlement_average:
                peak_label.configure(text=f"结算平均 {format_number(peak)} DPS")
            elif active_point is not None:
                peak_label.configure(
                    text=(
                        f"{format_duration(active_point[0])} · "
                        f"{format_number(active_point[1])} DPS"
                    )
                )
            else:
                peak_label.configure(text=f"团队峰值 {format_number(peak)} DPS")

    def _draw_history_snapshot_trend(self) -> None:
        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        mode = getattr(self, "history_meter_mode", "dps")
        if mode != "dps":
            self.history_trend_plot_bounds = None
            if mode == "boss_damage":
                label = "首领伤害"
                detail = "打开战斗详情可查看真实攻击事件时间轴"
                peak = "精确事件"
            else:
                label = "HPS" if mode == "hps" else "DT"
                detail = "暂不提供逐秒趋势"
                peak = "结算数据"
            canvas.create_text(
                width // 2,
                height // 2 - 6,
                text=f"{label} 当前显示结算汇总",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 14,
                text=detail,
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            if getattr(self, "history_snapshot_peak_label", None) is not None:
                self.history_snapshot_peak_label.configure(text=peak)
            return

        parsed = self._history_snapshot_team_dps_points()
        participant_series = self._history_snapshot_participant_dps_points()
        if not parsed:
            self.history_trend_plot_bounds = None
            canvas.create_text(
                width // 2,
                height // 2 - 6,
                text="暂无团队趋势数据",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 14,
                text="该记录没有可用的团队结算数据",
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            if getattr(self, "history_snapshot_peak_label", None) is not None:
                self.history_snapshot_peak_label.configure(text="团队 · 10 秒滑动")
            return

        trend_source = getattr(
            self, "history_trend_source", "settlement_average"
        )
        settlement_average = trend_source == "settlement_average"
        # A settlement-average team line is not a time series.  Do not mix an
        # event-derived local curve into that fallback, which would imply the
        # flat team line was observed during combat.
        if settlement_average:
            participant_series = {}
        if self.history_snapshot_trend_title_label is not None:
            scope = getattr(self, "history_participant_trend_scope", "team_only")
            self.history_snapshot_trend_title_label.configure(
                text=(
                    "团队 DPS 结算平均"
                    if settlement_average
                    else "全员 + 团队 DPS"
                    if scope == "all_players"
                    else "团队 + 本机 DPS"
                    if scope == "team_and_self"
                    else "仅团队 DPS 趋势"
                )
            )

        left, top, right, bottom = 10, 10, width - 9, height - 24
        if right <= left or bottom <= top:
            self.history_trend_plot_bounds = None
            return
        max_time = max(
            1.0,
            max(value[0] for value in parsed),
            max(
                (
                    point[0]
                    for series in participant_series.values()
                    for point in series
                ),
                default=0.0,
            ),
        )
        peak = max(
            1.0,
            max(value[1] for value in parsed),
            max(
                (
                    point[1]
                    for series in participant_series.values()
                    for point in series
                ),
                default=0.0,
            ),
        )
        chart_max = peak * 1.25 if settlement_average else peak
        self.history_trend_plot_bounds = (
            None if settlement_average else (left, right, max_time)
        )

        for fraction in (0.25, 0.5, 0.75):
            y = top + int((bottom - top) * fraction)
            canvas.create_line(left, y, right, y, fill=BORDER, dash=(2, 3))
        canvas.create_line(left, bottom, right, bottom, fill="#354049")

        coordinates: list[float] = []
        for second, dps in parsed:
            coordinates.extend(
                [
                    left + (right - left) * second / max_time,
                    bottom - (bottom - top) * dps / chart_max,
                ]
            )
        if len(coordinates) >= 4:
            if not settlement_average:
                area = [left, bottom, *coordinates, right, bottom]
                canvas.create_polygon(
                    *area,
                    fill=blend_color(SURFACE, ACCENT, 0.08),
                    outline="",
                )
            canvas.create_line(
                *coordinates,
                fill=MUTED if settlement_average else ACCENT,
                width=3,
                smooth=False,
                dash=(5, 4) if settlement_average else (),
                tags=("history-team-line",),
            )

        record = self._selected_history_record()
        participant_rows = (
            record.get("participants", []) if isinstance(record, dict) else []
        )
        participant_by_id = {
            int(row.get("actor_id", 0) or 0): row
            for row in participant_rows
            if isinstance(row, dict) and int(row.get("actor_id", 0) or 0) > 0
        }
        series_colors = (
            "#b990e9", "#6dbce7", "#efc46d", "#df7485", "#82a9d7",
            "#91d27f", "#d497e8", "#7ecfc6", "#e5986e", "#91a6cc",
            "#d7cc75", "#a3aeb8",
        )
        ordered_series = sorted(
            participant_series.items(),
            key=lambda item: max((point[1] for point in item[1]), default=0.0),
            reverse=True,
        )[:MAX_PARTY_MEMBERS]
        fallback_color_by_actor = {
            actor_id: series_colors[index % len(series_colors)]
            for index, (actor_id, _series) in enumerate(ordered_series)
        }
        color_by_actor: dict[int, str] = {}
        for actor_id, series in ordered_series:
            player_coordinates: list[float] = []
            for second, dps in series:
                player_coordinates.extend(
                    [
                        left + (right - left) * second / max_time,
                        bottom - (bottom - top) * dps / chart_max,
                    ]
                )
            if len(player_coordinates) < 4:
                continue
            row = participant_by_id.get(actor_id, {})
            class_id = int(row.get("profession_id", 0) or 0)
            profession_color = PROFESSION_COLORS.get(class_id)
            color = profession_color or fallback_color_by_actor[actor_id]
            color_by_actor[actor_id] = color
            canvas.create_line(
                *player_coordinates,
                fill=color,
                width=1,
                smooth=False,
                tags=("history-player-line",),
            )
        canvas.tag_raise("history-team-line")

        for index, fraction in enumerate((0.0, 0.25, 0.5, 0.75, 1.0)):
            x = left + (right - left) * fraction
            canvas.create_line(x, bottom, x, bottom + 3, fill="#46525b")
            canvas.create_text(
                x,
                height - 8,
                text=format_duration(max_time * fraction),
                fill=SUBTLE,
                anchor="w" if index == 0 else "e" if index == 4 else "center",
                font=self._ui_font("micro"),
            )

        active_time = None if settlement_average else (
            self.history_trend_hover_time
            if self.history_trend_hover_time is not None
            else self.history_trend_selected_time
        )
        active_point: tuple[float, float] | None = None
        if active_time is not None:
            active_point = min(parsed, key=lambda value: abs(value[0] - active_time))
        if active_point is not None:
            second, dps = active_point
            marker_x = left + (right - left) * second / max_time
            marker_y = bottom - (bottom - top) * dps / chart_max
            locked = self.history_trend_hover_time is None
            marker_color = "#e7f7f1" if locked else ACCENT
            canvas.create_line(
                marker_x,
                top,
                marker_x,
                bottom,
                fill=blend_color(SURFACE, marker_color, 0.7),
                dash=() if locked else (3, 3),
                width=1,
            )
            canvas.create_oval(
                marker_x - 6,
                marker_y - 6,
                marker_x + 6,
                marker_y + 6,
                fill=blend_color(SURFACE, marker_color, 0.22),
                outline="",
            )
            canvas.create_oval(
                marker_x - 3,
                marker_y - 3,
                marker_x + 3,
                marker_y + 3,
                fill=marker_color,
                outline=SURFACE,
            )

            snapshot_rows: list[tuple[str, float, str]] = []
            for series_index, (actor_id, series) in enumerate(ordered_series):
                if not series:
                    continue
                point = min(series, key=lambda value: abs(value[0] - second))
                row = participant_by_id.get(actor_id, {})
                name = self._history_actor_name(
                    row, series_index, self._history_names_hidden()
                ) if row else f"玩家{series_index + 1}"
                color = color_by_actor.get(
                    actor_id,
                    fallback_color_by_actor.get(
                        actor_id, series_colors[series_index % len(series_colors)]
                    ),
                )
                snapshot_rows.append((name, point[1], color))
            snapshot_rows.sort(key=lambda value: value[1], reverse=True)
            if snapshot_rows:
                canvas.delete("history-trend-tooltip")
                tooltip_width = min(max(190, width - 24), 320)
                visible_rows = snapshot_rows[:MAX_PARTY_MEMBERS]
                column_count = 2 if len(visible_rows) > 6 and tooltip_width >= 250 else 1
                rows_per_column = max(
                    1, (len(visible_rows) + column_count - 1) // column_count
                )
                tooltip_height = 42 + rows_per_column * 17
                tooltip_left = int(marker_x + 8)
                if tooltip_left + tooltip_width > right:
                    tooltip_left = int(marker_x - tooltip_width - 8)
                tooltip_left = max(left, min(right - tooltip_width, tooltip_left))
                tooltip_top = max(top, min(bottom - tooltip_height, int(marker_y - tooltip_height / 2)))
                canvas.create_rectangle(
                    tooltip_left, tooltip_top,
                    tooltip_left + tooltip_width, tooltip_top + tooltip_height,
                    fill="#11191b", outline="#725f37",
                    tags=("history-trend-tooltip",)
                )
                canvas.create_text(
                    tooltip_left + 9, tooltip_top + 10,
                    text=f"{format_duration(second)}  ·  团队 {format_number(dps)} DPS",
                    fill=WARN, anchor="nw", font=self._ui_font("micro"),
                    tags=("history-trend-tooltip",)
                )
                content_width = tooltip_width - 18
                column_width = content_width / column_count
                for row_index, (name, value, color) in enumerate(visible_rows):
                    column = row_index // rows_per_column
                    row_in_column = row_index % rows_per_column
                    column_left = tooltip_left + 9 + column * column_width
                    column_right = tooltip_left + 9 + (column + 1) * column_width
                    y = tooltip_top + 31 + row_in_column * 17
                    canvas.create_rectangle(
                        column_left, y - 3, column_left + 7, y + 4,
                        fill=color, outline="", tags=("history-trend-tooltip",)
                    )
                    canvas.create_text(
                        column_left + 13,
                        y,
                        text=self._fit_ui_text(
                            name, max(32, int(column_width) - 64), "micro"
                        ),
                        fill=MUTED, anchor="w", font=self._ui_font("micro"),
                        tags=("history-trend-tooltip",)
                    )
                    canvas.create_text(
                        column_right - 5, y,
                        text=format_number(value), fill=TEXT, anchor="e",
                        font=self._ui_font("number_small"),
                        tags=("history-trend-tooltip",)
                    )
                canvas.tag_raise("history-trend-tooltip")
            else:
                tooltip_width, tooltip_height = 150, 42
                tooltip_left = int(marker_x + 8)
                if tooltip_left + tooltip_width > right:
                    tooltip_left = int(marker_x - tooltip_width - 8)
                tooltip_left = max(left, min(right - tooltip_width, tooltip_left))
                tooltip_top = max(top, min(bottom - tooltip_height, int(marker_y - tooltip_height - 9)))
                canvas.create_rectangle(
                    tooltip_left, tooltip_top,
                    tooltip_left + tooltip_width, tooltip_top + tooltip_height,
                    fill="#11191b", outline=blend_color(BORDER, ACCENT, 0.55)
                )
                canvas.create_text(
                    tooltip_left + 9, tooltip_top + 12,
                    text=f"时间  {format_duration(second)}", fill=MUTED,
                    anchor="w", font=self._ui_font("micro")
                )
                canvas.create_text(
                    tooltip_left + 9, tooltip_top + 29,
                    text=f"团队综合 DPS  {format_number(dps)}", fill=ACCENT,
                    anchor="w", font=self._ui_font("micro")
                )

        peak_label = getattr(self, "history_snapshot_peak_label", None)
        if peak_label is not None:
            if settlement_average:
                peak_label.configure(
                    text=f"结算平均 {self._history_optional_number(peak)} DPS"
                )
            elif active_point is not None:
                peak_label.configure(
                    text=(
                        f"{format_duration(active_point[0])} · "
                        f"{format_number(active_point[1])} DPS"
                    )
                )
            else:
