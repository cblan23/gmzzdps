    @staticmethod
    def _pvp_history_epoch(
        record: dict,
        nanosecond_key: str,
        text_key: str,
    ) -> float:
        try:
            stamp = float(record.get(nanosecond_key, 0) or 0)
        except (TypeError, ValueError, OverflowError):
            stamp = 0.0
        if stamp:
            return stamp / 1_000_000_000 if stamp > 10_000_000_000 else stamp
        text_value = str(record.get(text_key) or "").strip()
        if not text_value:
            return 0.0
        try:
            return dt.datetime.fromisoformat(
                text_value.replace("Z", "+00:00")
            ).timestamp()
        except (TypeError, ValueError, OverflowError):
            return 0.0

    @staticmethod
    def _pvp_history_result_key(value: object) -> str:
        normalized = str(value or "").strip().casefold()
        if normalized in {"胜利", "victory", "win", "won", "defeated"}:
            return RESULT_DEFEATED
        if normalized in {"失败", "failure", "fail", "loss", "lost"}:
            return RESULT_FAILED
        return "pvp_unknown"

    @staticmethod
    def _pvp_history_duplicate_key(record: object) -> tuple[object, ...]:
        """Identify two locally finalized rows that came from one match."""

        if not isinstance(record, dict):
            return ()
        try:
            started_at_ns = int(record.get("started_at_ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            started_at_ns = 0
        player = record.get("player")
        player = player if isinstance(player, dict) else {}
        character_id = str(
            player.get("character_id") or player.get("user_token") or ""
        ).strip()
        if started_at_ns <= 0 or not character_id:
            return ()

        def integer(value: object) -> int:
            try:
                return int(value or 0)
            except (TypeError, ValueError, OverflowError):
                return 0

        return (
            started_at_ns,
            character_id,
            integer(record.get("mode_id")),
            integer(record.get("map_id")),
            integer(record.get("team_size")),
        )

    def _pvp_history_record_quality(self, record: dict) -> tuple[int, ...]:
        """Prefer the completed settlement over a stale partial duplicate."""

        data_scope = record.get("data_scope")
        data_scope = data_scope if isinstance(data_scope, dict) else {}
        allies = record.get("allies")
        allies = allies if isinstance(allies, list) else []
        enemies = record.get("enemies")
        enemies = enemies if isinstance(enemies, list) else []
        try:
            team_size = max(0, int(record.get("team_size", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            team_size = 0

        def member_key(row: object) -> str:
            if not isinstance(row, dict):
                return ""
            return str(
                row.get("character_id")
                or row.get("user_token")
                or row.get("opponent_id")
                or ""
            ).strip()

        def unique_count(rows: list) -> int:
            keys = {member_key(row) for row in rows if member_key(row)}
            return len(keys) if keys else len([row for row in rows if isinstance(row, dict)])

        ally_count = unique_count(allies)
        enemy_count = unique_count(enemies)
        members = [
            row for row in [*allies, *enemies] if isinstance(row, dict)
        ]
        full_roster = bool(
            team_size > 0
            and ally_count >= team_size
            and enemy_count >= team_size
        )
        equipment_count = sum(
            isinstance(row.get("equipment_snapshot"), dict) for row in members
        )
        skill_member_count = sum(
            bool(row.get("skills")) for row in members
        )
        skill_count = sum(
            len(row.get("skills"))
            for row in members
            if isinstance(row.get("skills"), list)
        )
        known_result = self._pvp_history_result_key(
            record.get("result")
        ) != "pvp_unknown"
        return (
            int(full_roster),
            int(str(data_scope.get("roster") or "").casefold() == "verified"),
            int(
                str(data_scope.get("team_metrics") or "").casefold()
                == "authoritative"
            ),
            int(known_result),
            min(ally_count, team_size) + min(enemy_count, team_size),
            equipment_count,
            skill_member_count,
            skill_count,
            int(bool(record.get("capture_complete"))),
        )

    def _deduplicate_pvp_history_records(self, records: object) -> list[dict]:
        result: list[dict] = []
        indexes: dict[tuple[object, ...], int] = {}
        for raw in records if isinstance(records, list) else []:
            if not isinstance(raw, dict):
                continue
            key = self._pvp_history_duplicate_key(raw)
            if not key or key not in indexes:
                result.append(raw)
                if key:
                    indexes[key] = len(result) - 1
                continue
            index = indexes[key]
            current = result[index]
            preferred = (
                raw
                if self._pvp_history_record_quality(raw)
                > self._pvp_history_record_quality(current)
                else current
            )
            if bool(raw.get("favorite")) or bool(current.get("favorite")):
                preferred = dict(preferred)
                preferred["favorite"] = True
            result[index] = preferred
        return result

    def _pvp_history_summary(self, record: dict, *, projected: bool = False) -> dict:
        source = (
            (record if projected else project_duel_result_counters(record))
            if isinstance(record, dict) else {}
        )
        def optional_nonnegative_int(value: object) -> int | None:
            if value is None:
                return None
            try:
                return max(0, int(value))
            except (TypeError, ValueError, OverflowError):
                return None

        player = source.get("player")
        player = player if isinstance(player, dict) else {}
        try:
            map_id = int(source.get("map_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            map_id = 0
        metadata = RECORDABLE_MAPS.get(map_id, {})
        mode_name = str(
            source.get("mode_name") or metadata.get("mode_name") or "未知模式"
        ).strip()
        map_name = str(
            source.get("map_name") or metadata.get("map_name") or "未知地图"
        ).strip()
        match_id = str(
            source.get("match_id") or source.get("battle_id") or ""
        ).strip()
        started_at_epoch = self._pvp_history_epoch(
            source, "started_at_ns", "started_at"
        )
        ended_at_epoch = self._pvp_history_epoch(
            source, "ended_at_ns", "ended_at"
        )
        try:
            duration = float(source.get("duration_seconds", 0.0) or 0.0)
        except (TypeError, ValueError, OverflowError):
            duration = 0.0
        damage = optional_nonnegative_int(
            source.get("damage", source.get("damage_done"))
        )
        try:
            team_size = int(
                source.get("team_size", metadata.get("team_size", 0)) or 0
            )
        except (TypeError, ValueError, OverflowError):
            team_size = 0
        match_kind = str(source.get("match_kind") or "").casefold()
        data_scope = source.get("data_scope")
        data_scope = data_scope if isinstance(data_scope, dict) else {}
        self_metrics_scope = str(
            data_scope.get("self_metrics") or ""
        ).strip().casefold()
        self_metrics_trusted = bool(
            team_size <= 1 or self_metrics_scope == "self_exact"
        )
        if not self_metrics_trusted:
            damage = None
        category = (
            "猎龙之城"
            if map_id in HUNTER_CITY_MAPS
            else
            "竞技场"
            if match_kind == "duel" or team_size in {1, 3, 6, 12}
            else "GVG"
        )
        equipment = player.get("equipment_snapshot")
        equipment = equipment if isinstance(equipment, dict) else {}
        rating = player.get("extraordinary_rating")
        if rating is None:
            rating = equipment.get("extraordinary_rating")
        opponents = source.get("opponents")
        opponents = opponents if isinstance(opponents, list) else []
        raw_result = str(source.get("result") or "未知").strip() or "未知"
        if raw_result not in {"胜利", "失败", "未知"}:
            raw_result = "未知"
        summary = dict(source)
        summary.update(
            {
                "battle_id": match_id,
                "encounter_id": match_id,
                "started_at_epoch": started_at_epoch,
                "ended_at_epoch": ended_at_epoch,
                "duration_seconds": max(0.0, duration),
                "stage_name": mode_name,
                "dungeon_name": map_name,
                "boss_name": map_name,
                "boss_count": 1,
                "difficulty": category,
                "my_name": str(player.get("name") or "未知玩家"),
                "profession_id": player.get("profession_id", 0),
                "extraordinary_rating": rating,
                "kills": (
                    optional_nonnegative_int(source.get("kills"))
                    if self_metrics_trusted
                    else None
                ),
                "assists": (
                    optional_nonnegative_int(source.get("assists"))
                    if self_metrics_trusted
                    else None
                ),
                "deaths": (
                    optional_nonnegative_int(source.get("deaths"))
                    if self_metrics_trusted
                    else None
                ),
                "my_damage": damage,
                "my_dps": (
                    damage / duration
                    if damage is not None and duration > 0
                    else None
                ),
                "my_taken": (
                    optional_nonnegative_int(
                        source.get("damage_taken", source.get("taken"))
                    )
                    if self_metrics_trusted
                    else None
                ),
                "result": (
                    "pvp_no_result" if map_id in HUNTER_CITY_MAPS
                    else self._pvp_history_result_key(raw_result)
                ),
                "pvp_result": (
                    "该类型无结果" if map_id in HUNTER_CITY_MAPS
                    else raw_result
                ),
                "pvp_category": category,
                "team_size": team_size,
                "pvp_mode_label": (
                    "猎龙战"
                    if map_id in HUNTER_CITY_MAPS
                    else
                    f"{team_size}V{team_size}"
                    if team_size in {1, 3, 6, 12}
                    else "PvP"
                ),
                "opponent_count": len(opponents),
                "pvp_data_quality": (
                    "trusted"
                    if self_metrics_trusted
                    else "legacy_unverified"
                ),
                "_pvp_record": source,
            }
        )
        return summary

    def _query_pvp_history_summaries(self) -> tuple[dict, dict]:
        controller = getattr(self, "pvp_recording", None)
        account_key = str(getattr(controller, "account_key", "") or "")
        repository = getattr(self, "pvp_history_repository", None)
        records = repository.list(account_key) if repository is not None and account_key else []
        records = self._deduplicate_pvp_history_records(records)
        summaries = [
            self._pvp_history_summary(record, projected=True)
            for record in records
            if isinstance(record, dict)
        ]

        time_value = (
            getattr(self, "history_filter_time_var", None).get()
            if getattr(self, "history_filter_time_var", None) is not None
            else "近30天"
        )
        now = dt.datetime.now().astimezone()
        today = now.replace(hour=0, minute=0, second=0, microsecond=0)
        start_epoch = 0.0
        days_by_label = {
            "今天": 0,
            "近3天": 2,
            "近7天": 6,
            "近30天": 29,
            "近90天": 89,
        }
        if time_value in days_by_label:
            start_epoch = (
                today - dt.timedelta(days=days_by_label[time_value])
            ).timestamp()
        entries = getattr(self, "history_filter_entries", {})
        query_entry = entries.get("query") if isinstance(entries, dict) else None
        query = str(query_entry.value() if query_entry is not None else "").casefold()
        mode_filter = (
            getattr(self, "history_filter_boss_var", None).get()
            if getattr(self, "history_filter_boss_var", None) is not None
            else "模式  全部"
        )
        result_value = (
            getattr(self, "history_filter_result_var", None).get()
            if getattr(self, "history_filter_result_var", None) is not None
            else "比赛结果  全部"
        )
        filtered: list[dict] = []
        for summary in summaries:
            if start_epoch and float(summary.get("started_at_epoch", 0.0) or 0.0) < start_epoch:
                continue
            if mode_filter != "模式  全部":
                expected = {
                    "1V1": 1,
                    "3V3": 3,
                    "6V6": 6,
                    "12V12": 12,
                }.get(str(mode_filter).upper())
                if expected is not None and int(summary.get("team_size", 0) or 0) != expected:
                    continue
            if result_value in {"胜利", "失败", "未知", "该类型无结果"}:
                if str(summary.get("pvp_result") or "未知") != result_value:
                    continue
            if query:
                payload = summary.get("_pvp_record")
                payload = payload if isinstance(payload, dict) else {}
                searchable_players = []
                for key in ("opponents", "allies", "enemies"):
                    rows = payload.get(key)
                    if isinstance(rows, list):
                        searchable_players.extend(
                            row for row in rows if isinstance(row, dict)
                        )
                haystack = " ".join(
                    [
                        str(summary.get("battle_id") or ""),
                        str(summary.get("stage_name") or ""),
                        str(summary.get("dungeon_name") or ""),
                        str(summary.get("my_name") or ""),
                        *(str(row.get("name") or "") for row in searchable_players),
                    ]
                ).casefold()
                if query not in haystack:
                    continue
            filtered.append(summary)

        sort_variable = getattr(self, "history_sort_var", None)
        sort_value = sort_variable.get() if sort_variable else "时间最新"
        sort_key, reverse = {
            "时间最新": (lambda row: float(row.get("started_at_epoch", 0.0) or 0.0), True),
            "时间最早": (lambda row: float(row.get("started_at_epoch", 0.0) or 0.0), False),
            "击杀最多": (lambda row: int(row.get("kills", 0) or 0), True),
            "助攻最多": (lambda row: int(row.get("assists", 0) or 0), True),
            "阵亡最多": (lambda row: int(row.get("deaths", 0) or 0), True),
            "时长最长": (lambda row: float(row.get("duration_seconds", 0.0) or 0.0), True),
            "时长最短": (lambda row: float(row.get("duration_seconds", 0.0) or 0.0), False),
        }.get(sort_value, (lambda row: float(row.get("started_at_epoch", 0.0) or 0.0), True))
        filtered.sort(key=sort_key, reverse=reverse)

        total = len(filtered)
        page_size = max(1, int(getattr(self, "history_page_size", 10) or 10))
        page_count = max(1, (total + page_size - 1) // page_size)
        page = min(page_count, max(1, int(getattr(self, "history_page_number", 1) or 1)))
        start = (page - 1) * page_size
        visible = filtered[start : start + page_size]
        def complete_total(field: str) -> int | None:
            values = [row.get(field) for row in filtered]
            if any(value is None for value in values):
                return None
            return sum(int(value or 0) for value in values)

        overview = {
            "battle_count": total,
            "total_kills": complete_total("kills"),
            "total_assists": complete_total("assists"),
            "total_deaths": complete_total("deaths"),
        }
        return (
            {
                "records": visible,
                "total": total,
                "page": page,
                "page_count": page_count,
                "page_size": page_size,
            },
            overview,
        )

    def _query_history_records(self) -> None:
        self.history_filter_after_id = None
        try:
            if getattr(self, "backend_current_page", "history") == "kings":
                result, overview = self._query_pvp_history_summaries()
            else:
                filters = self._history_filter_payload()
                result = self.history_store.query_summaries(
                    filters,
                    page=self.history_page_number,
                    page_size=self.history_page_size,
                    sort=self._history_sort_key(),
                )
                total = int(result.get("total", 0) or 0)
                balanced_page_size = self._balanced_history_page_size(
                    total, self.history_page_size
                )
                if balanced_page_size != self.history_page_size:
                    result = self.history_store.query_summaries(
                        filters,
                        page=int(result.get("page", self.history_page_number) or 1),
                        page_size=balanced_page_size,
                        sort=self._history_sort_key(),
                    )
                overview = self.history_store.history_overview(filters)
        except (OSError, TypeError, ValueError):
            result = {
                "records": [],
                "total": 0,
                "page": 1,
                "page_count": 1,
            }
            overview = {}
        self.history_effective_page_size = int(
            result.get("page_size", getattr(self, "history_page_size", 10))
            or getattr(self, "history_page_size", 10)
        )
        # Lightweight callers (and the deferred startup path) may query the
        # route before the full history workspace has initialized every
        # selection field.  Treat that state as an empty selection rather than
        # making the first PvP refresh fail before it can render.
        previous_id = getattr(self, "history_selected_id", "")
        if getattr(self, "backend_current_page", "history") != "kings":
            # Query refreshes can follow a late settlement save for the same
            # selected battle. Never retain its older detail payload.
            self.history_loaded_record = None
        self.history_records = list(result.get("records", []))
        self.history_total_records = int(result.get("total", 0) or 0)
        self.history_page_number = int(result.get("page", 1) or 1)
        self.history_page_count = int(result.get("page_count", 1) or 1)
        current_page_ids = {
            str(row.get("battle_id", row.get("encounter_id", "")))
            for row in self.history_records
        }
        if previous_id not in current_page_ids:
            self.history_selected_id = (
                str(
                    self.history_records[0].get(
                        "battle_id", self.history_records[0].get("encounter_id", "")
                    )
                )
                if self.history_records
                else ""
            )
            self.history_selected_actor = 0
            self.history_loaded_record = None
        self.history_overview_data = overview
        if self.history_count_label is not None:
            selected = len(self.history_selected_ids)
            suffix = f" · 已选 {selected}" if selected else ""
            self.history_count_label.configure(
                text=f"共 {self.history_total_records} 场{suffix}"
            )
        self._update_history_overview()
        self._draw_history_list()
        self._draw_history_pagination()
        self._render_history_snapshot()
        self._sync_history_selection_controls()
        if self.history_page_mode == "detail":
            self._render_history_selection()

