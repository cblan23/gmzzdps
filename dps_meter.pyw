    def _draw_history_boss_details(self) -> None:
        canvas = self.history_skill_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        boss_damage = self._history_boss_damage(record)
        sources = self._history_boss_sources(record)
        source = next(
            (
                row
                for row in sources
                if int(row.get("entity_id", 0) or 0)
                == int(self.history_selected_actor or 0)
            ),
            None,
        )
        if not isinstance(source, dict):
            message, color = self._history_boss_coverage_text(boss_damage)
            canvas.create_text(
                width // 2,
                height // 2 - 9,
                text=message,
                fill=color,
                font=self._ui_font("strong"),
            )
            if message == "该场未记录首领伤害":
                canvas.create_text(
                    width // 2,
                    height // 2 + 16,
                    text="仅新产生且捕获到精确攻击事件的记录可展示",
                    fill=SUBTLE,
                    font=self._ui_font("micro"),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        target_mode = self.history_detail_mode == "targets"
        raw_rows = source.get("targets" if target_mode else "skills", [])
        rows = (
            [row for row in raw_rows if isinstance(row, dict)]
            if isinstance(raw_rows, list)
            else []
        )
        header_height = 30
        row_height = 42
        top = header_height
        canvas.create_rectangle(
            0, 0, width, header_height, fill=SURFACE, outline=""
        )
        if target_mode:
            columns = {
                "damage": int(width * 0.66),
                "share": int(width * 0.82),
                "hits": width - 14,
            }
            headers = (
                ("受击成员", 12, "w"),
                ("承受伤害", columns["damage"], "e"),
                ("来源占比", columns["share"], "e"),
                ("命中次数", columns["hits"], "e"),
            )
        else:
            columns = {
                "damage": int(width * 0.52),
                "share": int(width * 0.64),
                "hits": int(width * 0.76),
                "average": int(width * 0.88),
                "max_hit": width - 14,
            }
            headers = (
                ("首领技能", 42, "w"),
                ("伤害", columns["damage"], "e"),
                ("占比", columns["share"], "e"),
                ("命中次数", columns["hits"], "e"),
                ("平均命中", columns["average"], "e"),
                ("最高一击", columns["max_hit"], "e"),
            )
        for text_value, x, anchor in headers:
            canvas.create_text(
                x,
                header_height // 2,
                text=text_value,
                fill=MUTED,
                anchor=anchor,
                font=self._ui_font("small"),
            )
        if not rows:
            canvas.create_text(
                width // 2,
                top + row_height // 2,
                text="暂无受击成员明细" if target_mode else "暂无首领技能明细",
                fill=MUTED,
                font=self._ui_font("body"),
            )
            top += row_height

        participant_rows = (
            record.get("participants", []) if isinstance(record, dict) else []
        )
        participant_rows = (
            participant_rows if isinstance(participant_rows, list) else []
        )
        participant_index = {
            int(row.get("actor_id", 0) or 0): index
            for index, row in enumerate(participant_rows)
            if isinstance(row, dict)
        }
        max_damage = max(
            (max(0, int(row.get("damage", 0) or 0)) for row in rows),
            default=0,
        )
        icons: list[object] = []
        name_right = columns["damage"] - 14
        for index, row in enumerate(rows):
            bottom = top + row_height
            base = PANEL if index % 2 == 0 else SURFACE
            damage = max(0, int(row.get("damage", 0) or 0))
            share = max(0.0, min(1.0, float(row.get("share", 0.0) or 0.0)))
            hits = max(0, int(row.get("hits", 0) or 0))
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline=""
            )
            if max_damage:
                canvas.create_rectangle(
                    0,
                    top,
                    max(3, int(width * damage / max_damage)),
                    bottom - 1,
                    fill=blend_color(base, "#e67d72", 0.12),
                    outline="",
                )
            if target_mode:
                actor_id = int(row.get("actor_id", 0) or 0)
                name = str(row.get("name", "")).strip() or "队伍成员"
                if self._history_names_hidden():
                    target_index = participant_index.get(actor_id, index)
                    name = f"玩家{target_index + 1}"
                name_x = 12
            else:
                skill_id = int(row.get("skill_id", 0) or 0)
                name = str(row.get("name", "")).strip() or "未命名技能"
                icon = self.icons.skill(skill_id, name, 0, 24)
                icons.append(icon)
                canvas.create_image(
                    10, top + (row_height - 24) // 2, image=icon, anchor="nw"
                )
                name_x = 42
            canvas.create_text(
                name_x,
                top + row_height // 2,
                text=self._fit_ui_text(
                    name, max(40, name_right - name_x), "strong"
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            for key, text_value in (
                ("damage", format_number(damage)),
                ("share", f"{share * 100:.1f}%"),
                ("hits", str(hits)),
            ):
                canvas.create_text(
                    columns[key],
                    top + row_height // 2,
                    text=text_value,
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font(
                        "number_strong" if key == "damage" else "number"
                    ),
                )
            if not target_mode:
                canvas.create_text(
                    columns["average"],
                    top + row_height // 2,
                    text=format_number(float(row.get("average_hit", 0.0) or 0.0)),
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number"),
                )
                canvas.create_text(
                    columns["max_hit"],
                    top + row_height // 2,
                    text=format_number(max(0, int(row.get("max_hit", 0) or 0))),
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number"),
                )
            top = bottom
        canvas._history_boss_skill_icons = icons
        canvas.configure(scrollregion=(0, 0, width, max(height, top)))

    def _draw_pvp_history_skills(self) -> None:
        """Draw both PvP skill directions in the native skill canvas."""
        canvas = self.history_skill_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        participants = record.get("participants", []) if isinstance(record, dict) else []
        participant = next(
            (row for row in participants if isinstance(row, dict) and int(row.get("actor_id", 0) or 0) == int(self.history_selected_actor or 0)),
            None,
        )
        if not isinstance(participant, dict):
            canvas.create_text(width // 2, height // 2, text="请选择一名玩家查看技能", fill=MUTED, font=self._ui_font("strong"))
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        def count(row: dict, key: str) -> int:
            try:
                return max(0, int(row.get(key, 0) or 0))
            except (TypeError, ValueError, OverflowError):
                return 0

        observed = participant.get("skills")
        if not isinstance(observed, list):
            observed = participant.get("skills_outgoing")
        used = [
            row for row in observed if isinstance(row, dict)
            and any(count(row, key) for key in ("casts", "hits", "damage"))
        ] if isinstance(observed, list) else []
        used.sort(key=lambda row: (-count(row, "casts"), -count(row, "damage")))
        sections = [("已观测技能使用", used, ACCENT, "used")]
        if participant.get("is_self") or participant.get("side") == "enemy":
            incoming = participant.get("pvp_skills_from")
            incoming = [
                row for row in incoming if isinstance(row, dict)
                and count(row, "damage") > 0
            ] if isinstance(incoming, list) else []
            incoming.sort(key=lambda row: -count(row, "damage"))
            sections.append((
                "敌方对我的伤害（已观测）"
                if participant.get("is_self") else "对我的伤害（已观测）",
                incoming, "#e47c80", "incoming",
            ))
        top = 0
        icons: list[object] = []
        for title, rows, accent, direction in sections:
            section_height = 32
            canvas.create_rectangle(0, top, width, top + section_height, fill=SURFACE, outline="")
            canvas.create_text(12, top + section_height // 2, text=title, fill=accent, anchor="w", font=self._ui_font("strong"))
            summary = (
                f"{len(rows)} 项 · {sum(count(row, 'casts') for row in rows)} 次释放"
                if direction == "used"
                else f"已观测 {format_number(sum(count(row, 'damage') for row in rows))}"
                if rows else "仅显示精确命中"
            )
            canvas.create_text(width - 12, top + section_height // 2, text=summary, fill=MUTED, anchor="e", font=self._ui_font("micro"))
            top += section_height
            if not rows:
                canvas.create_text(
                    width // 2,
                    top + 19,
                    text=(
                        "本场未取得可识别的技能使用记录"
                        if direction == "used"
                        else "未观测到该玩家对我的精确技能伤害"
                    ),
                    fill=MUTED,
                    font=self._ui_font("micro"),
                )
                top += 38
                continue
            row_height = 40
            for row in rows:
                bottom = top + row_height
                canvas.create_rectangle(0, top, width, bottom - 1, fill=PANEL if (top // row_height) % 2 == 0 else SURFACE, outline="")
                skill_id = int(row.get("skill_id", 0) or 0)
                skill_name = _history_skill_display_name(row.get("name")) or (
                    f"技能 ID {skill_id}" if skill_id else "未知技能"
                )
                icon = self.icons.skill(skill_id, skill_name, 0, 24)
                icons.append(icon)
                canvas.create_image(10, top + 8, image=icon, anchor="nw")
                canvas.create_text(42, top + 13, text=self._fit_ui_text(skill_name, max(70, int(width * .43)), "strong"), fill=TEXT, anchor="w", font=self._ui_font("strong"))
                hits = count(row, "hits")
                damage = count(row, "damage")
                if direction == "used":
                    casts = count(row, "casts")
                    values = (
                        ("释放", self._history_optional_number(casts if casts else None), width * .69),
                        ("命中", self._history_optional_number(hits if hits else None), width * .82),
                        ("已观测伤害", self._history_optional_number(damage if hits or damage else None), width - 12),
                    )
                else:
                    values = (
                        ("命中", self._history_optional_number(hits if hits else None), width * .81),
                        ("对我伤害", self._history_optional_number(damage), width - 12),
                    )
                for caption, value, x in values:
                    canvas.create_text(x, top + 10, text=value, fill=TEXT if value != "--" else MUTED, anchor="e", font=self._ui_font("number"))
                    canvas.create_text(x, top + 27, text=caption, fill=SUBTLE, anchor="e", font=self._ui_font("micro"))
                top = bottom
        canvas._history_pvp_skill_icons = icons
        canvas.configure(scrollregion=(0, 0, width, max(height, top)))

    def _select_history_equipment_item(self, event: tk.Event) -> None:
        if getattr(self, "history_detail_mode", "skills") != "equipment":
            return
        canvas = getattr(self, "history_skill_canvas", None)
        if canvas is None:
            return
        x, y = canvas.canvasx(event.x), canvas.canvasy(event.y)
        for left, top, right, bottom, index in getattr(canvas, "_pvp_equipment_hit_rows", ()):
            if left <= x <= right and top <= y < bottom:
                self.history_equipment_selected_index = index
                self._draw_history_skills()
                return

    def _draw_pve_history_equipment(self, canvas: tk.Canvas, record: dict) -> None:
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        participant = self._selected_history_equipment_participant(record)
        snapshot = participant.get("equipment_snapshot") if participant else None
        if isinstance(snapshot, dict):
            canvas.create_rectangle(0, 0, width, 38, fill=SURFACE, outline="")
            canvas.create_text(
                12, 19,
                text=f"快照时间  {self._history_equipment_timestamp(snapshot)}",
                fill=SUBTLE, anchor="w", font=self._ui_font("small"),
            )
        self._draw_pvp_duel_equipment_analysis(
            canvas, width, height, participant,
            selected_index_attr="history_equipment_selected_index",
            header_height=38 if isinstance(snapshot, dict) else 0,
        )

    def _draw_history_skills(self) -> None:
        canvas = self.history_skill_canvas
        if canvas is None:
            return
        if (
            getattr(self, "history_detail_mode", "skills") == "equipment"
            and getattr(self, "history_page_mode", "browser") == "detail"
        ):
            record = self._selected_history_record()
            if isinstance(record, dict) and str(record.get("combat_mode", "")).casefold() != "pvp":
                self._draw_pve_history_equipment(canvas, record)
                return
        if getattr(self, "history_meter_mode", "dps") == "boss_damage":
            self._draw_history_boss_details()
            return
        if getattr(self, "history_meter_mode", "dps") == "hps":
            self._draw_history_healing_details()
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        if getattr(self, "history_meter_mode", "dps") == "dt":
            canvas.create_text(
                width // 2,
                height // 2,
                text="承伤技能归属暂不可用",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        record = self._selected_history_record()
        if (
            isinstance(record, dict)
            and str(record.get("combat_mode", "")).casefold() == "pvp"
        ):
            self._draw_pvp_history_skills()
            return
        participants = record.get("participants", []) if record else []
        participants = participants if isinstance(participants, list) else []
        participant = next(
            (
                item
                for item in participants
                if int(item.get("actor_id", 0) or 0)
                == self.history_selected_actor
            ),
            None,
        )
        if not isinstance(participant, dict):
            canvas.create_text(
                width // 2,
                height // 2,
                text="暂无个人详情",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        detail_layout = getattr(self, "history_page_mode", "browser") == "detail"
        row_height = 42 if detail_layout else 38
        header_height = 30
        top = header_height
        if self.history_detail_mode == "targets":
            columns = {
                "type": int(width * 0.60),
                "damage": int(width * 0.80),
                "share": width - 14,
            }
            canvas.create_rectangle(
                0, 0, width, header_height, fill=SURFACE, outline=""
            )
            for text, x, anchor in (
                ("伤害目标", 12, "w"),
                ("类型", columns["type"], "e"),
                ("伤害", columns["damage"], "e"),
                ("占个人总伤", columns["share"], "e"),
            ):
                canvas.create_text(
                    x,
                    header_height // 2,
                    text=text,
                    fill=MUTED,
                    anchor=anchor,
                    font=self._ui_font("small"),
                )
            rows = participant.get("targets", [])
            rows = rows if isinstance(rows, list) else []
            if not rows:
                canvas.create_text(
                    width // 2,
                    top + row_height // 2,
                    text="暂无目标伤害",
                    fill=MUTED,
                    font=self._ui_font("body"),
                )
                top += row_height
            for index, target in enumerate(rows):
                bottom = top + row_height
                base = PANEL if index % 2 == 0 else SURFACE
                kind = str(target.get("kind", "小怪"))
                color = WARN if kind == "Boss" else ACCENT
                name = str(target.get("name", "")).strip() or "未命名目标"
                entity_ids = target.get("entity_ids", [])
                entity_count = len(entity_ids) if isinstance(entity_ids, list) else 0
                if entity_count > 1 and not bool(
                    target.get("history_encounter_group")
                ):
                    name = f"{name} ×{entity_count}"
                share = float(target.get("share", 0.0) or 0.0)
                canvas.create_rectangle(
                    0, top, width, bottom - 1, fill=base, outline=""
                )
                canvas.create_text(
                    12,
                    top + row_height // 2,
                    text=name,
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("strong"),
                )
                canvas.create_text(
                    columns["type"],
                    top + row_height // 2,
                    text=kind,
                    fill=color,
                    anchor="e",
                    font=self._ui_font("small"),
                )
                canvas.create_text(
                    columns["damage"],
                    top + row_height // 2,
                    text=format_number(target.get("damage", 0)),
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number_strong"),
                )
                canvas.create_text(
                    columns["share"],
                    top + row_height // 2,
                    text=f"{share * 100:.1f}%",
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number"),
                )
                top = bottom
        else:
            detail_columns = detail_layout and width >= 600
            count_heading, _count_help = self._history_skill_count_presentation(
                participant
            )
            rows = self._history_damage_skills(participant)
            show_max_hit = bool(
                detail_columns
                and any(
                    isinstance(skill, dict)
                    and skill.get("max_hit") is not None
                    for skill in rows
                )
            )
            if detail_columns and show_max_hit:
