    def _draw_pvp_history_inline_actions(
        self,
        canvas: tk.Canvas,
        left: int,
        top: int,
        index: int,
        favorite: bool,
    ) -> dict[str, str]:
        """Draw View/Share/Favorite only; deletion is not a PvP row action."""

        right = left + 140
        specs = (
            ("view", "查看详情", "eye", left, top, right, top + 28),
            ("share", "分享", "share", left, top + 34, left + 68, top + 62),
            ("favorite", "收藏", "star", left + 72, top + 34, right, top + 62),
        )
        tags = {}
        font = self._ui_font("micro")
        for kind, caption, icon_name, x1, y1, x2, y2 in specs:
            tag = f"pvp-history-action-{kind}:{index}"
            tags[kind] = tag
            active = kind == "favorite" and favorite
            if kind == "view":
                fill, outline, foreground = "#173b32", ACCENT, ACCENT
            elif active:
                fill, outline, foreground = "#2b2416", WARN, WARN
            else:
                fill, outline, foreground = "#151e27", MODAL_BORDER, "#a9b9c8"
            canvas.create_rectangle(
                x1,
                y1,
                x2,
                y2,
                fill=fill,
                outline=outline,
                tags=(tag, f"{tag}:bg"),
            )
            icon_size = 13
            text_width = font.measure(caption)
            content_width = icon_size + 5 + text_width
            content_left = (x1 + x2 - content_width) / 2
            icon = self.icons.toolbar(icon_name, icon_size, foreground)
            canvas.create_image(
                content_left,
                (y1 + y2) / 2,
                image=icon,
                anchor="w",
                tags=(tag, f"{tag}:icon"),
            )
            canvas.create_text(
                content_left + icon_size + 5,
                (y1 + y2) / 2,
                text=caption,
                fill=foreground,
                anchor="w",
                font=font,
                tags=(tag, f"{tag}:text"),
            )
        return tags

    def _set_pvp_history_action_hover(
        self,
        canvas: tk.Canvas,
        index: int,
        kind: str,
        hovered: bool,
        *,
        favorite: bool = False,
    ) -> None:
        tag = f"pvp-history-action-{kind}:{index}"
        if kind == "view":
            fill = "#205244" if hovered else "#173b32"
            outline = ACCENT
            foreground = "#dffcf2" if hovered else ACCENT
        elif kind == "favorite" and (favorite or hovered):
            fill, outline, foreground = "#382d17", WARN, WARN
        else:
            fill = "#1d2d3a" if hovered else "#151e27"
            outline = "#456077" if hovered else MODAL_BORDER
            foreground = "#dce9f4" if hovered else "#a9b9c8"
        canvas.itemconfigure(f"{tag}:bg", fill=fill, outline=outline)
        canvas.itemconfigure(f"{tag}:text", fill=foreground)
