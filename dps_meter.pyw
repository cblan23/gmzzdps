    @staticmethod
    def _missing_upload_equipment_tokens(record: object) -> set[str]:
        if not isinstance(record, dict):
            return set()
        identities = record.get("participant_identities")
        if not isinstance(identities, list):
            identities = record.get("participants_snapshot")
        actor_tokens: dict[int, str] = {}
        if isinstance(identities, list):
            for identity in identities:
                if not isinstance(identity, dict):
                    continue
                try:
                    actor_id = int(
                        identity.get("actor_id") or identity.get("iid") or 0
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
                token = str(
                    identity.get("character_id")
                    or identity.get("user_token")
                    or identity.get("id")
                    or ""
                ).strip()
                if actor_id and token:
                    actor_tokens[actor_id] = token

        missing: set[str] = set()
        participants = record.get("participants")
        if not isinstance(participants, list):
            return missing
        self_character_id = str(record.get("self_character_id") or "").strip()
        for participant in participants:
            if not isinstance(participant, dict):
                continue
            name = str(participant.get("name", "") or "").strip()
            if (
                history_participant_is_ai(participant)
                or name.endswith(PROJECTION_NAME_SUFFIX)
            ):
                continue
            snapshot = participant.get("equipment_snapshot")
            if (
                isinstance(snapshot, dict)
                and isinstance(snapshot.get("equipment"), list)
                and bool(snapshot["equipment"])
            ):
                continue
            token = str(
                participant.get("user_token")
                or participant.get("character_id")
                or actor_tokens.get(participant.get("actor_id"))
                or (
                    self_character_id
                    if participant.get("is_self") is True
                    else ""
                )
                or ""
            ).strip()
            if token:
                missing.add(token)
        return missing

    def _continue_automatic_victory_upload(
        self,
        battle_id: str,
        fallback_record: dict,
        equipment_deadline: float,
        equipment_capture_deadline_ns: int,
    ) -> None:
        if (
            bool(getattr(self, "closing", False))
            or not bool(
                getattr(self, "auto_upload_combat_records_enabled", True)
            )
        ):
            return
        record = self._history_record_for_upload(battle_id)
        if not isinstance(record, dict):
            record = fallback_record
        if not self._automatic_upload_needs_update(battle_id, record):
            return
        enriched = self._attach_pve_equipment_snapshots(
            record,
            capture_deadline_ns=equipment_capture_deadline_ns,
        )
        if enriched is not record:
            record = enriched
            store = getattr(self, "history_store", None)
            save = getattr(store, "save", None)
            if callable(save):
                try:
                    save(record)
                except (OSError, TypeError, ValueError):
                    pass

        missing_tokens = self._missing_upload_equipment_tokens(record)
        schedule = getattr(self, "_schedule_team_equipment_profiles", None)
        if missing_tokens and callable(schedule):
            schedule(extra_attempt_tokens=missing_tokens)
        requested_at = getattr(self, "team_equipment_requested_at", {})
        pending_tokens = (
            missing_tokens.intersection(requested_at)
            if isinstance(requested_at, dict)
            else set()
        )
        if pending_tokens and time.monotonic() < equipment_deadline:
            after = getattr(getattr(self, "root", None), "after", None)
            if callable(after):
                try:
                    after(
                        AUTOMATIC_UPLOAD_EQUIPMENT_POLL_MS,
                        lambda: self._continue_automatic_victory_upload(
                            battle_id,
                            record,
                            equipment_deadline,
                            equipment_capture_deadline_ns,
                        ),
                    )
                    return
                except tk.TclError:
                    pass
        self._start_automatic_history_upload(battle_id)

    @staticmethod
    def _history_detail_signature(record: dict) -> str:
        monster = record.get('monster')
        monster = monster if isinstance(monster, dict) else {}
        details = {
            'outcome': {
                'result': normalize_battle_result(record),
                'archive_reason': str(record.get('archive_reason', '') or ''),
                'completion_confirmed': bool(record.get('completion_confirmed')),
                'monster': {
                    key: monster.get(key)
                    for key in ('template_id', 'current_hp', 'max_hp')
                },
            }
        }
        details.update({
            key: record[key] for key in (
                'event_log', 'skill_cast_log', 'boss_hp_damage_samples',
                'team_damage_samples', 'display_team_dps_samples',
                'participant_damage_samples', 'team_dps_timeline',
            ) if record.get(key)
        })
        participant_details = ('skills', 'extraordinary_rating', 'equipment_snapshot')
        for field in ('participants', 'healers', 'damage_taken'):
            rows = [
                {'actor_id': row.get('actor_id'), **{
                    key: row[key] for key in participant_details if row.get(key)
                }}
                for row in record.get(field, ())
                if isinstance(row, dict) and any(row.get(key) for key in participant_details)
            ]
            if rows:
                details[field] = rows
        if not details:
            return ''
        return hashlib.sha256(json.dumps(
            details, sort_keys=True, separators=(',', ':'),
        ).encode('utf-8')).hexdigest()

    def _automatic_upload_needs_update(self, battle_id: str, record: dict) -> bool:
        state = self._history_upload_state(battle_id)
        status = str(state.get('state', 'pending') or 'pending').casefold()
        if status == 'pending':
            return True
        signature = self._history_detail_signature(record)
        return bool(
            status in {'uploaded', 'included', 'ranked'}
            and signature
            and signature != state.get('detail_signature', '')
        )

    def _queue_automatic_victory_upload(self, record: object) -> bool:
        """Upload a saved, decided PvE battle once outside combat handling."""

        if (
            not isinstance(record, dict)
            or not bool(
                getattr(self, "auto_upload_combat_records_enabled", True)
            )
            or encounter_upload_rejection_code(record)
            or (
                str(record.get("settlement_status", "")).upper() == "PENDING"
                and normalize_battle_result(record) != RESULT_FAILED
            )
            or bool(getattr(self, "closing", False))
        ):
            return False
        battle_id = str(record.get("encounter_id", "") or "").strip()
        if not battle_id:
            return False
        if not self._automatic_upload_needs_update(battle_id, record):
            return False
        queued = getattr(self, "automatic_upload_queued", None)
        if not isinstance(queued, set):
            queued = set()
            self.automatic_upload_queued = queued
        if (
            battle_id in queued
            or battle_id in getattr(self, "history_upload_in_progress", set())
        ):
            return False
        after = getattr(getattr(self, "root", None), "after", None)
        if not callable(after):
            return False
        queued.add(battle_id)
        try:
            equipment_deadline = (
                time.monotonic() + AUTOMATIC_UPLOAD_EQUIPMENT_WAIT_SECONDS
            )
            equipment_capture_deadline_ns = time.time_ns() + int(
                AUTOMATIC_UPLOAD_EQUIPMENT_WAIT_SECONDS * 1_000_000_000
            )
            after(
                0,
                lambda selected_id=battle_id, saved_record=record: (
                    self._continue_automatic_victory_upload(
                        selected_id,
                        saved_record,
                        equipment_deadline,
                        equipment_capture_deadline_ns,
                    )
                ),
            )
        except tk.TclError:
            queued.discard(battle_id)
            return False
        return True

    def _sync_settlement_history_for_upload(self, adapter, tracker) -> set[str]:
        """Observe saved history without changing matching or settlement logic."""

        self._enrich_settlement_ratings_from_live_profiles(tracker)
        model = getattr(self, 'model', None)
        local_id = str(getattr(model, 'encounter_id', '') or '')
        tracked_id = getattr(adapter, 'local_bindings', {}).get(local_id)
        encounter = tracker.encounters.get(tracked_id) if hasattr(tracker, 'encounters') else None
        build_record = getattr(model, 'build_combat_record', None)
        if encounter is not None and encounter.ended_at_ns is not None and callable(build_record):
            local_record = build_record('target_defeated' if encounter.result == 'VICTORY' else 'party_wipe')
            if isinstance(local_record, dict):
                projected = adapter.project_local_record(tracker, local_record)
                if projected is not None:
                    self.history_store.save(projected)
                    self._queue_automatic_victory_upload(projected)
        saved_ids = adapter.sync(tracker)
        store = getattr(self, "history_store", None)
        load = getattr(store, "load", None)
        for saved_id in saved_ids:
            if callable(load):
                record = load(saved_id)
                if isinstance(record, dict):
                    enriched = self._attach_pve_equipment_snapshots(record)
                    if enriched is not record:
                        store.save(enriched)
            self._queue_automatic_victory_upload(
                self._history_record_for_upload(saved_id)
            )
        return saved_ids

    def _enrich_settlement_ratings_from_live_profiles(self, tracker) -> bool:
        """Persist verified live scores before projecting a settlement.

        Older encounters can have a complete damage table while their start
        roster was captured before a teammate's score packet. Keep the score
        attached to the exact actor/token pair so later history renders do not
        depend on the live party still being present.
        """

        model = getattr(self, "model", None)
        ratings = getattr(model, "entity_extraordinary_ratings", {})
        if not isinstance(ratings, dict):
            return False
        controller = getattr(self, "settlement_ui", None)
        session_ids = set(getattr(controller, "session_encounter_ids", ()))
        if not session_ids:
            return False
        changed_any = False
        for encounter in tracker.encounters.values():
            if encounter.local_encounter_id not in session_ids:
                continue
            changed = False
            for identity in encounter.participants_snapshot:
                try:
                    actor_id = int(identity.get("iid") or 0)
                except (TypeError, ValueError, OverflowError):
                    actor_id = 0
                rating = normalize_extraordinary_rating(ratings.get(actor_id))
                if rating is None:
                    continue
                if normalize_extraordinary_rating(
                    identity.get("extraordinary_rating")
                ) is None:
                    identity["extraordinary_rating"] = rating
                    changed = True
                token = str(identity.get("id") or "")
                for participant in encounter.participants:
                    if str(participant.get("id") or "") == token:
                        persisted_rating = normalize_extraordinary_rating(
                            identity.get("extraordinary_rating")
                        )
                        if normalize_extraordinary_rating(
                            participant.get("extraordinary_rating")
                        ) is None:
                            participant["extraordinary_rating"] = persisted_rating
                            changed = True
                        break
            if changed:
                encounter.revision += 1
                changed_any = True
        if changed_any and controller is not None:
            controller.repository.save(tracker)
        return changed_any

    def _attach_pve_equipment_snapshots(
        self,
        record: dict,
        *,
        capture_deadline_ns: int = 0,
    ) -> dict:
        """Attach same-character gear captured by the official settlement edge."""

        try:
            ended_ns = int(float(record.get("ended_at_epoch") or 0) * 1e9)
        except (TypeError, ValueError, OverflowError):
            return record
        if ended_ns <= 0:
            return record
        try:
            settlement_ns = int(
                float(record.get("settlement_received_at") or 0) * 1e9
            )
        except (TypeError, ValueError, OverflowError):
            settlement_ns = 0
        # Delayed PVE statistics are often received only after the next Boss
        # starts. A correlated equipment response can therefore be newer than
        # the damage end while still predating the authoritative settlement.
        # UID and exact rating remain mandatory below, so this does not attach
        # arbitrary current gear to an older fight.
        snapshot_cutoff_ns = max(ended_ns, settlement_ns)
        try:
            automatic_upload_cutoff_ns = max(0, int(capture_deadline_ns or 0))
        except (TypeError, ValueError, OverflowError):
            automatic_upload_cutoff_ns = 0

        def valid_snapshot(value: object, expected_rating: object, token: str) -> dict | None:
            if not isinstance(value, dict):
                return None
            snapshot_token = str(
                value.get("user_token") or value.get("character_id") or ""
            ).strip()
            if snapshot_token and snapshot_token != token:
                return None
            try:
                captured_ns = int(value.get("captured_at_ns") or 0)
            except (TypeError, ValueError, OverflowError):
                return None
            expected = normalize_extraordinary_rating(expected_rating)
            captured = normalize_extraordinary_rating(
                value.get("extraordinary_rating")
            )
            allowed_cutoff_ns = max(
                snapshot_cutoff_ns,
                automatic_upload_cutoff_ns if expected is not None else 0,
            )
            if captured_ns <= 0 or captured_ns > allowed_cutoff_ns:
                return None
            if expected is not None and captured != expected:
                return None
            if captured_ns > ended_ns and expected is None:
                return None
            equipment = value.get("equipment")
            if not isinstance(equipment, list) or not equipment:
                return None
            return value

        profiles = getattr(self, "team_equipment_profiles", None)
        profiles = profiles if isinstance(profiles, dict) else {}
        model_actor_tokens = getattr(
            getattr(self, "model", None), "actor_character_ids", {}
        )
        actor_tokens = (
            dict(model_actor_tokens)
            if isinstance(model_actor_tokens, dict)
            else {}
        )
        identities = record.get("participant_identities")
        if not isinstance(identities, list):
            identities = record.get("participants_snapshot")
        if isinstance(identities, list):
            for identity in identities:
                if not isinstance(identity, dict):
                    continue
                try:
                    actor_id = int(
                        identity.get("actor_id") or identity.get("iid") or 0
                    )
                except (TypeError, ValueError, OverflowError):
                    continue
                token = str(
                    identity.get("character_id")
                    or identity.get("user_token")
                    or identity.get("id")
                    or ""
                ).strip()
                if actor_id and token:
                    actor_tokens[actor_id] = token
        self_character_id = str(record.get("self_character_id") or "").strip()
        resolved_snapshots: dict[tuple[str, int | None], dict | None] = {}
        changed = False
        result = dict(record)
        for collection in ("participants", "healers", "damage_taken"):
            rows = record.get(collection)
            if not isinstance(rows, list):
                continue
            updated = []
            for row in rows:
                if not isinstance(row, dict):
                    updated.append(row)
                    continue
                token = str(
                    row.get("user_token")
                    or row.get("character_id")
                    or actor_tokens.get(row.get("actor_id"))
                    or (self_character_id if row.get("is_self") is True else "")
                    or ""
                ).strip()
                if not token:
                    updated.append(row)
                    continue
                expected_rating = row.get("extraordinary_rating")
                if row.get("equipment_snapshot"):
                    snapshot = valid_snapshot(row["equipment_snapshot"], expected_rating, token)
                    rating = normalize_extraordinary_rating(
                        snapshot.get("extraordinary_rating") if snapshot else None
                    )
                    if normalize_extraordinary_rating(expected_rating) is None and rating is not None:
                        updated.append({**row, "user_token": token, "extraordinary_rating": rating})
                        changed = True
                    else:
                        updated.append(row)
                    continue
                snapshot_key = (token, normalize_extraordinary_rating(expected_rating))
                if snapshot_key not in resolved_snapshots:
                    profile = profiles.get(token)
                    snapshot = valid_snapshot(
                        (
                            profile.get("equipment_snapshot")
                            if isinstance(profile, dict)
                            else None
                        ),
                        expected_rating,
                        token,
                    )
                    resolved_snapshots[snapshot_key] = (
                        snapshot if isinstance(snapshot, dict) else None
                    )
                snapshot = resolved_snapshots.get(snapshot_key)
                if not isinstance(snapshot, dict):
                    updated.append(row)
                    continue
                enriched_row = {
                    **row,
                    "equipment_snapshot": deepcopy(snapshot),
                }
                if not str(row.get("user_token") or "").strip():
                    enriched_row["user_token"] = token
                rating = normalize_extraordinary_rating(snapshot.get("extraordinary_rating"))
                if normalize_extraordinary_rating(expected_rating) is None and rating is not None:
                    enriched_row["extraordinary_rating"] = rating
                updated.append(enriched_row)
                changed = True
            result[collection] = updated
        return result if changed else record

    def _save_combat_history_record(self, record: dict) -> bool:
        try:
            enriched_record = dict(record)
            enriched_record.pop("_shared_clock_request", None)
            capture_snapshot = self.worker.diagnostic_snapshot()
            enriched_record["capture_pipeline_at_archive"] = capture_snapshot
            for record_key, capture_key in (
                ("dungeon_id", "dungeon_id"),
                ("map_id", "map_id"),
                ("dungeon_stage_id", "dungeon_stage_id"),
                ("dungeon_stage_phase", "dungeon_stage_phase"),
                ("dungeon_context_filetime", "dungeon_context_filetime"),
            ):
                try:
                    existing_value = int(enriched_record.get(record_key, 0) or 0)
                    capture_value = int(capture_snapshot.get(capture_key, 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    continue
                if not existing_value and capture_value:
                    enriched_record[record_key] = capture_value
                    enriched_record["dungeon_context_source"] = (
                        "explicit_protocol_fields_at_archive"
                    )
            current_brass_status = str(
                enriched_record.get("brass_tome_status", "unknown") or "unknown"
            ).casefold()
            capture_brass_status = str(
                capture_snapshot.get("brass_tome_status", "unknown") or "unknown"
            ).casefold()
            if (
                current_brass_status not in {"enabled", "disabled"}
                and capture_brass_status in {"enabled", "disabled"}
            ):
                def context_id(value: object) -> int:
                    try:
                        return max(0, int(value or 0))
                    except (TypeError, ValueError, OverflowError):
                        return 0

                record_dungeon_id = context_id(
                    enriched_record.get("dungeon_id")
                )
                record_map_id = context_id(enriched_record.get("map_id"))
                capture_dungeon_id = context_id(
                    capture_snapshot.get("dungeon_id")
                )
                capture_map_id = context_id(capture_snapshot.get("map_id"))
                same_dungeon_context = bool(
                    capture_snapshot.get("in_dungeon") is True
                    and (record_dungeon_id > 0 or record_map_id > 0)
                    and (
                        record_dungeon_id <= 0
                        or record_dungeon_id == capture_dungeon_id
                    )
                    and (record_map_id <= 0 or record_map_id == capture_map_id)
                )
                if capture_brass_status == "enabled" or same_dungeon_context:
                    enriched_record["brass_tome_status"] = capture_brass_status
                    enriched_record["brass_tome_enabled"] = (
                        capture_brass_status == "enabled"
                    )
                    raw_ids = capture_snapshot.get("brass_tome_challenge_ids")
                    if isinstance(raw_ids, list):
                        enriched_record["brass_tome_challenge_ids"] = list(raw_ids)
                    enriched_record["brass_tome_source"] = str(
                        capture_snapshot.get("dungeon_context_source", "") or ""
                    )
            adapter = getattr(self, "settlement_history_adapter", None)
            controller = getattr(self, "settlement_ui", None)
            if (
                IS_PASSIVE_PROTOCOL_ADAPTER
                and adapter is not None
                and controller is not None
            ):
                projected = adapter.project_local_record(
                    controller.tracker, enriched_record
                )
                if projected is not None:
                    enriched_record = projected
            enriched_record = self._attach_pve_equipment_snapshots(enriched_record)
            self.history_store.save(enriched_record)
            self._queue_automatic_victory_upload(enriched_record)
            return True
        except (OSError, ValueError, TypeError):
            return False

    def _handle_combat_clock_result(self, result: CombatClockResult) -> None:
        self.model.apply_combat_clock(result)
        if not result.final:
            return
        pending = self.pending_clock_records.get(result.encounter_id)
        if pending is None:
            return
        record, _deadline, _fallback_saved = pending
        updated = apply_combat_clock_to_record(record, result)
        shared_clock = updated.get("shared_clock")
        if not (
            str(updated.get("duration_source", "")) == "server_shared_clock"
            and isinstance(shared_clock, dict)
            and bool(shared_clock.get("accepted"))
        ):
            return
        self.pending_clock_records.pop(result.encounter_id, None)
        if not self._save_combat_history_record(updated):
            self.model.completed_combats.append(updated)
            return

    def _flush_combat_history(self, *, force: bool = False) -> int:
        records = self.model.pop_completed_combats()
        saved = 0
        failed: list[dict] = []
        now = time.monotonic()
        worker = self.combat_clock_worker
        for record in records:
            self._remember_main_battle_result(record)
            encounter_id = str(record.get("encounter_id", "")).strip()
            clock_request = record.get("_shared_clock_request")
            game_clock_final = bool(
                str(record.get("duration_source", ""))
                == "game_server_team_clock"
            )
            if (
                game_clock_final
                and isinstance(clock_request, dict)
                and worker is not None
                and worker.is_alive()
            ):
                # The game settlement remains authoritative locally, but its
                # final report lets teammates close the same shared clock.
                worker.submit(clock_request)
                self.pending_clock_records.pop(encounter_id, None)
            if encounter_id and not isinstance(clock_request, dict):
                superseded = self.pending_clock_records.pop(
                    encounter_id, None
                )
                if superseded is not None and worker is not None:
                    worker.cancel(encounter_id)
            can_wait_for_clock = bool(
                not force
                and encounter_id
                and isinstance(clock_request, dict)
                and not game_clock_final
                and worker is not None
                and worker.is_alive()
            )
            if can_wait_for_clock:
                previous = self.pending_clock_records.get(encounter_id)
                if previous is None:
                    deadline = now + COMBAT_CLOCK_HISTORY_WAIT_SECONDS
                elif previous[2]:
                    # Late metadata replaced the already-saved fallback copy;
                    # persist the replacement in this same flush pass.
                    deadline = now
                else:
                    deadline = previous[1]
                self.pending_clock_records[encounter_id] = (
                    record,
                    deadline,
                    False,
                )
                worker.submit(clock_request)
                continue
            if self._save_combat_history_record(record):
                saved += 1
            else:
                failed.append(record)

        for encounter_id, (record, deadline, fallback_saved) in list(
            self.pending_clock_records.items()
        ):
            if not force and now < deadline:
                continue
            if fallback_saved or force:
                self.pending_clock_records.pop(encounter_id, None)
                if worker is not None:
                    worker.cancel(encounter_id)
                if force and not fallback_saved:
                    if self._save_combat_history_record(record):
                        saved += 1
                    else:
                        failed.append(record)
                continue
            if self._save_combat_history_record(record):
                saved += 1
                # Keep synchronization alive after the local fallback becomes
                # visible. A late party final can still overwrite this exact
                # encounter instead of leaving different clients forever.
                self.pending_clock_records[encounter_id] = (
                    record,
                    now + COMBAT_CLOCK_HISTORY_LATE_FINAL_SECONDS,
                    True,
                )
            else:
                self.pending_clock_records.pop(encounter_id, None)
                if worker is not None:
                    worker.cancel(encounter_id)
                failed.append(record)
        if failed:
            self.model.completed_combats.extend(failed)
        adapter = getattr(self, "settlement_history_adapter", None)
        controller = getattr(self, "settlement_ui", None)
        if adapter is not None and controller is not None and adapter.details_dirty:
            try:
                saved += len(self._sync_settlement_history_for_upload(adapter, controller.tracker))
            except (ValueError, OSError, TypeError) as error:
                controller.last_error = "战斗明细写入历史失败：" + type(error).__name__
        return saved

    def _ingest_stage_summary(self, payload: object) -> bool:
        if not isinstance(payload, dict):
            return False
        model_ingested = self.model.ingest_stage_summary(payload)
        wipe_attached = self.history_store.attach_exact_wipe_details(payload)
        attached = wipe_attached
        if not model_ingested and attached is None:
            attached = self.history_store.attach_stage_summary_validation(payload)
        if not model_ingested and attached is None:
            return False
        return True
























    def show_settings(self) -> None:
        if SETTINGS_TEMPORARILY_DISABLED or getattr(self, "closing", False):
            return
        if getattr(self, "hud_settings_open", False):
            self._close_hud_settings()
            return
        if self._layered_main_active():
            try:
                self.root.update_idletasks()
                anchor_x = int(self.root.winfo_x())
                anchor_y = int(self.root.winfo_y())
                self.hud_settings_restore_position = (anchor_x, anchor_y)
                self.hud_settings_anchor_bounds = (
                    anchor_x,
                    anchor_y,
                    max(1, int(self.root.winfo_width())),
                    max(1, int(self.root.winfo_height())),
                )
                self.hud_settings_work_area = monitor_work_area_for_widget(
                    self.root
                )
            except (AttributeError, TypeError, ValueError, tk.TclError):
                self.hud_settings_restore_position = None
                self.hud_settings_anchor_bounds = None
                self.hud_settings_work_area = None
        self.hud_settings_open = True
        self.hud_settings_page = 0
        self.layered_main_hover_action = ""
        self._schedule_layered_main_render(force=True)

    def _render_fallback_hud_settings(self) -> None:
        renderer = getattr(self, "layered_main_renderer", None)
        font_path = (
            str(renderer.font_paths["name"])
            if renderer is not None
            else str(Path(os.environ.get("WINDIR", r"C:\Windows")) / "Fonts" / "msyh.ttc")
        )
        scale = (float(getattr(self, "window_dpi", DEFAULT_DPI)) / DEFAULT_DPI) * float(
            getattr(self, "main_ui_scale", 1.0) or 1.0
        )
        image, regions = render_hud_settings(
            self._hud_settings_values(), self.hud_settings_page, font_path, scale
        )
        label = self.hud_settings_fallback_label
        if label is None:
            self.hud_settings_fallback_geometry = self.root.geometry()
            self.main_shell.pack_forget()
            label = tk.Label(self.root, bd=0, highlightthickness=0)
            label.bind("<ButtonRelease-1>", self._fallback_hud_settings_release)
            self.hud_settings_fallback_label = label
            label.pack(fill="both", expand=True)
        photo = ImageTk.PhotoImage(image, master=self.root)
        label.configure(image=photo)
        label.image = photo
        self.hud_settings_fallback_regions = regions
        self.root.geometry(f"{image.width}x{image.height}")

    def _fallback_hud_settings_release(self, event) -> str:
        for region, (left, top, right, bottom) in self.hud_settings_fallback_regions.items():
            if left <= event.x <= right and top <= event.y <= bottom:
                self._apply_hud_settings_action(region.removeprefix("action:"))
                break
        return "break"

    def _hud_settings_values(self) -> dict[str, object]:
        session = getattr(getattr(self, "licensing", None), "session", None)
        availability = membership_availability_text(
            getattr(session, "card_tier", "normal"),
            getattr(session, "expires_at", None),
        )
        expiry = availability[2:] if availability.startswith("至 ") else availability
        capturing = next((key for key, active in (
            ("visibility", self.toggle_hotkey_capture_active),
            ("view", self.hud_view_hotkey_capture_active),
            ("unlock", self.unlock_hotkey_capture_active),
        ) if active), "")
        return {
            "expiry": f"到期时间：{expiry}",
            "names": not self.hide_names,
            "rating": self.team_rating_preview_enabled,
            "deaths": self.show_deaths,
            "totals": self.show_main_totals,
            "team_dps": self.show_team_dps,
            "highlight": self.highlight_self,
            "time": self.show_combat_time,
            "boss_hp": self.show_boss_hp_bar,
            "enrage": self.boss_enrage_prediction_enabled,
            "upload": self.auto_upload_combat_records_enabled,
            "audience": self._profession_display_metric(AUDIENCE_PROFESSION_ID).upper(),
            "warrior": self._profession_display_metric(WARRIOR_PROFESSION_ID).upper(),
            "font": f"{self.ui_font_size}px",
            "scale": f"{round(self.main_ui_scale * 100)}%",
            "mask": f"{self.main_row_mask_opacity}%",
            "visibility_enabled": self.toggle_visibility_hotkey_enabled,
            "visibility_key": self.toggle_visibility_hotkey,
            "view_enabled": self.hud_view_hotkey_enabled,
            "view_key": self.hud_view_hotkey,
            "unlock_enabled": self.unlock_hotkey_enabled,
            "unlock_key": self.unlock_hotkey,
            "lock_toggle_enabled": self.lock_toggle_hotkey_enabled,
            "hover_action": getattr(self, "layered_main_hover_action", ""),
            "capturing": capturing,
            "status": (self.toggle_hotkey_error or self.hud_view_hotkey_error
                       or self.unlock_hotkey_error),
        }

    def _close_hud_settings(self) -> None:
        self._cancel_toggle_hotkey_capture()
        self._cancel_hud_view_hotkey_capture()
        self._cancel_unlock_hotkey_capture()
        self.hud_settings_open = False
        self.layered_main_hover_action = ""
        label = getattr(self, "hud_settings_fallback_label", None)
        if label is not None:
            label.destroy()
            self.hud_settings_fallback_label = None
            self.main_shell.pack(fill="both", expand=True)
            if self.hud_settings_fallback_geometry:
                self.root.geometry(self.hud_settings_fallback_geometry)
            self.hud_settings_fallback_geometry = None
        self._schedule_layered_main_render(force=True)

    def _hud_settings_key(self, event) -> str | None:
        if not getattr(self, "hud_settings_open", False):
            return None
        if self.toggle_hotkey_capture_active:
            result = self._capture_toggle_hotkey_key(event)
        elif self.hud_view_hotkey_capture_active:
            result = self._capture_hud_view_hotkey_key(event)
        elif self.unlock_hotkey_capture_active:
            result = self._capture_unlock_hotkey_key(event)
        elif str(getattr(event, "keysym", "")).casefold() == "escape":
            self._close_hud_settings()
            return "break"
        else:
            return None
        self._schedule_layered_main_render(force=True)
        return result

    def _hud_settings_key_release(self, event) -> str | None:
        if not getattr(self, "hud_settings_open", False):
            return None
        if self.toggle_hotkey_capture_active:
            return self._release_toggle_hotkey_modifier(event)
        if self.hud_view_hotkey_capture_active:
            return self._release_hud_view_hotkey_modifier(event)
        return None

    def _apply_hud_settings_action(self, action: str) -> None:
        if action == "settings_close":
            self._close_hud_settings()
            return
        if action.startswith("settings_page:"):
            self.hud_settings_page = max(0, min(2, int(action.rsplit(":", 1)[1])))
        elif action.startswith("settings_toggle:"):
            key = action.rsplit(":", 1)[1]
            hotkeys = {
                "visibility": ("toggle_visibility_hotkey_enabled", self._set_toggle_visibility_hotkey_enabled),
                "view": ("hud_view_hotkey_enabled", self._set_hud_view_hotkey_enabled),
                "unlock": ("unlock_hotkey_enabled", self._set_unlock_hotkey_enabled),
                "lock_toggle": ("lock_toggle_hotkey_enabled", self._set_lock_toggle_hotkey_enabled),
            }
            if key in hotkeys:
                attribute, setter = hotkeys[key]
                setter(not bool(getattr(self, attribute)))
            else:
                attributes = {
                    "rating": "team_rating_preview_enabled",
                    "deaths": "show_deaths", "totals": "show_main_totals",
                    "team_dps": "show_team_dps", "highlight": "highlight_self",
                    "time": "show_combat_time", "boss_hp": "show_boss_hp_bar",
                    "enrage": "boss_enrage_prediction_enabled",
                    "upload": "auto_upload_combat_records_enabled",
                }
                if key == "names":
                    self.hide_names = not self.hide_names
                elif key in attributes:
                    attribute = attributes[key]
                    enabled = not bool(getattr(self, attribute))
                    if key == "rating":
                        enabled = bool(TEAM_RATING_PREVIEW_AVAILABLE and enabled)
                    setattr(self, attribute, enabled)
                    if key == "enrage":
                        self.enrage_predictor.reset()
                        self.enrage_prediction = None
                        self._set_enrage_prediction_visible(False)
                    elif key == "upload" and not enabled:
                        self.automatic_upload_queued.clear()
                else:
                    return
                if key == "rating":
                    self._sync_team_rating_preview_layout(self._team_rating_preview_active())
                self._sync_main_component_visibility()
                self._save_preferences()
        elif action.startswith("settings_step:"):
            _prefix, key, direction_text = action.split(":", 2)
            direction = int(direction_text)
            if key in {"audience", "warrior"}:
                profession_id = (AUDIENCE_PROFESSION_ID if key == "audience"
                                 else WARRIOR_PROFESSION_ID)
                options = profession_metric_options(profession_id)
                current = self._profession_display_metric(profession_id)
                self.profession_display_metrics[str(profession_id)] = options[
                    (options.index(current) + direction) % len(options)
                ]
            elif key == "font":
                self.ui_font_size = min(18, max(12, self.ui_font_size + direction))
                self._configure_ui_fonts()
                self._refresh_main_scale_layout()
            elif key == "scale":
                self.main_ui_scale = clamp_main_ui_scale(
                    round(self.main_ui_scale * 100 + 10 * direction) / 100
                )
                self._refresh_main_scale_layout()
            elif key == "mask":
                self.main_row_mask_opacity = clamp_percent(
                    self.main_row_mask_opacity + 10 * direction, 0
                )
            else:
                return
            self._save_preferences()
        elif action.startswith("settings_capture:"):
            key = action.rsplit(":", 1)[1]
            starters = {
                "visibility": self._begin_toggle_hotkey_capture,
                "view": self._begin_hud_view_hotkey_capture,
                "unlock": self._begin_unlock_hotkey_capture,
            }
            if key not in starters:
                return
            self._cancel_toggle_hotkey_capture()
            self._cancel_hud_view_hotkey_capture()
            self._cancel_unlock_hotkey_capture()
            starters[key]()
            self.root.focus_force()
        elif action.startswith("settings_clear:"):
            key = action.rsplit(":", 1)[1]
            clearers = {
                "visibility": self._clear_toggle_visibility_hotkey,
                "view": self._clear_hud_view_hotkey,
                "unlock": self._clear_unlock_hotkey,
            }
            if key not in clearers:
                return
            clearers[key]()
        else:
            return
        self._schedule_layered_main_render(force=True)
































    def _freeze_model_for_victory_settlement(self, controller) -> bool:
        """Apply an accepted victory boundary to the live Boss snapshot.

        The passive settlement stream can arrive after the model has already
        archived the pull (and after ``tracker.current_id`` became ``None``).
        In that ordering the old transition-only path never called
        ``freeze_verified_encounter`` and a stale positive CurrentHP remained
        on the HUD.  Use the explicit local binding so a delayed result can
        update only its own pull; never freeze a newer Boss.
        """

        adapter = getattr(self, "settlement_history_adapter", None)
        tracker = getattr(controller, "tracker", None)
        model = getattr(self, "model", None)
        bindings = getattr(adapter, "local_bindings", None)
        freezer = getattr(model, "freeze_verified_encounter", None)
        encounters = getattr(tracker, "encounters", None)
        model_id = str(getattr(model, "encounter_id", "") or "").strip()
        if (
            tracker is None
            or not isinstance(bindings, dict)
            or not isinstance(encounters, dict)
            or not callable(freezer)
            or not model_id
        ):
            return False
        tracked_id = str(bindings.get(model_id, "") or "").strip()
        encounter = encounters.get(tracked_id)
        if (
            encounter is None
            or str(getattr(encounter, "result", "") or "").upper()
            != "VICTORY"
            or getattr(encounter, "ended_at_ns", None) is None
        ):
            return False
        try:
            return bool(
                freezer(
                    encounter.ended_at_ns,
                    "VICTORY",
                )
            )
        except (TypeError, ValueError, OverflowError, AttributeError):
            return False

    def _handle_settlement_observation(self, payload) -> None:
        controller = getattr(self, 'settlement_ui', None)
        if controller is None or not isinstance(payload, dict):
            return
        before_ids = set(controller.tracker.encounters)
        before_states = {
            encounter_id: (
                encounter.result,
                encounter.ended_at_ns,
                encounter.settlement_status,
            )
            for encounter_id, encounter in controller.tracker.encounters.items()
        }
        previous_current_id = controller.tracker.current_id
        previous_current = controller.tracker.encounters.get(
            previous_current_id
        )
        try:
            changed = controller.process(payload)
        except (ValueError, KeyError, TypeError, OSError) as error:
            controller.last_error = '战后统计保存失败：' + type(error).__name__
            self.status_label.configure(text=controller.last_error)
            return
        matcher_diagnostics = controller.tracker.take_accept_diagnostics()
        experiment = getattr(self, 'settlement_experiment', None)
        if experiment is not None and experiment.enabled:
            for encounter_id in set(controller.tracker.encounters) - before_ids:
                encounter = controller.tracker.encounters.get(encounter_id)
                if encounter is not None:
                    experiment.encounter_started(encounter)
            for encounter_id, encounter in controller.tracker.encounters.items():
                previous = before_states.get(encounter_id)
                if (
                    previous is not None
                    and previous[1] is None
                    and encounter.ended_at_ns is not None
                    and encounter.result in {'VICTORY', 'WIPE'}
                ):
                    if experiment.encounter_ended(encounter):
                        self.root.after(
                            IMMEDIATE_QUERY_DELAY_MS,
                            lambda target_id=encounter_id: (
                                self._try_immediate_settlement_query(target_id)
                            ),
                        )
            experiment.matcher_events(
                matcher_diagnostics,
                encounters=controller.tracker.encounters,
            )
        # The statistics packet may be the first packet that exposes the
        # tracker binding in a sparse capture.  Establish it before trying to
        # freeze the model, while the tracker still has the live encounter.
        self._bind_active_settlement_history()
        model_frozen = self._freeze_model_for_victory_settlement(controller)
        if changed:
            if controller.tracker.current_id != previous_current_id:
                self.main_scroll_offset = 0
            adapter = getattr(self, 'settlement_history_adapter', None)
            ended_record = (
                controller.tracker.encounters.get(previous_current_id)
                if previous_current_id
                else None
            )
            if (
                previous_current is not None
                and ended_record is not None
                and previous_current_id != controller.tracker.current_id
                and ended_record.ended_at_ns is not None
                and ended_record.result in {'VICTORY', 'WIPE'}
                and adapter is not None
            ):
                local_model_id = str(
                    getattr(self.model, 'encounter_id', '') or ''
                )
                bound_id = str(
                    getattr(adapter, 'local_bindings', {}).get(
                        local_model_id, ''
                    )
                    or ''
                )
                freezer = getattr(
                    self.model, 'freeze_verified_encounter', None
                )
                if bound_id == previous_current_id and callable(freezer):
                    model_frozen = bool(
                        freezer(
                            ended_record.ended_at_ns,
                            ended_record.result,
                        )
                    ) or model_frozen
            if adapter is not None:
                try:
                    self._sync_settlement_history_for_upload(
                        adapter, controller.tracker
                    )
                except (ValueError, OSError, TypeError) as error:
                    controller.last_error = (
                        '战后统计写入原历史失败：' + type(error).__name__
                    )
                    self.status_label.configure(text=controller.last_error)
                    return
            if model_frozen:
                self._flush_combat_history()
            self._schedule_layered_main_render()
        elif model_frozen:
            self._flush_combat_history()
            self._schedule_layered_main_render()

    def _try_immediate_settlement_query(self, encounter_id: str) -> None:
        """Submit the experiment's sole wipe query without changing PENDING."""

        experiment = getattr(self, 'settlement_experiment', None)
        controller = getattr(self, 'settlement_ui', None)
        if (
            experiment is None
            or not experiment.enabled
            or not experiment.query_enabled
            or controller is None
        ):
            return
        target_id = str(encounter_id or '')
        encounter = controller.tracker.encounters.get(target_id)
        if encounter is None:
            experiment.skip_query(target_id, 'ENCOUNTER_MISSING')
            return
        if encounter.settlement_status == 'SETTLED':
            experiment.skip_query(target_id, 'ALREADY_SETTLED')
            return
        if (
            encounter.result != 'WIPE'
            or encounter.settlement_status != 'PENDING'
        ):
            experiment.skip_query(target_id, 'NOT_PENDING_WIPE')
            return
        if controller.tracker.current_id:
            experiment.skip_query(target_id, 'NEW_ENCOUNTER_STARTED')
            return
        worker = getattr(self, 'worker', None)
        submit = getattr(worker, 'request_immediate_settlement', None)
        if worker is None or not worker.is_alive() or not callable(submit):
            experiment.skip_query(target_id, 'CAPTURE_WORKER_UNAVAILABLE')
            return
        if not experiment.query_submitted(target_id):
            return
        if not submit(
            {
                'local_encounter_id': target_id,
                'ended_at_ns': int(encounter.ended_at_ns or 0),
                'expected_battle_id': encounter.server_battle_id,
            }
        ):
            experiment.query_event(
                {
                    'event': 'error',
                    'local_encounter_id': target_id,
                    'failure': 'QUERY_QUEUE_REJECTED',
                }
            )

    def _bind_active_settlement_history(self) -> bool:
        """Keep the live model and settings history on one battle ID."""
        controller = getattr(self, "settlement_ui", None)
        adapter = getattr(self, "settlement_history_adapter", None)
        model = getattr(self, "model", None)
        if controller is None or adapter is None or model is None:
            return False
        tracked_id = str(controller.tracker.current_id or "").strip()
        local_id = str(getattr(model, "encounter_id", "") or "").strip()
        started = getattr(model, "_encounter_started", None)
        if (
            not tracked_id
            or not local_id
            or not callable(started)
            or not started()
        ):
            return False
        encounter = controller.tracker.encounters.get(tracked_id)
        context_changed = False
        if encounter is not None:
            for encounter_field, model_field in (
                ("dungeon_id", "encounter_dungeon_id"),
                ("map_id", "encounter_map_id"),
                ("stage_id", "encounter_dungeon_stage_id"),
                ("stage_index", "encounter_dungeon_stage_phase"),
            ):
                try:
                    value = int(getattr(model, model_field, 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    value = 0
                if getattr(encounter, encounter_field, None) is None and value > 0:
                    setattr(encounter, encounter_field, value)
                    context_changed = True
            if context_changed:
                encounter.revision += 1
                controller.repository.save(controller.tracker)
        return bool(adapter.bind(local_id, tracked_id) or context_changed)

    def _ingest_combat_state(self, payload: object) -> bool:
        if not isinstance(payload, dict):
            return False
        changed = bool(self.model.ingest_combat_state(payload))
        self._bind_active_settlement_history()
        return changed

    def _ingest_monster_update(self, payload: object) -> bool:
        if not isinstance(payload, dict):
            return False
        controller = getattr(self, "settlement_ui", None)
        observer = getattr(controller, "observe_boss_health", None)
        history_changed = bool(observer(payload)) if callable(observer) else False
        changed = bool(self.model.ingest_monster(payload))
        self._bind_active_settlement_history()
        if history_changed:
            adapter = getattr(self, "settlement_history_adapter", None)
            if adapter is not None:
                try:
                    self._sync_settlement_history_for_upload(
                        adapter, controller.tracker
                    )
                except (ValueError, OSError, TypeError) as error:
                    controller.last_error = (
                        "战后 Boss 血量写入历史失败：" + type(error).__name__
                    )
        return changed or history_changed

    def _main_live_self_dps_row(
        self, now=None, *, profession_id=None, metric_dps=None
    ):
        """Project only the local player's verified live values for the HUD."""
        model = self.model
        self_id = getattr(model, "self_id", None)
        if self_id is None:
            return None
        try:
            self_id = int(self_id)
        except (TypeError, ValueError, OverflowError):
            return None
        current_stats = getattr(model, "current_stats", None)
        damage_row = next(
            (
                row
                for row in (current_stats() if callable(current_stats) else ())
                if int(getattr(row, "actor_id", 0) or 0) == self_id
            ),
            None,
        )
        duration_reader = getattr(model, "duration", None)
        try:
            raw_duration = duration_reader(now) if callable(duration_reader) else 0
        except TypeError:
            raw_duration = duration_reader() if callable(duration_reader) else 0
        duration = dps_duration_seconds(raw_duration)
        dummy_total_reader = getattr(model, "dummy_display_damage", None)
        dummy_total = (
            dummy_total_reader() if callable(dummy_total_reader) else None
        )
        total = (
            int(dummy_total)
            if dummy_total is not None
            else int(damage_row.damage)
            if damage_row is not None
            else None
        )
        rate = float(total) / duration if total is not None and duration else None
        profession_reader = getattr(model, "actor_profession_id", None)
        profession_id = int(
            (profession_reader(self_id) if callable(profession_reader) else 0)
            or profession_id or 0
        )
        metric = self._main_player_display_metric(
            profession_id, rate if metric_dps is None else metric_dps
        )
        shown_total, shown_rate = total, rate
        if metric == "hps":
            healing_reader = getattr(model, "healing_summary", None)
            healing = (
                healing_reader(raw_duration)
                if callable(healing_reader)
                else getattr(self, "latest_healing_summary", {})
            )
            healer = next(
                (row for row in healing.get("healers", ())
                 if int(row.get("actor_id", 0) or 0) == self_id),
                {},
            )
            shown_total = healer.get("effective_healing")
            shown_rate = (
                float(shown_total) / duration
                if shown_total is not None and duration else None
            )
        elif metric == "dt":
            taken_reader = getattr(model, "current_taken_rows", None)
            taken = next(
                (row for row in (taken_reader() if callable(taken_reader) else ())
                 if int(row.get("actor_id", 0) or 0) == self_id),
                {},
            )
            shown_total = taken.get("taken")
            shown_rate = (
                float(shown_total) / duration
                if shown_total is not None and duration else None
            )
        deaths = getattr(model, "member_death_counts", {})
        shown_name = str(self._shown_actor_name(self_id) or "").strip() or "本人"
        rating = self._main_extraordinary_rating(self_id)
        return {
            "actor_id": self_id,
            "profession_id": profession_id,
            "name": shown_name,
            "metric": metric,
            "stat_value": shown_rate,
            "total_value": shown_total,
            "dps_value": rate,
            "damage_sort": total or 0,
            "deaths": int(deaths.get(self_id, 0) or 0),
            "is_self": True,
            "is_live_self": True,
            "interactive": True,
            "rating": rating,
            "rating_text": "--" if rating is None else str(rating),
            "inline_rating_text": str(rating) if rating is not None else "",
            "is_ai": self._main_actor_is_ai(self_id),
        }

    def _main_current_live_self_dps_row(
        self, now=None, *, profession_id=None, metric_dps=None
    ):
        """Return the local live row only when it belongs to the current fight."""

        segment = self._main_live_hud_dps_segment_state(now)
        if isinstance(segment, dict):
            if not segment.get("active"):
                return None
            try:
                started_at = float(segment.get("started_at_epoch", 0.0) or 0.0)
            except (TypeError, ValueError, OverflowError):
                return None
        else:
            return None

        row = self._main_live_self_dps_row(
            now, profession_id=profession_id, metric_dps=metric_dps
        )
        if row is None or row.get("total_value") is None:
            return None
        if started_at <= 0:
            return row

        metric = row.get("metric")
        if metric == "dps":
            if not hasattr(self.model, "last_damage_time"):
                return row
            event_at = getattr(self.model, "last_damage_time", 0.0)
        elif metric == "hps":
            if not hasattr(self.model, "last_healing_time"):
                return row
            event_at = getattr(self.model, "last_healing_time", 0.0)
        else:
            if not hasattr(self.model, "last_damage_time") and not hasattr(
                self.model, "last_healing_time"
            ):
                return row
            event_at = max(
                getattr(self.model, "last_damage_time", 0.0) or 0.0,
                getattr(self.model, "last_healing_time", 0.0) or 0.0,
            )
        try:
            event_at = float(event_at or 0.0)
        except (TypeError, ValueError, OverflowError):
            return None
        return row if math.isfinite(event_at) and event_at >= started_at else None

    def _main_small_monster_self_hps(self, now, team_self):
        """Return the local HPS carried by the current small-monster counter."""

        segment = self._main_live_hud_dps_segment_state(now)
        if not isinstance(segment, dict) or segment.get("kind") != "small_monsters":
            return None
        try:
            actor_id = int(team_self.get("actor_id", 0) or 0)
        except (AttributeError, TypeError, ValueError, OverflowError):
            return 0, 0.0
        states = getattr(self.model, "team_healing_states", {})
        healing_state = states.get(actor_id) if isinstance(states, dict) else None
        counters = segment.get("counter_states", {})
        counter = next(
            (
                state
                for state in counters.values()
                if isinstance(state, dict)
                and int(state.get("actor_id", 0) or 0) == actor_id
            ),
            None,
        ) if isinstance(counters, dict) else None

        total = 0
        if healing_state is not None:
            healing_epoch = int(getattr(healing_state, "server_time", 0) or 0)
            counter_epoch = int(counter.get("server_time", 0) or 0) if counter else 0
            if counter_epoch and healing_epoch == counter_epoch:
                total = max(0, int(getattr(healing_state, "last_absolute", 0) or 0))
            elif bool(getattr(healing_state, "exact_for_encounter", False)):
                total = max(
                    0,
                    int(
                        getattr(
                            healing_state, "accepted_effective_healing", 0
                        )
                        or 0
                    ),
                )
        try:
            duration = float(counter.get("duration", 0.0) or 0.0) if counter else 0.0
            if duration <= 0:
                duration = float(segment.get("snapshot_duration", 0.0) or 0.0)
        except (TypeError, ValueError, OverflowError):
            duration = 0.0
        duration = dps_duration_seconds(duration)
        return total, total / duration if duration else 0.0

    def _main_settlement_metric_values(self, member, duration, profession_id=None):
        """Select display values from one settlement, without changing its data."""
        metric = self._main_player_display_metric(
            member.get("profession_id") if profession_id is None else profession_id,
            member.get("dps"),
        )
        if metric == "dps":
            return metric, member.get("damage"), member.get("dps")
        total = member.get("heal" if metric == "hps" else "bear")
        rate = float(total) / duration if total is not None and duration else None
        return metric, total, rate

    def _settlement_record_main_rows(self, record) -> list[dict[str, object]]:
        statistics_scope = self._main_hud_statistics_scope(record)
        view = encounter_view(record, statistics_scope=statistics_scope)
        visible_tokens = set(visible_encounter_member_tokens(
            record, statistics_scope=statistics_scope
        ))
        rows: list[dict[str, object]] = []
        hidden = bool(getattr(self, "hide_names", False))
        for index, member in enumerate(view.get("members", ())):
            if member.get("id") not in visible_tokens:
                continue
            metric, total, rate = self._main_settlement_metric_values(
                member, view.get("duration_seconds")
            )
            server_name = str(member.get("name") or "").strip()
            actor_id = int(member.get("iid") or 0)
            rating = normalize_extraordinary_rating(
                member.get("extraordinary_rating")
            )
            if rating is None and actor_id:
                # Older settlement snapshots did not copy a teammate's
                # verified live score into the history identity. The actor
                # ID is stable for the current session, so use the live
                # profile as a display fallback without changing settlement
                # totals or damage attribution.
                rating = self._main_extraordinary_rating(actor_id, member)
            rows.append(
                {
                    "actor_id": actor_id,
                    "profession_id": int(member.get("profession_id") or 0),
                    "name": (
                        server_name
                        if server_name and not hidden
                        else f"玩家{index + 1}"
                    ),
                    "metric": metric,
                    "stat_value": rate,
                    # Show the matching official total; unavailable values
                    # stay blank instead of being fabricated as zero.
                    "total_value": total,
                    "dps_value": member.get("dps"),
                    "hide_total": False,
                    "damage_sort": int(member.get("damage") or 0),
                    "deaths": record.death_count(member["id"]),
                    "is_self": member.get("id") == record.self_token,
                    "highlight_self_row": False,
                    "interactive": False,
                    "is_recent_battle": True,
                    "settlement_status_text": member["status_text"],
                    "rating": rating,
                    "rating_text": (
                        "人机"
                        if bool(member.get("is_ai", False))
                        else "--" if rating is None else str(rating)
                    ),
                    "inline_rating_text": (
                        "人机"
                        if bool(member.get("is_ai", False))
                        else "" if rating is None else str(rating)
                    ),
                    "is_ai": bool(member.get("is_ai", False)),
                }
            )
        rows.sort(key=lambda row: -int(row.get("damage_sort", 0) or 0))
        return rows

    def _main_recent_settlement_record(
        self, *, keep_last_settled=True, settled_only=False
    ):
        """Return the exact ended record used by the recent-battle rows."""

        model = getattr(self, "model", None)
        try:
            party_session_id = max(
                0, int(getattr(model, "party_session_id", 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            party_session_id = 0
        controller = getattr(self, "settlement_ui", None)
        tracker = getattr(controller, "tracker", None)
        encounters = getattr(tracker, "encounters", None)
        if not isinstance(encounters, dict):
            return None
        current_id = getattr(tracker, "current_id", None)
        current = encounters.get(current_id)
        controller_instance = getattr(
            getattr(self, "settlement_ui", None), "instance_id", None
        )
        successor_instance = (
            getattr(current, "instance_id", None)
            if current is not None
            else controller_instance
        )
        successor_self_token = str(
            getattr(current, "self_token", "")
            if current is not None
            else getattr(model, "self_character_id", "")
            or ""
        ).strip()
        model_self_token = str(
            getattr(model, "self_character_id", "") or ""
        ).strip()
        if (
            model_self_token
            and successor_self_token
            and model_self_token != successor_self_token
        ):
            return None
        raw_session_ids = getattr(controller, "session_encounter_ids", None)
        session_encounter_ids = (
            set(raw_session_ids)
            if raw_session_ids is not None
            else set(encounters)
        )
        try:
            scope_started_ns = max(
                0,
                int(
                    getattr(
                        self, "main_recent_battle_scope_started_ns", 0
                    )
                    or 0
                ),
            )
        except (TypeError, ValueError, OverflowError):
            scope_started_ns = 0
        hidden_encounter_ids = set(
            getattr(self, "main_cleared_encounter_ids", ())
        )
        successor_instance_text = str(successor_instance or "")
        successor_uses_bootstrap_instance = successor_instance_text.startswith(
            "npcap-bootstrap:"
        )
        eligible = [
            encounter
            for encounter in encounters.values()
            if encounter.local_encounter_id in session_encounter_ids
            and encounter.local_encounter_id not in hidden_encounter_ids
            and (
                (
                    successor_instance
                    and (
                        str(getattr(encounter, "instance_id", "") or "")
                        == successor_instance_text
                        or (
                            successor_uses_bootstrap_instance
                            and str(
                                getattr(encounter, "instance_id", "") or ""
                            ).startswith("npcap-bootstrap:")
                            and int(encounter.started_at_ns) >= scope_started_ns
                        )
                    )
                    and str(getattr(encounter, "self_token", "") or "")
                    == successor_self_token
                )
                or (
                    not successor_instance
                    and int(encounter.started_at_ns) >= scope_started_ns
                    and int(getattr(encounter, "party_session_id", 0) or 0)
                    == party_session_id
                )
            )
            and encounter.local_encounter_id != current_id
            and encounter.ended_at_ns is not None
            and encounter.settlement_status != "ABANDONED"
            and not encounter.history_deleted
        ]
        if not eligible:
            return None

        if settled_only:
            eligible = [
                encounter for encounter in eligible
                if encounter.settlement_status == "SETTLED"
            ]
            if not eligible:
                return None

        def order_key(encounter):
            return (
                int(encounter.ended_at_ns or 0),
                int(encounter.started_at_ns),
            )

        latest = max(eligible, key=order_key)
        if latest.settlement_status == "SETTLED" or not keep_last_settled:
            return latest

        settled = [
            encounter
            for encounter in eligible
            if encounter.settlement_status == "SETTLED"
            and order_key(encounter) < order_key(latest)
        ]
        previous = max(settled, key=order_key, default=None)
        if previous is None:
            return latest

        try:
            latest_template = int(latest.boss_template_id or 0)
            previous_template = int(previous.boss_template_id or 0)
        except (TypeError, ValueError, OverflowError):
            latest_template = previous_template = 0
        if latest_template and previous_template:
            same_boss = bool(
                latest_template == previous_template
                or (previous_template, latest_template)
                in BOSS_PHASE_TEMPLATE_TRANSITIONS
                or (latest_template, previous_template)
                in BOSS_PHASE_TEMPLATE_TRANSITIONS
            )
        else:
            latest_token = str(latest.boss_token or "").strip()
            previous_token = str(previous.boss_token or "").strip()
            latest_name = normalize_boss_name(latest.boss_name)
            previous_name = normalize_boss_name(previous.boss_name)
            same_boss = bool(
                (latest_token and latest_token == previous_token)
                or (latest_name and latest_name == previous_name)
            )

        # During a repeated pull of the same Boss, retain its last complete
        # table until the delayed server settlement arrives.  A different Boss
        # must never inherit that table: show the new PENDING header and live
        # local rows instead of rolling the HUD back to the previous target.
        return previous if same_boss else latest

    def _main_pending_local_rows(self, record) -> list[dict[str, object]] | None:
        """Return exact frozen local rows for their bound pending encounter."""

        if record is None or record.settlement_status != "PENDING":
            return None
        retained = getattr(self, "main_last_battle_result", None)
        adapter = getattr(self, "settlement_history_adapter", None)
        bindings = getattr(adapter, "local_bindings", None)
        if not isinstance(retained, dict) or not isinstance(bindings, dict):
            return None
        local_id = str(retained.get("encounter_id") or "").strip()
        if (
            not local_id
            or str(bindings.get(local_id) or "") != record.local_encounter_id
        ):
            return None
        rows = self._main_retained_battle_rows()
        for row in rows:
            row.update(
                interactive=False,
                highlight_self_row=False,
                is_recent_battle=True,
                settlement_status_text="本地战斗数据，等待服务器结算",
            )
        return rows

    def _main_finished_current_local_rows(
        self, record, now: float | None = None
    ) -> list[dict[str, object]] | None:
        """Show the bound local result after combat stops but before settlement."""

        if (
            record is None
            or record.result != "IN_PROGRESS"
            or record.settlement_status != "LIVE"
        ):
            return None
        model = getattr(self, "model", None)
        adapter = getattr(self, "settlement_history_adapter", None)
        bindings = getattr(adapter, "local_bindings", None)
        local_id = str(getattr(model, "encounter_id", "") or "").strip()
        if (
            not local_id
            or not isinstance(bindings, dict)
            or str(bindings.get(local_id) or "") != record.local_encounter_id
        ):
            return None
        combat_reader = getattr(model, "combat_in_progress", None)
        if callable(combat_reader):
            try:
                active = bool(combat_reader(now))
            except TypeError:
                active = bool(combat_reader())
            if active:
                return None
        interval_reader = getattr(model, "resolve_combat_interval", None)
        if not callable(interval_reader):
            return None
        try:
            interval = interval_reader(now)
        except TypeError:
            interval = interval_reader()
        if not bool(getattr(interval, "final", False)):
            return None

        duration_reader = getattr(model, "duration", None)
        try:
            raw_duration = duration_reader(now) if callable(duration_reader) else 0
        except TypeError:
            raw_duration = duration_reader() if callable(duration_reader) else 0
        duration = dps_duration_seconds(raw_duration)
        rows = self._main_combat_display_rows(now)
        if not any(
            row.get("total_value") is not None or row.get("stat_value") is not None
            for row in rows
        ):
            return None
        if not self._main_team_rows_cover_known_party(rows):
            return None
        for row in rows:
            damage = int(row.get("damage_sort", 0) or 0)
            if duration:
                row["dps_value"] = damage / duration
                if row.get("metric") == "dps":
                    row["stat_value"] = row["dps_value"]
            row.update(
                interactive=False,
                highlight_self_row=False,
                is_recent_battle=True,
                settlement_status_text="本地战斗数据，等待服务器结算",
            )
        return rows

    def _current_party_recent_rows(self, record) -> list[dict[str, object]] | None:
        """Return the settled roster without applying later party changes.

        Team composition reads the live party independently. Once a battle is
        settled, its participant rows belong to that battle even if members
        leave or are removed before the next result is available.
        """

        if record is not None and record.ended_at_ns is not None:
            local_rows = self._main_pending_local_rows(record)
            if local_rows is not None:
                return local_rows
            rows = self._settlement_record_main_rows(record)
            model = getattr(self, "model", None)
            actor_tokens = getattr(model, "actor_character_ids", {})
            if isinstance(actor_tokens, dict):
                settled_tokens = {
                    int(member.get("iid") or 0): str(member.get("id") or "")
                    for member in record.participants_snapshot
                }
                try:
                    profiles = self._team_rating_preview_rows()
                except (AttributeError, TypeError, ValueError):
                    profiles = ()
                live_ratings = {
                    str(actor_tokens.get(int(profile.get("actor_id") or 0)) or ""):
                    normalize_extraordinary_rating(profile.get("extraordinary_rating"))
                    for profile in profiles
                    if isinstance(profile, dict)
                }
                for row in rows:
                    token = settled_tokens.get(int(row.get("actor_id") or 0), "")
                    rating = live_ratings.get(token) if token else None
                    if rating is not None and row.get("rating") is None:
                        row["rating"] = rating
                        row["rating_text"] = str(rating)
                        row["inline_rating_text"] = (
                            "" if getattr(self, "hide_names", False) else str(rating)
                        )
            return rows

        model = getattr(self, "model", None)
        actor_character_ids = getattr(model, "actor_character_ids", None)
        # Older integrations without token identity keep the original detached
        # settlement presentation.  The production CombatModel always owns
        # this mapping, even while it is temporarily empty.
        if not isinstance(actor_character_ids, dict):
            return None
        try:
            profiles = list(self._team_rating_preview_rows())
        except (AttributeError, TypeError, ValueError):
            profiles = []
        if not profiles:
            return []
        if (
            len(profiles) == 1
            and record is not None
            and record.settlement_status == "SETTLED"
            and len(getattr(record, "participants", ())) > 1
            and int(getattr(record, "party_session_id", 0) or 0) > 0
        ):
            # The current team can become solo between Boss pulls. The
            # completed result still belongs to that same team session; its
            # departed participants must remain visible as historical rows.
            return self._settlement_record_main_rows(record)

        history_by_token: dict[str, dict[str, object]] = {}
        duration = None
        if record is not None:
            view = encounter_view(
                record, statistics_scope=self._main_hud_statistics_scope(record)
            )
            duration = view.get("duration_seconds")
            for member in view.get("members", ()):
                token = str(member.get("id") or "").strip()
                if token:
                    history_by_token[token] = member

        hidden = bool(getattr(self, "hide_names", False))
        self_id = int(getattr(model, "self_id", 0) or 0)
        self_character_id = str(
            getattr(model, "self_character_id", "") or ""
        ).strip()
        rows: list[dict[str, object]] = []
        for index, profile in enumerate(profiles):
            try:
                actor_id = int(profile.get("actor_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                actor_id = 0
            token = str(actor_character_ids.get(actor_id, "") or "").strip()
            if not token and actor_id == self_id:
                token = self_character_id
            history_member = history_by_token.get(token)
            current_name = str(profile.get("display_name") or "").strip()
            anonymous_name = str(
                profile.get("anonymous_name") or f"玩家{index + 1}"
            ).strip()
            history_name = str(
                (history_member or {}).get("name") or ""
            ).strip()
            name = (
                anonymous_name
                if hidden
                else current_name or history_name or anonymous_name
            )
            damage = (
                history_member.get("damage")
                if history_member is not None
                else None
            )
            profession_id = int(profile.get("profession_id", 0) or 0)
            metric, total, rate = self._main_settlement_metric_values(
                history_member or {}, duration, profession_id
            )
            rows.append(
                {
                    "actor_id": actor_id,
                    "profession_id": profession_id,
                    "name": name,
                    "metric": metric,
                    "stat_value": rate,
                    "total_value": total,
                    "dps_value": (history_member or {}).get("dps"),
                    "hide_total": False,
                    "damage_sort": int(damage or 0),
                    "deaths": (
                        record.death_count(history_member["id"])
                        if record is not None and history_member is not None
                        else 0
                    ),
                    "is_self": actor_id == self_id,
                    "highlight_self_row": False,
                    "interactive": False,
                    "is_recent_battle": True,
                    "settlement_status_text": (
                        history_member.get("status_text", "")
                        if history_member is not None
                        else "等待战斗数据"
                    ),
                    "rating": normalize_extraordinary_rating(
                        profile.get("extraordinary_rating")
                    ),
                    "rating_text": (
                        "人机"
                        if bool(profile.get("is_ai"))
                        else "--"
                        if normalize_extraordinary_rating(
                            profile.get("extraordinary_rating")
                        ) is None
                        else str(
                            normalize_extraordinary_rating(
                                profile.get("extraordinary_rating")
                            )
                        )
                    ),
                    "inline_rating_text": (
                        "人机"
                        if bool(profile.get("is_ai"))
                        else ""
                        if normalize_extraordinary_rating(
                            profile.get("extraordinary_rating")
                        ) is None
                        else str(
                            normalize_extraordinary_rating(
                                profile.get("extraordinary_rating")
                            )
                        )
                    ),
                    "is_ai": bool(profile.get("is_ai", False)),
                    "_history_matched": history_member is not None,
                    "_roster_order": index,
                }
            )

        rows.sort(
            key=lambda row: (
                not bool(row.get("_history_matched")),
                -int(row.get("damage_sort", 0) or 0),
                int(row.get("_roster_order", 0) or 0),
            )
        )
        for row in rows:
            row.pop("_history_matched", None)
            row.pop("_roster_order", None)
        return rows

    def _main_displayable_team_dps_record(self):
        """Return the settled server record that is safe to show as team DPS.

        Entering fight mode or landing a local hit does not mean that a team
        result exists.  In particular, a first Boss pull and a training dummy
        must keep the roster-rating view until the settlement matcher has
        accepted a real team table.
        """

        if self._main_display_is_cleared() or self._main_context_display_is_stale():
            return None
        settlement_controller = getattr(self, "settlement_ui", None)
        settlement_tracker = getattr(settlement_controller, "tracker", None)
        current = (
            settlement_tracker.encounters.get(settlement_tracker.current_id)
            if settlement_tracker is not None
            else None
        )
        # A previous settled Boss must never populate the current pull while
        # the new encounter is live or waiting for its own settlement.
        if current is not None and current.result == "IN_PROGRESS":
            return None
        dummy_reader = getattr(self.model, "_is_dummy_encounter", None)
        if callable(dummy_reader) and dummy_reader():
            return None
        record = self._main_recent_settlement_record()
        if record is None or record.settlement_status != "SETTLED":
            return None
        participants = getattr(record, "participants", ())
        if self._main_hud_statistics_scope(record) == "ALL":
            participants = (record.all_statistics or {}).get("members", ())
        if not any(
            isinstance(member, dict) and member.get("damage") is not None
            for member in participants
        ):
            return None
        return record

    def _main_has_displayable_team_dps(self) -> bool:
        """Cover both the settlement journal and the legacy retained result."""

        if self._main_display_is_cleared() or self._main_context_display_is_stale():
            return False
        dummy_reader = getattr(self.model, "_is_dummy_encounter", None)
        if callable(dummy_reader) and dummy_reader():
            return False
        if self._main_displayable_team_dps_record() is not None:
            return True
        if getattr(self, "settlement_ui", None) is not None:
            return False
        retained = (
            getattr(self, "main_last_battle_result", None)
            if self._main_retained_battle_active()
            else None
        )
        return bool(
            isinstance(retained, dict)
            and any(
                isinstance(member, dict) and member.get("damage") is not None
                for member in retained.get("participants", ())
            )
        )

    def _main_recent_battle_team_dps_text(self) -> str | None:
        """Return only the latest completed battle total for the footer."""

        if self._main_display_is_cleared() or self._main_context_display_is_stale():
            return None
        controller = getattr(self, "settlement_ui", None)
        tracker = getattr(controller, "tracker", None)
        current = (
            tracker.encounters.get(tracker.current_id)
            if tracker is not None
            else None
        )
        local_rows = self._main_finished_current_local_rows(current)
        if local_rows:
            rates = [
                float(row["dps_value"])
                for row in local_rows
                if row.get("dps_value") is not None
            ]
            if rates:
                return format_main_rate(sum(rates))
        record = self._main_recent_settlement_record(settled_only=True)
        if record is not None:
            view = encounter_view(
                record,
                statistics_scope=self._main_hud_statistics_scope(record),
            )
            rates: list[float] = []
            for member in view.get("members", ()):
                try:
                    rate = float(member.get("dps"))
                except (AttributeError, TypeError, ValueError, OverflowError):
                    rates = []
                    break
                if not math.isfinite(rate) or rate < 0:
                    rates = []
                    break
                rates.append(rate)
            if rates:
                return format_main_rate(sum(rates))

        retained = getattr(self, "main_last_battle_result", None)
        if not isinstance(retained, dict) or not retained.get("participants"):
            return None
        try:
            team_dps = float(retained.get("team_dps"))
        except (TypeError, ValueError, OverflowError):
            return None
        if not math.isfinite(team_dps) or team_dps < 0:
            return None
        return f"{int(round(team_dps)):,}"


    def _main_live_team_dps_text(
        self,
        rows: list[dict[str, object]],
        now: float | None = None,
    ) -> str | None:
        """Use local dummy DPS; otherwise prefer team counters over Boss HP."""

        combat_reader = getattr(self.model, "combat_in_progress", None)
        try:
            active = (
                bool(combat_reader(now))
                if callable(combat_reader) and now is not None
                else bool(combat_reader())
                if callable(combat_reader)
                else False
            )
        except (AttributeError, TypeError, ValueError):
            active = False
        if not active:
            active = self._main_live_hud_projection_active(now)
        if not active:
            return None

        dummy_reader = getattr(self.model, "_is_dummy_encounter", None)
        if callable(dummy_reader) and dummy_reader():
            # A shared dummy's HP loss cannot measure this player's damage.
            # Reuse the self row's exact hits, Common total and round clock.
            row = self._main_live_self_dps_row(now)
            rate = row.get("dps_value") if row is not None else None
            return format_main_rate(rate) if rate is not None else None

        rates_by_actor: dict[int, float] = {}
        anonymous_rates: list[float] = []
        self_id = int(getattr(self.model, "self_id", 0) or 0)
        has_teammate_rate = False
        for row in rows:
            if (
                not isinstance(row, dict)
                or row.get("row_kind")
                or row.get("is_recent_battle")
                or row.get("metric") == "rating"
            ):
                continue
            raw = row.get("dps_value")
            if raw is None and row.get("metric") == "dps":
                raw = row.get("stat_value")
            try:
                rate = float(raw)
            except (TypeError, ValueError, OverflowError):
                continue
            if math.isfinite(rate) and rate >= 0:
                try:
                    actor_id = int(row.get("actor_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    actor_id = 0
                if actor_id:
                    # The local player is pinned above the complete live-team
                    # table.  Use the later team row for the same actor once,
                    # rather than counting the pinned copy twice.
                    rates_by_actor[actor_id] = rate
                else:
                    anonymous_rates.append(rate)
                if (
                    (self_id and actor_id and actor_id != self_id)
                    or (not self_id and row.get("is_self") is False)
                ):
                    has_teammate_rate = True
        rates = [*rates_by_actor.values(), *anonymous_rates]
        if rates and (has_teammate_rate or len(rates_by_actor) > 1):
            return format_main_rate(sum(rates))

        hp_rate = self._main_live_boss_hp_team_dps(now)
        if hp_rate is not None:
            return format_main_rate(hp_rate)
        return format_main_rate(sum(rates)) if rates else None

    def _main_live_boss_hp_team_dps(
        self, now: float | None = None
    ) -> float | None:
        """Return current team DPS from validated cumulative Boss HP drops."""

        live_boss = self._main_live_hud_boss_state()
        if live_boss is not None:
            try:
                damage = float(
                    live_boss.get("observed_damage_taken", 0.0) or 0.0
                )
                current_hp = float(live_boss.get("current_hp", 0.0) or 0.0)
            except (TypeError, ValueError, OverflowError):
                return None
            hp_known = bool(live_boss.get("current_hp_known", False)) or (
                current_hp > 0
            )
            duration = self._main_live_hud_dps_duration(now)
            divisor = dps_duration_seconds(duration)
            if (
                hp_known
                and divisor > 0
                and math.isfinite(damage)
                and damage >= 0
            ):
                return damage / divisor
            return None

        model = self.model
        current_bosses = getattr(model, "current_bosses", None)
        bosses = list(current_bosses()) if callable(current_bosses) else []
        if not bosses:
            current_monster = getattr(model, "current_monster", None)
            monster = current_monster() if callable(current_monster) else None
            bosses = [monster] if monster is not None else []
        if not any(
            getattr(boss, "current_hp", None) is not None for boss in bosses
        ):
            return None

        duration_reader = getattr(model, "display_duration", None)
        if not callable(duration_reader):
            return None
        boss_damage: list[float] = []
        for boss in bosses:
            if not hasattr(boss, "observed_damage_taken"):
                boss_damage = []
                break
            try:
                value = float(getattr(boss, "observed_damage_taken", 0.0) or 0.0)
            except (TypeError, ValueError, OverflowError):
                return None
            if not math.isfinite(value) or value < 0:
                return None
            boss_damage.append(value)
        damage_reader = getattr(model, "observed_boss_damage_taken", None)
        try:
            damage = (
                sum(boss_damage)
                if boss_damage
                else float(damage_reader())
                if callable(damage_reader)
                else 0.0
            )
            duration = float(duration_reader(now))
        except TypeError:
            try:
                damage = (
                    sum(boss_damage)
                    if boss_damage
                    else float(damage_reader())
                    if callable(damage_reader)
                    else 0.0
                )
                duration = float(duration_reader())
            except (AttributeError, TypeError, ValueError, OverflowError):
                return None
        except (AttributeError, ValueError, OverflowError):
            return None
        divisor = dps_duration_seconds(duration)
        if not math.isfinite(damage) or damage < 0 or divisor <= 0:
            return None
        return damage / divisor

    def _main_team_rating_section_rows(self) -> list[dict[str, object]]:
        """Build the lower roster shown until a matched team result exists."""

        rows = [dict(row) for row in self._main_rating_display_rows()]
        # The live party roster is the authoritative membership boundary. The
        # rating/equipment preview arrives asynchronously, so merge missing
        # party actors into the same section instead of dropping them.
        try:
            live_members = set(self._main_visible_roster_members())
        except (AttributeError, TypeError, ValueError):
            live_members = set()
        try:
            self_id = int(getattr(self.model, "self_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            self_id = 0
        if self_id:
            live_members.add(self_id)
        existing_ids = {
            int(row.get("actor_id", 0) or 0)
            for row in rows
            if int(row.get("actor_id", 0) or 0)
        }
        model = self.model
        names = getattr(model, "entity_names", {})
        professions = getattr(model, "entity_professions", {})
        ordered_members = list(getattr(model, "friend_order", ()))
        ordered_members.extend(sorted(live_members - set(ordered_members)))
        for actor_id in ordered_members:
            try:
                actor_id = int(actor_id or 0)
            except (TypeError, ValueError, OverflowError):
                continue
            if not actor_id or actor_id not in live_members or actor_id in existing_ids:
                continue
            name = str(names.get(actor_id, "") if isinstance(names, dict) else "").strip()
            profession_id = int(professions.get(actor_id, 0) or 0) if isinstance(professions, dict) else 0
            rating = self._main_extraordinary_rating(actor_id)
            rows.append({
                "actor_id": actor_id,
                "profession_id": profession_id,
                "name": name or "玩家识别中",
                "rating": rating,
                "is_ai": self._main_actor_is_ai(actor_id),
                "is_self": actor_id == self_id,
            })
            existing_ids.add(actor_id)
        for row in rows:
            rating = normalize_extraordinary_rating(row.get("rating"))
            row["metric"] = "rating"
            row["stat_value"] = None
            row["total_value"] = None
            row["damage_sort"] = 0
            row["hide_total"] = True
            row["hide_deaths"] = True
            row["interactive"] = False
            row["highlight_self_row"] = False
            row["rating_text"] = (
                "人机"
                if row.get("is_ai")
                else "--"
                if rating is None
                else str(rating)
            )
            row["inline_rating_text"] = (
                "人机"
                if row.get("is_ai")
                else str(rating)
                if rating is not None and not bool(getattr(self, "hide_names", False))
                else ""
            )
        return rows

    def _settlement_main_rows(self, now=None):
        controller = getattr(self, "settlement_ui", None)
        if controller is None:
            return None
        tracker = controller.tracker
        current = tracker.encounters.get(tracker.current_id)
        identity = next(
            (
                member
                for member in (current.participants_snapshot if current is not None else ())
                if member.get("id") == current.self_token
            ),
            {},
        )
        live_segment = self._main_live_hud_dps_segment_state(now)
        if isinstance(live_segment, dict) and live_segment.get("active"):
            live_row = self._main_current_live_self_dps_row(
                now, profession_id=identity.get("profession_id")
            )
        else:
            live_row = self._main_live_self_dps_row(
                now, profession_id=identity.get("profession_id")
            )
        if live_row is None:
            actor_id = int(identity.get("iid") or 0)
            shown_name = (
                str(self._shown_actor_name(actor_id) or "").strip()
                if actor_id
                else ""
            )
            if not shown_name and not bool(getattr(self, "hide_names", False)):
                shown_name = str(identity.get("name") or "").strip()
            if not shown_name and not bool(getattr(self, "hide_names", False)):
                cached_identity = getattr(getattr(self, "worker", None), "self_identity_cache", {})
                game_pid = int(getattr(self, "game_pid", 0) or 0)
                if game_pid and int(cached_identity.get("game_pid", 0) or 0) == game_pid:
                    shown_name = str(cached_identity.get("name") or "").strip()
            shown_name = shown_name or ("玩家" if getattr(self, "hide_names", False) else "识别中")
            live_row = {
                "actor_id": actor_id,
                "profession_id": int(identity.get("profession_id") or 0),
                "name": shown_name,
                "metric": self._main_player_display_metric(
                    identity.get("profession_id"), None
                ),
                "stat_value": None,
                "total_value": None,
                "dps_value": None,
                "damage_sort": 0,
                "deaths": current.death_count(current.self_token or "") if current is not None else 0,
                "is_self": True,
                "is_live_self": True,
                "interactive": bool(actor_id),
            }
        elif not str(live_row.get("name") or "").strip():
            shown_name = (
                str(identity.get("name") or "").strip()
                if not bool(getattr(self, "hide_names", False))
                else "本人"
            ) or "本人"
            live_row["name"] = shown_name
        if not live_row.get("profession_id"):
            live_row["profession_id"] = int(identity.get("profession_id") or 0)
        live_rating = self._main_extraordinary_rating(
            int(live_row.get("actor_id") or 0), live_row
        )
        live_row["rating"] = live_rating
        live_row["inline_rating_text"] = (
            str(live_rating)
            if live_rating is not None and not bool(getattr(self, "hide_names", False))
            else ""
        )
        context_display_stale = self._main_context_display_is_stale()
        if context_display_stale:
            live_row = dict(
                live_row,
                stat_value=None,
                total_value=None,
                dps_value=None,
                damage_sort=0,
                deaths=0,
            )

        # Recent history is limited to this launch/character epoch. Durable
        # records remain available in Settings, but a restart or account
        # switch starts the compact main window without the previous record.
        previous = self._main_recent_settlement_record()
        local_finished_rows = self._main_finished_current_local_rows(current, now)
        if current is not None and current.result == "IN_PROGRESS":
            # Once the next pull starts, its immediate predecessor owns the
            # lower table even while the server result is still pending.
            previous = self._main_recent_settlement_record(
                keep_last_settled=False
            )
        team_dps_record = self._main_displayable_team_dps_record()
        recent_record = team_dps_record
        if local_finished_rows is not None:
            recent_record = current
        elif recent_record is None and not self._main_display_is_cleared():
            dummy_reader = getattr(self.model, "_is_dummy_encounter", None)
            if not callable(dummy_reader) or not dummy_reader():
                recent_record = previous
        show_recent_result = recent_record is not None
        official_rows = None
        if (
            current is None
            and team_dps_record is not None
        ):
            official_rows = self._settlement_record_main_rows(team_dps_record)
            official_self = next(
                (row for row in official_rows if row.get("is_self")), None
            )
            if official_self is not None:
                live_row = dict(
                    official_self,
                    highlight_self_row=True,
                    is_live_self=False,
                    is_official_self=True,
                )
        default_section = {
                "row_kind": "section",
                "section_text": "实时战斗/战斗记录",
                "expanded": True,
            }
        rows = [live_row, default_section]
        if show_recent_result:
            recent_boss = self._main_recent_boss_row(recent_record)
            if recent_boss is not None:
                rows.append(recent_boss)
            party_rows = (
                local_finished_rows
                if local_finished_rows is not None and recent_record is current
                else self._current_party_recent_rows(recent_record)
            )
            if party_rows is not None:
                if party_rows:
                    # The top row is the local player's live DPS, while this
                    # section is the complete current-party roster projected
                    # onto the latest settlement.  Keep the local player here
                    # as well so the team rating list is complete and the
                    # player's live score does not disappear from the lower
                    # section merely because they are also pinned above it.
                    rows.extend(party_rows)
                else:
                    rows.append(
                        {
                            "row_kind": "message",
                            "message_text": "等待当前队伍资料",
                        }
                    )
            elif previous is not None:
                rows.extend(
                    row
                    for row in (
                        official_rows
                        if official_rows is not None
                        else self._settlement_record_main_rows(recent_record)
                    )
                    if not row.get("is_self")
                )
        else:
            rows.append(
                {
                    "row_kind": "message",
                    "message_text": "该数据将在战斗胜利或下一次挑战 Boss 时体现",
                }
            )
        return rows

    def _ingest_team_application(
        self, payload: object, *, now: float | None = None
    ) -> bool:
        """Remember one application for ten seconds without a row cap."""

        if not isinstance(payload, dict):
            return False
        token = str(payload.get("user_token", "") or "").strip()
        name = str(payload.get("name", "") or "").strip()
        if not token or not name:
            return False
        observed_at = time.monotonic() if now is None else float(now)
        rating = normalize_extraordinary_rating(
            payload.get("extraordinary_rating")
        )
        notice: dict[str, object] = {
            "user_token": token,
            "name": name[:20],
            "extraordinary_rating": rating,
            "received_at": observed_at,
            "expires_at": observed_at + TEAM_APPLICATION_NOTICE_SECONDS,
        }
        for key in ("profession_id", "level", "server_id"):
            try:
                value = int(payload.get(key, 0) or 0)
            except (TypeError, ValueError, OverflowError):
                value = 0
            if value > 0:
                notice[key] = value

        current = getattr(self, "team_application_notices", ())
        active = [
            dict(item)
            for item in current
            if isinstance(item, dict)
            and float(item.get("expires_at", 0.0) or 0.0) > observed_at
            and str(item.get("user_token", "") or "") != token
        ]
        active.append(notice)
        self.team_application_notices = deque(active)
        return True

    def _team_application_section_rows(
        self, *, now: float | None = None
    ) -> list[dict[str, object]]:
        """Return active application lines and expire them without timers."""

        observed_at = time.monotonic() if now is None else float(now)
        active = [
            dict(item)
            for item in getattr(self, "team_application_notices", ())
            if isinstance(item, dict)
            and float(item.get("expires_at", 0.0) or 0.0) > observed_at
        ]
        self.team_application_notices = deque(active)
        rows: list[dict[str, object]] = []
        for index, item in enumerate(active, start=1):
            name = (
                f"申请玩家{index}"
                if bool(getattr(self, "hide_names", False))
                else str(item.get("name", "") or "申请玩家")
            )
            rating = normalize_extraordinary_rating(
                item.get("extraordinary_rating")
            )
            rows.append(
                {
                    "row_kind": "team_application",
                    "application_text": (
                        f"入队申请  {name}  非凡评分 "
