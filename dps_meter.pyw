    def _draw_main_time_value(self) -> None:
        canvas = getattr(self, "time_value", None)
        if not isinstance(canvas, tk.Canvas):
            return
        canvas.delete("all")
        height = max(1, canvas.winfo_height())
        canvas_outlined_text(
            canvas,
            self._main_px(1),
            height // 2,
            text=str(getattr(self, "main_time_text", "00:00") or "00:00"),
            fill="#ffffff",
            outline="#08111b",
            outline_width=max(1, self._main_px(1)),
            anchor="w",
            font=self._ui_font("main_number_strong"),
        )

    def _draw_team_dps_value(self) -> None:
        canvas = getattr(self, "team_dps_caption", None)
        if not isinstance(canvas, tk.Canvas):
            return
        canvas.delete("all")
        height = max(1, canvas.winfo_height())
        middle_y = height // 2
        caption_font = self._ui_font("main_text")
        value_font = self._ui_font("main_number_strong")
        caption = str(
            getattr(self, "main_dps_caption_text", "全队秒伤") or "全队秒伤"
        )
        canvas_outlined_text(
            canvas,
            self._main_px(1),
            middle_y,
            text=caption,
            fill="#f7f9fc",
            outline="#071019",
            outline_width=max(1, self._main_px(1)),
            anchor="w",
            font=caption_font,
        )
        try:
            value_x = caption_font.measure(caption) + self._main_px(7)
        except (AttributeError, TypeError, ValueError, tk.TclError):
            value_x = self._main_px(63)
        canvas_outlined_text(
            canvas,
            value_x,
            middle_y,
            text=str(getattr(self, "team_dps_text", "0") or "0"),
            fill="#79bdff",
            outline="#071019",
            outline_width=max(1, self._main_px(1)),
            anchor="w",
            font=value_font,
        )

    def _set_team_dps_value(self, text: object) -> None:
        self.team_dps_text = str(text or "0")
        widget = getattr(self, "team_dps_caption", None)
        if isinstance(widget, tk.Canvas):
            self._draw_team_dps_value()
        elif getattr(self, "team_dps_label", None) is not None:
            self.team_dps_label.configure(text=self.team_dps_text)
        self._schedule_layered_main_render()

    def _set_main_time_value(self, text: object) -> None:
        self.main_time_text = str(text or "00:00")
        widget = getattr(self, "time_value", None)
        if isinstance(widget, tk.Canvas):
            self._draw_main_time_value()
        elif widget is not None:
            widget.configure(text=self.main_time_text, fg="#ffffff")
        self._schedule_layered_main_render()

    def _layered_main_active(self) -> bool:
        return bool(
            getattr(self, "layered_main_enabled", False)
            and getattr(self, "layered_main_renderer", None) is not None
            and getattr(self, "layered_main_presenter", None) is not None
        )

    def _schedule_layered_main_render(
        self, delay: int = 0, *, force: bool = False
    ) -> None:
        if getattr(self, "closing", False):
            return
        if not self._layered_main_active():
            if getattr(self, "hud_settings_open", False):
                self._render_fallback_hud_settings()
            return
        if getattr(self, "layered_main_after_id", None) is not None:
            if not force:
                return
            try:
                self.root.after_cancel(self.layered_main_after_id)
            except (AttributeError, tk.TclError):
                pass
            self.layered_main_after_id = None

        def render() -> None:
            self.layered_main_after_id = None
            if not self.closing:
                self._render_layered_main_hud()

        try:
            wait_ms = hud_render_delay(time.perf_counter(),
                getattr(self, "layered_main_paint_finished_at", 0.0), delay)
            self.layered_main_after_id = self.root.after(wait_ms, render)
        except (AttributeError, tk.TclError):
            self.layered_main_after_id = None

    def _main_boss_display_values(
        self, monster, *, force_defeated: bool = False
    ) -> dict[str, object]:
        boss_name = "暂无目标"
        boss_level = None
        current_hp = None
        maximum_hp = None
        if monster is not None:
            try:
                level = int(getattr(monster, "level", 0) or 0)
                if 1 <= level <= 999:
                    boss_level = level
            except (TypeError, ValueError, OverflowError):
                pass
            boss_name = str(getattr(monster, "name", "") or "").strip()
            if not boss_name or boss_name_is_placeholder(boss_name):
                display_target_name = getattr(self.model, "display_target_name", None)
                boss_name = (
                    str(
                        display_target_name(
                            int(getattr(monster, "entity_id", 0) or 0)
                        )
                        or ""
                    ).strip()
                    if callable(display_target_name)
                    else ""
                )
            boss_name = boss_name or "Boss"
            current_hp = getattr(monster, "current_hp", None)
            # A confirmed victory is an authoritative terminal boundary even
            # when the final CurrentHP packet was lost.  Keep this override at
            # the presentation edge so a stale positive live sample cannot
            # put a defeated Boss back on the HUD.  Wipes and live pulls do
            # not use this path.
            if force_defeated:
                current_hp = 0.0
            try:
                declared_maximum = float(
                    getattr(monster, "max_hp", 0.0) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                declared_maximum = 0.0
            try:
                observed_maximum = float(
                    getattr(monster, "observed_max_hp", 0.0) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                observed_maximum = 0.0
            if math.isfinite(declared_maximum) and declared_maximum > 0:
                maximum_hp = declared_maximum
            elif math.isfinite(observed_maximum) and observed_maximum > 0:
                maximum_hp = observed_maximum
                if isinstance(monster, MonsterStats) and boss_level is not None:
                    try:
                        template_id = int(getattr(monster, "template_id", 0) or 0)
                        identity = (template_id, boss_level)
                        reference = float(getattr(
                            self, "_boss_max_hp_references", {}
                        ).get(identity, 0) or 0)
                        raw_candidates = getattr(
                            self, "_boss_max_hp_reference_candidates", {}
                        ).get(identity, ())
                        candidates = sorted({
                            float(candidate)
                            for candidate in raw_candidates
                            if math.isfinite(float(candidate))
                            and float(candidate) > 0
                        })
                    except (TypeError, ValueError, OverflowError, AttributeError):
                        reference = 0.0
                        candidates = []
                    if candidates:
                        viable = [
                            candidate for candidate in candidates
                            if candidate >= observed_maximum
                        ]
                        reference = 0.0
                        if viable:
                            nearest = viable[0]
                            # Multiple full-HP scales can share one Boss
                            # template and level. A near-full live sample
                            # identifies the closest scale; a lower live
                            # sample remains ambiguous until it crosses all
                            # smaller confirmed scales.
                            if (
                                len(viable) == 1
                                or observed_maximum / nearest >= 0.95
                            ):
                                reference = nearest
                    if reference > 0 and 0 < observed_maximum / reference <= 1.0:
                        maximum_hp = reference
        boss_ratio = None
        if current_hp is not None and maximum_hp is not None and maximum_hp > 0:
            boss_ratio = min(1.0, max(0.0, float(current_hp) / float(maximum_hp)))
        boss_hp = format_team_health_number(current_hp) if current_hp is not None else ""
        boss_percent = ""
        if maximum_hp is not None:
            boss_hp = (
                f"{boss_hp} / "
                f"{format_team_health_number(maximum_hp)}"
            )
        if current_hp is not None and maximum_hp is not None and maximum_hp > 0:
            percent = boss_ratio * 100.0
            boss_percent = (
                f"{percent:.0f}%" if percent in (0.0, 100.0)
                else "<0.1%" if percent < 0.05
                else f"{percent:.1f}%"
            )
        return dict(boss_name=boss_name, boss_available=monster is not None,
                    boss_template_id=getattr(monster, 'template_id', 0) if monster is not None else 0,
                    boss_icon=getattr(monster, 'icon', '') if monster is not None else '',
                    boss_level=boss_level, boss_hp=boss_hp, boss_percent=boss_percent, boss_ratio=boss_ratio)

    def _main_recent_stage_metadata(self, encounter) -> dict[str, object]:
        """Resolve display-only Boss identity from an authoritative stage ID.

        Some final-stage settlement packets arrive without a matching live Boss
        template observation.  The stage catalog may restore the label and
        portrait, but it must not invent a template ID, maximum HP, or ratio.
        """

        catalog = getattr(self, "_main_recent_stage_catalog", None)
        dungeon_catalog = getattr(self, "_main_recent_dungeon_catalog", None)
        if not isinstance(catalog, dict) or not isinstance(dungeon_catalog, dict):
            try:
                payload = json.loads(
                    (ASSET_DIR / "bosses" / "boss_icon_sources.json").read_text(
                        encoding="utf-8-sig"
                    )
                )
                raw_stages = payload.get("stages", {})
                raw_dungeons = payload.get("dungeons", {})
                catalog = raw_stages if isinstance(raw_stages, dict) else {}
                dungeon_catalog = (
                    raw_dungeons if isinstance(raw_dungeons, dict) else {}
                )
            except (OSError, TypeError, ValueError, AttributeError):
                catalog = {}
                dungeon_catalog = {}
            self._main_recent_stage_catalog = catalog
            self._main_recent_dungeon_catalog = dungeon_catalog
        try:
            stage_id = int(getattr(encounter, "stage_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            stage_id = 0
        metadata = catalog.get(str(stage_id), {})
        return dict(metadata) if isinstance(metadata, dict) else {}

    def _main_hud_statistics_scope(self, encounter) -> str:
        """Show one Boss's STAGE table; use ALL only for a proven one-Boss map."""

        if encounter is None:
            return "STAGE"
        stage = getattr(encounter, "stage_statistics", None)
        stage_members = stage.get("members") if isinstance(stage, dict) else None
        if isinstance(stage_members, (list, tuple)) and any(
            isinstance(member, dict) and member.get("damage") is not None
            for member in stage_members
        ):
            return "STAGE"
        all_statistics = getattr(encounter, "all_statistics", None)
        all_members = (
            all_statistics.get("members")
            if isinstance(all_statistics, dict) else None
        )
        if (
            str(getattr(encounter, "result", "") or "").upper() != "VICTORY"
            or getattr(encounter, "settlement_status", None) != "SETTLED"
            or not isinstance(all_members, (list, tuple))
            or not all_members
        ):
            return "STAGE"
        try:
            stage_id = int(getattr(encounter, "stage_id", 0) or 0)
            dungeon_id = int(getattr(encounter, "dungeon_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return "STAGE"
        if stage_id <= 0:
            return "STAGE"
        stage_metadata = self._main_recent_stage_metadata(encounter)
        dungeon_ids = (
            [dungeon_id]
            if dungeon_id > 0
            else stage_metadata.get("dungeon_ids", ())
        )
        dungeons = getattr(self, "_main_recent_dungeon_catalog", {})
        if not isinstance(dungeons, dict) or not dungeon_ids:
            return "STAGE"
        for candidate_id in dungeon_ids:
            dungeon = dungeons.get(str(candidate_id), {})
            if not isinstance(dungeon, dict):
                return "STAGE"
            try:
                stages = {int(value) for value in dungeon.get("stage_ids", ())}
            except (TypeError, ValueError, OverflowError):
                return "STAGE"
            if stages != {stage_id}:
                return "STAGE"
        return "ALL"

    def _main_recent_settlement_monster(self, encounter):
        """Restore the exact archived Boss health for an ended Encounter.

        The Encounter-owned end snapshot has priority because a delayed server
        table can be received after the next pull has restored the mutable live
        Boss to full HP.  Older records without that snapshot still fall back
        to their matching CombatHistory monster metadata.
        """

        archived_monster: dict[str, object] = {}
        history_store = getattr(self, "history_store", None)
        loader = getattr(history_store, "load", None)
        if callable(loader):
            try:
                history = loader(encounter.local_encounter_id)
            except (OSError, ValueError, TypeError, KeyError):
                history = None
            if isinstance(history, dict):
                candidate = history.get("monster")
                if isinstance(candidate, dict):
                    archived_monster = candidate

        stage_metadata = self._main_recent_stage_metadata(encounter)
        encounter_name = str(encounter.boss_name or "").strip()
        archived_name = str(archived_monster.get("name") or "").strip()
        if boss_name_is_placeholder(encounter_name):
            encounter_name = ""
        if boss_name_is_placeholder(archived_name):
            archived_name = ""
        snapshot_current_hp = getattr(encounter, "boss_current_hp", None)
        snapshot_max_hp = getattr(encounter, "boss_max_hp", None)
        if str(getattr(encounter, "result", "") or "").upper() == "VICTORY":
            # Victory itself proves the terminal HP.  Older journals may have
            # captured only the last positive sample, so do not let that
            # historical value override the confirmed result.
            snapshot_current_hp = 0.0

        from types import SimpleNamespace
        return SimpleNamespace(
            entity_id=archived_monster.get("entity_id", 0),
            name=(
                encounter_name
                or archived_name
                or str(stage_metadata.get("name") or "").strip()
                or "Boss"
            ),
            template_id=(
                encounter.boss_template_id
                or archived_monster.get("template_id")
                or 0
            ),
            icon=(
                str(archived_monster.get("icon") or "").strip()
                or str(stage_metadata.get("icon") or "").strip()
            ),
            level=archived_monster.get("level", 0),
            current_hp=(
                snapshot_current_hp
                if snapshot_current_hp is not None
                else archived_monster.get("current_hp")
            ),
            max_hp=(
                snapshot_max_hp
                if snapshot_max_hp is not None
                else archived_monster.get("max_hp")
            ),
            observed_max_hp=(
                snapshot_max_hp
                if snapshot_max_hp is not None
                else archived_monster.get("observed_max_hp")
            ),
        )

    def _main_recent_victory_matches_live_boss(self, encounter, monster) -> bool:
        """Check whether a completed settlement belongs to the live Boss row."""

        if (
            encounter is None
            or monster is None
            or str(getattr(encounter, "result", "") or "").upper()
            != "VICTORY"
        ):
            return False
        try:
            live_template = int(getattr(monster, "template_id", 0) or 0)
            settled_template = int(
                getattr(encounter, "boss_template_id", 0) or 0
            )
        except (TypeError, ValueError, OverflowError):
            live_template = settled_template = 0
        template_match = bool(
            live_template
            and settled_template
            and (
                live_template == settled_template
                or (live_template, settled_template)
                in BOSS_PHASE_TEMPLATE_TRANSITIONS
                or (settled_template, live_template)
                in BOSS_PHASE_TEMPLATE_TRANSITIONS
            )
        )
        try:
            live_entity = int(getattr(monster, "entity_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            live_entity = 0
        settled_token = str(getattr(encounter, "boss_token", "") or "").strip()
        token_match = bool(
            settled_token
            and live_entity
            and settled_token in {str(live_entity), f"entity:{live_entity}"}
        )
        controller = getattr(self, "settlement_ui", None)
        boss_entities = getattr(controller, "boss_entities", {})
        observed_boss = (
            boss_entities.get(str(live_entity), {})
            if isinstance(boss_entities, dict) else {}
        )
        if isinstance(observed_boss, dict):
            token_match = token_match or bool(
                settled_token
                and str(observed_boss.get("token") or "").strip() == settled_token
            )
        if not token_match and live_entity:
            encounter_id = str(
                getattr(encounter, "local_encounter_id", "") or ""
            )
            cached = getattr(self, "_main_recent_victory_entity_cache", None)
            if encounter_id and (
                not isinstance(cached, tuple) or cached[0] != encounter_id
            ):
                loader = getattr(getattr(self, "history_store", None), "load", None)
                try:
                    archived = loader(encounter_id) if callable(loader) else None
                except (OSError, ValueError, TypeError, KeyError):
                    archived = None
                if isinstance(archived, dict):
                    archived_monster = archived.get("monster")
                    if isinstance(archived_monster, dict):
                        try:
                            archived_entity = int(
                                archived_monster.get("entity_id", 0) or 0
                            )
                        except (TypeError, ValueError, OverflowError):
                            archived_entity = 0
                        cached = (encounter_id, archived_entity)
                        self._main_recent_victory_entity_cache = cached
            token_match = bool(
                isinstance(cached, tuple)
                and cached[0] == encounter_id
                and cached[1] == live_entity
            )
        settled_name = normalize_boss_name(getattr(encounter, "boss_name", ""))
        live_name = normalize_boss_name(getattr(monster, "name", ""))
        name_match = bool(
            settled_name
            and live_name
            and (
                settled_name == live_name
                or boss_names_share_phase(settled_name, live_name)
            )
        )
        # A concrete Boss token is the strongest boundary.  Do not let a
        # repeated template/name from a newly started pull inherit the old
        # victory just because its first fight-mode packet is delayed.
        if settled_token:
            if not token_match:
                return False
        elif not (template_match or name_match):
            return False
        try:
            ended_at = int(getattr(encounter, "ended_at_ns", 0) or 0)
            hp_stamp = int(getattr(monster, "last_hp_update_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            ended_at = hp_stamp = 0
        if ended_at and hp_stamp > 116_444_736_000_000_000:
            hp_epoch_ns = (
                hp_stamp - 116_444_736_000_000_000
            ) * 100
            if hp_epoch_ns > ended_at + 2_000_000_000:
                # A newer HP sample belongs to a later pull and must win.
                return False
        return True

    def _main_recent_boss_row(self, encounter) -> dict[str, object] | None:
        """Build the compact Boss identity shown above recent DPS rows."""

        if encounter is None:
            return None
        values = self._main_boss_display_values(
            self._main_recent_settlement_monster(encounter)
        )
        return {
            "row_kind": "recent_boss",
            "boss_name": values.get("boss_name") or "Boss",
            "boss_template_id": values.get("boss_template_id") or 0,
            "boss_icon": values.get("boss_icon") or "",
            "boss_level": values.get("boss_level"),
            "boss_hp": values.get("boss_hp") or "",
            "boss_percent": values.get("boss_percent") or "",
            "boss_ratio": values.get("boss_ratio"),
            "boss_available": values.get("boss_available", True),
        }










    def _toggle_hud_content_view(self) -> None:
        self._set_pve_hud_view(
            "recent_battle" if getattr(self, "pve_hud_view", "team") == "team" else "team"
        )

    def _set_pve_hud_view(self, view: object) -> None:
        """Switch the PVE title-rail content view without resetting combat."""

        normalized = (
            "team"
            if str(view or "").strip().casefold() == "team"
            else "recent_battle"
        )
        if normalized == getattr(self, "pve_hud_view", "team"):
            return
        self.pve_hud_view = normalized
        self.main_scroll_offset = 0
        self.layered_main_hover_action = ""
        if normalized == "team":
            self._schedule_team_equipment_profiles()
        if self._layered_main_active():
            self._schedule_layered_main_render()








    def _layered_main_snapshot(self) -> dict[str, object]:
        targetless_team_data = self._main_targetless_team_data()
        live_hud_projection_active = self._main_live_hud_projection_active()
        raw_live_hud_boss_state = getattr(self, "live_hud_boss_state", None)
        terminal_boss_state = (
            raw_live_hud_boss_state
            if isinstance(raw_live_hud_boss_state, dict)
            and raw_live_hud_boss_state.get("terminal_zero")
            else None
        )
        live_hud_boss_state = (
            self._main_live_hud_boss_state()
            if live_hud_projection_active
            else None
        )
        rows, rating_preview = self._main_display_rows()
        # FightMode can arrive before the next team snapshot.  Only rows from
        # that snapshot may replace the delayed result from the previous pull.
        targetless_team_active = bool(
            live_hud_projection_active
            and any(
                isinstance(row, dict) and row.get("targetless_team_live")
                for row in rows
            )
        )
        application_rows = self._team_application_section_rows()
        display_rows: list[dict[str, object]] = []
        for raw in rows:
            row = dict(raw)
            if row.get("row_kind"):
                display_rows.append(row)
                continue
            if rating_preview or row.get("metric") == "rating":
                rating = normalize_extraordinary_rating(row.get("rating"))
                rating_text = (
                    "人机"
                    if row.get("is_ai")
                    else "--"
                    if rating is None
                    else str(rating)
                )
                # Keep both public presentation keys available regardless of
                # whether the row came from the live roster, a settlement, or
                # a test/provider projection.  The canvas and detail views
                # consume these independently.
                row["rating_text"] = rating_text
                row.setdefault("inline_rating_text", "" if rating is None else rating_text)
                if rating is None and row.get('metric') == 'rating':
                    row['rating_pending'] = True
            else:
                row["stat_text"] = format_main_rate(row.get("stat_value"))
                row["total_text"] = (
                    ""
                    if row.get("hide_total")
                    else row.get('total_text_override')
                    or format_main_total(row.get("total_value"))
                )
            display_rows.append(row)

        startup_blocked = self._startup_interaction_blocked()
        startup_message = self._startup_wait_message()
        if startup_blocked:
            try:
                self_id = int(getattr(self.model, "self_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                self_id = 0
            self_rows = [
                row
                for row in display_rows
                if row.get("is_live_self")
                or row.get("is_self")
                or (
                    self_id > 0
                    and int(row.get("actor_id", 0) or 0) == self_id
                )
            ]
            if self_rows:
                self_row = dict(self_rows[0])
            else:
                self_row = {
                    "actor_id": self_id,
                    "profession_id": 0,
                    "name": "识别中",
                    "metric": "dps",
                    "stat_text": "",
                    "total_text": "",
                    "deaths": 0,
                    "hide_deaths": True,
                    "is_self": True,
                    "is_live_self": True,
                    "interactive": False,
                }
            rating = normalize_extraordinary_rating(self_row.get("rating"))
            if rating is None and self_id > 0:
                rating = self._main_extraordinary_rating(self_id, self_row)
            if rating is not None:
                self_row["rating"] = rating
                # Keep the public row contract identical to normal roster
                # rows while the startup gate is active.  The layered HUD
                # reads ``rating_text`` even for the pinned self row.
                self_row["rating_text"] = str(rating)
                self_row["inline_rating_text"] = str(rating)
            else:
                self_row.setdefault(
                    "rating_text",
                    "浜烘満" if self_row.get("is_ai") else "--",
                )
            self_row["interactive"] = False
            display_rows = [
                self_row,
                {
                    "row_kind": "message",
                    "message_text": startup_message,
                },
            ]
            rating_preview = False
            application_rows = []

        # The PVE team tab is an explicit presentation choice.  Keep the
        # pinned local row, then show the complete current roster below it;
        # selecting this tab must never fabricate a battle result or clear a
        # live encounter.
        pve_team_view = (
            getattr(self, "pve_hud_view", "team") == "team"
        )
        if pve_team_view and not startup_blocked:
            team_rows = [
                dict(row)
                for row in self._main_team_rating_section_rows()
                if isinstance(row, dict)
            ]
            for row in team_rows:
                row["metric"] = "rating"
                row["hide_total"] = True
                row["hide_deaths"] = True
                row["interactive"] = False
                rating_value = normalize_extraordinary_rating(
                    row.get("rating")
                )
                row["rating_text"] = (
                    "人机"
                    if row.get("is_ai")
                    else "--"
                    if rating_value is None
                    else str(rating_value)
                )
                row["inline_rating_text"] = (
                    "人机"
                    if row.get("is_ai")
                    else ""
                    if rating_value is None
                    else str(rating_value)
                )
            self_row = next(
                (
                    row
                    for row in team_rows
                    if bool(row.get("is_self"))
                ),
                None,
            )
            if self_row is None:
                self_row = next(
                    (
                        row
                        for row in display_rows
                        if bool(row.get("is_self"))
                        or bool(row.get("is_live_self"))
                    ),
                    None,
                )
            if self_row is not None:
                self_row = dict(self_row)
                self_row["is_self"] = True
                self_row["is_live_self"] = True
                self_row["highlight_self_row"] = True
                team_rows = [
                    row for row in team_rows
                    if row.get("actor_id") != self_row.get("actor_id")
                ]
                display_rows = [
                    self_row,
                    {
                        "row_kind": "section",
                        "section_text": "团队构成",
                        "expanded": True,
                    },
                    *team_rows,
                ]
            else:
                display_rows = [
                    {
                        "row_kind": "section",
                        "section_text": "团队构成",
                        "expanded": True,
                    },
                    *team_rows,
                ]
            rating_preview = True

        current_monster = getattr(self.model, "current_monster", None)
        monster = current_monster() if callable(current_monster) else None
        if monster is None:
            current_bosses = getattr(self.model, "current_bosses", None)
            bosses = list(current_bosses()) if callable(current_bosses) else []
            monster = bosses[0] if bosses else None
        retained_record = self.main_last_battle_result if self._main_retained_battle_active() else None
        recent_settlement = self._main_recent_settlement_record()
        if targetless_team_active:
            retained_record = None
            recent_settlement = None
        if live_hud_boss_state is not None:
            from types import SimpleNamespace

            alias = LIVE_HUD_BOSS_ALIASES.get(
                int(live_hud_boss_state["template_id"]),
                LIVE_HUD_UNKNOWN_BOSS_ALIAS,
            )
            live_boss_name = str(live_hud_boss_state.get("name") or "").strip()
            if not live_boss_name or boss_name_is_placeholder(live_boss_name):
                live_boss_name = str(alias["name"])
            monster = SimpleNamespace(
                entity_id=int(live_hud_boss_state["entity_id"]),
                template_id=int(live_hud_boss_state["template_id"]),
                name=live_boss_name,
                icon=str(live_hud_boss_state.get("icon") or alias["icon"]),
                level=int(live_hud_boss_state.get("level", 0) or 0),
                current_hp=max(
                    0.0,
                    float(live_hud_boss_state.get("current_hp", 0.0) or 0.0),
                ),
                max_hp=max(
                    0.0,
                    float(live_hud_boss_state.get("max_hp", 0.0) or 0.0),
                ),
            )
        settlement_tracker = getattr(
            getattr(self, "settlement_ui", None), "tracker", None
        )
        current_settlement_id = getattr(settlement_tracker, "current_id", None)
        dummy_reader = getattr(self.model, "_is_dummy_encounter", None)
        is_dummy = bool(dummy_reader()) if callable(dummy_reader) else False
        try:
            current_boss_hp = float(getattr(monster, "current_hp", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            current_boss_hp = 0.0
        combat_reader = getattr(self.model, "combat_in_progress", None)
        model_combat_active = (
            bool(combat_reader()) if callable(combat_reader) else False
        )
        live_no_boss = bool(
            targetless_team_active
            and live_hud_boss_state is None
            and monster is None
        )
        if live_no_boss:
            # This is a live-only presentation state.  Repeated team counters
            # from small monsters must not resurrect an older Boss result.
            retained_record = None
            recent_settlement = None
        try:
            current_boss_id = int(getattr(monster, "entity_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            current_boss_id = 0
        combat_states = getattr(self.model, "entity_combat_states", {})
        current_boss_in_fight_mode = bool(
            current_boss_id
            and isinstance(combat_states, dict)
            and combat_states.get(current_boss_id) is True
        )
        # A confirmed replacement Boss can legitimately arrive before its
        # first CurrentHP packet (the delayed TeamStats path is independent
        # from target promotion).  ``current_monster()`` already exposes the
        # pending target in that window; keep the recent-settlement fallback
        # from putting the previous Boss back over the new target.
        pending_boss_id = int(
            getattr(self.model, "pending_active_boss_id", 0) or 0
        )
        model_has_current_boss = bool(
            monster is not None
            and (
                current_boss_hp > 0
                or model_combat_active
                or current_boss_in_fight_mode
                or (pending_boss_id and current_boss_id == pending_boss_id)
            )
        )
        model_terminal_victory = bool(
            str(getattr(self.model, "combat_end_reason", "") or "").casefold()
            == "target_defeated"
            and not model_combat_active
            and not current_boss_in_fight_mode
            and not pending_boss_id
        )
        terminal_zero_matches_live = bool(
            terminal_boss_state is not None
            and current_boss_id > 0
            and int(terminal_boss_state.get("entity_id", 0) or 0)
            == current_boss_id
            and float(terminal_boss_state.get("current_hp", 0.0) or 0.0)
            == 0.0
        )
        if terminal_zero_matches_live:
            model_terminal_victory = True
            model_has_current_boss = False
        recent_victory_matches_live = bool(
            recent_settlement is not None
            and not current_settlement_id
            and not pending_boss_id
            and self._main_recent_victory_matches_live_boss(
                recent_settlement, monster
            )
            and float(getattr(self.model, "first_damage_time", 0) or 0)
            <= int(recent_settlement.ended_at_ns or 0) / 1_000_000_000
        )
        if recent_victory_matches_live:
            # A settlement can be marked victorious after the live model has
            # stopped, but before its trailing HP packet arrives.  Treat that
            # exact Boss match as terminal; a newer Boss sample is excluded by
            # the identity/timestamp check above.
            model_terminal_victory = True
            model_has_current_boss = False
        current_boss_health_is_newer = False
        if retained_record is not None and current_boss_hp > 0:
            try:
                hp_updated_100ns = int(
                    getattr(monster, "last_hp_update_100ns", 0) or 0
                )
                retained_ended_at = float(
                    retained_record.get("ended_at_epoch", 0.0) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                hp_updated_100ns = 0
                retained_ended_at = 0.0
            if hp_updated_100ns > 116_444_736_000_000_000 and retained_ended_at > 0:
                hp_updated_at = (
                    hp_updated_100ns - 116_444_736_000_000_000
                ) / 10_000_000
                current_boss_health_is_newer = hp_updated_at > retained_ended_at
        if (
            pending_boss_id
            or model_combat_active
            or current_boss_in_fight_mode
            or current_boss_health_is_newer
        ):
            # A retained display copy cannot replace a newly promoted target.
            retained_record = None
        show_recent_settlement_header = bool(
            recent_settlement is not None
            and recent_settlement.settlement_status == "SETTLED"
            and not current_settlement_id
            and not is_dummy
            and not model_has_current_boss
            and not self._main_display_is_cleared()
        )
        if show_recent_settlement_header:
            monster = self._main_recent_settlement_monster(recent_settlement)
        elif retained_record is not None:
            from types import SimpleNamespace
            monster = SimpleNamespace(**retained_record['monster'])
        boss_values = self._main_boss_display_values(
            monster, force_defeated=model_terminal_victory
        )
        if live_hud_boss_state is not None:
            boss_values["live_hud_boss"] = True
            boss_values["boss_icon"] = str(live_hud_boss_state.get("icon") or "")
        if live_no_boss:
            boss_values = {
                "boss_name": "当前没有Boss · 小怪战斗",
                "boss_available": True,
                "boss_template_id": 0,
                "boss_icon": "live-small-monsters-v2.png",
                "live_no_boss": True,
                "boss_level": None,
                "boss_hp": "",
                "boss_percent": "",
                "boss_ratio": None,
            }
        boss_reader = getattr(self.model, 'current_bosses', None)
        if live_no_boss:
            display_bosses = [boss_values]
        elif show_recent_settlement_header:
            display_bosses = [boss_values]
        elif retained_record:
            retained_bosses = retained_record.get('bosses') or [boss_values]
            if model_terminal_victory:
                # Older retained rows can contain one last positive frame.
                # Preserve the dual-Boss layout while replacing only the
                # terminal health fields.
                display_bosses = []
                for raw_boss in retained_bosses:
                    row = dict(raw_boss) if isinstance(raw_boss, dict) else {}
                    row["boss_ratio"] = 0.0
                    row["boss_percent"] = "0%"
                    raw_hp = str(row.get("boss_hp") or "")
                    if "/" in raw_hp:
                        row["boss_hp"] = "0 / " + raw_hp.split("/", 1)[1].strip()
                    else:
                        row["boss_hp"] = raw_hp
                    display_bosses.append(row)
                if not display_bosses:
                    display_bosses = [boss_values]
            else:
                display_bosses = retained_bosses
        else:
            monsters = (list(boss_reader()) if callable(boss_reader) else [])[:MAX_SIMULTANEOUS_BOSSES]
            if len(monsters) > 1 and any(
                int(getattr(value, 'template_id', 0) or 0) in
                (FIRST_BELIEVER_BARNEY_TEMPLATE_IDS | FIRST_BELIEVER_ANXIA_TEMPLATE_IDS)
                for value in monsters
            ):
                owner = enrage_marker_row_index(monsters)
                if owner > 0:
                    # Keep the forecast over its existing phase owner: Barney
                    # first, then Anxia when the existing phase rule advances.
                    monsters = [monsters[owner], *monsters[:owner], *monsters[owner + 1:]]
            display_bosses = [
                self._main_boss_display_values(
                    value, force_defeated=model_terminal_victory
                )
                for value in monsters
            ]
            if not display_bosses:
                display_bosses = [boss_values]

        prediction_value: dict[str, object] | None = None
        prediction = getattr(self, "enrage_prediction", None)
        if (
            not live_no_boss
            and bool(getattr(self, "boss_enrage_prediction_enabled", True))
            and bool(getattr(self, "enrage_prediction_visible", False))
            and prediction is not None
            and not bool(getattr(prediction, "calculating", False))
        ):
            prediction_value = {
                "state": str(getattr(prediction, "state", "") or ""),
                "message": str(getattr(prediction, "message", "") or ""),
                "marker": enrage_marker_ratio(prediction),
            }

        physical_row_height = max(
            1,
            logical_pixels_to_physical(
                HUD_ROW_HEIGHT * float(getattr(self, "main_ui_scale", 1.0) or 1.0),
                getattr(self, "window_dpi", DEFAULT_DPI),
            ),
        )
        visible_rows = clamp_visible_rows(
            getattr(self, "main_visible_rows", HUD_DEFAULT_VISIBLE_ROWS)
        )
        recent_section = next(
            (
                row
                for row in display_rows
                if row.get("row_kind") == "section"
            ),
            None,
        )
        if (
            not pve_team_view
            and not startup_blocked
            and bool(getattr(self, "show_team_dps", True))
        ):
            if recent_section is None:
                recent_section = {
                    "row_kind": "section",
                    "section_text": "实时战斗/战斗记录",
                }
                display_rows.insert(0, recent_section)
            recent_section["live_team_dps"] = (
                self._main_live_team_dps_text(display_rows) or "--"
            )
            recent_section["live_dps_caption"] = (
                "实时玩家秒伤" if is_dummy else "实时团队秒伤"
            )
        if recent_section is not None:
            # Retain the user's chosen list capacity, with room for the pinned
            # self row, heading, optional Boss card and one result/message row.
            expanded_minimum = 4 if any(
                row.get("row_kind") == "recent_boss" for row in display_rows
            ) else 3
            visible_rows = max(expanded_minimum, visible_rows)
        maximum_start = max(0, len(display_rows) - visible_rows)
        start_index = min(
            maximum_start,
            max(0, int(getattr(self, "main_scroll_offset", 0)) // physical_row_height),
        )
        try:
            topmost = self._preferred_main_topmost()
        except (AttributeError, tk.TclError):
            topmost = bool(self.config.get("topmost", True))
        team_rating_footer_enabled = bool(
            TEAM_RATING_PREVIEW_AVAILABLE
            and getattr(self, "team_rating_preview_enabled", False)
        )
        if pve_team_view:
            team_dps_summary_text = (
                self._main_team_rating_summary_text()
                if team_rating_footer_enabled
                else "0"
            )
        else:
            team_dps_summary_text = (
                self._main_recent_battle_team_dps_text() or "--"
            )
        display_rows = [
            row if row.get("row_kind") or row.get("is_ai") else {
                **row, **self._equipment_refresh_fields(
                    int(row.get("actor_id", 0) or 0), row.get("user_token", ""),
                ),
            }
            for row in display_rows
        ]
        return {
            "time": self._main_display_time_text(
                recent_settlement if show_recent_settlement_header else None,
                retained_record,
            ),
            **boss_values,
            'bosses': display_bosses,
            "prediction": None if retained_record or show_recent_settlement_header or self._main_display_is_cleared() else prediction_value,
            "rows": display_rows,
            "application_rows": application_rows,
            "rating_preview": rating_preview,
            "pve_hud_view": (
                "team" if pve_team_view else "recent_battle"
            ),
            "start_index": start_index,
            "visible_rows": visible_rows,
            "show_time": bool(getattr(self, "show_combat_time", True)),
            "show_boss": bool(getattr(self, "show_boss_hp_bar", True)),
            "show_totals": bool(getattr(self, "show_main_totals", True)),
            "show_deaths": bool(getattr(self, "show_deaths", True)),
            "show_team_dps": bool(getattr(self, "show_team_dps", True)),
            "highlight_self": bool(getattr(self, "highlight_self", True)),
            "dps_summary_caption": (
                "团队总秒伤"
                if not pve_team_view
                else "团队超凡评分"
            ),
            "team_dps": team_dps_summary_text,
            "row_mask_opacity": int(getattr(self, "main_row_mask_opacity", 0) or 0),
            "topmost": bool(topmost),
            "locked": bool(getattr(self, "window_locked", False)),
            "hover_action": str(getattr(self, "layered_main_hover_action", "") or ""),
            "clear_disabled": self._main_clear_blocked(),
            "settings_disabled": SETTINGS_TEMPORARILY_DISABLED,
            "update_status_text": str(getattr(self, "update_status_text", "") or ""),
            "update_status_action": str(getattr(self, "update_status_action", "") or ""),
            "admin_elevated": bool(getattr(self, "process_is_elevated", False)),
            "interaction_blocked": startup_blocked,
            "startup_message": startup_message,
        }

    def _main_display_time_text(self, header_record=None, retained_record=None):
        """Resolve the displayed pull's clock, independently of remaining HP."""
        live_hud_active = self._main_live_hud_projection_active()
        model = self.model
        current_monster = getattr(model, "current_monster", None)
        model_monster = current_monster() if callable(current_monster) else None
        if model_monster is None:
            current_bosses = getattr(model, "current_bosses", None)
            model_bosses = (
                list(current_bosses()) if callable(current_bosses) else []
            )
            model_monster = model_bosses[0] if model_bosses else None
        live_hud_boss = (
            self._main_live_hud_boss_state() if live_hud_active else None
        )
        if live_hud_active and (
            live_hud_boss is not None or model_monster is None
        ):
            live_hud_duration = self._main_live_hud_dps_duration()
            if live_hud_duration is not None:
                return format_duration(live_hud_duration)
            targetless_team_data = self._main_targetless_team_data()
            if targetless_team_data is not None:
                if live_hud_boss is not None:
                    started_at = float(live_hud_boss["started_at_epoch"])
                    return format_duration(max(0.0, time.time() - started_at))
                return format_duration(targetless_team_data[1])
        if self._main_display_is_cleared() or self._main_context_display_is_stale():
            if header_record is None and retained_record is None:
                live_hud_duration = self._main_live_hud_dps_duration()
                if live_hud_duration is not None:
                    return format_duration(live_hud_duration)
                targetless_team_data = self._main_targetless_team_data()
                if targetless_team_data is not None:
                    return format_duration(targetless_team_data[1])
            return "00:00"
        live_text = str(getattr(self, "main_time_text", "00:00") or "00:00")
        if getattr(model, "pending_active_boss_id", None):
            reader = getattr(model, "display_duration", None)
            return format_duration(reader()) if callable(reader) else live_text
        controller = getattr(self, "settlement_ui", None)
        tracker = getattr(controller, "tracker", None)
        active_reader = getattr(model, "combat_in_progress", None)
        if (getattr(tracker, "current_id", None)
                or (callable(active_reader) and active_reader())):
            return live_text
        record = header_record or self._main_recent_settlement_record(keep_last_settled=False)
        if record is not None:
            # The header is the displayed Boss pull clock. A final victory can
            # also carry an ALL table whose member lengths cover the entire
            # dungeon; using that cumulative clock made the last Boss show the
            # full run time (for example 13:43 instead of 05:39).
            view = encounter_view(record, statistics_scope="STAGE")
            seconds = view.get("duration_seconds")
            if seconds is None or seconds <= 0:
                seconds = max(0, (record.ended_at_ns - record.started_at_ns) / 1e9)
            return format_duration(seconds)
        if retained_record:
            return format_duration(retained_record.get("duration_seconds") or 0)
        live_hud_duration = self._main_live_hud_dps_duration()
        if live_hud_duration is not None:
            return format_duration(live_hud_duration)
        targetless_team_data = self._main_targetless_team_data()
        if targetless_team_data is not None:
            return format_duration(targetless_team_data[1])
        reader = getattr(model, "display_duration", None)
        return format_duration(reader()) if callable(reader) else live_text

    def _render_layered_main_hud(self) -> None:
        if (
            not self._layered_main_active()
            or self.closing
            or bool(getattr(self, "layered_main_rendering", False))
        ):
            return
        self.layered_main_rendering = True
        paint_started = time.perf_counter()
        try:
            if self.root.state() != "normal":
                return
            renderer = self.layered_main_renderer
            presenter = self.layered_main_presenter
            if renderer is None or presenter is None:
                return
            pixel_scale = (
                float(getattr(self, "window_dpi", DEFAULT_DPI)) / DEFAULT_DPI
            ) * float(getattr(self, "main_ui_scale", 1.0) or 1.0)
            settings_open = bool(getattr(self, "hud_settings_open", False))
            if settings_open:
                snapshot = {"rows": ()}
                settings_image, settings_regions = render_hud_settings(
                    self._hud_settings_values(),
                    self.hud_settings_page,
                    str(renderer.font_paths["name"]),
                    pixel_scale,
                )
                result = HudRenderResult(
                    settings_image, settings_regions, (), 1, 1
                )
            else:
                snapshot = self._layered_main_snapshot()
                if (
                    not self._main_retained_battle_active()
                    and self._main_has_battle_values()
                ):
                    self.main_last_live_display_snapshot = dict(
                        encounter_id=getattr(self.model, 'encounter_id', ''),
                        bosses=snapshot.get('bosses', []),
                    )
                cache = getattr(self, "layered_main_frame_cache", None)
                if cache is None:
                    cache = self.layered_main_frame_cache = HudRenderCache()
                result = cache.render(
                    renderer, snapshot,
                    pixel_scale=pixel_scale,
                    font_size=int(getattr(self, "ui_font_size", 14) or 14),
                    assume_snapshot_immutable=False,
                )
            width, height = result.image.size
            try:
                # Retired Tk layout helpers may reapply their old minimum
                # after a settings change. The new HUD's actual art bounds
                # (including removal of the death column) are authoritative.
                self.root.minsize(1, 1)
                x, y = self.root.winfo_x(), self.root.winfo_y()
                target_x, target_y = x, y
                anchor_bounds = getattr(self, "hud_settings_anchor_bounds", None)
                work_area = getattr(self, "hud_settings_work_area", None)
                restore_position = getattr(
                    self, "hud_settings_restore_position", None
                )
                if settings_open and anchor_bounds is not None and work_area is not None:
                    target_x, target_y = settings_panel_position(
                        anchor_bounds, (width, height), work_area
                    )
                elif not settings_open and restore_position is not None:
                    target_x, target_y = restore_position
                if (
                    (self.root.winfo_width(), self.root.winfo_height())
                    != (width, height)
                    or (x, y) != (target_x, target_y)
                ):
                    self.root.geometry(
                        format_absolute_tk_geometry(
                            width, height, target_x, target_y
                        )
                    )
                    self.root.update_idletasks()
                if not settings_open and restore_position is not None:
                    self.hud_settings_restore_position = None
                    self.hud_settings_anchor_bounds = None
                    self.hud_settings_work_area = None
            except (AttributeError, TypeError, ValueError, tk.TclError):
                pass
            self.layered_main_hit_regions = dict(result.hit_regions)
            self.layered_main_actor_regions = result.actor_regions
            self.layered_main_visible_rows = result.visible_rows
            row_total = len(snapshot.get("rows", ()))
            viewport_rows = max(1, result.visible_rows)
            self.main_scroll_content_height = max(
                result.row_height * viewport_rows,
                result.row_height * row_total,
            )
            maximum_offset = max(
                0,
                self.main_scroll_content_height - result.row_height * viewport_rows,
            )
            self.main_scroll_offset = min(
                maximum_offset,
                max(0, int(getattr(self, "main_scroll_offset", 0))),
            )
            try:
                visible = self.root.state() == "normal"
            except (AttributeError, tk.TclError):
                visible = True
            if visible:
                presenter.present(
                    result.image,
                    opacity=1.0,
                )
            self.layered_main_last_image = result.image
            self.layered_main_last_error = ""
            if visible and self.window_locked:
                self._sync_unlock_window_position()
        except (AttributeError, OSError, RuntimeError, TypeError, ValueError, tk.TclError) as exc:
            # A single paint failure must never interrupt combat collection.
            error = f"{type(exc).__name__}: {exc}"
            if error != getattr(self, "layered_main_last_error", ""):
                print(f"[main-hud] {error}", file=sys.stderr)
                self.layered_main_last_error = error
            return
        finally:
            finished = time.perf_counter()
            self.layered_main_paint_finished_at = finished
            self.layered_main_paint_ms = (finished - paint_started) * 1000.0
            self.layered_main_peak_paint_ms = max(
                getattr(self, "layered_main_peak_paint_ms", 0.0), self.layered_main_paint_ms)
            self.layered_main_rendering = False

    def _layered_main_region_at(self, x: int, y: int) -> str:
        regions = getattr(self, "layered_main_hit_regions", {})
        for key, rect in regions.items():
            if not key.startswith(("action:", "equipment_refresh_pending:")):
                continue
            left, top, right, bottom = rect
            if left <= x <= right and top <= y <= bottom:
                return key
        for key, rect in regions.items():
            left, top, right, bottom = rect
            if left <= x <= right and top <= y <= bottom:
                return "prediction" if key == "prediction_marker" else key
        return ""

    def _layered_main_motion(self, event) -> None:
        if (
            not self._layered_main_active()
            or self.window_locked
        ):
            return
        region = self._layered_main_region_at(int(event.x), int(event.y))
        if (self._startup_interaction_blocked()
                and not getattr(self, "hud_settings_open", False)
                and region != "action:settings"):
            region = ""
        action = region.removeprefix("action:") if region.startswith("action:") else ""
        cursor = (
            "sb_v_double_arrow"
            if region in {"resize:height", "scrollbar:rows"}
            else "fleur"
            if region == "drag:window"
            else "hand2"
            if action
            else "arrow"
        )
        if cursor != getattr(self, "layered_main_cursor", ""):
            try:
                self.root.configure(cursor=cursor)
                self.layered_main_cursor = cursor
                self._schedule_layered_main_render()
            except tk.TclError:
                pass
        if action != getattr(self, "layered_main_hover_action", ""):
            self.layered_main_hover_action = action
            self._schedule_layered_main_render()
        if region == "prediction":
            tooltip = getattr(self, "enrage_tooltip", None)
            if tooltip is None or not tooltip.winfo_exists():
                self._show_enrage_tooltip(event)
        else:
            self._hide_enrage_tooltip()

    def _layered_main_leave(self, _event=None) -> None:
        if getattr(self, "layered_main_hover_action", ""):
            self.layered_main_hover_action = ""
            self._schedule_layered_main_render()
        self._hide_enrage_tooltip()

    def _layered_main_press(self, event) -> None:
        if (
            not self._layered_main_active()
            or self.window_locked
        ):
            return
        region = self._layered_main_region_at(int(event.x), int(event.y))
        startup_blocked = self._startup_interaction_blocked()
        if (startup_blocked and not getattr(self, "hud_settings_open", False)
                and region != "action:settings"):
            return
        self.layered_main_press_action = (
            region.removeprefix("action:") if region.startswith("action:") else ""
        )
        self.layered_main_press_origin = (int(event.x_root), int(event.y_root))
        self.layered_main_drag_armed = (
            not startup_blocked
            and not getattr(self, "hud_settings_open", False)
            and region not in {"action:update", "action:download_update", "action:settings"}
            and region not in {"scrollbar:rows", "resize:height"}
            and not region.startswith("action:refresh_equipment:")
            and not region.startswith("equipment_refresh_pending:")
            and region not in {
                "action:pve_recent_battle",
                "action:pve_team",
                "action:web_database",
            }
        )
        self.layered_main_scroll_drag_origin = None
        self.layered_main_dragged = False
        self.layered_main_resize_origin = None
        if region == "scrollbar:rows":
            snapshot = self._layered_main_snapshot()
            rows = snapshot.get("rows", ())
            visible_rows = max(
                1,
                int(snapshot.get("visible_rows", 1) or 1),
            )
            row_height = max(1, self._main_row_height())
            maximum_offset = max(
                0, row_height * (len(rows) - visible_rows)
            )
            scrollbar = getattr(
                self, "layered_main_hit_regions", {}
            ).get("scrollbar:rows")
            if maximum_offset and scrollbar is not None:
                _left, track_top, _right, track_bottom = scrollbar
                track_height = max(1, int(track_bottom - track_top))
                thumb_height = max(
                    1,
                    round(row_height * 12 / 75.4),
                    round(track_height * visible_rows / max(1, len(rows))),
                )
                travel = max(1, track_height - thumb_height)
                pointed_ratio = min(
                    1.0,
                    max(
                        0.0,
                        (int(event.y) - track_top - thumb_height / 2)
                        / travel,
                    ),
                )
                self.main_scroll_offset = round(
                    maximum_offset * pointed_ratio
                )
                self.main_scroll_content_height = row_height * len(rows)
                self.layered_main_scroll_drag_origin = (
                    int(event.y_root),
                    int(self.main_scroll_offset),
                    travel,
                    maximum_offset,
                )
                self._schedule_layered_main_render()
            return
        if region == "resize:height":
            self.layered_main_resize_origin = (
                int(event.y_root),
                int(getattr(self, "layered_main_visible_rows", 1)),
                self._main_row_height(),
            )
            self._hide_enrage_tooltip()
            return
        if self.layered_main_drag_armed:
            self._drag_start(event, self.root)

    def _layered_main_drag(self, event) -> None:
        origin = getattr(self, "layered_main_press_origin", None)
        if (
            origin is None
            or self.window_locked
            or self._startup_interaction_blocked()
        ):
            return
        resize = getattr(self, "layered_main_resize_origin", None)
        if resize is not None:
            y, rows, row_height = resize
            capacity = clamp_visible_rows(rows + int(round((int(event.y_root) - y) / max(1, row_height))))
            if capacity != getattr(
                self, "main_visible_rows", HUD_DEFAULT_VISIBLE_ROWS
            ):
                self.main_visible_rows = capacity
                self._schedule_layered_main_render()
            return
        scroll_drag = getattr(
            self, "layered_main_scroll_drag_origin", None
        )
        if scroll_drag is not None:
            origin_y, origin_offset, travel, maximum_offset = scroll_drag
            next_offset = min(
                maximum_offset,
                max(
                    0,
                    origin_offset
                    + round(
                        (int(event.y_root) - origin_y)
                        * maximum_offset
                        / max(1, travel)
                    ),
                ),
            )
            if next_offset != getattr(self, "main_scroll_offset", 0):
                self.main_scroll_offset = next_offset
                self._schedule_layered_main_render()
            return
        if not getattr(self, "layered_main_drag_armed", False):
            return
        delta_x = int(event.x_root) - origin[0]
        delta_y = int(event.y_root) - origin[1]
        if (
            delta_x * delta_x + delta_y * delta_y
            >= LAYERED_MAIN_DRAG_THRESHOLD * LAYERED_MAIN_DRAG_THRESHOLD
        ):
            self.layered_main_dragged = True
        if self.layered_main_dragged:
            self._drag_move(event, self.root)

    def _layered_main_release(self, event) -> None:
        if (
            not self._layered_main_active()
            or self.window_locked
        ):
            return
        pressed = str(getattr(self, "layered_main_press_action", "") or "")
        if (self._startup_interaction_blocked()
                and not getattr(self, "hud_settings_open", False)
                and pressed != "settings"):
            return
        dragged = bool(getattr(self, "layered_main_dragged", False))
        drag_armed = bool(getattr(self, "layered_main_drag_armed", False))
        self.layered_main_press_action = ""
        self.layered_main_press_origin = None
        self.layered_main_drag_armed = False
        self.layered_main_dragged = False
        if getattr(self, "layered_main_scroll_drag_origin", None) is not None:
            self.layered_main_scroll_drag_origin = None
            self._schedule_layered_main_render()
            return
        if getattr(self, "layered_main_resize_origin", None) is not None:
            self.layered_main_resize_origin = None
            self.config[MAIN_VISIBLE_ROWS_CONFIG_KEY] = clamp_visible_rows(
                getattr(self, "main_visible_rows", HUD_DEFAULT_VISIBLE_ROWS)
            )
            save_config(self.config)
            self._schedule_layered_main_render()
            return
        if drag_armed:
            self._drag_end(event, self.root)
        if not pressed:
            if drag_armed:
                self._schedule_layered_main_render()
            return
        released = self._layered_main_region_at(int(event.x), int(event.y))
        if getattr(self, "hud_settings_open", False):
            if not dragged and released == f"action:{pressed}":
                self._apply_hud_settings_action(pressed)
            return
        footer_action = pressed in {"update", "settings", "lock", "pin"}
        if dragged or (
            released != f"action:{pressed}" and not footer_action
        ):
            return
        if pressed.startswith("refresh_equipment:"):
            self._schedule_team_equipment_profiles(
                refresh_token=pressed.removeprefix("refresh_equipment:")
            )
            self._schedule_layered_main_render()
        elif pressed == "pve_recent_battle":
            self._set_pve_hud_view("recent_battle")
        elif pressed == "pve_team":
            self._set_pve_hud_view("team")
        elif pressed == "web_database":
            webbrowser.open(WEB_DATABASE_URL, new=2)
        elif pressed == "update":
            self._start_update_check(manual=True)
        elif pressed == "download_update":
            if getattr(self, "update_status_action", "") == "download_update":
                self._download_pending_update()
        elif pressed == "settings":
            if not SETTINGS_TEMPORARILY_DISABLED:
                self.show_settings()
        elif pressed == "clear":
            if not self._main_clear_blocked():
                self._clear_main_display()
        elif pressed == "pin":
            self.toggle_topmost()
        elif pressed == "lock":
            self.toggle_window_lock()
        elif pressed == "close":
            self._request_close()

    def _sync_main_component_visibility(self) -> None:
        """Apply display toggles without rebuilding or restarting the meter."""

        if self._layered_main_active():
            self._hide_enrage_tooltip()
            self._schedule_layered_main_render()
            return

        if bool(getattr(self, "show_combat_time", True)):
            self.titlebar.configure(height=self._main_px(MAIN_TITLE_HEIGHT))
            if not self.titlebar.winfo_manager():
                before = (
                    self.summary
                    if self.summary.winfo_manager()
                    else self.table_panel
                )
                self.titlebar.pack(fill="x", before=before)
            if not self.time_value.winfo_manager():
                self.time_value.pack(side="left", anchor="w")
        else:
            self.time_value.pack_forget()
            self.titlebar.pack_forget()

        if bool(getattr(self, "show_boss_hp_bar", True)):
            self.summary.configure(height=self._main_px(MAIN_BOSS_HEIGHT))
            if not self.summary.winfo_manager():
                self.summary.pack(fill="x", before=self.table_panel)
        else:
            self.summary.pack_forget()
            self._hide_enrage_tooltip()

        if bool(getattr(self, "show_team_dps", True)):
            if not self.team_dps_group.winfo_manager():
                self.team_dps_group.pack(side="left", fill="y")
        else:
            self.team_dps_group.pack_forget()

    def _refresh_main_scale_layout(self) -> None:
        self.titlebar.configure(height=self._main_px(MAIN_TITLE_HEIGHT))
        if isinstance(self.time_value, tk.Canvas):
            self.time_value.configure(
                width=self._main_px(66),
                height=self._main_px(MAIN_TITLE_HEIGHT),
            )
            self._draw_main_time_value()
        if isinstance(getattr(self, "team_dps_caption", None), tk.Canvas):
            self.team_dps_caption.configure(
                width=self._main_px(145),
                height=self._main_px(MAIN_FOOTER_HEIGHT),
            )
            self._draw_team_dps_value()
        self.summary.configure(height=self._main_px(MAIN_BOSS_HEIGHT))
        self.monster_hp_canvas.configure(height=self._main_px(MAIN_BOSS_HEIGHT))
        self.footer.configure(height=self._main_px(MAIN_FOOTER_HEIGHT))
        for button in (
            self.update_button,
            self.settings_button,
            self.pin_button,
            self.lock_button,
            self.close_button,
        ):
            button.configure(
                width=self._main_px(MAIN_ACTION_SIZE),
                height=self._main_px(MAIN_ACTION_SIZE),
            )
            self._sync_main_icon_button_visual(button)
        logo_size = max(20, int(round(27 * self.main_ui_scale)))
        logo_image = self.icons.app_logo(logo_size)
        self.main_logo.configure(image=logo_image)
        self.main_logo.image = logo_image
        self.resize_grip.place_configure(
            width=self._main_px(10), height=self._main_px(10)
        )
        self.root.minsize(self._main_minimum_width(), MAIN_MIN_HEIGHT)
        if self._layered_main_active():
            self.root.minsize(1, 1)
            self._schedule_layered_main_render()

    def _sync_main_content_height(self, row_count: int) -> None:
        """Keep Boss, rows, and footer touching with no opaque dead region."""

        if self._layered_main_active():
            return

        visible_rows = max(1, min(MAIN_MAX_VISIBLE_ROWS, int(row_count or 0)))
        rows_height = visible_rows * self._main_row_height()
        try:
            if int(self.rows_canvas.cget("height")) != rows_height:
                self.rows_canvas.configure(height=rows_height)
        except (AttributeError, TypeError, ValueError, tk.TclError):
            pass

        title_height = (
            self._main_px(MAIN_TITLE_HEIGHT)
            if bool(getattr(self, "show_combat_time", True))
            else 0
        )
        boss_height = (
            self._main_px(MAIN_BOSS_HEIGHT)
            if bool(getattr(self, "show_boss_hp_bar", True))
            else 0
        )
        footer_height = self._main_px(MAIN_FOOTER_HEIGHT)
        target_height = max(
            MAIN_MIN_HEIGHT,
            title_height + boss_height + rows_height + footer_height,
        )
        try:
            if id(self.root) in getattr(self, "resize_state", {}):
                return
            width = max(self._main_minimum_width(), self.root.winfo_width())
            if abs(self.root.winfo_height() - target_height) > 1:
                self.root.geometry(f"{width}x{target_height}")
        except (AttributeError, TypeError, ValueError, tk.TclError):
            return


    def _main_icon_button(
        self, parent: tk.Misc, icon_name: str, description: str, command
    ) -> tk.Label:
        tile_size = max(24, int(round(MAIN_ACTION_SIZE * self.main_ui_scale)))
        main_action_icon = getattr(self.icons, "main_action", None)
        image = (
            main_action_icon(icon_name, tile_size, TEXT)
            if callable(main_action_icon)
            else self.icons.toolbar(icon_name, max(14, tile_size - 10), TEXT)
        )
        label = tk.Label(
            parent,
            image=image,
            bg=MAIN_TRANSPARENT_KEY,
            width=self._main_px(MAIN_ACTION_SIZE),
            height=self._main_px(MAIN_ACTION_SIZE),
            bd=0,
            cursor="hand2",
        )
        label.image = image
        label._disabled = False
        label._description = description
        label._icon_name = icon_name
        label._normal_color = TEXT
        label._hovered = False
        label.bind(
            "<Enter>",
            lambda _event: self._main_icon_enter(label),
        )
        label.bind(
            "<Leave>",
            lambda _event: self._main_icon_leave(label),
        )
        label.bind(
            "<ButtonRelease-1>",
            lambda event: self._fallback_main_icon_release(event, label, command),
        )
        return label

    def _fallback_main_press(self, event) -> None:
        startup_blocked = self._startup_interaction_blocked()
        settings_button = getattr(self, 'settings_button', None)
        settings_press = (
            settings_button is not None
            and getattr(event, 'widget', None) is settings_button
        )
        if (self._layered_main_active() or self.window_locked
                or (startup_blocked and not settings_press)
                or id(self.root) in self.resize_state):
            return
        self.main_fallback_press_origin = (int(event.x_root), int(event.y_root))
        self.main_fallback_dragged = False
        if not startup_blocked:
            self._drag_start(event, self.root)

    def _fallback_main_drag(self, event) -> None:
        origin = getattr(self, 'main_fallback_press_origin', None)
        if (self._layered_main_active() or origin is None or self.window_locked
                or self._startup_interaction_blocked()
                or id(self.root) in self.resize_state):
            return
        dx, dy = int(event.x_root) - origin[0], int(event.y_root) - origin[1]
        if dx * dx + dy * dy >= LAYERED_MAIN_DRAG_THRESHOLD ** 2:
            self.main_fallback_dragged = True
        if self.main_fallback_dragged:
            self._drag_move(event, self.root)

    def _fallback_main_release(self, event) -> None:
        if self._layered_main_active():
            return
        self._drag_end(event, self.root)
        self.main_fallback_press_origin = None
        self.main_fallback_dragged = False

    def _fallback_main_icon_release(self, event, label, command) -> None:
        if (self.window_locked
                or (self._startup_interaction_blocked()
                    and label is not getattr(self, 'settings_button', None))
                or getattr(label, '_disabled', False)
                or getattr(self, 'main_fallback_dragged', False)):
            return
        origin = getattr(self, 'main_fallback_press_origin', None)
        if origin is None:
            return
        dx, dy = int(event.x_root) - origin[0], int(event.y_root) - origin[1]
        if dx * dx + dy * dy >= LAYERED_MAIN_DRAG_THRESHOLD ** 2:
            return
        if not (0 <= event.x < label.winfo_width() and 0 <= event.y < label.winfo_height()):
            return
        self._hide_main_tooltip()
        command()

    def _render_main_icon_button(
        self,
        button: tk.Label,
        color: str,
        background: str = MAIN_TRANSPARENT_KEY,
    ) -> None:
        del background
        tile_size = max(
            24,
            int(
                round(
                    MAIN_ACTION_SIZE
                    * float(getattr(self, "main_ui_scale", 1.0) or 1.0)
                )
            ),
        )
        main_action_icon = getattr(self.icons, "main_action", None)
        image = (
            main_action_icon(
                button._icon_name,
                tile_size,
                color,
                hovered=(
                    bool(getattr(button, "_hovered", False))
                    and not bool(getattr(button, "_disabled", False))
                ),
            )
            if callable(main_action_icon)
            else self.icons.toolbar(
                button._icon_name, max(14, tile_size - 10), color
            )
        )
        button.configure(image=image, bg=MAIN_TRANSPARENT_KEY)
        button.image = image

    def _sync_main_icon_button_visual(self, button: tk.Label) -> None:
        hovered = bool(getattr(button, "_hovered", False)) and not bool(
            getattr(button, "_disabled", False)
        )
        self._render_main_icon_button(
            button,
            ACCENT if hovered else button._normal_color,
            "#18232d" if hovered else MAIN_TRANSPARENT_KEY,
        )

    def _main_icon_enter(self, button: tk.Label) -> None:
        button._hovered = True
        self._sync_main_icon_button_visual(button)
        self._hide_main_tooltip()
        if str(getattr(button, "_description", "") or "").strip():
            self.main_tooltip_after_id = self.root.after(
                450,
                lambda target=button: self._show_main_tooltip(target),
            )

    def _main_icon_leave(self, button: tk.Label) -> None:
        button._hovered = False
        self._hide_main_tooltip()
        self._sync_main_icon_button_visual(button)

    def _show_main_tooltip(self, button: tk.Label) -> None:
        self.main_tooltip_after_id = None
        if (
            not bool(getattr(button, "_hovered", False))
            or not button.winfo_exists()
            or self.closing
        ):
            return
        description = str(getattr(button, "_description", "") or "").strip()
        if not description:
            return
        try:
            popup = tk.Toplevel(self.root)
            self.main_tooltip = popup
            popup.withdraw()
            popup.overrideredirect(True)
            popup.configure(bg="#28465d")
            popup.transient(self.root)
            body = tk.Label(
                popup,
                text=description,
                bg="#101923",
                fg="#e8eef5",
                padx=9,
                pady=5,
                bd=0,
                font=self._ui_font("main_micro"),
            )
            body.pack(fill="both", expand=True, padx=1, pady=1)
            popup.update_idletasks()
            popup_width = popup.winfo_reqwidth()
            popup_height = popup.winfo_reqheight()
            x, y = help_popup_position(
                button.winfo_rootx(),
                button.winfo_rooty(),
                button.winfo_width(),
                button.winfo_height(),
                popup_width,
                popup_height,
                monitor_work_area_for_widget(button),
            )
            popup.geometry(
                format_absolute_tk_geometry(
                    popup_width, popup_height, x, y
                )
            )
            popup.deiconify()
            self._set_window_topmost_noactivate(
                popup, self._preferred_main_topmost() or self.window_locked
            )
        except (AttributeError, tk.TclError):
            self._hide_main_tooltip()

    def _hide_main_tooltip(self) -> None:
        if getattr(self, "main_tooltip_after_id", None) is not None:
            try:
                self.root.after_cancel(self.main_tooltip_after_id)
            except tk.TclError:
                pass
            self.main_tooltip_after_id = None
        tooltip = getattr(self, "main_tooltip", None)
        if tooltip is not None and tooltip.winfo_exists():
            tooltip.destroy()
        self.main_tooltip = None

    def _request_close(self) -> None:
        """Ask before entering the existing safe capture shutdown path."""

        if self.closing:
            return
        self._hide_main_tooltip()
        self._show_notice(
            "退出程序",
            "退出前会安全停止采集，并保存当前战斗数据。\n确定退出叨叨诡秘助手吗？",
            parent=self.root,
            confirm_text="退出",
            cancel_text="取消",
            on_confirm=self.close,
        )

    def _destroy_main_content_overlay(self) -> None:
        if self.main_content_overlay_sync_after_id is not None:
            try:
                self.root.after_cancel(self.main_content_overlay_sync_after_id)
            except tk.TclError:
                pass
            self.main_content_overlay_sync_after_id = None
        window = self.main_content_overlay_window
        if window is not None and window.winfo_exists():
            window.destroy()
        self.main_content_overlay_window = None
        self.main_content_overlay_rows = None
        self.main_content_overlay_root_geometry = None
        self.main_content_overlay_click_through_ready = False
        self.main_content_overlay_topmost = None

    def _main_content_overlay_requested(self) -> bool:
        # Schema v1 removed DPS bars, so the legacy opaque-bar HWND must never
        # be created even when an upgraded config still stores the old flag.
        return False

    def _hide_main_content_overlay(self) -> None:
        self.main_content_overlay_root_geometry = None
        window = getattr(self, "main_content_overlay_window", None)
        if window is not None and window.winfo_exists():
            try:
                window.withdraw()
            except tk.TclError:
                pass

    def _ensure_main_content_overlay(self) -> bool:
        if not self.main_content_overlay_supported:
            return False
        window = self.main_content_overlay_window
        if window is not None and window.winfo_exists():
            return True
        try:
            window = tk.Toplevel(self.root)
            window.withdraw()
            self._prepare_toplevel_dpi(window)
            window.title(f"{UI_BRAND} · 前景内容")
            window.configure(bg=MAIN_CONTENT_OVERLAY_KEY)
            window.overrideredirect(True)
            window.transient(self.root)
            window.attributes("-alpha", DPS_BAR_COLOR_STRENGTH)
            window.attributes("-transparentcolor", MAIN_CONTENT_OVERLAY_KEY)
            self.main_content_overlay_window = window
            self.main_content_overlay_rows = tk.Canvas(
                window,
                bg=MAIN_CONTENT_OVERLAY_KEY,
                bd=0,
                highlightthickness=0,
                yscrollincrement=1,
            )
            window.update_idletasks()
            hwnd = self._win32_root_handle(window)
            style = self._win32_extended_style(hwnd)
            if style is None or not self._set_win32_extended_style(
                hwnd,
                style
                | WINDOW_EXSTYLE_TRANSPARENT
                | WINDOW_EXSTYLE_TOOLWINDOW
                | WINDOW_EXSTYLE_LAYERED
                | WINDOW_EXSTYLE_NOACTIVATE,
            ):
                raise tk.TclError("could not configure the content overlay")
            self.main_content_overlay_click_through_ready = True
            return True
        except (AttributeError, OSError, tk.TclError):
            self.main_content_overlay_supported = False
            self._destroy_main_content_overlay()
            return False

    def _schedule_main_content_overlay_sync(self, *, restart: bool = False) -> None:
        if self.closing or not self.main_content_overlay_supported:
            return
        if not self._main_content_overlay_requested():
            self._hide_main_content_overlay()
            return
        if self.main_content_overlay_sync_after_id is not None:
            if not restart:
                return
            try:
                self.root.after_cancel(self.main_content_overlay_sync_after_id)
            except tk.TclError:
                pass
            self.main_content_overlay_sync_after_id = None
        try:
            self.main_content_overlay_sync_after_id = self.root.after(
                16,
                self._sync_main_content_overlay
            )
        except tk.TclError:
            self.main_content_overlay_sync_after_id = None

    @staticmethod
    def _place_overlay_canvas(
        canvas: tk.Canvas,
        source: tk.Misc,
        root_x: int,
        root_y: int,
    ) -> bool:
        if not source.winfo_ismapped():
            canvas.place_forget()
            return False
        width = max(1, source.winfo_width())
        height = max(1, source.winfo_height())
        canvas.place(
            x=source.winfo_rootx() - root_x,
            y=source.winfo_rooty() - root_y,
            width=width,
            height=height,
        )
        return True

    def _main_content_overlay_layout(
        self,
    ) -> tuple[tuple[int, ...], tuple[int, int, int, int]] | None:
        source = self.rows_canvas
        if not source.winfo_ismapped():
            return None
        root_geometry = (
            self.root.winfo_rootx(),
            self.root.winfo_rooty(),
            max(1, self.root.winfo_width()),
            max(1, self.root.winfo_height()),
        )
        content_geometry = (
            source.winfo_rootx(),
            source.winfo_rooty(),
            max(1, source.winfo_width()),
            max(1, source.winfo_height()),
        )
        bounds = clipped_overlay_bounds(*root_geometry, *content_geometry)
        if bounds is None:
            return None
        return (*root_geometry, *content_geometry), bounds

    def _sync_main_content_overlay(self) -> None:
        self.main_content_overlay_sync_after_id = None
        if self.closing or not self.root.winfo_exists():
            self._destroy_main_content_overlay()
            return
        if (
            not self._main_content_overlay_requested()
            or self.root.state() != "normal"
        ):
            self._hide_main_content_overlay()
            return
        if not self._ensure_main_content_overlay():
            # Overlay creation can be unavailable on a particular Windows
            # build.  Restore the ordinary translucent rows immediately.
            self._draw_main_rows_on_canvas(
                self.rows_canvas, update_scroll_state=True
            )
            return
        window = self.main_content_overlay_window
        rows_canvas = self.main_content_overlay_rows
        if window is None or rows_canvas is None:
            return
        try:
            self.root.update_idletasks()
            layout = self._main_content_overlay_layout()
            if layout is None:
                self._hide_main_content_overlay()
                self._draw_main_rows_on_canvas(
                    self.rows_canvas, update_scroll_state=True
                )
                return
            geometry_signature, overlay_bounds = layout
            overlay_x, overlay_y, overlay_width, overlay_height = overlay_bounds
            if geometry_signature != self.main_content_overlay_root_geometry:
                # Never leave the old top-level visible while its owner is
                # moving or changing layout. A stale independent HWND is the
                # source of duplicate bars seen outside the meter.
                if window.state() == "normal":
                    window.withdraw()
                self._set_main_content_overlay_bounds(
                    window,
                    overlay_width,
                    overlay_height,
                    overlay_x,
                    overlay_y,
                )
                self.main_content_overlay_root_geometry = geometry_signature
            overlay_topmost = bool(self.root.attributes("-topmost"))
            if overlay_topmost != self.main_content_overlay_topmost:
                if self._set_window_topmost_noactivate(window, overlay_topmost):
                    self.main_content_overlay_topmost = overlay_topmost
            rows_visible = self._place_overlay_canvas(
                rows_canvas, self.rows_canvas, overlay_x, overlay_y
            )
            window.update_idletasks()
            if rows_visible:
                self._draw_main_rows_on_canvas(
                    self.rows_canvas,
                    update_scroll_state=True,
                    draw_bars=False,
                )
                self._draw_main_rows_on_canvas(
                    rows_canvas,
                    update_scroll_state=False,
                    draw_content=False,
                    opaque_bar_layer=True,
                )
            else:
                self._hide_main_content_overlay()
                self._draw_main_rows_on_canvas(
                    self.rows_canvas, update_scroll_state=True
                )
                return
            if window.state() != "normal":
                window.deiconify()
        except tk.TclError:
            if window.winfo_exists():
                window.withdraw()
            self._draw_main_rows_on_canvas(
                self.rows_canvas, update_scroll_state=True
            )

    def _main_window_configure(self, event) -> None:
        if event.widget is not self.root:
            return
        # A Configure event is delivered immediately during a cross-monitor
        # move.  The periodic check remains as a fallback for borderless
        # windows that do not emit a second event after Windows repositions
        # them for the new DPI.
        try:
            dpi = get_window_dpi(self.root)
            if dpi != getattr(self, "window_dpi", 0):
                self._apply_window_dpi_if_changed()
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            pass
        self._sync_titlebar_density(int(event.width))
        geometry_signature = (
            self.root.winfo_rootx(),
            self.root.winfo_rooty(),
            int(event.width),
            int(event.height),
        )
        cached_geometry = self.main_content_overlay_root_geometry
        cached_root_geometry = (
            cached_geometry[:4] if cached_geometry is not None else None
        )
        if geometry_signature != cached_root_geometry:
            overlay = self.main_content_overlay_window
            if (
                self._main_content_overlay_requested()
                and overlay is not None
                and overlay.winfo_exists()
            ):
                try:
                    overlay.withdraw()
                except tk.TclError:
                    pass
            self.main_content_overlay_root_geometry = None
            self._schedule_main_content_overlay_sync(restart=True)
        if self.window_locked:
            self._sync_unlock_window_position()

    def _main_rows_canvas_configure(self, _event=None) -> None:
        # The canvas can move within an unchanged top-level when compact mode,
        # title density, or DPI changes. Invalidate the independent overlay
        # immediately so it cannot remain at the previous screen position.
        overlay = getattr(self, "main_content_overlay_window", None)
        if (
            self._main_content_overlay_requested()
            and overlay is not None
            and overlay.winfo_exists()
        ):
            try:
                overlay.withdraw()
            except tk.TclError:
                pass
        self.main_content_overlay_root_geometry = None
        self._draw_main_rows()
        self._schedule_main_content_overlay_sync(restart=True)

    def _main_window_map_state(self, event) -> None:
        if event.widget is not self.root:
            return
        event_type = getattr(event, "type", "")
        event_name = str(getattr(event_type, "name", event_type)).casefold()
        if event_name in {"unmap", "18"}:
            overlay = self.main_content_overlay_window
            if overlay is not None and overlay.winfo_exists():
                try:
                    overlay.withdraw()
                except tk.TclError:
                    pass
            self.main_content_overlay_root_geometry = None
            if not self.main_window_intentionally_hidden:
                self.root.after(80, self._recover_accidentally_iconified_main_window)
            return
        try:
            # A withdrawn root can only provide a provisional monitor DPI.
            # Rebuild the named fonts immediately once the real HWND is mapped,
            # before the alpha foreground helper paints its first frame.
            self._apply_window_dpi_if_changed(force=True)
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            pass
        self.main_content_overlay_root_geometry = None
        self._schedule_main_content_overlay_sync()

    def _recover_accidentally_iconified_main_window(self) -> None:
        if (
            self.closing
            or self.main_window_intentionally_hidden
            or not self.root.winfo_exists()
        ):
            return
        try:
            if self.root.state() != "iconic":
                return
            self.root.overrideredirect(True)
            self.root.deiconify()
            self.root.update_idletasks()
            self._apply_window_dpi_if_changed(force=True)
            self._apply_windows_style(self.root)
            self._apply_main_transparency()
            self.root.lift()
            self.root.after(20, self._apply_window_lock_state)
        except (AttributeError, tk.TclError):
            pass

