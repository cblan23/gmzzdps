def encounter_upload_state(result: object) -> str:
    """Return the highest local milestone represented by a server receipt."""

    if not isinstance(result, EncounterUploadResult) or not result.accepted:
        return "failed"
    ranking_status = str(result.ranking_status or "").casefold()
    statistics_status = str(result.statistics_status or "").casefold()
    upload_status = str(result.upload_status or "").casefold()
    if ranking_status == "eligible" and result.rank is not None:
        return "ranked"
    if statistics_status == "included":
        return "included"
    if upload_status == "uploaded" and (
        statistics_status == "not_eligible" or ranking_status == "not_eligible"
    ):
        return "ineligible"
    return "uploaded"


def normalize_boss_name(value: object) -> str:
    return "".join(char.casefold() for char in str(value or "") if char.isalnum())


def _parsed_profession_id(value: object) -> int:
    try:
        parsed = int(value or 0)
    except (TypeError, ValueError, OverflowError):
        return 0
    return parsed if 1_200_001 <= parsed <= 1_200_007 else 0




def load_boss_name_allowlist(path: Path = BOSS_NAME_ALLOWLIST_PATH) -> tuple[str, ...]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ()
    return tuple(
        dict.fromkeys(
            normalized
            for line in lines
            if line.strip() and not line.lstrip().startswith("#")
            if (normalized := normalize_boss_name(line))
        )
    )


def boss_name_is_allowed(name: object, allowlist: tuple[str, ...]) -> bool:
    normalized = normalize_boss_name(name)
    return bool(normalized and any(item in normalized for item in allowlist))


BOSS_PHASE_NAME_GROUPS = (
    frozenset(
        {
            normalize_boss_name("先祖铠甲"),
            normalize_boss_name("伯德温·威瑟尔"),
        }
    ),
)


def boss_names_share_phase(left: object, right: object) -> bool:
    left_name = normalize_boss_name(left)
    right_name = normalize_boss_name(right)
    return bool(
        left_name
        and right_name
        and any(
            any(alias in left_name for alias in group)
            and any(alias in right_name for alias in group)
            for group in BOSS_PHASE_NAME_GROUPS
        )
    )


def boss_phase_continues(left: object, right: object) -> bool:
    left_name = normalize_boss_name(left)
    right_name = normalize_boss_name(right)
    ancestor = normalize_boss_name("先祖铠甲")
    baldwin = normalize_boss_name("伯德温·威瑟尔")
    return bool(
        left_name
        and right_name
        and ancestor in left_name
        and baldwin in right_name
    )


def load_target_identity_catalog() -> dict[str, dict]:
    """Load exact template metadata for display without promoting targets."""
    catalog = load_monster_metadata(MONSTER_METADATA_PATH)
    cached_names = load_json_object(MONSTER_NAME_CACHE_PATH)
    for template_id, name in cached_names.items():
        if isinstance(name, str) and name.strip():
            catalog.setdefault(str(template_id), {})["name"] = name.strip()
    for template_id, auxiliary in ENCOUNTER_AUXILIARY_TEMPLATES.items():
        metadata = dict(catalog.get(str(template_id), {}))
        metadata.update(
            {
                "name": auxiliary["name"],
                "encounter_auxiliary": True,
                "encounter_parent_template_ids": list(
                    auxiliary["parent_template_ids"]
                ),
            }
        )
        catalog[str(template_id)] = metadata
    return catalog


def load_monster_catalog() -> dict[str, dict]:
    catalog = load_target_identity_catalog()
    allowlist = load_boss_name_allowlist()
    if allowlist:
        filtered: dict[str, dict] = {}
        for template_id, metadata in catalog.items():
            try:
                parsed_template_id = int(template_id)
            except (TypeError, ValueError, OverflowError):
                parsed_template_id = 0
            if parsed_template_id in ENCOUNTER_NON_BOSS_TEMPLATE_IDS:
                continue
            if not boss_name_is_allowed(metadata.get("name", ""), allowlist):
                continue
            try:
                metadata_boss_type = int(metadata.get("boss_type", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                metadata_boss_type = 0
            if (
                metadata_boss_type != 3
                and parsed_template_id
                not in EXPLICIT_NON_TYPE3_BOSS_TEMPLATE_IDS
            ):
                continue
            boss_metadata = dict(metadata)
            boss_metadata["boss_type"] = 3
            filtered[template_id] = boss_metadata
        for template_id in ENCOUNTER_AUXILIARY_TEMPLATES:
            filtered[str(template_id)] = dict(catalog[str(template_id)])
        return filtered
    return catalog


def _catalog_boss_name(
    catalog: object,
    template_id: object,
) -> str:
    if not isinstance(catalog, dict):
        return ""
    try:
        parsed_template_id = int(template_id or 0)
    except (TypeError, ValueError, OverflowError):
        return ""
    metadata = catalog.get(str(parsed_template_id), {})
    if not isinstance(metadata, dict):
        return ""
    name = str(metadata.get("name", "")).strip()
    return name if name and not boss_name_is_placeholder(name) else ""


def _catalog_boss_level(
    catalog: object,
    template_id: object,
) -> int | None:
    if not isinstance(catalog, dict):
        return None
    try:
        parsed_template_id = int(template_id or 0)
    except (TypeError, ValueError, OverflowError):
        return None
    metadata = catalog.get(str(parsed_template_id), {})
    if not isinstance(metadata, dict):
        return None
    try:
        level = int(metadata.get("level", 0) or 0)
    except (TypeError, ValueError, OverflowError):
        return None
    return level if 1 <= level <= 999 else None


def _history_target_entity_ids(target: dict) -> list[int]:
    values: list[object] = [target.get("entity_id", 0)]
    grouped_ids = target.get("entity_ids", ())
    if isinstance(grouped_ids, (list, tuple, set)):
        values.extend(grouped_ids)
    entity_ids: list[int] = []
    for value in values:
        try:
            entity_id = int(value or 0)
        except (TypeError, ValueError, OverflowError):
            continue
        if entity_id and entity_id not in entity_ids:
            entity_ids.append(entity_id)
    return entity_ids


def _merge_first_believer_actor_targets(
    targets: list[object],
    template_by_entity: dict[int, int],
    actor_damage: object,
    canonical_name: str,
) -> tuple[list[object], bool]:
    """Collapse one actor's phase-target rows into the 一号信徒 encounter."""

    merged: dict | None = None
    merged_entity_ids: list[int] = []
    merged_damage = 0
    merged_share = 0.0
    result: list[object] = []
    changed = False

    for raw_target in targets:
        if not isinstance(raw_target, dict):
            result.append(raw_target)
            continue
        entity_ids = _history_target_entity_ids(raw_target)
        template_ids = {
            template_by_entity[entity_id]
            for entity_id in entity_ids
            if entity_id in template_by_entity
        }
        try:
            direct_template_id = int(raw_target.get("template_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            direct_template_id = 0
        if direct_template_id:
            template_ids.add(direct_template_id)
        if not template_ids or not template_ids.issubset(
            FIRST_BELIEVER_PHASE_TEMPLATE_IDS
        ):
            result.append(raw_target)
            continue

        if merged is None:
            merged = dict(raw_target)
            merged.update(
                {
                    "entity_id": entity_ids[0] if entity_ids else 0,
                    "entity_ids": merged_entity_ids,
                    "template_id": FIRST_BELIEVER_CANONICAL_TEMPLATE_ID,
                    "name": canonical_name,
                    "kind": "Boss",
                    "damage": 0,
                    "share": 0.0,
                    "history_encounter_group": True,
                }
            )
            result.append(merged)
        for entity_id in entity_ids:
            if entity_id not in merged_entity_ids:
                merged_entity_ids.append(entity_id)
        try:
            merged_damage += max(0, int(raw_target.get("damage", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            pass
        try:
            share = float(raw_target.get("share", 0.0) or 0.0)
        except (TypeError, ValueError, OverflowError):
            share = 0.0
        if math.isfinite(share):
            merged_share += max(0.0, share)
        changed = True

    if merged is not None:
        merged["damage"] = merged_damage
        try:
            total_damage = max(0, int(actor_damage or 0))
        except (TypeError, ValueError, OverflowError):
            total_damage = 0
        merged["share"] = (
            merged_damage / total_damage if total_damage else merged_share
        )
    return result, changed


def restore_history_boss_names(record: object, catalog: object) -> object:
    """Return a display-only history record with placeholder Boss names fixed."""
    if not isinstance(record, dict) or not isinstance(catalog, dict):
        return record

    changed = False
    updated = dict(record)
    canonical_by_entity: dict[int, str] = {}
    template_by_entity: dict[int, int] = {}
    encounter_template_ids: set[int] = set()
    primary_name = ""

    raw_monster = record.get("monster")
    if isinstance(raw_monster, dict):
        primary_name = _catalog_boss_name(
            catalog, raw_monster.get("template_id", 0)
        )
        primary_level = _catalog_boss_level(
            catalog, raw_monster.get("template_id", 0)
        )
        try:
            primary_entity_id = int(raw_monster.get("entity_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            primary_entity_id = 0
        try:
            primary_template_id = int(raw_monster.get("template_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            primary_template_id = 0
        if primary_entity_id and primary_name:
            canonical_by_entity[primary_entity_id] = primary_name
        if primary_template_id:
            encounter_template_ids.add(primary_template_id)
            if primary_entity_id:
                template_by_entity[primary_entity_id] = primary_template_id
        try:
            monster_level_valid = 1 <= int(
                raw_monster.get("level", 0) or 0
            ) <= 999
        except (TypeError, ValueError, OverflowError):
            monster_level_valid = False
        needs_name = (
            primary_template_id in AUTHORITATIVE_BOSS_NAME_TEMPLATE_IDS
            and str(raw_monster.get("name", "")).strip() != primary_name
        ) or not str(raw_monster.get("name", "")).strip() or (
            boss_name_is_placeholder(raw_monster.get("name", ""))
        )
        if (primary_name and needs_name) or (
            primary_level is not None and not monster_level_valid
        ):
            monster = dict(raw_monster)
            if primary_name and needs_name:
                monster["name"] = primary_name
            if primary_level is not None and not monster_level_valid:
                monster["level"] = primary_level
            updated["monster"] = monster
            changed = True

    raw_targets = record.get("targets")
    if isinstance(raw_targets, list):
        targets: list[object] = []
        targets_changed = False
        for raw_target in raw_targets:
            if not isinstance(raw_target, dict):
                targets.append(raw_target)
                continue
            try:
                entity_id = int(raw_target.get("entity_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                entity_id = 0
            try:
                template_id = int(raw_target.get("template_id", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                template_id = 0
            if template_id:
                encounter_template_ids.add(template_id)
                if entity_id:
                    template_by_entity[entity_id] = template_id
            canonical_name = _catalog_boss_name(
                catalog, raw_target.get("template_id", 0)
            ) or canonical_by_entity.get(entity_id, "")
            canonical_level = _catalog_boss_level(
                catalog, raw_target.get("template_id", 0)
            )
            if entity_id and canonical_name:
                canonical_by_entity[entity_id] = canonical_name
            try:
                target_level_valid = 1 <= int(
                    raw_target.get("level", 0) or 0
                ) <= 999
            except (TypeError, ValueError, OverflowError):
                target_level_valid = False
            needs_name = (
                template_id in AUTHORITATIVE_BOSS_NAME_TEMPLATE_IDS
                and str(raw_target.get("name", "")).strip() != canonical_name
            ) or not str(raw_target.get("name", "")).strip() or (
                boss_name_is_placeholder(raw_target.get("name", ""))
            )
            if (canonical_name and needs_name) or (
                canonical_level is not None and not target_level_valid
            ):
                target = dict(raw_target)
                if canonical_name and needs_name:
                    target["name"] = canonical_name
                if canonical_level is not None and not target_level_valid:
                    target["level"] = canonical_level
                targets.append(target)
                targets_changed = True
            else:
                targets.append(raw_target)
        if targets_changed:
            updated["targets"] = targets
            changed = True

    first_believer_encounter = is_first_believer_encounter(
        encounter_template_ids
    )
    first_believer_name = (
        _catalog_boss_name(catalog, FIRST_BELIEVER_CANONICAL_TEMPLATE_ID)
        or "一号信徒"
    )

    raw_participants = record.get("participants")
    if isinstance(raw_participants, list):
        participants: list[object] = []
        participants_changed = False
        for raw_participant in raw_participants:
            if not isinstance(raw_participant, dict):
                participants.append(raw_participant)
                continue
            raw_actor_targets = raw_participant.get("targets")
            if not isinstance(raw_actor_targets, list):
                participants.append(raw_participant)
                continue
            actor_targets: list[object] = []
            actor_targets_changed = False
            for raw_target in raw_actor_targets:
                if not isinstance(raw_target, dict):
                    actor_targets.append(raw_target)
                    continue
                candidate_names: set[str] = set()
                try:
                    entity_id = int(raw_target.get("entity_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    entity_id = 0
                try:
                    target_template_id = int(
                        raw_target.get("template_id", 0)
                        or template_by_entity.get(entity_id, 0)
                        or 0
                    )
                except (TypeError, ValueError, OverflowError):
                    target_template_id = 0
                authoritative_name = bool(
                    target_template_id in AUTHORITATIVE_BOSS_NAME_TEMPLATE_IDS
                )
                if (
                    str(raw_target.get("name", "")).strip()
                    and not boss_name_is_placeholder(raw_target.get("name", ""))
                    and not authoritative_name
                ):
                    actor_targets.append(raw_target)
                    continue
                direct_catalog_name = _catalog_boss_name(
                    catalog, target_template_id
                )
                if direct_catalog_name:
                    candidate_names.add(direct_catalog_name)
                if entity_id and entity_id in canonical_by_entity:
                    candidate_names.add(canonical_by_entity[entity_id])
                raw_entity_ids = raw_target.get("entity_ids", ())
                if isinstance(raw_entity_ids, (list, tuple, set)):
                    for raw_entity_id in raw_entity_ids:
                        try:
                            grouped_entity_id = int(raw_entity_id or 0)
                        except (TypeError, ValueError, OverflowError):
                            continue
                        if grouped_entity_id in canonical_by_entity:
                            candidate_names.add(
                                canonical_by_entity[grouped_entity_id]
                            )
                if (
                    not candidate_names
                    and str(raw_target.get("kind", "")).casefold() == "boss"
                    and primary_name
                ):
                    candidate_names.add(primary_name)
                if len(candidate_names) == 1:
                    target = dict(raw_target)
                    target["name"] = next(iter(candidate_names))
                    actor_targets.append(target)
                    actor_targets_changed = True
                else:
                    actor_targets.append(raw_target)
            if first_believer_encounter:
                actor_targets, targets_merged = (
                    _merge_first_believer_actor_targets(
                        actor_targets,
                        template_by_entity,
                        raw_participant.get("damage", 0),
                        first_believer_name,
                    )
                )
                actor_targets_changed |= targets_merged
            if actor_targets_changed:
                participant = dict(raw_participant)
                participant["targets"] = actor_targets
                participants.append(participant)
                participants_changed = True
            else:
                participants.append(raw_participant)
        if participants_changed:
            updated["participants"] = participants
            changed = True

    return updated if changed else record


def _history_skill_name_is_placeholder(value: object, skill_id: int) -> bool:
    """Return whether a saved skill label contains no useful name."""
    name = str(value or "").strip()
    if not name:
        return True
    compact = re.sub(r"\s+", "", name).casefold()
    if compact in {"未知技能", "未命名技能"}:
        return True
    return bool(
        skill_id > 0
        and re.fullmatch(
            rf"技能(?:id[:：]?)?{skill_id}",
            compact,
            flags=re.IGNORECASE,
        )
    )


def _history_skill_display_name(value: object) -> str:
    name = str(value or "").strip()
    return "恩赐词条" if name.startswith("恩赐词条-") else name


def catalog_confirmed_skill_id(value: object, catalog: object) -> int:
    """Collapse a packet effect suffix only when the catalog proves its root."""
    try:
        skill_id = int(value)
    except (TypeError, ValueError, OverflowError):
        return 0
    if skill_id <= 0 or not isinstance(catalog, dict):
        return max(0, skill_id)
    if skill_id in catalog:
        return skill_id
    if 100_000_000 <= skill_id <= 9_999_999_999:
        root_skill_id = skill_id // 10
        if root_skill_id in catalog:
            return root_skill_id
    return skill_id


def restore_history_skill_names(record: object, catalog: object) -> object:
    """Return a display-only copy with verified skill IDs and names restored."""
    if not isinstance(record, dict) or not isinstance(catalog, dict):
        return record
    canonical_names: dict[int, str] = {}
    for raw_skill_id, raw_name in catalog.items():
        try:
            skill_id = int(raw_skill_id)
        except (TypeError, ValueError, OverflowError):
            continue
        name = str(raw_name or "").strip()
        if skill_id > 0 and name:
            canonical_names[skill_id] = name
    if not canonical_names:
        return record

    updated = dict(record)
    changed = False
    for collection_name in ("participants", "healers"):
        raw_actors = record.get(collection_name)
        if not isinstance(raw_actors, list):
            continue
        actors: list[object] = []
        actors_changed = False
        for raw_actor in raw_actors:
            if not isinstance(raw_actor, dict):
                actors.append(raw_actor)
                continue
            actor = raw_actor
            actor_changed = False
            for skill_collection in (
                "skills",
                "skills_outgoing",
                "skills_incoming",
            ):
                raw_skills = raw_actor.get(skill_collection)
                if not isinstance(raw_skills, list):
                    continue
                skills: list[object] = []
                skills_changed = False
                for raw_skill in raw_skills:
                    if not isinstance(raw_skill, dict):
                        skills.append(raw_skill)
                        continue
                    try:
                        skill_id = int(raw_skill.get("skill_id", 0) or 0)
                    except (TypeError, ValueError, OverflowError):
                        skill_id = 0
                    canonical_skill_id = catalog_confirmed_skill_id(
                        skill_id, canonical_names
                    )
                    canonical_name = canonical_names.get(canonical_skill_id, "")
                    remapped = canonical_skill_id != skill_id
                    if remapped or (
                        canonical_name
                        and _history_skill_name_is_placeholder(
                            raw_skill.get("name", ""), skill_id
                        )
                    ):
                        skill = dict(raw_skill)
                        skill["skill_id"] = canonical_skill_id
                        if canonical_name:
                            skill["name"] = canonical_name
                        skills.append(skill)
                        skills_changed = True
                    else:
                        skills.append(raw_skill)
                if skills_changed:
                    if not actor_changed:
                        actor = dict(raw_actor)
                        actor_changed = True
                    actor[skill_collection] = skills
            actors.append(actor)
            actors_changed |= actor_changed
        if actors_changed:
            updated[collection_name] = actors
            changed = True

    for event_log_name in ("event_log", "skill_cast_log"):
        raw_event_log = record.get(event_log_name)
        if not isinstance(raw_event_log, dict):
            continue
        raw_columns = raw_event_log.get("columns")
        raw_rows = raw_event_log.get("rows")
        if isinstance(raw_columns, (list, tuple)):
            try:
                skill_column = raw_columns.index("skill_id")
            except ValueError:
                skill_column = -1
        else:
            skill_column = -1
        if skill_column < 0 or not isinstance(raw_rows, list):
            continue
        event_rows: list[object] = []
        event_rows_changed = False
        for raw_row in raw_rows:
            if (
                not isinstance(raw_row, (list, tuple))
                or len(raw_row) <= skill_column
            ):
                event_rows.append(raw_row)
                continue
            canonical_skill_id = catalog_confirmed_skill_id(
                raw_row[skill_column], canonical_names
            )
            try:
                skill_id = int(raw_row[skill_column] or 0)
            except (TypeError, ValueError, OverflowError):
                skill_id = 0
            if canonical_skill_id == skill_id:
                event_rows.append(raw_row)
                continue
            row = list(raw_row)
            row[skill_column] = canonical_skill_id
            event_rows.append(row)
            event_rows_changed = True
        if event_rows_changed:
            event_log = dict(raw_event_log)
            event_log["rows"] = event_rows
            updated[event_log_name] = event_log
            changed = True

    raw_boss_damage = record.get("boss_damage")
    if isinstance(raw_boss_damage, dict):
        boss_damage = dict(raw_boss_damage)
        boss_damage_changed = False

        def restore_skill_rows(raw_rows: object) -> tuple[object, bool]:
            if not isinstance(raw_rows, list):
                return raw_rows, False
            rows: list[object] = []
            rows_changed = False
            for raw_skill in raw_rows:
                if not isinstance(raw_skill, dict):
                    rows.append(raw_skill)
                    continue
                try:
                    skill_id = int(raw_skill.get("skill_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    skill_id = 0
                canonical_name = canonical_names.get(skill_id, "")
                if canonical_name and _history_skill_name_is_placeholder(
                    raw_skill.get("name", ""), skill_id
                ):
                    skill = dict(raw_skill)
                    skill["name"] = canonical_name
                    rows.append(skill)
                    rows_changed = True
                else:
                    rows.append(raw_skill)
            return rows, rows_changed

        restored_skills, skills_changed = restore_skill_rows(
            raw_boss_damage.get("skills")
        )
        if skills_changed:
            boss_damage["skills"] = restored_skills
            boss_damage_changed = True

        raw_sources = raw_boss_damage.get("sources")
        if isinstance(raw_sources, list):
            sources: list[object] = []
            sources_changed = False
            for raw_source in raw_sources:
                if not isinstance(raw_source, dict):
                    sources.append(raw_source)
                    continue
                restored_source_skills, source_skills_changed = (
                    restore_skill_rows(raw_source.get("skills"))
                )
                if source_skills_changed:
                    source = dict(raw_source)
                    source["skills"] = restored_source_skills
                    sources.append(source)
                    sources_changed = True
                else:
                    sources.append(raw_source)
            if sources_changed:
                boss_damage["sources"] = sources
                boss_damage_changed = True

        if boss_damage_changed:
            updated["boss_damage"] = boss_damage
            changed = True
    return updated if changed else record


def save_config(config: dict) -> None:
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(
            json.dumps(config, ensure_ascii=False, indent=2), encoding="utf-8"
        )
    except OSError:
        pass


@dataclass
class SkillStats:
    skill_id: int
    damage: int = 0
    hits: int = 0
    max_hit: int = 0
    first_time: float = 0.0
    last_time: float = 0.0

    def add(self, damage: int, event_time: float) -> None:
        self.damage += damage
        self.hits += 1
        self.max_hit = max(self.max_hit, damage)
        if not self.first_time:
            self.first_time = event_time
        self.last_time = event_time


@dataclass
class ActorStats:
    actor_id: int
    damage: int = 0
    hits: int = 0
    max_hit: int = 0
    first_time: float = 0.0
    last_time: float = 0.0
    skills: dict[int, SkillStats] = field(default_factory=dict)
    target_damage: dict[int, int] = field(default_factory=dict)
    damage_hits: int | None = None
    critical_hits: int | None = None
    penetration_hits: int | None = None

    def add(
        self,
        damage: int,
        event_time: float,
        skill_id: int,
        target_id: int = 0,
        critical: bool | None = None,
        penetrating: bool | None = None,
    ) -> None:
        self.damage += damage
        self.hits += 1
        self.max_hit = max(self.max_hit, damage)
        if not self.first_time:
            self.first_time = event_time
        self.last_time = event_time
        skill = self.skills.setdefault(skill_id, SkillStats(skill_id))
        skill.add(damage, event_time)
        if target_id:
            self.target_damage[target_id] = (
                self.target_damage.get(target_id, 0) + damage
            )
        if critical is not None or penetrating is not None:
            self.damage_hits = (self.damage_hits or 0) + 1
        if critical is not None:
            self.critical_hits = (self.critical_hits or 0) + int(critical)
        if penetrating is not None:
            self.penetration_hits = (
                (self.penetration_hits or 0) + int(penetrating)
            )


