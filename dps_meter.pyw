        self.member_death_states: dict[int, bool] = {}
        self.member_life_times: dict[int, int] = {}
        self.member_life_transitions: dict[int, list[tuple[int, bool]]] = {}
        # The Sun path can briefly publish a confirmed 0-HP edge before its
