            ("装备件数", str(len(equipment)) if equipment else "--", TEXT),
            (
                "装备类型",
                f"竞技 {pvp_count} / 冒险 {max(0, len(equipment) - pvp_count)}"
                if equipment
                else "--",
                "#e17575" if pvp_count else "#70b9e6",
            ),
            (
                "激活词条",
                f"{active_words} / {total_words}" if total_words else "--",
                ACCENT if total_words else MUTED,
            ),
            ("采集时间", self._history_equipment_timestamp(snapshot), MUTED),
        )
        cell_width = width / len(summary)
        for index, (caption, value, color) in enumerate(summary):
            left = index * cell_width
            if index:
                canvas.create_line(left, 11, left, summary_height - 11, fill=BORDER)
            canvas.create_text(
                left + 12,
                22,
                text=caption,
                fill=SUBTLE,
                anchor="w",
                font=self._ui_font("micro"),
            )
            canvas.create_text(
                left + 12,
                47,
                text=self._fit_ui_text(value, max(35, cell_width - 24), "strong"),
                fill=color,
                anchor="w",
                font=self._ui_font("strong"),
            )

        header_top = summary_height
        header_height = 31
        canvas.create_rectangle(
            0,
            header_top,
            width,
            header_top + header_height,
            fill=SURFACE,
            outline="",
        )
        columns = {
            "slot": 14,
            "item": max(92, int(width * 0.12)),
            "mode": max(190, int(width * 0.25)),
            "words": max(315, int(width * 0.40)),
            "score": max(480, int(width * 0.68)),
            "active": width - 18,
        }
        for caption, x, anchor in (
            ("槽位", columns["slot"], "w"),
            ("装备 ID", columns["item"], "w"),
            ("类型", columns["mode"], "w"),
            ("词条 ID / 类别", columns["words"], "w"),
            ("词条评分", columns["score"], "e"),
            ("激活 / 总词条", columns["active"], "e"),
        ):
            canvas.create_text(
                x,
                header_top + header_height // 2,
                text=caption,
                fill=MUTED,
                anchor=anchor,
                font=self._ui_font("table_header"),
            )
        row_height = 42
        top = header_top + header_height
        if not equipment:
            canvas.create_text(
                width // 2,
                top + row_height,
                text="装备响应中没有可展示的装备条目",
                fill=MUTED,
                font=self._ui_font("body"),
            )
            canvas.configure(scrollregion=(0, 0, width, max(height, top + row_height * 2)))
            return
        for index, item in enumerate(equipment):
            bottom = top + row_height
            background = PANEL if index % 2 == 0 else "#11161b"
            canvas.create_rectangle(0, top, width, bottom - 1, fill=background, outline="")
            mode = str(item.get("equipment_mode") or "").strip().casefold()
            is_pvp = bool(item.get("is_pvp")) or mode == "pvp"
            if is_pvp:
                mode_text, mode_color = "竞技装备", "#e17575"
            elif mode in {"pve", "adventure", "冒险"}:
                mode_text, mode_color = "冒险装备", "#70b9e6"
            else:
                mode_text, mode_color = "--", MUTED
            word_ids = item.get("word_ids")
            word_ids = list(word_ids) if isinstance(word_ids, (list, tuple)) else []
            classes = item.get("word_class_types")
            classes = list(classes) if isinstance(classes, (list, tuple)) else []
            word_text = ", ".join(str(value) for value in word_ids) or "--"
            if classes:
                word_text += "  /  " + ", ".join(str(value) for value in classes)
            try:
                word_score = max(0, int(item.get("word_score", 0) or 0))
                active = max(0, int(item.get("active_word_count", 0) or 0))
                total = max(0, int(item.get("total_word_count", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                word_score = active = total = 0
            values = (
                (columns["slot"], str(item.get("slot", "--")), "w", TEXT),
                (columns["item"], self._history_optional_number(item.get("item_id")), "w", TEXT),
                (columns["mode"], mode_text, "w", mode_color),
                (
                    columns["words"],
                    self._fit_ui_text(
                        word_text,
                        max(90, columns["score"] - columns["words"] - 18),
                        "micro",
                    ),
                    "w",
                    MUTED,
                ),
                (columns["score"], format_number(word_score) if word_score else "--", "e", WARN if word_score else MUTED),
                (columns["active"], f"{active} / {total}" if total else "--", "e", ACCENT if total else MUTED),
            )
            for x, value, anchor, color in values:
                canvas.create_text(
                    x,
                    top + row_height // 2,
                    text=value,
                    fill=color,
                    anchor=anchor,
                    font=self._ui_font("table"),
                )
            top = bottom
        canvas.configure(scrollregion=(0, 0, width, max(height, top)))

    @staticmethod
    def _history_damage_skills(participant: dict | None) -> list[dict]:
        if not isinstance(participant, dict):
            return []
        if str(participant.get("skill_detail_status", "")) == "pending_server_detail":
            return []
        raw_rows = participant.get("skills")
        rows = [row for row in raw_rows if isinstance(row, dict)] if isinstance(raw_rows, list) else []
        if not rows:
            try:
                damage = max(0, int(participant.get("damage", 0) or 0))
            except (TypeError, ValueError, OverflowError):
                damage = 0
            if damage:
                rows = [{
                    "skill_id": 0,
                    "name": "未归类伤害",
                    "damage": damage,
                    "share": 1.0,
                    "hits": None,
                    "max_hit": None,
                }]
        return sorted(
            rows,
            key=lambda row: max(0, int(row.get("damage", 0) or 0)),
            reverse=True,
        )

    def _history_self_skill_events(
        self, record: dict | None, participant: dict | None
    ) -> dict[int, list[dict[str, object]]]:
        if not isinstance(record, dict) or not isinstance(participant, dict):
            return {}
        pvp_record = str(record.get("combat_mode", "")).casefold() == "pvp"
        if not pvp_record and participant.get("is_self") is not True:
            return {}
        try:
            actor_id = int(participant.get("actor_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return {}
        if pvp_record:
            try:
                started_at_ns = max(0, int(record.get("started_at_ns", 0) or 0))
                duration_ns = max(
                    0,
                    int(float(record.get("duration_seconds", 0.0) or 0.0) * 1e9),
                )
            except (TypeError, ValueError, OverflowError):
                started_at_ns = duration_ns = 0

            def relative_seconds(value: object) -> float | None:
                try:
                    stamp = int(value)
                except (TypeError, ValueError, OverflowError):
                    return None
                if started_at_ns > 0 and stamp >= started_at_ns:
                    delta = stamp - started_at_ns
                elif 0 <= stamp <= duration_ns:
                    delta = stamp
                else:
                    return None
                if duration_ns > 0 and delta > duration_ns + 1_000_000_000:
                    return None
                return max(0.0, delta / 1e9)

            events: dict[int, list[dict[str, object]]] = {}
            raw_skills = participant.get("skills")
            for skill in raw_skills if isinstance(raw_skills, list) else []:
                if not isinstance(skill, dict):
                    continue
                try:
                    skill_id = int(skill.get("skill_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    continue
                raw_stamps = skill.get("hit_timestamps_ns")
                if skill_id <= 0 or not isinstance(raw_stamps, (list, tuple)):
                    continue
                for raw_stamp in raw_stamps:
                    second = relative_seconds(raw_stamp)
                    if second is None:
                        continue
                    events.setdefault(skill_id, []).append(
                        {
                            "time_seconds": second,
                            "damage": None,
                            "critical": None,
                            "penetrating": None,
                            "timestamp_source": "pvp_exact_hit",
                        }
                    )
            for rows in events.values():
                rows.sort(key=lambda row: float(row.get("time_seconds", 0.0)))
            return events

        event_log = record.get("event_log")
        rows = event_log.get("rows") if isinstance(event_log, dict) else None
        if actor_id <= 0 or not isinstance(rows, list):
            return {}
        events: dict[int, list[dict[str, object]]] = {}
        for row in rows:
            if not isinstance(row, (list, tuple)) or len(row) < 5:
                continue
            try:
                if int(row[1]) != actor_id:
                    continue
                damage = max(0, int(row[4]))
                skill_id = int(row[3] or 0)
                time_seconds = max(0.0, float(row[0]) / 1000.0)
            except (TypeError, ValueError, OverflowError):
                continue
            if damage <= 0:
                continue
            events.setdefault(skill_id, []).append({
                "time_seconds": time_seconds,
                "damage": damage,
                "critical": row[5] if len(row) > 5 and isinstance(row[5], bool) else None,
                "penetrating": row[6] if len(row) > 6 and isinstance(row[6], bool) else None,
            })
        return events

    @staticmethod
    def _history_opener_events(
        record: dict | None, actor_id: object
    ) -> list[dict[str, object]]:
        """Read exact local cast rows; never infer casts from damage events."""

        if not isinstance(record, dict):
            return []
        try:
            selected_actor = int(actor_id or 0)
        except (TypeError, ValueError, OverflowError):
            return []
        if str(record.get("combat_mode", "")).casefold() == "pvp":
            participants = record.get("participants")
            participant = next(
                (
                    row
                    for row in participants
                    if isinstance(row, dict)
                    and int(row.get("actor_id", 0) or 0) == selected_actor
                ),
                None,
            ) if isinstance(participants, list) else None
            if not isinstance(participant, dict):
                return []
            try:
                started_at_ns = max(0, int(record.get("started_at_ns", 0) or 0))
                duration_ns = max(
                    0,
                    int(float(record.get("duration_seconds", 0.0) or 0.0) * 1e9),
                )
            except (TypeError, ValueError, OverflowError):
                started_at_ns = duration_ns = 0
            parsed_rows: list[tuple[int, int, int, int]] = []
            source_index = 0
            skills = participant.get("skills")
            for skill in skills if isinstance(skills, list) else []:
                if not isinstance(skill, dict):
                    continue
                try:
                    skill_id = int(skill.get("skill_id", 0) or 0)
                except (TypeError, ValueError, OverflowError):
                    continue
                stamps = skill.get("cast_timestamps_ns")
                if skill_id <= 0 or not isinstance(stamps, (list, tuple)):
                    continue
                for ordinal, raw_stamp in enumerate(stamps, start=1):
                    try:
                        stamp = int(raw_stamp)
                    except (TypeError, ValueError, OverflowError):
                        continue
                    if started_at_ns > 0 and stamp >= started_at_ns:
                        delta_ns = stamp - started_at_ns
                    elif 0 <= stamp <= duration_ns:
                        delta_ns = stamp
                    else:
                        continue
                    if duration_ns > 0 and delta_ns > duration_ns + 1_000_000_000:
                        continue
                    parsed_rows.append(
                        (max(0, int(delta_ns / 1_000_000)), ordinal, source_index, skill_id)
                    )
                    source_index += 1
            parsed_rows.sort(key=lambda row: (row[0], row[1], row[2]))
            occurrence_by_skill: dict[int, int] = {}
            opener: list[dict[str, object]] = []
            previous_time_ms: int | None = None
            maximum_ms = int(round(HISTORY_OPENER_SEQUENCE_SECONDS * 1000.0))
            for time_ms, sequence, _source_index, skill_id in parsed_rows:
                occurrence_by_skill[skill_id] = occurrence_by_skill.get(skill_id, 0) + 1
                if time_ms > maximum_ms:
                    continue
                opener.append(
                    {
                        "time_ms": time_ms,
                        "time_seconds": time_ms / 1000.0,
                        "interval_ms": (
                            None
                            if previous_time_ms is None
                            else max(0, time_ms - previous_time_ms)
                        ),
                        "skill_id": skill_id,
                        "sequence": sequence,
                        "ordinal": occurrence_by_skill[skill_id],
                    }
                )
                previous_time_ms = time_ms
            return opener
        cast_log = record.get("skill_cast_log")
        if (
            selected_actor == 0
            or not isinstance(cast_log, dict)
            or cast_log.get("coverage") != "local_successful_active_casts"
        ):
            return []
        columns = cast_log.get("columns")
        rows = cast_log.get("rows")
        if not isinstance(columns, (list, tuple)) or not isinstance(rows, list):
            return []
        indexes = {str(name): index for index, name in enumerate(columns)}
        required = ("time_ms", "actor_id", "skill_id")
        if any(name not in indexes for name in required):
            return []

        parsed_rows: list[tuple[int, int, int, int]] = []
        for source_index, raw_row in enumerate(rows):
            if not isinstance(raw_row, (list, tuple)):
                continue
            try:
                time_ms = int(raw_row[indexes["time_ms"]])
                row_actor = int(raw_row[indexes["actor_id"]])
                skill_id = int(raw_row[indexes["skill_id"]])
                sequence_index = indexes.get("sequence", -1)
                sequence = (
                    int(raw_row[sequence_index] or 0)
                    if 0 <= sequence_index < len(raw_row)
                    else 0
                )
            except (IndexError, TypeError, ValueError, OverflowError):
                continue
            if time_ms < 0 or row_actor != selected_actor or skill_id <= 0:
                continue
            parsed_rows.append((time_ms, sequence, source_index, skill_id))
        parsed_rows.sort(key=lambda row: (row[0], row[1], row[2]))

        occurrence_by_skill: dict[int, int] = {}
        opener: list[dict[str, object]] = []
        previous_time_ms: int | None = None
        maximum_ms = int(round(HISTORY_OPENER_SEQUENCE_SECONDS * 1000.0))
        for time_ms, sequence, _source_index, skill_id in parsed_rows:
            occurrence_by_skill[skill_id] = occurrence_by_skill.get(skill_id, 0) + 1
            if time_ms > maximum_ms:
                continue
            opener.append(
                {
                    "time_ms": time_ms,
                    "time_seconds": time_ms / 1000.0,
                    "interval_ms": (
                        None
                        if previous_time_ms is None
                        else max(0, time_ms - previous_time_ms)
                    ),
                    "skill_id": skill_id,
                    "sequence": sequence,
                    "ordinal": occurrence_by_skill[skill_id],
                }
            )
            previous_time_ms = time_ms
        return opener

    @staticmethod
    def _format_history_cast_time(value: object) -> str:
        try:
            milliseconds = max(0, int(round(float(value))))
        except (TypeError, ValueError, OverflowError):
            milliseconds = 0
        minutes, remainder = divmod(milliseconds, 60_000)
        seconds, centiseconds = divmod(remainder, 1000)
        return f"{minutes:02d}:{seconds:02d}.{centiseconds // 10:02d}"

    def _history_opener_name_map(
        self, record: dict | None, actor_id: int
    ) -> tuple[dict[int, str], int]:
        names: dict[int, str] = {}
        profession_id = 0
        if isinstance(record, dict):
            for collection_name in ("participants", "healers"):
                collection = record.get(collection_name, [])
                if not isinstance(collection, list):
                    continue
                for participant in collection:
                    if not isinstance(participant, dict):
                        continue
                    try:
                        row_actor = int(participant.get("actor_id", 0) or 0)
                    except (TypeError, ValueError, OverflowError):
                        continue
                    if row_actor != actor_id:
                        continue
                    try:
                        profession_id = int(
                            participant.get("profession_id", profession_id) or profession_id
                        )
                    except (TypeError, ValueError, OverflowError):
                        pass
                    skills = participant.get("skills", [])
                    if not isinstance(skills, list):
                        continue
                    for skill in skills:
                        if not isinstance(skill, dict):
                            continue
                        try:
                            skill_id = int(skill.get("skill_id", 0) or 0)
                        except (TypeError, ValueError, OverflowError):
                            continue
                        name = str(skill.get("name", "") or "").strip()
                        if skill_id > 0 and name:
                            names.setdefault(skill_id, name)
        model = getattr(self, "model", None)
        for skill_id in {
            int(event.get("skill_id", 0) or 0)
            for event in self._history_opener_events(record, actor_id)
        }:
            if skill_id in names or model is None:
                continue
            try:
                name = str(model.display_skill_name(actor_id, skill_id) or "").strip()
            except (AttributeError, TypeError, ValueError):
                name = ""
            if name:
                names[skill_id] = name
        return names, profession_id

    def _set_history_opener_panel_height(self, value: object) -> None:
        try:
            height = max(HISTORY_OPENER_PANEL_MIN_HEIGHT, int(value))
        except (TypeError, ValueError, OverflowError):
            height = HISTORY_OPENER_PANEL_MIN_HEIGHT
        if height == int(
            getattr(
                self,
                "history_opener_panel_height",
                HISTORY_OPENER_PANEL_MIN_HEIGHT,
            )
            or HISTORY_OPENER_PANEL_MIN_HEIGHT
        ):
            return
        self.history_opener_panel_height = height
        panel = getattr(self, "history_opener_panel", None)
        if panel is not None:
            try:
                panel.configure(height=height)
            except (AttributeError, tk.TclError):
                pass
        if getattr(self, "history_page_mode", "browser") == "detail":
            self._refresh_history_page_extent()

    def _draw_history_opener_sequence(self) -> None:
        canvas = getattr(self, "history_opener_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        self.history_opener_regions = []
        width = max(1, canvas.winfo_width())
        record = self._selected_history_record()
        try:
            actor_id = int(self.history_selected_actor or 0)
        except (TypeError, ValueError, OverflowError):
            actor_id = 0
        events = self._history_opener_events(record, actor_id)
        caption = getattr(self, "history_opener_caption_label", None)
        if caption is not None:
            try:
                caption.configure(
                    text=(
                        f"前 30 秒 · {len(events)} 次真实施法 · 点击定位时间轴"
                        if events
                        else "前 30 秒 · 本机主动施法"
                    )
                )
            except (AttributeError, tk.TclError):
                pass
        if not events:
            self._set_history_opener_panel_height(HISTORY_OPENER_PANEL_MIN_HEIGHT)
            height = max(1, canvas.winfo_height())
            has_exact_log = isinstance(record, dict) and isinstance(
                record.get("skill_cast_log"), dict
            )
            canvas.create_text(
                width // 2,
                height // 2 - 9,
                text=(
                    "前 30 秒没有记录到主动施法"
                    if has_exact_log
                    else "该记录未保存起手数据"
                ),
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text=(
                    "仅展示真实成功施法回执，不根据伤害命中推算"
                ),
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            return
        if width < 160:
            return

        name_by_id, profession_id = self._history_opener_name_map(record, actor_id)
        outer_padding = 16
        slot_width = 76
        row_height = 78
        columns = max(1, (max(1, width - outer_padding * 2) + 8) // slot_width)
        row_count = int(math.ceil(len(events) / columns))
        body_height = 18 + row_count * row_height
        self._set_history_opener_panel_height(
            max(HISTORY_OPENER_PANEL_MIN_HEIGHT, 48 + body_height)
        )
        colors = self._history_skill_palette()
        icons: list[object] = []
        for index, opener_event in enumerate(events):
            row, column = divmod(index, columns)
            center_x = outer_padding + column * slot_width + 24
            center_y = 12 + row * row_height + 25
            skill_id = int(opener_event.get("skill_id", 0) or 0)
            name = name_by_id.get(skill_id, "") or "未知技能"
            color = colors[index % len(colors)]
            icon = self.icons.skill(skill_id, name, profession_id, 46)
            icons.append(icon)
            tag = f"history-opener:{index}"
            canvas.create_rectangle(
                center_x - 25,
                center_y - 25,
                center_x + 25,
                center_y + 25,
                fill="#0c1014",
                outline=blend_color(color, "#ffffff", 0.18),
                width=1,
                tags=(tag, "history-opener-item"),
            )
            canvas.create_image(
                center_x,
                center_y,
                image=icon,
                tags=(tag, "history-opener-item"),
            )
            badge_right = center_x - 10
            canvas.create_rectangle(
                center_x - 25,
                center_y - 25,
                badge_right,
                center_y - 10,
                fill="#17342c",
                outline="",
                tags=(tag, "history-opener-item"),
            )
            canvas.create_text(
                center_x - 17,
                center_y - 18,
                text=str(index + 1),
                fill=ACCENT,
                font=self._ui_font("micro"),
                tags=(tag, "history-opener-item"),
            )
            canvas.create_text(
                center_x,
                center_y + 35,
                text=self._format_history_cast_time(opener_event.get("time_ms")),
                fill=SUBTLE,
                font=self._ui_font("micro"),
                tags=(tag, "history-opener-item"),
            )
            if index + 1 < len(events):
                next_row = (index + 1) // columns
                canvas.create_text(
                    center_x + 36,
                    center_y,
                    text="→" if next_row == row else "↘",
                    fill="#71808c",
                    font=self._ui_font("strong"),
                )
            self.history_opener_regions.append(
                {
                    **opener_event,
                    "name": name,
                    "left": center_x - 27,
                    "top": center_y - 27,
                    "right": center_x + 27,
                    "bottom": center_y + 45,
                }
            )
        canvas._history_opener_icons = icons

    def _history_opener_event_at_pointer(self, event) -> dict[str, object] | None:
        try:
            x = float(event.x)
            y = float(event.y)
        except (AttributeError, TypeError, ValueError):
            return None
        return next(
            (
                item
                for item in getattr(self, "history_opener_regions", [])
                if float(item.get("left", 0.0)) <= x <= float(item.get("right", 0.0))
                and float(item.get("top", 0.0)) <= y <= float(item.get("bottom", 0.0))
            ),
            None,
        )

    def _history_opener_motion(self, event) -> None:
        canvas = getattr(self, "history_opener_canvas", None)
        if canvas is None:
            return
        canvas.delete("history-opener-hover")
        item = self._history_opener_event_at_pointer(event)
        if item is None:
            canvas.configure(cursor="arrow")
            return
        canvas.configure(cursor="hand2")
        canvas.create_rectangle(
            float(item["left"]),
            float(item["top"]),
            float(item["right"]),
            float(item["bottom"]) - 17,
            outline=ACCENT,
            width=2,
            tags=("history-opener-hover",),
        )
        tooltip_width = min(286, max(230, canvas.winfo_width() - 16))
        tooltip_height = 72
        left = min(
            max(8.0, float(event.x) + 14.0),
            max(8.0, canvas.winfo_width() - tooltip_width - 8.0),
        )
        top = min(
            max(8.0, float(event.y) + 14.0),
            max(8.0, canvas.winfo_height() - tooltip_height - 8.0),
        )
        right = left + tooltip_width
        bottom = top + tooltip_height
        canvas.create_polygon(
            left + 6, top,
            right - 6, top,
            right, top + 6,
            right, bottom - 6,
            right - 6, bottom,
            left + 6, bottom,
            left, bottom - 6,
            left, top + 6,
            fill="#090c0f",
            outline=BORDER,
            width=1,
            tags=("history-opener-hover",),
        )
        interval = item.get("interval_ms")
        interval_text = (
            "首个技能"
            if interval is None
            else f"距上一技能  +{float(interval) / 1000.0:.2f} 秒"
        )
        canvas.create_text(
            left + 10,
            top + 16,
            text=str(item.get("name", "未知技能")),
            fill=TEXT,
            anchor="w",
            font=self._ui_font("strong"),
            tags=("history-opener-hover",),
        )
        canvas.create_text(
            left + 10,
            top + 39,
            text=(
                f"释放 {self._format_history_cast_time(item.get('time_ms'))}"
                f"   ·   {interval_text}"
            ),
            fill=MUTED,
            anchor="w",
            font=self._ui_font("micro"),
            tags=("history-opener-hover",),
        )
        canvas.create_text(
            left + 10,
            top + 57,
            text=f"本场第 {int(item.get('ordinal', 1) or 1)} 次释放",
            fill=ACCENT,
            anchor="w",
            font=self._ui_font("micro"),
            tags=("history-opener-hover",),
        )

    def _history_opener_leave(self, _event=None) -> None:
        canvas = getattr(self, "history_opener_canvas", None)
        if canvas is None:
            return
        try:
            canvas.delete("history-opener-hover")
            canvas.configure(cursor="arrow")
        except (AttributeError, tk.TclError):
            pass

    def _history_opener_click(self, event) -> str:
        item = self._history_opener_event_at_pointer(event)
        if item is None:
            return "break"
        return self._focus_history_skill_timeline_from_cast(item)

    def _focus_history_skill_timeline_from_cast(
        self, cast_event: dict[str, object]
    ) -> str:
        try:
            focus_time = max(0.0, float(cast_event.get("time_seconds", 0.0)))
            skill_id = int(cast_event.get("skill_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return "break"
        _record, _participant, skills, _events, duration = (
            self._history_skill_timeline_payload()
        )
        duration = max(1.0, float(duration or 1.0))
        for index, skill in enumerate(skills):
            try:
                row_skill_id = int(skill.get("skill_id", 0) or 0)
            except (AttributeError, TypeError, ValueError, OverflowError):
                continue
            if row_skill_id == skill_id:
                self.history_skill_timeline_page = index // 6
                break
        span = min(duration, max(10.0, min(30.0, duration * 0.35)))
        view_start = max(0.0, focus_time - min(5.0, span * 0.35))
        view_start = min(view_start, max(0.0, duration - span))
        self.history_skill_timeline_range = (
            view_start / duration,
            min(1.0, (view_start + span) / duration),
        )
        self.history_skill_timeline_selected_hit = None
        self.history_skill_timeline_hover_hit = None
        self.history_skill_timeline_focus_time = focus_time
        self._draw_history_skill_timeline()
        page_canvas = getattr(self, "history_page_canvas", None)
        if page_canvas is not None:
            try:
                page_canvas.after_idle(self._scroll_history_to_skill_timeline)
            except (AttributeError, tk.TclError):
                self._scroll_history_to_skill_timeline()
        return "break"

    def _scroll_history_to_skill_timeline(self) -> None:
        canvas = getattr(self, "history_page_canvas", None)
        panel = getattr(self, "history_skill_timeline_panel", None)
        if canvas is None or panel is None:
            return
        try:
            self._refresh_history_page_extent()
            canvas.update_idletasks()
            scrollregion = str(canvas.cget("scrollregion")).split()
            total_height = float(scrollregion[3]) if len(scrollregion) == 4 else 0.0
            viewport_height = float(canvas.winfo_height())
            maximum_top = max(0.0, total_height - viewport_height)
            target_top = min(maximum_top, max(0.0, float(panel.winfo_y()) - 52.0))
            canvas.yview_moveto(target_top / max(1.0, total_height))
        except (AttributeError, IndexError, TypeError, ValueError, tk.TclError):
            return

    @staticmethod
    def _history_skill_palette() -> tuple[str, ...]:
        return (
            "#a879e7", "#5e91ed", "#4fc3d8", "#70b66a",
            "#e5b443", "#e37c32", "#e4665f", "#d66cb0",
            "#7181d9", "#47b5ad", "#9dbb52", "#89949e",
            "#c689e1", "#6ba7cf", "#dc916a", "#82909e",
        )

    def _set_history_skill_share_mode(self, mode: str) -> None:
        # The current archive schema contains exact skill IDs but no reliable
        # cross-profession category field.  Keep the approved category control
        # visible without inventing data that was never captured.
        if mode != "skills":
            return
        self.history_skill_share_mode = "skills"
        self._sync_history_skill_share_buttons()
        self._draw_history_skill_share()

    def _sync_history_skill_share_buttons(self) -> None:
        for mode, button in getattr(self, "history_skill_share_buttons", {}).items():
            active = mode == "skills"
            enabled = mode == "skills"
            try:
                button.configure(
                    bg="#193c33" if active else "#101318",
                    fg=ACCENT if active else SUBTLE,
                    cursor="hand2" if enabled else "arrow",
                )
            except (AttributeError, tk.TclError):
                pass

    def _history_skill_share_enter(self, _event, index: int) -> str:
        self._sync_history_skill_share_hover(index)
        return "break"

    def _sync_history_skill_share_hover(self, index: int | None) -> None:
        canvas = getattr(self, "history_skill_share_canvas", None)
        segments = getattr(self, "history_skill_share_segments", [])
        render = getattr(self, "history_skill_share_render", None)
        if canvas is None or not isinstance(render, dict):
            return
        if not isinstance(index, int) or not (0 <= index < len(segments)):
            index = None
        items = render.get("items", [])
        items = items if isinstance(items, list) else []
        ring_width = float(render.get("ring_width", 1.0) or 1.0)
        stage_color = str(render.get("stage_color", "#101419"))
        for item_index, item in enumerate(items):
            if not isinstance(item, dict):
                continue
            color = str(item.get("color", MUTED))
            selected = index == item_index
            arc_color = (
                color
                if index is None or selected
                else blend_color(stage_color, color, 0.24)
            )
            marker_color = (
                color
                if index is None or selected
                else blend_color(stage_color, color, 0.20)
            )
            try:
                canvas.itemconfigure(
                    item.get("arc"),
                    outline=arc_color,
                    width=ring_width + (4.0 if selected else 0.0),
                )
                canvas.itemconfigure(item.get("marker"), fill=marker_color)
                canvas.itemconfigure(
                    item.get("row_background"),
                    fill="#182027" if selected else stage_color,
                )
            except (AttributeError, tk.TclError):
                return
        center_items = render.get("center", {})
        center_items = center_items if isinstance(center_items, dict) else {}
        try:
            if index is None:
                canvas.itemconfigure(
                    center_items.get("kicker"),
                    text=str(render.get("center_caption", "个人总伤害")),
                    fill=MUTED,
                )
                canvas.itemconfigure(
                    center_items.get("value"),
                    text=format_number(render.get("total", 0)),
                    fill=TEXT,
                )
                canvas.itemconfigure(
                    center_items.get("caption"),
                    text=f"{len(segments)} 个技能",
                    fill=MUTED,
                )
                canvas.itemconfigure(
                    center_items.get("detail"),
                    text="悬停技能查看明细",
                    fill=SUBTLE,
                )
                canvas.configure(cursor="")
                return
            segment = segments[index]
            color = str(segment.get("color", ACCENT))
            canvas.itemconfigure(
                center_items.get("kicker"),
                text=str(segment.get("name", "未命名技能")),
                fill=color,
            )
            canvas.itemconfigure(
                center_items.get("value"),
                text=f"{float(segment.get('share', 0.0)) * 100:.1f}%",
                fill=color,
            )
            canvas.itemconfigure(
                center_items.get("caption"),
                text=format_number(segment.get("amount", 0)),
                fill=TEXT,
            )
            canvas.itemconfigure(
                center_items.get("detail"),
                text=str(render.get("detail_caption", "占个人总伤害")),
                fill=SUBTLE,
            )
            canvas.tag_raise(f"history-share-segment:{index}")
            canvas.configure(cursor="hand2")
        except (AttributeError, tk.TclError):
            return

    def _history_skill_share_leave(self, _event=None) -> str:
        self._sync_history_skill_share_hover(None)
        return "break"

    def _draw_history_skill_share(self) -> None:
        canvas = getattr(self, "history_skill_share_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        self.history_skill_share_segments = []
        self.history_skill_share_render = None
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        stage_color = "#101419"
        canvas.create_rectangle(
            0, 0, width, height, fill=stage_color, outline=""
        )
        mode = getattr(self, "history_meter_mode", "dps")
        record, participant = self._selected_history_damage_participant()
        amount_key = "damage"
        center_caption = "个人总伤害"
        if mode == "boss_damage":
            record = self._selected_history_record()
            sources = self._history_boss_sources(record)
            participant = next(
                (
                    row
                    for row in sources
                    if int(row.get("entity_id", 0) or 0)
                    == int(self.history_selected_actor or 0)
                ),
                None,
            )
            center_caption = "来源总伤害"
        elif mode == "hps":
            record = self._selected_history_record()
            healers = record.get("healers", []) if isinstance(record, dict) else []
            healers = healers if isinstance(healers, list) else []
            participant = next(
                (
                    row for row in healers
                    if isinstance(row, dict)
                    and int(row.get("actor_id", 0) or 0)
                    == int(self.history_selected_actor or 0)
                ),
                None,
            )
            amount_key = "effective_healing"
            center_caption = "个人有效治疗"
        elif mode == "dt":
            canvas.create_text(
                width // 2, height // 2 - 8, text="暂无承伤来源明细",
                fill=MUTED, font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2, height // 2 + 15,
                text="当前只保存玩家承伤量与队内占比",
                fill=SUBTLE, font=self._ui_font("micro"),
            )
            return

        if not isinstance(participant, dict):
            canvas.create_text(
                width // 2, height // 2, text="请选择一名有明细数据的队员",
                fill=MUTED, font=self._ui_font("strong"),
            )
            return
        if (
            mode == "dps"
            and str(participant.get("skill_detail_status", ""))
            == "pending_server_detail"
        ):
            caption = getattr(self, "history_skill_share_caption_label", None)
            if caption is not None:
                try:
                    caption.configure(text="服务器未返回技能明细")
                except (AttributeError, tk.TclError):
                    pass
            canvas.create_text(
                width // 2,
                height // 2 - 12,
                text="暂无技能明细",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 16,
                text=TEAMMATE_SKILL_DETAIL_MISSING_MESSAGE,
                width=max(120, width - 48),
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            return
        if mode == "hps":
            raw_skills = participant.get("skills", [])
            skills = (
                [row for row in raw_skills if isinstance(row, dict)]
                if isinstance(raw_skills, list) else []
            )
            if not skills:
                effective = max(0, int(participant.get("effective_healing", 0) or 0))
                if effective:
                    skills = [{
                        "skill_id": 0,
                        "name": "未归类治疗",
                        "effective_healing": effective,
                    }]
            skills.sort(
                key=lambda row: max(0, int(row.get(amount_key, 0) or 0)),
                reverse=True,
            )
        else:
            skills = self._history_damage_skills(participant)
        skills = [row for row in skills if int(row.get(amount_key, 0) or 0) > 0]
        if not skills:
            canvas.create_text(
                width // 2, height // 2, text="暂无技能明细",
                fill=MUTED, font=self._ui_font("strong"),
            )
            return

        total = max(1, sum(max(0, int(row.get(amount_key, 0) or 0)) for row in skills))
        display_skills = skills[:12]
        if len(skills) > 12:
            tail = skills[11:]
            display_skills = skills[:11] + [{
                "skill_id": 0,
                "name": f"其他技能（{len(tail)} 项）",
                amount_key: sum(max(0, int(row.get(amount_key, 0) or 0)) for row in tail),
            }]
        palette = self._history_skill_palette()
        segments: list[dict[str, object]] = []
        for index, skill in enumerate(display_skills):
            amount = max(0, int(skill.get(amount_key, 0) or 0))
            segments.append({
                "skill_id": int(skill.get("skill_id", 0) or 0),
                "name": _history_skill_display_name(skill.get("name")) or "未命名技能",
                "amount": amount,
                "share": amount / total,
                "color": palette[index % len(palette)],
            })
        self.history_skill_share_segments = segments

        caption = getattr(self, "history_skill_share_caption_label", None)
        if caption is not None:
            try:
                caption.configure(
                    text=(
                        f"{len(skills)} 个治疗技能 · {format_number(total)}"
                        if mode == "hps"
                        else f"{len(skills)} 个首领技能 · 伤害 {format_number(total)}"
                        if mode == "boss_damage"
                        else f"{len(skills)} 个技能 · 总伤害 {format_number(total)}"
                    )
                )
            except (AttributeError, tk.TclError):
                pass

        left_width = min(455.0, max(285.0, width * 0.375))
        if width - left_width < 360.0:
            left_width = max(220.0, width - 360.0)
        canvas.create_line(left_width, 0, left_width, height, fill=BORDER)

        center_x, center_y = left_width / 2.0, height / 2.0
        outer_radius = min(
            180.0,
            max(72.0, height / 2.0 - 28.0),
            max(72.0, left_width / 2.0 - 39.0),
        )
        inner_radius = max(46.0, outer_radius * 0.61)
        radius = (outer_radius + inner_radius) / 2.0
        ring_width = outer_radius - inner_radius
        box = (
            center_x - radius, center_y - radius,
            center_x + radius, center_y + radius,
        )
        canvas.create_oval(*box, outline="#273039", width=ring_width)
        start = 90.0
        render_items: list[dict[str, object]] = []
        for index, segment in enumerate(segments):
            extent = max(0.0, float(segment["share"])) * 360.0
            if extent <= 0:
                render_items.append({
                    "arc": None,
                    "marker": None,
                    "row_background": None,
                    "color": str(segment["color"]),
                })
                continue
            gap = min(1.2, extent * 0.10)
            tag = f"history-share-segment:{index}"
            arc = canvas.create_arc(
                *box, start=start,
                extent=-min(359.999, max(0.25, extent - gap)),
                style="arc", outline=str(segment["color"]),
                width=ring_width, tags=(tag,),
            )
            midpoint = math.radians(start - extent / 2.0)
            marker_start = outer_radius + 4.0
            marker_end = outer_radius + 11.0
            marker = canvas.create_line(
                center_x + math.cos(midpoint) * marker_start,
                center_y - math.sin(midpoint) * marker_start,
                center_x + math.cos(midpoint) * marker_end,
                center_y - math.sin(midpoint) * marker_end,
                fill=str(segment["color"]), width=2, tags=(tag,),
            )
            render_items.append({
                "arc": arc,
                "marker": marker,
                "row_background": None,
                "color": str(segment["color"]),
            })
            start -= extent

        center_items = {
            "kicker": canvas.create_text(
                center_x, center_y - 38, text=center_caption,
                fill=MUTED, font=self._ui_font("micro"),
            ),
            "value": canvas.create_text(
                center_x, center_y - 4, text=format_number(total),
                fill=TEXT, font=self._ui_font("number_large"),
            ),
            "caption": canvas.create_text(
                center_x, center_y + 24, text=f"{len(segments)} 个技能",
                fill=MUTED, font=self._ui_font("micro"),
            ),
            "detail": canvas.create_text(
                center_x, center_y + 49, text="悬停技能查看明细",
                fill=SUBTLE, font=self._ui_font("micro"),
            ),
        }

        rank_left = left_width + 14.0
        rank_right = max(rank_left + 120.0, width - 14.0)
        canvas.create_text(
            rank_left + 8.0, 18, text="技能排行",
            fill=SUBTLE, anchor="w", font=self._ui_font("micro"),
        )
        canvas.create_text(
            rank_right - 8.0, 18,
            text="有效治疗 · 占比" if mode == "hps" else "伤害 · 占比",
            fill=SUBTLE, anchor="e", font=self._ui_font("micro"),
        )
        canvas.create_line(rank_left, 33, rank_right, 33, fill="#252d34")

        class_id = int(participant.get("profession_id", 0) or 0)
        icons: list[object] = []
        column_gap = 12.0
        column_width = max(70.0, (rank_right - rank_left - column_gap) / 2.0)
        grid_top = 34.0
        footer_height = 25.0
        row_height = max(38.0, (height - grid_top - footer_height) / 6.0)
        max_share = max(
            (float(segment.get("share", 0.0)) for segment in segments),
            default=1.0,
        )
        for index, segment in enumerate(segments):
            column = 0 if index < 6 else 1
            row_index = index if index < 6 else index - 6
            row_left = rank_left + column * (column_width + column_gap)
            row_right = min(rank_right, row_left + column_width)
            row_top = grid_top + row_index * row_height
            row_bottom = min(height - footer_height, row_top + row_height)
            color = str(segment["color"])
            tag = f"history-share-segment:{index}"
            row_background = canvas.create_rectangle(
                row_left, row_top, row_right, row_bottom,
                fill=stage_color, outline="", tags=(tag,),
            )
            if index < len(render_items):
                render_items[index]["row_background"] = row_background
            canvas.create_line(
                row_left, row_bottom, row_right, row_bottom,
                fill="#252d34", tags=(tag,),
            )
            canvas.create_rectangle(
                row_left, row_top + 5, row_left + 3, row_bottom - 5,
                fill=color, outline="", tags=(tag,),
            )
            rank_x = row_left + 14.0
            icon_x = row_left + 42.0
            text_x = row_left + 65.0
            percent_x = row_right - 8.0
            primary_y = row_top + max(15.0, row_height * 0.31)
            secondary_y = row_top + max(31.0, row_height * 0.64)
            canvas.create_text(
                rank_x, (row_top + row_bottom) / 2.0,
                text=f"{index + 1:02d}", fill=SUBTLE,
                font=self._ui_font("micro"), tags=(tag,),
            )
            icon = self.icons.skill(
                int(segment["skill_id"]), str(segment["name"]), class_id, 29
            )
            icons.append(icon)
            canvas.create_image(
                icon_x, (row_top + row_bottom) / 2.0,
                image=icon, anchor="center", tags=(tag,),
            )
            name_width = max(28.0, percent_x - text_x - 57.0)
            canvas.create_text(
                text_x, primary_y,
                text=self._fit_ui_text(
                    str(segment["name"]), name_width, "strong"
                ),
                fill=TEXT, anchor="w",
                font=self._ui_font("strong"), tags=(tag,),
            )
            canvas.create_text(
                percent_x, primary_y,
                text=f"{float(segment['share']) * 100:.1f}%",
                fill=color, anchor="e",
                font=self._ui_font("number_strong"), tags=(tag,),
            )
            canvas.create_text(
                text_x, secondary_y,
                text=(
                    f"有效治疗 {format_number(segment['amount'])}"
                    if mode == "hps"
                    else f"伤害 {format_number(segment['amount'])}"
                ),
                fill=SUBTLE, anchor="w",
                font=self._ui_font("micro"), tags=(tag,),
            )
            track_width = min(65.0, max(34.0, column_width * 0.20))
            track_right = percent_x
            track_left = track_right - track_width
            track_y = min(row_bottom - 8.0, secondary_y + 9.0)
            canvas.create_rectangle(
                track_left, track_y, track_right, track_y + 3,
                fill="#303941", outline="", tags=(tag,),
            )
            relative_share = (
                float(segment["share"]) / max_share if max_share > 0 else 0.0
            )
            canvas.create_rectangle(
                track_left, track_y,
                track_left + max(2.0, track_width * relative_share),
                track_y + 3,
                fill=color, outline="", tags=(tag,),
            )
            tag_bind = getattr(canvas, "tag_bind", None)
            if callable(tag_bind):
                tag_bind(
                    tag, "<Enter>",
                    lambda event, selected_index=index: (
                        self._history_skill_share_enter(event, selected_index)
                    ),
                )
                tag_bind(tag, "<Leave>", self._history_skill_share_leave)
        footer_y = height - 10.0
        canvas.create_text(
            rank_left + 8.0, footer_y,
            text=(
                "最多展示 12 个治疗技能"
                if mode == "hps" else "最多展示 12 个技能"
            ),
            fill=SUBTLE, anchor="w", font=self._ui_font("micro"),
        )
        if rank_right - rank_left >= 420.0:
            canvas.create_text(
                rank_right - 8.0, footer_y,
                text="其余技能合并为其他技能",
                fill=SUBTLE, anchor="e", font=self._ui_font("micro"),
            )
        self.history_skill_share_render = {
            "items": render_items,
            "center": center_items,
            "ring_width": ring_width,
            "stage_color": stage_color,
            "center_caption": center_caption,
            "detail_caption": (
                "占个人有效治疗"
                if mode == "hps"
                else "占该来源伤害"
                if mode == "boss_damage"
                else "占个人总伤害"
            ),
            "total": total,
        }
        canvas._history_skill_share_icons = icons

    def _draw_history_skill_quality(self) -> None:
        canvas = getattr(self, "history_skill_quality_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        mode = getattr(self, "history_meter_mode", "dps")
        record, damage_participant = self._selected_history_damage_participant()
        boss_skills: list[dict] = []
        boss_events: dict[int, list[dict[str, object]]] = {}
        boss_duration = 1.0
        if mode == "boss_damage":
            (
                record,
                participant,
                boss_skills,
                boss_events,
                boss_duration,
            ) = self._history_skill_timeline_payload()
        else:
            participant = damage_participant
        if mode == "boss_damage":
            record = self._selected_history_record()
            boss_damage = self._history_boss_damage(record)
            status_text, status_color = self._history_boss_coverage_text(
                boss_damage
            )
            ratio = boss_damage.get("classification_ratio")
            ratio_text = self._history_rate_text(ratio)
            metrics = (
                ("数据状态", status_text, status_color),
                (
                    "已归类伤害",
                    format_number(boss_damage.get("observed_damage", 0) or 0),
                    "#e67d72",
                ),
                (
                    "未归类承伤",
                    self._history_optional_number(
                        boss_damage.get("unassigned_taken")
                    ),
                    WARN,
                ),
                (
                    "归类比例",
                    ratio_text,
                    ACCENT if ratio_text != "--" else MUTED,
                ),
            )
            cell_width = width / len(metrics)
            for index, (caption, value, color) in enumerate(metrics):
                left = index * cell_width
                if index:
                    canvas.create_line(
                        left, 16, left, height - 16, fill=BORDER
                    )
                canvas.create_text(
                    left + 16,
                    height / 2 - 15,
                    text=caption,
                    fill=SUBTLE,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                canvas.create_text(
                    left + 16,
                    height / 2 + 12,
                    text=value,
                    fill=color,
                    anchor="w",
                    font=self._ui_font("number_strong"),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        if mode in {"hps", "dt"} and isinstance(record, dict):
            collection_name = "healers" if mode == "hps" else "damage_taken"
            collection = record.get(collection_name, [])
            collection = collection if isinstance(collection, list) else []
            participant = next(
                (
                    row
                    for row in collection
                    if isinstance(row, dict)
                    and int(row.get("actor_id", 0) or 0)
                    == int(self.history_selected_actor or 0)
                ),
                None,
            )
        if mode != "dps":
            heading = (
                "当前没有逐次治疗命中数据"
                if mode == "hps"
                else "当前没有承伤来源明细"
            )
            detail = (
                "仅展示结算有效治疗、治疗占比与过量率"
                if mode == "hps"
                else "仅展示玩家承伤量与队内占比"
            )
            canvas.create_text(
                width // 2,
                height // 2 - 8,
                text=heading,
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text=detail,
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        events = self._history_self_skill_events(record, damage_participant)
        if not isinstance(participant, dict):
            canvas.create_text(width // 2, height // 2, text="请选择队员", fill=MUTED, font=self._ui_font("strong"))
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        pvp_record = (
            isinstance(record, dict)
            and str(record.get("combat_mode", "")).casefold() == "pvp"
        )
        if (not pvp_record and participant.get("is_self") is not True) or not events:
            canvas.create_text(width // 2, height // 2 - 8, text="逐技能暴击 / 穿刺暂不可用", fill=MUTED, font=self._ui_font("strong"))
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text=(
                    "本场没有返回该玩家的逐次技能命中，不展示推测值"
                    if pvp_record
                    else "队友结算只提供角色总体数据，不展示推测值"
                ),
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        skill_map = {
            int(row.get("skill_id", 0) or 0): row
            for row in self._history_damage_skills(participant)
        }
        ordered = [skill_id for skill_id in skill_map if skill_id in events]
        if not ordered:
            canvas.create_text(
                width // 2, height // 2, text="暂无可验证的逐技能命中",
                fill=MUTED, font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        palette = self._history_skill_palette()
        row_height = 43
        header_height = 29
        column_gap = 1
        column_count = 2 if width >= 720 and len(ordered) > 1 else 1
        rows_per_column = int(math.ceil(len(ordered) / column_count))
        column_width = (width - column_gap * (column_count - 1)) / column_count
        content_height = header_height + rows_per_column * row_height
        class_id = int(participant.get("profession_id", 0) or 0)
        icons: list[object] = []
        maximum_damage = max(
            (max(0, int(skill_map[skill_id].get("damage", 0) or 0)) for skill_id in ordered),
            default=1,
        ) or 1
        for column_index in range(column_count):
            column_left = column_index * (column_width + column_gap)
            column_right = column_left + column_width
            if column_index:
                canvas.create_line(
                    column_left - 1, 0, column_left - 1, max(height, content_height),
                    fill=BORDER,
                )
            canvas.create_rectangle(
                column_left, 0, column_right, header_height,
                fill="#101318", outline="",
            )
            identity_right = column_left + column_width * 0.46
            hit_x = column_left + column_width * 0.58
            critical_left = column_left + column_width * 0.66
            critical_right = column_left + column_width * 0.81
            penetration_left = column_left + column_width * 0.84
            penetration_right = column_right - 12
            for x, text, anchor in (
                (column_left + 12, "技能", "w"),
                (hit_x, "真实命中", "center"),
                (critical_right, "暴击率", "e"),
                (penetration_right, "穿刺率", "e"),
            ):
                canvas.create_text(
                    x, header_height / 2, text=text, fill=SUBTLE,
                    anchor=anchor, font=self._ui_font("micro"),
                )

        for ordered_index, skill_id in enumerate(ordered):
            column_index = ordered_index // rows_per_column
            row_index = ordered_index % rows_per_column
            column_left = column_index * (column_width + column_gap)
            column_right = column_left + column_width
            identity_right = column_left + column_width * 0.46
            hit_x = column_left + column_width * 0.58
            critical_left = column_left + column_width * 0.66
            critical_right = column_left + column_width * 0.81
            penetration_left = column_left + column_width * 0.84
            penetration_right = column_right - 12
            top = header_height + row_index * row_height
            bottom = top + row_height
            skill_events = events[skill_id]
            known_critical = [
                row["critical"]
                for row in skill_events
                if row.get("critical") is not None
            ]
            known_penetration = [
                row["penetrating"]
                for row in skill_events
                if row.get("penetrating") is not None
            ]
            critical_hits = sum(bool(value) for value in known_critical)
            penetration_hits = sum(bool(value) for value in known_penetration)
            critical = (
                critical_hits / len(known_critical) if known_critical else None
            )
            penetration = (
                penetration_hits / len(known_penetration)
                if known_penetration
                else None
            )
            name = (
                str(skill_map[skill_id].get("name", "")).strip()
                or "未命名技能"
            )
            color = palette[ordered_index % len(palette)]
            canvas.create_rectangle(
                column_left, top, column_right, bottom,
                fill="#12171c" if row_index % 2 == 0 else PANEL,
                outline="",
            )
            damage = max(0, int(skill_map[skill_id].get("damage", 0) or 0))
            canvas.create_rectangle(
                column_left,
                top + 3,
                column_left + (identity_right - column_left) * damage / maximum_damage,
                bottom - 3,
                fill=blend_color(PANEL, color, 0.09),
                outline="",
            )
            canvas.create_rectangle(
                column_left, top + 3, column_left + 2, bottom - 3,
                fill=color, outline="",
            )
            icon_size = 29
            icon = self.icons.skill(skill_id, name, class_id, icon_size)
            icons.append(icon)
            canvas.create_image(
                column_left + 9, top + (row_height - icon_size) / 2,
                image=icon, anchor="nw",
            )
            canvas.create_text(
                column_left + 46, top + row_height / 2,
                text=self._fit_ui_text(
                    name, max(42, identity_right - column_left - 52), "strong"
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                hit_x, top + row_height / 2,
                text=str(len(skill_events)), fill=TEXT,
                anchor="center", font=self._ui_font("number_strong"),
            )
            for value, left, right, bar_color in (
                (critical, critical_left, critical_right, "#b990e9"),
                (penetration, penetration_left, penetration_right, "#57cdb5"),
            ):
                text_value = "--" if value is None else f"{value * 100:.1f}%"
                canvas.create_text(
                    left, top + 14,
                    text=text_value,
                    fill=TEXT if value is not None else SUBTLE,
                    anchor="w", font=self._ui_font("micro"),
                )
                track_left = left
                track_right = right
                track_top = top + 30
                canvas.create_rectangle(
                    track_left, track_top, track_right, track_top + 3,
                    fill="#293139",
                    outline="",
                )
                if value is not None:
                    canvas.create_rectangle(
                        track_left, track_top,
                        track_left + (track_right - track_left) * max(0.0, min(1.0, value)),
                        track_top + 3,
                        fill=bar_color,
                        outline="",
                    )
            canvas.create_line(
                column_left + 8, bottom - 1, column_right - 8, bottom - 1,
                fill="#242b32",
            )
        canvas._history_skill_quality_icons = icons
        canvas.configure(scrollregion=(0, 0, width, max(height, content_height)))

    @staticmethod
    def _history_median(values: list[float]) -> float | None:
        finite = sorted(value for value in values if math.isfinite(value) and value > 0)
        if not finite:
            return None
        middle = len(finite) // 2
        if len(finite) % 2:
            return finite[middle]
        return (finite[middle - 1] + finite[middle]) / 2.0

    def _history_critical_luck_model(
        self, record: dict | None, participant: dict | None
    ) -> dict[str, object] | None:
        """Estimate how crit placement changed the selected player's damage.

        The archive has exact per-hit damage and crit flags for the local
        player, but it does not expose a canonical crit multiplier per skill.
        Infer conservative per-skill multipliers from observed medians, then
        hold each skill's observed crit count fixed while measuring whether
        those crits landed on unusually large hits.  This evaluates crit
        placement without pretending that the archive contains a theoretical
        character crit chance.  It never changes combat data.
        """

        if not isinstance(record, dict) or not isinstance(participant, dict):
            return None
        if participant.get("is_self") is not True:
            return None
        events_by_skill = self._history_self_skill_events(record, participant)
        known_by_skill: dict[int, list[dict[str, object]]] = {}
        for skill_id, rows in events_by_skill.items():
            known = [
                row for row in rows
                if isinstance(row.get("critical"), bool)
                and max(0, int(row.get("damage", 0) or 0)) > 0
            ]
            if known:
                known_by_skill[int(skill_id)] = known
        known_count = sum(len(rows) for rows in known_by_skill.values())
        if known_count < 8:
            return None
        critical_count = sum(
            int(row.get("critical") is True)
            for rows in known_by_skill.values()
            for row in rows
        )
        observed_rate = critical_count / known_count
        inferred_ratios: list[float] = []
        ratio_by_skill: dict[int, float] = {}
        for skill_id, rows in known_by_skill.items():
            critical_damage = [
                float(row["damage"]) for row in rows if row.get("critical") is True
            ]
            normal_damage = [
                float(row["damage"]) for row in rows if row.get("critical") is False
            ]
            critical_median = self._history_median(critical_damage)
            normal_median = self._history_median(normal_damage)
            if critical_median is None or normal_median is None:
                continue
            inferred = min(2.80, max(1.10, critical_median / normal_median))
            inferred_ratios.append(inferred)
            ratio_by_skill[skill_id] = inferred
        global_ratio = self._history_median(inferred_ratios) or 1.50

        observed_damage = 0.0
        expected_damage = 0.0
        variance = 0.0
        for skill_id, rows in known_by_skill.items():
            skill_count = len(rows)
            skill_critical = sum(row.get("critical") is True for row in rows)
            skill_rate = skill_critical / max(1, skill_count)
            multiplier = ratio_by_skill.get(skill_id, global_ratio)
            base_values: list[float] = []
            critical_deltas: list[float] = []
            for row in rows:
                damage = float(max(0, int(row.get("damage", 0) or 0)))
                base_damage = damage / multiplier if row.get("critical") is True else damage
                critical_delta = base_damage * (multiplier - 1.0)
                observed_damage += damage
                base_values.append(base_damage)
                critical_deltas.append(critical_delta)
            expected_damage += sum(base_values) + sum(critical_deltas) * skill_rate
            if skill_count > 1 and 0 < skill_critical < skill_count:
                mean_delta = sum(critical_deltas) / skill_count
                squared_deviations = sum(
                    (value - mean_delta) ** 2 for value in critical_deltas
                )
                variance += (
                    skill_critical
                    * (skill_count - skill_critical)
                    / (skill_count * (skill_count - 1))
                    * squared_deviations
                )
        if expected_damage <= 0:
            return None
        try:
            participant_damage = max(0.0, float(participant.get("damage", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            participant_damage = 0.0
        # Older archives can retain only a verified subset of the local event
        # log.  Project the sample delta onto the archived total so the chart's
        # x-axis remains comparable with the player's displayed total damage.
        if participant_damage > 0 and observed_damage > 0:
            projection = participant_damage / observed_damage
            observed_damage *= projection
            expected_damage *= projection
            variance *= projection * projection
        sigma = max(math.sqrt(max(0.0, variance)), expected_damage * 0.0008, 1.0)
        z_score = (observed_damage - expected_damage) / sigma
        percentile = 0.5 * (1.0 + math.erf(z_score / math.sqrt(2.0)))
        percentile = min(0.999, max(0.001, percentile))
        if percentile >= 0.90:
            verdict, verdict_color = "非常好运", ACCENT
        elif percentile >= 0.67:
            verdict, verdict_color = "略有好运", ACCENT
        elif percentile > 0.33:
            verdict, verdict_color = "接近期望", "#9fb0bd"
        elif percentile > 0.10:
            verdict, verdict_color = "略显倒霉", WARN
        else:
            verdict, verdict_color = "非常倒霉", ERROR
        tail_percent = max(
            1,
            min(
                99,
                int(round((1.0 - percentile) * 100 if percentile >= 0.5 else percentile * 100)),
            ),
        )
        return {
            "observed": observed_damage,
            "expected": expected_damage,
            "sigma": sigma,
            "z_score": z_score,
            "percentile": percentile,
            "tail_percent": tail_percent,
            "rank_text": (
                f"运气前 {tail_percent}%" if percentile >= 0.5
                else f"运气后 {tail_percent}%"
            ),
            "verdict": verdict,
            "verdict_color": verdict_color,
            "extra": observed_damage - expected_damage,
            "extra_ratio": (observed_damage - expected_damage) / expected_damage,
            "known_hits": known_count,
            "critical_hits": critical_count,
            "critical_rate": observed_rate,
            "multiplier": global_ratio,
        }

    def _draw_history_critical_luck(self) -> None:
        canvas = getattr(self, "history_critical_luck_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        self.history_critical_luck_plot = None
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        mode = getattr(self, "history_meter_mode", "dps")
        record, participant = self._selected_history_damage_participant()
        caption = getattr(self, "history_critical_luck_caption_label", None)
        if mode == "boss_damage":
            if caption is not None:
                try:
                    caption.configure(text="首领伤害不推测暴击属性")
                except (AttributeError, tk.TclError):
                    pass
            canvas.create_text(
                width // 2,
                height // 2 - 8,
                text="首领攻击仅展示已确认伤害事实",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text="不推断暴击、穿刺或技能与死亡之间的因果关系",
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            return
        if mode != "dps":
            if caption is not None:
                try:
                    caption.configure(text="仅伤害模式")
                except (AttributeError, tk.TclError):
                    pass
            canvas.create_text(
                width // 2, height // 2 - 8,
                text="当前模式不计算暴击运气",
                fill=MUTED, font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2, height // 2 + 15,
                text="切换至伤害 DPS，可查看本机真实暴击分布",
                fill=SUBTLE, font=self._ui_font("micro"),
            )
            return
        model = self._history_critical_luck_model(record, participant)
        if model is None:
            if caption is not None:
                try:
                    caption.configure(text="需要本机逐次暴击数据")
                except (AttributeError, tk.TclError):
                    pass
            canvas.create_text(
                width // 2, height // 2 - 8,
                text="暂无足够的暴击运气样本",
                fill=MUTED, font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2, height // 2 + 15,
                text="至少需要 8 次带暴击标记的本机真实命中；队友数据不做推测",
                fill=SUBTLE, font=self._ui_font("micro"),
            )
            return
        if caption is not None:
            try:
                caption.configure(
                    text=f"{int(model['known_hits'])} 次真实命中 · 概率分布估算"
                )
            except (AttributeError, tk.TclError):
                pass

        verdict_color = str(model["verdict_color"])
        canvas.create_rectangle(0, 0, width, 43, fill="#101318", outline="")
        canvas.create_text(
            15, 22, text="本场暴击结果", fill=MUTED,
            anchor="w", font=self._ui_font("micro"),
        )
        canvas.create_text(
            92, 22, text=str(model["verdict"]), fill=verdict_color,
            anchor="w", font=self._ui_font("strong"),
        )
        rank_text = str(model["rank_text"])
        rank_width = max(66, len(rank_text) * 12)
        canvas.create_rectangle(
            164, 10, 164 + rank_width, 33,
            fill=blend_color("#101318", verdict_color, 0.16),
            outline=blend_color(BORDER, verdict_color, 0.62),
        )
        canvas.create_text(
            164 + rank_width / 2, 22, text=rank_text,
            fill=verdict_color, font=self._ui_font("micro"),
        )
        extra = float(model["extra"])
        extra_ratio = float(model["extra_ratio"])
        extra_prefix = "多造成" if extra >= 0 else "少造成"
        canvas.create_text(
            width - 15, 22,
            text=(
                f"比期望{extra_prefix} {format_number(abs(extra))} 伤害  "
                f"({extra_ratio:+.2%})"
            ),
            fill=verdict_color, anchor="e", font=self._ui_font("strong"),
        )
        canvas.create_line(0, 43, width, 43, fill=BORDER)

        expected = float(model["expected"])
        observed = float(model["observed"])
        sigma = float(model["sigma"])
        minimum = min(expected - sigma * 3.8, observed - sigma * 0.65)
        maximum = max(expected + sigma * 3.8, observed + sigma * 0.65)
        minimum = max(0.0, minimum)
        if maximum <= minimum:
            maximum = minimum + 1.0
        left, right = 55.0, max(80.0, width - 34.0)
        top, bottom = 59.0, max(92.0, height - 28.0)
        chart_height = max(20.0, bottom - top - 10.0)

        def point(value: float) -> tuple[float, float]:
            x = left + (right - left) * (value - minimum) / (maximum - minimum)
            z_value = (value - expected) / sigma
            density = math.exp(-0.5 * z_value * z_value)
            y = bottom - density * chart_height
            return x, y

        curve: list[float] = []
        for index in range(121):
            value = minimum + (maximum - minimum) * index / 120.0
            curve.extend(point(value))
        canvas.create_polygon(
            left, bottom, *curve, right, bottom,
            fill=blend_color("#101419", "#6489e8", 0.28), outline="",
        )
        canvas.create_line(
            *curve, fill="#6489e8", width=2, smooth=True, splinesteps=18,
        )
        canvas.create_line(left, bottom, right, bottom, fill="#46515b")
        expected_x, _expected_y = point(expected)
        observed_x, observed_y = point(observed)
        canvas.create_line(
            expected_x, top, expected_x, bottom,
            fill="#9ca8b2", dash=(5, 4),
        )
        canvas.create_text(
            expected_x - 8, (top + bottom) / 2,
            text="期望伤害", fill=SUBTLE, angle=90,
            font=self._ui_font("micro"),
        )
        canvas.create_line(
            observed_x, top - 3, observed_x, bottom,
            fill=ACCENT, width=2,
        )
        canvas.create_oval(
            observed_x - 4, observed_y - 4, observed_x + 4, observed_y + 4,
            fill=ACCENT, outline="#10231e",
        )
        canvas.create_text(
            observed_x, top - 10, text="你的伤害",
            fill=TEXT, font=self._ui_font("micro"),
        )
        for tick in range(7):
            fraction = tick / 6.0
            x = left + (right - left) * fraction
            value = minimum + (maximum - minimum) * fraction
            canvas.create_line(x, bottom, x, bottom + 4, fill="#59656f")
            canvas.create_text(
                x, bottom + 15, text=format_number(value),
                fill=SUBTLE,
                anchor="w" if tick == 0 else "e" if tick == 6 else "center",
                font=self._ui_font("micro"),
            )
        self.history_critical_luck_plot = {
            "model": model,
            "left": left,
            "right": right,
            "top": top,
            "bottom": bottom,
            "minimum": minimum,
            "maximum": maximum,
        }

    def _history_critical_luck_motion(self, event) -> str:
        canvas = getattr(self, "history_critical_luck_canvas", None)
        plot = getattr(self, "history_critical_luck_plot", None)
        if canvas is None or not isinstance(plot, dict):
            return "break"
        left = float(plot["left"])
        right = float(plot["right"])
        try:
            pointer_x = float(canvas.canvasx(event.x))
        except (AttributeError, TypeError, ValueError, tk.TclError):
            return "break"
        if not left <= pointer_x <= right:
            return self._history_critical_luck_leave()
        minimum = float(plot["minimum"])
        maximum = float(plot["maximum"])
        value = minimum + (pointer_x - left) / max(1.0, right - left) * (maximum - minimum)
        model = plot["model"]
        expected = float(model["expected"])
        sigma = float(model["sigma"])
        z_score = (value - expected) / sigma
        percentile = 0.5 * (1.0 + math.erf(z_score / math.sqrt(2.0)))
        density = math.exp(-0.5 * z_score * z_score)
        top = float(plot["top"])
        bottom = float(plot["bottom"])
        point_y = bottom - density * max(20.0, bottom - top - 10.0)
        canvas.delete("history-critical-hover")
        tags = ("history-critical-hover",)
        canvas.create_line(
            pointer_x, top, pointer_x, bottom,
            fill="#8aa8ea", dash=(2, 3), tags=tags,
        )
        canvas.create_oval(
            pointer_x - 3, point_y - 3, pointer_x + 3, point_y + 3,
            fill="#a9beff", outline="", tags=tags,
        )
        tip_width, tip_height = 210, 48
        tip_left = min(max(left, pointer_x + 10), max(left, right - tip_width))
        tip_top = max(top, point_y - tip_height - 8)
        canvas.create_rectangle(
            tip_left, tip_top, tip_left + tip_width, tip_top + tip_height,
            fill="#171c21", outline="#5f79b3", tags=tags,
        )
        canvas.create_text(
            tip_left + 9, tip_top + 9,
            text=f"模拟伤害  {format_number(value)}",
            fill="#a9beff", anchor="nw", font=self._ui_font("strong"), tags=tags,
        )
        canvas.create_text(
            tip_left + 9, tip_top + 31,
            text=f"约位于第 {percentile * 100:.1f} 百分位",
            fill=MUTED, anchor="nw", font=self._ui_font("micro"), tags=tags,
        )
        canvas.tag_raise("history-critical-hover")
        return "break"

    def _history_critical_luck_leave(self, _event=None) -> str:
        canvas = getattr(self, "history_critical_luck_canvas", None)
        if canvas is not None:
            try:
                canvas.delete("history-critical-hover")
            except tk.TclError:
                pass
        return "break"

    def _set_history_skill_timeline_mode(self, mode: str) -> None:
        if mode != "all":
            return
        self.history_skill_timeline_mode = "all"
        self._sync_history_skill_timeline_buttons()
        self._draw_history_skill_timeline()

    def _sync_history_skill_timeline_buttons(self) -> None:
        selected = getattr(self, "history_skill_timeline_mode", "all")
        enabled = getattr(self, "history_meter_mode", "dps") in {
            "dps",
            "boss_damage",
        }
        for mode, button in getattr(self, "history_skill_timeline_buttons", {}).items():
            active = enabled and mode == selected
            button.configure(
                bg="#193c33" if active else "#101318",
                fg=ACCENT if active else MUTED if enabled else SUBTLE,
                cursor="hand2" if enabled else "arrow",
            )

    def _history_skill_timeline_payload(
        self,
    ) -> tuple[dict | None, dict | None, list[dict], dict[int, list[dict[str, object]]], float]:
        if getattr(self, "history_meter_mode", "dps") == "boss_damage":
            def integer(value: object) -> int:
                try:
                    return int(value or 0)
                except (TypeError, ValueError, OverflowError):
                    return 0

            record = self._selected_history_record()
            if not isinstance(record, dict):
                return None, None, [], {}, 1.0
            boss_damage = self._history_boss_damage(record)
            source = next(
                (
                    row
                    for row in self._history_boss_sources(record)
                    if integer(row.get("entity_id"))
                    == integer(self.history_selected_actor)
                ),
                None,
            )
            if not isinstance(source, dict):
                return record, None, [], {}, max(
                    self._history_display_duration(record), 1.0
                )
            skills = self._history_damage_skills(source)
            skill_by_id = {
                integer(row.get("skill_id")): row for row in skills
            }
            raw_source_ids = source.get("entity_ids", [])
            source_ids = {
                parsed
                for value in (
                    raw_source_ids if isinstance(raw_source_ids, list) else []
                )
                if (parsed := integer(value)) > 0
            }
            source_ids.add(integer(source.get("entity_id")))
            source_ids.discard(0)
            raw_targets = source.get("targets", [])
            target_names = {
                integer(row.get("actor_id")): str(row.get("name", "")).strip()
                for row in (raw_targets if isinstance(raw_targets, list) else [])
                if isinstance(row, dict)
            }
            event_log = boss_damage.get("event_log")
            event_log = event_log if isinstance(event_log, dict) else {}
            columns = event_log.get("columns", [])
            columns = columns if isinstance(columns, list) else []
            column_indexes = {
                str(name): index for index, name in enumerate(columns)
            }

            def event_value(raw_row: object, key: str, default: object = 0) -> object:
                if isinstance(raw_row, dict):
                    return raw_row.get(key, default)
                index = column_indexes.get(key)
                if isinstance(raw_row, (list, tuple)) and index is not None:
                    return raw_row[index] if index < len(raw_row) else default
                return default

            events: dict[int, list[dict[str, object]]] = {}
            raw_event_rows = event_log.get("rows", [])
            if isinstance(raw_event_rows, list):
                for raw_row in raw_event_rows:
                    try:
                        source_id = int(event_value(raw_row, "source_id") or 0)
                        target_id = int(event_value(raw_row, "target_id") or 0)
                        skill_id = int(event_value(raw_row, "skill_id") or 0)
                        damage = max(
                            0, int(event_value(raw_row, "damage") or 0)
                        )
                        time_seconds = max(
                            0.0,
                            float(event_value(raw_row, "time_ms") or 0)
                            / 1000.0,
                        )
                    except (TypeError, ValueError, OverflowError):
                        continue
                    if source_id not in source_ids or damage <= 0:
                        continue
                    target_name = target_names.get(target_id, "") or "队伍成员"
                    if self._history_names_hidden():
                        target_name = "已隐藏成员"
                    skill = skill_by_id.get(skill_id, {})
                    events.setdefault(skill_id, []).append(
                        {
                            "time_seconds": time_seconds,
                            "damage": damage,
                            "target_id": target_id,
                            "target_name": target_name,
                            "source_id": source_id,
                            "source_name": str(source.get("name", "") or "首领"),
                            "critical": None,
                            "penetrating": None,
                            "name": str(skill.get("name", "") or "未命名技能"),
                        }
                    )
            for rows in events.values():
                rows.sort(key=lambda row: float(row.get("time_seconds", 0.0)))
            skills = [
                row
                for row in skills
                if integer(row.get("skill_id")) in events
            ]
            participant = {
                **source,
                "actor_id": integer(source.get("entity_id")),
                "profession_id": 0,
                "is_self": True,
            }
            duration = max(
                self._history_display_duration(record),
                max(
                    (
                        float(event.get("time_seconds", 0.0) or 0.0)
                        for rows in events.values()
                        for event in rows
                    ),
                    default=0.0,
                ),
                1.0,
            )
            return record, participant, skills, events, duration
        record, participant = self._selected_history_damage_participant()
        pvp_record = (
            isinstance(record, dict)
            and str(record.get("combat_mode", "")).casefold() == "pvp"
        )
        if (
            getattr(self, "history_meter_mode", "dps") != "dps"
            or not isinstance(record, dict)
            or not isinstance(participant, dict)
            or (not pvp_record and participant.get("is_self") is not True)
        ):
            return record, participant, [], {}, 1.0
        events = self._history_self_skill_events(record, participant)
        skills = [
            row for row in self._history_damage_skills(participant)
            if int(row.get("skill_id", 0) or 0) in events
        ]
        duration = max(
            self._history_display_duration(record),
            max(
                (
                    float(event.get("time_seconds", 0.0) or 0.0)
                    for rows in events.values()
                    for event in rows
                ),
                default=0.0,
            ),
            1.0,
        )
        return record, participant, skills, events, duration

    def _history_skill_timeline_page_delta(self, amount: int) -> str:
        page_count = max(1, int(getattr(self, "history_skill_timeline_page_count", 1)))
        current = int(getattr(self, "history_skill_timeline_page", 0) or 0)
        self.history_skill_timeline_page = (current + int(amount)) % page_count
        self.history_skill_timeline_selected_hit = None
        self._draw_history_skill_timeline()
        return "break"

    def _toggle_history_skill_timeline_skill(self, skill_id: int) -> str:
        hidden = getattr(self, "history_skill_timeline_hidden_ids", None)
        if not isinstance(hidden, set):
            hidden = set()
            self.history_skill_timeline_hidden_ids = hidden
        skill_id = int(skill_id)
        if skill_id in hidden:
            hidden.remove(skill_id)
        else:
            hidden.add(skill_id)
        self.history_skill_timeline_selected_hit = None
        self._draw_history_skill_timeline()
        return "break"

    def _show_all_history_skill_timeline_skills(self) -> str:
        self.history_skill_timeline_hidden_ids = set()
        self._draw_history_skill_timeline()
        return "break"

    def _invert_history_skill_timeline_skills(self) -> str:
        _record, _participant, skills, _events, _duration = (
            self._history_skill_timeline_payload()
        )
        current_ids = {int(row.get("skill_id", 0) or 0) for row in skills}
        hidden = getattr(self, "history_skill_timeline_hidden_ids", set())
        hidden = hidden if isinstance(hidden, set) else set()
        self.history_skill_timeline_hidden_ids = current_ids - hidden
        self.history_skill_timeline_selected_hit = None
        self._draw_history_skill_timeline()
        return "break"

    def _reset_history_skill_timeline_view(self) -> str:
        self.history_skill_timeline_page = 0
        self.history_skill_timeline_hidden_ids = set()
        self.history_skill_timeline_range = (0.0, 1.0)
        self.history_skill_timeline_selected_hit = None
        self.history_skill_timeline_focus_time = None
        self._draw_history_skill_timeline()
        return "break"

    def _draw_history_skill_timeline_toolbar(self) -> None:
        canvas = getattr(self, "history_skill_timeline_toolbar_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        _record, participant, skills, _events, _duration = (
            self._history_skill_timeline_payload()
        )
        if not skills:
            canvas.create_text(
                12, height / 2,
                text=(
                    "当前模式没有逐次技能事件"
                    if getattr(self, "history_meter_mode", "dps") != "dps"
                    else "本机真实命中可用后显示技能图例"
                ),
                fill=SUBTLE, anchor="w", font=self._ui_font("micro"),
            )
            return
        palette = self._history_skill_palette()
        page_size = 6
        page_count = max(1, int(math.ceil(len(skills) / page_size)))
        self.history_skill_timeline_page_count = page_count
        page = min(page_count - 1, max(0, int(getattr(self, "history_skill_timeline_page", 0))))
        self.history_skill_timeline_page = page
        page_skills = skills[page * page_size:(page + 1) * page_size]
        hidden = getattr(self, "history_skill_timeline_hidden_ids", set())
        hidden = hidden if isinstance(hidden, set) else set()
        class_id = int(participant.get("profession_id", 0) or 0) if isinstance(participant, dict) else 0

        controls_width = 258
        legend_right = max(260, width - controls_width)
        x, y = 10.0, 17.0
        icons: list[object] = []
        for skill in page_skills:
            skill_id = int(skill.get("skill_id", 0) or 0)
            name = str(skill.get("name", "")).strip() or "未命名技能"
            source_index = next(
                (index for index, row in enumerate(skills) if int(row.get("skill_id", 0) or 0) == skill_id),
                0,
            )
            color = palette[source_index % len(palette)]
            item_width = min(132, max(82, 37 + len(name) * 12))
            if x + item_width > legend_right:
                x, y = 10.0, 45.0
            tag = f"history-timeline-legend-skill:{skill_id}"
            active = skill_id not in hidden
            canvas.create_rectangle(
                x, y - 13, x + item_width, y + 13,
                fill=blend_color("#101419", color, 0.08) if active else "#101419",
                outline=BORDER if active else "#20262c", tags=(tag,),
            )
            icon = self.icons.skill(skill_id, name, class_id, 22)
            icons.append(icon)
            canvas.create_image(x + 4, y, image=icon, anchor="w", tags=(tag,))
            canvas.create_text(
                x + 31, y,
                text=self._fit_ui_text(name, item_width - 37, "micro"),
                fill=TEXT if active else SUBTLE,
                anchor="w", font=self._ui_font("micro"), tags=(tag,),
            )
            canvas.tag_bind(
                tag, "<Button-1>",
                lambda _event, selected_id=skill_id: (
                    self._toggle_history_skill_timeline_skill(selected_id)
                ),
            )
            canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
            canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor="arrow"))
            x += item_width + 6
        canvas._history_skill_timeline_toolbar_icons = icons

        # These are derived from real hit damage and crit flags, rather than
        # fabricated boss/status events that are not present in the archive.
        marker_y = 47 if y < 30 else 17
        marker_x = 12
        rhythm_legend = (
            (("首领伤害节奏", "#e4665f"),)
            if getattr(self, "history_meter_mode", "dps") == "boss_damage"
            else (("伤害节奏", "#e4665f"), ("暴击节奏", "#e5b443"))
        )
        for label, color in rhythm_legend:
            canvas.create_line(
                marker_x, marker_y, marker_x + 18, marker_y,
                fill=color, width=2, dash=(2, 3),
            )
            canvas.create_text(
                marker_x + 24, marker_y, text=label,
                fill=MUTED, anchor="w", font=self._ui_font("micro"),
            )
            marker_x += 88

        def toolbar_button(
            left: float, top: float, button_width: float, caption: str,
            tag: str, command, *, active: bool = False
        ) -> None:
            canvas.create_rectangle(
                left, top, left + button_width, top + 28,
                fill="#193c33" if active else "#101318",
                outline=ACCENT if active else BORDER,
                tags=(tag,),
            )
            canvas.create_text(
                left + button_width / 2, top + 14, text=caption,
                fill=ACCENT if active else MUTED,
                font=self._ui_font("micro"), tags=(tag,),
            )
            canvas.tag_bind(tag, "<Button-1>", lambda _event: command())
            canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
            canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor="arrow"))

        control_top = (height - 28) / 2
        right = width - 10
        toolbar_button(right - 34, control_top, 34, "↻", "history-timeline-reset", self._reset_history_skill_timeline_view)
        right -= 40
        toolbar_button(right - 48, control_top, 48, "反选", "history-timeline-invert", self._invert_history_skill_timeline_skills)
        right -= 54
        toolbar_button(
            right - 48, control_top, 48, "全部", "history-timeline-all",
            self._show_all_history_skill_timeline_skills, active=not hidden,
        )
        right -= 58
        toolbar_button(right - 26, control_top, 26, "▶", "history-timeline-next", lambda: self._history_skill_timeline_page_delta(1))
        right -= 32
        canvas.create_text(
            right - 18, height / 2, text=f"{page + 1} / {page_count}",
            fill=MUTED, font=self._ui_font("micro"),
        )
        right -= 50
        toolbar_button(right - 26, control_top, 26, "◀", "history-timeline-previous", lambda: self._history_skill_timeline_page_delta(-1))

    def _draw_history_skill_timeline_range(self) -> None:
        canvas = getattr(self, "history_skill_timeline_range_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        _record, _participant, skills, events, duration = (
            self._history_skill_timeline_payload()
        )
        left, right = 14.0, max(30.0, width - 14.0)
        top, bottom = 10.0, max(20.0, height - 10.0)
        canvas.create_rectangle(
            left, top, right, bottom,
            fill="#343d47", outline="#55616c",
        )
        if not skills or not events:
            self.history_skill_timeline_range_bounds = (left, right, top, bottom, duration)
            return
        palette = self._history_skill_palette()
        color_by_id = {
            int(skill.get("skill_id", 0) or 0): palette[index % len(palette)]
            for index, skill in enumerate(skills)
        }
        event_rows = [
            (skill_id, event)
            for skill_id, rows in events.items()
            for event in rows
        ]
        if len(event_rows) > 900:
            stride = max(1, int(math.ceil(len(event_rows) / 900)))
            event_rows = event_rows[::stride]
        lane_height = max(1.0, (bottom - top - 4.0) / max(1, min(6, len(skills))))
        skill_position = {
            int(skill.get("skill_id", 0) or 0): index
            for index, skill in enumerate(skills)
        }
        for skill_id, event in event_rows:
            second = float(event.get("time_seconds", 0.0) or 0.0)
            x = left + (right - left) * min(1.0, max(0.0, second / duration))
            lane = skill_position.get(skill_id, 0) % 6
            y = top + 2 + lane * lane_height
            canvas.create_line(
                x, y, x, min(bottom - 2, y + max(2.0, lane_height - 1.0)),
                fill=color_by_id.get(skill_id, MUTED),
            )
        try:
            start_fraction, end_fraction = self.history_skill_timeline_range
        except (AttributeError, TypeError, ValueError):
            start_fraction, end_fraction = 0.0, 1.0
        start_fraction = min(1.0, max(0.0, float(start_fraction)))
        end_fraction = min(1.0, max(start_fraction, float(end_fraction)))
        start_x = left + (right - left) * start_fraction
        end_x = left + (right - left) * end_fraction
        if start_x > left:
            canvas.create_rectangle(
                left, top, start_x, bottom,
                fill="#11161b", stipple="gray50", outline="",
            )
        if end_x < right:
            canvas.create_rectangle(
                end_x, top, right, bottom,
                fill="#11161b", stipple="gray50", outline="",
            )
        canvas.create_rectangle(
            start_x, top, end_x, bottom,
            fill="", outline="#9aa8b2", width=1,
        )
        for x in (start_x, end_x):
            canvas.create_rectangle(
                x - 4, top - 1, x + 4, bottom + 1,
                fill="#89949d", outline="#c1c9cf",
            )
            canvas.create_line(x - 1, top + 5, x - 1, bottom - 5, fill="#46515a")
            canvas.create_line(x + 1, top + 5, x + 1, bottom - 5, fill="#b8c0c6")
        self.history_skill_timeline_range_bounds = (
            left, right, top, bottom, duration
        )

    def _history_skill_timeline_range_press(self, event) -> str:
        bounds = getattr(self, "history_skill_timeline_range_bounds", None)
        if not bounds:
            return "break"
        left, right, _top, _bottom, duration = bounds
        try:
            pointer_x = float(event.x)
            start_fraction, end_fraction = self.history_skill_timeline_range
        except (AttributeError, TypeError, ValueError):
            return "break"
        start_x = left + (right - left) * start_fraction
        end_x = left + (right - left) * end_fraction
        if abs(pointer_x - start_x) <= 9:
            kind = "start"
        elif abs(pointer_x - end_x) <= 9:
            kind = "end"
        elif start_x < pointer_x < end_x:
            kind = "window"
        else:
            kind = "window"
            span = end_fraction - start_fraction
            center = min(1.0, max(0.0, (pointer_x - left) / max(1.0, right - left)))
            start_fraction = min(1.0 - span, max(0.0, center - span / 2.0))
            end_fraction = start_fraction + span
            self.history_skill_timeline_range = (start_fraction, end_fraction)
            self._draw_history_skill_timeline()
        self.history_skill_timeline_range_drag = {
            "kind": kind,
            "pointer_x": pointer_x,
            "start": start_fraction,
            "end": end_fraction,
            "left": left,
            "right": right,
            "duration": duration,
        }
        canvas = getattr(self, "history_skill_timeline_range_canvas", None)
        if canvas is not None:
            canvas.configure(cursor="sb_h_double_arrow" if kind != "window" else "fleur")
        return "break"

    def _history_skill_timeline_range_motion(self, event) -> str:
        drag = getattr(self, "history_skill_timeline_range_drag", None)
        if not isinstance(drag, dict):
            return "break"
        try:
            delta = (float(event.x) - float(drag["pointer_x"])) / max(
                1.0, float(drag["right"]) - float(drag["left"])
            )
            start = float(drag["start"])
            end = float(drag["end"])
            duration = max(1.0, float(drag["duration"]))
        except (AttributeError, TypeError, ValueError):
            return "break"
        minimum = min(0.45, max(0.025, 10.0 / duration))
        kind = str(drag.get("kind", "window"))
        if kind == "start":
            start = min(end - minimum, max(0.0, start + delta))
        elif kind == "end":
            end = max(start + minimum, min(1.0, end + delta))
        else:
            span = end - start
            start = min(1.0 - span, max(0.0, start + delta))
            end = start + span
        self.history_skill_timeline_range = (start, end)
        self._draw_history_skill_timeline()
        return "break"

    def _history_skill_timeline_range_release(self, _event=None) -> str:
        self.history_skill_timeline_range_drag = None
        canvas = getattr(self, "history_skill_timeline_range_canvas", None)
        if canvas is not None:
            try:
                canvas.configure(cursor="arrow")
            except tk.TclError:
                pass
        return "break"

    @staticmethod
    def _format_history_hit_time(value: object) -> str:
        try:
            total_seconds = max(0, int(float(value)))
        except (TypeError, ValueError, OverflowError):
            total_seconds = 0
        minutes, seconds = divmod(total_seconds, 60)
        return f"{minutes:02d}:{seconds:02d}"

    @staticmethod
    def _history_hit_flag_text(label: str, value: object) -> str:
        if value is True:
            return label
        if value is False:
            return f"未{label}"
        return f"{label}未知"

    def _update_history_skill_timeline_selection(self) -> None:
        canvas = getattr(self, "history_skill_timeline_canvas", None)
        if canvas is None:
            return
        try:
            canvas.delete("history-timeline-cursor")
        except (AttributeError, tk.TclError):
            return
        hits = getattr(self, "history_skill_timeline_hits", {})
        selected = getattr(self, "history_skill_timeline_selected_hit", None)
        for key, hit in hits.items():
            item_id = hit.get("_item_id")
            color = str(hit.get("color", ACCENT))
            if item_id is None:
                continue
            active = key == selected
            try:
                canvas.itemconfigure(
                    item_id,
                    fill="#101419",
                    outline=("#ffffff" if active else str(hit.get("_outline", color))),
                    width=2 if active else 1,
                )
            except (AttributeError, tk.TclError):
                pass
        hit = hits.get(selected) if selected is not None else None
        bounds = getattr(self, "history_skill_timeline_plot_bounds", None)
        if not isinstance(hit, dict) or not bounds:
            return
        plot_left, plot_right, plot_top, plot_bottom, _duration = bounds
        cursor_x = max(plot_left, min(plot_right, float(hit.get("_x", plot_left))))
        try:
            canvas.create_line(
                cursor_x,
                plot_top,
                cursor_x,
                plot_bottom,
                fill=ACCENT,
                width=1,
                dash=(3, 3),
                tags=("history-timeline-cursor",),
            )
            badge_width = 70
            badge_left = max(
                plot_left,
                min(plot_right - badge_width, cursor_x - badge_width / 2),
            )
            canvas.create_rectangle(
                badge_left,
                2,
                badge_left + badge_width,
                24,
                fill="#17342c",
                outline=ACCENT,
                tags=("history-timeline-cursor",),
            )
            canvas.create_text(
                badge_left + badge_width / 2,
                13,
                text=self._format_history_hit_time(hit.get("time_seconds")),
                fill=ACCENT,
                font=self._ui_font("micro"),
                tags=("history-timeline-cursor",),
            )
            canvas.tag_raise(str(hit.get("_tag", "")))
            canvas.tag_raise("history-timeline-cursor")
            canvas.tag_raise(str(hit.get("_tag", "")))
        except (AttributeError, tk.TclError):
            pass

    def _history_skill_timeline_hit_from_pointer(
        self, event, *, clamp_x: bool = False
    ) -> tuple[int, int] | None:
        canvas = getattr(self, "history_skill_timeline_canvas", None)
        bounds = getattr(self, "history_skill_timeline_plot_bounds", None)
        hits = getattr(self, "history_skill_timeline_hits", {})
        if canvas is None or not bounds or not hits:
            return None
        plot_left, plot_right, plot_top, plot_bottom, duration = bounds
        try:
            pointer_x = float(canvas.canvasx(event.x))
            pointer_y = float(canvas.canvasy(event.y))
        except (AttributeError, TypeError, ValueError, tk.TclError):
            try:
                pointer_x = float(event.x)
                pointer_y = float(event.y)
            except (AttributeError, TypeError, ValueError):
                return None
        if not clamp_x and not (plot_left <= pointer_x <= plot_right):
            return None
        if pointer_y < plot_top - 26 or pointer_y > plot_bottom + 20:
            return None
        pointer_x = max(plot_left, min(plot_right, pointer_x))
        view_start = float(
            getattr(self, "history_skill_timeline_view_start", 0.0) or 0.0
        )
        target_time = view_start + (
            (pointer_x - plot_left) / max(1.0, plot_right - plot_left) * duration
        )
        row_hits = [
            (key, hit)
            for key, hit in hits.items()
            if float(hit.get("_row_top", plot_top))
            <= pointer_y
            <= float(hit.get("_row_bottom", plot_bottom))
        ]
        candidates = row_hits or list(hits.items())
        key, _hit = min(
            candidates,
            key=lambda item: (
                abs(float(item[1].get("time_seconds", 0.0)) - target_time),
                abs(float(item[1].get("_center_y", pointer_y)) - pointer_y),
                item[0],
            ),
        )
        return key

    def _history_skill_timeline_drag_start(self, event):
        key = self._history_skill_timeline_hit_from_pointer(event)
        if key is None:
            self.history_skill_timeline_dragging = False
            return None
        self.history_skill_timeline_dragging = True
        canvas = getattr(self, "history_skill_timeline_canvas", None)
        if canvas is not None:
            try:
                canvas.configure(cursor="sb_h_double_arrow")
            except tk.TclError:
                pass
        return self._select_history_skill_hit(key, redraw_timeline=False)

    def _history_skill_timeline_drag_motion(self, event):
        if not getattr(self, "history_skill_timeline_dragging", False):
            return None
        key = self._history_skill_timeline_hit_from_pointer(event, clamp_x=True)
        if key is not None:
            self._select_history_skill_hit(key, redraw_timeline=False)
        return "break"

    def _history_skill_timeline_drag_end(self, event):
        if getattr(self, "history_skill_timeline_dragging", False):
            key = self._history_skill_timeline_hit_from_pointer(event, clamp_x=True)
            if key is not None:
                self._select_history_skill_hit(key, redraw_timeline=False)
        self.history_skill_timeline_dragging = False
        canvas = getattr(self, "history_skill_timeline_canvas", None)
        if canvas is not None:
            try:
                canvas.configure(cursor="hand2")
            except tk.TclError:
                pass
        return "break"

    def _select_history_skill_hit(
        self, key: tuple[int, int], *, redraw_timeline: bool = True
    ) -> str:
        if key not in getattr(self, "history_skill_timeline_hits", {}):
            return "break"
        self.history_skill_timeline_selected_hit = key
        self.history_skill_timeline_hover_hit = None
        self.history_skill_timeline_focus_time = None
        self._update_history_skill_timeline_selection()
        self._draw_history_skill_hit_detail()
        return "break"

    def _step_history_skill_hit(self, amount: int) -> str:
        selected = getattr(self, "history_skill_timeline_selected_hit", None)
        hits = getattr(self, "history_skill_timeline_hits", {})
        if selected not in hits:
            return "break"
        skill_id, hit_index = selected
        keys = sorted(key for key in hits if key[0] == skill_id)
        try:
            position = keys.index((skill_id, hit_index))
        except ValueError:
            return "break"
        target = min(len(keys) - 1, max(0, position + int(amount)))
        return self._select_history_skill_hit(keys[target])

    def _select_history_skill_max_hit(self) -> str:
        selected = getattr(self, "history_skill_timeline_selected_hit", None)
        hits = getattr(self, "history_skill_timeline_hits", {})
        if selected not in hits:
            return "break"
        skill_id = selected[0]
        candidates = [key for key in hits if key[0] == skill_id]
        if not candidates:
            return "break"
        target = max(
            candidates,
            key=lambda key: int(hits[key].get("damage", 0) or 0),
        )
        return self._select_history_skill_hit(target)

    def _history_skill_hit_enter(self, event, key: tuple[int, int]) -> str:
        canvas = getattr(self, "history_skill_timeline_canvas", None)
        if canvas is None or key not in getattr(self, "history_skill_timeline_hits", {}):
            return "break"
        self.history_skill_timeline_hover_hit = key
        canvas.configure(cursor="hand2")
        tag = f"history-timeline-hit:{key[0]}:{key[1]}"
        try:
            canvas.itemconfigure(tag, width=2)
        except tk.TclError:
            pass
        self._draw_history_skill_hit_tooltip(event, key)
        return "break"

    def _history_skill_hit_leave(self, _event=None) -> str:
        canvas = getattr(self, "history_skill_timeline_canvas", None)
        previous = getattr(self, "history_skill_timeline_hover_hit", None)
        self.history_skill_timeline_hover_hit = None
        if canvas is not None:
            try:
                canvas.delete("history-timeline-tooltip")
                canvas.configure(
                    cursor=(
                        "sb_h_double_arrow"
                        if getattr(self, "history_skill_timeline_dragging", False)
                        else "arrow"
                    )
                )
                if previous is not None:
                    tag = f"history-timeline-hit:{previous[0]}:{previous[1]}"
                    canvas.itemconfigure(tag, width=1)
            except tk.TclError:
                pass
        return "break"

    def _draw_history_skill_hit_tooltip(
        self, event, key: tuple[int, int]
    ) -> None:
        canvas = getattr(self, "history_skill_timeline_canvas", None)
        hit = getattr(self, "history_skill_timeline_hits", {}).get(key)
        if canvas is None or not isinstance(hit, dict):
            return
        canvas.delete("history-timeline-tooltip")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        try:
            pointer_x = float(canvas.canvasx(event.x))
            pointer_y = float(canvas.canvasy(event.y))
            visible_top = float(canvas.canvasy(0))
            visible_bottom = float(canvas.canvasy(height))
        except (AttributeError, TypeError, ValueError, tk.TclError):
            pointer_x = float(getattr(event, "x", 0) or 0)
            pointer_y = float(getattr(event, "y", 0) or 0)
            visible_top, visible_bottom = 0.0, float(height)
        tooltip_width, tooltip_height = 272, 72
        left = min(max(8.0, pointer_x + 12.0), max(8.0, width - tooltip_width - 8.0))
        top = pointer_y - tooltip_height - 12.0
        if top < visible_top + 6:
            top = pointer_y + 12.0
        top = min(max(visible_top + 6, top), max(visible_top + 6, visible_bottom - tooltip_height - 6))
        right, bottom = left + tooltip_width, top + tooltip_height
        tags = ("history-timeline-tooltip",)
        canvas.create_polygon(
            left + 5,
            top,
            right - 5,
            top,
            right,
            top + 5,
            right,
            bottom - 5,
            right - 5,
            bottom,
            left + 5,
            bottom,
            left,
            bottom - 5,
            left,
            top + 5,
            fill="#171c20",
            outline=ACCENT,
            width=1,
            tags=tags,
        )
        name = str(hit.get("name", "")).strip() or "未命名技能"
        ordinal = int(hit.get("ordinal", 1) or 1)
        hit_count = int(hit.get("hit_count", 1) or 1)
        canvas.create_text(
            left + 10,
            top + 10,
            text=self._fit_ui_text(
                f"{name}  ·  第 {ordinal}/{hit_count} 次命中",
                tooltip_width - 20,
                "micro",
            ),
            fill=TEXT,
            anchor="nw",
            font=self._ui_font("strong"),
            tags=tags,
        )
        canvas.create_text(
            left + 10,
            top + 35,
            text=(
                f"{self._format_history_hit_time(hit.get('time_seconds'))}    "
                f"伤害 {self._history_optional_number(hit.get('damage'))}"
            ),
            fill=ACCENT,
            anchor="nw",
            font=self._ui_font("micro"),
            tags=tags,
        )
        canvas.create_text(
            right - 10,
            top + 56,
            text=(
                f"受击成员：{hit.get('target_name', '队伍成员')}"
                if getattr(self, "history_meter_mode", "dps") == "boss_damage"
                else (
                    f"{self._history_hit_flag_text('暴击', hit.get('critical'))}  ·  "
                    f"{self._history_hit_flag_text('穿刺', hit.get('penetrating'))}"
                )
            ),
            fill=MUTED,
            anchor="se",
            font=self._ui_font("micro"),
            tags=tags,
        )
        canvas.tag_raise("history-timeline-tooltip")

    def _draw_history_skill_hit_detail_button(
        self,
        canvas: tk.Canvas,
        left: int,
        width: int,
        caption: str,
        tag: str,
        command,
        *,
        enabled: bool = True,
        primary: bool = False,
    ) -> None:
        top, bottom = 27, 61
        fill = "#193c33" if primary and enabled else "#161c21" if enabled else "#101419"
        outline = ACCENT if primary and enabled else BORDER if enabled else "#252b31"
        foreground = ACCENT if primary and enabled else TEXT if enabled else SUBTLE
        canvas.create_rectangle(
            left,
            top,
            left + width,
            bottom,
            fill=fill,
            outline=outline,
            width=1,
            tags=(tag,),
        )
        canvas.create_text(
            left + width // 2,
            (top + bottom) // 2,
            text=caption,
            fill=foreground,
            font=self._ui_font("micro"),
            tags=(tag,),
        )
        if enabled:
            canvas.tag_bind(tag, "<Button-1>", lambda _event: command())
            canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
            canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor="arrow"))

    def _draw_history_skill_hit_detail(self) -> None:
        canvas = getattr(self, "history_skill_hit_detail_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        selected = getattr(self, "history_skill_timeline_selected_hit", None)
        hits = getattr(self, "history_skill_timeline_hits", {})
        hit = hits.get(selected) if selected is not None else None
        boss_mode = getattr(self, "history_meter_mode", "dps") == "boss_damage"
        if not isinstance(hit, dict):
            placeholders = (
                ("命中时间", "--:--"),
                ("本次伤害", "--"),
                ("攻击来源", "--") if boss_mode else ("暴击", "--"),
                ("受击成员", "--") if boss_mode else ("穿刺", "--"),
            )
            cell_width = max(1, width / len(placeholders))
            for index, (caption, value) in enumerate(placeholders):
                left = index * cell_width
                if index:
                    canvas.create_line(
                        left,
                        18,
                        left,
                        height - 18,
                        fill=BORDER,
                    )
                canvas.create_text(
                    left + 16,
                    29,
                    text=caption,
                    fill=SUBTLE,
                    anchor="w",
                    font=self._ui_font("micro"),
                )
                canvas.create_text(
                    left + 16,
                    57,
                    text=value,
                    fill=MUTED,
                    anchor="w",
                    font=self._ui_font("number_strong"),
                )
            return

        skill_id = int(hit.get("skill_id", 0) or 0)
        class_id = int(hit.get("profession_id", 0) or 0)
        name = str(hit.get("name", "")).strip() or "未命名技能"
        icon = self.icons.skill(skill_id, name, class_id, 40)
        canvas._history_selected_skill_icon = icon
        canvas.create_image(14, (height - 40) // 2, image=icon, anchor="nw")
        ordinal = int(hit.get("ordinal", 1) or 1)
        hit_count = int(hit.get("hit_count", 1) or 1)
        canvas.create_text(
            64,
            27,
            text=self._fit_ui_text(name, 190, "strong"),
            fill=TEXT,
            anchor="w",
            font=self._ui_font("strong"),
        )
        canvas.create_text(
            64,
            51,
            text=f"第 {ordinal} / {hit_count} 次命中",
            fill=SUBTLE,
            anchor="w",
            font=self._ui_font("micro"),
        )
        canvas.create_text(
            274,
            27,
            text=self._format_history_hit_time(hit.get("time_seconds")),
            fill=ACCENT,
            anchor="w",
            font=self._ui_font("number_strong"),
        )
        canvas.create_text(
            274,
            51,
            text=f"伤害 {self._history_optional_number(hit.get('damage'))}",
            fill=TEXT,
            anchor="w",
            font=self._ui_font("micro"),
        )
        canvas.create_text(
            425,
            27,
            text=(
                self._fit_ui_text(
                    str(hit.get("source_name", "首领")), 150, "strong"
                )
                if boss_mode
                else self._history_hit_flag_text("暴击", hit.get("critical"))
            ),
            fill=(
                "#e67d72"
                if boss_mode
                else "#c49bea" if hit.get("critical") is True else MUTED
            ),
            anchor="w",
            font=self._ui_font("strong"),
        )
        canvas.create_text(
            425,
            51,
            text=(
                self._fit_ui_text(
                    str(hit.get("target_name", "队伍成员")), 150, "micro"
                )
                if boss_mode
                else self._history_hit_flag_text(
                    "穿刺", hit.get("penetrating")
                )
            ),
            fill=(
                TEXT
                if boss_mode
                else "#70b9e6" if hit.get("penetrating") is True else MUTED
            ),
            anchor="w",
            font=self._ui_font("micro"),
        )

        skill_keys = sorted(key for key in hits if key[0] == skill_id)
        try:
            position = skill_keys.index(selected)
        except ValueError:
            position = 0
        button_specs = (
            ("上一击", 64, "history-hit-previous", lambda: self._step_history_skill_hit(-1), position > 0, False),
            ("最高一击", 74, "history-hit-maximum", self._select_history_skill_max_hit, True, True),
            ("下一击", 64, "history-hit-next", lambda: self._step_history_skill_hit(1), position < len(skill_keys) - 1, False),
        )
        total_width = sum(spec[1] for spec in button_specs) + 8
        left = max(525, width - total_width - 14)
        for caption, button_width, tag, command, enabled, primary in button_specs:
            self._draw_history_skill_hit_detail_button(
                canvas,
                left,
                button_width,
                caption,
                tag,
                command,
                enabled=enabled,
                primary=primary,
            )
            left += button_width + 4

    def _draw_history_skill_timeline(self) -> None:
        canvas = getattr(self, "history_skill_timeline_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        self.history_skill_timeline_hits = {}
        self.history_skill_timeline_hover_hit = None
        self.history_skill_timeline_plot_bounds = None
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record, damage_participant = self._selected_history_damage_participant()
        mode = getattr(self, "history_meter_mode", "dps")
        participant = damage_participant
        if mode in {"hps", "dt"} and isinstance(record, dict):
            collection_name = "healers" if mode == "hps" else "damage_taken"
            collection = record.get(collection_name, [])
            collection = collection if isinstance(collection, list) else []
            participant = next(
                (
                    row
                    for row in collection
                    if isinstance(row, dict)
                    and int(row.get("actor_id", 0) or 0)
                    == int(self.history_selected_actor or 0)
                ),
                None,
            )
        title = getattr(self, "history_skill_timeline_title_label", None)
        if title is not None:
            player_name = ""
            if mode == "boss_damage" and isinstance(participant, dict):
                player_name = str(participant.get("name", "")).strip()
            elif isinstance(participant, dict):
                collection_name = (
                    "healers"
                    if mode == "hps"
                    else "damage_taken" if mode == "dt" else "participants"
                )
                roster = (
                    record.get(collection_name, [])
                    if isinstance(record, dict)
                    else []
                )
                roster = roster if isinstance(roster, list) else []
                try:
                    player_index = next(
                        index
                        for index, row in enumerate(roster)
                        if isinstance(row, dict)
                        and int(row.get("actor_id", 0) or 0)
                        == int(participant.get("actor_id", 0) or 0)
                    )
                except StopIteration:
                    player_index = 0
                player_name = self._history_actor_name(
                    participant,
                    player_index,
                    self._history_names_hidden(),
                )
            timeline_name = (
                "技能命中时间轴"
                if mode == "dps"
                else "首领伤害时间轴"
                if mode == "boss_damage"
                else "治疗时间轴"
                if mode == "hps"
                else "承伤时间轴"
            )
            title.configure(
                text=f"{player_name + ' · ' if player_name else ''}{timeline_name}"
            )
        if mode in {"hps", "dt"}:
            self.history_skill_timeline_selected_hit = None
            heading = (
                "暂无逐次治疗时间戳"
                if mode == "hps"
                else "暂无逐次承伤时间戳"
            )
            detail = (
                "治疗页保留结算技能构成，不生成推测时间线"
                if mode == "hps"
                else "承伤页只展示可靠汇总，不生成推测来源与时间线"
            )
            canvas.create_text(
                width // 2,
                height // 2 - 8,
                text=heading,
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text=detail,
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            self._draw_history_skill_timeline_toolbar()
            self._draw_history_skill_timeline_range()
            self._draw_history_skill_hit_detail()
            return
        events = (
            boss_events
            if mode == "boss_damage"
            else self._history_self_skill_events(record, damage_participant)
        )
        if not isinstance(participant, dict):
            self.history_skill_timeline_selected_hit = None
            canvas.create_text(
                width // 2,
                height // 2,
                text=(
                    self._history_boss_coverage_text(
                        self._history_boss_damage(record)
                    )[0]
                    if mode == "boss_damage"
                    else "请选择队员"
                ),
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            self._draw_history_skill_timeline_toolbar()
            self._draw_history_skill_timeline_range()
            self._draw_history_skill_hit_detail()
            return
        pvp_record = (
            isinstance(record, dict)
            and str(record.get("combat_mode", "")).casefold() == "pvp"
        )
        if (not pvp_record and participant.get("is_self") is not True) or not events:
            self.history_skill_timeline_selected_hit = None
            canvas.create_text(
                width // 2,
                height // 2 - 8,
                text=(
                    "该来源没有已保存的逐次伤害事件"
                    if mode == "boss_damage"
                    else "该玩家没有可验证的逐次命中时间"
                ),
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text=(
                    "不根据汇总值生成推测时间轴"
                    if mode == "boss_damage"
                    else (
                        "仅展示本场实际保存的命中时间；缺失数据不做推测"
                        if pvp_record
                        else "只为本机角色绘制真实事件；队友数据不做推测"
                    )
                ),
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            self._draw_history_skill_timeline_toolbar()
            self._draw_history_skill_timeline_range()
            self._draw_history_skill_hit_detail()
            return
        if mode == "boss_damage":
            skills = boss_skills
            duration = boss_duration
        else:
            skills = self._history_damage_skills(participant)
            skills = [
                row
                for row in skills
                if int(row.get("skill_id", 0) or 0) in events
            ]
            duration = max(
                self._history_display_duration(record or {}),
                max(
                    (
                        float(row["time_seconds"])
                        for values in events.values()
                        for row in values
                    ),
                    default=0.0,
                ),
                1.0,
            )
        page_size = 6
        page_count = max(1, int(math.ceil(len(skills) / page_size)))
        page = min(
            page_count - 1,
            max(0, int(getattr(self, "history_skill_timeline_page", 0) or 0)),
        )
        self.history_skill_timeline_page = page
        self.history_skill_timeline_page_count = page_count
        page_skills = skills[page * page_size:(page + 1) * page_size]
        hidden = getattr(self, "history_skill_timeline_hidden_ids", set())
        hidden = hidden if isinstance(hidden, set) else set()
        try:
            range_start, range_end = self.history_skill_timeline_range
            range_start = min(1.0, max(0.0, float(range_start)))
            range_end = min(1.0, max(range_start + 0.001, float(range_end)))
        except (AttributeError, TypeError, ValueError):
            range_start, range_end = 0.0, 1.0
        self.history_skill_timeline_range = (range_start, range_end)
        view_start = duration * range_start
        view_end = duration * range_end
        view_duration = max(0.001, view_end - view_start)
        self.history_skill_timeline_view_start = view_start

        subtitle = getattr(self, "history_skill_timeline_subtitle_label", None)
        if subtitle is not None:
            try:
                subtitle.configure(
                    text=(
                        (
                            f"首领真实伤害事件  ·  {len(skills)} 个技能  ·  "
                            if mode == "boss_damage"
                            else (
                                f"PvP 真实命中  ·  {len(skills)} 个技能  ·  "
                                if pvp_record
                                else f"本机真实命中  ·  {len(skills)} 个技能  ·  "
                            )
                        )
                        + f"第 {page + 1}/{page_count} 页"
                    )
                )
            except (AttributeError, tk.TclError):
                pass
        self._draw_history_skill_timeline_toolbar()
        self._draw_history_skill_timeline_range()

        label_width = 44
        percent_width = 42
        plot_left = label_width
        plot_right = max(plot_left + 80, width - percent_width)
        plot_top = 32
        available_height = max(40.0, height - plot_top - 2.0)
        row_count = max(1, len(page_skills))
        row_height = max(34.0, available_height / row_count)
        plot_bottom = min(float(height), plot_top + row_height * row_count)
        self.history_skill_timeline_plot_bounds = (
            float(plot_left),
            float(plot_right),
            float(plot_top),
            float(plot_bottom),
            float(view_duration),
        )
        class_id = int(participant.get("profession_id", 0) or 0)
        colors = self._history_skill_palette()
        color_by_id = {
            int(skill.get("skill_id", 0) or 0): colors[index % len(colors)]
            for index, skill in enumerate(skills)
        }

        target_major = view_duration / 8.0
        intervals = (1, 2, 5, 10, 20, 30, 40, 60, 90, 120, 180, 300, 600)
        major_interval = next(
            (value for value in intervals if value >= target_major), intervals[-1]
        )
        minor_interval = major_interval / 4.0
        first_minor = math.ceil(view_start / minor_interval) * minor_interval
        tick_time = first_minor
        while tick_time <= view_end + 0.0001:
            fraction = (tick_time - view_start) / view_duration
            x = plot_left + (plot_right - plot_left) * fraction
            is_major = abs(tick_time / major_interval - round(tick_time / major_interval)) < 0.001
            canvas.create_line(
                x, plot_top - (7 if is_major else 3), x, plot_top,
                fill="#788590" if is_major else "#4a555f",
            )
            if is_major:
                canvas.create_text(
                    x, 13, text=format_duration(tick_time),
                    fill=MUTED,
                    anchor=(
                        "w" if x - plot_left < 18 else
                        "e" if plot_right - x < 18 else "center"
                    ),
                    font=self._ui_font("micro"),
                )
            canvas.create_line(
                x, plot_top, x, plot_bottom,
                fill="#273039" if is_major else "#1d242a",
                dash=() if is_major else (2, 5),
            )
            tick_time += minor_interval

        if mode == "boss_damage":
            death_events = [
                event
                for event in self._history_boss_death_events(record)
                if view_start
                <= float(event.get("time_seconds", 0.0) or 0.0)
                <= view_end
            ]
            for index, death in enumerate(death_events):
                second = float(death.get("time_seconds", 0.0) or 0.0)
                x = plot_left + (
                    (plot_right - plot_left)
                    * (second - view_start)
                    / view_duration
                )
                marker_y = plot_top + 8 + (index % 2) * 13
                canvas.create_line(
                    x,
                    plot_top,
                    x,
                    plot_bottom,
                    fill=ERROR,
                    width=1,
                    dash=(2, 5),
                    tags=("history-boss-death-node",),
                )
                canvas.create_polygon(
                    x,
                    marker_y - 5,
                    x + 5,
                    marker_y,
                    x,
                    marker_y + 5,
                    x - 5,
                    marker_y,
                    fill=ERROR,
                    outline="#ffd4d7",
                    tags=("history-boss-death-node",),
                )
                name = (
                    "已隐藏成员"
                    if self._history_names_hidden()
                    else str(death.get("name", "") or "队伍成员")
                )
                canvas.create_text(
                    min(plot_right - 4, x + 8),
                    marker_y,
                    text=self._fit_ui_text(
                        f"{name}死亡", max(50, plot_right - x - 12), "micro"
                    ),
                    fill="#ffc0c5",
                    anchor="w",
                    font=self._ui_font("micro"),
                    tags=("history-boss-death-node",),
                )

        # Percent scale and real hit-derived rhythm curves echo the reference
        # chart without pretending that uncaptured boss mechanics are known.
        for percent in (0, 60, 120, 180):
            y = plot_bottom - (plot_bottom - plot_top) * percent / 180.0
            canvas.create_text(
                width - 5, y, text=f"{percent}%", fill=SUBTLE,
                anchor="e", font=self._ui_font("micro"),
            )
        bin_count = max(18, min(72, int((plot_right - plot_left) / 18)))
        damage_bins = [0.0] * bin_count
        critical_bins = [0.0] * bin_count
        for skill_id, skill_events in events.items():
            if int(skill_id) in hidden:
                continue
            for event in skill_events:
                second = float(event.get("time_seconds", 0.0) or 0.0)
                if not view_start <= second <= view_end:
                    continue
                fraction = min(0.999999, max(0.0, (second - view_start) / view_duration))
                bin_index = min(bin_count - 1, int(fraction * bin_count))
                damage = float(max(0, int(event.get("damage", 0) or 0)))
                damage_bins[bin_index] += damage
                if event.get("critical") is True:
                    critical_bins[bin_index] += damage

        def draw_rhythm(values: list[float], color: str) -> None:
            average = sum(values) / max(1, len(values))
            if average <= 0:
                return
            coordinates: list[float] = []
            for index, value in enumerate(values):
                x = plot_left + (plot_right - plot_left) * (index + 0.5) / len(values)
                percent = min(180.0, max(0.0, value / average * 100.0))
                y = plot_bottom - (plot_bottom - plot_top) * percent / 180.0
                coordinates.extend((x, y))
            if len(coordinates) >= 4:
                canvas.create_line(
                    *coordinates, fill=color, width=1,
                    dash=(3, 3), smooth=False,
                )

        draw_rhythm(damage_bins, "#e4665f")
        if mode != "boss_damage":
            draw_rhythm(critical_bins, "#e5b443")

        total_damage = max(1, int(participant.get("damage", 0) or 0))
        icons: list[object] = []
        for page_index, skill in enumerate(page_skills):
            source_index = page * page_size + page_index
            top = plot_top + page_index * row_height
            skill_id = int(skill.get("skill_id", 0) or 0)
            name = str(skill.get("name", "")).strip() or "未命名技能"
            color = color_by_id.get(skill_id, colors[source_index % len(colors)])
            canvas.create_rectangle(
                0, top, width, top + row_height - 1,
                fill="#12171c" if page_index % 2 == 0 else PANEL,
                outline="",
            )
            tick_time = first_minor
            while tick_time <= view_end + 0.0001:
                fraction = (tick_time - view_start) / view_duration
                x = plot_left + (plot_right - plot_left) * fraction
                is_major = abs(tick_time / major_interval - round(tick_time / major_interval)) < 0.001
                canvas.create_line(
                    x, top, x, top + row_height - 1,
                    fill="#273039" if is_major else "#1d242a",
                    dash=() if is_major else (2, 5),
                )
                tick_time += minor_interval
            center_y = top + row_height // 2
            icon_size = max(22, min(28, int(row_height - 10)))
            icon = self.icons.skill(skill_id, name, class_id, icon_size)
            icons.append(icon)
            canvas.create_rectangle(
                7, center_y - icon_size / 2 - 1,
                9 + icon_size, center_y + icon_size / 2 + 1,
                fill="#101419", outline=color,
            )
            canvas.create_image(8, center_y, image=icon, anchor="w")
            if skill_id in hidden:
                canvas.create_rectangle(
                    7, center_y - icon_size / 2 - 1,
                    9 + icon_size, center_y + icon_size / 2 + 1,
                    fill="#11161b", stipple="gray50", outline="#343c43",
                )
            collision: dict[int, int] = {}
            skill_events = events.get(skill_id, [])
            for hit_index, event in enumerate(skill_events):
                second = float(event["time_seconds"])
                if skill_id in hidden or not view_start <= second <= view_end:
                    continue
                x = plot_left + (plot_right - plot_left) * (second - view_start) / view_duration
                event_size = max(18, min(24, int(row_height - 13)))
                bucket = int(x // max(7, event_size * 0.62))
                level = collision.get(bucket, 0)
                collision[bucket] = level + 1
                offsets = (0, -6, 6, -9, 9)
                offset = offsets[level % len(offsets)]
                critical = event.get("critical") is True
                penetrating = event.get("penetrating") is True
                hit_key = (skill_id, hit_index)
                hit_tag = f"history-timeline-hit:{skill_id}:{hit_index}"
                selected = hit_key == getattr(
                    self, "history_skill_timeline_selected_hit", None
                )
                outline = (
                    "#d9b8ff"
                    if critical
                    else "#9ad9ff" if penetrating else blend_color(color, "#ffffff", 0.25)
                )
                item_id = canvas.create_rectangle(
                    x - event_size / 2 - 1,
                    center_y - event_size / 2 - 1 + offset,
                    x + event_size / 2 + 1,
                    center_y + event_size / 2 + 1 + offset,
                    fill="#101419",
                    outline="#ffffff" if selected else outline,
                    width=2 if selected else 1,
                    tags=(hit_tag, "history-timeline-hit"),
                )
                canvas.create_image(
                    x, center_y + offset,
                    image=icon,
                    tags=(hit_tag, "history-timeline-hit"),
                )
                self.history_skill_timeline_hits[hit_key] = {
                    **event,
                    "skill_id": skill_id,
                    "name": name,
                    "profession_id": class_id,
                    "ordinal": hit_index + 1,
                    "hit_count": len(skill_events),
                    "color": color,
                    "_outline": outline,
                    "_item_id": item_id,
                    "_tag": hit_tag,
                    "_x": x,
                    "_center_y": center_y,
                    "_row_top": top,
                    "_row_bottom": top + row_height,
                }
                canvas.tag_bind(
                    hit_tag,
                    "<Enter>",
                    lambda event, key=hit_key: self._history_skill_hit_enter(
                        event, key
                    ),
                )
                canvas.tag_bind(
                    hit_tag,
                    "<Leave>",
                    self._history_skill_hit_leave,
                )
                canvas.tag_bind(
                    hit_tag,
                    "<Button-1>",
                    lambda _event, key=hit_key: self._select_history_skill_hit(
                        key, redraw_timeline=False
                    ),
                )
            canvas.create_line(0, top + row_height - 1, width, top + row_height - 1, fill="#242b32")
        canvas._history_skill_timeline_icons = icons
        focus_time = getattr(self, "history_skill_timeline_focus_time", None)
        if isinstance(focus_time, (int, float)) and view_start <= focus_time <= view_end:
            focus_x = plot_left + (
                (plot_right - plot_left) * (float(focus_time) - view_start) / view_duration
            )
            canvas.create_line(
                focus_x,
                plot_top,
                focus_x,
                plot_bottom,
                fill="#f0bc72",
                width=2,
                dash=(5, 3),
                tags=("history-timeline-cast-focus",),
            )
            badge_width = 92
            badge_left = max(
                plot_left,
                min(plot_right - badge_width, focus_x - badge_width / 2),
            )
            canvas.create_rectangle(
                badge_left,
                2,
                badge_left + badge_width,
                24,
                fill="#362a19",
                outline="#f0bc72",
                tags=("history-timeline-cast-focus",),
            )
            canvas.create_text(
                badge_left + badge_width / 2,
                13,
                text=(
                    "施法 "
                    + self._format_history_cast_time(float(focus_time) * 1000.0)
                ),
                fill="#f0bc72",
                font=self._ui_font("micro"),
                tags=("history-timeline-cast-focus",),
            )
        canvas.configure(scrollregion=(0, 0, width, height))
        if (
            getattr(self, "history_skill_timeline_selected_hit", None)
            not in self.history_skill_timeline_hits
        ):
            self.history_skill_timeline_selected_hit = None
        self._update_history_skill_timeline_selection()
        self._draw_history_skill_hit_detail()

