    def _schedule_backend_sidebar_art(self, _event=None) -> None:
        canvas = getattr(self, "backend_sidebar_art_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        pending = getattr(self, "backend_sidebar_art_after_id", None)
        if pending is not None:
            try:
                canvas.after_cancel(pending)
            except tk.TclError:
                pass
        self.backend_sidebar_art_after_id = canvas.after(
            35, self._draw_backend_sidebar_art
        )

    def _draw_backend_sidebar_art(self) -> None:
        self.backend_sidebar_art_after_id = None
        canvas = getattr(self, "backend_sidebar_art_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        width = max(1, int(canvas.winfo_width()))
        height = max(1, int(canvas.winfo_height()))
        if width < 8 or height < 8:
            self._schedule_backend_sidebar_art()
            return
        image = self.icons.sidebar_art(width, height)
        canvas.delete("all")
        canvas.create_image(
            0,
            0,
            image=image,
            anchor="nw",
            tags=("sidebar-art",),
        )
        canvas._sidebar_art_image = image
        if height >= 104:
            quote_y = min(68, max(40, round(height * 0.16)))
            canvas.create_text(
                width / 2 + 1,
                quote_y + 1,
                text="记录每一次战斗",
                fill="#07111d",
                anchor="center",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width / 2,
                quote_y,
                text="记录每一次战斗",
                fill="#cfe4ff",
                anchor="center",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width / 2 + 1,
                quote_y + 27,
                text="让数据说话",
                fill="#07111d",
                anchor="center",
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width / 2,
                quote_y + 26,
                text="让数据说话",
                fill="#b9d4ff",
                anchor="center",
                font=self._ui_font("strong"),
            )
            canvas.create_line(
                width / 2 - 12,
                quote_y + 49,
                width / 2 + 12,
                quote_y + 49,
                fill="#76cfff",
                width=2,
            )

    def _scroll_backend_page(self, event) -> str | None:
        if self.backend_current_page == "updates":
            canvas = getattr(self, "update_log_canvas", None)
        elif self.backend_current_page == "history":
            canvas = getattr(self, "history_page_canvas", None)
        else:
            return None
        if canvas is None:
            return None
        try:
            delta = int(getattr(event, "delta", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            delta = 0
        try:
            button = int(getattr(event, "num", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            button = 0
        if button == 4:
            amount = -1
        elif button == 5:
            amount = 1
        elif delta:
            steps = max(1, abs(delta) // 120)
            amount = -steps if delta > 0 else steps
        else:
            return "break"
        try:
            canvas.yview_scroll(amount, "units")
        except tk.TclError:
            return None
        return "break"

    def _select_backend_page(self, page: str) -> None:
        ModernDropdown.close_active_popup(
            getattr(self, "history_window", None)
        )
        page = str(page or "history")
        if page not in self.backend_pages:
            page = "history"
        if self.backend_current_page == "settings" and page != "settings":
            self._cancel_toggle_hotkey_capture()
        self.backend_current_page = page
        for key, frame in self.backend_pages.items():
            if key == page:
                frame.grid(row=0, column=0, sticky="nsew")
            else:
                frame.grid_remove()
        self._ensure_backend_window_opaque()
        self._sync_backend_navigation()
        self._sync_backend_window_topmost()
        if page == "history" and self.history_window is not None:
            self._refresh_history_records()

    def _sync_backend_pin_button(self) -> None:
        button = getattr(self, "history_pin_button", None)
        if button is None or not button.winfo_exists():
            return
        topmost = bool(getattr(self, "backend_topmost", False))
        button._icon_name = "pin" if topmost else "pin_off"
        button._normal_fg = ACCENT if topmost else "#c5ccd3"
        button._hover_fg = ACCENT if topmost else TEXT
        button._description = "取消置顶" if topmost else "置顶"
        self._render_titlebar_icon_button(button)

    def _sync_backend_window_topmost(self) -> None:
        self._sync_backend_pin_button()
        window = self.history_window
        if window is None or not window.winfo_exists():
            return
        topmost = bool(getattr(self, "backend_topmost", False))
        try:
            current_topmost = bool(window.attributes("-topmost"))
        except (AttributeError, TypeError, tk.TclError):
            current_topmost = not bool(topmost)
        if current_topmost != bool(topmost):
            window.attributes("-topmost", bool(topmost))
        self._set_window_topmost_noactivate(window, bool(topmost))

    def toggle_backend_topmost(self) -> None:
        self.backend_topmost = not bool(
            getattr(self, "backend_topmost", False)
        )
        self.config[BACKEND_TOPMOST_CONFIG_KEY] = self.backend_topmost
        self._sync_backend_window_topmost()
        save_config(self.config)

