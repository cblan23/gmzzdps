    def _sync_action_buttons(self) -> None:
        startup_blocked = self._startup_interaction_blocked()
        if (
            getattr(self, "lock_button", None) is not None
            and self.lock_button.winfo_exists()
        ):
            self.lock_button._icon_name = "lock" if self.window_locked else "unlock"
            self.lock_button._description = "解锁" if self.window_locked else "锁定"
            self.lock_button._normal_color = ACCENT if self.window_locked else TEXT
            self.lock_button._disabled = startup_blocked
            self.lock_button.configure(
                cursor="arrow" if startup_blocked else "hand2"
            )
            self._sync_main_icon_button_visual(self.lock_button)
        if (
            getattr(self, "privacy_button", None) is not None
            and self.privacy_button.winfo_exists()
        ):
            self.privacy_button._icon_name = "eye_off" if self.hide_names else "eye"
            self.privacy_button._description = (
                "显示名称" if self.hide_names else "隐藏名称"
            )
            self.privacy_button._normal_color = ACCENT if self.hide_names else TEXT
            self._sync_main_icon_button_visual(self.privacy_button)
        if (
            getattr(self, "pin_button", None) is not None
            and self.pin_button.winfo_exists()
        ):
            topmost = self._preferred_main_topmost()
            self.pin_button._icon_name = "pin" if topmost else "pin_off"
            self.pin_button._description = "取消置顶" if topmost else "置顶"
            self.pin_button._normal_color = ACCENT if topmost else TEXT
            self.pin_button._disabled = startup_blocked
            self.pin_button.configure(
                cursor="arrow" if startup_blocked else "hand2"
            )
            self._sync_main_icon_button_visual(self.pin_button)
        if (
            getattr(self, "compact_button", None) is not None
            and self.compact_button.winfo_exists()
        ):
            self.compact_button._description = "迷你模式"
            self.compact_button._normal_color = TEXT
            self._sync_main_icon_button_visual(self.compact_button)
        if (
            getattr(self, "settings_button", None) is not None
            and self.settings_button.winfo_exists()
        ):
            settings_disabled = bool(SETTINGS_TEMPORARILY_DISABLED)
            self.settings_button._disabled = settings_disabled
            self.settings_button._normal_color = (
                SUBTLE if settings_disabled else TEXT
            )
            self.settings_button.configure(
                cursor="arrow" if settings_disabled else "hand2"
            )
            self._sync_main_icon_button_visual(self.settings_button)
        reset_disabled = self._main_clear_blocked()
        if (
            getattr(self, "reset_button", None) is not None
            and self.reset_button.winfo_exists()
        ):
            self.reset_button._disabled = reset_disabled
            self.reset_button._normal_color = SUBTLE if reset_disabled else TEXT
            self.reset_button.configure(
                cursor="arrow" if reset_disabled else "hand2"
            )
            self._sync_main_icon_button_visual(self.reset_button)
        self._schedule_layered_main_render()

    def _sync_expiry_label(self) -> None:
        membership_label = getattr(self, "membership_label", None)
        expiry_label = getattr(self, "expiry_label", None)
        if membership_label is None or expiry_label is None:
            return
        try:
            if not membership_label.winfo_exists() or not expiry_label.winfo_exists():
                return
        except (AttributeError, tk.TclError):
            return
        session = self.licensing.session
        tier = str(getattr(session, "card_tier", "normal") or "normal").casefold()
        self._sync_upload_profile_label()
        badge_label = getattr(self, "membership_badge_label", None)
        if badge_label is not None and badge_label.winfo_exists():
            badge = membership_label_for_card_tier(tier)
            if (
                getattr(badge_label, "_badge_text", "") != badge
                or getattr(badge_label, "_asset_dpi", None)
                != self.icons.window_dpi
            ):
                badge_image = self.icons.membership_badge(badge)
                badge_label.configure(image=badge_image)
                badge_label.image = badge_image
                badge_label._badge_text = badge
                badge_label._asset_dpi = self.icons.window_dpi
        avatar_label = getattr(self, "sidebar_avatar_label", None)
        if (
            avatar_label is not None
            and avatar_label.winfo_exists()
            and getattr(avatar_label, "_asset_dpi", None)
            != self.icons.window_dpi
        ):
            avatar_image = self.icons.sidebar_avatar(52)
            avatar_label.configure(image=avatar_image)
            avatar_label.image = avatar_image
            avatar_label._asset_dpi = self.icons.window_dpi
        text = membership_contract_text(
            tier, getattr(session, "expires_at", None)
        )
        if expiry_label.cget("text") != text:
            expiry_label.configure(text=text)

    def _sync_upload_profile_label(self) -> None:
        label = getattr(self, "membership_label", None)
        if label is None:
            return
        try:
            if not label.winfo_exists():
                return
        except (AttributeError, tk.TclError):
            return
        profile = getattr(self, "upload_profile", None)
        nickname = (
            str(profile.nickname or "").strip()
            if isinstance(profile, UploadProfile)
            else ""
        )
        text = nickname or "匿名"
        edit_enabled = bool(nickname)
        try:
            font_role = "title"
            for candidate in ("title", "strong", "small", "micro"):
                candidate_font = self._ui_font(candidate)
                if candidate_font.measure(text) <= 144:
                    font_role = candidate
                    break
            else:
                font_role = "sidebar_micro"
            if getattr(label, "_profile_font_role", "") != font_role:
                label.configure(font=self._ui_font(font_role))
                label._profile_font_role = font_role
        except (AttributeError, KeyError, tk.TclError):
            pass
        try:
            if label.cget("text") != text:
                label.configure(text=text)
        except (AttributeError, tk.TclError):
            return
        try:
            if getattr(label, "_profile_edit_enabled", None) != edit_enabled:
                label.unbind("<Button-1>")
                label.configure(cursor="hand2" if edit_enabled else "arrow")
                if edit_enabled:
                    label.bind(
                        "<Button-1>",
                        lambda _event: self._show_upload_profile_editor(),
                    )
                label._profile_edit_enabled = edit_enabled
        except (AttributeError, tk.TclError):
            pass
        edit_button = getattr(self, "profile_edit_button", None)
        if edit_button is None:
            return
        try:
            if not edit_button.winfo_exists():
                return
            icon_dpi = getattr(self.icons, "window_dpi", None)
            if (
                getattr(edit_button, "_profile_edit_enabled", None) != edit_enabled
                or getattr(edit_button, "_profile_edit_dpi", None) != icon_dpi
            ):
                edit_button.unbind("<Button-1>")
                edit_color = "#8db8d8" if edit_enabled else "#496779"
                edit_image = self.icons.toolbar("edit", 16, edit_color)
                edit_button.configure(
                    image=edit_image,
                    cursor="hand2" if edit_enabled else "arrow",
                )
