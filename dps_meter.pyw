    @staticmethod
    def _is_pvp_duel_history_record(record: object) -> bool:
        if not isinstance(record, dict):
            return False
        if str(record.get("combat_mode") or "").casefold() != "pvp":
            return False
        try:
            return int(
                record.get("pvp_team_size", record.get("team_size", 0)) or 0
            ) in {1, 3, 6, 12}
        except (TypeError, ValueError, OverflowError):
            return False

    def _pvp_duel_players(self) -> tuple[dict | None, dict | None, dict | None]:
        record = self._selected_history_record()
        if not self._is_pvp_duel_history_record(record):
            return None, None, None
        participants = record.get("participants")
        participants = participants if isinstance(participants, list) else []
        allies = [
            row
            for row in participants
            if isinstance(row, dict) and row.get("side") == "ally"
        ]
        enemies = [
            row
            for row in participants
            if isinstance(row, dict) and row.get("side") == "enemy"
        ]
        ally = next((row for row in allies if row.get("is_self") is True), None)
        return record, ally or (allies[0] if allies else None), enemies[0] if enemies else None

    @staticmethod
    def _pvp_duel_player_side(player: object) -> str:
        if not isinstance(player, dict):
            return ""
        side = str(player.get("side") or player.get("team") or "").casefold()
        if side in {"ally", "allies", "friendly", "ours", "我方", "1"}:
            return "ally"
        if side in {"enemy", "enemies", "opponent", "opposing", "敌方", "2"}:
            return "enemy"
        return "ally" if player.get("is_self") is True else "enemy"

    @staticmethod
    def _pvp_duel_player_key(player: object, fallback_index: int = 0) -> str:
        if not isinstance(player, dict):
            return f"missing:{fallback_index}"
        try:
            actor_id = int(player.get("actor_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            actor_id = 0
        if actor_id:
            return f"actor:{actor_id}"
        for field in ("character_id", "character_uid", "role_uid", "uid"):
            value = str(player.get(field) or "").strip()
            if value:
                return f"uid:{value}"
        return (
            f"row:{DpsWindow._pvp_duel_player_side(player)}:"
            f"{player.get('name', '')}:{player.get('profession_id', 0)}:{fallback_index}"
        )

    def _pvp_duel_participants(self) -> list[dict]:
        record = self._selected_history_record()
        if not self._is_pvp_duel_history_record(record):
            return []
        raw = record.get("participants")
        rows = [row for row in raw if isinstance(row, dict)] if isinstance(raw, list) else []
        if not rows:
            _record, ally, enemy = self._pvp_duel_players()
            rows = [row for row in (ally, enemy) if isinstance(row, dict)]
        indexed = list(enumerate(rows))
        indexed.sort(
            key=lambda pair: (
                0 if self._pvp_duel_player_side(pair[1]) == "ally" else 1,
                0 if pair[1].get("is_self") is True else 1,
                pair[0],
            )
        )
        return [row for _index, row in indexed]

    def _selected_pvp_duel_equipment_player(self) -> dict | None:
        players = self._pvp_duel_participants()
        if not players:
            return None
        selected_key = str(
            getattr(self, "history_duel_equipment_selected_player", "") or ""
        )
        for index, player in enumerate(players):
            if self._pvp_duel_player_key(player, index) == selected_key:
                return player
        player = next((row for row in players if row.get("is_self") is True), players[0])
        index = players.index(player)
        self.history_duel_equipment_selected_player = self._pvp_duel_player_key(
            player, index
        )
        return player

    def _selected_pvp_duel_player(self) -> dict | None:
        record = self._selected_history_record()
        try:
            team_size = int(
                (record or {}).get(
                    "pvp_team_size", (record or {}).get("team_size", 0)
                )
                or 0
            )
        except (TypeError, ValueError, OverflowError):
            team_size = 0
        if (
            team_size > 1
            or getattr(self, "history_duel_analysis_tab", "skills")
            == "equipment"
        ):
            return self._selected_pvp_duel_equipment_player()
        _record, ally, enemy = self._pvp_duel_players()
        return enemy if getattr(self, "history_duel_selected_side", "ally") == "enemy" else ally

    def _render_pvp_duel_detail(self) -> None:
        record, ally, enemy = self._pvp_duel_players()
        if record is None:
            return
        if getattr(self, "history_duel_selected_side", "ally") not in {
            "ally",
            "enemy",
        }:
            self.history_duel_selected_side = "ally"
        side_selected = enemy if self.history_duel_selected_side == "enemy" else ally
        if side_selected is None:
            self.history_duel_selected_side = "enemy" if enemy is not None else "ally"
        selected = self._selected_pvp_duel_player()
        if isinstance(selected, dict):
            self.history_selected_actor = int(selected.get("actor_id", 0) or 0)

        summary = self._selected_history_summary()
        summary = summary if isinstance(summary, dict) else {}
        result_text, result_color = self._history_result_presentation(
            summary.get("result", record.get("result"))
        )
        rating_texts = []
        try:
            team_size = int(record.get("pvp_team_size", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            team_size = 0
        if team_size > 1:
            for key in (
                "pvp_ally_average_rating", "pvp_enemy_average_rating"
            ):
                rating = normalize_extraordinary_rating(record.get(key))
                rating_texts.append(
                    "--" if rating is None else format_number(rating)
                )
        else:
            for player in (ally, enemy):
                rating = normalize_extraordinary_rating(
                    player.get("extraordinary_rating")
                    if isinstance(player, dict)
                    else None
                )
                rating_texts.append(
                    "--" if rating is None else format_number(rating)
                )
        values = {
            "duration": self._history_optional_duration(record.get("duration_seconds")),
            "ally_damage": self._history_optional_number(
                record.get("pvp_ally_damage")
            ),
            "enemy_damage": self._history_optional_number(
                record.get("pvp_enemy_damage")
            ),
            "ratings": f"{rating_texts[0]}  VS  {rating_texts[1]}",
            "result": result_text,
        }
        for key, label in getattr(self, "history_duel_metric_values", {}).items():
            label.configure(
                text=values.get(key, "--"),
                fg=result_color if key == "result" else label._accent_color,
            )
        favorite = bool(record.get("favorite"))
        favorite_button = getattr(self, "history_duel_favorite_button", None)
        if favorite_button is not None:
            favorite_button.configure(
                text="★ 已收藏" if favorite else "☆ 收藏",
                fg=ACCENT if favorite else MUTED,
            )
        self._set_pvp_duel_analysis_tab(
            getattr(self, "history_duel_analysis_tab", "skills"), redraw=False
        )
        self._draw_pvp_duel_hero()
        self._draw_pvp_duel_side_card("ally")
        self._draw_pvp_duel_side_card("enemy")
        self._draw_pvp_duel_versus()
        self._draw_pvp_duel_equipment_roster()
        self._draw_pvp_duel_player_header()
        self._draw_pvp_duel_analysis()

    def _draw_pvp_duel_hero(self) -> None:
        canvas = getattr(self, "history_duel_hero_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record, _ally, _enemy = self._pvp_duel_players()
        record = record if isinstance(record, dict) else {}
        try:
            team_size = int(
                record.get("pvp_team_size", record.get("team_size", 0)) or 0
            )
        except (TypeError, ValueError, OverflowError):
            team_size = 0
        artwork = self.icons.pvp_duel_hero(width, height, team_size)
        canvas.create_image(0, 0, image=artwork, anchor="nw")
        canvas._pvp_duel_hero_image = artwork

        mode_title = {
            1: "一人一剑 · 胜负在此",
            3: "三人争锋 · 协战定胜",
            6: "六人同心 · 战局定胜",
            12: "十二人争锋 · 团战定胜",
        }.get(team_size, "PVP 对决 · 胜负在此")
        canvas_outlined_text(
            canvas,
            width / 2,
            max(34, round(height * 0.28)),
            text=mode_title,
            fill="#f4f7f5",
            anchor="center",
            outline="#061014",
            outline_width=2,
            font=self._ui_font("hero_title"),
        )
        if team_size > 1:
            canvas_outlined_text(
                canvas,
                width / 2,
                max(66, round(height * 0.48)),
                text=f"{team_size}v{team_size}",
                fill="#d6e9e7",
                anchor="center",
                outline="#061014",
                outline_width=1,
                font=self._ui_font("strong"),
            )

        summary = self._selected_history_summary()
        summary = summary if isinstance(summary, dict) else {}
        map_name = str(summary.get("dungeon_name") or "未知地图").strip()
        result_text, result_color = self._history_result_presentation(
            summary.get("result", record.get("result"))
        )
        canvas.create_rectangle(0, 0, 4, height, fill=ACCENT, outline="")
        meta = (
            f"{map_name}    ◆    {self._history_timestamp(record)}    ◆    "
            f"战斗时长 {self._history_optional_duration(record.get('duration_seconds'))}"
        )
        canvas.create_text(
            26,
            height - 24,
            text=self._fit_ui_text(meta, max(160, width - 170), "micro"),
            fill="#c1d3d1",
            anchor="w",
            font=self._ui_font("micro"),
        )
        badge_width = 88
        left = width - badge_width - 22
        top = height - 47
        canvas.create_polygon(
            left + 7,
            top,
            left + badge_width,
            top,
            left + badge_width,
            top + 31,
            left + badge_width - 7,
            top + 38,
            left,
            top + 38,
            left,
            top + 7,
            fill=blend_color("#0b1114", result_color, 0.22),
            outline=result_color,
        )
        canvas.create_text(
            left + badge_width / 2,
            top + 19,
            text=result_text,
            fill=result_color,
            font=self._ui_font("title"),
        )

    def _draw_pvp_duel_versus(self) -> None:
        canvas = getattr(self, "history_duel_versus_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        center_x = width / 2
        center_y = height / 2
        ally = "#59c9ee"
        enemy = "#f05e70"
        canvas.create_line(
            max(12, center_x - 132),
            center_y,
            center_x - 32,
            center_y,
            fill=blend_color(PANEL, ally, 0.58),
            width=1,
        )
        canvas.create_line(
            center_x + 32,
            center_y,
            min(width - 12, center_x + 132),
            center_y,
            fill=blend_color(PANEL, enemy, 0.58),
            width=1,
        )
        for inset, color in ((17, "#17384a"), (11, "#264f63")):
            canvas.create_polygon(
                center_x - inset - 18,
                center_y,
                center_x - inset,
                center_y - 15,
                center_x + 3,
                center_y,
                center_x - inset,
                center_y + 15,
                fill=color,
                outline="",
            )
        for inset, color in ((17, "#4b1f29"), (11, "#6a2a37")):
            canvas.create_polygon(
                center_x + inset + 18,
                center_y,
                center_x + inset,
                center_y - 15,
                center_x - 3,
                center_y,
                center_x + inset,
                center_y + 15,
                fill=color,
                outline="",
            )
        canvas_outlined_text(
            canvas,
            center_x - 7,
            center_y,
            text="V",
            fill=ally,
            anchor="e",
            outline="#07131a",
            outline_width=1,
            font=self._ui_font("hero_title"),
        )
        canvas_outlined_text(
            canvas,
            center_x + 7,
            center_y,
            text="S",
            fill=enemy,
            anchor="w",
            outline="#18090d",
            outline_width=1,
            font=self._ui_font("hero_title"),
        )

    def _set_pvp_duel_analysis_tab(
        self, mode: str, *, redraw: bool = True
    ) -> None:
        selected = mode if mode in {"skills", "equipment"} else "skills"
        self.history_duel_analysis_tab = selected
        for key, button in getattr(
            self, "history_duel_analysis_buttons", {}
        ).items():
            active = key == selected
            button.configure(
                bg=blend_color(SURFACE, ACCENT, 0.15) if active else SURFACE,
                fg=ACCENT if active else MUTED,
            )
        self._sync_pvp_duel_left_panel()
        if redraw:
            canvas = getattr(self, "history_duel_body_canvas", None)
            if canvas is not None:
                canvas.yview_moveto(0.0)
            self._draw_pvp_duel_player_header()
            self._draw_pvp_duel_equipment_roster()
            self._draw_pvp_duel_analysis()

    def _sync_pvp_duel_left_panel(self) -> None:
        equipment_mode = (
            getattr(self, "history_duel_analysis_tab", "skills") == "equipment"
        )
        record = self._selected_history_record()
        try:
            team_size = int(
                (record or {}).get(
                    "pvp_team_size", (record or {}).get("team_size", 0)
                )
                or 0
            )
        except (TypeError, ValueError, OverflowError):
            team_size = 0
        roster_mode = equipment_mode or team_size > 1
        side_panel = getattr(self, "history_duel_side_panel", None)
        roster_panel = getattr(self, "history_duel_roster_panel", None)
        if side_panel is None or roster_panel is None:
            return
        if roster_mode:
            if side_panel.winfo_manager():
                side_panel.pack_forget()
            if not roster_panel.winfo_manager():
                roster_panel.pack(fill="both", expand=True, padx=6, pady=(6, 8))
            players = self._pvp_duel_participants()
            self.history_duel_left_title.configure(
                text=f"参战成员 · {len(players)}人"
            )
            self.history_duel_left_subtitle.configure(
                text=(
                    "点击成员查看装备快照"
                    if equipment_mode
                    else "点击成员查看技能详情"
                )
            )
        else:
            if roster_panel.winfo_manager():
                roster_panel.pack_forget()
            if not side_panel.winfo_manager():
                side_panel.pack(fill="both", expand=True, padx=10, pady=(10, 10))
            self.history_duel_left_title.configure(text="对战双方")
            self.history_duel_left_subtitle.configure(text="一对一的较量，唯有更强")

    def _select_pvp_duel_equipment_player(self, event: tk.Event) -> None:
        record = self._selected_history_record()
        try:
            team_size = int(
                (record or {}).get(
                    "pvp_team_size", (record or {}).get("team_size", 0)
                )
                or 0
            )
        except (TypeError, ValueError, OverflowError):
            team_size = 0
        if (
            getattr(self, "history_duel_analysis_tab", "skills")
            != "equipment"
            and team_size <= 1
        ):
            return
        canvas = getattr(self, "history_duel_roster_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        try:
            x = float(canvas.canvasx(event.x))
            y = float(canvas.canvasy(event.y))
        except (AttributeError, TypeError, ValueError, tk.TclError):
            return
        players = self._pvp_duel_participants()
        for left, top, right, bottom, index in getattr(
            canvas, "_pvp_equipment_roster_hit_rows", ()
        ):
            if left <= x <= right and top <= y < bottom and index < len(players):
                player = players[index]
                self.history_duel_equipment_selected_player = (
                    self._pvp_duel_player_key(player, index)
                )
                self.history_duel_selected_side = self._pvp_duel_player_side(player)
                self.history_duel_equipment_selected_index = 0
                self.history_selected_actor = int(player.get("actor_id", 0) or 0)
                body = getattr(self, "history_duel_body_canvas", None)
                if body is not None:
                    body.yview_moveto(0.0)
                self._draw_pvp_duel_equipment_roster()
                self._draw_pvp_duel_player_header()
                self._draw_pvp_duel_analysis()
                return

    def _draw_pvp_duel_equipment_roster(self) -> None:
        canvas = getattr(self, "history_duel_roster_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("all")
        canvas._pvp_equipment_roster_hit_rows = []
        canvas._pvp_equipment_roster_icons = []
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        players = self._pvp_duel_participants()
        if not players:
            canvas.create_text(
                width // 2,
                height // 2,
                text="本场没有参战成员资料",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        selected = self._selected_pvp_duel_equipment_player()
        selected_key = self._pvp_duel_player_key(
            selected, players.index(selected)
        ) if selected in players else ""
        hidden = self._history_names_hidden()
        top = 0
        row_height = 46
        header_height = 34
        for side, side_title, accent in (
            ("ally", "我方", "#59c9ee"),
            ("enemy", "敌方", "#f05e70"),
        ):
            side_rows = [
                (index, player)
                for index, player in enumerate(players)
                if self._pvp_duel_player_side(player) == side
            ]
            if not side_rows:
                continue
            canvas.create_rectangle(
                0,
                top,
                width,
                top + header_height,
                fill=blend_color(PANEL, accent, 0.13),
                outline="",
            )
            canvas.create_rectangle(
                0, top, 4, top + header_height, fill=accent, outline=""
            )
            canvas.create_text(
                14,
                top + header_height / 2,
                text=f"{side_title} · {len(side_rows)}",
                fill=accent,
                anchor="w",
                font=self._ui_font("strong"),
            )
            top += header_height
            for global_index, player in side_rows:
                bottom = top + row_height
                key = self._pvp_duel_player_key(player, global_index)
                is_selected = key == selected_key
                base = blend_color(PANEL, accent, 0.13 if is_selected else 0.025)
                canvas.create_rectangle(
                    0, top, width, bottom - 1, fill=base, outline=""
                )
                if is_selected:
                    canvas.create_rectangle(
                        0, top, 3, bottom - 1, fill=ACCENT, outline=""
                    )
                canvas.create_line(0, bottom - 1, width, bottom - 1, fill=BORDER)
                profession_id = int(player.get("profession_id", 0) or 0)
                icon = self._history_profession_icon(profession_id, 28)
                canvas._pvp_equipment_roster_icons.append(icon)
                canvas.create_image(12, top + 9, image=icon, anchor="nw")
                name = self._history_actor_name(
                    player, global_index, hidden
                )
                canvas.create_text(
                    48,
                    top + row_height / 2,
                    text=self._fit_ui_text(name, max(64, width - 222), "strong"),
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("strong"),
                )
                name_right = 48 + self._ui_font("strong").measure(
                    self._fit_ui_text(name, max(64, width - 222), "strong")
                )
                if player.get("is_self") is True and name_right + 28 < width - 138:
                    canvas.create_rectangle(
                        name_right + 7,
                        top + 14,
                        name_right + 29,
                        top + 33,
                        fill="#15363f",
                        outline=ACCENT,
                    )
                    canvas.create_text(
                        name_right + 18,
                        top + 23,
                        text="我",
                        fill=ACCENT,
                        font=self._ui_font("micro"),
                    )
                rating = normalize_extraordinary_rating(
                    player.get("extraordinary_rating")
                )
                canvas.create_text(
                    width - 118,
                    top + row_height / 2,
                    text="--" if rating is None else format_number(rating),
                    fill=WARN if rating is not None else MUTED,
                    anchor="e",
                    font=self._ui_font("number"),
                )
                snapshot = player.get("equipment_snapshot")
                has_snapshot = isinstance(snapshot, dict) and isinstance(
                    snapshot.get("equipment"), list
                ) and bool(snapshot.get("equipment"))
                if player.get("is_ai") is True:
                    status, status_color = "人机", MUTED
                elif has_snapshot:
                    status, status_color = (
                        ("已获取", ACCENT)
                        if snapshot.get("equipment_score_complete")
                        else ("部分获取", "#d7a45f")
                    )
                else:
                    status, status_color = "未取得", "#d7a45f"
                canvas.create_text(
                    width - 14,
                    top + row_height / 2,
                    text=status,
                    fill=status_color,
                    anchor="e",
                    font=self._ui_font("small"),
                )
                canvas._pvp_equipment_roster_hit_rows.append(
                    (0, top, width, bottom, global_index)
                )
                top = bottom
        canvas.configure(scrollregion=(0, 0, width, max(height, top)))

    def _select_pvp_duel_side(self, side: str) -> None:
        if side not in {"ally", "enemy"}:
            return
        self.history_duel_selected_side = side
        self.history_duel_equipment_selected_index = 0
        selected = self._selected_pvp_duel_player()
        if isinstance(selected, dict):
            self.history_selected_actor = int(selected.get("actor_id", 0) or 0)
        canvas = getattr(self, "history_duel_body_canvas", None)
        if canvas is not None:
            canvas.yview_moveto(0.0)
        self._draw_pvp_duel_side_card("ally")
        self._draw_pvp_duel_side_card("enemy")
        self._draw_pvp_duel_player_header()
        self._draw_pvp_duel_analysis()

    def _draw_pvp_duel_side_card(self, side: str) -> None:
        canvas = getattr(self, "history_duel_side_canvases", {}).get(side)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        _record, ally, enemy = self._pvp_duel_players()
        player = enemy if side == "enemy" else ally
        accent = "#f05e70" if side == "enemy" else "#59c9ee"
        selected = getattr(self, "history_duel_selected_side", "ally") == side
        background = "#171014" if side == "enemy" else "#0b151b"
        tint = "#3a1821" if side == "enemy" else "#123343"
        bands = 14
        for index in range(bands):
            top = round(height * index / bands)
            bottom = round(height * (index + 1) / bands)
            ratio = (1.0 - index / max(1, bands - 1)) * (
                0.42 if selected else 0.28
            )
            canvas.create_rectangle(
                1,
                top,
                width - 2,
                bottom,
                fill=blend_color(background, tint, ratio),
                outline="",
            )
        border = blend_color(BORDER, accent, 0.42 if selected else 0.18)
        # Selection is carried by the side rail and tint. Avoid another bright
        # full-card frame around an already bordered workspace.
        canvas.create_line(0, height - 1, width, height - 1, fill=BORDER)
        canvas.create_rectangle(0, 25, 3, height - 1, fill=accent, outline="")
        canvas.create_polygon(
            0,
            0,
            82,
            0,
            94,
            12,
            82,
            25,
            0,
            25,
            fill=blend_color(background, accent, 0.42),
            outline="",
        )
        canvas.create_text(
            14,
            12,
            text="敌方" if side == "enemy" else "我方",
            fill="#fff0f2" if side == "enemy" else "#e4f8ff",
            anchor="w",
            font=self._ui_font("strong"),
        )
        if not isinstance(player, dict):
            canvas.create_text(
                width // 2,
                height // 2,
                text="等待对手资料",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            return

        profession_id = int(player.get("profession_id", 0) or 0)
        show_metrics = width >= 320
        identity_right = (
            max(168, min(205, int(width * 0.43)))
            if show_metrics
            else max(80, width - 10)
        )
        watermark = self.icons.profession_watermark(profession_id, size=58)
        canvas.create_image(
            identity_right - 8, 34, image=watermark, anchor="ne"
        )
        canvas._pvp_duel_watermark = watermark
        # The duel card uses the class crest directly. The full portrait and
        # circular frame belong to the roster overview, not this compact card.
        profession_icon = self.icons.main_profession(profession_id, size=58)
        canvas.create_image(16, 40, image=profession_icon, anchor="nw")
        canvas._pvp_duel_profession_icon = profession_icon
        name = self._history_actor_name(
            player,
            1 if side == "enemy" else 0,
            self._history_names_hidden(),
        )
        try:
            level = max(0, int(player.get("level", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            level = 0
        rating = normalize_extraordinary_rating(player.get("extraordinary_rating"))
        canvas.create_text(
            84,
            51,
            text=self._fit_ui_text(
                name, max(54, identity_right - 94), "strong"
            ),
            fill=TEXT,
            anchor="w",
            font=self._ui_font("strong"),
        )
        if level:
            canvas.create_oval(
                55, 82, 76, 101, fill="#11191e", outline=accent, width=1
            )
            canvas.create_text(
                65,
                91,
                text=str(level),
                fill="#f4fbff",
                font=self._ui_font("micro"),
            )
        rating_text = "--" if rating is None else format_number(rating)
        rating_prefix = "非凡评分  "
        rating_font = self._ui_font("number_large")
        available_width = max(64, identity_right - 28)
        full_rating_text = rating_prefix + rating_text
        if rating_font.measure(full_rating_text) + 20 > available_width:
            rating_font = self._ui_font("number")
        if rating_font.measure(full_rating_text) + 20 > available_width:
            rating_prefix = "评分  "
        if rating_font.measure(rating_prefix + rating_text) + 20 > available_width:
            rating_text = self._fit_ui_text(
                rating_text,
                max(24, available_width - rating_font.measure(rating_prefix) - 20),
                "number",
            )
        rendered_rating_text = rating_prefix + rating_text
        pill_width = min(
            available_width,
            max(92, rating_font.measure(rendered_rating_text) + 20),
        )
        pill_left = 14
        pill_right = min(identity_right - 10, pill_left + pill_width)
        canvas.create_polygon(
            pill_left,
            111,
            pill_right - 8,
            111,
            pill_right,
            119,
            pill_right,
            145,
            pill_left,
            145,
            fill=blend_color(background, WARN, 0.16),
            outline=blend_color(BORDER, WARN, 0.38),
        )
        canvas.create_text(
            pill_left + 10,
            128,
            text=rendered_rating_text,
            fill=WARN if rating is not None else MUTED,
            anchor="w",
            font=rating_font,
        )
        metrics = (
            ("伤害", player.get("damage"), accent),
            ("承伤", player.get("taken"), "#d9a466"),
            ("治疗", player.get("effective_healing", player.get("healing")), "#75c995"),
            ("击杀", player.get("kills"), "#f0cf72"),
            ("阵亡", player.get("deaths"), "#d98a94"),
        )
        if show_metrics:
            stats_left = identity_right + 8
            stats_right = width - 8
            canvas.create_line(
                identity_right, 34, identity_right, height - 10, fill=border
            )
            canvas.create_line(
                stats_left, 84, stats_right, 84, fill=border
            )
            for index, (caption, value, color) in enumerate(metrics):
                top_row = index < 3
                slot_count = 3 if top_row else 2
                slot_index = index if top_row else index - 3
                cell_width = max(
                    1, (stats_right - stats_left) / slot_count
                )
                center = stats_left + cell_width * (slot_index + 0.5)
                caption_y = 47 if top_row else 107
                value_y = 67 if top_row else 129
                if slot_index:
                    separator = stats_left + cell_width * slot_index
                    canvas.create_line(
                        separator,
                        37 if top_row else 94,
                        separator,
                        76 if top_row else 143,
                        fill=border,
                    )
                canvas.create_text(
                    center,
                    caption_y,
                    text=caption,
                    fill=SUBTLE,
                    font=self._ui_font("micro"),
                )
                if caption == "治疗":
                    source = str(player.get("healing_source") or "")
                    explanation = (
                        "估算治疗：结束瞬间已记录承伤－开场最大生命＋结束生命，"
                        "负数按 0 计。默认开场满血；结束后补到的伤害不计入估算，"
                        "因此可能与最终承伤不同。包含自然恢复、护盾和采样误差，"
                        "不是精确技能治疗，也不包含溢出治疗。"
                        if source == "hp_balance_estimate"
                        else "游戏治疗同步返回的有效治疗。"
                        if source == "network_exact"
                        else "未收到精确治疗；血量或承伤样本不足时不推算，显示 --。"
                    )
                    badge = getattr(canvas, "_pvp_duel_healing_help", None)
                    if badge is None or not badge.winfo_exists():
                        badge = ModernHelpBadge(
                            canvas, explanation,
                            font=self._ui_font("micro"),
                            background=blend_color(background, tint, 0.2),
                        )
                        canvas._pvp_duel_healing_help = badge
                    badge.help_text = explanation
                    canvas.create_window(
                        center + self._ui_font("micro").measure(caption) / 2 + 3,
                        caption_y,
                        window=badge,
                        anchor="w",
                    )
                canvas.create_text(
                    center,
                    value_y,
                    text=(
                        "≈" + self._history_optional_number(value)
                        if caption == "治疗" and source == "hp_balance_estimate"
                        and value is not None
                        else self._history_optional_number(value)
                    ),
                    fill=color if value is not None else MUTED,
                    font=self._ui_font("number_strong"),
                )

    def _draw_pvp_duel_player_header(self) -> None:
        canvas = getattr(self, "history_duel_player_header", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        player = self._selected_pvp_duel_player()
        if not isinstance(player, dict):
            canvas.create_text(
                width // 2,
                height // 2,
                text="请选择一名玩家",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            return
        equipment_mode = (
            getattr(self, "history_duel_analysis_tab", "skills") == "equipment"
        )
        side = (
            self._pvp_duel_player_side(player)
            if equipment_mode
            else getattr(self, "history_duel_selected_side", "ally")
        )
        accent = "#e06b73" if side == "enemy" else ACCENT
        selected_caption = getattr(self, "history_duel_selected_caption", None)
        if selected_caption is not None:
            selected_caption.configure(
                text=(
                    f"当前显示：{'己方' if side == 'ally' else '敌方'}装备快照"
                    if equipment_mode
                    else f"当前显示：{'己方' if side == 'ally' else '敌方'}玩家数据"
                ),
                fg=accent,
            )
        portrait = self.icons.pvp_appearance(
            player.get("avatar_id"),
            player.get("avatar_frame_id"),
            player.get("profession_id"),
            size=68,
        )
        canvas.create_image(16, 18, image=portrait, anchor="nw")
        canvas._pvp_duel_header_portrait = portrait
        name = self._history_actor_name(
            player,
            1 if side == "enemy" else 0,
            self._history_names_hidden(),
        )
        rating = normalize_extraordinary_rating(player.get("extraordinary_rating"))
        canvas.create_text(
            96,
            28,
            text=name,
            fill=TEXT,
            anchor="w",
            font=self._ui_font("title"),
        )
        canvas.create_text(
            96,
            53,
            text="我方" if side == "ally" else "敌方",
            fill=accent,
            anchor="w",
            font=self._ui_font("small"),
        )
        canvas.create_text(
            96,
            78,
            text="非凡评分  " + ("--" if rating is None else format_number(rating)),
            fill=WARN if rating is not None else MUTED,
            anchor="w",
            font=self._ui_font("number_strong"),
        )
        if equipment_mode:
            snapshot = player.get("equipment_snapshot")
            snapshot = snapshot if isinstance(snapshot, dict) else None
            equipment = snapshot.get("equipment") if snapshot else None
            has_snapshot = isinstance(equipment, list) and bool(equipment)
            if player.get("is_ai") is True:
                status_text, status_color = "人机 · 无需查询", MUTED
            elif has_snapshot:
                status_text, status_color = (
                    ("已获取", ACCENT)
                    if snapshot.get("equipment_score_complete")
                    else ("部分获取", "#d7a45f")
                )
            else:
                status_text, status_color = "未取得", "#d7a45f"
            timestamp = (
                self._history_equipment_timestamp(snapshot)
                if snapshot is not None
                else "--"
            )
            status_x = max(300, width - 235)
            canvas.create_line(status_x - 18, 18, status_x - 18, height - 18, fill=BORDER)
            canvas.create_text(
                status_x,
                37,
                text=f"快照时间  {timestamp}",
                fill="#8cb9dc" if timestamp != "--" else MUTED,
                anchor="w",
                font=self._ui_font("small"),
            )
            canvas.create_oval(
                status_x,
                66,
                status_x + 12,
                78,
                fill=status_color,
                outline="",
            )
            canvas.create_text(
                status_x + 22,
                72,
                text=status_text,
                fill=status_color,
                anchor="w",
                font=self._ui_font("strong"),
            )
            return
        stats = (
            ("K / D / A", " / ".join(self._history_optional_number(player.get(key)) for key in ("kills", "deaths", "assists"))),
            ("伤害", self._history_optional_number(player.get("damage"))),
            ("治疗", self._history_optional_number(player.get("effective_healing", player.get("healing")))),
            ("承伤", self._history_optional_number(player.get("taken"))),
        )
        start = max(280, int(width * 0.43))
        cell_width = max(74, (width - start - 12) / len(stats))
        for index, (caption, value) in enumerate(stats):
            left = start + index * cell_width
            if index:
                canvas.create_line(left, 18, left, height - 18, fill=BORDER)
            canvas.create_text(
                left + cell_width / 2,
                35,
                text=caption,
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            canvas.create_text(
                left + cell_width / 2,
                67,
                text=value,
                fill=accent if value != "--" else MUTED,
                font=self._ui_font("number_strong"),
            )

    def _select_pvp_duel_equipment_item(self, event: tk.Event) -> None:
        """Select an equipment row without changing the surrounding detail layout."""

        if getattr(self, "history_duel_analysis_tab", "skills") != "equipment":
            return
        canvas = getattr(self, "history_duel_body_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        try:
            x = float(canvas.canvasx(event.x))
            y = float(canvas.canvasy(event.y))
        except (AttributeError, TypeError, ValueError, tk.TclError):
            return
        for left, top, right, bottom, index in getattr(
            canvas, "_pvp_equipment_hit_rows", ()
        ):
            if left <= x <= right and top <= y < bottom:
                self.history_duel_equipment_selected_index = index
                self._draw_pvp_duel_analysis()
                return

    def _draw_pvp_duel_analysis(self) -> None:
        canvas = getattr(self, "history_duel_body_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        player = self._selected_pvp_duel_player()
        mode = getattr(self, "history_duel_analysis_tab", "skills")
        title = getattr(self, "history_duel_section_title", None)
        subtitle = getattr(self, "history_duel_section_subtitle", None)
        if mode == "equipment":
            if title is not None:
                title.configure(text="装备槽位")
            if subtitle is not None:
                snapshot = player.get("equipment_snapshot") if isinstance(player, dict) else None
                subtitle.configure(
                    text=(
                        "非本人装备分数暂不包含强化分"
                        if isinstance(snapshot, dict)
                        and player.get("is_self") is not True
                        and snapshot.get("equipment")
                        and not snapshot.get("equipment_score_complete")
                        else "点击装备卡查看评分、强化与中文词条详情"
                    )
                )
            self._draw_pvp_duel_equipment_analysis(canvas, width, height, player)
        else:
            if title is not None:
                title.configure(text="技能详情")
            if subtitle is not None:
                subtitle.configure(
                    text=(
                        "仅展示本机已捕获的部分技能；占比按已捕获伤害计算"
                        if isinstance(player, dict)
                        and player.get("skills_scope") == "observed_partial"
                        else "本场技能伤害、占比与命中次数"
                    )
                )
            self._draw_pvp_duel_skill_analysis(canvas, width, height, player)

    def _draw_pvp_duel_skill_analysis(
        self,
        canvas: tk.Canvas,
        width: int,
        height: int,
        player: dict | None,
    ) -> None:
        if not isinstance(player, dict):
            canvas.create_text(
                width // 2,
                height // 2,
                text="暂无玩家技能数据",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        side = getattr(self, "history_duel_selected_side", "ally")
        candidates = (
            ("skills", "skills_outgoing", "pvp_skills_from", "skills_incoming")
            if side == "enemy"
            else ("skills", "skills_outgoing", "pvp_skills_to")
        )
        skills: list[dict] = []
        for key in candidates:
            raw = player.get(key)
            rows = [row for row in raw if isinstance(row, dict)] if isinstance(raw, list) else []
            if rows:
                skills = rows
                break

        def skill_was_used(row: dict) -> bool:
            # Cast packets also contain stance, passive and periodic state
            # IDs that have no damage event and no display name.  This table
            # presents damage contribution, so a cast alone is not enough to
            # create a visible skill row.
            for key in (
                "damage",
                "hits",
                "critical_hits",
                "max_hit",
            ):
                try:
                    if int(row.get(key, 0) or 0) > 0:
                        return True
                except (TypeError, ValueError, OverflowError):
                    continue
            return False

        # Keep only rows backed by an actual hit/damage result. Cast-only
        # protocol rows remain available in the immutable record for future
        # analysis, but do not pollute this damage table with numeric IDs.
        skills = [row for row in skills if skill_was_used(row)]
        skills = sorted(
            skills,
            key=lambda row: max(0, int(row.get("damage", 0) or 0)),
            reverse=True,
        )
        known_total = sum(
            max(0, int(row.get("damage", 0) or 0)) for row in skills
        )
        summary_height = 64
        canvas.create_rectangle(0, 0, width, summary_height, fill="#10161a", outline="")
        partial_skills = player.get("skills_scope") == "observed_partial"
        summary = (
            ("已观测伤害" if partial_skills else "技能总伤害", self._history_optional_number(known_total if skills else None), ACCENT),
            ("技能数量", str(len(skills)) if skills else "--", TEXT),
            ("总命中", self._history_optional_number(sum(int(row.get("hits", 0) or 0) for row in skills) if any(row.get("hits") is not None for row in skills) else None), TEXT),
        )
        cell_width = width / len(summary)
        for index, (caption, value, color) in enumerate(summary):
            left = index * cell_width
            if index:
                canvas.create_line(left, 12, left, summary_height - 12, fill=BORDER)
            canvas.create_text(
                left + 12,
                19,
                text=caption,
                fill=SUBTLE,
                anchor="w",
                font=self._ui_font("micro"),
            )
            canvas.create_text(
                left + 12,
                43,
                text=value,
                fill=color if value != "--" else MUTED,
                anchor="w",
                font=self._ui_font("number_strong"),
            )
        header_top = summary_height
        header_height = 31
        canvas.create_rectangle(
            0,
            header_top,
            width,
            header_top + header_height,
            fill=SURFACE,
            outline="",
        )
        columns = {
            "skill": 45,
            "damage": int(width * 0.52),
            "share": int(width * 0.68),
            "hits": int(width * 0.82),
            "max_hit": width - 14,
        }
        for caption, x, anchor in (
            ("技能", columns["skill"], "w"),
            ("伤害", columns["damage"], "e"),
            ("已观测占比" if partial_skills else "占比", columns["share"], "e"),
            ("命中", columns["hits"], "e"),
            ("最高", columns["max_hit"], "e"),
        ):
            canvas.create_text(
                x,
                header_top + header_height // 2,
                text=caption,
                fill=MUTED,
                anchor=anchor,
                font=self._ui_font("table_header"),
            )
        top = header_top + header_height
        row_height = 48
        if not skills:
            cast_count = sum(
                max(0, int(row.get("casts", 0) or 0))
                for row in player.get("skills", ())
                if isinstance(row, dict)
            ) if isinstance(player.get("skills"), list) else 0
            canvas.create_text(
                width // 2,
                top + 62,
                text=(
                    f"已观测 {cast_count} 次技能释放，暂无可归属的命中伤害"
                    if cast_count else "本场没有取得该玩家的技能明细"
                ),
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                top + 89,
                text="缺失字段保持为空，不以总伤害反推技能分布",
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            canvas.configure(scrollregion=(0, 0, width, max(height, top + 130)))
            canvas._pvp_duel_skill_icons = []
            return
        icons = []
        class_id = int(player.get("profession_id", 0) or 0)
        _profession, skill_color = self._profession_info(class_id)
        max_damage = max(int(row.get("damage", 0) or 0) for row in skills)
        for index, skill in enumerate(skills):
            bottom = top + row_height
            base = PANEL if index % 2 == 0 else "#11171b"
            canvas.create_rectangle(0, top, width, bottom - 1, fill=base, outline="")
            damage = max(0, int(skill.get("damage", 0) or 0))
            if max_damage:
                canvas.create_rectangle(
                    0,
                    top,
                    max(3, int(width * 0.35 * damage / max_damage)),
                    bottom - 1,
                    fill=blend_color(base, skill_color, 0.16),
                    outline="",
                )
            skill_id = int(skill.get("skill_id", 0) or 0)
            name = _history_skill_display_name(skill.get("name")) or f"技能 {skill_id}"
            icon = self.icons.skill(skill_id, name, class_id, 28)
            icons.append(icon)
            canvas.create_image(10, top + 10, image=icon, anchor="nw")
            canvas.create_text(
                45,
                top + row_height // 2,
                text=self._fit_ui_text(name, max(80, columns["damage"] - 60), "strong"),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            raw_share = self._history_optional_ratio(skill.get("share"))
            share = raw_share if raw_share is not None else damage / known_total if known_total else None
            values = (
                (columns["damage"], self._history_optional_number(skill.get("damage"))),
                (columns["share"], f"{share * 100:.1f}%" if share is not None else "--"),
                (columns["hits"], self._history_optional_number(skill.get("hits"))),
                (columns["max_hit"], self._history_optional_number(skill.get("max_hit"))),
            )
            for x, value in values:
                canvas.create_text(
                    x,
                    top + row_height // 2,
                    text=value,
                    fill=TEXT if value != "--" else SUBTLE,
                    anchor="e",
                    font=self._ui_font("number"),
                )
            top = bottom
        canvas._pvp_duel_skill_icons = icons
        canvas.configure(scrollregion=(0, 0, width, max(height, top)))

    def _draw_pvp_duel_equipment_analysis(
        self,
        canvas: tk.Canvas,
        width: int,
        height: int,
        player: dict | None,
        *,
        selected_index_attr: str = "history_duel_equipment_selected_index",
        header_height: int = 0,
    ) -> None:
        canvas._pvp_equipment_hit_rows = []
        snapshot = (
            player.get("equipment_snapshot")
            if isinstance(player, dict)
            else None
        )
        if not isinstance(snapshot, dict):
            canvas.create_text(
                width // 2,
                height // 2 - 12,
                text="本场未取得该玩家的装备快照",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 18,
                text="不会用当前装备覆盖历史，也不会推测缺失词条",
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        equipment = snapshot.get("equipment")
        equipment = (
            [row for row in equipment if isinstance(row, dict)]
            if isinstance(equipment, list)
            else []
        )
        # The selected-player header already carries rating, status and capture
        # time.  Keep the canvas itself focused on the eight item slots and the
        # selected item detail, matching the approved snapshot composition.
        summary_height = header_height
        if not equipment:
            canvas.create_text(
                width // 2,
                summary_height + 70,
                text="装备响应中没有可展示的装备条目",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.configure(
                scrollregion=(0, 0, width, max(height, summary_height + 120))
            )
            return

        equipment = sorted(
            equipment,
            key=lambda row: int(row.get("slot", 0) or 0),
        )
        content_top = summary_height + 8
        selected_index = min(
            max(0, int(getattr(self, selected_index_attr, 0))),
            len(equipment) - 1,
        )
        setattr(self, selected_index_attr, selected_index)
        canvas._pvp_equipment_images = []
        canvas._pvp_equipment_surfaces = []

        def item_quality(row: dict) -> int:
            metadata = row.get("metadata")
            metadata = metadata if isinstance(metadata, dict) else {}
            try:
                return max(0, int(row.get("quality") or metadata.get("quality") or 0))
            except (TypeError, ValueError, OverflowError):
                return 0

        def item_mode(row: dict) -> tuple[str, str]:
            mode = str(row.get("equipment_mode") or "").casefold()
            is_pvp = bool(row.get("is_pvp")) or mode == "pvp"
            if is_pvp:
                return "竞技", "#e17575"
            if mode in {"pve", "adventure", "冒险"}:
                return "冒险", "#70b9e6"
            return "未知", MUTED

        def score_part(value: object) -> str:
            try:
                return format_number(max(0, int(value))) if value is not None else "--"
            except (TypeError, ValueError, OverflowError):
                return "--"

        def enhance_level_text(row: dict) -> str:
            def optional_int(value: object) -> int | None:
                try:
                    return max(0, int(value)) if value is not None else None
                except (TypeError, ValueError, OverflowError):
                    return None

            completed = optional_int(row.get("enhance_completed_level"))
            current = optional_int(row.get("enhance_level"))
            progress = optional_int(row.get("enhance_level_progress_percent"))
            if (
                completed is not None
                and current is not None
                and current > completed
                and progress is not None
                and progress < 100
            ):
                return f"强化 +{completed}（+{current} {progress}%）"
            level = completed if completed is not None else current
            return (
                f"强化 +{level}" if level is not None
                else "强化等级未返回" if player.get("is_self") is True else ""
            )

        def draw_quality_panel(
            left: int,
            top: int,
            right: int,
            bottom: int,
            quality: int,
            *,
            selected: bool = False,
        ) -> None:
            surface = self.icons.equipment_quality_surface(
                quality,
                max(8, right - left + 1),
                max(8, bottom - top + 1),
                selected=selected,
            )
            canvas._pvp_equipment_surfaces.append(surface)
            canvas.create_image(left, top, image=surface, anchor="nw")

        columns = 4
        gap = 7
        side_pad = 8
        card_width = max(
            96,
            int((width - side_pad * 2 - gap * (columns - 1)) / columns),
        )
        card_height = 104
        for card_index in range(8):
            row_index, column_index = divmod(card_index, columns)
            left = side_pad + column_index * (card_width + gap)
            top = content_top + row_index * (card_height + gap)
            right = min(width - side_pad, left + card_width)
            bottom = top + card_height
            item = equipment[card_index] if card_index < len(equipment) else None
            quality = item_quality(item) if isinstance(item, dict) else 0
            draw_quality_panel(
                left,
                top,
                right,
                bottom,
                quality,
                selected=card_index == selected_index and item is not None,
            )
            if item is None:
                canvas.create_text(
                    (left + right) / 2,
                    top + card_height / 2,
                    text="未返回",
                    fill=SUBTLE,
                    font=self._ui_font("micro"),
                )
                continue
            metadata = item.get("metadata")
            metadata = metadata if isinstance(metadata, dict) else {}
            icon_size = min(54, card_height - 28, max(38, card_width - 70))
            icon = self.icons.equipment_item(
                item.get("item_id"), metadata.get("icon"), icon_size
            )
            canvas._pvp_equipment_images.append(icon)
            icon_left = left + 8
            canvas.create_image(
                icon_left,
                top + 10,
                image=icon,
                anchor="nw",
            )
            text_left = icon_left + icon_size + 7
            slot_text = str(
                item.get("slot_name") or equipment_slot_name(item.get("slot"))
            )
            item_name = str(item.get("item_name") or equipment_item_name(item.get("item_id"))).strip()
            mode_text, mode_color = item_mode(item)
            canvas.create_text(
                text_left,
                top + 17,
                text=self._fit_ui_text(
                    slot_text, max(28, right - text_left - 6), "strong"
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
            )
            mode_width = self._ui_font("micro").measure(mode_text) + 10
            canvas.create_rectangle(
                text_left,
                top + 31,
                min(right - 5, text_left + mode_width),
                top + 50,
                fill=blend_color("#10161a", mode_color, 0.16),
                outline=mode_color,
            )
            canvas.create_text(
                text_left + 5,
                top + 40,
                text=mode_text,
                fill=mode_color,
                anchor="w",
                font=self._ui_font("micro"),
            )
            enhance_level = item.get("enhance_level")
            enhance_score = item.get("enhance_score")
            enhance_percent = item.get(
                "enhance_overall_percent", item.get("enhance_progress_percent")
            )
            if enhance_score is None and enhance_level is None:
                enhance_text = "强化未返回"
                enhance_color = SUBTLE
            else:
                enhance_text = (
                    f"强化 +{int(enhance_level)}"
                    if enhance_level is not None
                    else f"强化 {score_part(enhance_score)}"
                )
                enhance_color = WARN
            canvas.create_text(
                text_left,
                top + 63,
                text=self._fit_ui_text(
                    item_name or enhance_text, max(28, right - text_left - 6), "micro"
                ),
                fill=TEXT if item_name else enhance_color,
                anchor="w",
                font=self._ui_font("micro"),
            )
            score_complete = bool(item.get("score_complete"))
            visible_score = (
                item.get("total_score")
                if score_complete
                else item.get("known_score", item.get("item_score"))
            )
            score_text = score_part(visible_score)
            if score_text != "--" and not score_complete and player.get("is_self") is True:
                score_text = "已知 " + score_text
            canvas.create_text(
                right - 6,
                top + 84,
                text=score_text,
                fill=WARN if score_text != "--" else MUTED,
                anchor="e",
                font=self._ui_font("number"),
            )
            if enhance_percent is not None:
                try:
                    progress = min(100, max(0, int(enhance_percent)))
                except (TypeError, ValueError, OverflowError):
                    progress = 0
                bar_left = left + 8
                bar_right = right - 8
                canvas.create_rectangle(
                    bar_left,
                    bottom - 8,
                    bar_right,
                    bottom - 5,
                    fill="#253039",
                    outline="",
                )
                canvas.create_rectangle(
                    bar_left,
                    bottom - 8,
                    bar_left + (bar_right - bar_left) * progress / 100,
                    bottom - 5,
                    fill="#efc45e" if quality == 6 else "#e16a74" if quality == 7 else ACCENT,
                    outline="",
                )
            canvas._pvp_equipment_hit_rows.append(
