    def _write_history_export(
        self,
        battle_ids: list[str],
        export_format: str,
        directory_text: str,
        filename_text: str,
        status_label: tk.Label,
    ) -> None:
        extension = ".json" if export_format == "json" else ".csv"
        if not directory_text.strip():
            status_label.configure(text="请填写保存位置。")
            return
        filename = filename_text.strip()
        if not filename:
            status_label.configure(text="请填写文件名。")
            return
        if any(character in filename for character in '<>:"/\\|?*'):
            status_label.configure(text="文件名包含 Windows 不支持的字符。")
            return
        filename = filename.rstrip(" .")
        if not filename:
            status_label.configure(text="请填写有效的文件名。")
            return
        if not filename.casefold().endswith(extension):
            filename += extension
        try:
            directory = Path(os.path.expandvars(directory_text)).expanduser()
            if not directory.is_absolute():
                directory = Path.home() / directory
            directory.mkdir(parents=True, exist_ok=True)
            path = directory / filename
            suffix_number = 2
            while path.exists():
                path = directory / (
                    f"{Path(filename).stem} ({suffix_number}){extension}"
                )
                suffix_number += 1
            exported = self.history_store.export_records(
                battle_ids, str(path), export_format
            )
        except (OSError, TypeError, ValueError) as exc:
            status_label.configure(text=f"导出失败：{exc}")
            return
        self._close_history_modal()

        def open_export_folder() -> None:
            try:
                os.startfile(str(path.parent))
            except (AttributeError, OSError):
                self._show_notice(
                    "导出位置",
                    str(path.parent),
                    parent=self.history_window,
                )

        self._show_notice(
            "导出完成",
            f"已导出 {exported} 场战斗记录。\n{path}",
            parent=self.history_window,
            confirm_text="打开文件夹",
            cancel_text="关闭",
            on_confirm=open_export_folder,
        )

