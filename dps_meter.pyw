def load_json_object(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return {}
    return value if isinstance(value, dict) else {}


def write_json_object(path: Path, value: dict) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary = path.with_suffix(path.suffix + ".tmp")
        temporary.write_text(
            json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        os.replace(temporary, path)
    except OSError:
        pass


def _capture_json_default(value: object) -> object:
    """Preserve opaque capture values without interrupting live parsing."""

    if isinstance(value, (bytes, bytearray, memoryview)):
        data = bytes(value)
        return {
            "$bytes_base64": base64.b64encode(data).decode("ascii"),
            "$length": len(data),
        }
    if isinstance(value, Path):
        return str(value)
    return f"<{type(value).__name__}>"


def write_capture_record(log_handle, record: object) -> bool:
    """Best-effort diagnostics: capture logging must never break parsing."""

    try:
        log_handle.write(
            json.dumps(
                record,
                ensure_ascii=False,
                default=_capture_json_default,
            )
            + "\n"
        )
        return True
    except (OSError, TypeError, ValueError):
        return False


def write_capture_lifecycle_event(message: str, **fields: object) -> None:
    """Persist bounded, non-packet capture health diagnostics."""

    event = {
        "event_time": dt.datetime.now().astimezone().isoformat(),
        "message": str(message or "state")[:96],
        **fields,
    }
    try:
        encoded = json.dumps(
            event,
            ensure_ascii=False,
            separators=(",", ":"),
            default=lambda value: f"<{type(value).__name__}>",
        )
        with CAPTURE_LIFECYCLE_LOG_LOCK:
            CAPTURE_LIFECYCLE_LOG_PATH.parent.mkdir(
                parents=True, exist_ok=True
            )
            try:
                oversized = (
                    CAPTURE_LIFECYCLE_LOG_PATH.stat().st_size
                    >= CAPTURE_LIFECYCLE_LOG_MAX_BYTES
                )
            except OSError:
                oversized = False
            if oversized:
                previous = CAPTURE_LIFECYCLE_LOG_PATH.with_suffix(
                    CAPTURE_LIFECYCLE_LOG_PATH.suffix + ".1"
                )
                previous.unlink(missing_ok=True)
                os.replace(CAPTURE_LIFECYCLE_LOG_PATH, previous)
            with CAPTURE_LIFECYCLE_LOG_PATH.open(
                "a", encoding="utf-8", newline=""
            ) as handle:
                handle.write(encoded + "\n")
    except (OSError, TypeError, ValueError):
        # Health logging must never alter capture behavior.
        pass


def normalize_combat_upload_states(value: object) -> dict[str, dict[str, object]]:
    """Return bounded local upload metadata without touching combat archives."""

    root = value if isinstance(value, dict) else {}
    raw_records = root.get("records", root)
    if not isinstance(raw_records, dict):
        return {}
    result: dict[str, dict[str, object]] = {}
    for raw_battle_id, raw_state in list(raw_records.items())[-2000:]:
        battle_id = str(raw_battle_id or "").strip()[:96]
        if not battle_id or not isinstance(raw_state, dict):
            continue
        state = str(raw_state.get("state", "pending") or "pending").casefold()
        if state not in UPLOAD_STATE_VALUES:
            state = "pending"
        if state == "uploading":
            state = "failed"
        rank_value = raw_state.get("rank")
        try:
            rank = max(1, int(rank_value)) if rank_value is not None else None
        except (TypeError, ValueError, OverflowError):
            rank = None
        try:
            updated_at = max(0.0, float(raw_state.get("updated_at", 0.0) or 0.0))
        except (TypeError, ValueError, OverflowError):
            updated_at = 0.0
        public_mode = str(
            raw_state.get("public_mode", "nickname") or "nickname"
        ).casefold()
        result[battle_id] = {
            "state": state,
            "rank": rank,
            "encounter_id": str(raw_state.get("encounter_id", "") or "")[:64],
            "upload_id": str(raw_state.get("upload_id", "") or "")[:64],
            "message": str(raw_state.get("message", "") or "")[:240],
            "upload_status": str(raw_state.get("upload_status", "") or "")[:24],
            "statistics_status": str(
                raw_state.get("statistics_status", "") or ""
            )[:24],
            "ranking_status": str(raw_state.get("ranking_status", "") or "")[:24],
            "validation_reasons": [
                str(reason).strip()[:48]
                for reason in raw_state.get("validation_reasons", [])[:16]
                if str(reason).strip()
            ]
            if isinstance(raw_state.get("validation_reasons"), list)
            else [],
            "public_mode": (
                public_mode
                if public_mode in {"anonymous", "nickname", "character"}
                else "anonymous"
            ),
            "updated_at": updated_at,
        }
        if isinstance(raw_state.get("detail_signature"), str):
            result[battle_id]["detail_signature"] = raw_state["detail_signature"][:64]
    return result


def combat_upload_status_text(value: object) -> str:
    state = value if isinstance(value, dict) else {}
    status = str(state.get("state", "pending") or "pending").casefold()
    if status in {"uploaded", "included", "ranked", "ineligible"}:
        return "已上传"
    return {
        "uploading": "上传中",
        "failed": "上传失败",
    }.get(status, "未上传")


