    def _apply_lock_toggle_hotkey_enabled_setting(self, *_args) -> None:
        variable = getattr(self, "settings_lock_toggle_hotkey_enabled_var", None)
        if variable is None or getattr(self, "unlock_hotkey_enabled_syncing", False):
            return
        self._set_lock_toggle_hotkey_enabled(bool(variable.get()))

    def _sync_unlock_hotkey_controls(self) -> None:
        variable = getattr(self, "settings_unlock_hotkey_enabled_var", None)
        lock_toggle_variable = getattr(
            self, "settings_lock_toggle_hotkey_enabled_var", None
        )
        if variable is not None or lock_toggle_variable is not None:
            try:
                self.unlock_hotkey_enabled_syncing = True
                if variable is not None:
                    variable.set(bool(getattr(self, "unlock_hotkey_enabled", False)))
                if lock_toggle_variable is not None:
                    lock_toggle_variable.set(bool(getattr(self, "lock_toggle_hotkey_enabled", False)))
            except tk.TclError:
                pass
            finally:
                self.unlock_hotkey_enabled_syncing = False
        label = getattr(self, "settings_unlock_hotkey_value_label", None)
        if label is not None and label.winfo_exists():
            label.configure(
                text=("请按下快捷键…" if getattr(self, "unlock_hotkey_capture_active", False)
                      else getattr(self, "unlock_hotkey", "") or "未设置"),
                fg=ACCENT if (
                    getattr(self, "unlock_hotkey_enabled", False)
                    or getattr(self, "lock_toggle_hotkey_enabled", False)
                ) else MUTED,
            )
        status = getattr(self, "settings_unlock_hotkey_status_label", None)
        if status is not None and status.winfo_exists():
            status.configure(text=getattr(self, "unlock_hotkey_error", ""))

    def _begin_unlock_hotkey_capture(self, _event=None) -> str:
        if self.closing:
            return "break"
        self.unlock_hotkey_capture_active = True
        self.unlock_hotkey_capture_modifiers.clear()
        self._sync_unlock_hotkey_controls()
        label = getattr(self, "settings_unlock_hotkey_value_label", None)
        if label is not None and label.winfo_exists():
            label.focus_set()
        return "break"

    def _cancel_unlock_hotkey_capture(self, _event=None) -> None:
        if getattr(self, "unlock_hotkey_capture_active", False):
            self.unlock_hotkey_capture_active = False
            self.unlock_hotkey_capture_modifiers.clear()
            self._sync_unlock_hotkey_controls()

    def _capture_unlock_hotkey_key(self, event) -> str | None:
        if not getattr(self, "unlock_hotkey_capture_active", False):
            return None
        keysym = str(getattr(event, "keysym", "") or "")
        if keysym.casefold() == "escape":
            self._cancel_unlock_hotkey_capture()
            return "break"
        modifier = {
            "control_l": "Ctrl", "control_r": "Ctrl", "alt_l": "Alt",
            "alt_r": "Alt", "shift_l": "Shift", "shift_r": "Shift",
        }.get(keysym.casefold())
        if modifier:
            self.unlock_hotkey_capture_modifiers.add(modifier)
            return "break"
        try:
            state = int(getattr(event, "state", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            state = 0
        for held in self.unlock_hotkey_capture_modifiers:
            state |= {"Ctrl": 0x0004, "Alt": 0x0008, "Shift": 0x0001}[held]
        candidate = toggle_hotkey_from_tk_event(keysym, state)
        if not candidate:
            self.unlock_hotkey_error = "单键请使用 Home、F1-F12 等功能键"
            self._sync_unlock_hotkey_controls()
            return "break"
        if not self._set_native_unlock_hotkey(candidate):
            self.unlock_hotkey_error = "快捷键已被占用，请重试"
            self._sync_unlock_hotkey_controls()
            return "break"
        self.unlock_hotkey = candidate
        self.unlock_hotkey_enabled = bool(
            self.unlock_hotkey_enabled
            or not getattr(self, "lock_toggle_hotkey_enabled", False)
        )
        self.unlock_hotkey_registered = True
        self.unlock_hotkey_error = ""
        self.config[UNLOCK_HOTKEY_CONFIG_KEY] = candidate
        self.config[UNLOCK_HOTKEY_ENABLED_CONFIG_KEY] = self.unlock_hotkey_enabled
        self._cancel_unlock_hotkey_capture()
        save_config(self.config)
        if getattr(self, "window_locked", False):
            self._apply_window_lock_state()
        return "break"

    def _clear_unlock_hotkey(self) -> None:
        if not self._set_native_unlock_hotkey(""):
            self.unlock_hotkey_error = "无法停用解锁键，请重试"
            self._sync_unlock_hotkey_controls()
            return
        self.unlock_hotkey = ""
        self.unlock_hotkey_enabled = False
        self.lock_toggle_hotkey_enabled = False
        self.unlock_hotkey_registered = False
        self.unlock_hotkey_error = ""
        self._cancel_unlock_hotkey_capture()
        self.config[UNLOCK_HOTKEY_CONFIG_KEY] = ""
        self.config[UNLOCK_HOTKEY_ENABLED_CONFIG_KEY] = False
        self.config[LOCK_TOGGLE_HOTKEY_ENABLED_CONFIG_KEY] = False
        save_config(self.config)
        self._sync_unlock_hotkey_controls()
        if getattr(self, "window_locked", False):
            self._apply_window_lock_state()

