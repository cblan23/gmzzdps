    def _history_filter_payload(self) -> dict[str, object]:
        filters: dict[str, object] = {"boss_only": True}
        if not bool(getattr(self, "history_show_incomplete", False)):
            filters["completeness_rank"] = COMPLETENESS_COMPLETE_RANK
        time_value = (
            self.history_filter_time_var.get()
            if self.history_filter_time_var is not None
            else "近30天"
        )
        now = dt.datetime.now().astimezone()
        today = now.replace(hour=0, minute=0, second=0, microsecond=0)
        if time_value == "今天":
            filters["start_epoch"] = today.timestamp()
        elif time_value == "近3天":
            filters["start_epoch"] = (today - dt.timedelta(days=2)).timestamp()
        elif time_value == "近7天":
            filters["start_epoch"] = (today - dt.timedelta(days=6)).timestamp()
        elif time_value == "近30天":
            filters["start_epoch"] = (today - dt.timedelta(days=29)).timestamp()
        elif time_value == "近90天":
            filters["start_epoch"] = (today - dt.timedelta(days=89)).timestamp()
        filters["query"] = self._history_filter_value("query")

        if self.history_filter_dungeon_var is not None:
            selected_dungeon = self.history_filter_dungeon_var.get()
            if selected_dungeon != "全部":
                dungeon = selected_dungeon
                filters["dungeon"] = dungeon
                filters["dungeon_aliases"] = list(
                    HISTORY_DUNGEON_ALIASES.get(dungeon, (dungeon,))
                )
                filters["dungeon_bosses"] = list(
                    HISTORY_DUNGEON_BOSSES.get(dungeon, ())
                )
                if dungeon == "木桩":
                    filters["boss_only"] = False
        if self.history_filter_boss_var is not None:
            selected_boss = self.history_filter_boss_var.get()
            if selected_boss != "全部":
                boss = selected_boss
                filters["boss"] = boss
                filters["boss_aliases"] = list(
                    HISTORY_BOSS_ALIASES.get(boss, (boss,))
                )
        result_map = {
            "胜利": (RESULT_DEFEATED,),
            "失败": "failed",
            "中断": (RESULT_INTERRUPTED, RESULT_UNDETERMINED),
        }
        if self.history_filter_result_var is not None:
            result = result_map.get(self.history_filter_result_var.get())
            if result:
                if isinstance(result, tuple):
                    filters["results"] = list(result)
                else:
                    filters["result"] = result
        return filters

