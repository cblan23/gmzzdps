        pvp = (
            getattr(self, "backend_current_page", "history") == "kings"
            or getattr(self, "history_data_domain", "pve") == "pvp"
        )
        if pvp:
            copy = {
                "total": (
                    "己方总治疗" if healing_mode
                    else "己方总承伤" if taken_mode
                    else "己方总伤害",
                    "本场已记录数据",
                ),
                "rate": (
                    "敌方总治疗" if healing_mode
                    else "敌方总承伤" if taken_mode
                    else "敌方总伤害",
                    "本场已记录数据",
                ),
                "mine": ("己方 / 敌方平均评分", "仅统计已取得评分的真人玩家"),
                "team": ("战斗结果", "本场比赛结果"),
                "duration": ("战斗时长", "本场记录用时"),
            }
        elif boss_mode:
            copy = {
                "total": ("已归类首领伤害", "已确认来源的精确伤害"),
                "rate": ("归类比例", "已归类伤害 / 团队总承伤"),
                "mine": ("队伍平均非凡评分", "仅统计真人玩家"),
                "team": ("团队总承伤", "用于核对归类范围"),
                "duration": ("战斗时长", "完整遭遇用时"),
            }
        else:
            copy = {
                "total": (
                    "总有效治疗" if healing_mode else "团队总承伤" if taken_mode else "总伤害",
                    "团队结算有效量" if healing_mode else "队伍累计承受" if taken_mode else "团队结算累计",
                ),
                "rate": (
                    "团队 HPS" if healing_mode else "最高承伤占比" if taken_mode else "团队 DPS",
                    "统一治疗时长" if healing_mode else "队内最高占比" if taken_mode else "统一战斗时长",
                ),
                "mine": (
                    "队伍平均非凡评分",
                    "仅统计真人玩家",
                ),
                "team": (
                    "战斗结果" if detail_page else "参战队伍",
                    "本场结算状态" if detail_page else "有效统计成员",
                ),
                "duration": ("战斗时长", "完整遭遇用时"),
            }
        labels = {
            "total": getattr(self, "history_total_value", None),
            "rate": getattr(self, "history_dps_value", None),
            "mine": getattr(self, "history_my_value", None),
            "team": getattr(self, "history_team_value", None),
            "duration": getattr(self, "history_duration_value", None),
        }
        for key, label in labels.items():
            if label is None:
                continue
            caption, subtitle = copy[key]
            if (
                key == "mine"
                and detail_page
                and (getattr(self, "history_detail_metrics_layout_state", None) or (False,))[0]
            ):
                caption = "平均评分"
            caption_label = getattr(label, "_caption_label", None)
            subtitle_label = getattr(label, "_subtitle_label", None)
            if caption_label is not None:
                caption_label.configure(text=caption)
            if subtitle_label is not None:
                subtitle_label.configure(text=subtitle)

    def _update_history_team_average_rating(
        self, record: dict | None
    ) -> None:
        label = getattr(self, "history_my_value", None)
        if label is None:
            return
        participants = (
            record.get("participants", []) if isinstance(record, dict) else []
        )
        if (
            isinstance(record, dict)
            and str(record.get("combat_mode", "")).casefold() == "pvp"
        ):
            ally = normalize_extraordinary_rating(
                record.get("pvp_ally_average_rating")
            )
            enemy = normalize_extraordinary_rating(
                record.get("pvp_enemy_average_rating")
            )
            label.configure(
                text=(
                    f"{format_extraordinary_rating(ally)} / "
                    f"{format_extraordinary_rating(enemy)}"
                )
            )
            caption_label = getattr(label, "_caption_label", None)
            if caption_label is not None:
                caption_label.configure(text="己方 / 敌方平均评分")
            subtitle_label = getattr(label, "_subtitle_label", None)
            if subtitle_label is not None:
                subtitle_label.configure(text="仅统计已取得评分的真人玩家")
            return
        average, rated_count, team_size = team_average_extraordinary_rating(
            participants
        )
        label.configure(text=format_extraordinary_rating(average))
        subtitle_label = getattr(label, "_subtitle_label", None)
        if subtitle_label is not None:
            subtitle_label.configure(
                text=(
                    f"真人评分 {rated_count} / {team_size} 人"
                    if team_size
                    else "本场无真人评分"
                )
            )

    def _history_profession_icon(
        self, class_id: int | None, size: int = 34
    ) -> ImageTk.PhotoImage:
        """Use the same coloured profession crest as the main DPS window."""

        main_profession = getattr(self.icons, "main_profession", None)
        if callable(main_profession):
            return main_profession(class_id, size)
        return self.icons.profession(class_id, size)

    def _draw_history_detail_hero(self) -> None:
        canvas = getattr(self, "history_detail_hero_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        summary = self._selected_history_summary()
        summary = summary if isinstance(summary, dict) else {}
        record = record if isinstance(record, dict) else {}
        pvp_record = str(record.get("combat_mode", "")).casefold() == "pvp"
        dungeon_name = str(summary.get("dungeon_name", "")).strip() or "未知副本"
        difficulty = (
            str(summary.get("difficulty") or record.get("difficulty") or "").strip()
            or "难度未知"
        )
        boss_name = (
            self._history_encounter_title(summary) if summary else ""
        )
        monster = record.get("monster")
        monster = monster if isinstance(monster, dict) else {}
        boss_name = boss_name or str(monster.get("name", "")).strip() or "Boss 战斗"
        backdrop = self.icons.history_hero(dungeon_name, width, height)
        canvas.create_image(0, 0, image=backdrop, anchor="nw")
        canvas._history_hero_image = backdrop

        # Keep the luminous edge in Tk; the source art remains readable and
        # fallback dungeons still share the same framing language.
        canvas.create_rectangle(0, 0, 4, height, fill=ACCENT, outline="")
        canvas.create_line(4, 0, 4, height, fill="#baf9e7", width=1)

        tag_y = 28
        tag_width = min(230, max(86, self._ui_font("micro").measure(dungeon_name) + 22))
        canvas.create_rectangle(
            28, tag_y, 28 + tag_width, tag_y + 24,
            fill="#183b33", outline="#438c77"
        )
        canvas.create_text(
            39, tag_y + 12, text=dungeon_name, fill="#d9f8ee",
            anchor="w", font=self._ui_font("micro")
        )
