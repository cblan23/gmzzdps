    def _draw_history_detail_trend(self) -> None:
        canvas = getattr(self, "history_detail_trend_canvas", None)
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        mode = getattr(self, "history_meter_mode", "dps")
        title_label = getattr(self, "history_detail_trend_title_label", None)
        peak_label = getattr(self, "history_detail_trend_peak_label", None)
        hint_label = getattr(self, "history_detail_trend_hint_label", None)
        if mode != "dps":
            self.history_detail_trend_plot_bounds = None
            if mode == "boss_damage":
                label = "首领伤害"
                empty_title = "首领伤害使用独立的精确事件时间轴"
                empty_detail = "继续向下查看技能命中与队员死亡时间对照"
                hint = "下方查看真实事件"
                peak = "精确事件"
            else:
                label = "治疗 HPS" if mode == "hps" else "承伤 DT"
                empty_title = f"{label} 当前仅提供结算汇总"
                empty_detail = "切换至伤害 DPS 可查看团队战斗时间轴"
                hint = "当前模式暂无逐秒数据"
                peak = "结算数据"
            if title_label is not None:
                title_label.configure(text=f"团队{label}汇总")
            if peak_label is not None:
                peak_label.configure(text=peak, fg=MUTED)
            if hint_label is not None:
                hint_label.configure(text=hint)
            canvas.create_text(
                width // 2,
                height // 2 - 7,
                text=empty_title,
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text=empty_detail,
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            return

        parsed = self._history_snapshot_team_dps_points()
        if title_label is not None:
            title_label.configure(text="团队 DPS 时间轴")
        if not parsed:
            self.history_detail_trend_plot_bounds = None
            if peak_label is not None:
                peak_label.configure(text="暂无数据", fg=MUTED)
            if hint_label is not None:
                hint_label.configure(text="")
            canvas.create_text(
                width // 2,
                height // 2 - 7,
                text="暂无团队趋势数据",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 15,
                text="这场记录仅保存了结算汇总",
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            return

        trend_source = getattr(self, "history_trend_source", "settlement_average")
        settlement_average = trend_source == "settlement_average"
        summary_team_dps = trend_source == "team_dps"
        observed_boss_hp = trend_source == "observed_boss_hp_loss"
        if settlement_average:
            self.history_detail_trend_plot_bounds = None
            if title_label is not None:
                title_label.configure(text="团队 DPS（仅结算汇总）")
            if hint_label is not None:
                hint_label.configure(text="没有保存可靠的逐秒数据")
            if peak_label is not None:
                peak_label.configure(text="结算值", fg=MUTED)
            canvas.create_text(
                width // 2, height // 2 - 7,
                text="暂无可靠的团队 DPS 时间序列",
                fill=MUTED, font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2, height // 2 + 15,
                text="这场只保存了结算汇总，不绘制推测曲线",
                fill=SUBTLE, font=self._ui_font("micro"),
            )
            return
        if title_label is not None:
            title_label.configure(
                text="团队 DPS · Boss 血量观测" if observed_boss_hp
                else "团队 DPS" if settlement_average or summary_team_dps
                else "团队 DPS 时间轴"
            )
        if hint_label is not None:
            hint_label.configure(
                text="团队总 DPS" if settlement_average or summary_team_dps
                else "Boss 血量观测 · 点击锁定" if observed_boss_hp
                else "移动查看 · 点击锁定"
            )

        left, top, right, bottom = 45, 10, width - 12, height - 24
        if right <= left or bottom <= top:
            self.history_detail_trend_plot_bounds = None
            return
        max_time = max(1.0, max(point[0] for point in parsed))
        peak = max(1.0, max(point[1] for point in parsed))
        chart_max = peak * 1.16 if not settlement_average else peak * 1.22
        self.history_detail_trend_plot_bounds = (
            None if settlement_average else (left, right, max_time)
        )

        for fraction in (0.0, 0.5, 1.0):
            y = bottom - int((bottom - top) * fraction)
            canvas.create_line(left, y, right, y, fill=BORDER, dash=(2, 4))
            canvas.create_text(
                left - 7,
                y,
                text=format_number(chart_max * fraction),
                fill=SUBTLE,
                anchor="e",
                font=self._ui_font("micro"),
            )

        coordinates: list[float] = []
        for second, dps in parsed:
            coordinates.extend(
                (
                    left + (right - left) * second / max_time,
                    bottom - (bottom - top) * dps / chart_max,
                )
            )
        if len(coordinates) >= 4:
            if not settlement_average:
                canvas.create_polygon(
                    left,
                    bottom,
                    *coordinates,
                    right,
                    bottom,
                    fill=blend_color(SURFACE, ACCENT, 0.10),
                    outline="",
                )
            canvas.create_line(
                *coordinates,
                fill=MUTED if settlement_average else ACCENT,
                width=2,
                smooth=False,
                dash=(5, 4) if settlement_average else (),
                tags=("history-team-line",),
            )

        for index, fraction in enumerate((0.0, 0.25, 0.5, 0.75, 1.0)):
            x = left + (right - left) * fraction
            canvas.create_line(x, bottom, x, bottom + 3, fill="#46525b")
            canvas.create_text(
                x,
                height - 8,
                text=format_duration(max_time * fraction),
                fill=SUBTLE,
                anchor="w" if index == 0 else "e" if index == 4 else "center",
                font=self._ui_font("micro"),
            )

        active_time = None if settlement_average else (
            self.history_detail_trend_hover_time
            if self.history_detail_trend_hover_time is not None
            else self.history_detail_trend_selected_time
        )
        active_point = (
            min(parsed, key=lambda point: abs(point[0] - active_time))
            if active_time is not None
            else None
        )
        if active_point is not None:
            second, dps = active_point
            marker_x = left + (right - left) * second / max_time
            marker_y = bottom - (bottom - top) * dps / chart_max
            locked = self.history_detail_trend_hover_time is None
            marker_color = "#e7f7f1" if locked else ACCENT
            canvas.create_line(
                marker_x,
                top,
                marker_x,
                bottom,
                fill=blend_color(SURFACE, marker_color, 0.72),
                dash=() if locked else (3, 3),
            )
            canvas.create_oval(
                marker_x - 4,
                marker_y - 4,
                marker_x + 4,
                marker_y + 4,
                fill=marker_color,
                outline=SURFACE,
            )
            tooltip_width, tooltip_height = 144, 43
            tooltip_left = int(marker_x + 8)
            if tooltip_left + tooltip_width > right:
                tooltip_left = int(marker_x - tooltip_width - 8)
            tooltip_left = max(left, min(right - tooltip_width, tooltip_left))
            tooltip_top = int(marker_y - tooltip_height - 8)
            if tooltip_top < top:
                tooltip_top = int(marker_y + 8)
            tooltip_top = min(bottom - tooltip_height, max(top, tooltip_top))
            tooltip_right = tooltip_left + tooltip_width
            tooltip_bottom = tooltip_top + tooltip_height
            cut = 5
            canvas.create_polygon(
                tooltip_left + cut,
                tooltip_top,
                tooltip_right,
                tooltip_top,
                tooltip_right,
                tooltip_bottom - cut,
                tooltip_right - cut,
                tooltip_bottom,
                tooltip_left,
                tooltip_bottom,
                tooltip_left,
                tooltip_top + cut,
                fill="#11191b",
                outline=blend_color(BORDER, ACCENT, 0.62),
            )
            canvas.create_text(
                tooltip_left + 9,
                tooltip_top + 12,
                text=f"战斗时间  {format_duration(second)}",
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
            )
            canvas.create_text(
                tooltip_left + 9,
                tooltip_top + 30,
                text=f"团队 DPS  {format_number(dps)}",
                fill=ACCENT,
                anchor="w",
                font=self._ui_font("micro"),
            )

        if peak_label is not None:
            peak_label.configure(fg=ACCENT)
            if settlement_average:
                peak_label.configure(text=f"团队 DPS {format_number(peak)}")
            elif active_point is not None:
                peak_label.configure(
                    text=(
                        f"{format_duration(active_point[0])} · "
                        f"{format_number(active_point[1])} DPS"
                    )
                )
            else:
                peak_label.configure(text=f"团队峰值 {format_number(peak)} DPS")

    def _draw_history_snapshot_trend(self) -> None:
        canvas = getattr(self, "history_snapshot_trend_canvas", None)
        if canvas is None:
            return
        if getattr(self, "backend_current_page", "history") == "kings":
            self._draw_pvp_history_snapshot()
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        mode = getattr(self, "history_meter_mode", "dps")
        if mode != "dps":
            self.history_trend_plot_bounds = None
            if mode == "boss_damage":
                label = "首领伤害"
                detail = "打开战斗详情可查看真实攻击事件时间轴"
                peak = "精确事件"
            else:
                label = "HPS" if mode == "hps" else "DT"
                detail = "暂不提供逐秒趋势"
                peak = "结算数据"
            canvas.create_text(
                width // 2,
                height // 2 - 6,
                text=f"{label} 当前显示结算汇总",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 14,
                text=detail,
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            if getattr(self, "history_snapshot_peak_label", None) is not None:
                self.history_snapshot_peak_label.configure(text=peak)
            return

        parsed = self._history_snapshot_team_dps_points()
        participant_series = (
            self._history_snapshot_participant_dps_points()
            if getattr(self, "history_trend_source", "") != "settlement_average"
            else {}
        )
        if not parsed:
            self.history_trend_plot_bounds = None
            canvas.create_text(
                width // 2,
                height // 2 - 6,
                text="暂无团队趋势数据",
                fill=MUTED,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2,
                height // 2 + 14,
                text="该记录只保存了结算汇总，没有可靠的时间序列",
                fill=SUBTLE,
                font=self._ui_font("micro"),
            )
            if getattr(self, "history_snapshot_peak_label", None) is not None:
                self.history_snapshot_peak_label.configure(text="团队 · 10 秒滑动")
            return

        trend_source = getattr(
            self, "history_trend_source", "settlement_average"
        )
        settlement_average = trend_source == "settlement_average"
        summary_team_dps = trend_source == "team_dps"
        observed_boss_hp = trend_source == "observed_boss_hp_loss"
        # A settlement-average team line is not a time series.  Do not mix an
        # event-derived local curve into that fallback, which would imply the
        # flat team line was observed during combat.
        if settlement_average:
            participant_series = {}
            self.history_trend_plot_bounds = None
            if self.history_snapshot_trend_title_label is not None:
                self.history_snapshot_trend_title_label.configure(text="团队 DPS（仅结算汇总）")
            if getattr(self, "history_snapshot_peak_label", None) is not None:
                self.history_snapshot_peak_label.configure(text="结算值")
            canvas.create_text(
                width // 2, height // 2 - 6,
                text="暂无可靠的团队 DPS 时间序列",
                fill=MUTED, font=self._ui_font("strong"),
            )
            canvas.create_text(
                width // 2, height // 2 + 14,
                text="这场只保存了结算汇总，不绘制推测曲线",
                fill=SUBTLE, font=self._ui_font("micro"),
            )
            return
        if self.history_snapshot_trend_title_label is not None:
            scope = getattr(self, "history_participant_trend_scope", "team_only")
            self.history_snapshot_trend_title_label.configure(
                text=(
                    "团队 DPS"
                    if settlement_average or summary_team_dps
                    else "全员 + 团队 DPS"
                    if scope == "all_players"
                    else "团队 + 本机 DPS"
                    if scope == "team_and_self"
                    else "仅团队 DPS 趋势"
                ) + (" · Boss 血量观测" if observed_boss_hp else "")
            )

        left, top, right, bottom = 10, 10, width - 9, height - 24
        if right <= left or bottom <= top:
            self.history_trend_plot_bounds = None
            return
        max_time = max(
            1.0,
            max(value[0] for value in parsed),
            max(
                (
                    point[0]
                    for series in participant_series.values()
                    for point in series
                ),
                default=0.0,
            ),
        )
        peak = max(
            1.0,
            max(value[1] for value in parsed),
            max(
                (
                    point[1]
                    for series in participant_series.values()
                    for point in series
                ),
                default=0.0,
            ),
        )
        chart_max = peak * 1.25 if settlement_average else peak
        self.history_trend_plot_bounds = (
            None if settlement_average else (left, right, max_time)
        )

        for fraction in (0.25, 0.5, 0.75):
            y = top + int((bottom - top) * fraction)
            canvas.create_line(left, y, right, y, fill=BORDER, dash=(2, 3))
        canvas.create_line(left, bottom, right, bottom, fill="#354049")

        coordinates: list[float] = []
        for second, dps in parsed:
            coordinates.extend(
                [
                    left + (right - left) * second / max_time,
                    bottom - (bottom - top) * dps / chart_max,
                ]
            )
        if len(coordinates) >= 4:
            if not settlement_average:
                area = [left, bottom, *coordinates, right, bottom]
                canvas.create_polygon(
                    *area,
                    fill=blend_color(SURFACE, ACCENT, 0.08),
                    outline="",
                )
            canvas.create_line(
                *coordinates,
                fill=MUTED if settlement_average else ACCENT,
                width=3,
                smooth=False,
                dash=(5, 4) if settlement_average else (),
                tags=("history-team-line",),
            )

        record = self._selected_history_record()
        participant_rows = (
            record.get("participants", []) if isinstance(record, dict) else []
        )
        participant_by_id = {
            int(row.get("actor_id", 0) or 0): row
            for row in participant_rows
            if isinstance(row, dict) and int(row.get("actor_id", 0) or 0) > 0
        }
        series_colors = (
            "#b990e9", "#6dbce7", "#efc46d", "#df7485", "#82a9d7",
            "#91d27f", "#d497e8", "#7ecfc6", "#e5986e", "#91a6cc",
            "#d7cc75", "#a3aeb8",
        )
        ordered_series = sorted(
            participant_series.items(),
            key=lambda item: max((point[1] for point in item[1]), default=0.0),
            reverse=True,
        )[:MAX_PARTY_MEMBERS]
        fallback_color_by_actor = {
            actor_id: series_colors[index % len(series_colors)]
            for index, (actor_id, _series) in enumerate(ordered_series)
        }
        color_by_actor: dict[int, str] = {}
        for actor_id, series in ordered_series:
            player_coordinates: list[float] = []
            for second, dps in series:
                player_coordinates.extend(
                    [
                        left + (right - left) * second / max_time,
                        bottom - (bottom - top) * dps / chart_max,
                    ]
                )
            if len(player_coordinates) < 4:
                continue
            row = participant_by_id.get(actor_id, {})
            class_id = int(row.get("profession_id", 0) or 0)
            profession_color = PROFESSION_COLORS.get(class_id)
            color = profession_color or fallback_color_by_actor[actor_id]
            color_by_actor[actor_id] = color
            canvas.create_line(
                *player_coordinates,
                fill=color,
                width=1,
                smooth=False,
                tags=("history-player-line",),
            )
        canvas.tag_raise("history-team-line")

        for index, fraction in enumerate((0.0, 0.25, 0.5, 0.75, 1.0)):
            x = left + (right - left) * fraction
            canvas.create_line(x, bottom, x, bottom + 3, fill="#46525b")
            canvas.create_text(
                x,
                height - 8,
                text=format_duration(max_time * fraction),
                fill=SUBTLE,
                anchor="w" if index == 0 else "e" if index == 4 else "center",
                font=self._ui_font("micro"),
            )

        active_time = None if settlement_average else (
            self.history_trend_hover_time
            if self.history_trend_hover_time is not None
            else self.history_trend_selected_time
        )
        active_point: tuple[float, float] | None = None
        if active_time is not None:
            active_point = min(parsed, key=lambda value: abs(value[0] - active_time))
        if active_point is not None:
            second, dps = active_point
            marker_x = left + (right - left) * second / max_time
            marker_y = bottom - (bottom - top) * dps / chart_max
            locked = self.history_trend_hover_time is None
            marker_color = "#e7f7f1" if locked else ACCENT
            canvas.create_line(
                marker_x,
                top,
                marker_x,
                bottom,
                fill=blend_color(SURFACE, marker_color, 0.7),
                dash=() if locked else (3, 3),
                width=1,
            )
            canvas.create_oval(
                marker_x - 6,
                marker_y - 6,
                marker_x + 6,
                marker_y + 6,
                fill=blend_color(SURFACE, marker_color, 0.22),
                outline="",
            )
            canvas.create_oval(
                marker_x - 3,
                marker_y - 3,
                marker_x + 3,
                marker_y + 3,
                fill=marker_color,
                outline=SURFACE,
            )

            snapshot_rows: list[tuple[str, float, str]] = []
            for series_index, (actor_id, series) in enumerate(ordered_series):
                if not series:
                    continue
                point = min(series, key=lambda value: abs(value[0] - second))
                row = participant_by_id.get(actor_id, {})
                name = self._history_actor_name(
                    row, series_index, self._history_names_hidden()
                ) if row else f"玩家{series_index + 1}"
                color = color_by_actor.get(
                    actor_id,
                    fallback_color_by_actor.get(
                        actor_id, series_colors[series_index % len(series_colors)]
                    ),
                )
                snapshot_rows.append((name, point[1], color))
            snapshot_rows.sort(key=lambda value: value[1], reverse=True)
            if snapshot_rows:
                canvas.delete("history-trend-tooltip")
                tooltip_width = min(max(190, width - 24), 320)
                visible_rows = snapshot_rows[:MAX_PARTY_MEMBERS]
                column_count = 2 if len(visible_rows) > 6 and tooltip_width >= 250 else 1
                rows_per_column = max(
                    1, (len(visible_rows) + column_count - 1) // column_count
                )
                tooltip_height = 42 + rows_per_column * 17
                tooltip_left = int(marker_x + 8)
                if tooltip_left + tooltip_width > right:
                    tooltip_left = int(marker_x - tooltip_width - 8)
                tooltip_left = max(left, min(right - tooltip_width, tooltip_left))
                tooltip_top = max(top, min(bottom - tooltip_height, int(marker_y - tooltip_height / 2)))
                canvas.create_rectangle(
                    tooltip_left, tooltip_top,
                    tooltip_left + tooltip_width, tooltip_top + tooltip_height,
                    fill="#11191b", outline="#725f37",
                    tags=("history-trend-tooltip",)
                )
                canvas.create_text(
                    tooltip_left + 9, tooltip_top + 10,
                    text=f"{format_duration(second)}  ·  团队 {format_number(dps)} DPS",
                    fill=WARN, anchor="nw", font=self._ui_font("micro"),
                    tags=("history-trend-tooltip",)
                )
                content_width = tooltip_width - 18
                column_width = content_width / column_count
                for row_index, (name, value, color) in enumerate(visible_rows):
                    column = row_index // rows_per_column
                    row_in_column = row_index % rows_per_column
                    column_left = tooltip_left + 9 + column * column_width
                    column_right = tooltip_left + 9 + (column + 1) * column_width
                    y = tooltip_top + 31 + row_in_column * 17
                    canvas.create_rectangle(
                        column_left, y - 3, column_left + 7, y + 4,
                        fill=color, outline="", tags=("history-trend-tooltip",)
                    )
                    canvas.create_text(
                        column_left + 13,
                        y,
                        text=self._fit_ui_text(
                            name, max(32, int(column_width) - 64), "micro"
                        ),
                        fill=MUTED, anchor="w", font=self._ui_font("micro"),
                        tags=("history-trend-tooltip",)
                    )
                    canvas.create_text(
                        column_right - 5, y,
                        text=format_number(value), fill=TEXT, anchor="e",
                        font=self._ui_font("number_small"),
                        tags=("history-trend-tooltip",)
                    )
                canvas.tag_raise("history-trend-tooltip")
            else:
                tooltip_width, tooltip_height = 150, 42
                tooltip_left = int(marker_x + 8)
                if tooltip_left + tooltip_width > right:
                    tooltip_left = int(marker_x - tooltip_width - 8)
                tooltip_left = max(left, min(right - tooltip_width, tooltip_left))
                tooltip_top = max(top, min(bottom - tooltip_height, int(marker_y - tooltip_height - 9)))
                canvas.create_rectangle(
                    tooltip_left, tooltip_top,
                    tooltip_left + tooltip_width, tooltip_top + tooltip_height,
                    fill="#11191b", outline=blend_color(BORDER, ACCENT, 0.55)
                )
                canvas.create_text(
                    tooltip_left + 9, tooltip_top + 12,
                    text=f"时间  {format_duration(second)}", fill=MUTED,
                    anchor="w", font=self._ui_font("micro")
                )
                canvas.create_text(
                    tooltip_left + 9, tooltip_top + 29,
                    text=f"团队综合 DPS  {format_number(dps)}", fill=ACCENT,
                    anchor="w", font=self._ui_font("micro")
                )

        peak_label = getattr(self, "history_snapshot_peak_label", None)
        if peak_label is not None:
            if settlement_average or summary_team_dps:
                peak_label.configure(
                    text=f"团队 DPS {self._history_optional_number(peak)}"
                )
            elif active_point is not None:
                peak_label.configure(
                    text=(
                        f"{format_duration(active_point[0])} · "
                        f"{format_number(active_point[1])} DPS"
                    )
                )
            else:
                scope = getattr(self, "history_participant_trend_scope", "team_only")
                peak_label.configure(
                    text=(
                        "Boss 血量观测 · 10 秒滑动"
                        if observed_boss_hp
                        else "全员 + 团队 · 10 秒滑动"
                        if scope == "all_players"
                        else "团队 + 本机 · 数据范围"
