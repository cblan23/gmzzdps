    def _build_settings_hotkey_row(self, parent, text, variable, on_clear, help_text):
        row = tk.Frame(parent, bg=PANEL)
        row.pack(fill='x', padx=8, pady=(12, 0))
        tk.Frame(row, bg=BORDER, height=1).pack(side='bottom', fill='x')
        control = ModernCheckControl(row, text, variable, font=self._ui_font('settings'),
                                     background=PANEL, foreground=TEXT,
                                     help_text=help_text, help_font=self._ui_font('small'))
        control.pack(side='left', fill='both', expand=True, pady=(8, 7))
        actions = tk.Frame(row, bg=PANEL)
        actions.pack(side='right', pady=(10, 11))
        button = self._label_button(actions, '清除', on_clear, width=58,
                                    bg=PANEL, hover=PANEL_2, fg=MUTED, font=self._ui_font('settings'))
        button.pack(side='right', fill='y', padx=(8, 0))
        label = tk.Label(actions, text='', width=22, bg=PANEL_2, fg=ACCENT,
                         highlightthickness=1, highlightbackground=BORDER, highlightcolor=ACCENT,
                         cursor='hand2', takefocus=True, font=self._ui_font('settings_strong'))
        label.pack(side='right', fill='y')
        status = tk.Label(actions, text='', bg=PANEL, fg=ERROR, font=self._ui_font('small'))
        status.pack(side='right', padx=(0, 8))
        return label, status

    def _set_native_toggle_hotkey(self, hotkey: str) -> bool:
        tray_icon = getattr(self, "tray_icon", None)
        if not hotkey:
            if tray_icon is None:
                return True
            try:
                return bool(tray_icon.set_hotkey(0, 0))
            except (AttributeError, OSError, RuntimeError):
                return False
        parameters = toggle_hotkey_windows_parameters(hotkey)
        if tray_icon is None or parameters is None:
            return False
        try:
            return bool(tray_icon.set_hotkey(*parameters))
        except (AttributeError, OSError, RuntimeError):
            return False

    def _set_toggle_visibility_hotkey_enabled(
        self,
        enabled: bool,
        *,
        persist: bool = True,
    ) -> bool:
        desired = bool(enabled)
        previous_enabled = bool(
            getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        if desired:
            hotkey = self.toggle_visibility_hotkey or DEFAULT_TOGGLE_VISIBILITY_HOTKEY
            self.toggle_visibility_hotkey = hotkey
            if not self._set_native_toggle_hotkey(hotkey):
                self.toggle_visibility_hotkey_enabled = False
                self.toggle_hotkey_registered = False
                self.toggle_hotkey_error = (
                    f"{hotkey} 已被其他程序占用"
                    if getattr(self, "tray_icon", None) is not None
                    else "全局快捷键服务不可用"
                )
                self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = hotkey
                self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = False
                if persist:
                    save_config(self.config)
                self._sync_toggle_hotkey_controls()
                return False
            self.toggle_visibility_hotkey_enabled = True
            self.toggle_hotkey_registered = True
            self.toggle_hotkey_error = ""
        else:
            if not self._set_native_toggle_hotkey(""):
                self.toggle_visibility_hotkey_enabled = previous_enabled
                self.toggle_hotkey_error = "无法停用当前快捷键，请重试"
                self._sync_toggle_hotkey_controls()
                return False
            self.toggle_visibility_hotkey_enabled = False
            self.toggle_hotkey_registered = False
            self.toggle_hotkey_error = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = (
            self.toggle_visibility_hotkey
        )
        self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = (
            self.toggle_visibility_hotkey_enabled
        )
        if persist:
            save_config(self.config)
        self._sync_toggle_hotkey_controls()
        return True

    def _apply_toggle_hotkey_enabled_setting(self, *_args) -> None:
        variable = getattr(self, "settings_hotkey_enabled_var", None)
        if variable is None or getattr(
            self, "toggle_hotkey_enabled_syncing", False
        ):
            return
        try:
            enabled = bool(variable.get())
        except tk.TclError:
            return
        self._set_toggle_visibility_hotkey_enabled(enabled)

    def _register_configured_toggle_hotkey(self) -> bool:
        hotkey = getattr(self, "toggle_visibility_hotkey", "")
        enabled = bool(
            hotkey
            and getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        if not enabled:
            if not hotkey:
                self.toggle_visibility_hotkey_enabled = False
            unregistered = self._set_native_toggle_hotkey("")
            self.toggle_hotkey_registered = False
            self.toggle_hotkey_error = (
                "" if unregistered else "无法停用当前快捷键，请重试"
            )
            self._sync_toggle_hotkey_controls()
            return unregistered
        tray_available = getattr(self, "tray_icon", None) is not None
        registered = self._set_native_toggle_hotkey(hotkey)
        self.toggle_hotkey_registered = registered
        self.toggle_hotkey_error = (
            ""
            if registered
            else (
                f"{hotkey} 已被其他程序占用"
                if tray_available
                else "全局快捷键服务不可用"
            )
        )
        self._sync_toggle_hotkey_controls()
        return registered

    def _sync_toggle_hotkey_controls(
        self,
        status: str | None = None,
        *,
        error: bool = False,
    ) -> None:
        value_label = getattr(self, "settings_hotkey_value_label", None)
        status_label = getattr(self, "settings_hotkey_status_label", None)
        enabled_variable = getattr(self, "settings_hotkey_enabled_var", None)
        capturing = bool(getattr(self, "toggle_hotkey_capture_active", False))
        enabled = bool(
            getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        if enabled_variable is not None:
            try:
                if bool(enabled_variable.get()) != enabled:
                    self.toggle_hotkey_enabled_syncing = True
                    enabled_variable.set(enabled)
            except tk.TclError:
                pass
            finally:
                self.toggle_hotkey_enabled_syncing = False
        if status is None:
            status = getattr(self, "toggle_hotkey_error", "")
            error = bool(status)
        shown_status = str(status or "") if error else ""
        if value_label is not None and value_label.winfo_exists():
            value_label.configure(
                text=(
                    "录入中…"
                    if capturing
                    else (self.toggle_visibility_hotkey or "未设置")
                ),
                fg=(
                    WARN
                    if capturing
                    else (ACCENT if enabled else MUTED)
                ),
                highlightbackground=(
                    ERROR if shown_status else (ACCENT if capturing else BORDER)
                ),
            )
        if status_label is None or not status_label.winfo_exists():
            return
        status_label.configure(text=shown_status, fg=ERROR)

    def _begin_toggle_hotkey_capture(self, _event=None) -> str:
        if self.closing:
            return "break"
        if getattr(self, "toggle_hotkey_registered", False) and not (
            self._set_native_toggle_hotkey("")
        ):
            self._sync_toggle_hotkey_controls(
                "无法暂停当前快捷键，请重试", error=True
            )
            return "break"
        self.toggle_hotkey_registered = False
        self.toggle_hotkey_capture_active = True
        self.toggle_hotkey_capture_modifiers = set()
        self._sync_toggle_hotkey_controls()
        value_label = self.settings_hotkey_value_label
        if value_label is not None and value_label.winfo_exists():
            value_label.focus_set()
        return "break"

    def _capture_toggle_hotkey_key(self, event) -> str | None:
        if not getattr(self, "toggle_hotkey_capture_active", False):
            return None
        keysym = str(getattr(event, "keysym", "") or "")
        folded = keysym.casefold()
        if folded == "escape":
            self._cancel_toggle_hotkey_capture()
            return "break"
        modifier = ""
        if folded in {"control_l", "control_r"}:
            modifier = "Ctrl"
        elif folded in {"alt_l", "alt_r", "iso_level3_shift"}:
            modifier = "Alt"
        elif folded in {"shift_l", "shift_r"}:
            modifier = "Shift"
        if modifier:
            self.toggle_hotkey_capture_modifiers.add(modifier)
            return "break"

        try:
            state = int(getattr(event, "state", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            state = 0
        for held_modifier in self.toggle_hotkey_capture_modifiers:
            state |= {
                "Ctrl": 0x0004,
                "Alt": 0x0008,
                "Shift": 0x0001,
            }[held_modifier]
        candidate = toggle_hotkey_from_tk_event(keysym, state)
        if not candidate:
            self._sync_toggle_hotkey_controls(
                "单键请使用 Home、F1-F12 等功能键", error=True
            )
            return "break"

        previous_hotkey = self.toggle_visibility_hotkey
        enabled = bool(
            getattr(self, "toggle_visibility_hotkey_enabled", True)
        )
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        if enabled and not self._set_native_toggle_hotkey(candidate):
            restored = self._set_native_toggle_hotkey(previous_hotkey)
            self.toggle_hotkey_registered = bool(previous_hotkey and restored)
            self.toggle_visibility_hotkey_enabled = bool(
                self.toggle_hotkey_registered
            )
            self.toggle_hotkey_error = (
                f"{candidate} 已被其他程序占用"
                if restored
                else f"{previous_hotkey} 暂时无法恢复"
            )
            self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = (
                self.toggle_visibility_hotkey_enabled
            )
            save_config(self.config)
            self._sync_toggle_hotkey_controls()
            return "break"

        self.toggle_visibility_hotkey = candidate
        self.toggle_hotkey_registered = enabled
        self.toggle_hotkey_error = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = candidate
        self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = enabled
        save_config(self.config)
        self._sync_toggle_hotkey_controls()
        return "break"

    def _release_toggle_hotkey_modifier(self, event) -> str | None:
        if not getattr(self, "toggle_hotkey_capture_active", False):
            return None
        folded = str(getattr(event, "keysym", "") or "").casefold()
        modifier = ""
        if folded in {"control_l", "control_r"}:
            modifier = "Ctrl"
        elif folded in {"alt_l", "alt_r", "iso_level3_shift"}:
            modifier = "Alt"
        elif folded in {"shift_l", "shift_r"}:
            modifier = "Shift"
        if modifier:
            self.toggle_hotkey_capture_modifiers.discard(modifier)
            return "break"
        return None

    def _cancel_toggle_hotkey_capture(self, _event=None) -> None:
        if not getattr(self, "toggle_hotkey_capture_active", False):
            return
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        self._register_configured_toggle_hotkey()

    def _clear_toggle_visibility_hotkey(self) -> None:
        self.toggle_hotkey_capture_active = False
        self.toggle_hotkey_capture_modifiers.clear()
        if not self._set_native_toggle_hotkey(""):
            self._sync_toggle_hotkey_controls(
                "无法关闭当前快捷键，请重试", error=True
            )
            return
        self.toggle_visibility_hotkey = ""
        self.toggle_visibility_hotkey_enabled = False
        self.toggle_hotkey_registered = False
        self.toggle_hotkey_error = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_CONFIG_KEY] = ""
        self.config[TOGGLE_VISIBILITY_HOTKEY_ENABLED_CONFIG_KEY] = False
        save_config(self.config)
        self._sync_toggle_hotkey_controls()

    def _select_settings_section(self, section: str) -> None:
        if section not in self.backend_settings_frames:
            section = "general"
        for key, frame in self.backend_settings_frames.items():
            if key == section:
                frame.grid(row=0, column=0, sticky="nsew")
            else:
                frame.grid_remove()
        for key, button in self.backend_settings_buttons.items():
            selected = key == section
            button.configure(
                bg=PANEL_2 if selected else BG,
                fg=ACCENT if selected else TEXT,
            )

    def _remember_backend_sidebar_width(self) -> None:
        sidebar = self.backend_sidebar
        if sidebar is None or not sidebar.winfo_exists():
            return
        width = min(420, max(270, int(sidebar.winfo_width())))
        try:
            previous = int(self.config.get("backend_sidebar_width", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            previous = 0
        if previous == width:
            return
        self.config["backend_sidebar_width"] = width
        save_config(self.config)

    def _preview_font_size(self, value: object) -> None:
        if self.settings_font_value_label is None:
            return
        try:
            size = int(round(float(value)))
        except (TypeError, ValueError, OverflowError):
            return
        self.settings_font_value_label.configure(text=f"{size}px")
        self._apply_live_ui_settings()

    def _preview_row_mask_opacity(self, value: object) -> None:
        percent = clamp_percent(value, self.main_row_mask_opacity)
        if self.settings_row_mask_value_label is not None:
            self.settings_row_mask_value_label.configure(text=f"{percent}%")
        self._apply_live_ui_settings()

    def _preview_main_ui_scale(self, value: object) -> None:
        percent = clamp_percent(value, round(self.main_ui_scale * 100), 80)
        percent = min(140, percent)
        if self.settings_ui_scale_value_label is not None:
            self.settings_ui_scale_value_label.configure(text=f"{percent}%")
        self._apply_live_ui_settings()

    def _preview_window_alpha(self, value: object) -> None:
        # Opacity has its own slider callback. Apply the value directly so it
        # cannot be dropped by the guard used while the rest of Settings is
        # still being constructed.
        self._set_window_alpha(value)

    def _apply_live_ui_settings(self, *_args) -> None:
        if (
            not getattr(self, "settings_live_apply_ready", False)
            or getattr(self, "settings_live_apply_running", False)
        ):
            return
        self.settings_live_apply_running = True
        try:
            self._save_ui_settings()
        finally:
            self.settings_live_apply_running = False

    def _save_ui_settings(self) -> None:
        previous_font_size = self.ui_font_size
        previous_ui_scale = float(getattr(self, "main_ui_scale", 1.0) or 1.0)
        if self.settings_font_size_var is not None:
            self.ui_font_size = min(18, max(12, self.settings_font_size_var.get()))
        if self.settings_opacity_var is not None:
            self._set_window_alpha(self.settings_opacity_var.get(), persist=False)
        row_mask_variable = getattr(self, "settings_row_mask_opacity_var", None)
        if row_mask_variable is not None:
            self.main_row_mask_opacity = clamp_percent(
                row_mask_variable.get(), 24
            )
        ui_scale_variable = getattr(self, "settings_ui_scale_var", None)
        if ui_scale_variable is not None:
            self.main_ui_scale = clamp_main_ui_scale(
                float(ui_scale_variable.get()) / 100.0
            )
        audience_metric_variable = getattr(
            self, "settings_audience_metric_var", None
        )
        if audience_metric_variable is not None:
            selected = str(audience_metric_variable.get()).casefold()
            allowed = profession_metric_options(AUDIENCE_PROFESSION_ID)
            self.profession_display_metrics[str(AUDIENCE_PROFESSION_ID)] = (
                selected if selected in allowed else allowed[0]
            )
        warrior_metric_variable = getattr(
            self, "settings_warrior_metric_var", None
        )
        if warrior_metric_variable is not None:
            selected = str(warrior_metric_variable.get()).casefold()
            allowed = profession_metric_options(WARRIOR_PROFESSION_ID)
            self.profession_display_metrics[str(WARRIOR_PROFESSION_ID)] = (
                selected if selected in allowed else allowed[0]
            )
        if self.settings_target_boss_lookup_var is not None:
            self.target_boss_lookup_enabled = bool(
                self.settings_target_boss_lookup_var.get()
            )
            self.worker.set_target_boss_lookup_enabled(
                self.target_boss_lookup_enabled
            )
        if self.settings_show_names_var is not None:
            self.hide_names = not bool(self.settings_show_names_var.get())
        if self.settings_show_damage_var is not None:
            self.show_total_damage = bool(self.settings_show_damage_var.get())
        if self.settings_show_dps_var is not None:
            self.show_dps = bool(self.settings_show_dps_var.get())
        if self.settings_show_share_var is not None:
            self.show_damage_share = bool(self.settings_show_share_var.get())
        if self.settings_show_critical_var is not None:
            self.show_critical_rate = bool(self.settings_show_critical_var.get())
        if self.settings_show_penetration_var is not None:
            self.show_penetration_rate = bool(
                self.settings_show_penetration_var.get()
            )
        if self.settings_keep_dps_bars_opaque_var is not None:
            self.keep_dps_bars_opaque = bool(
                self.settings_keep_dps_bars_opaque_var.get()
            )
            if not self.keep_dps_bars_opaque:
                self._hide_main_content_overlay()
        if self.settings_show_extraordinary_rating_var is not None:
            self.show_extraordinary_rating = bool(
                self.settings_show_extraordinary_rating_var.get()
            )
        if self.settings_team_rating_preview_var is not None:
            self.team_rating_preview_enabled = bool(
                TEAM_RATING_PREVIEW_AVAILABLE
                and self.settings_team_rating_preview_var.get()
            )
            if self._team_rating_preview_active():
                self._hide_main_content_overlay()
        if self.settings_boss_enrage_prediction_var is not None:
            prediction_enabled = bool(
                self.settings_boss_enrage_prediction_var.get()
            )
            if prediction_enabled != self.boss_enrage_prediction_enabled:
                self.boss_enrage_prediction_enabled = prediction_enabled
                self.enrage_predictor.reset()
                self.enrage_prediction = None
                self._set_enrage_prediction_visible(False)
        auto_upload_variable = getattr(
            self, "settings_auto_upload_combat_records_var", None
        )
        if auto_upload_variable is not None:
            previous_auto_upload = bool(
                getattr(self, "auto_upload_combat_records_enabled", True)
            )
            self.auto_upload_combat_records_enabled = bool(
                auto_upload_variable.get()
            )
            if not self.auto_upload_combat_records_enabled:
                queued = getattr(self, "automatic_upload_queued", None)
                if isinstance(queued, set):
                    queued.clear()
            elif not previous_auto_upload:
                wake = getattr(
                    getattr(self, "pvp_upload_worker", None), "wake", None
                )
                if callable(wake):
                    wake()
        show_boss_hp_variable = getattr(self, "settings_show_boss_hp_var", None)
        if show_boss_hp_variable is not None:
            self.show_boss_hp_bar = bool(show_boss_hp_variable.get())
        show_combat_time_variable = getattr(
            self, "settings_show_combat_time_var", None
        )
        if show_combat_time_variable is not None:
            self.show_combat_time = bool(
                show_combat_time_variable.get()
            )
        show_main_totals_variable = getattr(
            self, "settings_show_main_totals_var", None
        )
        if show_main_totals_variable is not None:
            self.show_main_totals = bool(
                show_main_totals_variable.get()
            )
        if self.settings_show_deaths_var is not None:
            self.show_deaths = bool(self.settings_show_deaths_var.get())
        show_team_dps_variable = getattr(self, "settings_show_team_dps_var", None)
        if show_team_dps_variable is not None:
            self.show_team_dps = bool(show_team_dps_variable.get())
        highlight_self_variable = getattr(self, "settings_highlight_self_var", None)
        if highlight_self_variable is not None:
            self.highlight_self = bool(highlight_self_variable.get())
        show_pvp_button_variable = getattr(
            self, "settings_show_pvp_button_var", None
        )
        if show_pvp_button_variable is not None:
            self.show_pvp_button = bool(
                show_pvp_button_variable.get()
            )
        if self.settings_show_revives_var is not None:
            self.show_revives = bool(self.settings_show_revives_var.get())
        if self.settings_show_death_duration_var is not None:
            self.show_death_duration = bool(
                self.settings_show_death_duration_var.get()
            )
        if self.settings_show_taken_var is not None:
            self.show_taken = bool(self.settings_show_taken_var.get())
        if self.settings_show_taken_share_var is not None:
            self.show_taken_share = bool(
                self.settings_show_taken_share_var.get()
            )
        if self.settings_show_boss_damage_var is not None:
            self.show_boss_damage = bool(
                self.settings_show_boss_damage_var.get()
            )
        if self.settings_show_boss_share_var is not None:
            self.show_boss_share = bool(
                self.settings_show_boss_share_var.get()
            )
