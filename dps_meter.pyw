    def _export_current_history(self) -> None:
        if self.history_selected_id:
            self._show_single_history_export_dialog(self.history_selected_id)

    def _show_single_history_export_dialog(self, battle_id: str) -> None:
        self.history_selected_ids.add(str(battle_id))
        self._show_history_export_dialog()

    def _choose_history_export_path(
        self, battle_ids: list[str], export_format: str
    ) -> None:
        self._close_history_modal()
        extension = ".json" if export_format == "json" else ".csv"
        default_directory = Path.home() / "Downloads"
        if not default_directory.is_dir():
            default_directory = Path.home() / "Documents"
        if not default_directory.is_dir():
            default_directory = DATA_DIR / "exports"
        default_name = (
            f"叨叨诡秘助手-history-{dt.datetime.now():%Y%m%d-%H%M%S}{extension}"
        )
        _panel, body, _overlay = self._open_history_modal(
            "保存导出文件", width=520, height=310
        )
        tk.Label(
            body,
            text=(
                f"将 {len(battle_ids)} 场战斗导出为 "
                f"{export_format.upper()}。文件重名时会自动保留两份。"
            ),
            bg=PANEL,
            fg=MUTED,
            anchor="w",
            font=self._ui_font("small"),
        ).pack(fill="x", pady=(0, 10))

        tk.Label(
            body,
            text="保存位置",
            bg=PANEL,
            fg=TEXT,
            anchor="w",
            font=self._ui_font("micro"),
        ).pack(fill="x")
        directory_field = ModernTextField(
            body,
            placeholder="请输入保存文件夹",
            width=470,
            font=self._ui_font("small"),
            background=SURFACE,
        )
        directory_field.pack(fill="x", pady=(4, 9))
        directory_field.set_value(str(default_directory))

        tk.Label(
            body,
            text="文件名",
            bg=PANEL,
            fg=TEXT,
            anchor="w",
            font=self._ui_font("micro"),
        ).pack(fill="x")
        filename_field = ModernTextField(
            body,
            placeholder=f"请输入 {extension} 文件名",
            width=470,
            font=self._ui_font("small"),
            background=SURFACE,
        )
        filename_field.pack(fill="x", pady=(4, 5))
        filename_field.set_value(default_name)

        status_label = tk.Label(
            body,
            text="",
            bg=PANEL,
            fg=ERROR,
            anchor="w",
            font=self._ui_font("micro"),
        )
        status_label.pack(fill="x")
        footer = tk.Frame(body, bg=PANEL)
        footer.pack(side="bottom", fill="x", pady=(6, 0))
        self._history_modal_action(
            footer,
            "导出",
            lambda: self._write_history_export(
                battle_ids,
                export_format,
                directory_field.value(),
                filename_field.value(),
                status_label,
            ),
            primary=True,
        ).pack(side="right")
        self._history_modal_action(
            footer, "取消", self._close_history_modal
        ).pack(side="right", padx=(0, 8))
        filename_field.focus_set()

    def _write_history_export(
        self,
        battle_ids: list[str],
        export_format: str,
        directory_text: str,
        filename_text: str,
        status_label: tk.Label,
    ) -> None:
        extension = ".json" if export_format == "json" else ".csv"
        if not directory_text.strip():
            status_label.configure(text="请填写保存位置。")
            return
        filename = filename_text.strip()
        if not filename:
            status_label.configure(text="请填写文件名。")
            return
        if any(character in filename for character in '<>:"/\\|?*'):
            status_label.configure(text="文件名包含 Windows 不支持的字符。")
            return
        filename = filename.rstrip(" .")
        if not filename:
            status_label.configure(text="请填写有效的文件名。")
            return
        if not filename.casefold().endswith(extension):
            filename += extension
        try:
            directory = Path(os.path.expandvars(directory_text)).expanduser()
            if not directory.is_absolute():
                directory = Path.home() / directory
            directory.mkdir(parents=True, exist_ok=True)
            path = directory / filename
            suffix_number = 2
            while path.exists():
                path = directory / (
                    f"{Path(filename).stem} ({suffix_number}){extension}"
                )
                suffix_number += 1
            exported = self.history_store.export_records(
                battle_ids, str(path), export_format
            )
        except (OSError, TypeError, ValueError) as exc:
            status_label.configure(text=f"导出失败：{exc}")
            return
        self._close_history_modal()

        def open_export_folder() -> None:
            try:
                os.startfile(str(path.parent))
            except (AttributeError, OSError):
                self._show_notice(
                    "导出位置",
                    str(path.parent),
                    parent=self.history_window,
                )

        self._show_notice(
            "导出完成",
            f"已导出 {exported} 场战斗记录。\n{path}",
            parent=self.history_window,
            confirm_text="打开文件夹",
            cancel_text="关闭",
            on_confirm=open_export_folder,
        )

    def _show_history_cleanup_dialog(self) -> None:
        if getattr(self, "backend_current_page", "history") == "kings":
            return
        _panel, body, overlay = self._open_history_modal(
            "清理战斗记录", width=470, height=420
        )
        intro = tk.Label(
            body,
            text="选择需要清理的范围。此操作只影响当前电脑。",
            bg=PANEL,
            fg=MUTED,
            anchor="w",
            font=self._ui_font("small"),
        )
        intro.pack(fill="x", pady=(0, 8))
        choice_var = tk.StringVar(master=self.history_window, value="selected")
        # Reserve actions before laying out choices. At high DPI or in a short
        # host window only the options scroll; confirmation remains reachable.
        footer = tk.Frame(body, bg=PANEL)
        footer.pack(side="bottom", fill="x", pady=(8, 0))
        self._history_modal_action(
            footer, "确认清理", lambda: self._confirm_history_cleanup(choice_var.get()), danger=True,
        ).pack(side="right")
        self._history_modal_action(
            footer, "取消", self._close_history_modal,
        ).pack(side="right", padx=(0, 8))
        options_host = tk.Frame(body, bg=PANEL)
        options_host.pack(fill="both", expand=True)
        options_canvas = tk.Canvas(options_host, bg=PANEL, bd=0, highlightthickness=0, width=420)
        scrollbar = ModernScrollbar(options_host, command=options_canvas.yview, background=PANEL, width=9)
        scrollbar.pack(side="right", fill="y")
        options_canvas.pack(side="left", fill="both", expand=True)
        options_canvas.configure(yscrollcommand=scrollbar.set)
        choices = tk.Frame(options_canvas, bg=PANEL)
        choices_id = options_canvas.create_window(0, 0, window=choices, anchor="nw")
        choices.bind('<Configure>', lambda _event: options_canvas.configure(scrollregion=options_canvas.bbox('all')))
        options_canvas.bind('<Configure>', lambda event: options_canvas.itemconfigure(choices_id, width=max(1, event.width)))

        def scroll_options(event):
            delta = int(getattr(event, 'delta', 0) or 0)
            if delta:
                options_canvas.yview_scroll(-1 if delta > 0 else 1, 'units')
            return 'break'

        options_canvas.bind('<MouseWheel>', scroll_options)
        descriptions = (
            (
                "selected",
                "删除选中记录",
                f"当前已选择 {len(self.history_selected_ids)} 场",
            ),
            ("30", "删除 30 天以前记录", "保留最近 30 天的战斗档案"),
            ("90", "删除 90 天以前记录", "保留最近 90 天的战斗档案"),
            ("all", "清空全部战斗记录", f"当前共 {self.history_total_records} 场"),
        )
        for value, caption, description in descriptions:
            row = ModernChoiceCard(
                choices,
                caption,
                choice_var,
                value,
                font=self._ui_font("strong"),
                detail=description,
                detail_font=self._ui_font("micro"),
                accent=ERROR,
                selected_background="#29181e",
                height=58,
            )
            row.pack(fill="x", pady=3)
            stack = [row]
            while stack:
                widget = stack.pop()
                widget.bind('<MouseWheel>', scroll_options, add='+')
                stack.extend(widget.winfo_children())
        body.update_idletasks()
        options_canvas.configure(height=choices.winfo_reqheight())
        self._fit_history_modal_contents(body)
        shell = self.history_modal_layout[0]
        wanted_width, wanted_height = int(shell.cget('width')), int(shell.cget('height'))

        def fit_host(_event=None):
            if not overlay.winfo_exists():
                return
            shell.configure(width=min(wanted_width, max(280, overlay.winfo_width()-24)),
                            height=min(wanted_height, max(220, overlay.winfo_height()-24)))
            intro.configure(wraplength=max(180, min(wanted_width, overlay.winfo_width()-24)-46))

        overlay.bind('<Configure>', fit_host, add='+')
        fit_host()

    def _confirm_history_cleanup(self, scope: str) -> None:
        self._close_history_modal()
        if scope == "selected":
            count = len(self.history_selected_ids)
            if count <= 0:
                self._show_notice(
                    "清理记录",
                    "当前没有选中的战斗记录。",
                    parent=self.history_window,
                )
                return
            message = f"确定删除选中的 {count} 场战斗记录吗？删除后无法恢复。"
        elif scope in {"30", "90"}:
            message = f"确定删除 {scope} 天以前的战斗记录吗？删除后无法恢复。"
        else:
            message = "确定清空全部战斗记录吗？删除后无法恢复。"

        def remove() -> None:
            if scope == "selected":
                self._hide_settlement_history_records(
                    self.history_selected_ids
                )
                self.history_store.delete_many(self.history_selected_ids)
                self.history_selected_ids.clear()
            elif scope in {"30", "90"}:
                cutoff = time.time() - int(scope) * 86400
                self._hide_settlement_history_records(
                    self._settlement_history_record_ids(
                        lambda encounter: (
                            encounter.ended_at_ns / 1_000_000_000 < cutoff
                        )
                    )
                )
                self.history_store.delete_older_than(int(scope))
            else:
                self._hide_settlement_history_records(
                    self._settlement_history_record_ids()
                )
                self.history_store.delete_all()
                self.history_selected_ids.clear()
            self.history_selected_id = ""
            self.history_loaded_record = None
            self._show_history_browser()
            self._refresh_history_records()

        self._show_notice(
            "确认清理",
            message,
            parent=self.history_window,
            confirm_text="确认删除",
            cancel_text="取消",
            on_confirm=remove,
        )

    def _add_history_note(self) -> None:
        record = self._selected_history_record()
        if record is None:
            return
        _panel, body, _overlay = self._open_history_modal(
            "添加战斗备注", width=450, height=300
        )
        tk.Label(
            body,
            text="备注会参与战斗记录搜索，仅保存在当前电脑。",
            bg=PANEL,
            fg=MUTED,
            anchor="w",
            font=self._ui_font("small"),
        ).pack(fill="x", pady=(0, 8))
        editor = ModernTextArea(
            body,
            font=self._ui_font("body"),
            background=SURFACE,
            height=112,
        )
        editor.pack(fill="both", expand=True)
        editor.insert("1.0", str(record.get("note", "") or ""))
        footer = tk.Frame(body, bg=PANEL)
        footer.pack(fill="x", pady=(9, 0))

        def save_note() -> None:
            updated = self.history_store.set_note(
                self.history_selected_id, editor.get("1.0", "end-1c")
            )
            self._close_history_modal()
            if updated is not None:
                self.history_loaded_record = self._restore_history_record(updated)
                self._refresh_history_records()

        self._history_modal_action(
            footer, "保存备注", save_note, primary=True
        ).pack(side="right")
        self._history_modal_action(
            footer, "取消", self._close_history_modal
        ).pack(side="right", padx=(0, 8))
        editor.focus_set()

    def _recalculate_selected_history(self) -> None:
        if not self.history_selected_id:
            return
        updated, status = self.history_store.recalculate(
            self.history_selected_id
        )
        if updated is None:
            message = "无法读取这场战斗的本地档案。"
        elif status == "complete":
            message = "已根据原始事件重新生成摘要和 DPS 趋势。"
        else:
            message = "旧记录未保存原始事件，已校验现有摘要，无法补出真实趋势。"
        self.history_loaded_record = self._restore_history_record(updated)
        self._refresh_history_records()
        self._show_notice(
            "重新计算",
            message,
            parent=self.history_window,
        )

    def _delete_history_by_id(self, battle_id: str) -> str:
        battle_id = str(battle_id)
        summary = next(
            (
                row
                for row in self.history_records
                if str(row.get("battle_id", row.get("encounter_id", "")))
                == battle_id
            ),
            None,
        )
        boss_name = ""
        if summary is not None:
            boss_name = self._history_encounter_title(summary)

        def remove() -> None:
            self._hide_settlement_history_records({battle_id})
            self.history_store.delete(battle_id)
            self.history_selected_ids.discard(battle_id)
            if self.history_selected_id == battle_id:
                self.history_selected_id = ""
                self.history_loaded_record = None
                self.history_selected_actor = 0
                self._show_history_browser()
            self._refresh_history_records()

        self._show_notice(
            "删除战斗记录",
            (
                f"确定删除“{boss_name}”的这场战斗记录？此操作无法撤销。"
                if boss_name
                else "确定删除这场战斗记录？此操作无法撤销。"
            ),
            parent=self.history_window,
            confirm_text="删除",
            cancel_text="取消",
            on_confirm=remove,
        )
        return "break"

    def _delete_history(self) -> None:
        record = self._selected_history_record()
        if record is None:
            return
        self._delete_history_by_id(
            str(record.get("encounter_id", record.get("battle_id", "")))
        )

    def _clear_unfavorited_history(self) -> None:
        self._flush_combat_history(force=True)
        unfavorited_count = self.history_store.unfavorited_count()
        if unfavorited_count <= 0:
            self._show_notice(
                "一键清理",
                "当前没有可清理的未收藏记录。",
                parent=self.history_window,
            )
            return

        def clear_unfavorited() -> None:
            self._hide_settlement_history_records(
                self._settlement_history_record_ids(
                    lambda encounter: not bool(
                        (
                            self.history_store.load(
                                encounter.local_encounter_id
                            )
                            or {}
                        ).get("favorite", False)
                    )
                )
            )
            self.history_store.clear_unfavorited()
            self.history_selected_id = ""
            self.history_selected_actor = 0
            self._refresh_history_records()

        self._show_notice(
            "一键清理",
            f"确定删除 {unfavorited_count} 条未收藏记录？已收藏记录会保留。",
            parent=self.history_window,
            confirm_text="一键清理",
            cancel_text="取消",
            on_confirm=clear_unfavorited,
        )

    def _settlement_history_record_ids(self, predicate=None) -> set[str]:
        controller = getattr(self, "settlement_ui", None)
        tracker = getattr(controller, "tracker", None)
        encounters = getattr(tracker, "encounters", {})
        result = set()
        for encounter in encounters.values():
            if encounter.ended_at_ns is None or encounter.history_deleted:
                continue
            if predicate is not None and not predicate(encounter):
                continue
            result.add(encounter.local_encounter_id)
        return result

    def _hide_settlement_history_records(self, encounter_ids) -> set[str]:
        controller = getattr(self, "settlement_ui", None)
        if controller is None:
            return set()
        return controller.hide_history_records(encounter_ids)

    def _pvp_history_share_text(self, summary: dict) -> str:
        allies, enemies, team_size = self._pvp_snapshot_rosters(summary)
        mode = (
            f"{team_size}V{team_size}"
            if team_size in {1, 3, 6, 12}
            else "PvP"
        )
        result = str(summary.get("pvp_result") or "未知")
        if result not in {"胜利", "失败", "未知"}:
            result = "未知"
        values = {
            key: self._history_optional_number(summary.get(key))
            for key in ("kills", "assists", "deaths", "my_damage")
        }
        parts = [
            f"{mode} · {summary.get('stage_name') or '未知玩法'}",
            str(summary.get("dungeon_name") or "未知地图"),
            result,
            self._history_optional_duration(summary.get("duration_seconds")),
        ]
        if team_size == 1:
            opponent = enemies[0] if enemies else {}
            opponent_name = self._history_actor_name(
                opponent,
                0,
                self._history_names_hidden(),
            )
            parts.extend(
                (
                    f"对手 {opponent_name}",
                    f"击败 {values['kills']} / 阵亡 {values['deaths']}",
                    f"伤害 {values['my_damage']}",
                )
            )
        else:
            parts.extend(
                (
                    f"击杀 {values['kills']} / 助攻 {values['assists']} / 阵亡 {values['deaths']}",
                    f"伤害 {values['my_damage']}",
                )
            )
        return " | ".join(parts)

    def _share_history(self) -> None:
        if getattr(self, "backend_current_page", "history") == "kings":
            summary = self._selected_history_summary()
            if summary is None:
                return
            self._copy_share_text(
                self._pvp_history_share_text(summary),
                self.history_window,
                title="分享 PvP 战绩",
            )
            return
        record = self._selected_history_record()
        if record is None:
            return
        # Sharing is intentionally DPS-only and never follows the selected tab.
        text = self._history_share_text(record, self._history_names_hidden())
        self._copy_share_text(text, self.history_window)

    def _share_current(self) -> None:
        record = self.model.build_combat_record("share")
        # The main HPS/DT/BOSS tabs still share the DPS participant snapshot.
        text = self._history_share_text(record or {}, self.hide_names)
        self._copy_share_text(text, self.root)

    def _copy_share_text(
        self,
        text: str,
        parent: tk.Misc | None,
        *,
        title: str = "分享 DPS",
    ) -> None:
        if not text:
            self._show_notice(title, "当前没有可分享的数据。", parent=parent)
            return
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        self.root.update_idletasks()
        self._show_notice(title, "已复制到剪贴板。", parent=parent)

    @staticmethod
    def _notice_dimensions(
        message: object, *, modal: bool = False, font_size: object = 14
    ) -> tuple[int, int]:
        text = str(message or "")
        visual_lines = 0
        for line in text.splitlines() or [""]:
            units = sum(2 if ord(char) > 0x7F else 1 for char in line)
            visual_lines += max(1, (units + 45) // 46)
        try:
            normalized_font_size = int(font_size)
        except (TypeError, ValueError, OverflowError):
            normalized_font_size = 14
        font_growth = max(0, min(4, normalized_font_size - 14))
        width = (490 if modal else 430) + font_growth * 26
        base_height = 244 if modal else 190
        included_lines = 2 if modal else 1
        height = min(
            410 if modal else 330,
            base_height
            + font_growth * 9
            + max(0, visual_lines - included_lines) * 26,
        )
        return width, height

    def _show_notice(
        self,
        title_text: str,
        message: str,
        *,
        parent: tk.Misc | None = None,
        confirm_text: str = "确定",
        cancel_text: str = "",
        on_confirm=None,
    ) -> None:
        self._close_notice_window()
        try:
            anchor_exists = parent is not None and parent.winfo_exists()
        except (AttributeError, tk.TclError):
            anchor_exists = False
        anchor = parent if anchor_exists else self.root
        try:
            owner = anchor.winfo_toplevel()
        except (AttributeError, tk.TclError):
            owner = self.root
        title = str(title_text or "提示")
        message_text = str(message or "")
        danger = any(
            token in title
            for token in (
                "退出",
                "删除",
                "清理",
                "失败",
                "无法",
                "取消",
                "错误",
            )
        )
        success = any(
            token in title for token in ("成功", "完成", "已上传", "已复制", "已就绪")
        )
        accent = ERROR if danger else (ACCENT if success else PVE_MODE_FOREGROUND)
        modal = on_confirm is not None or bool(cancel_text)
        destructive = any(
            token in str(confirm_text or "") for token in ("退出", "删除", "清理")
        )
        if "退出" in title:
            icon_name = "power"
        elif destructive:
            icon_name = "trash"
        elif danger:
            icon_name = "warning"
        elif success:
            icon_name = "check"
        else:
            icon_name = "info"

        logical_width, logical_height = self._notice_dimensions(
            message_text,
            modal=modal,
            font_size=getattr(self, "ui_font_size", 14),
        )

        try:
            owner.update_idletasks()
            initial_dpi = get_window_dpi(owner)
        except (AttributeError, OSError, tk.TclError, TypeError, ValueError):
            initial_dpi = getattr(self, "window_dpi", DEFAULT_DPI)

        window = tk.Toplevel(owner)
        window.withdraw()
        self.notice_window = window
        self.notice_parent = owner
        self.notice_modal = modal
        window.title(f"{UI_BRAND} · {title}")
        window.configure(bg=accent)
        try:
            window.transient(owner)
        except tk.TclError:
            pass

        width = logical_pixels_to_physical(logical_width, initial_dpi)
        height = logical_pixels_to_physical(logical_height, initial_dpi)
        try:
            owner_x = int(owner.winfo_rootx())
            owner_y = int(owner.winfo_rooty())
            owner_width = max(1, int(owner.winfo_width()))
            owner_height = max(1, int(owner.winfo_height()))
        except (AttributeError, tk.TclError, TypeError, ValueError):
            owner_x = owner_y = 0
            owner_width = int(window.winfo_screenwidth())
            owner_height = int(window.winfo_screenheight())
        x = owner_x + (owner_width - width) // 2
        y = owner_y + (owner_height - height) // 2
        work_area = monitor_work_area_for_widget(owner)
        x, y = clamp_popup_position(x, y, width, height, work_area, margin=12)
        window.geometry(format_absolute_tk_geometry(width, height, x, y))
        self._prepare_toplevel_dpi(window)
        dpi = get_window_dpi(owner)

        def px(value: object) -> int:
            return logical_pixels_to_physical(value, dpi)

        width = px(logical_width)
        height = px(logical_height)
        if modal:
            x = owner_x + (owner_width - width) // 2
            y = owner_y + (owner_height - height) // 2
        else:
            x = owner_x + owner_width - width - px(18)
            y = owner_y + owner_height - height - px(18)
        x, y = clamp_popup_position(x, y, width, height, work_area, margin=12)
        window.geometry(format_absolute_tk_geometry(width, height, x, y))
        window.resizable(False, False)
        try:
            owner_topmost = bool(owner.attributes("-topmost"))
        except (AttributeError, tk.TclError, TypeError):
            owner_topmost = False
        window.attributes("-topmost", owner_topmost)
        window.attributes("-alpha", 1.0)
        window.overrideredirect(True)
        window.protocol("WM_DELETE_WINDOW", self._close_notice_window)
        window.bind("<Escape>", lambda _event: self._close_notice_window())

        shell = tk.Frame(window, bg=accent)
        shell.pack(fill="both", expand=True)
        card = tk.Frame(shell, bg=MODAL_SURFACE)
        card.pack(fill="both", expand=True, padx=px(1), pady=px(1))
        card.pack_propagate(False)
        tk.Frame(card, bg=accent, height=px(3)).pack(fill="x")

        header = tk.Frame(card, bg=BG, height=px(48))
        header.pack(fill="x")
        header.pack_propagate(False)
        self._bind_drag(header, window)
        header.bind("<Double-Button-1>", lambda _event: "break")
        logo_image = self.icons.app_logo(22)
        logo = tk.Label(header, image=logo_image, bg=BG, bd=0)
        logo.image = logo_image
        logo.pack(side="left", padx=(px(16), px(8)))
        self._bind_drag(logo, window)
        logo.bind("<Double-Button-1>", lambda _event: "break")
        brand_label = tk.Label(
            header,
            text=UI_BRAND,
            bg=BG,
            fg=TEXT,
            anchor="w",
            font=self._ui_font("title"),
        )
        brand_label.pack(side="left", fill="y")
        self._bind_drag(brand_label, window)
        brand_label.bind("<Double-Button-1>", lambda _event: "break")
        self._titlebar_icon_button(
            header,
            "close",
            self._close_notice_window,
            width=px(48),
            height=px(48),
            bg=BG,
            hover="#562631",
            fg="#b9c3cc",
        ).pack(side="right", fill="y")

        content = tk.Frame(card, bg=MODAL_SURFACE)
        content.pack(
            fill="both",
            expand=True,
            padx=px(22),
            pady=(px(16), px(13)),
        )
        status_icon = tk.Canvas(
            content,
            width=px(56),
            height=px(56),
            bg=MODAL_SURFACE,
            bd=0,
            highlightthickness=0,
        )
        status_icon.create_oval(
            px(2),
            px(2),
            px(54),
            px(54),
            fill=blend_color(MODAL_SURFACE, accent, 0.15),
            outline=blend_color(BORDER, accent, 0.72),
            width=max(1, px(1)),
        )
        status_image = self.icons.toolbar(icon_name, 26, accent)
        status_icon.create_image(px(28), px(28), image=status_image)
        status_icon.image = status_image
        status_icon.pack(side="left", anchor="n", padx=(0, px(14)))

        text_group = tk.Frame(content, bg=MODAL_SURFACE)
        text_group.pack(side="left", fill="both", expand=True)
        tk.Label(
            text_group,
            text=title,
            bg=MODAL_SURFACE,
            fg=TEXT,
            justify="left",
            anchor="w",
            font=self._ui_font("dialog_title"),
        ).pack(fill="x")
        tk.Label(
            text_group,
            text=message_text,
            bg=MODAL_SURFACE,
            fg="#c5cfd8",
            justify="left",
            anchor="nw",
            wraplength=max(px(280), width - px(126)),
            font=self._ui_font("dialog_body"),
        ).pack(fill="both", expand=True, pady=(px(7), 0))

        button_bar = tk.Frame(card, bg=BG, height=px(60))
        button_bar.pack(side="bottom", fill="x")
        button_bar.pack_propagate(False)
        tk.Frame(button_bar, bg=BORDER, height=px(1)).pack(fill="x")
        action_host = tk.Frame(button_bar, bg=BG)
        action_host.pack(side="right", fill="y", padx=px(18), pady=px(10))

        def confirm() -> None:
            self._close_notice_window()
            if on_confirm is not None:
                on_confirm()

        def action_button(
            caption: str,
            command,
            *,
            primary: bool = False,
            danger: bool = False,
            logical_button_width: int = 112,
        ) -> tk.Label:
            slot = tk.Frame(
                action_host,
                bg=BG,
                width=px(logical_button_width),
                height=px(38),
            )
            slot.pack(side="right", padx=(px(9), 0))
            slot.pack_propagate(False)
            button = self._history_modal_action(
                slot,
                caption,
                command,
                primary=primary,
                danger=danger,
            )
            button.configure(
                padx=0,
                pady=0,
                font=self._ui_font("dialog_button"),
            )
            button.pack(fill="both", expand=True)
            return button

        confirm_button = action_button(
            confirm_text,
            confirm,
            primary=not destructive,
            danger=destructive,
            logical_button_width=108,
        )
        cancel_button = None
        if cancel_text:
            cancel_button = action_button(
                cancel_text,
                self._close_notice_window,
                logical_button_width=96,
            )

        window.deiconify()
        window.lift(owner)
        window.after(20, lambda target=window: self._apply_windows_style(target))
        if modal:
            window.grab_set()
            window.focus_force()
            (cancel_button or confirm_button).focus_set()
        if on_confirm is None and not cancel_text:
            window.after(
                3600,
                lambda target=window: self._close_notice_window(target),
            )

    def _close_notice_window(self, expected: tk.Misc | None = None) -> None:
        window = getattr(self, "notice_window", None)
        if expected is not None and window is not expected:
            return
        parent = getattr(self, "notice_parent", None)
        modal = bool(getattr(self, "notice_modal", False))
        self.notice_window = None
        self.notice_parent = None
        self.notice_modal = False
        if window is not None:
            getattr(self, "drag_state", {}).pop(id(window), None)
            try:
                if window.winfo_exists():
                    try:
                        window.grab_release()
                    except tk.TclError:
                        pass
                    window.destroy()
            except (AttributeError, tk.TclError):
                pass
        if not modal or bool(getattr(self, "closing", False)):
            return
        try:
            if parent is not None and parent.winfo_exists():
                parent.lift()
                parent.focus_force()
        except (AttributeError, tk.TclError):
            pass

    def _minimize_history(self) -> None:
        if self.history_window is None or not self.history_window.winfo_exists():
            return
        ModernDropdown.close_active_popup(self.history_window)
        self._cancel_toggle_hotkey_capture()
        self._cancel_hud_view_hotkey_capture()
        self._flush_window_geometry(self.history_window)
        self.config["history_geometry"] = self.history_window.geometry()
        self.history_window.withdraw()
        self.tray_history_hidden = True
        save_config(self.config)

    def _restore_main_after_backend_close(self) -> None:
        if (
            self.closing
            or self.authorization_resetting
            or not self.root.winfo_exists()
            or self.compact_mode
        ):
            return
        self.main_window_intentionally_hidden = False
        self.root.deiconify()
        self.root.update_idletasks()
        self._apply_window_dpi_if_changed(force=True)
        self.root.lift()
        if not self.window_locked:
            self.root.focus_force()
        self._apply_windows_style(self.root)
        self._apply_main_transparency()
        self.root.after(20, self._apply_window_lock_state)

    def _close_history_window(self, *, destroy: bool = False) -> None:
        refresh_id = getattr(self, "pvp_history_refresh_after_id", None)
        window = getattr(self, "history_window", None)
        if refresh_id is not None and window is not None:
            try:
                window.after_cancel(refresh_id)
            except tk.TclError:
                pass
        self.pvp_history_refresh_after_id = None
        if not destroy:
            ModernDropdown.close_active_popup(window)
            self._cancel_toggle_hotkey_capture()
            self._cancel_hud_view_hotkey_capture()
            pvp_alliance_page = getattr(self, "pvp_alliance_page", None)
            if pvp_alliance_page is not None:
                pvp_alliance_page.on_hide()
            if self.history_filter_after_id is not None and window is not None:
                try:
                    window.after_cancel(self.history_filter_after_id)
                except tk.TclError:
                    pass
            self.history_filter_after_id = None
            if window is not None and window.winfo_exists():
                self._flush_window_geometry(window)
                self.config["history_geometry"] = self.restore_geometry.get(
                    id(window), window.geometry()
                )
                window.withdraw()
            self.tray_history_hidden = False
            save_config(self.config)
            self._restore_main_after_backend_close()
            return

        for page in (getattr(self, "pvp_history_page", None), getattr(self, "pvp_alliance_page", None)):
            if page is not None:
                page.dispose()
        self.pvp_history_page = None
        self.pvp_alliance_page = None
        ModernDropdown.close_active_popup(
            getattr(self, "history_window", None)
        )
        self._cancel_toggle_hotkey_capture()
        self._cancel_hud_view_hotkey_capture()
        if self.history_filter_after_id is not None and self.history_window is not None:
            try:
                self.history_window.after_cancel(self.history_filter_after_id)
            except tk.TclError:
                pass
        self.history_filter_after_id = None
        self.settings_live_apply_ready = False
        self.settings_live_apply_running = False
        if self.history_window is not None and self.history_window.winfo_exists():
            self._flush_window_geometry(self.history_window)
            self.config["history_geometry"] = self.restore_geometry.get(
                id(self.history_window), self.history_window.geometry()
            )
            self.drag_state.pop(id(self.history_window), None)
            self.resize_state.pop(id(self.history_window), None)
            self.restore_geometry.pop(id(self.history_window), None)
            self.history_window.destroy()
