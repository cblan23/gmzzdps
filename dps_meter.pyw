            if isinstance(metadata, dict)
        )
        self._diagnostic_entity_templates: dict[int, dict[str, object]] = {}
        self._diagnostic_damage_targets: dict[int, dict[str, object]] = {}
        self.team_stats_last_snapshot_total: int | None = None
        self.hybrid_receive_hook_active = False
        self.hybrid_receive_hook_authoritative = False
        self.next_live_team_rating_republish_at = 0.0
        self.team_profile_cache = load_json_object(TEAM_PROFILE_CACHE_PATH)
        self.self_identity_cache = load_json_object(SELF_IDENTITY_CACHE_PATH)
        self.last_emitted_self_identity: dict[str, object] = {}
        self.active_boss_cache = load_json_object(ACTIVE_BOSS_CACHE_PATH)
        self.boss_name_resolver = BossNameResolver(
            messages,
            stop_event,
            self.monster_catalog,
        )
        self.equipment_capture_session_id = 0
        self.equipment_game_pid = 0
        self.equipment_profiles = EquipmentProfileCoordinator(
            data_dir=DATA_DIR,
            emit=self.emit,
            stop_event=stop_event,
            runtime_profile_provider=self._equipment_runtime_profile,
            request_hook_pause=self._pause_team_stats_for_equipment,
            request_hook_resume=self._resume_team_stats_after_equipment,
        )

    def _equipment_runtime_profile(self):
        with self.runtime_capability_lock:
            capability = self.runtime_capability
        return capability.profile if capability is not None else None

    def equipment_session(self) -> tuple[int, int]:
        return (
            int(self.equipment_game_pid or 0),
            int(self.equipment_capture_session_id or 0),
        )

    def schedule_equipment_profiles(self, value: object) -> bool:
        if not isinstance(value, dict):
            return False
        game_pid, capture_session_id = self.equipment_session()
        if game_pid <= 0 or capture_session_id <= 0:
            return False
        return self.equipment_profiles.schedule(
            {
                **value,
                "game_pid": game_pid,
                "capture_session_id": capture_session_id,
            }
        )

    def _pause_team_stats_for_equipment(self, game_pid: int) -> bool:
        response: queue.Queue = queue.Queue(maxsize=1)
        self.equipment_hook_commands.put(("pause", int(game_pid or 0), response))
        try:
            return bool(response.get(timeout=3.0))
        except queue.Empty:
            return False

    def _resume_team_stats_after_equipment(self, game_pid: int) -> None:
        response: queue.Queue = queue.Queue(maxsize=1)
        self.equipment_hook_commands.put(("resume", int(game_pid or 0), response))
        try:
            response.get(timeout=3.0)
        except queue.Empty:
            pass

    def _service_equipment_hook_commands(
        self,
        hybrid_team_driver,
        game_pid: int,
    ) -> None:
        while True:
            try:
                action, requested_pid, response = (
                    self.equipment_hook_commands.get_nowait()
                )
            except queue.Empty:
                return
            succeeded = False
            if action == "pause" and requested_pid == int(game_pid or 0):
                succeeded = bool(
                    hybrid_team_driver is None
                    or hybrid_team_driver.pause_for_external_request()
                )
                if succeeded:
                    self.equipment_team_hook_paused = True
            elif action == "resume":
                self.equipment_team_hook_paused = False
                if hybrid_team_driver is not None:
                    hybrid_team_driver.resume_after_external_request()
                succeeded = True
            try:
                response.put_nowait(succeeded)
            except queue.Full:
                pass

    def _set_active_boss_cache(self, value: dict) -> None:
        if value == self.active_boss_cache:
            return
        self.active_boss_cache = dict(value)
        write_json_object(ACTIVE_BOSS_CACHE_PATH, self.active_boss_cache)

    def _restore_same_process_boss(
        self, parser: NetworkPacketParser, game_pid: int
    ) -> bool:
        try:
            cached_pid = int(self.active_boss_cache.get("game_pid", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            cached_pid = 0
        if cached_pid != int(game_pid or 0):
            if self.active_boss_cache:
                self._set_active_boss_cache({})
            return False
        updates = parser.restore_active_boss_state(self.active_boss_cache)
        if not updates:
            self._set_active_boss_cache({})
            return False
        for kind, update in updates:
            self.emit(kind, update)
        return True

    def _sync_active_boss_cache(
        self, parser: NetworkPacketParser, game_pid: int
    ) -> None:
        active_boss_cache = getattr(self, "active_boss_cache", {})
        if not isinstance(active_boss_cache, dict):
            active_boss_cache = {}
        state = parser.current_active_boss_state()
        if state is None:
            try:
                cached_pid = int(active_boss_cache.get("game_pid", 0) or 0)
            except (TypeError, ValueError, OverflowError):
                cached_pid = 0
            if cached_pid == int(game_pid or 0):
                self._set_active_boss_cache({})
            return
        next_state = {
            "game_pid": int(game_pid or 0),
            **state,
        }
        try:
            previous_pid = int(active_boss_cache.get("game_pid", 0) or 0)
            previous_entity_id = int(
                active_boss_cache.get("entity_id", 0) or 0
            )
        except (TypeError, ValueError, OverflowError):
            previous_pid = 0
            previous_entity_id = 0
        next_entity_id = int(state.get("entity_id", 0) or 0)
        active_entity_changed = bool(
            next_entity_id
            and (
                previous_pid != int(game_pid or 0)
                or previous_entity_id != next_entity_id
            )
        )
        identity_updated = bool(
            not active_entity_changed
            and next_entity_id
            and (
                (next_state.get("template_id") and next_state.get("template_id") != active_boss_cache.get("template_id"))
                or (next_state.get("name") and next_state.get("name") != active_boss_cache.get("name"))
            )
        )
        # A reconnect/resync can identify the same live Boss before its exact
        # MaxHP message is seen again. Do not let that transient zero erase a
        # previously confirmed maximum for the same process and entity. The
        # value is never carried across a PID or entity change.
        if not active_entity_changed:
            try:
                next_max_hp = float(next_state.get("max_hp", 0) or 0)
                previous_max_hp = float(
                    active_boss_cache.get("max_hp", 0) or 0
                )
            except (TypeError, ValueError, OverflowError):
                next_max_hp = previous_max_hp = 0.0
            if next_max_hp <= 0 < previous_max_hp:
                next_state["max_hp"] = previous_max_hp
        self._set_active_boss_cache(next_state)
        if active_entity_changed or identity_updated:
            self.emit(
                "active_boss",
                {
                    **state,
                    "source_method": (
                        "network_active_boss_transition"
                        if active_entity_changed
                        else "network_active_boss_identity_update"
                    ),
                },
            )

    def _update_diagnostics(self, **values: object) -> None:
        with self.diagnostic_lock:
            self.diagnostics.update(values)

    def _log_experiment_lifecycle(
        self, message: str, **fields: object
    ) -> None:
        write_capture_lifecycle_event(
            message,
            component="capture_worker",
            **fields,
        )
        callback = self.settlement_experiment_lifecycle
        if callback is None:
            return
        try:
            callback(message, component="capture_worker", **fields)
        except Exception:
            # Diagnostics must never alter capture behavior.
            pass

    def _apply_team_stats_mode(
        self,
        capture: CaptureProcessClient | None,
        parser: object,
        batch: dict | None,
    ) -> None:
        """Propagate the conservative scene classification to the child."""
        next_mode, reason = classify_team_stats_mode(
            parser,
            batch,
            self.team_stats_mode,
        )
        normalized = team_stats_mode_name(next_mode)
        changed = normalized != self.team_stats_mode
        self.team_stats_mode = normalized
        self.team_stats_mode_reason = str(reason or "")[:64]
        if changed:
            self.team_stats_mode_changes += 1
        self._update_diagnostics(
            team_stats_mode=self.team_stats_mode,
            team_stats_mode_reason=self.team_stats_mode_reason,
            team_stats_mode_changes=self.team_stats_mode_changes,
        )
        if capture is not None and changed:
            try:
                capture.set_team_stats_mode(self.team_stats_mode)
            except Exception:
                self.emit(
                    "diagnostic",
                    "team-stat mode propagation failed",
                )

    def set_target_boss_lookup_enabled(self, enabled: bool) -> None:
        enabled = bool(enabled)
        if enabled:
            self.target_boss_lookup_event.set()
        else:
            self.target_boss_lookup_event.clear()
        self._update_diagnostics(target_boss_lookup_enabled=enabled)

    def refresh_runtime_capability(self, value: object) -> float:
        """Renew the child lease without allowing its runtime profile to change."""
        with self.runtime_capability_lock:
            current = self.runtime_capability
            capture = self.capture_client
            if current is None:
                raise RuntimeCapabilityError(
                    "capture worker has no runtime capability"
                )
            try:
                next_capability = RuntimeCapability.from_value(
                    value,
                    expected_session_id=current.session_id,
                    expected_client_id=current.client_id,
                    expected_build_id=current.build_id,
                    expected_client_build=current.client_build,
                    trusted_public_keys=self.trusted_capability_public_keys,
                    allow_development=self.allow_development_capability,
                )
                if not current.same_binding(next_capability):
                    raise RuntimeCapabilityError(
                        "runtime capability binding or profile changed"
                    )
                if capture is not None:
                    capture.refresh_runtime_capability(next_capability)
            except RuntimeCapabilityError:
                if capture is not None:
                    capture.revoke_runtime_capability()
                raise
            self.runtime_capability = next_capability
        self._update_diagnostics(
            runtime_profile_id=next_capability.profile_id,
            runtime_capability_expires_at=next_capability.expires_at,
        )
        return next_capability.expires_at

    def _add_diagnostic_counts(self, **values: int) -> None:
        with self.diagnostic_lock:
            for key, value in values.items():
                self.diagnostics[key] = int(self.diagnostics.get(key, 0) or 0) + int(
                    value
                )

    def diagnostic_snapshot(self) -> dict[str, object]:
        with self.diagnostic_lock:
            snapshot = dict(self.diagnostics)
            snapshot["messages"] = list(self.diagnostics.get("messages", []))
            snapshot["recent_damage_targets"] = [
                dict(value)
                for value in list(self._diagnostic_damage_targets.values())[-16:]
            ]
            snapshot["recent_boss_templates"] = [
                dict(value)
                for value in self._diagnostic_entity_templates.values()
                if bool(value.get("catalog_match"))
                or int(value.get("runtime_boss_type", 0) or 0) == 3
            ][-24:]
        return snapshot

    def team_stats_health_state(self) -> str:
        """Return the lightweight live response state used by the main UI."""
        with self.diagnostic_lock:
            return str(
                self.diagnostics.get("team_stats_response_health", "inactive")
                or "inactive"
            )

    def _record_native_boss_observation(self, record: dict) -> None:
        try:
            entity_id = int(record.get("entity_id", 0) or 0)
            template_id = int(record.get("template_id", 0) or 0)
            runtime_boss_type = int(record.get("boss_type", -1))
            filetime_100ns = int(record.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return
        if not entity_id:
            return
        metadata = self.monster_catalog.get(str(template_id), {})
        try:
            catalog_match = bool(
                isinstance(metadata, dict)
                and int(metadata.get("boss_type", 0) or 0) == 3
            )
        except (TypeError, ValueError, OverflowError):
            catalog_match = False
        name = ""
        if isinstance(metadata, dict):
            name = str(metadata.get("name", "")).strip()[:64]
        if not name:
            name = str(record.get("name", "")).strip()[:64]
        observation: dict[str, object] = {
            "entity_id": str(entity_id),
            "template_id": template_id,
            "runtime_boss_type": runtime_boss_type,
            "catalog_match": catalog_match,
            "name": name,
            "filetime_100ns": filetime_100ns,
        }
        with self.diagnostic_lock:
            self._diagnostic_entity_templates.pop(entity_id, None)
            self._diagnostic_entity_templates[entity_id] = observation
            while len(self._diagnostic_entity_templates) > 4096:
                oldest = next(iter(self._diagnostic_entity_templates))
                self._diagnostic_entity_templates.pop(oldest, None)
            target = self._diagnostic_damage_targets.get(entity_id)
            if target is not None:
                target.update(
                    {
                        "template_id": template_id,
                        "runtime_boss_type": runtime_boss_type,
                        "catalog_match": catalog_match,
                        "name": name,
                    }
                )

    def _record_native_damage_observation(self, record: dict) -> None:
        try:
            target_id = int(record.get("target_id", 0) or 0)
            damage = max(0, int(record.get("damage", 0) or 0))
            filetime_100ns = int(record.get("filetime_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return
        if not target_id or damage <= 0:
            return
        with self.diagnostic_lock:
            existing = self._diagnostic_damage_targets.pop(target_id, None) or {
                "target_id": str(target_id),
                "records": 0,
                "damage": 0,
                "template_id": 0,
                "runtime_boss_type": -1,
                "catalog_match": False,
                "name": "",
            }
            existing["records"] = int(existing.get("records", 0) or 0) + 1
            existing["damage"] = int(existing.get("damage", 0) or 0) + damage
            existing["filetime_100ns"] = filetime_100ns
            template = self._diagnostic_entity_templates.get(target_id)
            if template is not None:
                existing.update(
                    {
                        "template_id": int(template.get("template_id", 0) or 0),
                        "runtime_boss_type": int(
                            template.get("runtime_boss_type", -1)
                        ),
                        "catalog_match": bool(template.get("catalog_match")),
                        "name": str(template.get("name", ""))[:64],
                    }
                )
            self._diagnostic_damage_targets[target_id] = existing
            while len(self._diagnostic_damage_targets) > 32:
                oldest = next(iter(self._diagnostic_damage_targets))
                self._diagnostic_damage_targets.pop(oldest, None)

    def _remember_diagnostic_message(self, message: object) -> None:
        text = str(message or "").strip()
        if not text:
            return
        with self.diagnostic_lock:
            messages = list(self.diagnostics.get("messages", []))
            messages.append({"time": time.time(), "message": text[:500]})
            self.diagnostics["messages"] = messages[-12:]

    def emit(self, kind: str, payload=None) -> None:
        if kind == "event":
            self._add_diagnostic_counts(parsed_damage_events=1)
            self._update_diagnostics(last_parsed_damage_at=time.time())
        elif (
            kind == "profile"
            and isinstance(payload, dict)
            and payload.get("boss_source") == "monster_template_catalog"
        ):
            self._add_diagnostic_counts(boss_catalog_promotions=1)
        elif kind == "monster":
            self._add_diagnostic_counts(monster_updates=1)
        elif kind in {"diagnostic", "error", "fatal"}:
            self._remember_diagnostic_message(payload)
        self.messages.put((kind, payload))

    def _emit_parser_update(
        self, parser: NetworkPacketParser, kind: str, payload: object
    ) -> None:
        previous_token = ""
        next_token = ""
        if kind == "identity_session_reset" and isinstance(payload, dict):
            previous_token = str(
                payload.get("previous_user_token", "")
                or self.last_emitted_self_identity.get("user_token", "")
                or ""
            ).strip()
            next_token = str(payload.get("user_token", "") or "").strip()
        if previous_token and next_token and previous_token != next_token:
            # The selected account/character can change while the game PID and
            # capture session stay the same. Only clear worker-side role/Boss
            # caches once both tokens prove that this is a different role. A
            # transport rebuild can temporarily report only a new actor ID;
            # retaining the old token lets the next live profile prove whether
            # the role actually changed.
            self.last_emitted_self_identity = {}
            self.last_emitted_dungeon_context = {}
            self.team_stats_last_snapshot_total = None
            self.equipment_profiles.invalidate("identity_session_reset")
            if self.self_identity_cache:
                self.self_identity_cache = {}
                write_json_object(
                    SELF_IDENTITY_CACHE_PATH,
                    self.self_identity_cache,
                )
            if self.active_boss_cache:
                self._set_active_boss_cache({})
        if (
            kind == "event"
            and isinstance(payload, dict)
            and not parser.should_forward_damage_event(payload)
        ):
            self._add_diagnostic_counts(filtered_non_boss_damage_events=1)
            return
        self.emit(kind, payload)

    def _enrich_boss_record(self, record: dict, pid: int) -> None:
        try:
            template_id = int(record.get("template_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            template_id = 0
        if not template_id:
            return
        metadata = self.monster_catalog.get(str(template_id), {})
        if not isinstance(metadata, dict):
            return
        name = str(metadata.get("name", "")).strip()
        if name and not boss_name_is_placeholder(name):
            record["name"] = name
        if metadata.get("level") not in (None, ""):
            record["level"] = metadata["level"]
        paths = metadata.get("fc_paths", [])
        if isinstance(paths, list) and paths:
            record["template_path"] = str(paths[0])[:160]
        try:
            localization_id = int(metadata.get("localization_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            localization_id = 0
        if not record.get("name") and localization_id:
            self.boss_name_resolver.request(
                pid,
                int(record.get("entity_id", 0) or 0),
                template_id,
                localization_id,
                int(record.get("filetime_100ns", 0) or 0),
            )

    @staticmethod
    def _capture_detail(payload: object) -> str:
        if isinstance(payload, dict):
            details = str(payload.get("details", "") or "").strip()
        else:
            details = str(payload or "").strip()
        lines = [line.strip() for line in details.splitlines() if line.strip()]
        return lines[-1] if lines else details

    def _create_network_parser(
        self,
        game_pid: int,
        *,
        allow_remembered_identity: bool = True,
    ) -> NetworkPacketParser:
        parser_class = NetworkPacketParser
        if IS_PASSIVE_PROTOCOL_ADAPTER:
            from npcap_parser_adapter import NpcapParserAdapter
            parser_class = NpcapParserAdapter
        remembered_self_token = ""
        try:
            remembered_game_pid = int(
                self.self_identity_cache.get("game_pid", 0) or 0
            )
        except (TypeError, ValueError, OverflowError):
            remembered_game_pid = 0
        if (
            allow_remembered_identity
            and remembered_game_pid == int(game_pid or 0)
        ):
            remembered_self_token = str(
                self.self_identity_cache.get("user_token", "")
            ).strip()
        return parser_class(
            self.team_profile_cache,
            self.monster_catalog,
            target_identity_catalog=self.target_identity_catalog,
            remembered_self_token=remembered_self_token,
            allow_cached_projection_roster=bool(
                allow_remembered_identity
                and remembered_game_pid == int(game_pid or 0)
            ),
            boss_name_allowlist=load_boss_name_allowlist(),
        )

    def _sync_parser_runtime_state(
        self, parser: NetworkPacketParser, game_pid: int
    ) -> bool:
        dungeon_context = parser.current_dungeon_context()
        self._update_diagnostics(**dungeon_context)
        self._update_diagnostics(invalid_combat_values=int(getattr(parser, 'invalid_combat_values', 0)))
        if dungeon_context != self.last_emitted_dungeon_context:
            self.last_emitted_dungeon_context = dict(dungeon_context)
            self.emit("dungeon_context", dict(dungeon_context))
        profile_cache_dirty = False
        cached_profiles = parser.take_team_profile_cache()
        if cached_profiles is not None:
            self.team_profile_cache = cached_profiles
            profile_cache_dirty = True
        current_self_identity = parser.current_self_identity()
        if current_self_identity is not None:
            emitted_identity = {
                "entity_id": int(getattr(parser, "self_id", 0) or 0),
                **current_self_identity,
            }
            if emitted_identity != self.last_emitted_self_identity:
                self.last_emitted_self_identity = dict(emitted_identity)
                self.emit("self_character", emitted_identity)
            next_self_identity = {
                "game_pid": int(game_pid or 0),
                **current_self_identity,
            }
            if next_self_identity != self.self_identity_cache:
                self.self_identity_cache = next_self_identity
                write_json_object(
                    SELF_IDENTITY_CACHE_PATH,
                    self.self_identity_cache,
                )
        self._sync_active_boss_cache(parser, game_pid)
        return profile_cache_dirty

    def _publish_startup_self_profile(
        self, payload: object, *, live: bool
    ) -> bool:
        """Publish a log-proven local role before Npcap stream alignment ends."""

        if not isinstance(payload, dict):
            return False
        try:
            game_pid = int(payload.get("game_pid", 0) or 0)
            actor_id = int(
                payload.get("entity_id", 0)
                or payload.get("startup_self_actor_id", 0)
                or 0
            )
            identity = canonical_character_identity(
                payload.get("user_token")
                or payload.get("startup_self_token")
                or ""
            )
        except (ProfileUploadError, TypeError, ValueError, OverflowError):
            return False
        if game_pid <= 0 or actor_id <= 0:
            return False

        cached = self.team_profile_cache.get(identity.canonical, {})
        profile = dict(cached) if isinstance(cached, dict) else {}
        remembered = (
            self.self_identity_cache
            if isinstance(self.self_identity_cache, dict)
            else {}
        )
        try:
            remembered_pid = int(remembered.get("game_pid", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            remembered_pid = 0
        if (
            remembered_pid == game_pid
            and str(remembered.get("user_token", "")).strip()
            == identity.canonical
        ):
            profile.update(remembered)
        if live:
            profile.update(payload)

        name = str(profile.get("name", "") or "").strip()[:48]
        if not name:
            return False
        clean: dict[str, object] = {
            "entity_id": actor_id,
            "user_token": identity.canonical,
            "name": name,
        }
        for key in ("profession_id", "level", "role_number"):
            try:
                value = int(profile.get(key, 0) or 0)
            except (TypeError, ValueError, OverflowError):
                value = 0
            if value > 0:
                clean[key] = value
        # The log-proven token may safely restore identity fields across a
        # game restart, but an equipment score is mutable.  Never paint the
        # disk-cached score as current; only the live poller callback may add
        # it to this startup profile.
        rating = normalize_extraordinary_rating(
            payload.get("extraordinary_rating") if live else None
        )
        if rating is not None:
            clean["extraordinary_rating"] = rating

        previous_token = str(
            self.last_emitted_self_identity.get("user_token", "") or ""
        ).strip()
        if previous_token and previous_token != identity.canonical:
            self.emit(
                "identity_session_reset",
                {
                    "entity_id": actor_id,
                    "previous_user_token": previous_token,
                    "user_token": identity.canonical,
                    "reason": "startup_local_role_changed",
                },
            )
            self.last_emitted_self_identity = {}

        stored_profile = dict(cached) if isinstance(cached, dict) else {}
        stored_profile.update(
            {key: value for key, value in clean.items() if key != "entity_id"}
        )
        self.team_profile_cache[identity.canonical] = stored_profile
        write_json_object(TEAM_PROFILE_CACHE_PATH, self.team_profile_cache)
        self.self_identity_cache = {
            "game_pid": game_pid,
            **{key: value for key, value in clean.items() if key != "entity_id"},
        }
        write_json_object(SELF_IDENTITY_CACHE_PATH, self.self_identity_cache)

        emitted = dict(clean)
        if emitted != self.last_emitted_self_identity:
            self.last_emitted_self_identity = dict(emitted)
            self.emit(
                "identity",
                {
                    "entity_id": actor_id,
                    "tentative": False,
                    "source_method": "StartupLocalRoleProfile",
                },
            )
            self.emit("self_character", emitted)
        return True

    def _record_team_stats_response_diagnostics(
        self, record: object, updates: object
    ) -> None:
        """Record parsed snapshot coverage without changing combat values."""
        if not isinstance(record, dict):
            return
        method = str(record.get("method", ""))
        if method not in TEAM_STATISTICS_METHODS:
            return
        parsed_updates = updates if isinstance(updates, list) else []
        rows = [
            value
            for kind, value in parsed_updates
            if kind == "team_stat" and isinstance(value, dict)
        ]
        self._add_diagnostic_counts(team_stats_parsed_responses=1)
        try:
            filetime_100ns = max(
                0, int(record.get("filetime_100ns", 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            filetime_100ns = 0
        if not rows:
            self._add_diagnostic_counts(team_stats_empty_responses=1)
            return
        if method != "RetCommonCombatStatisticsByTeam":
            return

        member_keys = {
            str(row.get("user_token", "")).strip()
            or str(row.get("actor_id", "")).strip()
            for row in rows
            if str(row.get("user_token", "")).strip()
            or str(row.get("actor_id", "")).strip()
        }
        total_damage = 0
        for row in rows:
            try:
                total_damage += max(
                    0, int(row.get("absolute_damage", 0) or 0)
                )
            except (TypeError, ValueError, OverflowError):
                continue
        previous_total = self.team_stats_last_snapshot_total
        self.team_stats_last_snapshot_total = total_damage
        diagnostic_values: dict[str, object] = {
            "team_stats_last_member_count": len(member_keys),
            "team_stats_last_damage_total": total_damage,
        }
        if previous_total is None or total_damage != previous_total:
            self._add_diagnostic_counts(team_stats_damage_progress_count=1)
            diagnostic_values["team_stats_last_progress_filetime"] = (
                filetime_100ns
            )
        self._update_diagnostics(**diagnostic_values)

    def _emit_completed_settlement_observations(
        self, parser: NetworkPacketParser
    ) -> None:
        if not IS_PASSIVE_PROTOCOL_ADAPTER:
            return
        take_observations = getattr(
            parser, "take_settlement_observations", None
        )
        if not callable(take_observations):
            return
        for observation in take_observations():
            self.emit("settlement_observation", observation)

    def _emit_completed_pvp_observations(self, parser: NetworkPacketParser) -> None:
        take_observations = getattr(parser, "take_pvp_observations", None)
        if callable(take_observations):
            for observation in take_observations():
                self.emit("pvp_observation", observation)

    def _restore_pvp_lifecycle_context(self, parser, payload, log_handle) -> int:
        """Restore missed scene/player identities, never combat counters."""
        if not IS_PASSIVE_PROTOCOL_ADAPTER or not isinstance(payload, dict):
            return 0
        game_path = str(payload.get("game_path") or "").strip()
        if not game_path:
            return 0
        from pvp_client_bootstrap import pvp_lifecycle_records

        try:
            log_path = Path(game_path).resolve().parents[2] / "Saved" / "Logs" / "C7.log"
            records = pvp_lifecycle_records(
                log_path,
                include_non_pvp=getattr(parser, "wire_map_id", None) in RECORDABLE_MAPS,
            )
            for record in records:
                write_capture_record(log_handle, record)
                for kind, update in parser.process(record):
                    self._emit_parser_update(parser, kind, update)
                self._emit_completed_pvp_observations(parser)
        except (IndexError, OSError, TypeError, ValueError) as error:
            self._log_experiment_lifecycle(
                "pvp_lifecycle_restore_failed", details=str(error)[:500],
            )
            return 0
        if records:
            self._log_experiment_lifecycle(
                "pvp_lifecycle_restored", records=len(records),
                map_id=records[0]["decoded_arguments"][0]["properties"]["TemplateID"],
            )
        return len(records)

    def request_immediate_settlement(self, payload: object) -> bool:
        """Queue one local experiment request for execution on this thread."""

        if (
            not self.settlement_experiment_query_enabled
            or not isinstance(payload, dict)
        ):
            return False
        self.settlement_experiment_commands.put(dict(payload))
        return True

    def _poll_settlement_experiment(self, driver, game_pid: int) -> None:
        if driver is None:
            return
        while True:
            try:
                command = self.settlement_experiment_commands.get_nowait()
            except queue.Empty:
                break
            driver.arm(command, game_pid=int(game_pid or 0))
        driver.poll()

    def _republish_live_team_ratings(
        self,
        parser: NetworkPacketParser,
        *,
        now: float | None = None,
        capture_client=None,
    ) -> bool:
        """Project the current roster and passive ratings every two seconds."""

        current = time.monotonic() if now is None else float(now)
        if current < self.next_live_team_rating_republish_at:
            return False
        self.next_live_team_rating_republish_at = (
            current + LIVE_TEAM_RATING_REPUBLISH_SECONDS
        )
        unix_ns = time.time_ns()
        source = {
            "method": "PeriodicLiveTeamRatingSnapshot",
            "filetime_100ns": unix_ns // 100 + 116444736000000000,
            "event_time": dt.datetime.now().astimezone().isoformat(),
        }
        roster_flusher = getattr(parser, "flush_live_party_roster", None)
        roster_updates = []
        if callable(roster_flusher):
            roster_updates = list(roster_flusher(now=current) or ())
            for kind, update in roster_updates:
                self._emit_parser_update(parser, kind, update)
            # The roster heartbeat is also an Encounter identity boundary.
            # Feed it through the same detached observation path as Boss
            # edges, otherwise the live HUD updates while the settlement
            # journal keeps departed members in its frozen snapshot.
            if any(
                kind == "party"
                and isinstance(update, dict)
                and update.get("roster_replace") is True
                for kind, update in roster_updates
            ) and getattr(parser, "self_token", None):
                try:
                    from settlement_ui_controller import parser_observation

                    observation = parser_observation(
                        parser,
                        {
                            "method": "LivePartyRosterSnapshot",
                            "decoded_arguments": [],
                            "network_entity_id": getattr(parser, "self_id", 0),
                            "capture_timestamp_ns": unix_ns,
                            "filetime_100ns": unix_ns // 100
                            + 116444736000000000,
                            "npcap_synthetic": True,
                        },
                        roster_updates,
                    )
                except (AttributeError, TypeError, ValueError, KeyError):
                    observation = None
                if observation is not None:
                    self.emit("settlement_observation", observation)
        snapshot_reader = getattr(
            parser, "live_team_rating_snapshot_updates", None
        )
        if not callable(snapshot_reader):
            return False
        token_reader = getattr(parser, "current_team_profile_tokens", None)
        token_writer = getattr(
            capture_client, "set_live_team_profile_tokens", None
        )
        if callable(token_reader) and callable(token_writer):
            token_writer(token_reader())
        updates = snapshot_reader(source)
        for kind, update in updates:
            self._emit_parser_update(parser, kind, update)
        return bool(updates)

    def _process_capture_batch(
        self,
        parser: NetworkPacketParser,
        batch: dict,
        log_handle,
        game_pid: int,
        capture_client=None,
    ) -> bool:
        records = list(batch.get("records", []) or [])
        request_records = list(batch.get("request_records", []) or [])
        native_records = list(batch.get("native_records", []) or [])
        native_boss_records = list(
            batch.get("native_boss_records", []) or []
        )
        # Passive capture supplies read-only initialization in the same entity
        # schema. No native damage or game hook is enabled by these records.
        native_boss_records.extend(batch.get("entity_metadata_records", []) or [])
        native_name_records = list(
            batch.get("native_name_records", []) or []
        )
        native_skill_name_records = list(
            batch.get("native_skill_name_records", []) or []
        )
        team_profile_records = list(
            batch.get("team_profile_records", []) or []
        )
        native_damage_active = bool(
            batch.get("native_damage_hook_installed", False)
        )
        sequence_gaps = list(batch.get("sequence_gaps", []) or [])

        self._add_diagnostic_counts(capture_batches=1)
        if records:
            self._add_diagnostic_counts(network_records=len(records))
            self._update_diagnostics(last_network_record_at=time.time())
        if request_records:
            self._add_diagnostic_counts(
                outbound_request_records=len(request_records)
            )
        if native_records:
            self._add_diagnostic_counts(
                native_damage_records=len(native_records)
            )
            self._update_diagnostics(last_native_damage_at=time.time())
        if native_boss_records:
            self._add_diagnostic_counts(
                native_boss_records=len(native_boss_records)
            )

        if team_profile_records:
            self._add_diagnostic_counts(
                live_team_profile_records=len(team_profile_records)
            )
        if sequence_gaps:
            if IS_PASSIVE_PROTOCOL_ADAPTER:
                self.emit('settlement_capture_gap', {'reason':'network_sequence_gap'})
            self._add_diagnostic_counts(
                network_sequence_gaps=len(sequence_gaps)
            )
            first_gap = sequence_gaps[0]
            self.emit(
                "diagnostic",
                "网络采集序号不连续："
                f"期望 {first_gap.get('expected')}，实际 {first_gap.get('actual')}",
            )

        # Preserve the former worker's processing contract exactly. Native
        # metadata and damage are applied before the network records captured
        # at the beginning of the same polling cycle.
        # Outbound request captures are evidence-only: write them verbatim and
        # never feed their opaque snapshots into the combat parser.
        for record in request_records:
            write_capture_record(log_handle, record)
        for record in native_boss_records:
            self._enrich_boss_record(record, game_pid)
            self._record_native_boss_observation(record)
            write_capture_record(log_handle, record)
            parsed_updates = parser.process_native_boss_type(record)
            self._emit_completed_settlement_observations(parser)
            for kind, update in parsed_updates:
                self.emit(kind, update)
        for record in native_name_records:
            write_capture_record(log_handle, record)
            boss_name_update = parser.apply_runtime_boss_name(record)
            if boss_name_update:
                self.emit(*boss_name_update)
            runtime_name = str(record.get("name", "")).strip()
            if not boss_name_is_placeholder(runtime_name):
                self.emit("name", record)
        for record in native_skill_name_records:
            write_capture_record(log_handle, record)
            self.emit("skill_name", record)
        for record in native_records:
            self._record_native_damage_observation(record)
            write_capture_record(log_handle, record)
            for kind, update in parser.process_native_damage(record):
                self._emit_parser_update(parser, kind, update)
            self._emit_completed_pvp_observations(parser)
        for record in records:
            live_hud_combat = self.live_hud_combat_tracker.ingest(record)
            if live_hud_combat is not None:
                self.emit("live_hud_combat", live_hud_combat)
            live_hud_boss = self.live_hud_boss_tracker.ingest(record)
            if live_hud_boss is not None:
                self.emit("live_hud_boss", live_hud_boss)
            if record.get("method") == EQUIPMENT_PROFILE_RESPONSE_METHOD:
                # The dedicated archive is the durable source for later
                # equipment research.  It is optional enrichment and must
                # never prevent the same batch's combat statistics from
                # reaching the parser.
                try:
                    self.equipment_profiles.handle_response(record)
                except Exception as error:
                    self._log_experiment_lifecycle(
                        "equipment_response_processing_failed",
                        error_type=type(error).__name__,
                        details=str(error)[:1000],
                    )
            write_capture_record(log_handle, record)
            parsed_updates = parser.process(record, include_damage=True)
            # ``parser.process`` can promote a newly created Boss before it
            # returns that entity's profile/HP updates. Publish the promotion
            # first so a busy UI queue never applies new-Boss HP while the old
            # Boss is still selected. The batch-end runtime sync remains the
            # fallback for records that do not produce ordinary updates.
            self._sync_active_boss_cache(parser, game_pid)
            self._emit_completed_settlement_observations(parser)
            for kind, update in parsed_updates:
                # Every decoded team-stat snapshot is useful in the passive
                # receive-only path.  In particular, the server's ordinary
                # TeamStat response carries the authoritative damage/time
                # counters used by the live HUD and encounter settlement.
                # The former hybrid/Npcap gate discarded these updates unless
                # a hook happened to be authoritative, which made the HUD
                # freeze after the first boss or the next challenge.  The
                # training-dummy Common snapshot is handled by the same model
                # path and remains distinguishable via its marker.
                self._emit_parser_update(parser, kind, update)
            self._emit_completed_pvp_observations(parser)
            self._record_team_stats_response_diagnostics(
                record, parsed_updates
            )
            if self.settlement_experiment_enabled:
                summaries = summarize_statistics_record(
                    record,
                    context={
                        "instance_id": getattr(parser, "wire_instance_id", None),
                        "dungeon_id": getattr(parser, "dungeon_id", None),
                        "map_id": getattr(parser, "wire_map_id", None),
                    },
                )
                if summaries:
                    self.emit("settlement_experiment_record", summaries)
        for record in team_profile_records:
            if record.get("method") in {
                "ReadOnlyCurrentDungeonRoster", "ReadOnlyCurrentEncounterContext"
            } and record.get("lua_state_address"):
                self.equipment_profiles.update_lua_state_hint(
                    game_pid, record["lua_state_address"]
                )
            write_capture_record(log_handle, record)
            if record.get("method") == "ReadOnlyCurrentEncounterContext":
                apply_context = getattr(
                    parser, "apply_read_only_encounter_context", None
                )
                if callable(apply_context):
                    apply_context(record)
                continue
            if record.get("method") == "ReadOnlyCurrentDungeonRoster":
                apply_roster = getattr(
                    parser, "apply_read_only_group_roster", None
                )
                updates = (
                    list(apply_roster(record) or ())
                    if callable(apply_roster) else []
                )
                for kind, update in updates:
                    self._emit_parser_update(parser, kind, update)
                if any(
                    kind == "party" and update.get("roster_replace") is True
                    for kind, update in updates
                    if isinstance(update, dict)
                ):
                    from settlement_ui_controller import parser_observation

                    observation = parser_observation(
                        parser,
                        dict(
                            record,
                            method="LivePartyRosterSnapshot",
                            network_entity_id=getattr(parser, "self_id", 0),
                            npcap_synthetic=True,
                        ),
                        updates,
                    )
                    if observation is not None:
                        self.emit("settlement_observation", observation)
                continue
            apply_profile = getattr(
                parser, "apply_read_only_team_profile", None
            )
            if not callable(apply_profile):
                continue
            for kind, update in apply_profile(record):
                self._emit_parser_update(parser, kind, update)

        if time.monotonic() - getattr(self, '_last_capture_log_flush', 0.0) >= 1.0:
            log_handle.flush()
            self._last_capture_log_flush = time.monotonic()

        self._republish_live_team_ratings(
            parser, capture_client=capture_client
        )

        team_status = batch.get("team_status")
        if isinstance(team_status, dict):
            self._update_diagnostics(
                team_stats_hook_installed=bool(
                    team_status.get("installed", False)
                ),
                team_stats_hook_enabled=bool(
                    team_status.get("enabled", False)
                ),
                team_stats_hook_adopted=bool(
                    team_status.get("adopted", False)
                ),
                team_stats_requests=int(
                    team_status.get("request_count", 0) or 0
                ),
                team_stats_last_result=int(
                    team_status.get("last_result", 0) or 0
                ),
                team_stats_last_request_filetime=int(
                    team_status.get("last_request_filetime", 0) or 0
                ),
                outbound_request_captured=int(
                    team_status.get("captured_request_count", 0) or 0
                ),
                outbound_request_dropped=int(
                    team_status.get("dropped_request_count", 0) or 0
                ),
                team_stats_response_health=str(
                    team_status.get("response_health", "inactive")
                    or "inactive"
                )[:48],
                team_stats_data_incomplete=bool(
                    team_status.get("data_incomplete", False)
                ),
                team_stats_response_count=int(
                    team_status.get("response_count", 0) or 0
                ),
                team_stats_last_response_filetime=int(
                    team_status.get("last_response_filetime", 0) or 0
                ),
                team_stats_last_response_age_seconds=(
                    float(team_status["last_response_age_seconds"])
                    if team_status.get("last_response_age_seconds") is not None
                    else None
                ),
                team_stats_last_combat_activity_age_seconds=(
                    float(team_status["last_combat_activity_age_seconds"])
                    if team_status.get("last_combat_activity_age_seconds")
                    is not None
                    else None
                ),
                team_stats_requests_since_response=int(
                    team_status.get("requests_since_response", 0) or 0
                ),
                team_stats_rearm_count=int(
                    team_status.get("rearm_count", 0) or 0
                ),
                team_stats_reinstall_count=int(
                    team_status.get("reinstall_count", 0) or 0
                ),
            )
        return self._sync_parser_runtime_state(parser, game_pid)

    def _sync_hybrid_team_status(self, driver) -> None:
        if driver is None:
            return
        status = driver.status_snapshot()
        self._update_diagnostics(
            team_stats_hybrid_enabled=True,
            team_stats_hook_installed=bool(status.get("installed", False)),
            team_stats_hook_enabled=bool(status.get("enabled", False)),
            team_stats_hook_adopted=bool(status.get("adopted", False)),
            team_stats_requests=int(status.get("request_count", 0) or 0),
            team_stats_last_result=int(status.get("last_result", 0) or 0),
            team_stats_last_request_filetime=int(
                status.get("last_request_filetime", 0) or 0
            ),
            team_stats_request_script_entity=int(
                status.get("script_entity_override", 0) or 0
            ),
            team_stats_request_original_script_entity=int(
                status.get("last_script_entity", 0) or 0
            ),
            team_stats_response_health=str(
                status.get("response_health", "inactive") or "inactive"
            ),
        )

    def _sync_hybrid_receive_status(self, driver) -> None:
        if driver is None:
            self.hybrid_receive_hook_active = False
            self.hybrid_receive_hook_authoritative = False
            return
        status = driver.status_snapshot()
        active = bool(
            status.get("installed", False)
            and status.get("poller_alive", False)
        )
        decoded_count = int(status.get("decoded_response_count", 0) or 0)
        self.hybrid_receive_hook_active = active
        self.hybrid_receive_hook_authoritative = bool(active and decoded_count)
        self._update_diagnostics(
            team_stats_receive_hook_installed=bool(
                status.get("installed", False)
            ),
            team_stats_receive_hook_adopted=bool(
                status.get("adopted", False)
            ),
            team_stats_receive_poller_alive=bool(
                status.get("poller_alive", False)
            ),
            team_stats_receive_hook_records=int(
                status.get("response_count", 0) or 0
            ),
            team_stats_receive_hook_decoded=int(decoded_count),
            team_stats_receive_hook_decode_errors=int(
                status.get("decode_error_count", 0) or 0
            ),
            team_stats_receive_hook_last_filetime=int(
                status.get("last_response_filetime", 0) or 0
            ),
            team_stats_receive_hook_last_method=str(
                status.get("last_method", "") or ""
            )[:64],
            team_stats_receive_hook_sequence_gaps=int(
                status.get("sequence_gap_count", 0) or 0
            ),
            team_stats_receive_hook_authoritative=(
                self.hybrid_receive_hook_authoritative
            ),
            team_stats_local_role_script_entity=int(
                status.get("local_role_script_entity", 0) or 0
            ),
            team_stats_local_role_evidence_method=str(
                status.get("local_role_evidence_method", "") or ""
            )[:64],
        )

    def _process_hybrid_team_records(
        self,
        parser: NetworkPacketParser,
        records: list[dict],
        log_handle,
        game_pid: int,
    ) -> bool:
        """Feed only decoded team snapshots from the receive Hook."""

        for record in records:
            write_capture_record(log_handle, record)
            parsed_updates = parser.process(record, include_damage=True)
            self._emit_completed_settlement_observations(parser)
            for kind, update in parsed_updates:
                self._emit_parser_update(parser, kind, update)
            self._emit_completed_pvp_observations(parser)
            self._record_team_stats_response_diagnostics(
                record, parsed_updates
            )
            if self.settlement_experiment_enabled:
                summaries = summarize_statistics_record(
                    record,
                    context={
                        "instance_id": getattr(
                            parser, "wire_instance_id", None
                        ),
                        "dungeon_id": getattr(parser, "dungeon_id", None),
                        "map_id": getattr(parser, "wire_map_id", None),
                    },
                )
                if summaries:
                    self.emit("settlement_experiment_record", summaries)
        if records:
            log_handle.flush()
        return self._sync_parser_runtime_state(parser, game_pid)

    def _handle_hybrid_team_event(self, payload: object) -> None:
        if not isinstance(payload, dict):
            return
        event = str(payload.get("event", "") or "hybrid_event")
        fields = {key: value for key, value in payload.items() if key != "event"}
        self._log_experiment_lifecycle(
            f"team_stats_{event}",
            **fields,
        )
        if payload.get("local_encounter_id"):
            self.emit("immediate_settlement_experiment", dict(payload))
        if event in {
            "hybrid_install_error",
            "hybrid_runtime_error",
            "hybrid_cleanup_error",
            "hybrid_control_error",
            "hybrid_receive_install_error",
            "hybrid_receive_runtime_error",
            "hybrid_receive_cleanup_error",
        }:
            self.emit(
                "diagnostic",
                f"Hybrid team-stat Hook: {payload.get('details') or event}",
            )

    def _handle_outbound_observer_event(self, payload: object) -> None:
        if not isinstance(payload, dict):
            return
        event = str(payload.get("event", "") or "outbound_observer_event")
        fields = {key: value for key, value in payload.items() if key != "event"}
        self._log_experiment_lifecycle(event, **fields)
        if event == "outbound_observer_installed":
            self._update_diagnostics(outbound_observer_installed=True)
        elif event in {
            "outbound_observer_closed",
            "outbound_observer_install_error",
            "outbound_observer_poll_error",
            "outbound_observer_cleanup_error",
        }:
            self._update_diagnostics(outbound_observer_installed=False)
        if event == "outbound_rpc":
            self._add_diagnostic_counts(outbound_observer_records=1)

    def _handle_capture_diagnostic(self, payload: object) -> None:
        component = str(payload.get("component", "") if isinstance(payload, dict) else "")
        detail = self._capture_detail(payload)
        prefixes = {
            "team_install": "团队精确伤害主动查询不可用",
            "team_detached": "队伍数据查询已断开，正在自动恢复",
            "team_rearm": "队伍数据响应超时，已重新同步",
            "team_reinstall": "队伍数据仍未恢复，已执行一次安全重连",
            "native_install": "原生伤害入口不可用，已使用脚本封包",
            "native_poll": "原生伤害入口已回退",
            "team_status": "读取团队精确查询状态失败",
        }
        prefix = prefixes.get(component, "采集诊断")
        self.emit("diagnostic", f"{prefix}：{detail}" if detail else prefix)
        if component == "native_poll":
            self._update_diagnostics(
                native_damage_hook_installed=False,
                damage_source="script",
            )

    def _handle_cleanup_error(self, payload: object) -> None:
        component = str(payload.get("component", "") if isinstance(payload, dict) else "")
        self._update_diagnostics(
            hook_cleanup_verified=False,
            hook_cleanup_error_component=component,
        )
        detail = self._capture_detail(payload)
        prefixes = {
            "team": "恢复团队精确查询函数失败",
            "native": "恢复原生伤害函数失败",
            "network": "恢复游戏函数失败",
        }
        prefix = prefixes.get(component, "恢复采集函数失败")
        self.emit("error", f"{prefix}：{detail}" if detail else prefix)

    def _shutdown_capture_client(self, capture: CaptureProcessClient) -> None:
        capture.request_stop()
        warning_at = time.monotonic() + CAPTURE_PROCESS_SLOW_SHUTDOWN_SECONDS
        warned = False
        while capture.is_alive():
            try:
                capture.get(timeout=0.05)
            except queue.Empty:
                pass
            capture.join(0)
            if not warned and time.monotonic() >= warning_at:
                warned = True
                self.emit("diagnostic", "采集进程正在继续执行安全清理")

    @staticmethod
    def _capture_batch_heartbeat_overdue(
        *,
        armed: bool,
        shutdown_requested: bool,
        last_batch_at: float,
        now: float,
    ) -> bool:
        return bool(
            armed
            and not shutdown_requested
            and last_batch_at > 0.0
            and now - last_batch_at >= CAPTURE_BATCH_HEARTBEAT_TIMEOUT_SECONDS
        )

    def _stop_stalled_capture_client(
        self,
        capture: CaptureProcessClient,
        *,
        session_id: int,
        last_batch_at: float,
        now: float,
    ) -> bool:
        """Stop a silent live child so the main-window restart path can recover."""

        silence_seconds = max(0.0, now - last_batch_at)
        self._log_experiment_lifecycle(
            "capture_batch_heartbeat_timeout",
            session_id=int(session_id),
            child_pid=int(capture.pid),
            silence_seconds=round(silence_seconds, 3),
        )
        self._add_diagnostic_counts(capture_heartbeat_timeouts=1)
        self._update_diagnostics(
            stage="capture_heartbeat_timeout",
            capture_protocol_ready=False,
        )
        self.emit("diagnostic", "采集数据长时间未更新，正在自动重新连接")
        capture.request_stop()
        capture.join(CAPTURE_STALL_STOP_GRACE_SECONDS)
        forced = bool(capture.is_alive())
        if forced:
            capture.terminate()
            capture.join(CAPTURE_STALL_STOP_GRACE_SECONDS)
        self._log_experiment_lifecycle(
            "capture_stall_stop_completed",
            session_id=int(session_id),
            child_pid=int(capture.pid),
            forced=forced,
            child_alive=bool(capture.is_alive()),
        )
        return forced

    def run(self) -> None:
        log_handle = None
        capture = None
        parser: NetworkPacketParser | None = None
        profile_cache_dirty = False
        last_profile_cache_save = 0.0
        active_session_id = 0
        expected_batch_id = 0
        game_pid = 0
        shutdown_requested = False
        shutdown_warning_at: float | None = None
        shutdown_warning_emitted = False
        child_exit_seen_at: float | None = None
        received_stopped = False
        capture_fatal_seen = False
        capture_heartbeat_armed = False
        last_capture_batch_at = 0.0
        capture_forced_termination = False
        worker_stop_reason = "unknown"
        settlement_driver = None
        outbound_observer = None
        hybrid_team_driver = None
        hybrid_receive_driver = None
        self._log_experiment_lifecycle(
            "worker_thread_started",
            parent_stop_event_set=self.stop_event.is_set(),
            backend=CAPTURE_BACKEND_NAME,
        )
        try:
            with self.runtime_capability_lock:
                capability = self.runtime_capability
            if capability is None:
                raise RuntimeCapabilityError(
                    "capture cannot start without a runtime capability"
                )
            capability = RuntimeCapability.from_value(
                capability,
                expected_session_id=capability.session_id,
                expected_client_id=capability.client_id,
                expected_build_id=capability.build_id,
                expected_client_build=capability.client_build,
                trusted_public_keys=self.trusted_capability_public_keys,
                allow_development=self.allow_development_capability,
            )
            self._log_experiment_lifecycle(
                "runtime_capability_validated",
                expires_at=float(capability.expires_at),
                wall_time=time.time(),
                lease_remaining_seconds=(
                    float(capability.expires_at) - time.time()
                ),
            )
            self.equipment_profiles.start()
            if self.team_stats_hybrid_enabled:
                from hybrid_team_stats import (
                    HybridTeamStatsHookDriver,
                    HybridTeamStatsReceiveDriver,
                )

                hybrid_team_driver = HybridTeamStatsHookDriver(
                    capability.profile,
                    self._handle_hybrid_team_event,
                    interval=self.team_stats_hybrid_interval,
                )
                hybrid_receive_driver = HybridTeamStatsReceiveDriver(
                    capability.profile,
                    self._handle_hybrid_team_event,
                )
            if (
                self.settlement_experiment_query_enabled
                and hybrid_team_driver is None
            ):
                from immediate_settlement_experiment import (
                    OneShotTeamStatsHookDriver,
                )

                settlement_driver = OneShotTeamStatsHookDriver(
                    capability.profile,
                    lambda payload: self.emit(
                        "immediate_settlement_experiment", payload
                    ),
                )
            if (
                self.settlement_experiment_observe_outbound
                and hybrid_team_driver is None
                and settlement_driver is None
            ):
                from immediate_settlement_experiment import (
                    PassiveOutboundRpcObserver,
                )

                outbound_observer = PassiveOutboundRpcObserver(
                    capability.profile,
                    self._handle_outbound_observer_event,
                )
            self.boss_name_resolver.start()
            LOG_DIR.mkdir(parents=True, exist_ok=True)
            log_path = LOG_DIR / time.strftime("network_%Y%m%d_%H%M%S.jsonl")
            log_handle = log_path.open("a", encoding="utf-8", buffering=256 * 1024)
            target_boss_lookup_sent = (
                self.target_boss_lookup_event.is_set()
            )
            capture = CaptureProcessClient(
                runtime_capability=capability,
                allow_development=self.allow_development_capability,
                trusted_public_keys=self.trusted_capability_public_keys,
                parent_pid=os.getpid(),
                target_boss_lookup_enabled=target_boss_lookup_sent,
                team_stats_mode=TEAM_STATS_MODE_UNKNOWN,
            )
            with self.runtime_capability_lock:
                self.capture_client = capture
            self.team_stats_mode = TEAM_STATS_MODE_NAMES[TEAM_STATS_MODE_UNKNOWN]
            self.team_stats_mode_reason = "capture_session_start"
            capture.start()
            self._log_experiment_lifecycle(
                "capture_child_started",
                child_pid=capture.pid,
                network_log=str(log_path),
            )
            self._update_diagnostics(
                stage="capture_process_starting",
                capture_process_pid=capture.pid,
                team_stats_mode=self.team_stats_mode,
                team_stats_mode_reason=self.team_stats_mode_reason,
            )

            while True:
                now = time.monotonic()
                # Keep roster/rating publication independent of capture queue
                # pressure.  A busy stream can otherwise postpone the 2-second
                # leave/change refresh indefinitely because the old call lived
                # only in ``queue.Empty`` handling.
                if parser is not None:
                    self._republish_live_team_ratings(
                        parser,
                        now=now,
                        capture_client=capture,
                    )
                self._service_equipment_hook_commands(
                    hybrid_team_driver,
                    game_pid,
                )
                if hybrid_team_driver is not None:
                    hybrid_receive_driver.sync(game_pid=game_pid)
                    hybrid_records = hybrid_receive_driver.poll()
                    self._sync_hybrid_receive_status(hybrid_receive_driver)
                    receive_status = (
                        hybrid_receive_driver.status_snapshot()
                    )
                    if not self.equipment_team_hook_paused:
                        hybrid_team_driver.sync(
                            game_pid=game_pid,
                            mode=self.team_stats_mode,
                            script_entity_override=receive_status.get(
                                "local_role_script_entity", 0
                            ),
                        )
                    if parser is not None and hybrid_records:
                        profile_cache_dirty = (
                            self._process_hybrid_team_records(
                                parser,
                                hybrid_records,
                                log_handle,
                                game_pid,
                            )
                            or profile_cache_dirty
                        )
                    if not self.equipment_team_hook_paused:
                        self._poll_settlement_experiment(
                            hybrid_team_driver,
                            game_pid,
                        )
                    self._sync_hybrid_team_status(hybrid_team_driver)
                else:
                    self._poll_settlement_experiment(settlement_driver, game_pid)
                if outbound_observer is not None:
                    outbound_observer.sync(game_pid=game_pid)
                    outbound_records = outbound_observer.poll()
                    if outbound_records:
                        for record in outbound_records:
                            write_capture_record(log_handle, record)
                        if (
                            time.monotonic()
                            - getattr(self, "_last_capture_log_flush", 0.0)
                            >= 1.0
                        ):
                            log_handle.flush()
                            self._last_capture_log_flush = time.monotonic()
                target_boss_lookup_enabled = (
                    self.target_boss_lookup_event.is_set()
                )
                if target_boss_lookup_enabled != target_boss_lookup_sent:
                    capture.set_target_boss_lookup_enabled(
                        target_boss_lookup_enabled
                    )
                    target_boss_lookup_sent = target_boss_lookup_enabled
                if self.stop_event.is_set() and not shutdown_requested:
                    worker_stop_reason = "parent_stop_event"
                    self._log_experiment_lifecycle(
                        "parent_stop_event_observed",
                        child_pid=capture.pid,
                    )
                    capture.request_stop()
                    shutdown_requested = True
                    shutdown_warning_at = (
                        now + CAPTURE_PROCESS_SLOW_SHUTDOWN_SECONDS
                    )
                if (
                    shutdown_warning_at is not None
                    and not shutdown_warning_emitted
                    and now >= shutdown_warning_at
                    and capture.is_alive()
                ):
                    shutdown_warning_emitted = True
                    self.emit("diagnostic", "采集进程正在继续执行安全清理")

                try:
                    kind, payload = capture.get(timeout=0.05)
                    child_exit_seen_at = None
                except queue.Empty:
                    if profile_cache_dirty and now - last_profile_cache_save >= 1.0:
                        write_json_object(
                            TEAM_PROFILE_CACHE_PATH,
                            self.team_profile_cache,
                        )
                        profile_cache_dirty = False
                        last_profile_cache_save = now
                    if capture.is_alive() and self._capture_batch_heartbeat_overdue(
                        armed=capture_heartbeat_armed,
                        shutdown_requested=shutdown_requested,
                        last_batch_at=last_capture_batch_at,
                        now=now,
                    ):
                        worker_stop_reason = "capture_batch_heartbeat_timeout"
                        capture_heartbeat_armed = False
                        capture_forced_termination = self._stop_stalled_capture_client(
                            capture,
                            session_id=active_session_id,
                            last_batch_at=last_capture_batch_at,
                            now=now,
                        )
                        break
                    if capture.is_alive():
                        continue
                    if child_exit_seen_at is None:
                        child_exit_seen_at = now
                        continue
                    if now - child_exit_seen_at < 0.1:
                        continue
                    if not received_stopped and not self.stop_event.is_set():
                        worker_stop_reason = "capture_process_exited"
                        self._update_diagnostics(stage="capture_process_exited")
                        self.emit("fatal", "采集进程意外退出")
                    break

                if kind == "process_started" and isinstance(payload, dict):
                    self._log_experiment_lifecycle(
                        "capture_process_started",
                        child_pid=int(payload.get("pid", 0) or 0),
                        backend=str(
                            payload.get("capture_backend", CAPTURE_BACKEND_NAME)
                        ),
                        npcap_capture_active=bool(
                            payload.get("npcap_capture_active", False)
                        ),
                        passive_capture_active=bool(
                            payload.get("passive_capture_active", False)
                        ),
                        raw_socket_capture_active=bool(
                            payload.get("raw_socket_capture_active", False)
                        ),
                    )
                    self._update_diagnostics(
                        capture_process_pid=int(payload.get("pid", 0) or 0),
                        capture_process_priority=str(
                            payload.get("priority_class", "default")
                        ),
                        capture_process_priority_applied=bool(
                            payload.get("priority_applied", False)
                        ),
                        capture_backend=str(
                            payload.get("capture_backend", CAPTURE_BACKEND_NAME)
                        ),
                        npcap_capture_active=bool(
                            payload.get("npcap_capture_active", False)
                        ),
                        passive_capture_active=bool(
                            payload.get("passive_capture_active", False)
                        ),
                        raw_socket_capture_active=bool(
                            payload.get("raw_socket_capture_active", False)
                        ),
                    )
                elif kind == "state" and isinstance(payload, dict):
                    stage = str(payload.get("stage", ""))
                    if payload.get("capture_protocol_ready") is False:
                        # Waiting for a new connection is an explicit parser
                        # state, not a frozen child. It may legitimately emit
                        # only a 15-second state heartbeat.
                        capture_heartbeat_armed = False
                    if stage == "locating_decryption_state":
                        self._publish_startup_self_profile(payload, live=False)
                    self._log_experiment_lifecycle(
                        "capture_state",
                        stage=stage,
                        process_found=bool(payload.get("process_found", False)),
                    )
                    self._update_diagnostics(**payload)
                    if stage == "game_not_found":
                        self.emit("waiting", "游戏未运行")
                    elif stage == "game_exited" and not self.stop_event.is_set():
                        self.emit("waiting", "游戏已退出")
                elif kind == "startup_self_profile" and isinstance(payload, dict):
                    if parser is not None:
                        apply_local_profile = getattr(
                            parser,
                            "apply_authoritative_local_profile",
                            None,
                        )
                        if callable(apply_local_profile):
                            for update_kind, update_payload in (
                                apply_local_profile(payload) or []
                            ):
                                self._emit_parser_update(
                                    parser,
                                    update_kind,
                                    update_payload,
                                )
                    if self._publish_startup_self_profile(payload, live=True):
                        profile_cache_dirty = True
                elif kind == "connected" and isinstance(payload, dict):
                    capture_heartbeat_armed = False
                    last_capture_batch_at = 0.0
                    next_game_pid = int(payload.get("game_pid", 0) or 0)
                    self._log_experiment_lifecycle(
                        "capture_connected",
                        game_pid=next_game_pid,
                        session_id=int(payload.get("session_id", 0) or 0),
                        npcap_capture_active=bool(
                            payload.get("npcap_capture_active", False)
                        ),
                    )
                    replacing_capture_session = parser is not None
                    same_game_process = bool(
                        replacing_capture_session
                        and game_pid
                        and next_game_pid == game_pid
                    )
                    if parser is not None:
                        pending_cache = parser.take_team_profile_cache()
                        if pending_cache is not None:
                            self.team_profile_cache = pending_cache
                            profile_cache_dirty = True
                    if replacing_capture_session and not same_game_process:
                        # A different game process is a hard role boundary.
                        # Same-PID transport resynchronization is not: the
                        # adapter must retain the current actor, roster, Boss
                        # and pending settlement so it can explicitly emit an
                        # identity_session_reset if the local actor later
                        # proves to have changed.
                        self.last_emitted_self_identity = {}
                        self.last_emitted_dungeon_context = {}
                        if self.self_identity_cache:
                            self.self_identity_cache = {}
                            write_json_object(
                                SELF_IDENTITY_CACHE_PATH,
                                self.self_identity_cache,
                            )
                        if self.active_boss_cache:
                            self._set_active_boss_cache({})
                    active_session_id = int(payload.get("session_id", 0) or 0)
                    expected_batch_id = 0
                    game_pid = next_game_pid
                    previous_equipment_pid = self.equipment_game_pid
                    self.equipment_capture_session_id = active_session_id
                    self.equipment_game_pid = game_pid
                    if (
                        previous_equipment_pid
                        and previous_equipment_pid != game_pid
                    ):
                        self.equipment_profiles.invalidate(
                            "game_process_changed"
                        )
                    # Resolve the stable request descriptor in the background
                    # while the user is still entering the game/team. This is
                    # read-only and sends no equipment request.
                    self.equipment_profiles.prepare(game_pid)
                    if not same_game_process:
                        parser = self._create_network_parser(
                            game_pid,
                            allow_remembered_identity=not replacing_capture_session,
                        )
                    self._restore_pvp_lifecycle_context(parser, payload, log_handle)
                    self.next_live_team_rating_republish_at = 0.0
                    self.team_stats_last_snapshot_total = None
                    connected_team_mode = team_stats_mode_name(
                        payload.get(
                            "team_stats_mode", TEAM_STATS_MODE_UNKNOWN
                        )
                    )
                    connected_team_installed = bool(
                        payload.get("team_stats_hook_installed", False)
                    )
                    self._update_diagnostics(
                        stage="capturing",
                        process_found=True,
                        passive_capture_active=bool(
                            payload.get("passive_capture_active", False)
                        ),
                        raw_socket_capture_active=bool(
                            payload.get("raw_socket_capture_active", False)
                        ),
                        capture_backend=str(
                            payload.get("capture_backend", CAPTURE_BACKEND_NAME)
                        ),
                        npcap_capture_active=bool(
                            payload.get("npcap_capture_active", False)
                        ),
                        capture_protocol_ready=False,
                        network_hook_installed=not IS_PASSIVE_PROTOCOL_ADAPTER,
                        network_hook_adopted=bool(
                            payload.get("network_hook_adopted", False)
                        ),
                        native_damage_hook_installed=bool(
                            payload.get("native_damage_hook_installed", False)
                        ),
                        native_damage_hook_adopted=bool(
                            payload.get("native_damage_hook_adopted", False)
                        ),
                        team_stats_hook_installed=connected_team_installed,
                        team_stats_hook_adopted=bool(
                            payload.get("team_stats_hook_adopted", False)
                        ),
                        team_stats_hook_enabled=bool(
                            connected_team_installed
                            and connected_team_mode == "team"
                        ),
                        team_stats_response_health=(
                            "passive_windows_raw"
                            if IS_PASSIVE_PROTOCOL_ADAPTER
                            else
                            "waiting_response"
                            if connected_team_installed
                            and connected_team_mode == "team"
                            else "inactive"
                        ),
                        team_stats_data_incomplete=False,
                        team_stats_response_count=0,
                        team_stats_last_response_filetime=0,
                        team_stats_last_response_age_seconds=None,
                        team_stats_last_combat_activity_age_seconds=None,
                        team_stats_requests_since_response=0,
                        team_stats_rearm_count=0,
                        team_stats_reinstall_count=0,
                        team_stats_parsed_responses=0,
                        team_stats_empty_responses=0,
                        team_stats_last_member_count=0,
                        team_stats_last_damage_total=0,
                        team_stats_damage_progress_count=0,
                        team_stats_last_progress_filetime=0,
                        hook_cleanup_verified=False,
                        hook_cleanup_components={},
                        team_stats_mode=connected_team_mode,
                        damage_source=str(payload.get("damage_source", "none")),
                        game_pid=game_pid,
                    )
                    self.team_stats_mode = connected_team_mode
                    self.team_stats_mode_reason = "child_connected"
                    self.emit(
                        "connected",
                        {
                            "pid": game_pid,
                            "log": str(log_path),
                            "session_id": active_session_id,
                        },
                    )
                    restored_boss = bool(
                        same_game_process
                        or (
                            not replacing_capture_session
                            and self._restore_same_process_boss(parser, game_pid)
                        )
                    )
                    self._update_diagnostics(boss_state_restored=restored_boss)
                elif kind == "capture_ready" and isinstance(payload, dict):
                    ready_session_id = int(payload.get("session_id", 0) or 0)
                    ready_game_pid = int(payload.get("game_pid", 0) or 0)
                    if (
                        ready_session_id == active_session_id
                        and ready_game_pid == game_pid
                    ):
                        capture_heartbeat_armed = True
                        last_capture_batch_at = time.monotonic()
                        self._log_experiment_lifecycle(
                            "capture_ready",
                            session_id=ready_session_id,
                            game_pid=ready_game_pid,
                            protocol_application_messages=int(
                                payload.get("protocol_application_messages", 0)
                                or 0
                            ),
                        )
                        self._update_diagnostics(
                            capture_protocol_ready=True,
                            capture_transport=payload.get('capture_transport', 'unknown'),
                            protocol_application_messages=int(
                                payload.get(
                                    "protocol_application_messages", 0
                                )
                                or 0
                            ),
                        )
                        self.emit(
                            "capture_ready",
                            {
                                "pid": game_pid,
                                "session_id": active_session_id,
                            },
                        )
                elif kind == "batch" and isinstance(payload, dict):
                    batch_session_id = int(payload.get("session_id", 0) or 0)
                    batch_id = int(payload.get("batch_id", -1))
                    if parser is None or batch_session_id != active_session_id:
                        self.emit(
                            "diagnostic",
                            f"忽略无对应会话的采集批次：{batch_session_id}/{batch_id}",
                        )
                        continue
                    last_capture_batch_at = time.monotonic()
                    if batch_id != expected_batch_id:
                        self.emit(
                            "diagnostic",
                            "采集批次序号不连续："
                            f"期望 {expected_batch_id}，实际 {batch_id}",
                        )
                    expected_batch_id = batch_id + 1
                    self._log_experiment_lifecycle(
                        "capture_batch_started",
                        session_id=batch_session_id,
                        batch_id=batch_id,
                        records=len(payload.get("records", []) or []),
                        metadata_records=len(
                            payload.get("entity_metadata_records", []) or []
                        ),
                        team_profile_records=len(
                            payload.get("team_profile_records", []) or []
                        ),
                    )
                    try:
                        batch_cache_dirty = self._process_capture_batch(
                            parser,
                            payload,
                            log_handle,
                            game_pid,
                            capture_client=capture,
                        )
                        self._apply_team_stats_mode(capture, parser, payload)
                        self._sync_hybrid_team_status(hybrid_team_driver)
                        self._sync_hybrid_receive_status(hybrid_receive_driver)
                    except Exception as error:
                        self._log_experiment_lifecycle(
                            "capture_batch_failed",
                            session_id=batch_session_id,
                            batch_id=batch_id,
                            error_type=type(error).__name__,
                            details=traceback.format_exc()[-12000:],
                        )
                        self._add_diagnostic_counts(capture_batch_failures=1)
                        self.emit(
                            "diagnostic",
                            f"采集批次 {batch_id} 解析失败，已跳过并继续采集。",
                        )
                        continue
                    profile_cache_dirty = (
                        batch_cache_dirty or profile_cache_dirty
                    )
                    self._log_experiment_lifecycle(
                        "capture_batch_completed",
                        session_id=batch_session_id,
                        batch_id=batch_id,
                    )
                elif kind == "protocol_unknown" and isinstance(payload, list):
                    samples = [row for row in payload if isinstance(row, dict)]
                    if samples:
                        self._add_diagnostic_counts(
                            protocol_unknown_samples=len(samples)
                        )
                        for sample in samples:
                            write_capture_record(
                                log_handle,
                                {
                                    "event_time": dt.datetime.now().astimezone().isoformat(),
                                    "capture_source": self.diagnostics.get(
                                        "capture_backend", CAPTURE_BACKEND_NAME
                                    ),
                                    "diagnostic_type": "protocol_unknown",
                                    **sample,
                                },
                            )
                        log_handle.flush()
                elif kind == "capture_gap":
                    gap_payload = payload if isinstance(payload, dict) else {}
                    gap_reason = str(
                        gap_payload.get('reason')
                        or 'network_sequence_gap'
                    )
                    settlement_gap = settlement_capture_gap_reason(gap_payload)
                    if settlement_gap is not None:
                        self._add_diagnostic_counts(network_sequence_gaps=1)
                        self._update_diagnostics(team_stats_data_incomplete=True)
                        self.emit(
                            'settlement_capture_gap',
                            {
                                'reason': settlement_gap,
                                'capture_source': gap_payload.get(
                                    'capture_source', CAPTURE_BACKEND_NAME
                                ),
                            },
                        )
                    else:
                        # Switching to another complete KCP flow is a normal
                        # passive-capture resynchronization. It remains visible
                        # in diagnostics but must not poison settlement matching.
                        self.emit(
                            "diagnostic",
                            f"Passive capture flow changed: {gap_reason}",
                        )
                elif kind == "diagnostic":
                    self._handle_capture_diagnostic(payload)
                elif kind == "cleanup_error":
                    self._handle_cleanup_error(payload)
                elif kind == "capture_error":
                    stage = str(
                        payload.get("stage", "capture_failed")
                        if isinstance(payload, dict)
                        else "capture_failed"
                    )
                    self._update_diagnostics(stage=stage)
                    detail = self._capture_detail(payload)
                    prefix = "连接失败" if stage == "network_hook_failed" else "采集异常"
                    recoverable = bool(
                        isinstance(payload, dict)
                        and payload.get("recoverable") is True
                    )
                    if recoverable and isinstance(payload, dict) and (
                        payload.get("awaiting_connection_change")
                        or payload.get("awaiting_game_traffic")
                        or payload.get("awaiting_initial_state")
                        or payload.get("requires_new_connection_initialization")
                    ):
                        capture_heartbeat_armed = False
                    self._log_experiment_lifecycle(
                        "capture_error",
                        stage=stage,
                        recoverable=recoverable,
                        details=detail[:1000],
                    )
                    if (
                        recoverable
                        and isinstance(payload, dict)
                        and (payload.get('awaiting_connection_change') or payload.get('awaiting_game_traffic') or payload.get('awaiting_initial_state'))
                    ):
                        self._update_diagnostics(
                            capture_protocol_ready=False,
                            capture_transport=payload.get('capture_transport', 'unknown'),
                        )
                        self.emit('capture_waiting', {
                            'pid': int(payload.get('game_pid', game_pid) or 0),
                            'session_id': int(payload.get('session_id', active_session_id) or 0),
                            'reason': ('initial_state' if payload.get('awaiting_initial_state')
                                       else 'game_traffic' if payload.get('awaiting_game_traffic')
                                       else 'connection_change'),
                            'details': detail,
                        })
                    elif (
                        recoverable
                        and isinstance(payload, dict)
                        and payload.get("requires_new_connection_initialization")
                    ):
                        # The previous stream is no longer decryptable. Tell the
                        # main window immediately; waiting for the next
                        # ``connected`` event leaves a misleading ready window
                        # while RC4/Zstd state is being located again.
                        self.emit(
                            "capture_initializing",
                            {
                                "pid": game_pid,
                                "session_id": active_session_id,
                                "reason": "resynchronizing",
                            },
                        )
                    self.emit(
                        "diagnostic" if recoverable else "error",
                        f"{prefix}：{detail}" if detail else prefix,
                    )
                elif kind == "session_closed" and isinstance(payload, dict):
                    capture_heartbeat_armed = False
                    # Scene changes close one transport before opening the next
                    # one in the same game process.  Equipment belongs to the
                    # role/team lifetime and must survive that hand-off.
                    self.equipment_capture_session_id = 0
                    closed_mode = team_stats_mode_name(
                        payload.get("team_stats_mode", self.team_stats_mode)
                    )
                    self.team_stats_mode = closed_mode
                    self.team_stats_mode_reason = "session_closed"
                    self._update_diagnostics(
                        network_hook_installed=False,
                        native_damage_hook_installed=False,
                        team_stats_hook_installed=False,
                        team_stats_hook_enabled=False,
                        team_stats_response_health="inactive",
                        team_stats_mode=closed_mode,
                        team_stats_mode_reason="session_closed",
                        hook_cleanup_verified=bool(
                            payload.get("hook_cleanup_verified", False)
                        ),
                        hook_cleanup_components=dict(
                            payload.get("hook_cleanup_components", {})
                            if isinstance(
                                payload.get("hook_cleanup_components"), dict
                            )
                            else {}
                        ),
                        damage_source="none",
                        npcap_capture_active=False,
                        passive_capture_active=False,
                        raw_socket_capture_active=False,
                        capture_protocol_ready=False,
                    )
                elif kind == "fatal":
                    capture_fatal_seen = True
                    fatal_fields = payload if isinstance(payload, dict) else {}
                    self._log_experiment_lifecycle(
                        "capture_fatal",
                        stage=str(fatal_fields.get("stage", ""))[:96],
                        error_code=capture_failure_error_code(payload),
                        details=str(payload or "")[-2000:],
                    )
                    self._update_diagnostics(stage="fatal")
                    self.emit("fatal", payload)
                elif kind == "runtime_capability_expired":
                    self._log_experiment_lifecycle(
                        "capture_child_runtime_capability_expired",
                        payload=(payload if isinstance(payload, dict) else {}),
                    )
                    self._update_diagnostics(stage="runtime_capability_expired")
                    self.emit(
                        "license_capture_expired",
                        None,
                    )
                elif kind == "stopped":
                    received_stopped = True
                    if not capture_fatal_seen:
                        worker_stop_reason = str(
                            payload.get("reason", "capture_child_stopped")
                            if isinstance(payload, dict)
                            else "capture_child_stopped"
                        )
                    self._log_experiment_lifecycle(
                        "capture_child_stopped",
                        payload=(payload if isinstance(payload, dict) else {}),
                        parent_stop_event_set=self.stop_event.is_set(),
                    )
                    capture.join(1.0)
                    if not capture.is_alive():
                        break

                now = time.monotonic()
                if profile_cache_dirty and now - last_profile_cache_save >= 1.0:
                    write_json_object(
                        TEAM_PROFILE_CACHE_PATH,
                        self.team_profile_cache,
                    )
                    profile_cache_dirty = False
                    last_profile_cache_save = now
        except Exception as error:
            worker_stop_reason = "worker_exception"
            self._log_experiment_lifecycle(
                "worker_exception",
                error_type=type(error).__name__,
                details=traceback.format_exc()[-12000:],
            )
            self._update_diagnostics(stage="fatal")
            self.emit("fatal", traceback.format_exc())
        finally:
            self._log_experiment_lifecycle(
                "worker_finalizing",
                received_child_stopped=received_stopped,
                parent_stop_event_set=self.stop_event.is_set(),
                child_alive=bool(capture is not None and capture.is_alive()),
            )
            self.equipment_profiles.close()
            self.equipment_capture_session_id = 0
            self.equipment_game_pid = 0
            if settlement_driver is not None:
                settlement_driver.close()
            if outbound_observer is not None:
                outbound_observer.close()
            if hybrid_team_driver is not None:
                hybrid_team_driver.close()
            if hybrid_receive_driver is not None:
                hybrid_receive_driver.close()
            self.hybrid_receive_hook_active = False
            self.hybrid_receive_hook_authoritative = False
            with self.runtime_capability_lock:
                self.capture_client = None
            if capture is not None:
                try:
                    if capture.is_alive():
                        self._shutdown_capture_client(capture)
                finally:
                    try:
                        capture.close(
                            wait_for_queue=not capture_forced_termination
                        )
                    except TypeError:
                        capture.close()
                    except Exception:
                        pass
            if parser is not None:
                pending_cache = parser.take_team_profile_cache()
                if pending_cache is not None:
                    self.team_profile_cache = pending_cache
                    profile_cache_dirty = True
            if profile_cache_dirty:
                write_json_object(TEAM_PROFILE_CACHE_PATH, self.team_profile_cache)
            if log_handle:
                log_handle.close()
            self._update_diagnostics(
                stage="stopped",
                network_hook_installed=False,
                native_damage_hook_installed=False,
                team_stats_hook_installed=False,
                team_stats_hook_enabled=False,
                team_stats_response_health="inactive",
                damage_source="none",
                npcap_capture_active=False,
                passive_capture_active=False,
                raw_socket_capture_active=False,
                capture_process_pid=0,
            )
            self.emit(
                "stopped",
                {
                    "reason": worker_stop_reason,
                    "requested": bool(self.stop_event.is_set()),
                    "received_child_stopped": received_stopped,
                    "terminal": capture_fatal_seen,
                },
            )
            self._log_experiment_lifecycle(
                "worker_thread_stopped",
                received_child_stopped=received_stopped,
            )


class MetadataWorker(threading.Thread):
    def __init__(self, messages: queue.Queue, stop_event: threading.Event):
        super().__init__(name="C7RuntimeMetadata", daemon=False)
        self.messages = messages
        self.stop_event = stop_event

    def emit(self, kind: str, payload=None) -> None:
        self.messages.put((kind, payload))

    def run(self) -> None:
        # Kept only for the unused legacy window class. Runtime identity now
        # comes exclusively from decoded network packets in HookWorker.
        return


