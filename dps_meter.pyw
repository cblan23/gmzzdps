    def _close_user_notice(self) -> None:
        window = self.user_notice_window
        if window is not None and window.winfo_exists():
            try:
                window.grab_release()
            except tk.TclError:
                pass
            window.destroy()
        self.user_notice_window = None
        parent = self.login_window
        if (
            not self.closing
            and parent is not None
            and parent.winfo_exists()
        ):
            parent.lift()
            parent.focus_force()

    def _show_login_placeholder(self) -> None:
        entry = self.login_card_entry
        if entry is None or not entry.winfo_exists() or entry.get():
            return
        self.login_placeholder_active = True
        entry.configure(fg=MUTED)
        entry.insert(0, "请输入卡号")

    def _login_entry_focus_in(self, _event=None) -> None:
        entry = self.login_card_entry
        if entry is None:
            return
        if self.login_placeholder_active:
            entry.icursor(0)

    def _login_entry_prepare_input(self, _event=None) -> None:
        entry = self.login_card_entry
        if entry is None or not self.login_placeholder_active:
            return
        entry.delete(0, "end")
        entry.configure(fg=TEXT)
        self.login_placeholder_active = False

    def _login_entry_key_press(self, event=None) -> None:
        if event is not None and event.keysym in {
            "Control_L",
            "Control_R",
            "Shift_L",
            "Shift_R",
            "Alt_L",
            "Alt_R",
            "Tab",
        }:
            return
        self._login_entry_prepare_input()

    def _login_entry_focus_out(self, _event=None) -> None:
        entry = self.login_card_entry
        if entry is None or entry.get().strip():
            return
        self._show_login_placeholder()

    def _set_login_status(self, message: str, *, error: bool = True) -> None:
        self.login_status_message = str(message).strip()
        if self.login_status_label is not None and self.login_status_label.winfo_exists():
            display_message = self.login_status_message or LOGIN_ADMIN_REMINDER
            foreground = (
                ERROR
                if self.login_status_message and error
                else MUTED
                if self.login_status_message
                else WARN
            )
            self.login_status_label.configure(
                text=display_message,
                fg=foreground,
            )
            self._fit_login_window()

    def _login_disclaimer_accepted(self) -> bool:
        return bool(
            self.login_disclaimer_var is not None
            and self.login_disclaimer_var.get()
        )

    def _sync_login_disclaimer_state(self, *, hover: bool = False) -> None:
        button = self.login_button
        if button is None or not button.winfo_exists():
            return
        accepted = self._login_disclaimer_accepted()
        button.configure(
            bg="#86edca" if accepted and hover else ACCENT if accepted else PANEL_2,
            fg="#07110e" if accepted else SUBTLE,
            cursor="hand2" if accepted else "arrow",
        )

    def _sync_login_trial_button_state(self, *, hover: bool = False) -> None:
        button = self.login_trial_button
        if button is None or not button.winfo_exists():
            return
        pending = bool(self.trial_claim_in_progress)
        button.configure(
            text="获取中" if pending else "获取试用",
            bg=PANEL_2 if hover and not pending else PANEL,
            fg=MUTED if pending else "#86edca" if hover else ACCENT,
            cursor="arrow" if pending else "hand2",
        )

    def _request_trial_card(self) -> None:
        if (
            self.closing
            or self.authorization_resetting
            or self.trial_claim_in_progress
        ):
            return
        self.trial_claim_in_progress = True
        self._sync_login_trial_button_state()
        self._set_login_status("正在获取试用卡…", error=False)

        def claim() -> None:
            try:
                result = self.licensing.claim_trial_card()
            except LicensingConnectionError:
                result = TrialClaim(False, TRIAL_CLAIM_FAILURE_MESSAGE)
            except Exception:
                result = TrialClaim(False, TRIAL_CLAIM_FAILURE_MESSAGE)
            self.control_messages.put(("trial_claim_result", result))

        threading.Thread(
            target=claim, name="trial-card-claim", daemon=True
        ).start()

    def _handle_trial_claim_result(self, payload: object) -> None:
        self.trial_claim_in_progress = False
        self._sync_login_trial_button_state()
        if not isinstance(payload, TrialClaim):
            self._set_login_status(TRIAL_CLAIM_FAILURE_MESSAGE)
            return
        if not payload.accepted or not payload.card_key:
            self._set_login_status(payload.message or TRIAL_CLAIM_FAILURE_MESSAGE)
            return
        entry = self.login_card_entry
        if entry is None or not entry.winfo_exists():
            return
        entry.delete(0, "end")
        entry.configure(fg=TEXT)
        entry.insert(0, payload.card_key)
        entry.selection_range(0, "end")
        entry.icursor("end")
        self.login_placeholder_active = False
        self._set_login_status(
            payload.message or "2 小时试用卡领取成功，请点击“登录”。",
            error=False,
        )
        entry.focus_set()

    def _complete_card_login(self) -> None:
        if self.closing or self.authorization_resetting:
            return
        if bool(getattr(self, "trial_claim_in_progress", False)):
            self._set_login_status("正在获取试用卡，请稍候。", error=False)
            return
        if not self._login_disclaimer_accepted():
            self._set_login_status("请先阅读并同意用户须知。")
            self._sync_login_disclaimer_state()
            return
        card_key = (
            self.login_card_entry.get().strip()
            if self.login_card_entry is not None
            and not self.login_placeholder_active
            else ""
        )
        if not card_key:
            self._set_login_status("请输入卡号后再登录。")
            return
        if self.login_button is not None:
            self.login_button.configure(text="正在验证", bg=PANEL_2, fg=MUTED)
        if self.login_window is not None:
            self.login_window.update_idletasks()
        try:
            session = self.licensing.sign_in_card(card_key)
        except LicensingConnectionError as exc:
            self._set_login_status(str(exc))
            if self.login_button is not None:
                self.login_button.configure(text="登录", bg=ACCENT, fg="#07110e")
            return
        if not session.active:
            self._set_login_status(
                session.display_name
                or "登录失败，请稍后重试；若持续出现，请联系管理员。"
            )
            if self.login_button is not None:
                self.login_button.configure(text="登录", bg=ACCENT, fg="#07110e")
            return
        try:
            capability = session.runtime_capability
            if capability is None:
                if RELEASE_IDENTITY.protected:
                    raise RuntimeCapabilityError(
                        "受保护客户端未取得服务器下发的采集授权"
                    )
                capability = create_development_capability(
                    DEVELOPMENT_RUNTIME_PROFILE_PATH,
                    session_id=session.session_id,
                    client_id=self.client_id,
                    build_id=RELEASE_IDENTITY.build_id,
                    client_build=CLIENT_BUILD,
                )
                session = self.licensing.set_runtime_capability(capability)
            else:
                capability = RuntimeCapability.from_value(
                    capability,
                    expected_session_id=session.session_id,
                    expected_client_id=self.client_id,
                    expected_build_id=RELEASE_IDENTITY.build_id,
                    expected_client_build=CLIENT_BUILD,
                    trusted_public_keys=(
                        RELEASE_IDENTITY.capability_public_keys
                    ),
                    allow_development=not RELEASE_IDENTITY.protected,
                )
        except RuntimeCapabilityError as exc:
            try:
                self.licensing.sign_out()
            except LicensingConnectionError:
                pass
            self._set_login_status(
                SYSTEM_TIME_SYNC_MESSAGE
                if isinstance(exc, RuntimeCapabilityTimeError)
                else CARD_LOGIN_FAILURE_MESSAGE
            )
            if self.login_button is not None:
                self.login_button.configure(text="登录", bg=ACCENT, fg="#07110e")
            return
        pvp_recording = getattr(self, "pvp_recording", None)
        if pvp_recording is not None:
            # The raw card is never persisted with PVP history.  A salted,
            # device-local digest gives crash recovery and the upload outbox a
            # stable owner across application restarts.
            pvp_account_key = hashlib.sha256(
                (
                    f"{self.client_id}\0"
                    f"{str(card_key).strip().upper()}"
                ).encode("utf-8")
            ).hexdigest()
            pvp_recording.bind_account(pvp_account_key)
            pvp_uploader = getattr(self, "pvp_upload_worker", None)
            if pvp_uploader is not None:
                pvp_session = replace(self.licensing.session)
                pvp_gateway = self.licensing.gateway
                pvp_uploader.bind_request(
                    pvp_account_key,
                    lambda action, payload: pvp_gateway.pvp_request(pvp_session, action, payload),
                )
                pvp_uploader.start()
                pvp_uploader.wake()
        if remember_card(self.config, card_key):
            save_config(self.config)
        if self._login_disclaimer_accepted() and not bool(
            self.config.get("user_notice_accepted", False)
        ):
            self.config["user_notice_accepted"] = True
            save_config(self.config)
        self.login_status_message = ""
        self._close_user_notice()
        if self.login_window is not None and self.login_window.winfo_exists():
            try:
                self.login_window.grab_release()
            except tk.TclError:
                pass
            self.login_window.destroy()
        self.login_window = None
        self.login_card_entry = None
        self.login_status_label = None
        self.login_consent_row = None
        self.login_button = None
        self.login_trial_button = None
        self.login_disclaimer_var = None
        self.main_window_intentionally_hidden = False
        self.root.deiconify()
        self.root.update_idletasks()
        self._apply_window_dpi_if_changed(force=True)
        self.root.lift()
        if not self.window_locked:
            self.root.focus_force()
        self._sync_expiry_label()
        self.root.after(20, lambda: self._apply_windows_style(self.root))
        self.root.after(30, self._apply_window_lock_state)
        self.root.after(45, self._apply_main_transparency)
        self.heartbeat_stop_event = threading.Event()
        self.heartbeat_worker = LicenseHeartbeatWorker(
            self.licensing, self.control_messages, self.heartbeat_stop_event
        )
        self.heartbeat_worker.start()
        self.combat_clock_stop_event = threading.Event()
        self.combat_clock_worker = CombatClockWorker(
            self.licensing,
            self.control_messages,
            self.combat_clock_stop_event,
        )
        self.combat_clock_worker.start()
        self._start_capture()
        self._start_update_check()

    def _start_capture(self) -> None:
        if self.capture_started or self.closing:
            self.settlement_experiment.lifecycle(
                "capture_start_skipped",
                capture_started=self.capture_started,
                closing=self.closing,
            )
            return
        capability = self.licensing.session.runtime_capability
        if capability is None:
            self.settlement_experiment.lifecycle(
                "capture_start_rejected",
                reason="runtime_capability_missing",
            )
            self._return_to_login("采集授权缺失，请重新登录。")
            return
        self.startup_identity_pending = not self._startup_self_profile_ready()
        self.startup_capture_pending = True
        self.capture_transport_resyncing = False
        self.startup_wait_reason = "starting"
        self.startup_wait_started_at = time.monotonic()
        self._schedule_layered_main_render()
        self.settlement_experiment.lifecycle(
            "capture_start_requested",
            component="main_window",
            backend=CAPTURE_BACKEND_NAME,
            expires_at=float(capability.expires_at),
            wall_time=time.time(),
            lease_remaining_seconds=float(capability.expires_at) - time.time(),
        )
        self.stop_event = threading.Event()
        self.worker = HookWorker(
            self.messages,
            self.stop_event,
            runtime_capability=capability,
            allow_development_capability=not RELEASE_IDENTITY.protected,
            trusted_capability_public_keys=(
                RELEASE_IDENTITY.capability_public_keys
            ),
            target_boss_lookup_enabled=self.target_boss_lookup_enabled,
            settlement_experiment_enabled=self.settlement_experiment_enabled,
            settlement_experiment_query_enabled=(
                self.settlement_experiment_query_enabled
            ),
            settlement_experiment_observe_outbound=(
                self.settlement_experiment_enabled
                and self.settlement_experiment_mode
                == EXPERIMENT_MODE_OBSERVE
            ),
            settlement_experiment_lifecycle=(
                self.settlement_experiment.lifecycle
            ),
            team_stats_hybrid_enabled=self.team_stats_hybrid_enabled,
            team_stats_hybrid_interval=self.team_stats_hybrid_interval,
        )
        self.capture_started = True
        self.worker.start()
        self.settlement_experiment.lifecycle(
            "capture_worker_started",
            component="main_window",
            worker_name=self.worker.name,
        )

    def _restart_capture_after_unexpected_stop(self) -> None:
        self.capture_restart_after_id = None
        if (
            self.closing
            or self.authorization_resetting
            or getattr(self, "license_network_paused", False)
            or self.capture_started
        ):
            return
        write_capture_lifecycle_event(
            "capture_restart_started",
            component="main_window",
            attempt=int(self.capture_restart_attempts),
        )
        self._start_capture()

    def _show_capture_recovery_notice(self, message: str | None = None) -> None:
        """Tell the user when transient capture recovery has been exhausted."""

        if getattr(self, "capture_recovery_notice_shown", False):
            return
        self.capture_recovery_notice_shown = True
        show_notice = getattr(self, "_show_notice", None)
        if callable(show_notice):
            show_notice(
                "采集已停止",
                message
                or "Windows 采集资源不足，自动重连未成功。请重启助手后再试。",
                parent=getattr(self, "root", None),
            )

    def _queue_automatic_capture_feedback(
        self, details: object, fatal_payload: object
    ) -> bool:
        """Report one unrecoverable capture stop without touching feedback UI."""

        if (
            getattr(self, "automatic_capture_feedback_attempted", False)
            or getattr(self, "automatic_capture_feedback_in_progress", False)
        ):
            return False
        licensing = getattr(self, "licensing", None)
        submit_feedback = getattr(licensing, "submit_feedback", None)
        if not callable(submit_feedback):
            return False

        stop_details = details if isinstance(details, dict) else {}
        failure = fatal_payload if isinstance(fatal_payload, dict) else {}
        reason = str(stop_details.get("reason") or "unknown")[:96]
        stage = str(failure.get("stage") or "")[:96]
        failure_detail = str(
            failure.get("details")
            or failure.get("message")
            or failure.get("error")
            or fatal_payload
            or ""
        )[:1000]
        error_code = capture_failure_error_code(fatal_payload)
        try:
            restart_attempts = max(
                0, int(getattr(self, "capture_restart_attempts", 0) or 0)
            )
        except (TypeError, ValueError, OverflowError):
            restart_attempts = 0

        character_name = str(
            getattr(self, "current_character_name", "") or ""
        ).strip()[:48]
        if not character_name:
            feedback_character_name = getattr(self, "_feedback_character_name", None)
            if callable(feedback_character_name):
                try:
                    character_name = str(feedback_character_name() or "").strip()[:48]
                except (AttributeError, TypeError, ValueError):
                    character_name = ""

        capture_snapshot: dict[str, object] = {}
        diagnostic_snapshot = getattr(
            getattr(self, "worker", None), "diagnostic_snapshot", None
        )
        if callable(diagnostic_snapshot):
            try:
                snapshot = diagnostic_snapshot()
                if isinstance(snapshot, dict):
                    capture_snapshot = snapshot
            except Exception as exc:
                capture_snapshot = {
                    "snapshot_error": f"{type(exc).__name__}: {exc}"[:240]
                }

        diagnostics = {
            "app_version": CLIENT_BUILD,
            "display_version": APP_VERSION,
            "build_id": RELEASE_IDENTITY.build_id,
            "capture_pipeline": capture_snapshot,
            "automatic_capture_stop": {
                "reason": reason,
                "stage": stage,
                "details": failure_detail,
                "error_code": error_code,
                "restart_attempts": restart_attempts,
            },
        }
        content_lines = [
            "自动反馈：采集已停止",
            f"停止原因：{reason}",
        ]
        if stage:
            content_lines.append(f"故障阶段：{stage}")
        if error_code is not None:
            content_lines.append(f"错误码：{error_code}")
        content_lines.append(f"自动重连次数：{restart_attempts}")
        if failure_detail:
            content_lines.append(f"故障信息：{failure_detail}")
        content = "\n".join(content_lines)[:2000]

        self.automatic_capture_feedback_attempted = True
        self.automatic_capture_feedback_in_progress = True
        write_capture_lifecycle_event(
            "automatic_capture_feedback_queued",
            component="main_window",
            reason=reason,
            error_code=error_code,
            restart_attempts=restart_attempts,
        )

        def submit() -> None:
            accepted = False
            feedback_id = ""
            result_message = ""
            try:
                result = submit_feedback(
                    category="connection",
                    content=content,
                    character_name=character_name,
                    diagnostics=diagnostics,
                )
                accepted = bool(result.accepted)
                feedback_id = str(result.feedback_id or "")[:32]
                result_message = str(result.message or "")[:240]
            except LicensingConnectionError as exc:
                result_message = str(exc)[:240]
            except Exception as exc:
                result_message = f"{type(exc).__name__}: {exc}"[:240]
            finally:
                self.automatic_capture_feedback_in_progress = False
                write_capture_lifecycle_event(
                    "automatic_capture_feedback_completed",
                    component="main_window",
                    accepted=accepted,
                    feedback_id=feedback_id,
                    result_message=result_message,
                )

        try:
            threading.Thread(
                target=submit,
                name="capture-stop-feedback",
                daemon=True,
            ).start()
        except Exception as exc:
            self.automatic_capture_feedback_in_progress = False
            write_capture_lifecycle_event(
                "automatic_capture_feedback_completed",
                component="main_window",
                accepted=False,
                feedback_id="",
                result_message=f"{type(exc).__name__}: {exc}"[:240],
            )
            return False
        return True

    def _handle_capture_worker_stopped(self, payload: object) -> None:
        details = payload if isinstance(payload, dict) else {}
        fatal_payload = getattr(self, "capture_fatal_payload", None)
        requested = bool(details.get("requested", False))
        terminal = bool(details.get("terminal", False))
        intentional = bool(
            requested
            or self.closing
            or self.authorization_resetting
            or getattr(self, "license_network_paused", False)
        )
        self.capture_started = False
        write_capture_lifecycle_event(
            "capture_worker_stopped",
            component="main_window",
            reason=str(details.get("reason", "unknown"))[:96],
            requested=requested,
            intentional=intentional,
        )
        if intentional or self.capture_restart_after_id is not None:
            return
        if terminal:
            retryable = capture_failure_can_retry(fatal_payload)
            if retryable and int(self.capture_restart_attempts) < CAPTURE_TRANSIENT_RESTART_LIMIT:
                # WinDivert error 1450 is commonly recoverable after the old
                # receive handle has been released. Reconnect a few times;
                # keep the permanent error path for missing/blocked drivers.
                terminal = False
                self.capture_fatal_payload = None
            elif retryable:
                self.connected = False
                self.startup_identity_pending = False
                self.startup_capture_pending = False
                self.startup_wait_reason = "capture_error"
                self.startup_wait_started_at = 0.0
                dot = getattr(self, "dot", None)
                status = getattr(self, "status_label", None)
                if dot is not None:
                    dot.configure(fg=ERROR)
                if status is not None:
                    status.configure(
                        text="采集已停止，请重启助手",
                        fg=ERROR,
                    )
                self._queue_automatic_capture_feedback(details, fatal_payload)
                self._show_capture_recovery_notice()
                self._schedule_layered_main_render()
                return
            else:
                self.capture_fatal_payload = None
        if terminal:
            # The preceding fatal message already contains the actionable
            # cause. Keep that red error visible and do not turn a missing or
            # blocked capture component into an endless reconnect loop.
            self.connected = False
            self.startup_identity_pending = False
            self.startup_capture_pending = False
            self.startup_wait_reason = "capture_error"
            self.startup_wait_started_at = 0.0
            notice = "采集已停止，请重启助手后再试。若仍然失败，请提交反馈。"
            if capture_failure_error_code(fatal_payload) in (1275, 1237):
                notice = f"{chinese_error_message(fatal_payload)} 处理后请重启助手。"
            self._queue_automatic_capture_feedback(details, fatal_payload)
            self._show_capture_recovery_notice(
                notice
            )
            self._schedule_layered_main_render()
            return
        self.connected = False
        self.startup_capture_pending = True
        self.startup_wait_reason = "capture_restart"
        self.startup_wait_started_at = time.monotonic()
        dot = getattr(self, "dot", None)
        status = getattr(self, "status_label", None)
        if dot is not None:
            dot.configure(fg=WARN)
        if status is not None:
            status.configure(text="正在重新连接", fg=WARN)
        self.capture_restart_attempts = min(
            8, int(self.capture_restart_attempts) + 1
        )
        delay_ms = min(
            5000,
            500 * (2 ** min(self.capture_restart_attempts - 1, 3)),
        )
        self.capture_restart_after_id = self.root.after(
            delay_ms, self._restart_capture_after_unexpected_stop
        )
        self._schedule_layered_main_render()

    def _startup_self_profile_ready(self) -> bool:
        """Return whether the first HUD row is bound to a real local role.

        Rating discovery is independent and must never be satisfied from a
        stale cache merely to unlock startup.  The row can appear once the
        exact local token/name is known; its score is filled only by live data.
        """

        model = getattr(self, "model", None)
        try:
            actor_id = int(getattr(model, "self_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            actor_id = 0
        if actor_id <= 0:
            return False
        name = str(getattr(self, "current_character_name", "") or "").strip()
        if not name:
            name = str(
                getattr(model, "entity_names", {}).get(actor_id, "") or ""
            ).strip()
        return bool(name and name != "识别中")

    def _startup_interaction_blocked(self) -> bool:
        return bool(
            getattr(self, "startup_identity_pending", False)
            or getattr(self, "startup_capture_pending", False)
        )

    def _startup_wait_message(self) -> str:
        identity_pending = bool(
            getattr(self, "startup_identity_pending", False)
        )
        capture_pending = bool(
            getattr(self, "startup_capture_pending", False)
        )
        if capture_pending and getattr(self, "startup_wait_reason", "") == "initial_state":
            return "采集未就绪，自动重试中"
        return "正在连接启动中…" if identity_pending or capture_pending else ""

    def _sync_startup_identity_state(self) -> bool:
        if not getattr(self, "startup_identity_pending", False):
            return False
        if not self._startup_self_profile_ready():
            return False
        self.startup_identity_pending = False
        if getattr(self, "startup_capture_pending", False):
            if self.startup_wait_reason not in ('game_traffic', 'connection_change', 'initial_state'):
                self.startup_wait_reason = "capture"
        else:
            self.startup_wait_reason = ""
            self.startup_wait_started_at = 0.0
        self._schedule_layered_main_render()
        return True

    def _release_stalled_startup_gate(self, now: float | None = None) -> bool:
        """Keep passive discovery running without blocking the HUD forever."""

        identity_pending = bool(
            getattr(self, "startup_identity_pending", False)
        )
        capture_pending = bool(
            getattr(self, "startup_capture_pending", False)
        )
        if not (identity_pending or capture_pending):
            return False
        if not bool(getattr(self, "connected", False)):
            return False
        if int(getattr(self, "active_capture_game_pid", 0) or 0) <= 0:
            return False
        if str(getattr(self, "startup_wait_reason", "") or "") in {
            "capture_error",
            "game_not_found",
        }:
            return False
        try:
            started_at = float(
                getattr(self, "startup_wait_started_at", 0.0) or 0.0
            )
        except (TypeError, ValueError, OverflowError):
            started_at = 0.0
        current = time.monotonic() if now is None else float(now)
        if (
            started_at <= 0.0
            or current - started_at < STARTUP_GATE_MAX_SECONDS
        ):
            return False

        self.startup_identity_pending = False
        self.startup_capture_pending = False
        self.startup_wait_reason = ""
        self.startup_wait_started_at = 0.0
        dot = getattr(self, "dot", None)
        status = getattr(self, "status_label", None)
        if capture_pending:
            if dot is not None:
                dot.configure(fg=WARN)
            if status is not None:
                status.configure(text="等待游戏数据", fg=WARN)
        else:
            if dot is not None:
                dot.configure(fg=ACCENT)
            if status is not None:
                status.configure(text="运行中", fg=MUTED)
        experiment = getattr(self, "settlement_experiment", None)
        if experiment is not None:
            experiment.lifecycle(
                "startup_gate_timeout",
                elapsed_seconds=max(0.0, current - started_at),
                capture_pending=capture_pending,
                identity_pending=identity_pending,
            )
        self._schedule_layered_main_render()
        return True

    def _handle_self_character(self, payload: object) -> None:
        if not isinstance(payload, dict):
            return
        raw_character_id = str(payload.get("user_token", "") or "").strip()
        try:
            identity = canonical_character_identity(raw_character_id)
        except ProfileUploadError:
            return
        try:
            entity_id = int(payload.get("entity_id", 0) or 0)
            profession_id = max(0, int(payload.get("profession_id", 0) or 0))
        except (TypeError, ValueError, OverflowError):
            entity_id = profession_id = 0
        character_name = str(payload.get("name", "") or "").strip()[:48]
        previous_character_id = str(self.current_character_id or "").strip()
        character_changed = previous_character_id != identity.canonical
        if character_changed and previous_character_id:
            # A new local role can arrive without a full capture-session reset.
            # Drop the old role's visible model/profile rows immediately so the
            # HUD cannot show the previous account until the next packet.
            try:
                self.model.reset(
                    keep_identity=False,
                    keep_monsters=False,
                    archive_reason="character_changed",
                )
            except (AttributeError, TypeError, ValueError):
                pass
            self._flush_combat_history(force=True)
            for mapping_name in (
                "entity_names", "entity_professions", "entity_extraordinary_ratings",
                "entity_ai_states", "actor_character_ids", "tokens",
            ):
                mapping = getattr(self.model, mapping_name, None)
                if isinstance(mapping, dict):
                    mapping.clear()
            self.model.local_player_name = ""
            self.main_last_battle_result = None
            self.main_last_live_display_snapshot = None
            self.main_manual_clear_state = None
            self.main_scroll_offset = 0
            self.pvp_team_composition_cache_key = None
            recording = getattr(self, "pvp_recording", None)
            if recording is not None:
                self.pvp_hud_state = recording.snapshot()
            self._clear_team_equipment_profiles()
            self._invalidate_team_rating_preview_rows(clear_profiles=True)
        self.current_character_id = identity.canonical
        self.current_character_name = character_name
        self.current_character_profession_id = profession_id
        if entity_id:
            profile = {
                "entity_id": entity_id,
                "user_token": identity.canonical,
                "name": character_name,
                "profession_id": profession_id,
                "entity_type": "Player",
                "is_ai": False,
            }
            rating = normalize_extraordinary_rating(
                payload.get("extraordinary_rating")
            )
            if rating is not None:
                profile["extraordinary_rating"] = rating
            self.model.ingest_profile(profile)
            self.model.ingest_identity(
                {
                    "entity_id": entity_id,
                    "tentative": False,
                    "source_method": "SelfCharacterProfile",
                }
            )
            self._invalidate_team_rating_preview_rows(entity_id)
            self._schedule_layered_main_render()
            self._sync_startup_identity_state()
        if character_changed:
            self.upload_profile = None
            self.profile_resolved_character_id = ""
        self._sync_upload_profile_label()
        self._resolve_upload_profile_async()

    def _resolve_upload_profile_async(self) -> None:
        character_id = str(getattr(self, "current_character_id", "") or "")
        if (
            not character_id
            or bool(getattr(self, "profile_resolve_in_progress", False))
            or not self.licensing.session.active
            or self.closing
        ):
            return
        self.profile_resolve_in_progress = True
        character_name = str(getattr(self, "current_character_name", "") or "")
        profession_id = int(
            getattr(self, "current_character_profession_id", 0) or 0
        )

        def resolve() -> None:
            try:
                result = self.licensing.resolve_upload_profile(
                    character_id,
                    character_name=character_name,
                    profession_id=profession_id,
                )
            except LicensingConnectionError as exc:
                result = ProfileResult(False, error="connection", message=str(exc))
            except Exception:
                result = ProfileResult(
                    False,
                    error="unexpected",
                    message="上传身份查询失败，请稍后重试。",
                )
            self.control_messages.put(
                (
                    "profile_resolve_result",
                    {"character_id": character_id, "result": result},
                )
            )

        threading.Thread(
            target=resolve, name="profile-resolve", daemon=True
        ).start()

    def _handle_profile_resolve_result(self, payload: object) -> None:
        self.profile_resolve_in_progress = False
        if not isinstance(payload, dict):
            return
        if str(payload.get("character_id", "")) != self.current_character_id:
            self._resolve_upload_profile_async()
            return
        result = payload.get("result")
        if not isinstance(result, ProfileResult):
            return
        if result.accepted:
            self.upload_profile = result.profile
            self.profile_resolved_character_id = self.current_character_id
        self._sync_upload_profile_label()
        pending_battle_id = str(self.pending_upload_battle_id or "")
        editor_pending = bool(getattr(self, "profile_editor_pending", False))
        if not pending_battle_id and not editor_pending:
            return
        if not result.accepted:
            self.pending_upload_battle_id = ""
            self.profile_editor_pending = False
            self._show_notice(
                "上传身份查询失败",
                result.message or "上传身份查询失败，请稍后重试。",
                parent=self.history_window,
            )
            return
        self._close_notice_window()
        self.profile_editor_pending = False
        if pending_battle_id and isinstance(self.upload_profile, UploadProfile):
            self.root.after_idle(
                lambda battle_id=pending_battle_id: self._show_history_upload_confirmation(
                    battle_id
                )
            )
        elif pending_battle_id:
            self._show_profile_setup_choice()
        elif editor_pending:
            if isinstance(self.upload_profile, UploadProfile):
                self._show_profile_nickname_form(rename=True)
            else:
                self._show_profile_setup_choice()

    def _start_update_check(self, *, manual: bool = False) -> None:
        if (
            getattr(self, "update_check_in_progress", False)
            or getattr(self, "rollback_check_in_progress", False)
            or getattr(self, "update_downloading", False)
            or getattr(self, "closing", False)
        ):
            return
        if getattr(self, "update_check_started", False) and not manual:
            return
        self.update_check_started = True
        self.update_check_in_progress = True
        self._refresh_update_page()

        def check() -> None:
            try:
                update = self.licensing.check_update()
                payload = {"manual": manual, "update": update, "error": ""}
            except LicensingConnectionError as exc:
                payload = {"manual": manual, "update": None, "error": str(exc)}
            except Exception:
                payload = {
                    "manual": manual,
                    "update": None,
                    "error": "检查更新失败，请稍后重试。",
                }
            self.control_messages.put(("update_check_result", payload))

        threading.Thread(target=check, name="update-check", daemon=True).start()

    def _handle_update_check_result(self, payload: object) -> None:
        self.update_check_in_progress = False
        if not isinstance(payload, dict):
            self._refresh_update_page("更新检查返回了无效结果。")
            return
        manual = bool(payload.get("manual"))
        update = payload.get("update")
        error = str(payload.get("error", "")).strip()
        if isinstance(update, UpdateInfo) and update.available:
            self._cache_available_update(update)
            return
        if not manual:
            self._refresh_update_page()
            return
        self.pending_update = None
        if error:
            self._refresh_update_page(error)
            return
        self._refresh_update_page(
            f"当前已是最新版本，更新文件保存位置：{UPDATE_DIR}"
        )

    def _cache_available_update(self, update: UpdateInfo) -> None:
        if self.closing:
            return
        self.pending_update = update
        self._refresh_update_page()

    def _update_page_action(self) -> None:
        if self.pending_update is not None and self.pending_update.available:
            self._download_pending_update()
        else:
            self._start_update_check(manual=True)

    def _start_version_rollback(self, version: object) -> None:
        target_version = normalize_rollback_version(version)
        if not rollback_version_is_supported(target_version):
            self._show_notice(
                "无法回滚",
                "版本回滚仅支持 v0.1.0 及以上版本。",
                parent=self.history_window,
            )
            return
        if target_version == normalize_rollback_version(APP_VERSION):
            return
        if (
            self.update_check_in_progress
            or self.rollback_check_in_progress
            or self.update_downloading
        ):
            self._refresh_update_page("已有更新或回滚任务正在进行，请稍候。")
            return

        self._show_notice(
            "确认版本回滚",
            f"确定回滚到 v{target_version} 吗？",
            parent=self.history_window,
            confirm_text="确认回滚",
            cancel_text="取消",
            on_confirm=lambda: self._request_version_rollback(target_version),
        )

    def _request_version_rollback(self, version: str) -> None:
        target_version = normalize_rollback_version(version)
        if (
            not rollback_version_is_supported(target_version)
            or target_version == normalize_rollback_version(APP_VERSION)
            or self.update_check_in_progress
            or self.rollback_check_in_progress
            or self.update_downloading
            or self.closing
        ):
            return
        self.pending_update = None
        self.rollback_requested_version = target_version
        self.rollback_check_in_progress = True
        self._refresh_update_page(f"正在获取 v{target_version} 的回滚信息…")

        def check() -> None:
            try:
                update = self.licensing.check_rollback(target_version)
                payload = {
                    "version": target_version,
                    "update": update,
                    "error": "",
                }
            except LicensingConnectionError as exc:
                payload = {
                    "version": target_version,
                    "update": None,
                    "error": str(exc),
                }
            except Exception:
                payload = {
                    "version": target_version,
                    "update": None,
                    "error": "获取回滚版本失败，请稍后重试。",
                }
            self.control_messages.put(("rollback_check_result", payload))

        threading.Thread(
            target=check,
            name="rollback-check",
            daemon=True,
        ).start()

    def _handle_rollback_check_result(self, payload: object) -> None:
        self.rollback_check_in_progress = False
        if not isinstance(payload, dict):
            self.rollback_requested_version = ""
            self._refresh_update_page("回滚信息返回了无效结果。")
            return
        target_version = normalize_rollback_version(payload.get("version"))
        update = payload.get("update")
        error = str(payload.get("error", "")).strip()
        if (
            not target_version
            or target_version != self.rollback_requested_version
            or not isinstance(update, UpdateInfo)
            or not update.available
            or not update.rollback
            or normalize_rollback_version(update.latest_version) != target_version
        ):
            self.rollback_requested_version = ""
            self.pending_update = None
            self._refresh_update_page(
                error or f"服务器暂未提供 v{target_version or '?'} 的回滚包。"
            )
            return
        self.pending_update = update
        self._refresh_update_page(f"已找到 v{target_version}，准备下载并校验…")
        self._download_pending_update()

    def _refresh_update_page(self, status_text: str = "") -> None:
        update = getattr(self, "pending_update", None)
        is_rollback = bool(isinstance(update, UpdateInfo) and update.rollback)
        update_summary_label = getattr(self, "update_summary_label", None)
        update_status_label = getattr(self, "update_status_label", None)
        update_action_button = getattr(self, "update_action_button", None)
        if update_summary_label is not None:
            if update is not None and update.available:
                size_text = (
                    f" · {update.size / 1024 / 1024:.1f} MB"
                    if update.size > 0
                    else ""
                )
                update_summary_label.configure(
                    text=(
                        f"准备回滚到 v{update.latest_version}{size_text}"
                        if is_rollback
                        else f"发现新版本 v{update.latest_version}{size_text}"
                    ),
                    fg=ACCENT,
                )
            elif self.rollback_check_in_progress and self.rollback_requested_version:
                update_summary_label.configure(
                    text=f"准备回滚到 v{self.rollback_requested_version}",
                    fg=WARN,
                )
            else:
                update_summary_label.configure(
                    text=f"当前版本 v{APP_VERSION}", fg=TEXT
                )
        if update_status_label is not None:
            if status_text:
                update_status_label.configure(text=status_text, fg=MUTED)
            elif update is not None and update.available:
                update_status_label.configure(
                    text=(
                        "回滚包下载完成后将自动安全停止采集并重启程序。"
                        if is_rollback
                        else (update.notes or "新版本可下载。")
                    ),
                    fg=MUTED,
                )
            else:
                update_status_label.configure(
                    text=(
                        "可在下方回滚到 v0.1.0 及以上版本；"
                        "更新、回滚和文件校验均在本页完成。"
                    ),
                    fg=MUTED,
                )
        if update_action_button is not None:
            if bool(getattr(self, "update_downloading", False)):
                text, disabled = ("回滚中…" if is_rollback else "下载中…"), True
            elif bool(getattr(self, "rollback_check_in_progress", False)):
                text, disabled = "获取中…", True
            elif bool(getattr(self, "update_check_in_progress", False)):
                text, disabled = "检查中…", True
            elif update is not None and update.available:
                text, disabled = ("重试回滚" if is_rollback else "立即更新"), False
            else:
                text, disabled = "检查更新", False
            update_action_button._disabled = disabled
            update_action_button.configure(
                text=text,
                cursor="arrow" if disabled else "hand2",
                bg=PANEL_2 if disabled else ACCENT,
                fg=MUTED if disabled else "#07110e",
            )
        self._refresh_rollback_buttons()

    def _refresh_rollback_buttons(self) -> None:
        buttons = getattr(self, "update_rollback_buttons", {})
        current_version = normalize_rollback_version(APP_VERSION)
        requested_version = normalize_rollback_version(
            getattr(self, "rollback_requested_version", "")
        )
        pending_update = getattr(self, "pending_update", None)
        pending_version = (
            normalize_rollback_version(pending_update.latest_version)
            if isinstance(pending_update, UpdateInfo) and pending_update.rollback
            else ""
        )
        checking = bool(
            getattr(self, "update_check_in_progress", False)
            or getattr(self, "rollback_check_in_progress", False)
        )
        downloading = bool(getattr(self, "update_downloading", False))
        for version, button in buttons.items():
            supported = rollback_version_is_supported(version)
            is_current = supported and version == current_version
            disabled = not supported or is_current or checking or downloading
            if not supported:
                text = "不支持回滚"
            elif is_current:
                text = "当前版本"
            elif self.rollback_check_in_progress and version == requested_version:
                text = "获取中…"
            elif downloading and version == pending_version:
                text = "回滚中…"
            elif pending_version == version:
                text = "重试回滚"
            else:
                text = "回滚"
            button._disabled = disabled
            button.configure(
                text=text,
                cursor="arrow" if disabled else "hand2",
                bg=PANEL_2,
                fg=SUBTLE if disabled else MUTED,
            )

    def _download_pending_update(self) -> None:
        update = self.pending_update
        if update is None or self.update_downloading or self.closing:
            return
        is_rollback = bool(update.rollback)
        self.update_downloading = True
        if self.update_status_label is not None:
            self.update_status_label.configure(
                text=(
                    f"正在下载并校验 v{update.latest_version} 回滚包…"
                    if is_rollback
                    else "正在下载并校验…"
                ),
                fg=MUTED,
            )
        if self.update_action_button is not None:
            self.update_action_button.configure(
                text="回滚中" if is_rollback else "下载中",
                bg=PANEL_2,
                fg=MUTED,
            )
        self._refresh_rollback_buttons()

        def download() -> None:
            last_progress_at = 0.0

            def report_progress(written: int, total: int) -> None:
                nonlocal last_progress_at
                now = time.monotonic()
                if 0 < written < total and now - last_progress_at < 0.2:
                    return
                last_progress_at = now
                self.control_messages.put(
                    ("update_download_progress", (written, total))
                )

            try:
                staging_path, target_path = update_install_paths(
                    UPDATE_DIR, APP_EXECUTABLE_PATH, update.filename
                )
                destination = staging_path if IS_FROZEN else target_path
                path = self.licensing.download_update(
                    update, destination, report_progress
                )
                result = ("update_downloaded", path)
            except (LicensingConnectionError, OSError) as exc:
                result = ("update_download_failed", str(exc))
            except Exception:
                result = (
                    "update_download_failed",
                    "更新下载失败，请稍后重试。",
                )
            self.control_messages.put(result)

        threading.Thread(target=download, name="update-download", daemon=True).start()

    def _handle_update_download_progress(self, payload: object) -> None:
        if not self.update_downloading or self.update_status_label is None:
            return
        try:
            written, total = payload
            written = max(0, int(written))
            total = max(0, int(total))
        except (TypeError, ValueError, OverflowError):
            return
        if total <= 0:
            action = "回滚包" if bool(self.pending_update and self.pending_update.rollback) else "更新"
            text = f"正在下载{action} {written / 1024 / 1024:.1f} MB…"
        else:
            percentage = min(100, int(written * 100 / total))
            text = (
                "下载完成，正在校验文件…"
                if percentage >= 100
                else f"正在下载 {written / 1024 / 1024:.1f} / {total / 1024 / 1024:.1f} MB（{percentage}%）…"
            )
        self.update_status_label.configure(text=text, fg=MUTED)

    def _handle_update_downloaded(self, payload: object) -> None:
        self.update_downloading = False
        update_path = Path(str(payload))
        update = self.pending_update
        if not isinstance(update, UpdateInfo) or not update.filename:
            self._handle_update_download_failed("更新信息已失效，请重新检查更新。")
            return
        if not IS_FROZEN or sys.platform != "win32":
            if self.update_status_label is not None:
                self.update_status_label.configure(
                    text=(
                        f"回滚安装包已保存：{update_path}"
                        if update.rollback
                        else f"安装包已保存：{update_path}"
                    ),
                    fg=ACCENT,
                )
            if self.update_action_button is not None:
                self.update_action_button.configure(text="已下载", bg=PANEL_2, fg=ACCENT)
            return
        try:
            _staging_path, target_path = update_install_paths(
                UPDATE_DIR, APP_EXECUTABLE_PATH, update.filename
            )
            self.pending_update_install = (
                update_path,
                target_path,
                APP_EXECUTABLE_PATH,
            )
        except OSError as exc:
            self._handle_update_download_failed(str(exc))
            return
        if self.update_status_label is not None:
            self.update_status_label.configure(
                text=(
                    "回滚包校验完成，正在安全停止采集…"
                    if update.rollback
                    else "校验完成，正在安全停止采集…"
                ),
                fg=ACCENT,
            )
        if self.update_action_button is not None:
            self.update_action_button.configure(
                text="准备安装", bg=PANEL_2, fg=ACCENT
            )
        self.close_status_text = "正在安全停止采集并准备更新…"
        if update.rollback:
            self.close_status_text = "正在安全停止采集并准备回滚…"
        self.root.after(120, self.close)

    def _handle_update_download_failed(self, payload: object) -> None:
        self.update_downloading = False
        self.pending_update_install = None
        message = str(payload).strip() or "更新下载失败，请稍后重试。"
        if self.update_status_label is not None:
            self.update_status_label.configure(text=message, fg=ERROR)
        if self.update_action_button is not None:
            self.update_action_button.configure(
                text=(
                    "重试回滚"
                    if bool(self.pending_update and self.pending_update.rollback)
                    else "重试"
                ),
                bg=ACCENT,
                fg="#07110e",
            )
        self._refresh_rollback_buttons()

    def _launch_update_replacer(
        self,
        update_path: Path,
        *,
        target_path: Path | None = None,
        legacy_target_path: Path | None = None,
    ) -> None:
        target_path = Path(target_path or APP_EXECUTABLE_PATH).resolve()
        legacy_target_path = Path(
            legacy_target_path or APP_EXECUTABLE_PATH
        ).resolve()
        UPDATE_DIR.mkdir(parents=True, exist_ok=True)
        script_path = UPDATE_DIR / "apply-update.ps1"
        script_path.write_text(
            "param([int]$TargetPid,[string]$Source,[string]$Target,[string]$PreviousTarget)\n"
            "$ErrorActionPreference = 'Stop'\n"
            "$deadline = [DateTime]::UtcNow.AddSeconds(60)\n"
            "while (Get-Process -Id $TargetPid -ErrorAction SilentlyContinue) {\n"
            "  if ([DateTime]::UtcNow -ge $deadline) { exit 20 }\n"
            "  Start-Sleep -Milliseconds 200\n"
            "}\n"
            "$installed = $false\n"
            "for ($attempt = 0; $attempt -lt 20; $attempt++) {\n"
            "  try { Copy-Item -LiteralPath $Source -Destination $Target -Force; $installed = $true; break }\n"
            "  catch { Start-Sleep -Milliseconds 500 }\n"
            "}\n"
            "if ($installed) {\n"
            "  if ($PreviousTarget -and (-not [StringComparer]::OrdinalIgnoreCase.Equals([System.IO.Path]::GetFullPath($PreviousTarget), [System.IO.Path]::GetFullPath($Target)))) {\n"
            "    Remove-Item -LiteralPath $PreviousTarget -Force -ErrorAction SilentlyContinue\n"
            "  }\n"
            "  Start-Process -FilePath $Target -WorkingDirectory (Split-Path -Parent $Target)\n"
            "  Remove-Item -LiteralPath $Source -Force -ErrorAction SilentlyContinue\n"
            "}\n"
            "Remove-Item -LiteralPath $PSCommandPath -Force -ErrorAction SilentlyContinue\n",
            encoding="utf-8-sig",
        )
        creation_flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        subprocess.Popen(
            [
                "powershell.exe",
                "-NoProfile",
                "-NonInteractive",
                "-ExecutionPolicy",
                "Bypass",
                "-WindowStyle",
                "Hidden",
                "-File",
                str(script_path),
                "-TargetPid",
                str(os.getpid()),
                "-Source",
                str(update_path.resolve()),
                "-Target",
                str(target_path),
                "-PreviousTarget",
                str(legacy_target_path),
            ],
            close_fds=True,
            creationflags=creation_flags,
        )

    def _request_capture_stop(self, reason: str, **fields: object) -> None:
        stop_event = getattr(self, "stop_event", None)
        was_set = bool(stop_event is not None and stop_event.is_set())
        write_capture_lifecycle_event(
            "capture_stop_requested",
            component="main_window",
            reason=str(reason or "unknown"),
            already_set=was_set,
            **fields,
        )
        experiment = getattr(self, "settlement_experiment", None)
        if experiment is not None:
            experiment.lifecycle(
                "capture_stop_requested",
                component="main_window",
                reason=str(reason or "unknown"),
                already_set=was_set,
                **fields,
            )
        if stop_event is not None:
            stop_event.set()

    def _report_tk_callback_exception(
        self, exception_type, exception_value, exception_traceback
    ) -> None:
        details = "".join(
            traceback.format_exception(
                exception_type, exception_value, exception_traceback
            )
        )
        experiment = getattr(self, "settlement_experiment", None)
        if experiment is not None:
            experiment.lifecycle(
                "tk_callback_exception",
                component="main_window",
                error_type=getattr(exception_type, "__name__", str(exception_type)),
                details=details[-4000:],
            )
        try:
            with (APP_DIR / "dps_error.log").open(
                "a", encoding="utf-8", newline=""
            ) as handle:
                handle.write(
                    f"\n[{dt.datetime.now().astimezone().isoformat()}] "
                    "Tk callback exception\n"
                )
                handle.write(details)
        except OSError:
            pass

    def _return_to_login(self, message: str) -> None:
        if self.closing or self.authorization_resetting:
            return
        pvp_recording = getattr(self, "pvp_recording", None)
        if pvp_recording is not None:
            # Authorization/account changes are terminal match boundaries.
            # Persist first, then remove the owner so late capture packets
            # cannot silently start a new match while shutdown is draining.
            pvp_recording.reset_context(reason="account_changed")
            pvp_recording.bind_account("")
            self.pvp_tracker = pvp_recording.current
        pvp_uploader = getattr(self, "pvp_upload_worker", None)
        if pvp_uploader is not None:
            pvp_uploader.unbind_request()
        self.settlement_experiment.lifecycle(
            "return_to_login_requested",
            component="main_window",
            reason=str(message or "")[:240],
        )
        self.authorization_resetting = True
        self.license_network_paused = False
        self.license_network_reconnecting = False
        self.startup_identity_pending = False
        self.startup_capture_pending = False
        self.startup_wait_reason = ""
        self._set_window_click_through(self.root, False)
        self._destroy_unlock_window()
        self.connected = False
        self.game_pid = 0
        self.active_capture_session_id = 0
        self.active_capture_game_pid = 0
        self._close_notice_window()
        self._close_user_notice()
        self._close_skill_window()
        self._close_hunter_team_panel()
        self._close_history_window(destroy=True)
        self._close_feedback_window()
        self.dot.configure(fg=WARN)
        self.status_label.configure(text="正在安全停止", fg=WARN)
        self.heartbeat_stop_event.set()
        self.combat_clock_stop_event.set()
        self._request_capture_stop("return_to_login")
        self.login_status_message = str(message).strip() or "请重新输入卡号。"
        self.root.after(50, self._finish_return_to_login)

    def _finish_return_to_login(self) -> None:
        if self.closing:
            return
        if self.worker.is_alive() or (
            self.heartbeat_worker is not None and self.heartbeat_worker.is_alive()
        ):
            self.root.after(50, self._finish_return_to_login)
            return
        if not self._ingest_pending_capture_messages():
            self.root.after(1, self._finish_return_to_login)
            return
        self.model.reset(keep_identity=False, archive_reason="authorization")
        self.main_last_battle_result = None
        self.model.entity_names.clear()
        self.model.entity_professions.clear()
        self.model.entity_extraordinary_ratings.clear()
        self.model.entity_ai_states.clear()
        for mapping_name in (
            "entity_fight_attributes",
            "entity_fight_attribute_times",
        ):
            mapping = getattr(self.model, mapping_name, None)
            if isinstance(mapping, dict):
                mapping.clear()
        self.model.local_player_name = ""
        self.current_character_id = ""
        self.current_character_name = ""
        self.current_character_profession_id = 0
        self.startup_identity_pending = False
        self.startup_capture_pending = False
        self.startup_wait_reason = ""
        self.upload_profile = None
        self.profile_resolved_character_id = ""
        self.profile_resolve_in_progress = False
        self.profile_editor_pending = False
        self.profile_mutation_in_progress = False
        self.pending_upload_battle_id = ""
        self.history_upload_in_progress.clear()
        self.automatic_upload_queued.clear()
        self._flush_combat_history(force=True)
        self.capture_started = False
        self.heartbeat_worker = None
        self.combat_clock_worker = None
        self.update_check_started = False
        self.pending_update = None
        self.rollback_check_in_progress = False
        self.rollback_requested_version = ""
        self.connected = False
        self.game_pid = 0
        self.dot.configure(fg=WARN)
        self.status_label.configure(text="待机", fg=MUTED)
        self.main_window_intentionally_hidden = True
        self.root.withdraw()
        self.authorization_resetting = False
        self._show_login(activate=False)

    @staticmethod
    def _label_button(
        parent: tk.Misc,
        text: str,
        command,
        *,
        width: int = 38,
        bg: str = SURFACE,
        hover: str = PANEL_2,
        fg: str = MUTED,
        font=tk_font_spec("Microsoft YaHei UI", 10),
    ) -> tk.Label:
        label = tk.Label(
            parent,
            text=text,
            bg=bg,
            fg=fg,
            width=1,
            height=1,
            anchor="center",
            cursor="hand2",
            font=font,
        )
        label.configure(padx=max(4, (width - 12) // 2))
        label.bind("<Enter>", lambda _event: label.configure(bg=hover, fg=TEXT))
        label.bind("<Leave>", lambda _event: label.configure(bg=bg, fg=fg))
        label.bind("<Button-1>", lambda _event: command())
        return label

    def _titlebar_icon_button(
        self,
        parent: tk.Misc,
        icon_name: str,
        command,
        *,
        width: int = 44,
        height: int = 44,
        bg: str = SURFACE,
        hover: str = PANEL_2,
        fg: str = "#c5ccd3",
        hover_fg: str = TEXT,
    ) -> tk.Label:
        button = tk.Label(
            parent,
            bg=bg,
            width=width,
            height=height,
            bd=0,
            cursor="hand2",
        )
        button._icon_name = str(icon_name)
        button._normal_bg = bg
        button._hover_bg = hover
        button._normal_fg = fg
        button._hover_fg = hover_fg
        button._hovered = False
        button.bind(
            "<Enter>",
            lambda _event: self._set_titlebar_icon_hover(button, True),
        )
        button.bind(
            "<Leave>",
            lambda _event: self._set_titlebar_icon_hover(button, False),
        )
        button.bind("<Button-1>", lambda _event: command())
        self._render_titlebar_icon_button(button)
        return button

    def _render_titlebar_icon_button(self, button: tk.Label) -> None:
        hovered = bool(getattr(button, "_hovered", False))
        color = button._hover_fg if hovered else button._normal_fg
        background = button._hover_bg if hovered else button._normal_bg
        image = self.icons.toolbar(button._icon_name, 16, color)
        button.configure(image=image, bg=background)
        button.image = image

    def _set_titlebar_icon_hover(
        self, button: tk.Label, hovered: bool
    ) -> None:
        button._hovered = bool(hovered)
        self._render_titlebar_icon_button(button)

    def _set_titlebar_icon(self, button: tk.Label, icon_name: str) -> None:
        button._icon_name = str(icon_name)
        self._render_titlebar_icon_button(button)

    def _bind_drag(self, widget: tk.Misc, window: tk.Misc) -> None:
        widget.bind("<ButtonPress-1>", lambda event: self._drag_start(event, window))
        widget.bind("<B1-Motion>", lambda event: self._drag_move(event, window))
        widget.bind("<ButtonRelease-1>", lambda event: self._drag_end(event, window))
        # The borderless DPS HUD is height-sized through its own grip.  A
        # double-click on its drag band must not accidentally maximize it and
        # make it appear to jump toward the centre of the desktop.  Ordinary
        # settings/history windows retain their normal double-click behaviour.
        if window is not self.root:
            widget.bind(
                "<Double-Button-1>",
                lambda _event: self._toggle_maximize(window),
            )

    @staticmethod
    def _win32_root_handle(window: tk.Misc) -> int:
        """Resolve Tk's client HWND to the real native top-level window."""
        if sys.platform != "win32" or not window.winfo_exists():
            return 0
        import ctypes
        from ctypes import wintypes

        # An already mapped window has a stable HWND. Draining every pending
        # idle redraw while opening Settings can block on a busy 30-player HUD.
        if not window.winfo_ismapped():
            window.update_idletasks()
        client_handle = int(window.winfo_id())
        user32 = ctypes.WinDLL("user32", use_last_error=True)
        get_ancestor = user32.GetAncestor
        get_ancestor.argtypes = (wintypes.HWND, wintypes.UINT)
        get_ancestor.restype = wintypes.HWND
        root_handle = get_ancestor(client_handle, 2)  # GA_ROOT
        return int(root_handle or client_handle)

    @staticmethod
    def _win32_extended_style(hwnd: int) -> int | None:
        if sys.platform != "win32" or not hwnd:
            return None
        import ctypes
        from ctypes import wintypes

        user32 = ctypes.WinDLL("user32", use_last_error=True)
        if ctypes.sizeof(ctypes.c_void_p) == 8:
            get_style = user32.GetWindowLongPtrW
            get_style.restype = ctypes.c_ssize_t
        else:
            get_style = user32.GetWindowLongW
            get_style.restype = wintypes.LONG
        get_style.argtypes = (wintypes.HWND, ctypes.c_int)
        ctypes.set_last_error(0)
        value = int(get_style(hwnd, -20))
        if value == 0 and ctypes.get_last_error():
            return None
        return value & 0xFFFFFFFF

    @staticmethod
    def _set_win32_extended_style(hwnd: int, style: int) -> bool:
        if sys.platform != "win32" or not hwnd:
            return False
        import ctypes
        from ctypes import wintypes

        user32 = ctypes.WinDLL("user32", use_last_error=True)
        pointer_sized = ctypes.sizeof(ctypes.c_void_p) == 8
        if pointer_sized:
            set_style = user32.SetWindowLongPtrW
            set_style.restype = ctypes.c_ssize_t
            encoded_style = int(style) & 0xFFFFFFFF
        else:
            set_style = user32.SetWindowLongW
            set_style.restype = wintypes.LONG
            encoded_style = ctypes.c_long(int(style) & 0xFFFFFFFF).value
        set_style.argtypes = (
            wintypes.HWND,
            ctypes.c_int,
            ctypes.c_ssize_t if pointer_sized else wintypes.LONG,
        )
        ctypes.set_last_error(0)
        previous = int(set_style(hwnd, -20, encoded_style))
        if previous == 0 and ctypes.get_last_error():
            return False

        set_position = user32.SetWindowPos
        set_position.argtypes = (
            wintypes.HWND,
            wintypes.HWND,
            ctypes.c_int,
            ctypes.c_int,
            ctypes.c_int,
            ctypes.c_int,
            wintypes.UINT,
        )
        set_position.restype = wintypes.BOOL
        if not set_position(hwnd, 0, 0, 0, 0, 0, 0x0037):
            return False
        return DpsWindow._win32_extended_style(hwnd) == (int(style) & 0xFFFFFFFF)

    def _sync_login_window_taskbar(
        self, window: tk.Misc, *, no_activate: bool = False
    ) -> bool:
        if sys.platform != "win32" or not window.winfo_exists():
            return False
        try:
            hwnd = self._win32_root_handle(window)
            current = self._win32_extended_style(hwnd)
            if not hwnd or current is None:
                return False
            updated = window_exstyle_for_taskbar(
                current,
                no_activate=no_activate,
            )
            if updated != current and not self._set_win32_extended_style(hwnd, updated):
                return False
            verified = self._win32_extended_style(hwnd)
            if verified is None:
                return False
            managed_bits = (
                WINDOW_EXSTYLE_APPWINDOW
                | WINDOW_EXSTYLE_TOOLWINDOW
                | WINDOW_EXSTYLE_NOACTIVATE
            )
            return (verified & managed_bits) == (updated & managed_bits)
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            return False

    def _set_main_content_overlay_bounds(
        self, window: tk.Misc, width: int, height: int, root_x: int, root_y: int
    ) -> None:
        window.geometry(
            format_absolute_tk_geometry(width, height, root_x, root_y)
        )

    @staticmethod
    def _set_window_topmost_noactivate(window: tk.Misc, topmost: bool) -> bool:
        """Change native z-order without activating an auxiliary window."""
        if sys.platform != "win32" or not window.winfo_exists():
            return False
        try:
            import ctypes
            from ctypes import wintypes

            hwnd = DpsWindow._win32_root_handle(window)
            if not hwnd:
                return False
            style = DpsWindow._win32_extended_style(hwnd)
            if style is not None and bool(style & WINDOW_EXSTYLE_TOPMOST) == bool(
                topmost
            ):
                return True
            user32 = ctypes.WinDLL("user32", use_last_error=True)
            set_position = user32.SetWindowPos
            set_position.argtypes = (
                wintypes.HWND,
                wintypes.HWND,
                ctypes.c_int,
                ctypes.c_int,
                ctypes.c_int,
                ctypes.c_int,
                wintypes.UINT,
            )
            set_position.restype = wintypes.BOOL
            insert_after = -1 if topmost else -2  # HWND_TOPMOST / HWND_NOTOPMOST
            flags = 0x0013  # SWP_NOSIZE | SWP_NOMOVE | SWP_NOACTIVATE
            return bool(set_position(hwnd, insert_after, 0, 0, 0, 0, flags))
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            return False

    def _set_window_click_through(self, window: tk.Misc, locked: bool) -> bool:
        if sys.platform != "win32" or not window.winfo_exists():
            return not locked
        try:
            hwnd = self._win32_root_handle(window)
            current = self._win32_extended_style(hwnd)
            if not hwnd or current is None:
                return False
            style_key = int(hwnd)
            if locked:
                original = self.window_lock_original_styles.setdefault(
                    style_key, current
                )
            else:
                original = self.window_lock_original_styles.pop(style_key, None)
            updated = window_exstyle_for_lock(current, locked, original)
            applied = updated == current or self._set_win32_extended_style(hwnd, updated)
            verified = self._win32_extended_style(hwnd)
            if not locked:
                self.window_lock_original_styles.clear()
            if verified is None:
                return False
            managed_bits = WINDOW_EXSTYLE_TRANSPARENT | WINDOW_EXSTYLE_LAYERED
            expected_bits = updated & managed_bits
            return bool(applied and (verified & managed_bits) == expected_bits)
        except (AttributeError, OSError, TypeError, ValueError, tk.TclError):
            return False

    def _destroy_unlock_window(self) -> None:
        presenter = getattr(self, "layered_unlock_presenter", None)
        if presenter is not None:
            presenter.close()
            self.layered_unlock_presenter = None
        if self.unlock_window is not None and self.unlock_window.winfo_exists():
            self.unlock_window.destroy()
        self.unlock_window = None
        self.unlock_button = None

    def _preferred_main_topmost(self) -> bool:
        restore = getattr(self, "window_lock_topmost_restore", None)
        if restore is not None:
            return bool(restore)
        return bool(self.root.attributes("-topmost"))

    def _set_main_topmost(self, value: bool) -> None:
        value = bool(value)
        self.root.attributes("-topmost", value)
        window = getattr(self, "main_content_overlay_window", None)
        if (
            window is not None
            and window.winfo_exists()
        ):
            if self._set_window_topmost_noactivate(window, value):
                self.main_content_overlay_topmost = value

    def _force_main_topmost_while_locked(self) -> None:
        if self.window_lock_topmost_restore is None:
            self.window_lock_topmost_restore = bool(
                self.root.attributes("-topmost")
            )
        self.config["topmost"] = self.window_lock_topmost_restore
        self._set_main_topmost(True)

    def _restore_main_topmost_after_unlock(self) -> bool:
        restore = self.window_lock_topmost_restore
        if restore is None:
            return False
        self._set_main_topmost(restore)
        self.config["topmost"] = bool(restore)
        self.window_lock_topmost_restore = None
        return True

    def _sync_unlock_window_position(self) -> None:
        if self._hotkey_only_lock_active():
            self._destroy_unlock_window()
            return
        window = self.unlock_window
        if (
            not self.window_locked
            or window is None
            or not window.winfo_exists()
            or self.root.state() != "normal"
        ):
            return
        if self._layered_main_active():
            region = getattr(self, "layered_main_hit_regions", {}).get("action:lock")
            frame = getattr(self, "layered_main_last_image", None)
            presenter = getattr(self, "layered_unlock_presenter", None)
            if region is None or frame is None or presenter is None:
                return
            left, top, right, bottom = region
            width, height = max(1, right - left), max(1, bottom - top)
            x, y = self.root.winfo_x() + left, self.root.winfo_y() + top
            geometry = format_absolute_tk_geometry(width, height, x, y)
            if window.geometry() != geometry:
                window.geometry(geometry)
                window.update_idletasks()
            presenter.present(frame.crop(region), opacity=1.0)
            return
        self.root.update_idletasks()
        if self.lock_button.winfo_ismapped():
            width = max(27, self.lock_button.winfo_width())
            height = max(24, self.lock_button.winfo_height())
            x = self.lock_button.winfo_rootx()
            y = self.lock_button.winfo_rooty()
        else:
            width, height = 27, 28
            x = self.root.winfo_rootx() + self.root.winfo_width() - 135
            y = self.root.winfo_rooty()
        geometry = format_absolute_tk_geometry(width, height, x, y)
        if window.geometry() != geometry:
            window.geometry(geometry)

    def _show_unlock_window(self) -> None:
        if self._hotkey_only_lock_active():
            self._destroy_unlock_window()
            return
        if self.root.state() != "normal":
            return
        if self._layered_main_active():
            if self.unlock_window is None or not self.unlock_window.winfo_exists():
                window = tk.Toplevel(self.root)
                window.withdraw()
                window.overrideredirect(True)
                window.transient(self.root)
                window.title("解锁 DPS 窗口")
                window.attributes("-topmost", True)
                window.configure(cursor="hand2")
                window.bind("<Button-1>", lambda _event: self.toggle_window_lock())
                self.unlock_window = window
                self.unlock_button = None
                self.layered_unlock_presenter = WindowsLayeredPresenter(window)
                self._apply_windows_style(window)
            self._sync_unlock_window_position()
            self.unlock_window.deiconify()
            self.unlock_window.update_idletasks()
            self._sync_unlock_window_position()
            return
        if self.unlock_window is None or not self.unlock_window.winfo_exists():
            window = tk.Toplevel(self.root)
            window.withdraw()
            self.unlock_window = window
            self._prepare_toplevel_dpi(window)
            window.title("解锁 DPS 窗口")
            window.configure(bg=BORDER)
            window.overrideredirect(True)
            window.attributes("-alpha", 1.0)
            locked_icon = self.icons.toolbar("lock", 16, ACCENT)
            locked_hover_icon = self.icons.toolbar("lock", 16, TEXT)
            label = tk.Label(
                window,
                image=locked_icon,
                bg=SURFACE,
                cursor="hand2",
                bd=0,
            )
            label.image = locked_icon
            self.unlock_button = label
            label.pack(fill="both", expand=True, padx=1, pady=1)
            label.bind(
                "<Enter>",
                lambda _event: label.configure(
                    bg=PANEL_2, image=locked_hover_icon
                ),
            )
            label.bind(
                "<Leave>",
                lambda _event: label.configure(bg=SURFACE, image=locked_icon),
            )
            label.bind("<Button-1>", lambda _event: self.toggle_window_lock())
            window.update_idletasks()
            hwnd = self._win32_root_handle(window)
            style = self._win32_extended_style(hwnd)
            if style is not None:
                self._set_win32_extended_style(
                    hwnd,
                    style
                    | WINDOW_EXSTYLE_TOOLWINDOW
                    | WINDOW_EXSTYLE_NOACTIVATE,
                )
        self._sync_unlock_window_position()
        if self.unlock_window.state() != "normal":
            self.unlock_window.deiconify()
        self._set_window_topmost_noactivate(self.unlock_window, True)

    def _apply_window_lock_state(self) -> None:
        if self.closing or not self.root.winfo_exists():
            return
        restored_after_unlock = False
        if self.window_locked:
            self._force_main_topmost_while_locked()
        else:
            restored_after_unlock = self._restore_main_topmost_after_unlock()
        # Tk may rewrite WS_EX_LAYERED when applying alpha. Apply opacity first,
        # then make click-through the final native style operation.
        self._apply_main_transparency()
        click_through_applied = self._set_window_click_through(
            self.root, self.window_locked
        )
        if self.window_locked:
            self._show_unlock_window()
            if not click_through_applied:
                self.root.after(
                    40,
                    lambda: self.window_locked
                    and self._set_window_click_through(self.root, True),
                )
        else:
            self._destroy_unlock_window()
            if restored_after_unlock and self.root.state() == "normal":
                self.root.lift()
                self.root.focus_force()
        after = getattr(self.root, "after", None)
        if callable(after):
            locked = bool(self.window_locked)
            try:
                after(
                    60,
                    lambda expected=locked: self._reassert_main_transparency_after_lock(
                        expected
                    ),
                )
            except tk.TclError:
                pass
        self._sync_action_buttons()
        self._draw_main_header()

    def _hotkey_only_lock_active(self) -> bool:
        tray = getattr(self, "tray_icon", None)
        return bool(
            getattr(self, "window_locked", False)
            and getattr(self, "unlock_hotkey_enabled", False)
            and getattr(self, "unlock_hotkey_registered", False)
            and tray is not None
            and tray.alive
        )

    def toggle_window_lock(self) -> None:
        if self.closing or (
            not self.window_locked and self._startup_interaction_blocked()
        ):
            return
        self.window_locked = not self.window_locked
        self.config["window_locked"] = self.window_locked
        self.drag_state.pop(id(self.root), None)
        self.resize_state.pop(id(self.root), None)
        self._apply_window_lock_state()
        save_config(self.config)

    def _build_ui(self) -> None:
        """Build the single transparent main meter used by the current display schema."""

        transparent = MAIN_TRANSPARENT_KEY
        shell = tk.Frame(self.root, bg=transparent, bd=0)
        self.main_shell = shell
        shell.pack(fill="both", expand=True)
        inset = self._main_px(2)
        self.body = tk.Frame(shell, bg=transparent, bd=0)
        self.body.pack(fill="both", expand=True, padx=inset)

        self.titlebar = tk.Frame(
            self.body,
            bg=transparent,
            height=self._main_px(MAIN_TITLE_HEIGHT),
            bd=0,
        )
        self.titlebar.pack(fill="x")
        self.titlebar.pack_propagate(False)
        self._bind_drag(self.titlebar, self.root)
        self.main_time_text = "00:00"
        self.time_value = tk.Canvas(
            self.titlebar,
            bg=transparent,
            bd=0,
            highlightthickness=0,
            width=self._main_px(66),
