    def _settings_check_row(
        self,
        parent: tk.Misc,
        caption: str,
        variable: tk.BooleanVar,
        *,
        disabled: bool,
        row: int,
        column: int,
        help_text: str = "",
    ) -> None:
        cell = tk.Frame(parent, bg=PANEL, height=54)
        cell.grid(
            row=row,
            column=column,
            sticky="ew",
            padx=(8, 14) if column == 0 else (14, 8),
        )
        cell.grid_propagate(False)
        tk.Frame(cell, bg=BORDER, height=1).pack(side="bottom", fill="x")
        control = ModernCheckControl(
            cell,
            caption,
            variable,
            font=self._ui_font("settings"),
            background=PANEL,
            foreground=TEXT,
            disabled=disabled,
            help_text=help_text,
            help_font=self._ui_font("small"),
        )
        control.pack(fill="both", expand=True, padx=4, pady=(8, 7))

    def _set_native_unlock_hotkey(self, hotkey: str) -> bool:
        tray = getattr(self, "tray_icon", None)
        if tray is None:
            return not hotkey
        parameters = toggle_hotkey_windows_parameters(hotkey) if hotkey else (0, 0)
        if parameters is None:
            return False
        try:
            return bool(tray.set_hotkey(*parameters, action="unlock"))
        except (AttributeError, OSError, RuntimeError):
            return False

    def _register_configured_unlock_hotkey(self) -> bool:
        enabled = bool(
            getattr(self, "unlock_hotkey_enabled", False)
            or getattr(self, "lock_toggle_hotkey_enabled", False)
        )
        key = getattr(self, "unlock_hotkey", "") if enabled else ""
        registered = self._set_native_unlock_hotkey(key)
        # An empty key is a successful unregister, not an active shortcut.
        self.unlock_hotkey_registered = bool(enabled and key and registered)
        self.unlock_hotkey_error = (
            "" if registered else "快捷键不可用，请修改快捷键或关闭相关开关"
        )
        self._sync_unlock_hotkey_controls()
        return registered

    def _set_unlock_hotkey_enabled(self, enabled: bool) -> bool:
        key = getattr(self, "unlock_hotkey", "")
        if enabled and not key:
            self.unlock_hotkey_error = "请先录入解锁快捷键"
            self._sync_unlock_hotkey_controls()
            return False
        if not self._set_native_unlock_hotkey(
            key if enabled or getattr(self, "lock_toggle_hotkey_enabled", False) else ""
        ):
            self.unlock_hotkey_error = "快捷键被占用或服务不可用"
            self._sync_unlock_hotkey_controls()
            return False
        self.unlock_hotkey_enabled = bool(enabled)
        self.unlock_hotkey_registered = bool(
            enabled or getattr(self, "lock_toggle_hotkey_enabled", False)
        )
        self.unlock_hotkey_error = ""
        self.config[UNLOCK_HOTKEY_CONFIG_KEY] = key
        self.config[UNLOCK_HOTKEY_ENABLED_CONFIG_KEY] = bool(enabled)
        save_config(self.config)
        self._sync_unlock_hotkey_controls()
        if getattr(self, "window_locked", False):
            self._apply_window_lock_state()
        return True

    def _apply_unlock_hotkey_enabled_setting(self, *_args) -> None:
        variable = getattr(self, "settings_unlock_hotkey_enabled_var", None)
        if variable is None or getattr(self, "unlock_hotkey_enabled_syncing", False):
            return
        self._set_unlock_hotkey_enabled(bool(variable.get()))

    def _set_lock_toggle_hotkey_enabled(self, enabled: bool) -> bool:
