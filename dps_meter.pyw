    def _open_selected_history_detail(self) -> None:
        if not self.history_selected_id:
            return
        record = self._selected_history_record()
        if record is None:
            self._show_notice(
                "战斗详情",
                "这场战斗的本地文件已不存在，请刷新战斗记录。",
                parent=self.history_window,
            )
            return
        source = record.get("_pvp_record")
        candidate = source if isinstance(source, dict) else record
        try:
            candidate_map_id = int(candidate.get("map_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            candidate_map_id = 0
        if candidate_map_id in HUNTER_CITY_MAPS:
            self._open_hunter_history_detail(candidate)
            return
        browser = getattr(self, "history_browser_frame", None)
        detail = getattr(self, "history_battle_detail_frame", None)
        duel_detail = getattr(self, "history_duel_detail_frame", None)
        if browser is not None and browser.winfo_manager():
            browser.pack_forget()
        use_duel_detail = self._is_pvp_duel_history_record(record)
        self.history_duel_detail_active = use_duel_detail
        if use_duel_detail:
            if detail is not None and detail.winfo_manager():
                detail.pack_forget()
            if duel_detail is not None and not duel_detail.winfo_manager():
                duel_detail.pack(fill="both", expand=True)
            self.history_duel_selected_side = "ally"
            self.history_duel_equipment_selected_player = ""
            self.history_duel_equipment_selected_index = 0
        else:
            if duel_detail is not None and duel_detail.winfo_manager():
                duel_detail.pack_forget()
            if detail is not None and not detail.winfo_manager():
                detail.pack(fill="both", expand=True)
        self.history_page_mode = "detail"
        self._sync_history_detail_toolbar_visibility(not use_duel_detail)
        self._refresh_history_page_extent()
        self._reset_history_page_scroll()
        self._render_history_selection()
        if not use_duel_detail:
            self._draw_history_detail_result()
            self._draw_history_detail_hero()

