    def _set_enrage_prediction_visible(self, visible: bool) -> None:
        visible = bool(
            visible
            and getattr(self, "boss_enrage_prediction_enabled", True)
            and not getattr(self, "compact_mode", False)
        )
        changed = visible != bool(
            getattr(self, "enrage_prediction_visible", False)
        )
        self.enrage_prediction_visible = visible
        if changed:
            self._draw_monster_hp()
        if not visible:
            self._hide_enrage_tooltip()

    def _enrage_forecast_bosses(self) -> list[MonsterStats]:
        current_bosses = getattr(self.model, "current_bosses", None)
        if callable(current_bosses):
            try:
                return list(current_bosses())[:MAX_SIMULTANEOUS_BOSSES]
            except (AttributeError, TypeError, ValueError):
                return []
        monster = self.model.current_monster()
        return [monster] if monster is not None else []

    def _update_enrage_prediction(self, now: float | None = None) -> None:
        predictor = getattr(self, "enrage_predictor", None)
        if predictor is None or not getattr(
            self, "boss_enrage_prediction_enabled", True
        ):
            self.enrage_prediction = None
            self._set_enrage_prediction_visible(False)
            return
        now = time.time() if now is None else float(now)
        bosses = self._enrage_forecast_bosses()
        first_damage_time = float(
            getattr(self.model, "first_damage_time", 0.0) or 0.0
        )
        encounter_running = bool(
            first_damage_time > 0.0
            and not getattr(self.model, "combat_end_time", 0.0)
            and bosses
            and any(
                monster.current_hp is None or float(monster.current_hp) > 0.0
                for monster in bosses
            )
        )
        # The displayed timer already resolves local/shared clocks to a
        # duration. A server start epoch must never be subtracted from local
        # wall time: their offset otherwise gets added to the enrage budget.
        elapsed = self.model.duration(now) if encounter_running else 0.0

        forced_invulnerability = bool(
            getattr(self.model, "long_gap_phase_suspended", False)
        )
        combat_states = getattr(self.model, "entity_combat_states", {})
        if not forced_invulnerability and isinstance(combat_states, dict):
            known_states = [
                bool(combat_states[monster.entity_id])
                for monster in bosses
                if monster.entity_id in combat_states
            ]
            if known_states and not any(known_states):
                forced_invulnerability = True
        dungeon_id = int(
            getattr(self.model, "encounter_dungeon_id", 0)
            or getattr(self.model, "current_dungeon_id", 0)
            or 0
        )
        countdown_elapsed_seconds = None
        countdown_signal = str(
            getattr(self.model, "enrage_countdown_signal", "") or ""
        ).strip()
        countdown_start_100ns = int(
            getattr(self.model, "enrage_countdown_start_100ns", 0) or 0
        )
        matched_rule = predictor.catalog.match(bosses, dungeon_id=dungeon_id)
        if (
            matched_rule is not None
            and matched_rule.countdown_start_signal
            and countdown_signal == matched_rule.countdown_start_signal
            and countdown_start_100ns > 116_444_736_000_000_000
        ):
            countdown_started_at = (
                countdown_start_100ns - 116_444_736_000_000_000
            ) / 10_000_000
            if first_damage_time - 1.0 <= countdown_started_at <= now + 1.0:
                countdown_elapsed_seconds = max(0.0, now - countdown_started_at)
        try:
            prediction = predictor.update(
                encounter_key=getattr(self.model, "encounter_id", ""),
                elapsed_seconds=elapsed,
                bosses=bosses,
                dungeon_id=dungeon_id,
                encounter_running=encounter_running,
                forced_invulnerability=forced_invulnerability,
                monotonic_seconds=time.monotonic(),
                countdown_elapsed_seconds=countdown_elapsed_seconds,
            )
        except (AttributeError, TypeError, ValueError, OverflowError):
            prediction = None
        self.enrage_prediction = prediction
        self._set_enrage_prediction_visible(prediction is not None)
        self._draw_enrage_prediction()

    @staticmethod
    def _enrage_state_palette(state: object) -> tuple[str, str, str]:
        return {
            "ample": ("#10251f", "#4bd6a8", "#bff9e6"),
            "normal": ("#101e2b", "#5aaeea", "#c9e9ff"),
            "critical": ("#2a2417", "#e8b94f", "#fff0b8"),
            "danger": ("#30171b", "#ef6670", "#ffe1e4"),
            "calculating": ("#171b20", "#84909d", "#d0d6dc"),
        }.get(str(state or ""), ("#111b22", BORDER, MUTED))

    def _draw_enrage_prediction(self) -> None:
        prediction = getattr(self, "enrage_prediction", None)
        self._draw_monster_hp()
        tooltip = getattr(self, "enrage_tooltip", None)
        tooltip_canvas = getattr(self, "enrage_tooltip_canvas", None)
        if (
            tooltip is not None
            and tooltip_canvas is not None
            and tooltip.winfo_exists()
        ):
            self._draw_enrage_tooltip_contents(tooltip_canvas, prediction)

    @staticmethod
    def _format_prediction_margin(value: float | None) -> str:
        if value is None or not math.isfinite(value):
            return "--"
        sign = "+" if value >= 0.0 else "-"
        rounded_seconds = int(math.floor(abs(value) + 0.5))
        return f"{sign}{format_duration(rounded_seconds)}"

    def _draw_enrage_tooltip_contents(
        self, canvas: tk.Canvas, prediction: EnragePrediction
    ) -> None:
        canvas.delete("all")
        width = 374
        height = 254
        background, accent, foreground = self._enrage_state_palette(
            prediction.state
        )
        canvas.create_rectangle(
            0,
            0,
            width - 1,
            height - 1,
            fill="#0d1115",
            outline=accent,
            width=1,
        )
        canvas.create_rectangle(1, 1, 5, height - 2, fill=accent, outline="")
        canvas.create_text(
            19,
            18,
            text="狂暴节奏预测",
            fill=foreground,
            anchor="w",
            font=self._ui_font("strong"),
        )
        canvas.create_text(
            width - 18,
            18,
            text=prediction.message,
            fill=accent,
            anchor="e",
            font=self._ui_font("small"),
        )
        canvas.create_line(18, 36, width - 18, 36, fill="#26323a")
        theoretical_hp = float(
            getattr(prediction, "theoretical_remaining_hp", 0.0) or 0.0
        )
        theoretical_percent = float(
            getattr(prediction, "theoretical_remaining_hp_percent", 0.0)
            or 0.0
        )
        actual_stage_percent = float(
            getattr(prediction, "actual_stage_remaining_percent", 0.0)
            or 0.0
        )
        theoretical_stage_percent = float(
            getattr(prediction, "theoretical_stage_remaining_percent", 0.0)
            or 0.0
        )
        progress_delta = float(
            getattr(prediction, "progress_delta_percent", 0.0) or 0.0
        )

        detail_rows = (
            (
                "Boss 当前血量",
                f"{format_number(prediction.boss_current_hp)} / "
                f"{format_number(prediction.boss_max_hp)}  "
                f"{prediction.boss_hp_percent:.1f}%",
            ),
            (
                "阶段已用时间" if getattr(prediction, "countdown_start_signal", "") else "已战斗时间",
                format_duration(prediction.elapsed_seconds),
            ),
            ("狂暴剩余时间", format_duration(math.ceil(prediction.time_to_enrage_seconds))),
            (
                "该时刻理论血量",
                f"{format_number(theoretical_hp)}  ·  {theoretical_percent:.1f}%",
            ),
            (
                "阶段剩余（实际 / 理论）",
                f"{actual_stage_percent:.1f}% / {theoretical_stage_percent:.1f}%",
            ),
            (
                "血量进度差",
                f"{progress_delta:+.1f} 个百分点",
            ),
            (
                "节奏余量",
                self._format_prediction_margin(prediction.safety_margin_seconds),
            ),
        )
        for index, (caption, value) in enumerate(detail_rows):
            y = 54 + index * 25
            canvas.create_text(
                19,
                y,
                text=caption,
                fill=MUTED,
                anchor="w",
                font=self._ui_font("small"),
            )
            canvas.create_text(
                width - 19,
                y,
                text=value,
                fill=TEXT,
                anchor="e",
                font=self._ui_font("small"),
            )
        footer = "仅比较战斗时间与 Boss 血量 · 颜色变化持续 3 秒后确认"
        canvas.create_rectangle(
            12,
            height - 31,
            width - 12,
            height - 10,
            fill=background,
            outline="",
        )
        canvas.create_text(
            width // 2,
            height - 20,
            text=footer,
            fill=accent,
            font=self._ui_font("micro"),
        )

    def _track_enrage_tooltip(self, event) -> None:
        if not bool(getattr(self, "enrage_prediction_visible", False)):
            self._hide_enrage_tooltip()
            return
        try:
            pointer_x = int(event.x)
            pointer_y = int(event.y)
        except (AttributeError, TypeError, ValueError):
            self._hide_enrage_tooltip()
            return
        hit = any(
            left <= pointer_x <= right and top <= pointer_y <= bottom
            for left, top, right, bottom in getattr(
                self, "enrage_prediction_hit_regions", ()
            )
        )
        if not hit:
            self._hide_enrage_tooltip()
            return
        tooltip = getattr(self, "enrage_tooltip", None)
        try:
            tooltip_visible = tooltip is not None and tooltip.winfo_exists()
        except (AttributeError, tk.TclError):
            tooltip_visible = False
        if not tooltip_visible:
            self._show_enrage_tooltip(event)

    def _show_enrage_tooltip(self, _event=None) -> None:
        prediction = getattr(self, "enrage_prediction", None)
        canvas = (
            self.root
            if self._layered_main_active()
            else getattr(self, "enrage_prediction_canvas", None)
        )
        if (
            prediction is None
            or canvas is None
            or not bool(getattr(self, "enrage_prediction_visible", False))
        ):
            return
        self._hide_enrage_tooltip()
        tooltip = tk.Toplevel(self.root)
        tooltip.withdraw()
        tooltip.overrideredirect(True)
        tooltip.configure(bg="#0d1115")
        try:
            tooltip.transient(self.root)
            tooltip.attributes("-topmost", bool(self.root.attributes("-topmost")))
        except tk.TclError:
            pass
        tooltip_width, tooltip_height = 374, 254
        tooltip_canvas = tk.Canvas(
            tooltip,
            width=tooltip_width,
            height=tooltip_height,
            bg="#0d1115",
            bd=0,
            highlightthickness=0,
        )
        tooltip_canvas.pack(fill="both", expand=True)
        self._draw_enrage_tooltip_contents(tooltip_canvas, prediction)
        tooltip.update_idletasks()
        x, y = help_popup_position(
            canvas.winfo_rootx(),
            canvas.winfo_rooty(),
            canvas.winfo_width(),
            canvas.winfo_height(),
            tooltip_width,
            tooltip_height,
            monitor_work_area_for_widget(canvas),
        )
        tooltip.geometry(
            format_absolute_tk_geometry(
                tooltip_width, tooltip_height, x, y
            )
        )
        tooltip.deiconify()
        self.enrage_tooltip = tooltip
        self.enrage_tooltip_canvas = tooltip_canvas

    def _hide_enrage_tooltip(self, _event=None) -> None:
        tooltip = getattr(self, "enrage_tooltip", None)
        if tooltip is not None:
            try:
                if tooltip.winfo_exists():
                    tooltip.destroy()
            except (AttributeError, tk.TclError):
                pass
        self.enrage_tooltip = None
        self.enrage_tooltip_canvas = None

    def _draw_monster_hp(self) -> None:
        if self._layered_main_active():
            self._schedule_layered_main_render()
            return
        canvas = self.monster_hp_canvas
        canvas.delete("all")
        self.enrage_prediction_hit_regions = []
        if not bool(getattr(self, "show_boss_hp_bar", True)):
            return

        width = max(1, canvas.winfo_width())
        height_reader = getattr(canvas, "winfo_height", None)
        height = max(
            1,
            int(height_reader())
            if callable(height_reader)
            else self._main_px(MAIN_BOSS_HEIGHT),
        )
        if self._main_targetless_team_data() is not None:
            mode_name = self._fit_ui_text(
                self._main_targetless_mode_name(),
                max(1, width - self._main_px(16)),
                "main_strong",
            )
            canvas_outlined_text(
                canvas,
                self._main_px(8),
                height // 2,
                text=mode_name,
                fill="#fff5f6",
                anchor="w",
                font=self._ui_font("main_strong"),
                outline_width=max(1, self._main_px(1)),
            )
            return
        current_monster = getattr(self.model, "current_monster", None)
        monster = current_monster() if callable(current_monster) else None
        if monster is None:
            current_bosses = getattr(self.model, "current_bosses", None)
            bosses = list(current_bosses()) if callable(current_bosses) else []
            monster = bosses[0] if bosses else None
        display_name = "暂无目标"
        current_hp = None
        maximum_hp = None
        if monster is not None:
            display_name = str(getattr(monster, "name", "") or "").strip()
            if not display_name or boss_name_is_placeholder(display_name):
                display_target_name = getattr(self.model, "display_target_name", None)
                display_name = (
                    str(display_target_name(getattr(monster, "entity_id", 0)) or "")
                    if callable(display_target_name)
                    else ""
                )
            display_name = display_name or "Boss"
            current_hp = getattr(monster, "current_hp", None)
            monster_max_hp = getattr(monster, "max_hp", None)
            maximum_hp = (
                monster_max_hp
                if monster_max_hp is not None and monster_max_hp > 0
                else None
            )

        prediction = getattr(self, "enrage_prediction", None)
        prediction_ready = bool(
            getattr(self, "boss_enrage_prediction_enabled", True)
            and getattr(self, "enrage_prediction_visible", False)
            and prediction is not None
            and not bool(getattr(prediction, "calculating", False))
        )

        icon_logical_size = 46.0 * float(
            getattr(self, "main_ui_scale", 1.0) or 1.0
        )
        icon_size = min(
            self._main_px(46), max(self._main_px(30), height - self._main_px(4))
        )
        icons = getattr(self, "icons", None)
        icon = (
            icons.main_boss_icon(icon_logical_size)
            if icons is not None
            else None
        )
        icon_x = self._main_px(0)
        icon_y = max(0, (height - icon_size) // 2)
        bar_left = self._main_px(31) if icon is not None else self._main_px(1)
        bar_right = max(bar_left + 1, width - self._main_px(1))
        bar_top = self._main_px(18 if prediction_ready else 9)
        bar_bottom = min(
            height - self._main_px(2), bar_top + self._main_px(32)
        )
        bar_radius = max(self._main_px(7), (bar_bottom - bar_top) // 2)

        hp_pending = current_hp is None
        ratio = health_bar_ratio(current_hp, maximum_hp)
        canvas_rounded_rectangle(
            canvas,
            bar_left - self._main_px(1),
            bar_top - self._main_px(1),
            bar_right + self._main_px(1),
            bar_bottom + self._main_px(1),
            bar_radius + self._main_px(1),
            fill="#16040b",
            outline="#650b2a",
            width=max(2, self._main_px(3)),
        )
        canvas_rounded_rectangle(
            canvas,
            bar_left,
            bar_top,
            bar_right,
            bar_bottom,
            bar_radius,
            fill="#252a31" if hp_pending else "#250611",
            outline="#68727d" if hp_pending else "#f01c50",
            width=max(1, self._main_px(2)),
        )
        if ratio > 0:
            fill_right = bar_left + max(
                self._main_px(2), int((bar_right - bar_left) * ratio)
            )
            canvas_rounded_rectangle(
                canvas,
                bar_left + 1,
                bar_top + 1,
                min(bar_right - 1, fill_right),
                bar_bottom - 1,
                min(bar_radius - 1, max(1, (fill_right - bar_left) // 2)),
                fill="#700a2b",
                outline="",
            )
        canvas_rounded_rectangle(
            canvas,
            bar_left + self._main_px(3),
            bar_top + self._main_px(3),
            bar_right - self._main_px(3),
            bar_bottom - self._main_px(3),
            max(1, bar_radius - self._main_px(3)),
            fill="",
            outline="#7f1737",
            width=max(1, self._main_px(1)),
        )

        hp_text = (
            format_team_health_number(current_hp)
            if current_hp is not None
            else "-- / --"
        )
        percent_text = "--"
        if maximum_hp is not None:
            hp_text = (
                f"{format_team_health_number(current_hp)} / "
                f"{format_team_health_number(maximum_hp)}"
            )
        if current_hp is not None and maximum_hp is not None and maximum_hp > 0:
            percent = ratio * 100.0
            percent_text = (
                f"{percent:.0f}%"
                if percent in (0.0, 100.0)
                else f"{percent:.1f}%"
            )

        bar_width = max(1, bar_right - bar_left)
        name_x = max(
            bar_left + self._main_px(12),
            icon_x + icon_size - self._main_px(2),
        )
        hp_x = bar_right - self._main_px(68)
        name_text = self._fit_ui_text(
            display_name,
            max(self._main_px(48), hp_x - name_x - self._main_px(104)),
            "main_strong",
        )
        middle_y = (bar_top + bar_bottom) // 2
        canvas_outlined_text(
            canvas,
            name_x,
            middle_y,
            text=name_text,
            fill="#fff5f6",
            anchor="w",
            font=self._ui_font("main_strong"),
            outline_width=max(1, self._main_px(1)),
        )
        canvas_outlined_text(
            canvas,
            hp_x,
            middle_y,
            text=hp_text,
            fill="#f3dfe2",
            anchor="e",
            font=self._ui_font("main_number_small"),
            outline_width=max(1, self._main_px(1)),
        )
        canvas_outlined_text(
            canvas,
            bar_right - self._main_px(8),
            middle_y,
            text=percent_text,
            fill="#ff5d78" if percent_text != "--" else "#bf8190",
            anchor="e",
            font=self._ui_font("main_number_strong"),
            outline_width=max(1, self._main_px(1)),
        )

        if prediction_ready:
            background, accent, foreground = self._enrage_state_palette(
                prediction.state
            )
            marker_x = int(
                round(
                    bar_left
                    + (bar_right - bar_left) * enrage_marker_ratio(prediction)
                )
            )
            prediction_text = str(prediction.message or "节奏预测")
            prediction_font = self._ui_font("main_micro")
            try:
                prediction_width = int(prediction_font.measure(f"⚠ {prediction_text}"))
            except (AttributeError, TypeError, ValueError, tk.TclError):
                prediction_width = self._main_px(118)
            label_width = min(
                max(self._main_px(106), prediction_width + self._main_px(18)),
                max(self._main_px(120), int(bar_width * 0.62)),
            )
            label_right = bar_right
            label_left = max(bar_left, label_right - label_width)
            label_top = 0
            label_bottom = self._main_px(18)
            canvas_rounded_rectangle(
                canvas,
                label_left,
                label_top,
                label_right,
                label_bottom,
                self._main_px(8),
                fill=background,
                outline=accent,
                width=max(1, self._main_px(1)),
            )
            canvas_outlined_text(
                canvas,
                (label_left + label_right) // 2,
                (label_top + label_bottom) // 2,
                text=self._fit_ui_text(
                    f"⚠ {prediction_text}",
                    label_width - self._main_px(10),
                    "main_micro",
                ),
                fill=foreground,
                anchor="center",
                font=prediction_font,
                outline_width=max(1, self._main_px(1)),
            )
            arrow_x = max(
                label_left + self._main_px(8),
                min(label_right - self._main_px(8), marker_x),
            )
            canvas.create_polygon(
                arrow_x - self._main_px(4),
                label_bottom - self._main_px(1),
                arrow_x + self._main_px(4),
                label_bottom - self._main_px(1),
                arrow_x,
                bar_top + self._main_px(2),
                fill=accent,
                outline=accent,
            )
            self.enrage_prediction_hit_regions.append(
                (label_left, label_top, label_right, label_bottom)
            )

        create_image = getattr(canvas, "create_image", None)
        if icon is not None and callable(create_image):
            create_image(icon_x, icon_y, image=icon, anchor="nw")

    def _draw_main_header(self) -> None:
        canvas = self.header_canvas
        canvas.delete("all")
        # The approved schema has no visible table header or compact controls.
        try:
            canvas.configure(height=0)
        except (AttributeError, tk.TclError):
            pass
        return

        # Retained below as inert downgrade reference for old configuration
        # semantics; it is never reached by the schema v1 renderer.
        width = max(1, canvas.winfo_width())
        columns = self._main_columns(width)
        compact = self.compact_mode
        rating_preview = self._team_rating_preview_active()
        meter_mode = getattr(self, "main_meter_mode", "dps")
        healing_mode = meter_mode == "hps"
        taken_mode = meter_mode == "dt"
        boss_mode = meter_mode == "boss"
        header_font = self._ui_font(
            "table_header_compact" if compact else "table_header"
        )
        if boss_mode:
            captions = {
                "boss_damage": "伤害" if compact else "已归类伤害",
                "boss_share": "占比" if compact else "归类占比",
                "boss_hits": "命中" if compact else "命中次数",
                "boss_max_hit": "最高" if compact else "最高一击",
            }
        elif healing_mode:
            captions = {
                "effective": "有效" if compact else "有效治疗",
                "hps": "HPS",
                "overheal": "过量" if compact else "过量率",
            }
        elif taken_mode:
            captions = {
                "taken": "承伤" if compact else "总承伤",
                "taken_share": "占比" if compact else "承伤占比",
            }
        else:
            captions = (
                {
                    "damage": "伤害",
                    "dps": "DPS",
                    "share": "占比",
                    "critical": "暴击",
                    "penetration": "穿刺",
                    "deaths": "死亡",
                    "revives": "复活",
                    "death_time": "死时",
                }
                if compact
                else {
                    "damage": "总伤害",
                    "dps": "秒伤",
                    "share": "占比",
                    "critical": "暴击率",
                    "penetration": "穿刺率",
                    "deaths": "死亡",
                    "revives": "复活",
                    "death_time": "死亡时间",
                }
            )
        canvas.create_text(
            34 if compact else 42,
            14,
            text=("技能" if compact else "首领技能") if boss_mode else (
                "玩家" if compact else "玩家名称"
            ),
            fill=TEXT,
            anchor="w",
            font=header_font,
        )
        if not rating_preview:
            for key in (
                ("boss_damage", "boss_share", "boss_hits", "boss_max_hit")
                if boss_mode
                else ("effective", "hps", "overheal")
                if healing_mode
                else (
                    ("taken", "taken_share")
                    if taken_mode
                    else (
                        "damage",
                        "dps",
                        "share",
                        "critical",
                        "penetration",
                        "deaths",
                        "revives",
                        "death_time",
                    )
                )
            ):
                if key not in columns:
                    continue
                canvas.create_text(
                    columns[key],
                    14,
                    text=captions[key],
                    fill=TEXT,
                    anchor="e",
                    font=header_font,
                )
        canvas.create_line(0, 27, width, 27, fill=BORDER)
        if compact:
            canvas.create_rectangle(
                width - 64,
                2,
                width - 34,
                26,
                fill=SURFACE,
                outline="",
                tags=("compact_lock", "compact_lock_bg"),
            )
            lock_icon = self.icons.toolbar(
                "lock" if self.window_locked else "unlock",
                14,
                ACCENT if self.window_locked else TEXT,
            )
            canvas.create_image(
                width - 49,
                14,
                image=lock_icon,
                tags=("compact_lock",),
            )
            canvas.tag_bind(
                "compact_lock", "<Button-1>", self._toggle_lock_from_header
            )
            canvas.tag_bind(
                "compact_lock", "<Enter>", self._compact_lock_enter
            )
            canvas.tag_bind(
                "compact_lock", "<Leave>", self._compact_lock_leave
            )
            canvas.create_rectangle(
                width - 32,
                2,
                width - 2,
                26,
                fill=SURFACE,
                outline="",
                tags=("compact_restore", "compact_restore_bg"),
            )
            restore_icon = self.icons.toolbar("expand", 15, TEXT)
            canvas.create_image(
                width - 17,
                14,
                image=restore_icon,
                tags=("compact_restore",),
            )
            canvas.tag_bind(
                "compact_restore",
                "<Button-1>",
                self._restore_compact_from_header,
            )
            canvas.tag_bind(
                "compact_restore", "<Enter>", self._compact_restore_enter
            )
            canvas.tag_bind(
                "compact_restore", "<Leave>", self._compact_restore_leave
            )

    def _toggle_lock_from_header(self, _event=None) -> str:
        self.toggle_window_lock()
        return "break"

    def _compact_lock_enter(self, _event=None) -> None:
        self.header_canvas.configure(cursor="hand2")
