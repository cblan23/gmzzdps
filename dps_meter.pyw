            for line in (
                (12, 2, 12, 6),
                (12, 18, 12, 22),
                (2, 12, 6, 12),
                (18, 12, 22, 12),
                (5, 5, 8, 8),
                (16, 16, 19, 19),
                (19, 5, 16, 8),
                (8, 16, 5, 19),
            ):
                draw.line(tuple(point(value) for value in line), fill=stroke, width=width)
        elif name in {"pin", "pin_off"}:
            draw.line(
                (
                    point(8),
                    point(4),
                    point(16),
                    point(4),
                    point(15),
                    point(9),
                    point(18),
                    point(12),
                    point(6),
                    point(12),
                    point(9),
                    point(9),
                    point(8),
                    point(4),
