    def _build_backend_history_page(self, parent: tk.Misc) -> tk.Frame:
        page = tk.Frame(parent, bg=BG, width=760, height=650)
        page.grid_rowconfigure(0, weight=1)
        page.grid_columnconfigure(0, weight=1)
        self.history_page_root = page
        canvas = tk.Canvas(
            page,
            bg=BG,
            bd=0,
            highlightthickness=0,
            yscrollincrement=32,
        )
        self.history_page_canvas = canvas
        scrollbar = ModernScrollbar(
            page,
            orient="vertical",
            command=canvas.yview,
            background=BG,
            width=10,
        )
        self.history_page_scrollbar = scrollbar
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.grid(row=0, column=0, sticky="nsew")
        scrollbar.grid(row=0, column=1, sticky="ns")
        page.winfo_toplevel().bind(
            "<MouseWheel>", self._scroll_history_page, add="+"
        )

        content = tk.Frame(canvas, bg=BG, width=760)
        content_window = canvas.create_window(
            0,
            0,
            window=content,
            anchor="nw",
        )
        self.history_page_content_window = content_window
        canvas.bind("<Configure>", self._resize_history_page_content)
        self.history_browser_frame = tk.Frame(
            content,
            bg=BG,
            width=760,
            height=HISTORY_PAGE_MIN_CONTENT_HEIGHT,
        )
        self.history_browser_frame.pack_propagate(False)
        self.history_battle_detail_frame = tk.Frame(
            content,
            bg=BG,
            width=760,
            height=HISTORY_PAGE_MIN_CONTENT_HEIGHT,
        )
        self.history_battle_detail_frame.pack_propagate(False)
        self.history_duel_detail_frame = tk.Frame(
            content,
            bg=BG,
            width=760,
            height=HISTORY_PAGE_MIN_CONTENT_HEIGHT,
        )
        self.history_duel_detail_frame.pack_propagate(False)
        self._build_history_browser_view(self.history_browser_frame)
        self._build_history_detail_view(self.history_battle_detail_frame)
        self._build_pvp_duel_detail_view(self.history_duel_detail_frame)
        self._show_history_browser()
        return page

    def _resize_history_page_content(self, event) -> None:
        self._refresh_history_page_extent(
            viewport_width=getattr(event, "width", 1),
            viewport_height=getattr(event, "height", 1),
        )

    def _refresh_history_page_extent(
        self,
        *,
        viewport_width: object | None = None,
        viewport_height: object | None = None,
    ) -> None:
        canvas = getattr(self, "history_page_canvas", None)
        window_id = getattr(self, "history_page_content_window", None)
        if canvas is None or window_id is None:
            return
        try:
            width = max(
                1,
                int(
                    canvas.winfo_width()
                    if viewport_width is None
                    else viewport_width
                ),
            )
        except (TypeError, ValueError, OverflowError, tk.TclError):
            width = 1
        try:
            viewport = max(
                1,
                int(
                    canvas.winfo_height()
                    if viewport_height is None
                    else viewport_height
                ),
            )
        except (TypeError, ValueError, OverflowError, tk.TclError):
            viewport = 1
        duel_detail = bool(getattr(self, "history_duel_detail_active", False))
        detail_minimum = (
            HISTORY_DUEL_DETAIL_MIN_CONTENT_HEIGHT
            if duel_detail
            else self._history_detail_minimum_content_height()
        )
        stacked_detail = (
            not duel_detail
            and getattr(self, "history_page_mode", "browser") == "detail"
            and width - 36 < HISTORY_DETAIL_STACK_WIDTH
        )
        if stacked_detail:
            metric_row_height = max(
                76,
                self._ui_font("micro").metrics("linespace")
                + self._ui_font("number_large").metrics("linespace") + 20,
            )
            detail_minimum += (
                HISTORY_DETAIL_STACK_WORKSPACE_HEIGHT
                - NATIVE_DETAIL_WORKSPACE_HEIGHT
                + 2 * metric_row_height - 76
            )
        minimum = (
            detail_minimum
            if getattr(self, "history_page_mode", "browser") == "detail"
            else HISTORY_PAGE_MIN_CONTENT_HEIGHT
        )
        height = max(
            minimum,
            viewport,
        )
        try:
            if self.history_browser_frame is not None:
                self.history_browser_frame.configure(
                    width=width,
                    height=max(HISTORY_PAGE_MIN_CONTENT_HEIGHT, viewport),
                )
            if self.history_battle_detail_frame is not None:
                self.history_battle_detail_frame.configure(
                    width=width,
                    height=max(detail_minimum, viewport),
                )
            workspace = getattr(self, "history_detail_workspace", None)
            if workspace is not None:
                desired_height = (
                    HISTORY_DETAIL_STACK_WORKSPACE_HEIGHT
                    if stacked_detail else NATIVE_DETAIL_WORKSPACE_HEIGHT
                )
                if int(workspace.cget("height")) != desired_height:
                    workspace.configure(height=desired_height)
            duel_frame = getattr(self, "history_duel_detail_frame", None)
            if duel_frame is not None:
                duel_frame.configure(
                    width=width,
                    height=max(HISTORY_DUEL_DETAIL_MIN_CONTENT_HEIGHT, viewport),
                )
            canvas.itemconfigure(window_id, width=width, height=height)
            canvas.configure(scrollregion=(0, 0, width, height))
        except tk.TclError:
            return

    def _history_detail_minimum_content_height(self) -> int:
        equipment_height = (
            346 if bool(getattr(self, "history_equipment_visible", False)) else 0
        )
        if bool(
            getattr(self, "history_local_detail_modules_visible", True)
        ):
            opener_height = max(
                HISTORY_OPENER_PANEL_MIN_HEIGHT,
                int(
                    getattr(
                        self,
                        "history_opener_panel_height",
                        HISTORY_OPENER_PANEL_MIN_HEIGHT,
                    )
                    or HISTORY_OPENER_PANEL_MIN_HEIGHT
                ),
            )
            return equipment_height + (
                HISTORY_DETAIL_MIN_CONTENT_HEIGHT
                + opener_height
                - HISTORY_OPENER_PANEL_MIN_HEIGHT
            )
        return equipment_height + max(
            HISTORY_PAGE_MIN_CONTENT_HEIGHT,
            HISTORY_DETAIL_MIN_CONTENT_HEIGHT
            - HISTORY_DETAIL_LOCAL_MODULES_HEIGHT,
        )

    def _scroll_history_page(self, event) -> str | None:
        canvas = getattr(self, "history_page_canvas", None)
        if canvas is None or not canvas.winfo_exists():
            return None
        widget = getattr(event, "widget", None)
        inner_canvases = {
            getattr(self, "history_list_canvas", None),
            getattr(self, "history_participant_canvas", None),
            getattr(self, "history_skill_canvas", None),
            getattr(self, "history_equipment_canvas", None),
            getattr(self, "history_skill_quality_canvas", None),
            getattr(self, "history_skill_timeline_canvas", None),
        }
        if widget in inner_canvases:
            return None
        amount = self._history_mousewheel_amount(event)
        if not amount:
            return None
        try:
            canvas.yview_scroll(amount, "units")
        except tk.TclError:
            return None
        return "break"

    def _reset_history_page_scroll(self) -> None:
        canvas = getattr(self, "history_page_canvas", None)
        if canvas is None:
            return
        try:
            canvas.yview_moveto(0.0)
        except tk.TclError:
            return

    @staticmethod
    def _history_mousewheel_amount(event) -> int:
        try:
            button = int(getattr(event, "num", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            button = 0
        try:
            delta = int(getattr(event, "delta", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            delta = 0
        if button == 4:
            amount = -1
        elif button == 5:
            amount = 1
        elif delta:
            amount = -max(1, abs(delta) // 120) if delta > 0 else max(
                1, abs(delta) // 120
            )
        else:
            return 0
        return amount

    def _scroll_history_inner_canvas(self, canvas: tk.Canvas, event) -> str:
        amount = self._history_mousewheel_amount(event)
        if not amount:
            return "break"
        page_canvas = getattr(self, "history_page_canvas", None)

        def scroll_page() -> None:
            try:
                if page_canvas is not None and page_canvas.winfo_exists():
                    page_canvas.yview_scroll(amount, "units")
            except tk.TclError:
                pass

        before: tuple[float, float] | None = None
        try:
            first, last = (float(value) for value in canvas.yview())
            before = (first, last)
        except (AttributeError, TypeError, ValueError, tk.TclError):
            pass
        can_scroll_inner = before is None or (
            before[1] - before[0] < 0.999999
            and (
                (amount < 0 and before[0] > 0.000001)
                or (amount > 0 and before[1] < 0.999999)
            )
        )
        if not can_scroll_inner:
            scroll_page()
            return "break"
        try:
            canvas.yview_scroll(amount, "units")
        except tk.TclError:
            scroll_page()
            return "break"
        if before is not None:
            try:
                after = tuple(float(value) for value in canvas.yview())
            except (AttributeError, TypeError, ValueError, tk.TclError):
                after = None
            if after is not None and all(
                abs(current - previous) <= 0.0000001
                for current, previous in zip(after, before)
            ):
                scroll_page()
        return "break"

    def _bind_history_inner_mousewheel(
        self,
        canvas: tk.Canvas,
        *event_widgets: tk.Misc,
    ) -> None:
        for widget in (canvas, *event_widgets):
            for event_name in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
                widget.bind(
                    event_name,
                    lambda event, target=canvas: self._scroll_history_inner_canvas(
                        target, event
                    ),
                )

