    def _sync_backend_pin_button(self) -> None:
        button = getattr(self, "history_pin_button", None)
        if button is None or not button.winfo_exists():
            return
        topmost = bool(getattr(self, "backend_topmost", False))
        button._icon_name = "pin" if topmost else "pin_off"
        button._normal_fg = ACCENT if topmost else "#c5ccd3"
        button._hover_fg = ACCENT if topmost else TEXT
        button._description = "取消置顶" if topmost else "置顶"
        self._render_titlebar_icon_button(button)

    def _sync_backend_window_topmost(self) -> None:
        self._sync_backend_pin_button()
        window = self.history_window
        if window is None or not window.winfo_exists():
            return
        # Settings must remain reachable while a topmost game/overlay window
        # is active. This is a temporary page-level elevation; the pin switch
        # still controls the saved topmost preference for all other pages.
        topmost = bool(
            getattr(self, "backend_topmost", False)
            or getattr(self, "backend_current_page", "history") == "settings"
        )
        try:
            current_topmost = bool(window.attributes("-topmost"))
        except (AttributeError, TypeError, tk.TclError):
            current_topmost = not bool(topmost)
        if current_topmost != bool(topmost):
            window.attributes("-topmost", bool(topmost))
        self._set_window_topmost_noactivate(window, bool(topmost))

    def toggle_backend_topmost(self) -> None:
        self.backend_topmost = not bool(
            getattr(self, "backend_topmost", False)
        )
        self.config[BACKEND_TOPMOST_CONFIG_KEY] = self.backend_topmost
        self._sync_backend_window_topmost()
        save_config(self.config)

