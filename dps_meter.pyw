    def _confirm_history_cleanup(self, scope: str) -> None:
        self._close_history_modal()
        if scope == "selected":
            count = len(self.history_selected_ids)
            if count <= 0:
                self._show_notice(
                    "清理记录",
                    "当前没有选中的战斗记录。",
                    parent=self.history_window,
                )
                return
            message = f"确定删除选中的 {count} 场战斗记录吗？删除后无法恢复。"
        elif scope in {"30", "90"}:
            message = f"确定删除 {scope} 天以前的战斗记录吗？删除后无法恢复。"
        else:
            message = "确定清空全部战斗记录吗？删除后无法恢复。"

        def remove() -> None:
            if scope == "selected":
                self.history_store.delete_many(self.history_selected_ids)
                self.history_selected_ids.clear()
            elif scope in {"30", "90"}:
                self.history_store.delete_older_than(int(scope))
            else:
                self.history_store.delete_all()
                self.history_selected_ids.clear()
            self.history_selected_id = ""
            self.history_loaded_record = None
            self._show_history_browser()
            self._refresh_history_records()

        self._show_notice(
            "确认清理",
            message,
            parent=self.history_window,
            confirm_text="确认删除",
            cancel_text="取消",
            on_confirm=remove,
        )

    def _add_history_note(self) -> None:
        record = self._selected_history_record()
        if record is None:
            return
        _panel, body, _overlay = self._open_history_modal(
            "添加战斗备注", width=450, height=300
        )
        tk.Label(
            body,
            text="备注会参与战斗记录搜索，仅保存在当前电脑。",
            bg=PANEL,
            fg=MUTED,
            anchor="w",
            font=self._ui_font("small"),
        ).pack(fill="x", pady=(0, 8))
        editor = ModernTextArea(
            body,
            font=self._ui_font("body"),
            background=SURFACE,
            height=112,
        )
        editor.pack(fill="both", expand=True)
        editor.insert("1.0", str(record.get("note", "") or ""))
        footer = tk.Frame(body, bg=PANEL)
        footer.pack(fill="x", pady=(9, 0))

        def save_note() -> None:
            updated = self.history_store.set_note(
