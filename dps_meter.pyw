    def _toggle_history_favorite_by_id(self, battle_id: str) -> str:
        battle_id = str(battle_id)
        summary = next(
            (
                row
                for row in self.history_records
                if str(row.get("battle_id", row.get("encounter_id", "")))
                == battle_id
            ),
            None,
        )
        record = summary if summary is not None else self.history_store.load(battle_id)
        if record is None:
            return "break"
        updated = self.history_store.set_favorite(
            battle_id, not bool(record.get("favorite"))
        )
        if updated is not None:
            if battle_id == self.history_selected_id:
                self.history_loaded_record = self._restore_history_record(updated)
            self._refresh_history_records()
        return "break"

    def _toggle_history_favorite(self) -> None:
        record = self._selected_history_record()
        if record is None:
            return
        self._toggle_history_favorite_by_id(
            str(record.get("encounter_id", record.get("battle_id", "")))
        )

    def _open_history_modal(
        self, title: str, *, width: int = 430, height: int = 270
    ) -> tuple[tk.Frame, tk.Frame, tk.Frame]:
        self._close_history_modal()
        host = self.history_page_root
        if host is None:
            raise tk.TclError("history page is unavailable")
        overlay = tk.Frame(host, bg="#050607")
        overlay.place(x=0, y=0, relwidth=1, relheight=1)
        overlay.lift()
        panel = tk.Frame(
            overlay,
            bg=PANEL,
            width=width,
            height=height,
            highlightthickness=1,
            highlightbackground=BORDER,
        )
        panel.place(relx=0.5, rely=0.5, anchor="center")
        panel.pack_propagate(False)
        header = tk.Frame(panel, bg=SURFACE, height=44)
        header.pack(fill="x")
        header.pack_propagate(False)
        tk.Label(
            header,
            text=title,
            bg=SURFACE,
            fg=TEXT,
            anchor="w",
            font=self._ui_font("title"),
        ).pack(side="left", padx=14, fill="y")
        close = tk.Label(
            header,
            text="×",
            bg=SURFACE,
            fg=MUTED,
            width=4,
            cursor="hand2",
            font=self._ui_font("icon"),
