            "history-select-all",
            "<Enter>",
            lambda _event: canvas.configure(cursor="hand2"),
        )
        canvas.tag_bind(
            "history-select-all",
            "<Leave>",
            lambda _event: canvas.configure(cursor=""),
        )

    def _draw_indexed_history_list(self) -> None:
        canvas = self.history_list_canvas
        if canvas is None:
            return
        canvas.delete("all")
        viewport_width = max(1, canvas.winfo_width())
        width = self._history_list_content_width(viewport_width)
        height = max(1, canvas.winfo_height())
        if not self.history_records:
            filtered = bool(
                self._history_filter_value("query")
                or (
                    self.history_filter_time_var is not None
                    and self.history_filter_time_var.get() != "全部"
                )
                or (
                    self.history_filter_result_var is not None
                    and self.history_filter_result_var.get() != "战斗结果  全部"
                )
            )
            canvas.create_text(
                viewport_width // 2,
                height // 2 - 18,
                text=(
                    "没有找到符合条件的战斗记录"
                    if filtered
                    else "暂无 Boss 战斗记录"
                ),
                fill=TEXT,
                font=self._ui_font("strong"),
            )
            canvas.create_text(
                viewport_width // 2,
                height // 2 + 5,
                text=(
                    "清除筛选条件"
                    if filtered
                    else "完成一次有效 Boss 战斗后，记录会自动出现在这里"
                ),
                fill=ACCENT if filtered else MUTED,
                font=self._ui_font("micro"),
                tags=("history-clear-filters",) if filtered else (),
            )
            if filtered:
                canvas.tag_bind(
                    "history-clear-filters",
                    "<Button-1>",
                    lambda _event: self._clear_history_filters(),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        base_row_height = 68
        content_height = len(self.history_records) * base_row_height
        if self.history_page_count > 1:
            content_height = max(content_height, height)
        canvas.configure(yscrollincrement=base_row_height)
        columns = self._history_list_columns(width)
        right = columns["right"]
        for index, summary in enumerate(self.history_records):
            top = round(index * content_height / len(self.history_records))
            bottom = round(
                (index + 1) * content_height / len(self.history_records)
            )
            row_height = bottom - top
            middle = top + row_height // 2
            primary_y = middle - 14
            secondary_y = middle + 11
            battle_id = str(
                summary.get("battle_id", summary.get("encounter_id", ""))
            )
            selected = battle_id == self.history_selected_id
            checked = battle_id in self.history_selected_ids
            base = PANEL_2 if selected else (PANEL if index % 2 == 0 else SURFACE)
            tag = f"history:{index}"
            check_tag = f"history-check:{index}"
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline="", tags=(tag,)
            )
            canvas.create_rectangle(
                0,
                top,
                3,
                bottom - 1,
                fill=ACCENT if selected else base,
                outline="",
                tags=(tag,),
            )
            self._draw_history_checkbox(
                canvas,
                columns["check"],
                middle,
                "checked" if checked else "empty",
                (check_tag,),
            )
            duration = summary.get("duration_seconds")
            try:
                duration_text = format_duration(float(duration))
            except (TypeError, ValueError, OverflowError):
                duration_text = "--:--"
            try:
                timestamp = dt.datetime.fromtimestamp(
                    float(
                        summary.get(
                            "started_at_epoch", summary.get("ended_at_epoch", 0.0)
                        )
                        or 0.0
                    )
                )
                occurred_text = timestamp.strftime("%m-%d · %H:%M")
            except (OSError, TypeError, ValueError, OverflowError):
                occurred_text = "发生时间未知"
            canvas.create_text(
                columns["time"],
                primary_y,
                text=duration_text,
                fill=TEXT,
                anchor="w",
                font=self._ui_font("number_strong"),
                tags=(tag,),
            )
            canvas.create_text(
                columns["time"],
                secondary_y,
                text=occurred_text,
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            dungeon_name = str(summary.get("dungeon_name", "")).strip() or "未知区域"
            encounter_title = self._history_encounter_title(summary)
            boss_name = str(summary.get("boss_name", "")).strip() or encounter_title
            boss_icon = self.icons.boss(
                summary.get("boss_icon", ""), boss_name, size=50
            )
            canvas.create_image(
                columns["icon"],
                middle,
                image=boss_icon,
                anchor="w",
                tags=(tag,),
            )
            content_x = columns["content"]
            available = max(36, columns["content_right"] - content_x)
            canvas.create_text(
                content_x,
                primary_y,
                text=self._fit_ui_text(
                    encounter_title,
                    available,
                    "strong",
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
                tags=(tag,),
            )
            canvas.create_text(
                content_x,
                secondary_y,
                text=self._fit_ui_text(
                    (
                        f"副本 · {dungeon_name}"
                        if dungeon_name != encounter_title
                        else ""
                    ),
                    available,
                    "micro",
                ),
                fill=MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            if self._history_field_visible("character"):
                class_id = _parsed_profession_id(
                    summary.get("profession_id", 0)
                )
                profession_icon = self.icons.profession(class_id, 22)
                canvas.create_image(
                    columns["character_icon"],
                    middle,
                    image=profession_icon,
                    anchor="w",
                    tags=(tag,),
                )
                raw_character_name = str(summary.get("my_name", "")).strip()
                character_name = (
                    "玩家1"
                    if self._history_names_hidden() and raw_character_name
                    else raw_character_name or "--"
                )
                character_available = max(
                    36,
                    columns["character_right"]
                    - columns["character_name"]
