    def _begin_toggle_hotkey_capture(self, _event=None) -> str:
        if self.closing:
            return "break"
        if getattr(self, "toggle_hotkey_registered", False) and not (
            self._set_native_toggle_hotkey("")
        ):
            self._sync_toggle_hotkey_controls(
                "无法暂停当前快捷键，请重试", error=True
            )
            return "break"
        self.toggle_hotkey_registered = False
