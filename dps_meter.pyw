    @staticmethod
    def _action_button(parent: tk.Misc, text: str, command) -> tk.Label:
        label = tk.Label(
            parent,
            text=text,
            bg=PANEL_2,
            fg=MUTED,
            padx=4,
            pady=2,
            cursor="hand2",
            font=tk_font_spec("Microsoft YaHei UI", 7, "bold"),
        )
        label._disabled = False
        label._normal_bg = PANEL_2
        label._normal_fg = MUTED
        label._hover_bg = blend_color(PANEL_2, ACCENT, 0.13)
        label._hover_fg = TEXT
        label.bind(
            "<Enter>",
            lambda _event: (
                None
                if getattr(label, "_disabled", False)
                else label.configure(
                    bg=getattr(label, "_hover_bg", PANEL_2),
                    fg=getattr(label, "_hover_fg", TEXT),
                )
            ),
        )
        label.bind(
            "<Leave>",
            lambda _event: label.configure(
                bg=getattr(label, "_normal_bg", PANEL_2),
                fg=(
                    "#4e5862"
                    if getattr(label, "_disabled", False)
                    else getattr(label, "_normal_fg", MUTED)
                ),
            ),
        )
        label.bind(
            "<Button-1>",
            lambda _event: (
                None if getattr(label, "_disabled", False) else command()
            ),
        )
        return label

