    def _draw_history_boss_sources(self) -> None:
        canvas = self.history_participant_canvas
        if canvas is None:
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        boss_damage = self._history_boss_damage(record)
        sources = self._history_boss_sources(record)
        subtitle = getattr(self, "history_team_subtitle_label", None)
        if subtitle is not None:
            subtitle.configure(
                text=f"{len(sources)} 个已确认来源" if sources else "无已确认来源"
            )
        if not sources:
            message, color = self._history_boss_coverage_text(boss_damage)
            canvas.create_text(
                width // 2,
                height // 2 - 10,
                text=message,
                fill=color,
                font=self._ui_font("strong"),
            )
            if message == "该场未记录首领伤害":
                canvas.create_text(
                    width // 2,
                    height // 2 + 16,
                    text="旧记录不会反推或补造首领技能数据",
                    fill=SUBTLE,
                    font=self._ui_font("micro"),
                )
            canvas.configure(scrollregion=(0, 0, width, height))
            return

        row_height = 58
        icons: list[object] = []
        for index, source in enumerate(sources):
            top = index * row_height
            bottom = top + row_height
            entity_id = int(source.get("entity_id", 0) or 0)
            selected = entity_id == int(self.history_selected_actor or 0)
            base = (
                blend_color(PANEL, "#e67d72", 0.11)
                if selected
                else PANEL if index % 2 == 0 else "#11161b"
            )
            tag = f"history-boss-source:{index}"
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline="", tags=(tag,)
            )
            canvas.create_rectangle(
                0,
                top,
                3,
                bottom - 1,
                fill="#e67d72" if selected else BORDER,
                outline="",
                tags=(tag,),
            )
            name = str(source.get("name", "")).strip() or "首领"
            portrait = self.icons.boss(
                self._history_boss_icon_name(source), name, size=34
            )
            icons.append(portrait)
            canvas.create_image(
                10,
                top + (row_height - 34) // 2,
                image=portrait,
                anchor="nw",
                tags=(tag,),
            )
            canvas.create_text(
                52,
                top + 19,
                text=self._fit_ui_text(name, max(70, width - 205), "strong"),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("strong"),
                tags=(tag,),
            )
            kind = (
                "机制"
                if str(source.get("kind", "boss")).casefold() == "mechanism"
                else "首领"
            )
            canvas.create_text(
                52,
                top + 39,
                text=f"{kind} · 命中 {max(0, int(source.get('hits', 0) or 0))}",
                fill=WARN if kind == "机制" else MUTED,
                anchor="w",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            canvas.create_text(
                width - 12,
                top + 19,
                text=format_number(max(0, int(source.get("damage", 0) or 0))),
                fill="#e67d72",
                anchor="e",
                font=self._ui_font("number_strong"),
                tags=(tag,),
            )
            canvas.create_text(
                width - 12,
                top + 39,
                text=f"占比 {max(0.0, min(1.0, float(source.get('share', 0.0) or 0.0))) * 100:.1f}%",
                fill=MUTED,
                anchor="e",
                font=self._ui_font("micro"),
                tags=(tag,),
            )
            canvas.tag_bind(
                tag,
                "<Button-1>",
                lambda _event, selected_id=entity_id: self._select_history_actor(
                    selected_id
                ),
            )
            canvas.tag_bind(
                tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2")
            )
            canvas.tag_bind(
                tag, "<Leave>", lambda _event: canvas.configure(cursor="")
            )
        canvas._history_boss_source_icons = icons
        canvas.configure(
            scrollregion=(0, 0, width, max(height, len(sources) * row_height))
        )

    def _draw_history_participants(self) -> None:
        canvas = self.history_participant_canvas
        if canvas is None:
            return
        if getattr(self, "history_meter_mode", "dps") == "boss_damage":
            self._draw_history_boss_sources()
            return
        canvas.delete("all")
        width = max(1, canvas.winfo_width())
        height = max(1, canvas.winfo_height())
        record = self._selected_history_record()
        healing_mode = getattr(self, "history_meter_mode", "dps") == "hps"
        taken_mode = getattr(self, "history_meter_mode", "dps") == "dt"
        participants = (
            record.get(
                (
                    "healers"
                    if healing_mode
                    else "damage_taken" if taken_mode else "participants"
                ),
                [],
            )
            if record
            else []
        )
        participants = participants if isinstance(participants, list) else []
        compact_detail_roster = (
            getattr(self, "history_page_mode", "browser") == "detail"
            and getattr(self, "history_participant_header_canvas", None) is None
        )
        subtitle = getattr(self, "history_team_subtitle_label", None)
        if compact_detail_roster and subtitle is not None:
            subtitle.configure(text=f"{len(participants)} 名队员")
        if not participants:
            canvas.create_text(
                width // 2,
                height // 2,
                text=(
                    "暂无团队治疗"
                    if healing_mode
                    else "暂无团队承伤" if taken_mode else "暂无团队伤害"
                ),
                fill=MUTED,
                font=tk_font_spec("Microsoft YaHei UI", 9, "bold"),
            )
            canvas.configure(scrollregion=(0, 0, width, height))
            return
        highest_damage = max(
            (
                max(
                    0,
                    int(
                        participant.get(
                            (
                                "effective_healing"
                                if healing_mode
                                else "taken" if taken_mode else "damage"
                            ),
                            0,
                        )
                        or 0
                    ),
                )
                for participant in participants
                if isinstance(participant, dict)
            ),
            default=0,
        )
        columns = self._history_participant_columns(width)
        duration = self._history_display_duration(record, healing_mode)
        dps_duration = dps_duration_seconds(
            record.get(
                "hps_duration_seconds" if healing_mode else "dps_duration_seconds",
                duration,
            )
            or duration
        )
        detail_layout = getattr(self, "history_page_mode", "browser") == "detail"
        row_height = 43 if compact_detail_roster else 40 if detail_layout else 34
        for index, participant in enumerate(participants):
            top = index * row_height
            bottom = top + row_height
            center_y = top + row_height // 2
            actor_id = int(participant.get("actor_id", 0) or 0)
            selected = actor_id == self.history_selected_actor
            class_id = int(participant.get("profession_id", 0) or 0)
            _profession, color = self._profession_info(class_id)
            base = PANEL_2 if selected else (PANEL if index % 2 == 0 else SURFACE)
            if healing_mode:
                effective = max(
                    0, int(participant.get("effective_healing", 0) or 0)
                )
                team_effective = max(
                    0, int(record.get("team_effective_healing", 0) or 0)
                )
                share = effective / team_effective if team_effective else 0.0
                primary_value = effective
            elif taken_mode:
                try:
                    share = max(
                        0.0,
                        min(
                            1.0,
                            float(participant.get("share", 0.0) or 0.0),
                        ),
                    )
                except (TypeError, ValueError, OverflowError):
                    share = 0.0
                try:
                    primary_value = max(
                        0, int(participant.get("taken", 0) or 0)
                    )
                except (TypeError, ValueError, OverflowError):
                    primary_value = 0
            else:
                share = float(participant.get("share", 0.0) or 0.0)
                primary_value = max(
                    0, int(participant.get("damage", 0) or 0)
                )
            bar_ratio = relative_damage_bar_ratio(
                primary_value, highest_damage
            )
            tag = f"history-actor:{index}"
            if compact_detail_roster:
                base = (
                    blend_color(PANEL, ACCENT, 0.10)
                    if selected
                    else PANEL if index % 2 == 0 else "#11161b"
                )
            canvas.create_rectangle(
                0, top, width, bottom - 1, fill=base, outline="", tags=(tag,)
            )
            if not compact_detail_roster:
                canvas.create_rectangle(
                    0,
                    top,
                    max(3, int(width * bar_ratio)),
                    bottom - 1,
                    fill=blend_color(base, color, 0.22),
                    outline="",
                    tags=(tag,),
                )
            if compact_detail_roster:
                canvas.create_rectangle(
                    0,
                    top,
                    3,
                    bottom - 1,
                    fill=ACCENT if selected else blend_color(base, color, 0.65),
                    outline="",
                    tags=(tag,),
                )
                if bar_ratio > 0:
                    canvas.create_rectangle(
                        3,
                        bottom - 3,
                        max(5, int(width * bar_ratio)),
                        bottom - 1,
                        fill=blend_color(base, color, 0.78),
                        outline="",
                        tags=(tag,),
                    )
                canvas.create_text(
                    21,
                    center_y,
                    text=str(index + 1),
                    fill=(
                        ACCENT
                        if selected
                        else WARN if index < 3 else MUTED
                    ),
                    font=self._ui_font("number_strong"),
                    tags=(tag,),
                )
                icon = self.icons.profession(class_id, 21)
                canvas.create_image(
                    38,
                    top + (row_height - 21) // 2,
                    image=icon,
                    anchor="nw",
                    tags=(tag,),
                )
                name = self._history_actor_name(
                    participant, index, self._history_names_hidden()
                )
                canvas.create_text(
                    65,
                    top + 13,
                    text=self._fit_ui_text(name, max(56, width - 238), "micro"),
                    fill=TEXT,
                    anchor="w",
                    font=self._ui_font("strong"),
                    tags=(tag,),
                )
                is_ai = history_participant_is_ai(participant)
                rating = (
                    None
                    if is_ai
                    else normalize_extraordinary_rating(
                        participant.get("extraordinary_rating")
                    )
                )
                if is_ai:
                    rating_text = "非凡评分 人机"
                elif rating is not None:
                    rating_text = f"非凡评分 {format_number(rating)}"
                else:
                    rating_text = "非凡评分 --"
                canvas.create_text(
                    65,
                    top + 30,
                    text=rating_text,
                    fill="#8bc7d4" if is_ai else ACCENT if rating is not None else SUBTLE,
                    anchor="w",
                    font=self._ui_font("micro"),
                    tags=(tag,),
                )
                amount = (
                    primary_value
                    if healing_mode or taken_mode
                    else max(0, int(participant.get("damage", 0) or 0))
                )
                if healing_mode:
                    rate = participant.get("hps", 0)
                    rate_label = "HPS"
                    amount_label = "治疗"
                elif taken_mode:
                    rate = primary_value
                    rate_label = "承伤"
                    amount_label = "承伤"
                else:
                    raw_rate = participant.get("dps")
                    rate = (
                        float(raw_rate)
                        if raw_rate is not None
                        else primary_value / dps_duration if dps_duration else 0.0
                    )
                    rate_label = "DPS"
                    amount_label = "伤害"
                canvas.create_text(
                    width - 13,
                    top + 13,
                    text=f"{format_number(rate)}  {rate_label}",
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("number_strong"),
                    tags=(tag,),
                )
                canvas.create_text(
                    width - 13,
                    top + 30,
                    text=(
                        f"占比 {share * 100:.1f}%"
                        if taken_mode
                        else f"{amount_label} {format_number(amount)}  ·  "
                        f"占比 {share * 100:.1f}%"
                    ),
                    fill=MUTED,
                    anchor="e",
                    font=self._ui_font("micro"),
                    tags=(tag,),
                )
                canvas.create_line(0, bottom - 1, width, bottom - 1, fill="#20262d")
                canvas.tag_bind(
                    tag,
                    "<Button-1>",
                    lambda _event, selected_actor=actor_id: self._select_history_actor(
                        selected_actor
                    ),
                )
                canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
                canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor=""))
                continue
            canvas.create_text(
                columns["rank"],
                center_y,
                text=str(index + 1),
                fill=ACCENT if index < 3 else MUTED,
                anchor="e",
                font=self._ui_font("table"),
                tags=(tag,),
            )
            icon = self.icons.profession(class_id, 20)
            canvas.create_image(
                columns["profession_icon"],
                top + (row_height - 20) // 2,
                image=icon,
                anchor="nw",
                tags=(tag,),
            )
            canvas.create_text(
                columns["name"],
                center_y,
                text=self._fit_main_actor_name(
                    self._history_actor_name(
                        participant, index, self._history_names_hidden()
                    ),
                    max(40, columns["name_limit"] - columns["name"] - 8),
                ),
                fill=TEXT,
                anchor="w",
                font=self._ui_font("table"),
                tags=(tag,),
            )
            if healing_mode:
                overheal_rate = participant.get("overheal_rate")
                values = {
                    "effective": format_number(primary_value),
                    "hps": format_number(participant.get("hps", 0)),
                    "overheal": format_overheal_rate(
                        overheal_rate,
                        partial=bool(
                            participant.get("overheal_rate_partial")
                        ),
                    ),
                }
                keys = ("effective", "hps", "overheal")
            elif taken_mode:
                values = {
                    "taken": format_number(primary_value),
                    "taken_share": f"{share * 100:.1f}%",
                }
                keys = ("taken", "taken_share")
            else:
                try:
                    damage = max(
                        0.0, float(participant.get("damage", 0.0) or 0.0)
                    )
                except (TypeError, ValueError, OverflowError):
                    damage = 0.0
                try:
                    raw_dps = participant.get("dps")
                    dps = (
                        max(0.0, float(raw_dps))
                        if raw_dps is not None
                        else (damage / dps_duration if dps_duration else 0.0)
                    )
                except (TypeError, ValueError, OverflowError):
                    dps = damage / dps_duration if dps_duration else 0.0
                critical_rate = participant.get("critical_rate")
                try:
                    critical_text = (
                        f"{float(critical_rate) * 100:.1f}%"
                        if critical_rate is not None
                        else "--"
                    )
                except (TypeError, ValueError, OverflowError):
                    critical_text = "--"
                penetration_rate = participant.get("penetration_rate")
                try:
                    penetration_text = (
                        f"{float(penetration_rate) * 100:.1f}%"
                        if penetration_rate is not None
                        else "--"
                    )
                except (TypeError, ValueError, OverflowError):
                    penetration_text = "--"
                values = {
                    "damage": format_number(damage),
                    "dps": format_number(dps),
                    "share": f"{share * 100:.1f}%",
                    "critical": critical_text,
                    "penetration": penetration_text,
                    "deaths": str(
                        max(0, int(participant.get("deaths", 0) or 0))
                    ),
                    "revives": str(
                        max(0, int(participant.get("revives", 0) or 0))
                    ),
                    "death_time": format_duration(
                        max(
                            0.0,
                            float(
                                participant.get("death_duration_seconds", 0.0)
                                or 0.0
                            ),
                        )
                    ),
                }
                keys = (
                    "damage",
                    "dps",
                    "share",
                    "critical",
                    "penetration",
                    "deaths",
                    "revives",
                    "death_time",
                )
            for key in keys:
                if key not in columns:
                    continue
                canvas.create_text(
                    columns[key],
                    center_y,
                    text=values[key],
                    fill=TEXT,
                    anchor="e",
                    font=self._ui_font("table"),
                    tags=(tag,),
                )
            canvas.tag_bind(
                tag,
                "<Button-1>",
                lambda _event, selected_actor=actor_id: self._select_history_actor(
                    selected_actor
                ),
            )
            canvas.tag_bind(tag, "<Enter>", lambda _event: canvas.configure(cursor="hand2"))
            canvas.tag_bind(tag, "<Leave>", lambda _event: canvas.configure(cursor=""))
        canvas.configure(
            scrollregion=(0, 0, width, max(height, len(participants) * row_height))
        )

    def _select_history_actor(self, actor_id: int) -> None:
        next_actor = int(actor_id)
        if next_actor != self.history_selected_actor:
            self.history_skill_timeline_selected_hit = None
            self.history_skill_timeline_hover_hit = None
            self.history_skill_timeline_focus_time = None
        self.history_selected_actor = next_actor
        self._render_history_selection()

