    def _draw_main_time_value(self) -> None:
        canvas = getattr(self, "time_value", None)
        if not isinstance(canvas, tk.Canvas):
            return
        canvas.delete("all")
        height = max(1, canvas.winfo_height())
        canvas_outlined_text(
            canvas,
            self._main_px(1),
            height // 2,
            text=str(getattr(self, "main_time_text", "00:00") or "00:00"),
            fill="#ffffff",
            outline="#08111b",
            outline_width=max(1, self._main_px(1)),
            anchor="w",
            font=self._ui_font("main_number_strong"),
        )

    def _draw_team_dps_value(self) -> None:
        canvas = getattr(self, "team_dps_caption", None)
        if not isinstance(canvas, tk.Canvas):
            return
        canvas.delete("all")
        height = max(1, canvas.winfo_height())
        middle_y = height // 2
        caption_font = self._ui_font("main_text")
        value_font = self._ui_font("main_number_strong")
        caption = str(
            getattr(self, "main_dps_caption_text", "全队秒伤") or "全队秒伤"
        )
        canvas_outlined_text(
            canvas,
            self._main_px(1),
            middle_y,
            text=caption,
            fill="#f7f9fc",
            outline="#071019",
            outline_width=max(1, self._main_px(1)),
            anchor="w",
            font=caption_font,
        )
        try:
            value_x = caption_font.measure(caption) + self._main_px(7)
        except (AttributeError, TypeError, ValueError, tk.TclError):
            value_x = self._main_px(63)
        canvas_outlined_text(
            canvas,
            value_x,
            middle_y,
            text=str(getattr(self, "team_dps_text", "0") or "0"),
            fill="#79bdff",
            outline="#071019",
            outline_width=max(1, self._main_px(1)),
            anchor="w",
            font=value_font,
        )

    def _set_team_dps_value(self, text: object) -> None:
        self.team_dps_text = str(text or "0")
        widget = getattr(self, "team_dps_caption", None)
        if isinstance(widget, tk.Canvas):
            self._draw_team_dps_value()
        elif getattr(self, "team_dps_label", None) is not None:
            self.team_dps_label.configure(text=self.team_dps_text)
        self._schedule_layered_main_render()

    def _set_main_time_value(self, text: object) -> None:
        self.main_time_text = str(text or "00:00")
        widget = getattr(self, "time_value", None)
        if isinstance(widget, tk.Canvas):
            self._draw_main_time_value()
        elif widget is not None:
            widget.configure(text=self.main_time_text, fg="#ffffff")
        self._schedule_layered_main_render()

    def _layered_main_active(self) -> bool:
        return bool(
            getattr(self, "layered_main_enabled", False)
            and getattr(self, "layered_main_renderer", None) is not None
            and getattr(self, "layered_main_presenter", None) is not None
        )

    def _schedule_layered_main_render(
        self, delay: int = 0, *, force: bool = False
    ) -> None:
        if not self._layered_main_active() or self.closing:
            return
        if getattr(self, "layered_main_after_id", None) is not None:
            if not force:
                return
            try:
                self.root.after_cancel(self.layered_main_after_id)
            except (AttributeError, tk.TclError):
                pass
            self.layered_main_after_id = None

        def render() -> None:
            self.layered_main_after_id = None
            if not self.closing:
                self._render_layered_main_hud()

        try:
            wait_ms = hud_render_delay(time.perf_counter(),
                getattr(self, "layered_main_paint_finished_at", 0.0), delay)
            self.layered_main_after_id = self.root.after(wait_ms, render)
        except (AttributeError, tk.TclError):
            self.layered_main_after_id = None

    def _main_boss_display_values(
        self, monster, *, force_defeated: bool = False
    ) -> dict[str, object]:
        boss_name = "暂无目标"
        boss_level = None
        current_hp = None
        maximum_hp = None
        if monster is not None:
            try:
                level = int(getattr(monster, "level", 0) or 0)
                if 1 <= level <= 999:
                    boss_level = level
            except (TypeError, ValueError, OverflowError):
                pass
            boss_name = str(getattr(monster, "name", "") or "").strip()
            if not boss_name or boss_name_is_placeholder(boss_name):
                display_target_name = getattr(self.model, "display_target_name", None)
                boss_name = (
                    str(
                        display_target_name(
                            int(getattr(monster, "entity_id", 0) or 0)
                        )
                        or ""
                    ).strip()
                    if callable(display_target_name)
                    else ""
                )
            boss_name = boss_name or "Boss"
            current_hp = getattr(monster, "current_hp", None)
            # A confirmed victory is an authoritative terminal boundary even
            # when the final CurrentHP packet was lost.  Keep this override at
            # the presentation edge so a stale positive live sample cannot
            # put a defeated Boss back on the HUD.  Wipes and live pulls do
            # not use this path.
            if force_defeated:
                current_hp = 0.0
            try:
                declared_maximum = float(
                    getattr(monster, "max_hp", 0.0) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                declared_maximum = 0.0
            try:
                observed_maximum = float(
                    getattr(monster, "observed_max_hp", 0.0) or 0.0
                )
            except (TypeError, ValueError, OverflowError):
                observed_maximum = 0.0
            if math.isfinite(declared_maximum) and declared_maximum > 0:
                maximum_hp = declared_maximum
            elif math.isfinite(observed_maximum) and observed_maximum > 0:
                maximum_hp = observed_maximum
                if isinstance(monster, MonsterStats) and boss_level is not None:
                    try:
                        template_id = int(getattr(monster, "template_id", 0) or 0)
                        reference = float(getattr(
                            self, "_boss_max_hp_references", {}
                        ).get((template_id, boss_level), 0) or 0)
                    except (TypeError, ValueError, OverflowError, AttributeError):
                        reference = 0.0
                    if reference > 0 and 0 < observed_maximum / reference <= 1.0:
                        maximum_hp = reference
        boss_ratio = None
        if current_hp is not None and maximum_hp is not None and maximum_hp > 0:
            boss_ratio = min(1.0, max(0.0, float(current_hp) / float(maximum_hp)))
        boss_hp = format_team_health_number(current_hp) if current_hp is not None else ""
        boss_percent = ""
        if maximum_hp is not None:
            boss_hp = (
                f"{boss_hp} / "
                f"{format_team_health_number(maximum_hp)}"
            )
        if current_hp is not None and maximum_hp is not None and maximum_hp > 0:
            percent = boss_ratio * 100.0
            boss_percent = (
                f"{percent:.0f}%" if percent in (0.0, 100.0)
                else "<0.1%" if percent < 0.05
                else f"{percent:.1f}%"
            )
        return dict(boss_name=boss_name, boss_available=monster is not None,
                    boss_template_id=getattr(monster, 'template_id', 0) if monster is not None else 0,
                    boss_icon=getattr(monster, 'icon', '') if monster is not None else '',
                    boss_level=boss_level, boss_hp=boss_hp, boss_percent=boss_percent, boss_ratio=boss_ratio)

    def _main_recent_stage_metadata(self, encounter) -> dict[str, object]:
        """Resolve display-only Boss identity from an authoritative stage ID.

        Some final-stage settlement packets arrive without a matching live Boss
        template observation.  The stage catalog may restore the label and
        portrait, but it must not invent a template ID, maximum HP, or ratio.
        """

        catalog = getattr(self, "_main_recent_stage_catalog", None)
        dungeon_catalog = getattr(self, "_main_recent_dungeon_catalog", None)
        if not isinstance(catalog, dict) or not isinstance(dungeon_catalog, dict):
            try:
                payload = json.loads(
                    (ASSET_DIR / "bosses" / "boss_icon_sources.json").read_text(
                        encoding="utf-8-sig"
                    )
                )
                raw_stages = payload.get("stages", {})
                raw_dungeons = payload.get("dungeons", {})
                catalog = raw_stages if isinstance(raw_stages, dict) else {}
                dungeon_catalog = (
                    raw_dungeons if isinstance(raw_dungeons, dict) else {}
                )
            except (OSError, TypeError, ValueError, AttributeError):
                catalog = {}
                dungeon_catalog = {}
            self._main_recent_stage_catalog = catalog
            self._main_recent_dungeon_catalog = dungeon_catalog
        try:
            stage_id = int(getattr(encounter, "stage_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            stage_id = 0
        metadata = catalog.get(str(stage_id), {})
        return dict(metadata) if isinstance(metadata, dict) else {}

    def _main_hud_statistics_scope(self, encounter) -> str:
        """Show one Boss's STAGE table; use ALL only for a proven one-Boss map."""

        if encounter is None:
            return "STAGE"
        stage = getattr(encounter, "stage_statistics", None)
        stage_members = stage.get("members") if isinstance(stage, dict) else None
        if isinstance(stage_members, (list, tuple)) and any(
            isinstance(member, dict) and member.get("damage") is not None
            for member in stage_members
        ):
            return "STAGE"
        all_statistics = getattr(encounter, "all_statistics", None)
        all_members = (
            all_statistics.get("members")
            if isinstance(all_statistics, dict) else None
        )
        if (
            str(getattr(encounter, "result", "") or "").upper() != "VICTORY"
            or getattr(encounter, "settlement_status", None) != "SETTLED"
            or not isinstance(all_members, (list, tuple))
            or not all_members
        ):
            return "STAGE"
        try:
            stage_id = int(getattr(encounter, "stage_id", 0) or 0)
            dungeon_id = int(getattr(encounter, "dungeon_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            return "STAGE"
        if stage_id <= 0:
            return "STAGE"
        stage_metadata = self._main_recent_stage_metadata(encounter)
        dungeon_ids = (
            [dungeon_id]
            if dungeon_id > 0
            else stage_metadata.get("dungeon_ids", ())
        )
        dungeons = getattr(self, "_main_recent_dungeon_catalog", {})
        if not isinstance(dungeons, dict) or not dungeon_ids:
            return "STAGE"
        for candidate_id in dungeon_ids:
            dungeon = dungeons.get(str(candidate_id), {})
            if not isinstance(dungeon, dict):
                return "STAGE"
            try:
                stages = {int(value) for value in dungeon.get("stage_ids", ())}
            except (TypeError, ValueError, OverflowError):
                return "STAGE"
            if stages != {stage_id}:
                return "STAGE"
        return "ALL"

    def _main_recent_settlement_monster(self, encounter):
        """Restore the exact archived Boss health for an ended Encounter.

        The Encounter-owned end snapshot has priority because a delayed server
        table can be received after the next pull has restored the mutable live
        Boss to full HP.  Older records without that snapshot still fall back
        to their matching CombatHistory monster metadata.
        """

        archived_monster: dict[str, object] = {}
        history_store = getattr(self, "history_store", None)
        loader = getattr(history_store, "load", None)
        if callable(loader):
            try:
                history = loader(encounter.local_encounter_id)
            except (OSError, ValueError, TypeError, KeyError):
                history = None
            if isinstance(history, dict):
                candidate = history.get("monster")
                if isinstance(candidate, dict):
                    archived_monster = candidate

        stage_metadata = self._main_recent_stage_metadata(encounter)
        encounter_name = str(encounter.boss_name or "").strip()
        archived_name = str(archived_monster.get("name") or "").strip()
        if boss_name_is_placeholder(encounter_name):
            encounter_name = ""
        if boss_name_is_placeholder(archived_name):
            archived_name = ""
        snapshot_current_hp = getattr(encounter, "boss_current_hp", None)
        snapshot_max_hp = getattr(encounter, "boss_max_hp", None)
        if str(getattr(encounter, "result", "") or "").upper() == "VICTORY":
            # Victory itself proves the terminal HP.  Older journals may have
            # captured only the last positive sample, so do not let that
            # historical value override the confirmed result.
            snapshot_current_hp = 0.0

        from types import SimpleNamespace
        return SimpleNamespace(
            entity_id=archived_monster.get("entity_id", 0),
            name=(
                encounter_name
                or archived_name
                or str(stage_metadata.get("name") or "").strip()
                or "Boss"
            ),
            template_id=(
                encounter.boss_template_id
                or archived_monster.get("template_id")
                or 0
            ),
            icon=(
                str(archived_monster.get("icon") or "").strip()
                or str(stage_metadata.get("icon") or "").strip()
            ),
            level=archived_monster.get("level", 0),
            current_hp=(
                snapshot_current_hp
                if snapshot_current_hp is not None
                else archived_monster.get("current_hp")
            ),
            max_hp=(
                snapshot_max_hp
                if snapshot_max_hp is not None
                else archived_monster.get("max_hp")
            ),
            observed_max_hp=(
                snapshot_max_hp
                if snapshot_max_hp is not None
                else archived_monster.get("observed_max_hp")
            ),
        )

    def _main_recent_victory_matches_live_boss(self, encounter, monster) -> bool:
        """Check whether a completed settlement belongs to the live Boss row."""

        if (
            encounter is None
            or monster is None
            or str(getattr(encounter, "result", "") or "").upper()
            != "VICTORY"
        ):
            return False
        try:
            live_template = int(getattr(monster, "template_id", 0) or 0)
            settled_template = int(
                getattr(encounter, "boss_template_id", 0) or 0
            )
        except (TypeError, ValueError, OverflowError):
            live_template = settled_template = 0
        template_match = bool(
            live_template
            and settled_template
            and (
                live_template == settled_template
                or (live_template, settled_template)
                in BOSS_PHASE_TEMPLATE_TRANSITIONS
                or (settled_template, live_template)
                in BOSS_PHASE_TEMPLATE_TRANSITIONS
            )
        )
        try:
            live_entity = int(getattr(monster, "entity_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            live_entity = 0
        settled_token = str(getattr(encounter, "boss_token", "") or "").strip()
        token_match = bool(
            settled_token
            and live_entity
            and settled_token in {str(live_entity), f"entity:{live_entity}"}
        )
        controller = getattr(self, "settlement_ui", None)
        boss_entities = getattr(controller, "boss_entities", {})
        observed_boss = (
            boss_entities.get(str(live_entity), {})
            if isinstance(boss_entities, dict) else {}
        )
        if isinstance(observed_boss, dict):
            token_match = token_match or bool(
                settled_token
                and str(observed_boss.get("token") or "").strip() == settled_token
            )
        if not token_match and live_entity:
            encounter_id = str(
                getattr(encounter, "local_encounter_id", "") or ""
            )
            cached = getattr(self, "_main_recent_victory_entity_cache", None)
            if encounter_id and (
                not isinstance(cached, tuple) or cached[0] != encounter_id
            ):
                loader = getattr(getattr(self, "history_store", None), "load", None)
                try:
                    archived = loader(encounter_id) if callable(loader) else None
                except (OSError, ValueError, TypeError, KeyError):
                    archived = None
                if isinstance(archived, dict):
                    archived_monster = archived.get("monster")
                    if isinstance(archived_monster, dict):
                        try:
                            archived_entity = int(
                                archived_monster.get("entity_id", 0) or 0
                            )
                        except (TypeError, ValueError, OverflowError):
                            archived_entity = 0
                        cached = (encounter_id, archived_entity)
                        self._main_recent_victory_entity_cache = cached
            token_match = bool(
                isinstance(cached, tuple)
                and cached[0] == encounter_id
                and cached[1] == live_entity
            )
        settled_name = normalize_boss_name(getattr(encounter, "boss_name", ""))
        live_name = normalize_boss_name(getattr(monster, "name", ""))
        name_match = bool(
            settled_name
            and live_name
            and (
                settled_name == live_name
                or boss_names_share_phase(settled_name, live_name)
            )
        )
        # A concrete Boss token is the strongest boundary.  Do not let a
        # repeated template/name from a newly started pull inherit the old
        # victory just because its first fight-mode packet is delayed.
        if settled_token:
            if not token_match:
                return False
        elif not (template_match or name_match):
            return False
        try:
            ended_at = int(getattr(encounter, "ended_at_ns", 0) or 0)
            hp_stamp = int(getattr(monster, "last_hp_update_100ns", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            ended_at = hp_stamp = 0
        if ended_at and hp_stamp > 116_444_736_000_000_000:
            hp_epoch_ns = (
                hp_stamp - 116_444_736_000_000_000
            ) * 100
            if hp_epoch_ns > ended_at + 2_000_000_000:
                # A newer HP sample belongs to a later pull and must win.
                return False
        return True

    def _main_recent_boss_row(self, encounter) -> dict[str, object] | None:
        """Build the compact Boss identity shown above recent DPS rows."""

        if encounter is None:
            return None
        values = self._main_boss_display_values(
            self._main_recent_settlement_monster(encounter)
        )
        return {
            "row_kind": "recent_boss",
            "boss_name": values.get("boss_name") or "Boss",
            "boss_template_id": values.get("boss_template_id") or 0,
            "boss_icon": values.get("boss_icon") or "",
            "boss_level": values.get("boss_level"),
            "boss_hp": values.get("boss_hp") or "",
            "boss_percent": values.get("boss_percent") or "",
            "boss_ratio": values.get("boss_ratio"),
            "boss_available": values.get("boss_available", True),
        }

    def _pvp_hud_map_active(self) -> bool:
        recording = getattr(self, "pvp_recording", None)
        try:
            map_id = int(getattr(recording, "map_id", 0) or 0)
        except (TypeError, ValueError, OverflowError):
            map_id = 0
        return map_id in RECORDABLE_MAPS

    def _set_main_combat_mode(self, mode: object) -> None:
        """Switch the shared HUD surface between its PVE and PVP pages."""

        normalized = "pvp" if str(mode or "").casefold() == "pvp" else "pve"
        if normalized == "pvp" and (
            not PVP_FEATURE_ENABLED
            or not bool(getattr(self, "show_pvp_button", True))
        ):
            return
        if normalized == getattr(self, "main_combat_mode", "pve"):
            return
        self.main_combat_mode = normalized
        self.main_scroll_offset = 0
        self.layered_main_hover_action = ""
        self._hide_enrage_tooltip()
        if self._layered_main_active():
            self._schedule_layered_main_render()

    def _set_pvp_hud_view(self, view: object) -> None:
        """Switch only the content area of the PVP HUD."""

        normalized = "team" if str(view or "").strip().casefold() == "team" else "live"
        if normalized == getattr(self, "pvp_hud_view", "team"):
            return
        self.pvp_hud_view = normalized
        self.pvp_team_offset = 0
        self.layered_main_hover_action = ""
        if normalized == "team":
            self._schedule_team_equipment_profiles()
        if self._layered_main_active():
            self._schedule_layered_main_render()

    def _hunter_team_panel_available(self) -> bool:
        recording = getattr(self, "pvp_recording", None)
        match = getattr(recording, "recording", None)
        return bool(
            getattr(recording, "active", False)
            and isinstance(match, dict)
            and match.get("map_id") in HUNTER_CITY_MAPS
        )

    def _open_hunter_team_panel(self) -> None:
        window = getattr(self, "hunter_team_window", None)
        if window is not None and window.winfo_exists():
            window.deiconify()
            window.lift()
            return
        window = tk.Toplevel(self.root)
        self.hunter_team_window = window
        self.hunter_team_page = 0
        self.hunter_team_signature = None
        window.title("猎龙之城 · 团队构成")
        window.configure(bg=BG)
        window.geometry("1220x760")
        window.minsize(1020, 650)
        window.attributes("-topmost", self._preferred_main_topmost())
        window.protocol("WM_DELETE_WINDOW", self._close_hunter_team_panel)
        window.bind("<Escape>", lambda _event: self._close_hunter_team_panel())
        self._refresh_hunter_team_panel(force=True)
        window.lift()

    def _close_hunter_team_panel(self) -> None:
        window = getattr(self, "hunter_team_window", None)
        after_id = getattr(self, "hunter_team_refresh_after_id", None)
        self.hunter_team_refresh_after_id = None
        if window is not None and after_id is not None:
            try:
                window.after_cancel(after_id)
            except tk.TclError:
                pass
        self.hunter_team_window = None
        self.hunter_team_signature = None
        if window is not None:
            try:
                window.destroy()
            except tk.TclError:
                pass

    def _select_hunter_team_page(self, page: int) -> None:
        self.hunter_team_page = max(0, int(page))
        self._refresh_hunter_team_panel(force=True)

    def _refresh_hunter_team_panel(self, *, force: bool = False) -> None:
        window = getattr(self, "hunter_team_window", None)
        if window is None or not window.winfo_exists():
            return
        after_id = getattr(self, "hunter_team_refresh_after_id", None)
        if after_id is not None:
            window.after_cancel(after_id)
            self.hunter_team_refresh_after_id = None
        rows = self._pvp_team_composition_rows() if self._hunter_team_panel_available() else []
        signature = tuple(
            (row.get("user_token"), row.get("actor_id"), row.get("name"),
             row.get("profession_id"), row.get("rating_text"),
             row.get("equipment_count"), row.get("pvp_equipment_count"))
            for row in rows
        )
        page_size = 30
        pages = max(1, (len(rows) + page_size - 1) // page_size)
        self.hunter_team_page = min(self.hunter_team_page, pages - 1)
        state = (signature, self.hunter_team_page)
        if force or state != getattr(self, "hunter_team_signature", None):
            self.hunter_team_signature = state
            for child in window.winfo_children():
                child.destroy()
            header = tk.Frame(window, bg=SURFACE)
            header.pack(fill="x", padx=18, pady=(18, 10))
            tk.Label(header, text="猎龙之城  /  团队构成", bg=SURFACE, fg=TEXT,
                     font=self._ui_font("title"), anchor="w").pack(fill="x", padx=18, pady=(12, 2))
            tk.Label(header, text=f"当前已识别 · 共 {len(rows)} 人",
                     bg=SURFACE, fg=ACCENT, font=self._ui_font("body"),
                     anchor="w").pack(fill="x", padx=18)
            tk.Label(header, text="当前未取得可靠团号，页面按实时名单顺序分组。",
                     bg=SURFACE, fg=MUTED, font=self._ui_font("small"),
                     anchor="w").pack(fill="x", padx=18, pady=(3, 12))
            tabs = tk.Frame(window, bg=BG)
            tabs.pack(fill="x", padx=18, pady=(0, 12))
            for page in range(pages):
                selected = page == self.hunter_team_page
                tk.Button(
                    tabs, text=f"显示分组 {page + 1}  ·  {len(rows[page * page_size:(page + 1) * page_size])} 人",
                    command=lambda page=page: self._select_hunter_team_page(page),
                    bg=PANEL_2 if selected else SURFACE,
                    fg=ACCENT if selected else MUTED,
                    activebackground=PANEL_2, activeforeground=TEXT,
                    relief="flat", bd=0, padx=20, pady=10,
                    font=self._ui_font("body"), cursor="hand2",
                ).pack(side="left", padx=(0, 8))
            grid = tk.Frame(window, bg=BG)
            grid.pack(fill="both", expand=True, padx=18, pady=(0, 18))
            for column in range(6):
                grid.grid_columnconfigure(column, weight=1, uniform="hunter-team")
            for row_index in range(5):
                grid.grid_rowconfigure(row_index, weight=1)
            visible = rows[
                self.hunter_team_page * page_size:(self.hunter_team_page + 1) * page_size
            ]
            if not visible:
                tk.Label(grid, text="当前没有可显示的团队成员", bg=BG, fg=MUTED,
                         font=self._ui_font("body")).grid(row=0, column=0, columnspan=6)
            window._hunter_team_icons = []
            for index, member in enumerate(visible):
                card = tk.Frame(grid, bg=PANEL, highlightthickness=1,
                                highlightbackground=ACCENT if member.get("is_self") else BORDER)
                card.grid(row=index // 6, column=index % 6, sticky="nsew",
                          padx=(0, 6), pady=(0, 6))
                profession_id = int(member.get("profession_id") or 0)
                icon = self.icons.main_profession(profession_id, size=28)
                window._hunter_team_icons.append(icon)
                tk.Label(card, image=icon, bg=PANEL, bd=0).pack(
                    side="left", padx=(7, 4), pady=10)
                detail = tk.Frame(card, bg=PANEL)
                detail.pack(side="left", fill="both", expand=True, pady=9)
                tk.Label(detail, text=str(member.get("name") or "玩家识别中"),
                         bg=PANEL, fg=TEXT, font=self._ui_font("small"),
                         anchor="w", wraplength=125).pack(fill="x")
                rating = member.get("rating_text") or "--"
                equipment = (
                    f"竞技装备 {member.get('pvp_equipment_count', 0)}/{member.get('equipment_count', 0)}"
                    if member.get("equipment_profile_ready") else "装备未获取"
                )
                tk.Label(detail, text=f"非凡评分 {rating}", bg=PANEL,
                         fg=ACCENT, font=self._ui_font("micro"),
                         anchor="w").pack(fill="x", pady=(3, 0))
                tk.Label(detail, text=equipment, bg=PANEL,
                         fg=MUTED, font=self._ui_font("micro"),
                         anchor="w").pack(fill="x", pady=(3, 0))
        self.hunter_team_refresh_after_id = window.after(
            1200, self._refresh_hunter_team_panel
        )

